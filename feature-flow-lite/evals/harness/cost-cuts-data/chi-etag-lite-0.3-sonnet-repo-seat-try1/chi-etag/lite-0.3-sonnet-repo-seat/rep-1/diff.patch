diff --git a/middleware/etag.go b/middleware/etag.go
new file mode 100644
index 0000000..5c5bcfc
--- /dev/null
+++ b/middleware/etag.go
@@ -0,0 +1,266 @@
+package middleware
+
+import (
+	"bufio"
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"maps"
+	"net"
+	"net/http"
+	"strconv"
+	"strings"
+)
+
+// ETag is a middleware that buffers the response to GET and HEAD requests and
+// decides the final response once the handler returns. When the response
+// status is 200 and the handler did not set an ETag header, a strong ETag is
+// computed as the SHA-256 of the full body. A matching If-None-Match request
+// header (weak comparison, RFC 9110 §13.1.2) is answered with 304 Not Modified,
+// which keeps the ETag and the caching headers listed in RFC 9110 §15.4.5 and
+// removes Content-Type, Content-Length and Content-Encoding. Requests with
+// other methods, and responses with any other status, pass through unchanged.
+//
+// ETag must not be placed inside (after) NoCache: NoCache deletes the request's
+// If-None-Match header, so no 304 could ever be sent. Place ETag outside (before)
+// Compress, so that compressed and identity responses get different ETags.
+func ETag(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet && r.Method != http.MethodHead {
+			next.ServeHTTP(w, r)
+			return
+		}
+
+		ew := &etagWriter{ResponseWriter: w}
+		next.ServeHTTP(ew, r)
+		ew.respond(r)
+	})
+}
+
+// etagWriter holds back the body of a GET or HEAD response until the handler
+// returns. Once a non-200 status is sent, it forwards writes directly.
+type etagWriter struct {
+	http.ResponseWriter
+	buf         bytes.Buffer
+	wroteHeader bool
+	passthrough bool        // a non-200 status was sent
+	hijacked    bool        // the connection was taken over by the handler
+	snapshot    http.Header // headers as they were when the 200 status was set
+}
+
+func (ew *etagWriter) WriteHeader(code int) {
+	if ew.wroteHeader {
+		return
+	}
+	if code >= 100 && code <= 199 && code != http.StatusSwitchingProtocols {
+		ew.ResponseWriter.WriteHeader(code)
+		return
+	}
+	ew.wroteHeader = true
+	if code != http.StatusOK {
+		ew.passthrough = true
+		ew.ResponseWriter.WriteHeader(code)
+		return
+	}
+	ew.snapshot = ew.Header().Clone()
+}
+
+func (ew *etagWriter) Write(p []byte) (int, error) {
+	if !ew.wroteHeader {
+		ew.WriteHeader(http.StatusOK)
+	}
+	if ew.passthrough {
+		return ew.ResponseWriter.Write(p)
+	}
+	// Like net/http, reject the whole Write when it would pass the declared Content-Length.
+	if n := declaredLength(ew.snapshot); n >= 0 && int64(ew.buf.Len()+len(p)) > n {
+		return 0, http.ErrContentLength
+	}
+	return ew.buf.Write(p)
+}
+
+// Flush is a no-op while the response is buffered, so it never ends buffering.
+func (ew *etagWriter) Flush() {
+	if !ew.passthrough {
+		return
+	}
+	if f, ok := ew.ResponseWriter.(http.Flusher); ok {
+		f.Flush()
+	}
+}
+
+func (ew *etagWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	hj, ok := ew.ResponseWriter.(http.Hijacker)
+	if !ok {
+		return nil, nil, http.ErrNotSupported
+	}
+	conn, rw, err := hj.Hijack()
+	if err == nil {
+		ew.hijacked = true
+	}
+	return conn, rw, err
+}
+
+func (ew *etagWriter) Push(target string, opts *http.PushOptions) error {
+	if ps, ok := ew.ResponseWriter.(http.Pusher); ok {
+		return ps.Push(target, opts)
+	}
+	return http.ErrNotSupported
+}
+
+func (ew *etagWriter) Unwrap() http.ResponseWriter {
+	return ew.ResponseWriter
+}
+
+// respond runs after the handler returns and writes the final response.
+func (ew *etagWriter) respond(r *http.Request) {
+	if ew.hijacked || ew.passthrough {
+		return
+	}
+	if !ew.wroteHeader {
+		ew.snapshot = ew.Header().Clone()
+	}
+
+	// Trailer values come from the headers as the handler left them. The
+	// header map is then reset to the snapshot, so later header changes do not
+	// reach the client.
+	current := ew.Header().Clone()
+	h := ew.Header()
+	clear(h)
+	maps.Copy(h, ew.snapshot)
+	// Header keys are matched case-insensitively, so an ETag set under another
+	// spelling is moved to the canonical key.
+	for k, v := range h {
+		if k != "Etag" && strings.EqualFold(k, "Etag") {
+			delete(h, k)
+			h["Etag"] = append(h["Etag"], v...)
+		}
+	}
+
+	if _, ok := h["Etag"]; !ok && !headBodyUnknown(r, h, ew.buf.Len()) {
+		sum := sha256.Sum256(ew.buf.Bytes())
+		h.Set("ETag", `"`+hex.EncodeToString(sum[:])+`"`)
+	}
+
+	if ifNoneMatch(r.Header.Values("If-None-Match"), h.Values("Etag")) {
+		h.Del("Content-Type")
+		h.Del("Content-Length")
+		h.Del("Content-Encoding")
+		ew.ResponseWriter.WriteHeader(http.StatusNotModified)
+		return
+	}
+
+	ew.ResponseWriter.WriteHeader(http.StatusOK)
+	// net/http discards the body of a HEAD response, but it derives Content-Length
+	// and Content-Type from the bytes written, so the body is written for HEAD too.
+	ew.ResponseWriter.Write(ew.buf.Bytes())
+	// net/http reads trailer values from the header map after the body is
+	// written, so they are copied in here.
+	for _, k := range trailerKeys(ew.snapshot, current) {
+		if v, ok := current[k]; ok {
+			h[k] = v
+		}
+	}
+}
+
+// trailerKeys returns the canonical names of the trailers declared in the
+// Trailer header of snapshot, plus any keys in current that use the
+// http.TrailerPrefix.
+func trailerKeys(snapshot, current http.Header) []string {
+	var keys []string
+	for _, v := range snapshot.Values("Trailer") {
+		for _, name := range strings.Split(v, ",") {
+			if name = strings.TrimSpace(name); name != "" {
+				keys = append(keys, http.CanonicalHeaderKey(name))
+			}
+		}
+	}
+	for k := range current {
+		if strings.HasPrefix(k, http.TrailerPrefix) {
+			keys = append(keys, k)
+		}
+	}
+	return keys
+}
+
+// ifNoneMatch reports whether any If-None-Match line matches one of the
+// response's ETag values. A "*" line matches any current representation.
+func ifNoneMatch(lines, etags []string) bool {
+	for _, line := range lines {
+		line = strings.TrimSpace(line)
+		if line == "*" {
+			return true
+		}
+		for _, tag := range parseEntityTags(line) {
+			for _, etag := range etags {
+				if strings.TrimPrefix(tag, "W/") == strings.TrimPrefix(etag, "W/") {
+					return true
+				}
+			}
+		}
+	}
+	return false
+}
+
+// parseEntityTags returns the entity-tags of a comma-separated list. Scanning
+// stops at the first malformed member, so the tags before it are still returned.
+func parseEntityTags(s string) []string {
+	var tags []string
+	for {
+		s = strings.TrimLeft(s, " \t,")
+		if s == "" {
+			return tags
+		}
+		tag, rest, ok := cutEntityTag(s)
+		if !ok {
+			return tags
+		}
+		tags = append(tags, tag)
+		s = rest
+	}
+}
+
+// cutEntityTag splits a leading entity-tag, with an optional W/ prefix, off s.
+// It fails if the tag is malformed or is not followed by a comma or the end.
+func cutEntityTag(s string) (tag, rest string, ok bool) {
+	quoted := strings.TrimPrefix(s, "W/")
+	if !strings.HasPrefix(quoted, `"`) {
+		return "", "", false
+	}
+	end := strings.IndexByte(quoted[1:], '"')
+	if end < 0 {
+		return "", "", false
+	}
+	for i := 1; i <= end; i++ {
+		if !isEtagChar(quoted[i]) {
+			return "", "", false
+		}
+	}
+	n := len(s) - len(quoted) + end + 2
+	tag, rest = s[:n], strings.TrimLeft(s[n:], " \t")
+	if rest != "" && rest[0] != ',' {
+		return "", "", false
+	}
+	return tag, rest, true
+}
+
+// isEtagChar reports whether c may appear inside the quotes of an entity-tag.
+func isEtagChar(c byte) bool {
+	return c == 0x21 || (c >= 0x23 && c <= 0x7E) || c >= 0x80
+}
+
+// headBodyUnknown reports whether a HEAD response wrote no body bytes but
+// declares a non-zero Content-Length, so the body a GET would send is unknown.
+func headBodyUnknown(r *http.Request, h http.Header, written int) bool {
+	return r.Method == http.MethodHead && written == 0 && declaredLength(h) > 0
+}
+
+// declaredLength returns the Content-Length in h, or -1 if it is missing or
+// invalid. It accepts the same values as net/http.
+func declaredLength(h http.Header) int64 {
+	n, err := strconv.ParseUint(h.Get("Content-Length"), 10, 63)
+	if err != nil {
+		return -1
+	}
+	return int64(n)
+}
diff --git a/middleware/etag_test.go b/middleware/etag_test.go
new file mode 100644
index 0000000..3eb39e7
--- /dev/null
+++ b/middleware/etag_test.go
@@ -0,0 +1,933 @@
+package middleware
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/http/httptrace"
+	"net/textproto"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/go-chi/chi/v5"
+)
+
+// etagTag is the strong ETag ETag computes for body.
+func etagTag(body string) string {
+	sum := sha256.Sum256([]byte(body))
+	return `"` + hex.EncodeToString(sum[:]) + `"`
+}
+
+// etagWrites returns a handler that writes body with the implicit 200 status.
+func etagWrites(body string) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte(body))
+	})
+}
+
+type etagResult struct {
+	status  int
+	header  http.Header
+	trailer http.Header
+	body    string
+}
+
+// etagDo serves h on a real httptest server and returns what the client saw.
+// Redirects are not followed, so 3xx responses can be inspected.
+func etagDo(t *testing.T, h http.Handler, method string, reqHeader http.Header) etagResult {
+	t.Helper()
+	ts := httptest.NewServer(h)
+	defer ts.Close()
+
+	client := &http.Client{
+		CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse },
+	}
+	req, err := http.NewRequest(method, ts.URL+"/", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for k, v := range reqHeader {
+		req.Header[k] = v
+	}
+	resp, err := client.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(resp.Body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return etagResult{resp.StatusCode, resp.Header, resp.Trailer, string(body)}
+}
+
+func TestETagOtherMethodsPassThrough(t *testing.T) {
+	for _, method := range []string{http.MethodPost, http.MethodPut, http.MethodDelete, http.MethodOptions, "get"} {
+		t.Run(method, func(t *testing.T) {
+			// If-None-Match: * matches any 200, so a wrapped response would turn into a 304.
+			res := etagDo(t, ETag(etagWrites("body")), method, http.Header{"If-None-Match": {"*"}})
+			if res.status != http.StatusOK || res.body != "body" {
+				t.Errorf("got status %d and body %q, want 200 and \"body\"", res.status, res.body)
+			}
+			if got := res.header.Get("ETag"); got != "" {
+				t.Errorf("ETag = %q, want none", got)
+			}
+		})
+	}
+}
+
+func TestETagOtherMethodsGetOriginalWriter(t *testing.T) {
+	for _, method := range []string{http.MethodPost, "get"} {
+		rec := httptest.NewRecorder()
+		h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			if w != rec {
+				t.Errorf("%s: handler got a wrapped writer, want the original", method)
+			}
+			w.Write([]byte("x"))
+		}))
+		h.ServeHTTP(rec, httptest.NewRequest(method, "/", nil))
+	}
+}
+
+func TestETagComputesStrongTagFromBody(t *testing.T) {
+	cases := []struct {
+		name string
+		h    http.HandlerFunc
+		body string
+	}{
+		{"explicit WriteHeader(200)", func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(http.StatusOK)
+			w.Write([]byte("hello"))
+		}, "hello"},
+		{"implicit 200 from Write", func(w http.ResponseWriter, r *http.Request) {
+			w.Write([]byte("hello"))
+		}, "hello"},
+		{"no writes", func(w http.ResponseWriter, r *http.Request) {}, ""},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("X-Custom", "1")
+				tc.h(w, r)
+			})
+			res := etagDo(t, ETag(h), http.MethodGet, nil)
+			if res.status != http.StatusOK || res.body != tc.body {
+				t.Errorf("got status %d and body %q, want 200 and %q", res.status, res.body, tc.body)
+			}
+			if got := res.header.Get("ETag"); got != etagTag(tc.body) {
+				t.Errorf("ETag = %q, want %q", got, etagTag(tc.body))
+			}
+			if got := res.header.Get("X-Custom"); got != "1" {
+				t.Errorf("X-Custom = %q, want \"1\"", got)
+			}
+		})
+	}
+}
+
+func TestETagSameTagForSplitWrites(t *testing.T) {
+	const body = "hello world"
+	split := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		for i := range len(body) {
+			w.Write([]byte{body[i]})
+		}
+	})
+	for _, h := range []http.Handler{ETag(etagWrites(body)), ETag(split)} {
+		res := etagDo(t, h, http.MethodGet, nil)
+		if res.body != body || res.header.Get("ETag") != etagTag(body) {
+			t.Errorf("got body %q and ETag %q, want %q and %q", res.body, res.header.Get("ETag"), body, etagTag(body))
+		}
+	}
+}
+
+func TestETagLargeBody(t *testing.T) {
+	body := strings.Repeat("0123456789abcdef", 1<<19) // 8 MB
+	res := etagDo(t, ETag(etagWrites(body)), http.MethodGet, nil)
+	if res.body != body {
+		t.Errorf("body length %d, want %d", len(res.body), len(body))
+	}
+	if got := res.header.Get("ETag"); got != etagTag(body) {
+		t.Errorf("ETag = %q, want %q", got, etagTag(body))
+	}
+}
+
+func TestETagKeepsHandlerETag(t *testing.T) {
+	cases := []struct {
+		name string
+		set  func(http.Header)
+		want []string
+	}{
+		{"empty value", func(h http.Header) { h.Set("ETag", "") }, []string{""}},
+		{"weak value", func(h http.Header) { h.Set("ETag", `W/"x"`) }, []string{`W/"x"`}},
+		{"lower-case key", func(h http.Header) { h.Set("etag", `"v1"`) }, []string{`"v1"`}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				tc.set(w.Header())
+				w.Write([]byte("body"))
+			})
+			res := etagDo(t, ETag(h), http.MethodGet, nil)
+			if got := res.header.Values("Etag"); !slices.Equal(got, tc.want) {
+				t.Errorf("ETag values = %q, want %q", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestETagHEADKeepsOrComputesTag(t *testing.T) {
+	cases := []struct {
+		name       string
+		h          http.HandlerFunc
+		reqHeader  http.Header
+		wantStatus int
+		wantETag   string
+	}{
+		{"handler ETag kept", func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("ETag", `"h"`)
+			w.Write([]byte("hello"))
+		}, nil, http.StatusOK, `"h"`},
+		{"computed from written body", func(w http.ResponseWriter, r *http.Request) {
+			w.Write([]byte("hello"))
+		}, nil, http.StatusOK, etagTag("hello")},
+		{"no ETag when body is unknown", func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Content-Length", "1234")
+		}, http.Header{"If-None-Match": {etagTag("")}}, http.StatusOK, ""},
+		{"empty body without Content-Length", func(w http.ResponseWriter, r *http.Request) {},
+			nil, http.StatusOK, etagTag("")},
+		{"empty body with zero Content-Length", func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Content-Length", "0")
+		}, nil, http.StatusOK, etagTag("")},
+		{"empty body matches", func(w http.ResponseWriter, r *http.Request) {},
+			http.Header{"If-None-Match": {etagTag("")}}, http.StatusNotModified, etagTag("")},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			res := etagDo(t, ETag(tc.h), http.MethodHead, tc.reqHeader)
+			if res.status != tc.wantStatus {
+				t.Errorf("status = %d, want %d", res.status, tc.wantStatus)
+			}
+			if got := res.header.Get("ETag"); got != tc.wantETag {
+				t.Errorf("ETag = %q, want %q", got, tc.wantETag)
+			}
+			if res.body != "" {
+				t.Errorf("HEAD body = %q, want none", res.body)
+			}
+		})
+	}
+}
+
+func TestETagHEADKeepsContentLength(t *testing.T) {
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Length", "1234")
+	})
+	res := etagDo(t, ETag(h), http.MethodHead, nil)
+	if got := res.header.Get("Content-Length"); got != "1234" {
+		t.Errorf("Content-Length = %q, want \"1234\"", got)
+	}
+}
+
+func TestETagHEADViaGetHead(t *testing.T) {
+	r := chi.NewRouter()
+	r.Use(GetHead)
+	r.Use(ETag)
+	r.Get("/", func(w http.ResponseWriter, req *http.Request) {
+		w.Write([]byte("hello"))
+	})
+
+	get := etagDo(t, r, http.MethodGet, nil)
+	head := etagDo(t, r, http.MethodHead, nil)
+	if get.header.Get("ETag") != etagTag("hello") {
+		t.Errorf("GET ETag = %q, want %q", get.header.Get("ETag"), etagTag("hello"))
+	}
+	if head.header.Get("ETag") != get.header.Get("ETag") {
+		t.Errorf("HEAD ETag = %q, want the GET ETag %q", head.header.Get("ETag"), get.header.Get("ETag"))
+	}
+	if head.body != "" {
+		t.Errorf("HEAD body = %q, want none", head.body)
+	}
+}
+
+func TestETagIfNoneMatch(t *testing.T) {
+	const body = "body"
+	computed := etagTag(body)
+	cases := []struct {
+		name   string
+		etag   string   // handler-set ETag; empty means computed
+		lines  []string // If-None-Match header lines
+		status int
+	}{
+		{"star", "", []string{"*"}, http.StatusNotModified},
+		{"star with spaces", "", []string{"  * "}, http.StatusNotModified},
+		{"comma inside quotes matches", `"a,b"`, []string{`"a,b"`}, http.StatusNotModified},
+		{"comma inside quotes vs shorter tag", `"a,b"`, []string{`"a"`}, http.StatusOK},
+		{"unquoted tag never matches", `"abc"`, []string{"abc"}, http.StatusOK},
+		{"weak request matches strong handler tag", `"x"`, []string{`W/"x"`}, http.StatusNotModified},
+		{"strong request matches weak handler tag", `W/"x"`, []string{`"x"`}, http.StatusNotModified},
+		{"list with weak computed tag", "", []string{`"nope", W/` + computed}, http.StatusNotModified},
+		{"empty header", "", []string{""}, http.StatusOK},
+		{"two header lines", "", []string{`"a"`, computed}, http.StatusNotModified},
+		{"case sensitive", `"abc"`, []string{`"ABC"`}, http.StatusOK},
+		{"missing closing quote", `"abc"`, []string{`"abc`}, http.StatusOK},
+		{"W/ without quoted tag", `"abc"`, []string{`W/abc`}, http.StatusOK},
+		{"quote inside tag", `"a"`, []string{`"a"b"`}, http.StatusOK},
+		{"members not separated by comma", `"a"`, []string{`"x" "a"`}, http.StatusOK},
+		{"malformed member stops the line", `"b"`, []string{`abc, "b"`}, http.StatusOK},
+	}
+	for _, tc := range cases {
