+	res = etagDo(t, h, http.MethodGet, http.Header{"If-None-Match": {`"mine"`}})
+	if res.status != http.StatusNotModified || res.body != "" {
+		t.Errorf("got status %d and body %q, want 304 and no body", res.status, res.body)
+	}
+}
+
+func TestETagIoCopyGoesThroughBuffer(t *testing.T) {
+	big := bytes.Repeat([]byte("io-copy "), 1<<17) // about 1 MB
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if _, ok := w.(io.ReaderFrom); ok {
+			t.Error("writer implements io.ReaderFrom, which would bypass the buffer")
+		}
+		io.Copy(w, bytes.NewReader(big))
+	}))
+	res := etagDo(t, h, http.MethodGet, nil)
+	if res.body != string(big) || res.header.Get("ETag") != etagTag(string(big)) {
+		t.Errorf("body length %d and ETag %q, want %d and %q", len(res.body), res.header.Get("ETag"), len(big), etagTag(string(big)))
+	}
+}
+
+func TestETagHEADFileServerHasNoEmptyBodyTag(t *testing.T) {
+	content := strings.Repeat("x", 60)
+	dir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(dir, "index.html"), []byte(content), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	h := ETag(http.FileServer(http.Dir(dir)))
+
+	get := etagDo(t, h, http.MethodGet, nil)
+	if got := get.header.Get("ETag"); got != etagTag(content) {
+		t.Errorf("GET ETag = %q, want %q", got, etagTag(content))
+	}
+	head := etagDo(t, h, http.MethodHead, nil)
+	if got := head.header.Get("ETag"); got != "" {
+		t.Errorf("HEAD ETag = %q, want none", got)
+	}
+	if got := head.header.Get("Content-Length"); got != "60" {
+		t.Errorf("HEAD Content-Length = %q, want \"60\"", got)
+	}
+}
+
+func TestETagEnforcesDeclaredContentLength(t *testing.T) {
+	var n int
+	var err error
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Length", "5")
+		w.Write([]byte("hello"))
+		n, err = w.Write([]byte(" world"))
+	}))
+	res := etagDo(t, h, http.MethodGet, nil)
+	if n != 0 || err != http.ErrContentLength {
+		t.Errorf("second Write = %d, %v; want 0, %v", n, err, http.ErrContentLength)
+	}
+	if res.status != http.StatusOK || res.header.Get("Content-Length") != "5" || res.body != "hello" || res.header.Get("ETag") != etagTag("hello") {
+		t.Errorf("got status %d, Content-Length %q, body %q, ETag %q; want 200, \"5\", \"hello\", %q",
+			res.status, res.header.Get("Content-Length"), res.body, res.header.Get("ETag"), etagTag("hello"))
+	}
+}
+
+func TestETagSingleWriteBeyondContentLength(t *testing.T) {
+	var n int
+	var err error
+	rec := httptest.NewRecorder()
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Length", "5")
+		n, err = w.Write([]byte("hello world"))
+	}))
+	h.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/", nil))
+	if n != 0 || err != http.ErrContentLength {
+		t.Errorf("Write = %d, %v; want 0, %v", n, err, http.ErrContentLength)
+	}
+	if rec.Body.Len() != 0 {
+		t.Errorf("body = %q, want none buffered", rec.Body.String())
+	}
+}
+
+func TestETagIgnoresUnparsableContentLength(t *testing.T) {
+	rec := httptest.NewRecorder()
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Length", "abc")
+		if n, err := w.Write([]byte("hello world")); n != 11 || err != nil {
+			t.Errorf("Write = %d, %v; want 11, nil", n, err)
+		}
+	}))
+	h.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/", nil))
+	if rec.Body.String() != "hello world" || rec.Header().Get("ETag") != etagTag("hello world") {
+		t.Errorf("got body %q and ETag %q, want \"hello world\" and %q", rec.Body.String(), rec.Header().Get("ETag"), etagTag("hello world"))
+	}
+}
