+func TestETagNotModifiedHeaders(t *testing.T) {
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		hdr := w.Header()
+		hdr.Set("ETag", `"v1"`)
+		hdr.Set("Cache-Control", "max-age=60")
+		hdr.Set("Vary", "Accept-Encoding")
+		hdr.Set("Expires", "Thu, 01 Jan 2099 00:00:00 GMT")
+		hdr.Set("Date", "Mon, 02 Jan 2006 15:04:05 GMT")
+		hdr.Set("Content-Location", "/v1")
+		hdr.Set("Content-Length", "4")
+		hdr.Set("Content-Type", "text/plain")
+		w.Write([]byte("body"))
+	})
+	rec := httptest.NewRecorder()
+	etagServe(h, rec, etagGet(http.MethodHead, `"v1"`))
+
+	if rec.Code != http.StatusNotModified || rec.Body.Len() != 0 {
+		t.Errorf("got %d with %d body bytes, want empty 304", rec.Code, rec.Body.Len())
+	}
+	for _, k := range []string{"ETag", "Cache-Control", "Vary", "Expires", "Date", "Content-Location"} {
+		if rec.Header().Get(k) == "" {
+			t.Errorf("304 dropped %s", k)
+		}
+	}
+	for _, k := range []string{"Content-Length", "Content-Type"} {
+		if v, ok := rec.Header()[k]; ok {
+			t.Errorf("304 kept %s = %q", k, v)
+		}
+	}
+}
