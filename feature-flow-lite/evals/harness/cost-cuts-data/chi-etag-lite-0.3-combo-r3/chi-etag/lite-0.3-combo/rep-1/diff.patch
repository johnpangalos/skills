+		t.Errorf("trailer X-T = %q, want \"tv\"", v)
+	}
+	if res.Header.Get("ETag") != etagSum([]byte("body")) {
+		t.Errorf("ETag = %q, want body digest", res.Header.Get("ETag"))
+	}
