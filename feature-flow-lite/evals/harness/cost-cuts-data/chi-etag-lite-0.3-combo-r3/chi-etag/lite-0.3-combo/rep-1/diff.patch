+func TestETagHeadersFixedAtStatus(t *testing.T) {
+	tests := []struct {
+		name    string
+		handler http.HandlerFunc
+	}{
+		{"after WriteHeader", func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("X-Early", "1")
+			w.WriteHeader(http.StatusOK)
+			w.Header().Set("X-Late", "1")
+			w.Write([]byte("body"))
+		}},
+		{"after Write", func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("X-Early", "1")
+			w.Write([]byte("body"))
+			w.Header().Set("X-Late", "1")
+		}},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			rec := httptest.NewRecorder()
+			etagServe(tc.handler, rec, etagGet(http.MethodGet))
+
+			sent := rec.Result().Header
+			if sent.Get("X-Early") != "1" || sent.Get("X-Late") != "" {
+				t.Errorf("sent X-Early %q, X-Late %q; want \"1\" and none", sent.Get("X-Early"), sent.Get("X-Late"))
+			}
+			if want := etagSum([]byte("body")); sent.Get("ETag") != want {
+				t.Errorf("ETag = %q, want %q", sent.Get("ETag"), want)
+			}
+		})
+	}
+}
