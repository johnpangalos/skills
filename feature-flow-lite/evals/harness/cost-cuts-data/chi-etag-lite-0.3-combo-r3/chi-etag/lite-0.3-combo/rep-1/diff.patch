+func TestETagPassthroughFlushReachesClient(t *testing.T) {
+	rec := httptest.NewRecorder()
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusPartialContent)
