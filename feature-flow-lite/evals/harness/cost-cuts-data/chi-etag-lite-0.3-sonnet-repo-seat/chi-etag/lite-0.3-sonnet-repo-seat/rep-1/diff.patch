+func TestETagHeadBodyKnown(t *testing.T) {
+	tests := []struct {
+		name     string
+		h        http.HandlerFunc
+		wantETag string
+	}{
+		{
+			name: "writes body",
+			h: func(w http.ResponseWriter, r *http.Request) {
+				w.Write([]byte("hello"))
+			},
+			wantETag: expectedETag([]byte("hello")),
+		},
+		{
+			name: "no body and no Content-Length",
+			h: func(w http.ResponseWriter, r *http.Request) {
+				w.WriteHeader(http.StatusOK)
+			},
+			wantETag: "",
+		},
+		{
+			name: "Content-Length 0 and empty body",
+			h: func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Content-Length", "0")
+			},
+			wantETag: expectedETag(nil),
+		},
+		{
+			name: "Content-Length differs from body",
+			h: func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Content-Length", "3")
+				w.Write([]byte("hello"))
+			},
+			wantETag: "",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			rec := serveETag(tt.h, http.MethodHead)
+			if got := rec.Header().Values("ETag"); (tt.wantETag == "") != (len(got) == 0) || (len(got) > 0 && got[0] != tt.wantETag) {
+				t.Errorf("HEAD ETag = %q, want %q", got, tt.wantETag)
+			}
+			if tt.wantETag != "" {
+				match := serveETag(tt.h, http.MethodHead, tt.wantETag)
+				if match.Code != http.StatusNotModified {
+					t.Errorf("HEAD If-None-Match match: code = %d, want 304", match.Code)
+				}
+			}
+		})
+	}
+}
