+func TestETagHeadWithoutKnownBody(t *testing.T) {
+	h := ETag(http.FileServerFS(fstest.MapFS{
+		"a.txt": {Data: []byte("alpha")},
+		"b.txt": {Data: []byte("bravo")},
+	}))
+	do := func(method, path string, inm ...string) *httptest.ResponseRecorder {
+		req := httptest.NewRequest(method, path, nil)
+		for _, v := range inm {
+			req.Header.Add("If-None-Match", v)
+		}
+		rec := httptest.NewRecorder()
+		h.ServeHTTP(rec, req)
+		return rec
+	}
+
+	tagA := do(http.MethodGet, "/a.txt").Header().Get("ETag")
+	if tagA != expectedETag([]byte("alpha")) {
+		t.Fatalf("GET ETag = %q, want computed value", tagA)
+	}
+	if got := do(http.MethodHead, "/a.txt").Header().Values("ETag"); len(got) != 0 {
+		t.Errorf("HEAD ETag = %q, want none", got)
+	}
+	// "*" is left out: ServeContent answers it with its own 304.
+	for _, inm := range []string{tagA, expectedETag(nil)} {
+		if rec := do(http.MethodHead, "/b.txt", inm); rec.Code != http.StatusOK {
+			t.Errorf("HEAD /b.txt If-None-Match %q: code = %d, want 200", inm, rec.Code)
+		}
+	}
+}
