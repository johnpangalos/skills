+func TestETagOutsideCompressDescribesSentBytes(t *testing.T) {
+	body := strings.Repeat("hello ", 100)
+	h := ETag(Compress(5)(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "text/plain")
+		w.Write([]byte(body))
+	})))
+
+	identity := httptest.NewRecorder()
+	h.ServeHTTP(identity, httptest.NewRequest(http.MethodGet, "/", nil))
+
+	gzReq := httptest.NewRequest(http.MethodGet, "/", nil)
+	gzReq.Header.Set("Accept-Encoding", "gzip")
+	gz := httptest.NewRecorder()
+	h.ServeHTTP(gz, gzReq)
+
+	if gz.Header().Get("Content-Encoding") != "gzip" {
+		t.Fatalf("Content-Encoding = %q, want gzip", gz.Header().Get("Content-Encoding"))
+	}
+	if got := identity.Header().Get("ETag"); got != expectedETag([]byte(body)) {
+		t.Errorf("identity ETag = %q, want computed over body", got)
+	}
+	if got := gz.Header().Get("ETag"); got != expectedETag(gz.Body.Bytes()) {
+		t.Errorf("gzip ETag = %q, want computed over the sent gzip bytes", got)
+	}
+	if gz.Header().Get("ETag") == identity.Header().Get("ETag") {
+		t.Error("gzip and identity responses share an ETag")
+	}
+}
