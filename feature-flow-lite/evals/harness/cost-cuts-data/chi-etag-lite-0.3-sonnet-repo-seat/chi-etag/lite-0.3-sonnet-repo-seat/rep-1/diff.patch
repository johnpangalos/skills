+// hijackAndWrite hijacks w through ResponseController and writes body raw.
+func hijackAndWrite(w http.ResponseWriter, body string) {
+	conn, rw, err := http.NewResponseController(w).Hijack()
+	if err != nil {
+		return
+	}
+	defer conn.Close()
+	rw.WriteString(body)
+	rw.Flush()
+}
