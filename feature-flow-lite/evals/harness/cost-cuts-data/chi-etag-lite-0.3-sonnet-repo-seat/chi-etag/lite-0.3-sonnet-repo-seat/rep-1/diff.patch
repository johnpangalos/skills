diff --git a/middleware/etag.go b/middleware/etag.go
new file mode 100644
index 0000000..fe24504
--- /dev/null
+++ b/middleware/etag.go
@@ -0,0 +1,284 @@
+package middleware
+
+import (
+	"bufio"
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"maps"
+	"net"
+	"net/http"
+	"strconv"
+	"strings"
+)
+
+// ETag adds a strong entity-tag to GET and HEAD responses and answers
+// requests whose If-None-Match header matches it with 304 Not Modified.
+//
+// For GET and HEAD the handler's whole response is buffered until the handler
+// returns. A 200 response without an ETag header gets a strong ETag computed
+// from the body with SHA-256. The exception is a HEAD response whose body is
+// unknown, as with http.FileServer: when the handler wrote no body without
+// declaring Content-Length: 0, wrote a different number of bytes than its
+// Content-Length, or set a Content-Encoding without a Content-Length, no ETag is
+// computed. An ETag set by the handler is kept as
+// is. When If-None-Match matches (RFC 9110 weak comparison, lists and "*"
+// included, so "*" gives 304 for any 200 response), the response becomes 304
+// Not Modified with no body, keeping the cache headers and dropping
+// Content-Type, Content-Length, Content-Encoding and, when an ETag is present,
+// Last-Modified. Other methods and non-200 responses pass through unchanged.
+//
+// The computed ETag describes the bytes the handler wrote. To make it describe
+// the bytes sent to the client, place ETag outside Compress and Compress closer
+// to the handler, as in r.Use(ETag, Compress(5)). Then gzip and identity
+// responses get different ETags. NoCache strips If-None-Match from the request,
+// so 304 responses never happen when both are used.
+func ETag(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet && r.Method != http.MethodHead {
+			next.ServeHTTP(w, r)
+			return
+		}
+
+		ew := &etagResponseWriter{ResponseWriter: w}
+		next.ServeHTTP(ew, r)
+		if ew.hijacked {
+			return
+		}
+		ew.send(r)
+	})
+}
+
+// etagResponseWriter buffers the handler's response. Header returns the
+// underlying writer's header map, so headers set by outer middleware are
+// visible to the handler. The headers are snapshotted at the final WriteHeader
+// and restored before the response is sent.
+type etagResponseWriter struct {
+	http.ResponseWriter
+
+	headers     http.Header // handler's headers at the final WriteHeader
+	status      int
+	body        bytes.Buffer
+	wroteHeader bool
+	hijacked    bool
+	sent        bool // the buffered response was already written by Hijack
+}
+
+func (w *etagResponseWriter) WriteHeader(code int) {
+	if w.wroteHeader {
+		return
+	}
+	// Informational responses (other than 101) before the final status go out
+	// immediately.
+	if code < 200 && code != http.StatusSwitchingProtocols {
+		w.ResponseWriter.WriteHeader(code)
+		return
+	}
+	w.wroteHeader = true
+	w.status = code
+	w.headers = w.ResponseWriter.Header().Clone()
+}
+
+func (w *etagResponseWriter) Write(p []byte) (int, error) {
+	if w.hijacked {
+		return 0, http.ErrHijacked
+	}
+	if !w.wroteHeader {
+		w.WriteHeader(http.StatusOK)
+	}
+	if len(p) == 0 {
+		return 0, nil
+	}
+	// 1xx, 204 and 304 responses have no body.
+	if w.status < 200 || w.status == http.StatusNoContent || w.status == http.StatusNotModified {
+		return 0, http.ErrBodyNotAllowed
+	}
+	if w.sent {
+		return w.ResponseWriter.Write(p)
+	}
+	return w.body.Write(p)
+}
+
+// Flush is a no-op while the response is buffered. Once Hijack has sent the
+// buffered response, it flushes the underlying writer.
+func (w *etagResponseWriter) Flush() {
+	if f, ok := w.ResponseWriter.(http.Flusher); ok && w.sent {
+		f.Flush()
+	}
+}
+
+func (w *etagResponseWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	hj, ok := w.ResponseWriter.(http.Hijacker)
+	if !ok {
+		return nil, nil, errors.New("chi/middleware: http.Hijacker is unavailable on the writer")
+	}
+	// Send a buffered final status, headers and body as they are, so the
+	// client sees what a plain writer would have sent before the hijack.
+	if w.wroteHeader && !w.sent {
+		dst := w.ResponseWriter.Header()
+		clear(dst)
+		maps.Copy(dst, w.headers)
+		w.ResponseWriter.WriteHeader(w.status)
+		w.ResponseWriter.Write(w.body.Bytes())
+		w.sent = true
+	}
+	conn, rw, err := hj.Hijack()
+	w.hijacked = err == nil
+	return conn, rw, err
+}
+
+func (w *etagResponseWriter) Push(target string, opts *http.PushOptions) error {
+	if ps, ok := w.ResponseWriter.(http.Pusher); ok {
+		return ps.Push(target, opts)
+	}
+	return errors.New("chi/middleware: http.Pusher is unavailable on the writer")
+}
+
+func (w *etagResponseWriter) Unwrap() http.ResponseWriter {
+	return w.ResponseWriter
+}
+
+// send writes the buffered response to the underlying writer. It runs after the
+// handler returns, so a panic in the handler leaves nothing written.
+func (w *etagResponseWriter) send(r *http.Request) {
+	if w.sent {
+		return
+	}
+	if !w.wroteHeader {
+		w.WriteHeader(http.StatusOK)
+	}
+
+	// Read the handler's trailers from its live headers before restoring the
+	// snapshot over the same map.
+	trailers := etagTrailers(w.ResponseWriter.Header(), w.headers)
+	dst := w.ResponseWriter.Header()
+	clear(dst)
+	maps.Copy(dst, w.headers)
+
+	if w.status == http.StatusOK {
+		if len(dst.Values("ETag")) == 0 && (r.Method != http.MethodHead || headBodyKnown(dst, w.body.Len())) {
+			dst.Set("ETag", etagOf(w.body.Bytes()))
+		}
+		if ifNoneMatchHit(r.Header.Values("If-None-Match"), dst.Get("ETag")) {
+			writeNotModified(dst)
+			w.ResponseWriter.WriteHeader(http.StatusNotModified)
+			return
+		}
+	}
+
+	w.ResponseWriter.WriteHeader(w.status)
+	w.ResponseWriter.Write(w.body.Bytes())
+	maps.Copy(dst, trailers)
+}
+
+// etagOf returns a strong entity-tag for body: the hex of the first 16 bytes of
+// its SHA-256 hash, in double quotes.
+func etagOf(body []byte) string {
+	sum := sha256.Sum256(body)
+	return `"` + hex.EncodeToString(sum[:16]) + `"`
+}
+
+// headBodyKnown reports whether a HEAD response's buffered body of length n is
+// the body a GET would send. A HEAD handler may write no body, so the body is
+// known only if it is non-empty and Content-Length is absent, or if
+// Content-Length equals n. A Content-Encoding without a Content-Length means the
+// body was encoded on the way out, so its length is unknown.
+func headBodyKnown(h http.Header, n int) bool {
+	cl := h.Get("Content-Length")
+	if cl == "" {
+		return n > 0 && h.Get("Content-Encoding") == ""
+	}
+	size, err := strconv.Atoi(cl)
+	return err == nil && size == n
+}
+
+// etagTrailers returns the live values of the keys declared in the Trailer
+// header of declared, plus the http.TrailerPrefix keys of live.
+func etagTrailers(live, declared http.Header) http.Header {
+	trailers := http.Header{}
+	for _, name := range strings.Split(strings.Join(declared.Values("Trailer"), ","), ",") {
+		name = http.CanonicalHeaderKey(strings.TrimSpace(name))
+		if vals, ok := live[name]; ok {
+			trailers[name] = vals
+		}
+	}
+	for k, vals := range live {
+		if strings.HasPrefix(k, http.TrailerPrefix) {
+			trailers[k] = vals
+		}
+	}
+	return trailers
+}
+
+// writeNotModified removes the headers that do not apply to a 304 response, the
+// same way net/http's writeNotModified does, and drops the trailer declaration.
+func writeNotModified(h http.Header) {
+	h.Del("Content-Type")
+	h.Del("Content-Length")
+	h.Del("Content-Encoding")
+	h.Del("Trailer")
+	if len(h.Values("ETag")) > 0 {
+		h.Del("Last-Modified")
+	}
+}
+
+// ifNoneMatchHit reports whether the If-None-Match header lines match etag.
+// The lines are read as one comma-separated list. Parsing stops at the first
+// malformed member, as net/http does.
+func ifNoneMatchHit(lines []string, etag string) bool {
+	list := strings.Join(lines, ",")
+	for {
+		list = strings.TrimLeft(list, " \t")
+		switch {
+		case list == "":
+			return false
+		case list[0] == ',':
+			list = list[1:]
+		case list[0] == '*':
+			return true
+		default:
+			tag, rest, ok := scanETag(list)
+			if !ok {
+				return false
+			}
+			if weakMatch(tag, etag) {
+				return true
+			}
+			list = rest
+		}
+	}
+}
+
+// scanETag returns the entity-tag at the start of s, with its quotes and any
+// W/ prefix, and the text after it. ok is false if s does not start with a
+// well-formed entity-tag.
+func scanETag(s string) (tag, rest string, ok bool) {
+	start := 0
+	if strings.HasPrefix(s, "W/") {
+		start = 2
+	}
+	if start >= len(s) || s[start] != '"' {
+		return "", "", false
+	}
+	for i := start + 1; i < len(s); i++ {
+		switch c := s[i]; {
+		case c == '"':
+			return s[:i+1], s[i+1:], true
+		case c == 0x21 || (c >= 0x23 && c <= 0x7e) || c >= 0x80:
+			// etagc character
+		default:
+			return "", "", false
+		}
+	}
+	return "", "", false
+}
+
+// weakMatch compares tag from If-None-Match with the response etag. Both must be
+// well-formed entity-tags, and the W/ prefixes are ignored.
+func weakMatch(tag, etag string) bool {
+	if _, rest, ok := scanETag(etag); !ok || rest != "" {
+		return false
+	}
+	return strings.TrimPrefix(tag, "W/") == strings.TrimPrefix(etag, "W/")
+}
diff --git a/middleware/etag_test.go b/middleware/etag_test.go
new file mode 100644
index 0000000..b0d7ac2
--- /dev/null
+++ b/middleware/etag_test.go
@@ -0,0 +1,1032 @@
+package middleware
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"github.com/go-chi/chi/v5"
+	"io"
+	"log"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/http/httptrace"
+	"net/textproto"
+	"regexp"
+	"strings"
+	"sync"
+	"testing"
+	"testing/fstest"
+	"time"
+)
+
+var etagFormat = regexp.MustCompile(`^"[0-9a-f]{32}"$`)
+
+// expectedETag is the ETag the middleware should compute for body.
+func expectedETag(body []byte) string {
+	sum := sha256.Sum256(body)
+	return `"` + hex.EncodeToString(sum[:16]) + `"`
+}
+
+// serveETag runs h through ETag with one request using method and the given
+// If-None-Match header lines.
+func serveETag(h http.Handler, method string, inm ...string) *httptest.ResponseRecorder {
+	req := httptest.NewRequest(method, "/", nil)
+	for _, v := range inm {
+		req.Header.Add("If-None-Match", v)
+	}
+	rec := httptest.NewRecorder()
+	ETag(h).ServeHTTP(rec, req)
+	return rec
+}
+
+func newETagServer(t *testing.T, h http.Handler) *httptest.Server {
+	ts := httptest.NewServer(ETag(h))
+	t.Cleanup(ts.Close)
+	return ts
+}
+
+func TestETagPassthroughMethods(t *testing.T) {
+	methods := []string{http.MethodPost, http.MethodPut, http.MethodPatch, http.MethodDelete, http.MethodOptions, "get", "PURGE"}
+	for _, method := range methods {
+		t.Run(method, func(t *testing.T) {
+			var seen http.ResponseWriter
+			h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				seen = w
+				w.Header().Set("X-Test", "1")
+				w.WriteHeader(http.StatusCreated)
+				w.Write([]byte("created"))
+			})
+			rec := serveETag(h, method, "*")
+
+			if seen != rec {
+				t.Error("handler did not receive the original ResponseWriter")
+			}
+			if rec.Code != http.StatusCreated {
+				t.Errorf("code = %d, want %d", rec.Code, http.StatusCreated)
+			}
+			if rec.Body.String() != "created" {
+				t.Errorf("body = %q, want %q", rec.Body.String(), "created")
+			}
+			if rec.Header().Get("X-Test") != "1" {
+				t.Errorf("X-Test = %q, want %q", rec.Header().Get("X-Test"), "1")
+			}
+			if got := rec.Header().Values("ETag"); len(got) != 0 {
+				t.Errorf("ETag = %q, want none", got)
+			}
+		})
+	}
+}
+
+func TestETagPassthroughNeverNotModified(t *testing.T) {
+	for _, method := range []string{http.MethodPost, http.MethodPut} {
+		h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("ETag", `"x"`)
+			w.Write([]byte("ok"))
+		})
+		rec := serveETag(h, method, `"x"`)
+		if rec.Code != http.StatusOK || rec.Body.String() != "ok" {
+			t.Errorf("%s: got %d %q, want 200 \"ok\"", method, rec.Code, rec.Body.String())
+		}
+	}
+}
+
+func TestETagComputesStrongETag(t *testing.T) {
+	many := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("hello "))
+		w.Write([]byte("world"))
+	})
+	one := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("hello world"))
+	})
+	other := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("hello there"))
+	})
+	empty := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {})
+	explicit := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusOK)
+		w.Write([]byte("hello world"))
+	})
+
+	oneRec := serveETag(one, http.MethodGet)
+	if !etagFormat.MatchString(oneRec.Header().Get("ETag")) {
+		t.Fatalf("ETag = %q, want a strong entity-tag", oneRec.Header().Get("ETag"))
+	}
+	if want := expectedETag([]byte("hello world")); oneRec.Header().Get("ETag") != want {
+		t.Errorf("ETag = %q, want %q", oneRec.Header().Get("ETag"), want)
+	}
+	if got := serveETag(many, http.MethodGet).Header().Get("ETag"); got != oneRec.Header().Get("ETag") {
+		t.Errorf("many writes ETag = %q, want %q", got, oneRec.Header().Get("ETag"))
+	}
+	if got := serveETag(explicit, http.MethodGet).Header().Get("ETag"); got != oneRec.Header().Get("ETag") {
+		t.Errorf("explicit 200 ETag = %q, want %q", got, oneRec.Header().Get("ETag"))
+	}
+	if got := serveETag(other, http.MethodGet).Header().Get("ETag"); got == oneRec.Header().Get("ETag") {
+		t.Errorf("different body has the same ETag %q", got)
+	}
+
+	emptyRec := serveETag(empty, http.MethodGet)
+	if emptyRec.Code != http.StatusOK || emptyRec.Body.Len() != 0 {
+		t.Errorf("empty body: got %d with %d bytes, want 200 and no body", emptyRec.Code, emptyRec.Body.Len())
+	}
+	if got := emptyRec.Header().Get("ETag"); got != expectedETag(nil) {
+		t.Errorf("empty body ETag = %q, want %q", got, expectedETag(nil))
+	}
+}
+
+func TestETagLargeBody(t *testing.T) {
+	big := bytes.Repeat([]byte("a"), 10<<20)
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		for i := 0; i < len(big); i += 64 << 10 {
+			w.Write(big[i : i+64<<10])
+		}
+	})
+	rec := serveETag(h, http.MethodGet)
+	if rec.Code != http.StatusOK {
+		t.Errorf("code = %d, want 200", rec.Code)
+	}
+	if !bytes.Equal(rec.Body.Bytes(), big) {
+		t.Errorf("body length = %d, want %d", rec.Body.Len(), len(big))
+	}
+	if got := rec.Header().Get("ETag"); got != expectedETag(big) {
+		t.Errorf("ETag = %q, want %q", got, expectedETag(big))
+	}
+}
+
+func TestETagHandlerSetETagKept(t *testing.T) {
+	tests := []struct {
+		name string
+		etag string
+	}{
+		{"weak", `W/"v1"`},
+		{"empty value", ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("ETag", tt.etag)
+				w.Write([]byte("body"))
+			})
+			rec := serveETag(h, http.MethodGet)
+			if got := rec.Header().Values("ETag"); len(got) != 1 || got[0] != tt.etag {
+				t.Errorf("ETag = %q, want [%q]", got, tt.etag)
+			}
+		})
+	}
+}
+
+func TestETagGetAndHeadMatch(t *testing.T) {
+	ts := newETagServer(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("hello"))
+	}))
+
+	getResp, getBody := testRequest(t, ts, http.MethodGet, "/", nil)
+	headResp, headBody := testRequest(t, ts, http.MethodHead, "/", nil)
+
+	if getBody != "hello" {
+		t.Errorf("GET body = %q, want %q", getBody, "hello")
+	}
+	if headBody != "" {
+		t.Errorf("HEAD body = %q, want none", headBody)
+	}
+	if getResp.Header.Get("ETag") != expectedETag([]byte("hello")) {
+		t.Errorf("GET ETag = %q", getResp.Header.Get("ETag"))
+	}
+	if headResp.Header.Get("ETag") != getResp.Header.Get("ETag") {
+		t.Errorf("HEAD ETag = %q, GET ETag = %q", headResp.Header.Get("ETag"), getResp.Header.Get("ETag"))
+	}
+}
+
+func TestETagNon200PassThrough(t *testing.T) {
+	tests := []struct {
+		name     string
+		code     int
+		body     string
+		location string
+	}{
+		{name: "created", code: http.StatusCreated, body: "made"},
+		{name: "no content", code: http.StatusNoContent},
+		{name: "moved", code: http.StatusMovedPermanently, location: "/new"},
+		{name: "not found", code: http.StatusNotFound, body: "gone"},
+		{name: "server error", code: http.StatusInternalServerError, body: "boom"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("ETag", `"x"`)
+				if tt.location != "" {
+					w.Header().Set("Location", tt.location)
+				}
+				w.WriteHeader(tt.code)
+				w.Write([]byte(tt.body))
+			})
+			rec := serveETag(h, http.MethodGet, `"x"`)
+			if rec.Code != tt.code {
+				t.Errorf("code = %d, want %d", rec.Code, tt.code)
+			}
+			if rec.Body.String() != tt.body {
+				t.Errorf("body = %q, want %q", rec.Body.String(), tt.body)
+			}
+			if rec.Header().Get("Location") != tt.location {
+				t.Errorf("Location = %q, want %q", rec.Header().Get("Location"), tt.location)
+			}
+			if rec.Header().Get("ETag") != `"x"` {
+				t.Errorf("ETag = %q, want %q", rec.Header().Get("ETag"), `"x"`)
+			}
+		})
+	}
+}
+
+func TestETagNon200NoETagAdded(t *testing.T) {
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusCreated)
+		w.Write([]byte("made"))
+	})
+	rec := serveETag(h, http.MethodGet)
+	if got := rec.Header().Values("ETag"); len(got) != 0 {
+		t.Errorf("ETag = %q, want none", got)
+	}
+	if rec.Code != http.StatusCreated || rec.Body.String() != "made" {
+		t.Errorf("got %d %q, want 201 \"made\"", rec.Code, rec.Body.String())
+	}
+}
+
+func TestETagServeContentOwn304And206(t *testing.T) {
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("ETag", `"x"`)
+		http.ServeContent(w, r, "a.txt", time.Time{}, strings.NewReader("hello"))
+	})
+
+	rec := serveETag(h, http.MethodGet, `"x"`)
+	if rec.Code != http.StatusNotModified || rec.Body.Len() != 0 {
+		t.Errorf("ServeContent 304: got %d with %d bytes", rec.Code, rec.Body.Len())
+	}
+
+	req := httptest.NewRequest(http.MethodGet, "/", nil)
+	req.Header.Set("Range", "bytes=0-1")
+	rec = httptest.NewRecorder()
+	ETag(h).ServeHTTP(rec, req)
+	if rec.Code != http.StatusPartialContent || rec.Body.String() != "he" {
+		t.Errorf("ServeContent 206: got %d %q, want 206 \"he\"", rec.Code, rec.Body.String())
+	}
+}
+
