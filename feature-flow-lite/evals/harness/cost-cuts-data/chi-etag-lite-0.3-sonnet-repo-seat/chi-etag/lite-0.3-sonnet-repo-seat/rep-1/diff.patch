+func TestETagHeadBehindCompressWithFileServer(t *testing.T) {
+	fsys := fstest.MapFS{
+		"a.txt": {Data: []byte(strings.Repeat("hello world ", 34))},
+		"b.txt": {Data: []byte(strings.Repeat("bravo ", 200))},
+	}
+	r := chi.NewRouter()
+	r.Use(ETag, Compress(5))
+	r.Handle("/*", http.FileServerFS(fsys))
+
+	do := func(method, path string, inm ...string) *httptest.ResponseRecorder {
+		req := httptest.NewRequest(method, path, nil)
+		req.Header.Set("Accept-Encoding", "gzip")
+		for _, v := range inm {
+			req.Header.Add("If-None-Match", v)
+		}
+		rec := httptest.NewRecorder()
+		r.ServeHTTP(rec, req)
+		return rec
+	}
+
+	getA := do(http.MethodGet, "/a.txt")
+	if getA.Header().Get("Content-Encoding") != "gzip" {
+		t.Fatalf("Content-Encoding = %q, want gzip", getA.Header().Get("Content-Encoding"))
+	}
+	tagA := getA.Header().Get("ETag")
+	if tagA != expectedETag(getA.Body.Bytes()) {
+		t.Errorf("GET a ETag = %q, want computed over the gzip bytes", tagA)
+	}
+	for _, path := range []string{"/a.txt", "/b.txt"} {
+		if got := do(http.MethodHead, path).Header().Values("ETag"); len(got) != 0 {
+			t.Errorf("HEAD %s ETag = %q, want none", path, got)
+		}
+	}
+	if rec := do(http.MethodHead, "/b.txt", tagA); rec.Code != http.StatusOK {
+		t.Errorf("HEAD b with GET a's tag: code = %d, want 200", rec.Code)
+	}
+}
