+func TestETagWriteAfterFailedHijackReachesClient(t *testing.T) {
+	ts := httptest.NewServer(Compress(5)(ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "text/plain")
+		w.Header().Set("Trailer", "X-Sum")
+		w.Write([]byte("part1 "))
+		_, _, err := w.(http.Hijacker).Hijack()
+		if err == nil {
+			t.Error("Hijack succeeded, want an error")
+			return
+		}
+		w.Write([]byte("fallback: " + err.Error()))
+		w.(http.Flusher).Flush()
+		w.Header().Set("X-Sum", "abc")
+	}))))
+	t.Cleanup(ts.Close)
+
+	resp, body := testRequest(t, ts, http.MethodGet, "/", nil)
+	want := "part1 fallback: chi/middleware: http.Hijacker is unavailable on the writer"
+	if body != want {
+		t.Errorf("body = %q, want %q", body, want)
+	}
+	if resp.Trailer.Get("X-Sum") != "abc" {
+		t.Errorf("trailer X-Sum = %q, want %q", resp.Trailer.Get("X-Sum"), "abc")
+	}
+}
