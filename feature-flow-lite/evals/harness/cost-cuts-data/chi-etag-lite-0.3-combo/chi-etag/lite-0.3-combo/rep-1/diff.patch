+func TestETagWriterBehavesLikeResponseWriter(t *testing.T) {
+	t.Run("second WriteHeader ignored", func(t *testing.T) {
+		rec := serveETag(http.MethodGet, func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(http.StatusAccepted)
+			w.WriteHeader(http.StatusInternalServerError)
+			w.Write([]byte("x"))
+		})
+		if rec.Code != http.StatusAccepted {
+			t.Errorf("status = %d, want 202", rec.Code)
+		}
+	})
+
+	t.Run("write implies 200 and returns length", func(t *testing.T) {
+		rec := serveETag(http.MethodGet, func(w http.ResponseWriter, r *http.Request) {
+			n, err := w.Write([]byte("hello"))
+			if n != 5 || err != nil {
+				t.Errorf("Write = (%d, %v), want (5, nil)", n, err)
+			}
+		})
+		if rec.Code != http.StatusOK {
+			t.Errorf("status = %d, want 200", rec.Code)
+		}
+	})
+
+	t.Run("header changes after WriteHeader are ignored", func(t *testing.T) {
+		rec := serveETag(http.MethodGet, func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("X-Early", "1")
+			w.WriteHeader(http.StatusAccepted)
+			w.Header().Set("X-Late", "1")
+			w.Write([]byte("x"))
+			w.Header().Set("X-Later", "1")
+		})
+		if rec.Header().Get("X-Early") != "1" {
+			t.Errorf("X-Early = %q, want %q", rec.Header().Get("X-Early"), "1")
+		}
+		if h := rec.Result().Header; h.Get("X-Late") != "" || h.Get("X-Later") != "" {
+			t.Errorf("late headers were sent: X-Late=%q X-Later=%q", h.Get("X-Late"), h.Get("X-Later"))
+		}
+	})
+
+	t.Run("late ETag after WriteHeader(200) is ignored", func(t *testing.T) {
+		rec := serveETag(http.MethodGet, func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(http.StatusOK)
+			w.Header().Set("ETag", `"late"`)
+			w.Write([]byte("hello"))
+		})
+		if got, want := rec.Header().Get("ETag"), strongETag([]byte("hello")); got != want {
+			t.Errorf("ETag = %q, want computed %q", got, want)
+		}
+	})
+
+	t.Run("informational status forwarded immediately", func(t *testing.T) {
+		rec := &codeRecorder{ResponseRecorder: httptest.NewRecorder()}
+		ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Link", "</style.css>; rel=preload")
+			w.WriteHeader(http.StatusEarlyHints)
+			if len(rec.codes) != 1 || rec.codes[0] != http.StatusEarlyHints {
+				t.Errorf("codes after 103 = %v, want [103]", rec.codes)
+			}
+			w.Write([]byte("hello"))
+		})).ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/", nil))
+
+		if len(rec.codes) != 2 || rec.codes[1] != http.StatusOK {
+			t.Errorf("codes = %v, want [103 200]", rec.codes)
+		}
+	})
+
+	t.Run("Flush does not commit and body is still hashed", func(t *testing.T) {
+		rec := httptest.NewRecorder()
+		var flushErr error
+		ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			f, ok := w.(http.Flusher)
+			if !ok {
+				t.Fatal("ETag writer does not implement http.Flusher")
+			}
+			f.Flush()
+			w.Write([]byte("a"))
+			flushErr = http.NewResponseController(w).Flush()
+			w.Write([]byte("b"))
+		})).ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/", nil))
+
+		if flushErr != nil {
+			t.Errorf("ResponseController.Flush error = %v, want nil", flushErr)
+		}
+		if rec.Flushed {
+			t.Errorf("underlying writer was flushed early")
+		}
+		if rec.Body.String() != "ab" {
+			t.Errorf("body = %q, want %q", rec.Body.String(), "ab")
+		}
+		if got, want := rec.Header().Get("ETag"), strongETag([]byte("ab")); got != want {
+			t.Errorf("ETag = %q, want %q", got, want)
+		}
+	})
+
+	t.Run("Flush then 304", func(t *testing.T) {
+		rec := serveETag(http.MethodGet, func(w http.ResponseWriter, r *http.Request) {
+			w.(http.Flusher).Flush()
+			w.Write([]byte("a"))
+			w.(http.Flusher).Flush()
+			w.Write([]byte("b"))
+		}, strongETag([]byte("ab")))
+		if rec.Code != http.StatusNotModified {
+			t.Errorf("status = %d, want 304", rec.Code)
+		}
+	})
+
+	t.Run("Unwrap returns the underlying writer", func(t *testing.T) {
+		var got http.ResponseWriter
+		rec := serveETag(http.MethodGet, func(w http.ResponseWriter, r *http.Request) {
+			u, ok := w.(interface{ Unwrap() http.ResponseWriter })
+			if !ok {
+				t.Fatal("ETag writer does not implement Unwrap")
+			}
+			got = u.Unwrap()
+		})
+		if _, ok := got.(*httptest.ResponseRecorder); !ok || got != http.ResponseWriter(rec) {
+			t.Errorf("Unwrap() = %T, want the original *httptest.ResponseRecorder", got)
+		}
+	})
+}
