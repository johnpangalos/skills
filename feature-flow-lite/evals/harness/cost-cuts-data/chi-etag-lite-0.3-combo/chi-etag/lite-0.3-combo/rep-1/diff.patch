+func TestETagHEADKeepsUnwrappedHeaders(t *testing.T) {
+	tests := []struct {
+		name   string
+		status int
+	}{
+		{"ok", http.StatusOK},
+		{"not found", http.StatusNotFound},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.WriteHeader(tt.status)
+				w.Write([]byte("hello"))
+			})
+			plain, _ := fetch(t, handler, http.MethodHead)
+			wrapped, body := fetch(t, ETag(handler), http.MethodHead)
+
+			if wrapped.StatusCode != plain.StatusCode {
+				t.Errorf("status = %d, want %d", wrapped.StatusCode, plain.StatusCode)
+			}
+			for _, name := range []string{"Content-Length", "Content-Type"} {
+				if got, want := wrapped.Header.Get(name), plain.Header.Get(name); got != want {
+					t.Errorf("%s = %q, want %q", name, got, want)
+				}
+			}
+			if got := wrapped.Header.Get("Content-Length"); got != "5" {
+				t.Errorf("Content-Length = %q, want %q", got, "5")
+			}
+			if body != "" {
+				t.Errorf("HEAD body = %q, want empty", body)
+			}
+		})
+	}
+}
