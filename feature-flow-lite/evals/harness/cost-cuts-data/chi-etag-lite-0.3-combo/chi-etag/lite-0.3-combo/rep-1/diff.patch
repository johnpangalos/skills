+func TestETagHijackWritesNothingAfterward(t *testing.T) {
+	tests := []struct {
+		name   string
+		hijack func(w http.ResponseWriter) (net.Conn, *bufio.ReadWriter, error)
+	}{
+		{"type assertion", func(w http.ResponseWriter) (net.Conn, *bufio.ReadWriter, error) {
+			return w.(http.Hijacker).Hijack()
+		}},
+		{"response controller", func(w http.ResponseWriter) (net.Conn, *bufio.ReadWriter, error) {
+			return http.NewResponseController(w).Hijack()
+		}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			rec := &hijackRecorder{codeRecorder{ResponseRecorder: httptest.NewRecorder()}}
+			ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if _, _, err := tt.hijack(w); err != nil {
+					t.Fatalf("Hijack error = %v", err)
+				}
+				w.Write([]byte("late"))
+			})).ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/", nil))
+
+			if len(rec.codes) != 0 {
+				t.Errorf("WriteHeader codes after hijack = %v, want none", rec.codes)
+			}
+			if rec.Body.Len() != 0 {
+				t.Errorf("body after hijack = %q, want empty", rec.Body.String())
+			}
+		})
+	}
+}
