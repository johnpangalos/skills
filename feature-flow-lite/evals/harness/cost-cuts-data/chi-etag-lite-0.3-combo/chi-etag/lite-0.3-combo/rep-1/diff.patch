+// fetch sends a request with method to a test server running handler and returns
+// the response and its body.
+func fetch(t *testing.T, handler http.Handler, method string) (*http.Response, string) {
+	t.Helper()
+	srv := httptest.NewServer(handler)
+	defer srv.Close()
+	req, err := http.NewRequest(method, srv.URL, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp, err := srv.Client().Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(resp.Body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return resp, string(body)
+}
