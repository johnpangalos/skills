+func TestETagTrailersMatchUnwrapped(t *testing.T) {
+	tests := []struct {
+		name  string
+		early bool // set X-Sum before the first Write as well
+	}{
+		{"late only", false},
+		{"early and late", true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Trailer", "X-Sum")
+				if tt.early {
+					w.Header().Set("X-Sum", "early")
+				}
+				w.Write([]byte("hello"))
+				w.Header().Set("X-Sum", "abc")
+				w.Header().Set(http.TrailerPrefix+"X-Late", "z")
+				w.Header().Set("X-Plain-Late", "no")
+			})
+			plain, plainBody := fetch(t, handler, http.MethodGet)
+			wrapped, wrappedBody := fetch(t, ETag(handler), http.MethodGet)
+
+			if wrappedBody != plainBody {
+				t.Errorf("body = %q, want %q", wrappedBody, plainBody)
+			}
+			if !reflect.DeepEqual(wrapped.Trailer, plain.Trailer) {
+				t.Errorf("Trailer = %q, want %q", wrapped.Trailer, plain.Trailer)
+			}
+			if got := wrapped.Trailer.Get("X-Sum"); got != "abc" {
+				t.Errorf("X-Sum trailer = %q, want %q", got, "abc")
+			}
+			if got := wrapped.Trailer.Get("X-Late"); got != "z" {
+				t.Errorf("X-Late trailer = %q, want %q", got, "z")
+			}
+			if wrapped.Header.Get("X-Plain-Late") != "" || wrapped.Trailer.Get("X-Plain-Late") != "" {
+				t.Errorf("late non-trailer header was sent")
+			}
+			// ETag is added by the middleware and Date varies per response, so both are excluded.
+			wantHeader := plain.Header.Clone()
+			gotHeader := wrapped.Header.Clone()
+			for _, h := range []http.Header{wantHeader, gotHeader} {
+				h.Del("Date")
+				h.Del("ETag")
+			}
+			if !reflect.DeepEqual(gotHeader, wantHeader) {
+				t.Errorf("Header = %q, want %q", gotHeader, wantHeader)
+			}
+		})
+	}
+}
