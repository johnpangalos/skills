+// trailerHandler declares X-Sum as a trailer and sets it after the final WriteHeader
+// and Write. It also sets a TrailerPrefix trailer, and a header that must not be sent.
+func trailerHandler(status int) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Trailer", "X-Sum")
+		w.WriteHeader(status)
+		w.Write([]byte(strings.Repeat("x", 5000)))
+		w.Header().Set("X-Sum", "v")
+		w.Header()[http.TrailerPrefix+"X-Prefix"] = []string{"p"}
+		w.Header().Set("X-Late", "late")
+	})
+}
