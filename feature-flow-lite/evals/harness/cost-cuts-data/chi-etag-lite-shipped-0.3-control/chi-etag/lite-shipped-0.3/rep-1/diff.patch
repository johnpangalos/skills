+
+	head := httptest.NewRecorder()
+	h.ServeHTTP(head, httptest.NewRequest("HEAD", "/f.txt", nil))
+	if head.Code != 200 || head.Header().Get("Content-Length") != "10" || head.Header().Get("ETag") != "" {
+		t.Fatalf("HEAD: got %d, Content-Length %q, ETag %q", head.Code, head.Header().Get("Content-Length"), head.Header().Get("ETag"))
+	}
+
+	get := httptest.NewRecorder()
+	h.ServeHTTP(get, httptest.NewRequest("GET", "/f.txt", nil))
+	if want := strongETag([][]byte{[]byte("0123456789")}); get.Header().Get("ETag") != want {
+		t.Fatalf("GET ETag = %q, want %q", get.Header().Get("ETag"), want)
+	}
+}
