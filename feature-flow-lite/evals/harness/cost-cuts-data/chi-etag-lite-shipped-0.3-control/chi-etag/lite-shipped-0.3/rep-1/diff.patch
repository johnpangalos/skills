+func TestETagDeletedTrailerMatchesPlainResponse(t *testing.T) {
+	tests := []struct {
+		name  string
+		set   func(h http.Header) // runs before the final WriteHeader
+		unset string              // deleted after Write
+	}{
+		{
+			name:  "declared trailer",
+			set:   func(h http.Header) { h.Set("Trailer", "X-T"); h.Set("X-T", "v1") },
+			unset: "X-T",
+		},
+		{
+			name:  "trailer prefix",
+			set:   func(h http.Header) { h[http.TrailerPrefix+"X-P"] = []string{"p"} },
+			unset: http.TrailerPrefix + "X-P",
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				tc.set(w.Header())
+				w.WriteHeader(201)
+				w.Write([]byte(strings.Repeat("x", 5000)))
+				delete(w.Header(), tc.unset)
+			})
+			plain := httptest.NewServer(handler)
+			defer plain.Close()
+			wrapped := httptest.NewServer(ETag(handler))
+			defer wrapped.Close()
+
+			want, _ := testRequest(t, plain, "GET", "/", nil)
+			got, _ := testRequest(t, wrapped, "GET", "/", nil)
+			// Date and ETag differ by design, so they are left out of the comparison.
+			headers := func(resp *http.Response) http.Header {
+				h := resp.Header.Clone()
+				h.Del("Date")
+				h.Del("Etag")
+				return h
+			}
+			if !reflect.DeepEqual(headers(got), headers(want)) {
+				t.Errorf("headers %v, plain %v", got.Header, want.Header)
+			}
+			if !reflect.DeepEqual(got.Trailer, want.Trailer) {
+				t.Errorf("trailers %v, plain %v", got.Trailer, want.Trailer)
+			}
+			if got.ContentLength != want.ContentLength || !slices.Equal(got.TransferEncoding, want.TransferEncoding) {
+				t.Errorf("framing: length %d %v, plain %d %v", got.ContentLength, got.TransferEncoding, want.ContentLength, want.TransferEncoding)
+			}
+		})
+	}
+}
