+func TestETagTrailersMatchPlainResponse(t *testing.T) {
+	for _, status := range []int{200, 404} {
+		t.Run(fmt.Sprint(status), func(t *testing.T) {
+			plain := httptest.NewServer(trailerHandler(status))
+			defer plain.Close()
+			wrapped := httptest.NewServer(ETag(trailerHandler(status)))
+			defer wrapped.Close()
+
+			want, _ := testRequest(t, plain, "GET", "/", nil)
+			got, _ := testRequest(t, wrapped, "GET", "/", nil)
+			if got.Trailer.Get("X-Sum") != "v" || got.Trailer.Get("X-Prefix") != "p" {
+				t.Fatalf("trailers %v", got.Trailer)
+			}
+			if !reflect.DeepEqual(got.Trailer, want.Trailer) {
+				t.Fatalf("trailers %v, plain %v", got.Trailer, want.Trailer)
+			}
+			if got.Header.Get("X-Late") != "" {
+				t.Fatal("header changed after WriteHeader was sent")
+			}
+		})
+	}
+}
