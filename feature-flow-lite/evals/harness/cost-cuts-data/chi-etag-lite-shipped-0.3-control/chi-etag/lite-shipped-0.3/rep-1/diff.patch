+func TestETagHeadWithDeclaredLengthAndBodyMatchesGet(t *testing.T) {
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Length", "10")
+		w.Write([]byte("0123456789"))
+	}))
+	want := strongETag([][]byte{[]byte("0123456789")})
+	if got := serveETag(h, "GET").Header().Get("ETag"); got != want {
+		t.Fatalf("GET ETag = %q, want %q", got, want)
+	}
+	if got := serveETag(h, "HEAD").Header().Get("ETag"); got != want {
+		t.Fatalf("HEAD ETag = %q, want %q", got, want)
+	}
+}
