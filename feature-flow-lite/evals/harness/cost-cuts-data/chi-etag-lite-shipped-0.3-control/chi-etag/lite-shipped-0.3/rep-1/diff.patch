diff --git a/middleware/etag.go b/middleware/etag.go
new file mode 100644
index 0000000..098fb37
--- /dev/null
+++ b/middleware/etag.go
@@ -0,0 +1,279 @@
+package middleware
+
+import (
+	"bufio"
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"maps"
+	"net"
+	"net/http"
+	"strconv"
+	"strings"
+)
+
+// ETag buffers the response to GET and HEAD requests. A 200 response that the
+// handler gave no ETag gets a strong one: the SHA-256 of the body, in quotes.
+// When If-None-Match matches the response's ETag, ETag answers 304 Not Modified
+// with no body instead. If-None-Match is compared with the weak comparison of
+// RFC 9110 section 8.8.3.2, and "*" matches any 200 response. A HEAD response
+// that declares a non-zero Content-Length but writes no body, as http.FileServer
+// does, gets no generated ETag.
+//
+// Other methods pass through unchanged. So do responses with any status other
+// than 200, which are sent as the handler wrote them. Flush does nothing on a
+// buffered response. 1xx informational responses other than 101 that come before
+// the final status are sent immediately, and later ones are ignored.
+func ETag(next http.Handler) http.Handler {
+	fn := func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet && r.Method != http.MethodHead {
+			next.ServeHTTP(w, r)
+			return
+		}
+
+		ew := &etagWriter{ResponseWriter: w}
+		next.ServeHTTP(ew, r)
+		if ew.hijacked || ew.sent {
+			return
+		}
+		if ew.status == 0 {
+			ew.WriteHeader(http.StatusOK)
+		}
+
+		if ew.status == http.StatusOK {
+			etags, present := etagValues(ew.header)
+			if !present && !headBodyUnseen(r, ew) {
+				tag := strongETag(ew.body)
+				ew.header.Set("ETag", tag)
+				etags = []string{tag}
+			}
+			if ifNoneMatch(r.Header.Values("If-None-Match"), etags) {
+				ew.header.Del("Content-Type")
+				ew.header.Del("Content-Length")
+				ew.header.Del("Content-Encoding")
+				if ew.header.Get("Etag") != "" {
+					ew.header.Del("Last-Modified")
+				}
+				ew.send(http.StatusNotModified, nil)
+				return
+			}
+		}
+		ew.send(ew.status, ew.body)
+	}
+
+	return http.HandlerFunc(fn)
+}
+
+// etagWriter holds back the handler's response until the handler returns.
+type etagWriter struct {
+	http.ResponseWriter
+
+	status   int         // final status, or 0 if none was written
+	header   http.Header // headers as they were when the final status was written
+	body     [][]byte    // the Write calls, in order
+	size     int         // total bytes written
+	hijacked bool
+	sent     bool // Hijack has sent the response, so ETag leaves it alone
+}
+
+func (ew *etagWriter) WriteHeader(code int) {
+	if ew.hijacked {
+		return
+	}
+	if ew.sent {
+		ew.ResponseWriter.WriteHeader(code)
+		return
+	}
+	if ew.status != 0 {
+		return // Superfluous, as in net/http, so the code is not checked.
+	}
+	if code < 100 || code > 999 {
+		panic(fmt.Sprintf("invalid WriteHeader code %v", code))
+	}
+	if code >= 100 && code <= 199 && code != http.StatusSwitchingProtocols {
+		// Informational, so it is sent now and does not count as the final status.
+		ew.ResponseWriter.WriteHeader(code)
+		return
+	}
+	ew.status = code
+	ew.header = ew.Header().Clone()
+}
+
+func (ew *etagWriter) Write(p []byte) (int, error) {
+	if ew.hijacked {
+		return 0, http.ErrHijacked
+	}
+	if ew.sent {
+		return ew.ResponseWriter.Write(p)
+	}
+	if ew.status == 0 {
+		ew.WriteHeader(http.StatusOK)
+	}
+	if !bodyAllowed(ew.status) {
+		return 0, http.ErrBodyNotAllowed
+	}
+	ew.body = append(ew.body, bytes.Clone(p))
+	ew.size += len(p)
+	return len(p), nil
+}
+
+// Flush does nothing, because a buffered response is only sent once the handler returns.
+func (ew *etagWriter) Flush() {}
+
+func (ew *etagWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	hj, ok := ew.ResponseWriter.(http.Hijacker)
+	if !ok {
+		return nil, nil, errors.New("chi/middleware: http.Hijacker is unavailable on the writer")
+	}
+	if ew.status != 0 && !ew.sent {
+		// As net/http does, send what the handler already wrote before hijacking.
+		ew.send(ew.status, ew.body)
+		ew.sent = true // Recorded even if Hijack fails, so the response is not sent twice.
+	}
+	conn, rw, err := hj.Hijack()
+	if err == nil {
+		ew.hijacked = true
+	}
+	return conn, rw, err
+}
+
+func (ew *etagWriter) Push(target string, opts *http.PushOptions) error {
+	if ps, ok := ew.ResponseWriter.(http.Pusher); ok {
+		return ps.Push(target, opts)
+	}
+	return errors.New("chi/middleware: http.Pusher is unavailable on the writer")
+}
+
+func (ew *etagWriter) Unwrap() http.ResponseWriter {
+	return ew.ResponseWriter
+}
+
+// send writes the response to the underlying writer: the headers from the final
+// WriteHeader, the status, then the same Write calls the handler made. Headers
+// changed after the final WriteHeader are not sent, but trailers still are.
+func (ew *etagWriter) send(status int, body [][]byte) {
+	h := ew.Header()
+	trailers := trailerValues(h, ew.header)
+	clear(h)
+	maps.Copy(h, ew.header)
+	ew.ResponseWriter.WriteHeader(status)
+	// Trailers the handler deleted after the final WriteHeader must not come back.
+	for k := range trailerValues(h, ew.header) {
+		if _, ok := trailers[k]; !ok {
+			delete(h, k)
+		}
+	}
+	maps.Copy(h, trailers)
+	for _, p := range body {
+		ew.ResponseWriter.Write(p)
+	}
+}
+
+// bodyAllowed reports whether a response with this final status may have a body.
+func bodyAllowed(status int) bool {
+	return status != http.StatusNoContent && status != http.StatusNotModified && (status < 100 || status > 199)
+}
+
+// headBodyUnseen reports whether a HEAD response declares a non-zero Content-Length
+// but the handler wrote no body, as http.ServeContent does, so there is nothing to hash.
+func headBodyUnseen(r *http.Request, ew *etagWriter) bool {
+	n, err := strconv.ParseInt(ew.header.Get("Content-Length"), 10, 64)
+	return r.Method == http.MethodHead && ew.size == 0 && err == nil && n != 0
+}
+
+// trailerValues returns the entries of h that are sent as trailers: keys named in
+// the Trailer header of snap, and keys with the TrailerPrefix.
+func trailerValues(h, snap http.Header) http.Header {
+	declared := make(map[string]bool)
+	for _, v := range snap.Values("Trailer") {
+		for _, name := range strings.Split(v, ",") {
+			declared[http.CanonicalHeaderKey(strings.TrimSpace(name))] = true
+		}
+	}
+	trailers := make(http.Header)
+	for k, v := range h {
+		if declared[http.CanonicalHeaderKey(k)] || strings.HasPrefix(k, http.TrailerPrefix) {
+			trailers[k] = v
+		}
+	}
+	return trailers
+}
+
+// strongETag returns the strong entity tag for a body given as the chunks it was
+// written in: the SHA-256 of the body, in quotes.
+func strongETag(body [][]byte) string {
+	h := sha256.New()
+	for _, p := range body {
+		h.Write(p)
+	}
+	return `"` + hex.EncodeToString(h.Sum(nil)) + `"`
+}
+
+// etagValues returns the values of every ETag key in h, whatever its casing,
+// and whether such a key is present at all.
+func etagValues(h http.Header) (values []string, present bool) {
+	for k, v := range h {
+		if strings.EqualFold(k, "ETag") {
+			values = append(values, v...)
+			present = true
+		}
+	}
+	return values, present
+}
+
+// ifNoneMatch reports whether the If-None-Match field values match any of etags.
+// The values are joined into one list. A "*" that is the whole list matches any
+// current representation. Scanning stops at the first malformed member, so the
+// members before it still count.
+func ifNoneMatch(values, etags []string) bool {
+	list := strings.Join(values, ",")
+	if strings.Trim(list, " \t") == "*" {
+		return true
+	}
+	for {
+		list = strings.Trim(list, " \t")
+		if list == "" {
+			return false
+		}
+		if list[0] == ',' {
+			list = list[1:]
+			continue
+		}
+		tag, rest := scanETag(list)
+		if tag == "" {
+			return false
+		}
+		// Weak comparison: a W/ prefix is ignored and the opaque tags must be equal.
+		for _, etag := range etags {
+			if strings.TrimPrefix(tag, "W/") == strings.TrimPrefix(etag, "W/") {
+				return true
+			}
+		}
+		list = rest
+	}
+}
+
+// scanETag reads the entity tag at the start of s, either W/"x" or "x". It returns
+// the tag and the text after it, or an empty tag if s does not start with a valid one.
+func scanETag(s string) (tag, rest string) {
+	start := 0
+	if strings.HasPrefix(s, "W/") {
+		start = 2
+	}
+	if len(s[start:]) < 2 || s[start] != '"' {
+		return "", ""
+	}
+	for i := start + 1; i < len(s); i++ {
+		c := s[i]
+		switch {
+		case c == 0x21 || c >= 0x23 && c <= 0x7E || c >= 0x80:
+		case c == '"':
+			return s[:i+1], s[i+1:]
+		default:
+			return "", ""
+		}
+	}
+	return "", ""
+}
diff --git a/middleware/etag_test.go b/middleware/etag_test.go
new file mode 100644
index 0000000..38e9a0e
--- /dev/null
+++ b/middleware/etag_test.go
@@ -0,0 +1,919 @@
+package middleware
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/http/httptrace"
+	"net/textproto"
+	"os"
+	"path/filepath"
+	"reflect"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/go-chi/chi/v5"
+)
+
+const (
+	helloETag = `"2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824"` // SHA-256 of "hello"
+	emptyETag = `"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"` // SHA-256 of ""
+)
+
+// serveETag sends method to h, adding each value as its own If-None-Match line.
+func serveETag(h http.Handler, method string, ifNoneMatch ...string) *httptest.ResponseRecorder {
+	rec := httptest.NewRecorder()
+	req := httptest.NewRequest(method, "/", nil)
+	for _, v := range ifNoneMatch {
+		req.Header.Add("If-None-Match", v)
+	}
+	h.ServeHTTP(rec, req)
+	return rec
+}
+
+// plainWriter hides the optional interfaces of the ResponseWriter it wraps.
+type plainWriter struct{ http.ResponseWriter }
+
+type hijackRecorder struct {
+	*httptest.ResponseRecorder
+	hijacked bool
+}
+
+func (h *hijackRecorder) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	h.hijacked = true
+	return nil, nil, nil
+}
+
+type pushRecorder struct {
+	*httptest.ResponseRecorder
+	pushed string
+}
+
+func (p *pushRecorder) Push(target string, _ *http.PushOptions) error {
+	p.pushed = target
+	return nil
+}
+
+// flushedHandler writes status (if not 0) and then each part. When flush is set it
+// calls Flush before each part and at the end.
+func flushedHandler(status int, flush bool, parts ...string) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		rc := http.NewResponseController(w)
+		if status != 0 {
+			w.WriteHeader(status)
+		}
+		for _, p := range parts {
+			if flush {
+				rc.Flush()
+			}
+			w.Write([]byte(p))
+		}
+		if flush {
+			rc.Flush()
+		}
+	})
+}
+
+func TestETagGeneratesStrongTag(t *testing.T) {
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("hello"))
+	}))
+
+	rec := serveETag(h, "GET")
+	if rec.Code != 200 || rec.Body.String() != "hello" {
+		t.Fatalf("got %d %q", rec.Code, rec.Body.String())
+	}
+	if got := rec.Header().Get("ETag"); got != helloETag {
+		t.Fatalf("ETag = %s, want %s", got, helloETag)
+	}
+	if rec := serveETag(h, "HEAD"); rec.Header().Get("ETag") != helloETag {
+		t.Fatalf("HEAD ETag = %s, want %s", rec.Header().Get("ETag"), helloETag)
+	}
+}
+
+func TestETagHeadMatchesGet(t *testing.T) {
+	ts := httptest.NewServer(ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/a" {
+			w.Write([]byte("hello"))
+			return
+		}
+		w.Write([]byte("world"))
+	})))
+	defer ts.Close()
+
+	getA, bodyA := testRequest(t, ts, "GET", "/a", nil)
+	headA, headBody := testRequest(t, ts, "HEAD", "/a", nil)
+	getB, _ := testRequest(t, ts, "GET", "/b", nil)
+	if bodyA != "hello" || headBody != "" {
+		t.Fatalf("bodies: GET %q, HEAD %q", bodyA, headBody)
+	}
+	if got := getA.Header.Get("ETag"); got != helloETag {
+		t.Fatalf("GET ETag = %s, want %s", got, helloETag)
+	}
+	if got := headA.Header.Get("ETag"); got != helloETag {
+		t.Fatalf("HEAD ETag = %s, want %s", got, helloETag)
+	}
+	if got := getB.Header.Get("ETag"); got == helloETag || got == "" {
+		t.Fatalf("different body gave ETag %s", got)
+	}
+}
+
+func TestETagEmptyBody(t *testing.T) {
+	noWrite := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}))
+	rec := serveETag(noWrite, "GET")
+	if rec.Code != 200 || rec.Body.Len() != 0 || rec.Header().Get("ETag") != emptyETag {
+		t.Fatalf("got %d %q, ETag %s", rec.Code, rec.Body.String(), rec.Header().Get("ETag"))
+	}
+
+	emptyWrite := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte{})
+	}))
+	if rec := serveETag(emptyWrite, "HEAD"); rec.Code != 200 || rec.Header().Get("ETag") != emptyETag {
+		t.Fatalf("got %d, ETag %s", rec.Code, rec.Header().Get("ETag"))
+	}
+}
+
+func TestETagManyWritesMatchOneWrite(t *testing.T) {
+	big := bytes.Repeat([]byte("0123456789abcdef"), (10<<20)/16)
+
+	chunked := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		for i := 0; i < len(big); i += 1024 {
+			w.Write(big[i : i+1024])
+		}
+	}))
+	single := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write(big)
+	}))
+
+	got := serveETag(chunked, "GET").Header().Get("ETag")
+	if want := serveETag(single, "GET").Header().Get("ETag"); got != want || got != strongETag([][]byte{big}) {
+		t.Fatalf("chunked ETag %s, single write %s", got, want)
+	}
+}
+
+func TestETagIOCopy(t *testing.T) {
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		// Hide WriteTo so that io.Copy goes through Write.
+		if _, err := io.Copy(w, struct{ io.Reader }{strings.NewReader("hello")}); err != nil {
+			t.Error(err)
+		}
+	}))
+	if got := serveETag(h, "GET").Header().Get("ETag"); got != helloETag {
+		t.Fatalf("ETag = %s, want %s", got, helloETag)
+	}
+}
+
+func TestETagKeepsHandlerSetETagKey(t *testing.T) {
+	tests := map[string][]string{
+		"nil":   nil,
+		"empty": {""},
+		"weak":  {`W/"v1"`},
+	}
+	for name, vals := range tests {
+		t.Run(name, func(t *testing.T) {
+			h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header()["ETag"] = vals
+				w.Write([]byte("body"))
+			}))
+			rec := serveETag(h, "GET")
+			if rec.Code != 200 || rec.Body.String() != "body" {
+				t.Fatalf("got %d %q", rec.Code, rec.Body.String())
+			}
+			if got := rec.Header()["ETag"]; !slices.Equal(got, vals) {
+				t.Fatalf("ETag key = %q, want %q", got, vals)
+			}
+			if _, added := rec.Header()["Etag"]; added {
+				t.Fatal("middleware added a second ETag")
+			}
+		})
+	}
+}
+
+func TestETagPanicWritesNothingPartial(t *testing.T) {
+	r := chi.NewRouter()
+	r.Use(Recoverer)
+	r.Use(ETag)
+	r.Get("/", func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("partial"))
+		panic("boom")
+	})
+	ts := httptest.NewServer(r)
+	defer ts.Close()
+
+	resp, body := testRequest(t, ts, "GET", "/", nil)
+	if resp.StatusCode != 500 || body != "" {
+		t.Fatalf("got %d %q, want 500 with empty body", resp.StatusCode, body)
+	}
+}
+
+func TestETagFirstStatusWins(t *testing.T) {
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(201)
+		w.WriteHeader(500)
+		w.Write([]byte("made"))
+	}))
+	rec := serveETag(h, "GET")
+	if rec.Code != 201 || rec.Body.String() != "made" || rec.Header().Get("ETag") != "" {
+		t.Fatalf("got %d %q, ETag %q", rec.Code, rec.Body.String(), rec.Header().Get("ETag"))
+	}
+}
+
+func TestETagIfNoneMatch(t *testing.T) {
+	tests := []struct {
+		name string
+		etag string   // ETag the handler sets
+		inm  []string // If-None-Match header lines
+		want int
+	}{
+		{"exact", `"x"`, []string{`"x"`}, 304},
+		{"weak request", `"x"`, []string{`W/"x"`}, 304},
+		{"weak response", `W/"x"`, []string{`"x"`}, 304},
+		{"weak both", `W/"x"`, []string{`W/"x"`}, 304},
+		{"odd whitespace", `"c"`, []string{`"a", W/"b" ,  "c"`}, 304},
+		{"empty members", `"b"`, []string{`"a",,"b"`}, 304},
+		{"comma inside tag", `"a,b"`, []string{`"a,b"`}, 304},
+		{"comma tag is not a list", `"x"`, []string{`"a,x"`}, 200},
+		{"quoted star is a tag", `"x"`, []string{`"*"`}, 200},
+		{"quoted star matches tag", `"*"`, []string{`"*"`}, 304},
+		{"lowercase weak prefix", `"x"`, []string{`w/"x"`}, 200},
+		{"lowercase weak member stops scan", `"y"`, []string{`w/"x", "y"`}, 200},
+		{"unquoted", `"x"`, []string{`abc`}, 200},
+		{"unterminated", `"abc"`, []string{`"abc`}, 200},
+		{"malformed stops scan", `"x"`, []string{`abc, "x"`}, 200},
+		{"match before malformed", `"x"`, []string{`"x", abc`}, 304},
+		{"star in list", `"x"`, []string{`"a", *`}, 200},
+		{"empty value", `"x"`, []string{""}, 200},
+		{"case sensitive", `"x"`, []string{`"X"`}, 200},
+		{"star", `"x"`, []string{"*"}, 304},
+		{"padded star", `"x"`, []string{"  *  "}, 304},
+		{"two lines", `"x"`, []string{`"a"`, `"x"`}, 304},
+		{"malformed second line", `"x"`, []string{`"a"`, `abc`}, 200},
+		{"malformed first line", `"x"`, []string{`abc`, `"x"`}, 200},
+		{"malformed etag", `abc`, []string{`abc`}, 200},
+		{"malformed etag quoted", `abc`, []string{`"abc"`}, 200},
+		{"malformed etag, star", `abc`, []string{"*"}, 304},
+		{"empty etag", ``, []string{`""`}, 200},
+		{"space in tag", `"a b"`, []string{`"a b"`}, 200},
+		{"space in tag, star", `"a b"`, []string{"*"}, 304},
+		{"control char in tag", "\"a\x01\"", []string{"\"a\x01\""}, 200},
+		{"control char in request", `"a"`, []string{"\"a\x7f\""}, 200},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("ETag", tc.etag)
+				w.Write([]byte("body"))
+			}))
