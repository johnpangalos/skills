+// failHijackRecorder is a Hijacker whose Hijack always fails.
+type failHijackRecorder struct{ *httptest.ResponseRecorder }
+
+func (failHijackRecorder) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	return nil, nil, errors.New("hijack failed")
+}
+
+func TestETagFailedHijackAfterWriteSendsOnce(t *testing.T) {
+	rec := httptest.NewRecorder()
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusNotFound)
+		w.Write([]byte("abc"))
+		if _, _, err := http.NewResponseController(w).Hijack(); err == nil {
+			t.Error("Hijack did not fail")
+		}
+		if _, _, err := http.NewResponseController(w).Hijack(); err == nil {
+			t.Error("second Hijack did not fail")
+		}
+		w.Write([]byte("-after"))
+	}))
+	h.ServeHTTP(failHijackRecorder{rec}, httptest.NewRequest("GET", "/", nil))
+	if rec.Body.String() != "abc-after" || rec.Code != 404 {
+		t.Fatalf("got %d %q, want 404 \"abc-after\"", rec.Code, rec.Body.String())
+	}
+}
+
+func TestETagSuperfluousInvalidWriteHeaderIsIgnored(t *testing.T) {
+	rec := serveETag(ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusOK)
+		w.WriteHeader(0)
+		w.Write([]byte("b"))
+	})), "GET")
+	if rec.Code != 200 || rec.Body.String() != "b" {
+		t.Fatalf("got %d %q, want 200 \"b\"", rec.Code, rec.Body.String())
+	}
+
+	hr := &hijackRecorder{ResponseRecorder: httptest.NewRecorder()}
+	ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if _, _, err := http.NewResponseController(w).Hijack(); err != nil {
+			t.Error(err)
+		}
+		w.WriteHeader(0) // Ignored after Hijack, so no panic.
+	})).ServeHTTP(hr, httptest.NewRequest("GET", "/", nil))
+}
