+func TestETagTrailersPassThrough(t *testing.T) {
+	declared := func(code int) http.HandlerFunc {
+		return func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Trailer", "X-Sum")
+			w.WriteHeader(code)
+			w.Write([]byte("data"))
+			w.Header().Set("X-Sum", "abc")
+		}
+	}
+	prefixed := func(code int) http.HandlerFunc {
+		return func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set(http.TrailerPrefix+"X-Sum", "pending")
+			w.WriteHeader(code)
+			w.Write([]byte("data"))
+			w.Header().Set(http.TrailerPrefix+"X-Sum", "abc")
+		}
+	}
+	tests := []struct {
+		name string
+		h    http.HandlerFunc
+	}{
+		{"declared 200", declared(http.StatusOK)},
+		{"declared 404", declared(http.StatusNotFound)},
+		{"prefixed 200", prefixed(http.StatusOK)},
+		{"prefixed 404", prefixed(http.StatusNotFound)},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			want, _ := doServer(t, newServer(t, tt.h), "GET")
+			got, body := doServer(t, newServer(t, ETag(tt.h)), "GET")
+
+			if got.StatusCode != want.StatusCode || body != "data" {
+				t.Fatalf("code = %d, body = %q, want code %d", got.StatusCode, body, want.StatusCode)
+			}
+			if want.Trailer.Get("X-Sum") != "abc" {
+				t.Fatalf("plain server trailer X-Sum = %q, want %q", want.Trailer.Get("X-Sum"), "abc")
+			}
+			if got.Trailer.Get("X-Sum") != "abc" {
+				t.Fatalf("trailer X-Sum = %q, want %q", got.Trailer.Get("X-Sum"), "abc")
+			}
+		})
+	}
+}
