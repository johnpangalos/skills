+func TestETagDirectFlushHeldBack(t *testing.T) {
+	rec := httptest.NewRecorder()
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("a"))
+		w.(http.Flusher).Flush()
+		if rec.Flushed || rec.Body.Len() != 0 {
+			t.Errorf("response sent early: flushed = %v, body = %q", rec.Flushed, rec.Body.String())
+		}
+		w.Write([]byte("b"))
+	}))
+	h.ServeHTTP(rec, httptest.NewRequest("GET", "/", nil))
+
+	if rec.Body.String() != "ab" || rec.Header().Get("ETag") != etagTag("ab") {
+		t.Fatalf("body = %q, ETag = %q", rec.Body.String(), rec.Header().Get("ETag"))
+	}
+}
