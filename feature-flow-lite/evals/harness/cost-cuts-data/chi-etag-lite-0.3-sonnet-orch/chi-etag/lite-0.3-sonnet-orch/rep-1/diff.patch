+func TestETagWriterHasNoEscapeHatches(t *testing.T) {
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if _, ok := w.(http.Hijacker); !ok {
+			t.Error("writer does not implement http.Hijacker")
+		}
+		if _, ok := w.(http.Pusher); ok {
+			t.Error("writer implements http.Pusher")
+		}
+		if _, ok := w.(interface{ Unwrap() http.ResponseWriter }); ok {
+			t.Error("writer implements Unwrap() http.ResponseWriter")
+		}
+		rc := http.NewResponseController(w)
+		if err := rc.SetWriteDeadline(time.Now().Add(time.Minute)); !errors.Is(err, http.ErrNotSupported) {
+			t.Errorf("SetWriteDeadline err = %v, want ErrNotSupported", err)
+		}
+		w.Write([]byte("ok"))
+		conn, _, err := rc.Hijack()
+		if err == nil {
+			conn.Close()
+			t.Error("Hijack after Write succeeded")
+		}
+	}))
+	_, body := doServer(t, newServer(t, h), "GET")
+
+	if body != "ok" {
+		t.Fatalf("body = %q, want %q", body, "ok")
+	}
+}
