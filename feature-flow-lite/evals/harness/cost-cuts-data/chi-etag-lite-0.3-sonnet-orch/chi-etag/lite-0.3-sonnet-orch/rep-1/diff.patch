+func TestETagHeadMatchesPlainServer(t *testing.T) {
+	tests := []struct {
+		name string
+		h    http.HandlerFunc
+	}{
+		{"200 sniffed type", etagBody("hello")},
+		{"404 sniffed type", func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(http.StatusNotFound)
+			w.Write([]byte("missing"))
+		}},
+		{"handler Content-Length", func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Content-Length", "5")
+			w.Write([]byte("hello"))
+		}},
+		{"10000 byte body", etagBody(strings.Repeat("x", 10000))},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			want, _ := doServer(t, newServer(t, tt.h), "HEAD")
+			wrapped := newServer(t, ETag(tt.h))
+			got, body := doServer(t, wrapped, "HEAD")
+			get, _ := doServer(t, wrapped, "GET")
+
+			if got.StatusCode != want.StatusCode || body != "" {
+				t.Fatalf("HEAD code = %d, body = %q, want code %d", got.StatusCode, body, want.StatusCode)
+			}
+			for _, k := range []string{"Content-Length", "Content-Type"} {
+				if got.Header.Get(k) != want.Header.Get(k) {
+					t.Fatalf("HEAD %s = %q, want %q", k, got.Header.Get(k), want.Header.Get(k))
+				}
+			}
+			if got.Header.Get("ETag") != get.Header.Get("ETag") {
+				t.Fatalf("HEAD ETag = %q, GET ETag = %q", got.Header.Get("ETag"), get.Header.Get("ETag"))
+			}
+		})
+	}
+}
