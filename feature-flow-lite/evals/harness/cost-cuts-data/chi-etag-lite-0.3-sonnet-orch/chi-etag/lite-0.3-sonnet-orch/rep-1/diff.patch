+func TestETagUpgradeHijacksBeforeWrite(t *testing.T) {
+	upgrade := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		conn, _, err := http.NewResponseController(w).Hijack()
+		if err != nil {
+			t.Error(err)
+			return
+		}
+		defer conn.Close()
+		conn.Write([]byte("HTTP/1.1 101 Switching Protocols\r\nConnection: Upgrade\r\nUpgrade: websocket\r\n\r\n"))
+	})
+	want := rawUpgrade(t, newServer(t, upgrade))
+	got := rawUpgrade(t, newServer(t, ETag(upgrade)))
+
+	if got != want || got != "HTTP/1.1 101 Switching Protocols" {
+		t.Fatalf("status line = %q, want %q", got, want)
+	}
+}
+
+func TestETagHijackAfterWriteFails(t *testing.T) {
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("hello"))
+		conn, _, err := http.NewResponseController(w).Hijack()
+		if err == nil {
+			conn.Close()
+			t.Error("Hijack after Write succeeded")
+		}
+	}))
+	got, body := doServer(t, newServer(t, h), "GET")
+
+	if got.StatusCode != http.StatusOK || body != "hello" || got.Header.Get("ETag") != etagTag("hello") {
+		t.Fatalf("code = %d, body = %q, ETag = %q", got.StatusCode, body, got.Header.Get("ETag"))
+	}
+}
+
+func TestETagHijackUnsupportedWriter(t *testing.T) {
+	rec := httptest.NewRecorder()
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		conn, _, err := http.NewResponseController(w).Hijack()
+		if conn != nil {
+			conn.Close()
+		}
+		if !errors.Is(err, http.ErrNotSupported) {
+			t.Errorf("Hijack err = %v, want ErrNotSupported", err)
+		}
+		w.Write([]byte("ok"))
+	}))
+	h.ServeHTTP(rec, httptest.NewRequest("GET", "/", nil))
+
+	if rec.Body.String() != "ok" {
+		t.Fatalf("body = %q, want %q", rec.Body.String(), "ok")
+	}
+}
