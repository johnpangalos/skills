+func TestETagPanicPropagates(t *testing.T) {
+	for _, want := range []any{http.ErrAbortHandler, "boom"} {
+		rec := httptest.NewRecorder()
+		func() {
+			defer func() {
+				if got := recover(); got != want {
+					t.Fatalf("recovered %v, want %v", got, want)
+				}
+			}()
+			r := chi.NewRouter()
+			r.Use(ETag)
+			r.Get("/", func(w http.ResponseWriter, r *http.Request) {
+				w.Write([]byte("partial"))
+				panic(want)
+			})
+			r.ServeHTTP(rec, httptest.NewRequest("GET", "/", nil))
+		}()
+
+		if rec.Body.Len() != 0 || rec.Flushed || rec.Header().Get("ETag") != "" {
+			t.Fatalf("partial response written: body = %q, ETag = %q", rec.Body.String(), rec.Header().Get("ETag"))
+		}
+	}
+}
