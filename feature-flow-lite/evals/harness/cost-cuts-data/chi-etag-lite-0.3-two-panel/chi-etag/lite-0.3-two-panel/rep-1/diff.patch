+func TestETagIfNoneMatchParsing(t *testing.T) {
+	tests := []struct {
+		name  string
+		lines []string
+		tag   string
+		want  bool
+	}{
+		{"list member equals response", []string{`"x", W/"y" ,  "z"`}, `"z"`, true},
+		{"weak member matches strong response", []string{`"x", W/"y" ,  "z"`}, `"y"`, true},
+		{"weak response matches weak member", []string{`"x", W/"y" ,  "z"`}, `W/"y"`, true},
+		{"comma inside tag matches", []string{`"a,b"`}, `"a,b"`, true},
+		{"comma inside tag is one tag", []string{`"a,b"`}, `"a"`, false},
+		{"member after comma inside tag", []string{`"a,b", "c"`}, `"c"`, true},
+		{"empty", []string{""}, `"x"`, false},
+		{"only commas", []string{" , ,,"}, `"x"`, false},
+		{"unterminated", []string{`"unterminated`}, `"x"`, false},
+		{"weak prefix alone", []string{"W/"}, `"x"`, false},
+		{"bare token", []string{"xyz"}, `"xyz"`, false},
+		{"W is case sensitive", []string{`w/"x"`}, `"x"`, false},
+		{"star matches any response", []string{"*"}, `"x"`, true},
+		{"star matches malformed response", []string{"*"}, "abc", true},
+		{"star with trailing text is malformed", []string{"*x"}, `"*x"`, false},
+		{"malformed member does not hide the next", []string{`"a"b, "c"`}, `"c"`, true},
+		{"malformed response never matches a tag", []string{`"abc"`}, "abc", false},
+		{"space inside tag is invalid", []string{`"a b"`}, `"a b"`, false},
+		{"tabs and spaces around members", []string{"\t\"q\"\t,\t\"r\" "}, `"r"`, true},
+		{"second line is checked", []string{`"other"`, `"etag"`}, `"etag"`, true},
+		{"no lines", nil, `"x"`, false},
+	}
+	for _, c := range tests {
+		t.Run(c.name, func(t *testing.T) {
+			assertEqual(t, ifNoneMatch(c.lines, c.tag), c.want)
+		})
+	}
+}
