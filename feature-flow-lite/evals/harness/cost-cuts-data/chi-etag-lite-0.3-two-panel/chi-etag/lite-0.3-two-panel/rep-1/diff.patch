diff --git a/middleware/etag.go b/middleware/etag.go
new file mode 100644
index 0000000..f739808
--- /dev/null
+++ b/middleware/etag.go
@@ -0,0 +1,309 @@
+package middleware
+
+import (
+	"bufio"
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"net"
+	"net/http"
+	"strings"
+)
+
+// ETag is a middleware that adds a strong entity-tag to GET and HEAD responses
+// that finish with status 200 and have no ETag set by the handler. The tag is
+// the hex-encoded SHA-256 of the response body, except that a HEAD response with
+// no body gets no computed tag. If the request's If-None-Match
+// matches the response's ETag (computed or handler-set), the response is
+// 304 Not Modified with no body.
+//
+// The whole GET or HEAD response is buffered in memory before it is sent, so
+// large or streamed responses use memory proportional to their size. Flush commits
+// the status like net/http but sends nothing until the handler returns. Other
+// methods are passed through.
+//
+// Register ETag before (outside) any middleware that rewrites the response body,
+// such as Compress, e.g. r.Use(middleware.ETag, middleware.Compress(5)), so the
+// tag covers the bytes the client receives. NoCache removes
+// If-None-Match from the request and ETag from the response, so don't combine it
+// with ETag on the same routes.
+func ETag(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet && r.Method != http.MethodHead {
+			next.ServeHTTP(w, r)
+			return
+		}
+
+		ew := &etagResponseWriter{w: w}
+		next.ServeHTTP(ew, r)
+		ew.finish(r)
+	})
+}
+
+// etagResponseWriter buffers the handler's response so that it can be tagged
+// and possibly replaced by a 304 once the handler returns.
+type etagResponseWriter struct {
+	w        http.ResponseWriter
+	buf      bytes.Buffer
+	status   int
+	snapshot http.Header // header map as it was when the status was committed
+	sent     bool        // the committed response was written before Hijack
+	hijacked bool
+}
+
+func (ew *etagResponseWriter) Header() http.Header {
+	return ew.w.Header()
+}
+
+func (ew *etagResponseWriter) WriteHeader(code int) {
+	if ew.hijacked {
+		return
+	}
+	if code >= 100 && code <= 199 && code != http.StatusSwitchingProtocols && ew.status == 0 {
+		// Informational responses go out immediately and are not the final status.
+		ew.w.WriteHeader(code)
+		return
+	}
+	if ew.status != 0 {
+		return
+	}
+	ew.status = code
+	ew.snapshot = ew.w.Header().Clone()
+}
+
+func (ew *etagResponseWriter) Write(p []byte) (int, error) {
+	if ew.hijacked {
+		return 0, http.ErrHijacked
+	}
+	if ew.sent {
+		// Hijack failed after the committed response went out; keep streaming.
+		return ew.w.Write(p)
+	}
+	if ew.status == 0 {
+		ew.WriteHeader(http.StatusOK)
+	}
+	ew.buf.Write(p)
+	return len(p), nil
+}
+
+// Flush commits the status, as net/http does, but the body stays buffered until
+// the handler returns.
+func (ew *etagResponseWriter) Flush() {
+	if ew.status == 0 {
+		ew.WriteHeader(http.StatusOK)
+	}
+}
+
+func (ew *etagResponseWriter) Push(target string, opts *http.PushOptions) error {
+	if ps, ok := ew.w.(http.Pusher); ok {
+		return ps.Push(target, opts)
+	}
+	return errors.New("chi/middleware: http.Pusher is unavailable on the writer")
+}
+
+// Hijack sends a committed but unsent response first, as net/http would have,
+// then hands the connection to the handler.
+func (ew *etagResponseWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	if ew.hijacked {
+		return nil, nil, http.ErrHijacked
+	}
+	hj, ok := ew.w.(http.Hijacker)
+	if !ok {
+		return nil, nil, errors.New("chi/middleware: http.Hijacker is unavailable on the writer")
+	}
+	if ew.status != 0 && !ew.sent {
+		ew.restoreHeader()
+		ew.w.WriteHeader(ew.status)
+		ew.w.Write(ew.buf.Bytes())
+		ew.sent = true
+	}
+	conn, rw, err := hj.Hijack()
+	if err == nil {
+		ew.hijacked = true
+	}
+	return conn, rw, err
+}
+
+func (ew *etagResponseWriter) Unwrap() http.ResponseWriter {
+	return ew.w
+}
+
+// finish sends the buffered response. It is not deferred, so a panic in the
+// handler propagates without anything being written.
+func (ew *etagResponseWriter) finish(r *http.Request) {
+	if ew.sent || ew.hijacked {
+		return
+	}
+	if ew.status == 0 {
+		ew.WriteHeader(http.StatusOK)
+	}
+	trailers := ew.trailers()
+	ew.restoreHeader()
+	h := ew.w.Header()
+
+	if ew.status != http.StatusOK {
+		ew.w.WriteHeader(ew.status)
+		ew.sendTrailers(trailers)
+		ew.w.Write(ew.buf.Bytes())
+		return
+	}
+
+	tag := ew.snapshot.Get("Etag")
+	if tag == "" && !(r.Method == http.MethodHead && ew.buf.Len() == 0) {
+		sum := sha256.Sum256(ew.buf.Bytes())
+		tag = `"` + hex.EncodeToString(sum[:]) + `"`
+		h.Set("ETag", tag)
+	}
+
+	if ifNoneMatch(r.Header.Values("If-None-Match"), tag) {
+		h.Del("Content-Type")
+		h.Del("Content-Length")
+		h.Del("Content-Encoding")
+		h.Del("Last-Modified")
+		ew.w.WriteHeader(http.StatusNotModified)
+		return
+	}
+
+	ew.w.WriteHeader(http.StatusOK)
+	ew.sendTrailers(trailers)
+	ew.w.Write(ew.buf.Bytes())
+}
+
+// restoreHeader resets the header map to the snapshot taken when the status was
+// committed. net/http keeps http.TrailerPrefix keys out of the header block and
+// uses them to choose chunked encoding, so they are restored too.
+func (ew *etagResponseWriter) restoreHeader() {
+	h := ew.w.Header()
+	clear(h)
+	for k, v := range ew.snapshot {
+		h[k] = v
+	}
+}
+
+// trailers returns the values set on the live header map that are trailers.
+// Call it before restoreHeader.
+func (ew *etagResponseWriter) trailers() http.Header {
+	declared := declaredTrailers(ew.snapshot)
+	trailers := http.Header{}
+	for k, v := range ew.w.Header() {
+		if isTrailer(k, declared) {
+			trailers[k] = v
+		}
+	}
+	return trailers
+}
+
+// sendTrailers puts trailer values back into the header map after the header
+// block is written; net/http reads them when the handler returns.
+func (ew *etagResponseWriter) sendTrailers(trailers http.Header) {
+	h := ew.w.Header()
+	for k, v := range trailers {
+		h[k] = v
+	}
+}
+
+// isTrailer reports whether header key k is a trailer, given the declared trailer names.
+func isTrailer(k string, declared map[string]bool) bool {
+	return strings.HasPrefix(k, http.TrailerPrefix) || declared[k]
+}
+
+// declaredTrailers returns the canonical names listed in the Trailer header of h.
+func declaredTrailers(h http.Header) map[string]bool {
+	names := make(map[string]bool)
+	for _, line := range h.Values("Trailer") {
+		for _, name := range strings.Split(line, ",") {
+			names[http.CanonicalHeaderKey(strings.TrimSpace(name))] = true
+		}
+	}
+	return names
+}
+
+// ifNoneMatch reports whether any member of the If-None-Match field lines
+// matches the entity-tag tag using weak comparison (RFC 9110 §13.1.2).
+func ifNoneMatch(lines []string, tag string) bool {
+	want := opaqueTag(tag)
+	for _, line := range lines {
+		rest := line
+		for {
+			rest = strings.TrimLeft(rest, " \t,")
+			if rest == "" {
+				break
+			}
+			value, next, ok := cutListMember(rest)
+			rest = next
+			if ok && (value == "*" || value == want) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// cutListMember reads the If-None-Match list member at the start of s, which
+// must not begin with whitespace or a comma. It returns the member's value ("*"
+// or an opaque-tag with any W/ prefix dropped) and the text after it. A
+// malformed member has no value, and the text resumes after the next comma.
+func cutListMember(s string) (value, rest string, ok bool) {
+	var n int
+	if s[0] == '*' {
+		value, n = "*", 1
+	} else {
+		body := strings.TrimPrefix(s, "W/")
+		tag, m, valid := parseOpaqueTag(body)
+		if !valid {
+			return "", skipPastComma(s, 0), false
+		}
+		value, n = tag, len(s)-len(body)+m
+	}
+	tail := strings.TrimLeft(s[n:], " \t")
+	if tail != "" && tail[0] != ',' {
+		return "", skipPastComma(s, n), false
+	}
+	return value, tail, true
+}
+
+// skipPastComma returns the text after the first comma in s at or after from,
+// or "" if there is none.
+func skipPastComma(s string, from int) string {
+	i := strings.IndexByte(s[from:], ',')
+	if i < 0 {
+		return ""
+	}
+	return s[from+i+1:]
+}
+
+// opaqueTag returns the opaque-tag of the entity-tag tag, ignoring a W/ prefix,
+// or "" if tag is not a valid entity-tag.
+func opaqueTag(tag string) string {
+	body := strings.TrimPrefix(tag, "W/")
+	opaque, n, ok := parseOpaqueTag(body)
+	if !ok || n != len(body) {
+		return ""
+	}
+	return opaque
+}
+
+// parseOpaqueTag reads a quoted string made of etagc characters at the start
+// of s. It returns the quoted string and its length in bytes.
+func parseOpaqueTag(s string) (string, int, bool) {
+	if !strings.HasPrefix(s, `"`) {
+		return "", 0, false
+	}
+	end := strings.IndexByte(s[1:], '"')
+	if end < 0 {
+		return "", 0, false
+	}
+	for i := 1; i <= end; i++ {
+		if !isEtagc(s[i]) {
+			return "", 0, false
+		}
+	}
+	return s[:end+2], end + 2, true
+}
+
+// isEtagc reports whether c is an etagc character (RFC 9110 §8.8.3): any
+// visible ASCII except the double quote, or any obs-text byte.
+func isEtagc(c byte) bool {
+	return c == 0x21 || (c >= 0x23 && c <= 0x7E) || c >= 0x80
+}
diff --git a/middleware/etag_test.go b/middleware/etag_test.go
new file mode 100644
index 0000000..ea49555
--- /dev/null
+++ b/middleware/etag_test.go
@@ -0,0 +1,888 @@
+package middleware
+
+import (
+	"bufio"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/go-chi/chi/v5"
+)
+
+// etagOf is the tag ETag must compute for body.
+func etagOf(body string) string {
+	sum := sha256.Sum256([]byte(body))
+	return `"` + hex.EncodeToString(sum[:]) + `"`
+}
+
+func etagServer(t *testing.T, h http.HandlerFunc) *httptest.Server {
+	t.Helper()
+	ts := httptest.NewServer(ETag(h))
+	t.Cleanup(ts.Close)
+	return ts
+}
+
+// etagServeGet runs h behind ETag for a GET request, recording the response in w.
+func etagServeGet(w http.ResponseWriter, h http.HandlerFunc) {
+	ETag(h).ServeHTTP(w, httptest.NewRequest(http.MethodGet, "/", nil))
+}
+
+// etagRequest sends method to ts, adding one If-None-Match line per inm value.
+func etagRequest(t *testing.T, ts *httptest.Server, method string, inm ...string) (*http.Response, string) {
+	t.Helper()
+	req, err := http.NewRequest(method, ts.URL+"/", nil)
+	assertNoError(t, err)
+	for _, v := range inm {
+		req.Header.Add("If-None-Match", v)
+	}
+	resp, err := http.DefaultClient.Do(req)
+	assertNoError(t, err)
+	defer resp.Body.Close()
+	body, err := io.ReadAll(resp.Body)
+	assertNoError(t, err)
+	return resp, string(body)
+}
+
+// etagPlainWriter hides every optional interface of the writer it wraps.
+type etagPlainWriter struct {
+	http.ResponseWriter
+}
+
+// etagHijackWriter records calls to Hijack on top of a recorder.
+type etagHijackWriter struct {
+	*httptest.ResponseRecorder
+	hijacked bool
+}
+
+func (w *etagHijackWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	w.hijacked = true
+	return nil, nil, nil
+}
+
+// etagPushWriter records the targets pushed on top of a recorder.
+type etagPushWriter struct {
+	*httptest.ResponseRecorder
+	pushed []string
+}
+
+func (w *etagPushWriter) Push(target string, opts *http.PushOptions) error {
+	w.pushed = append(w.pushed, target)
+	return nil
+}
+
+// etagInfoWriter records 1xx codes and the Link header at the time they are sent.
+type etagInfoWriter struct {
+	*httptest.ResponseRecorder
+	infoCodes []int
+	infoLink  string
+}
+
+func (w *etagInfoWriter) WriteHeader(code int) {
+	if code >= 100 && code <= 199 {
+		w.infoCodes = append(w.infoCodes, code)
+		w.infoLink = w.Header().Get("Link")
+		return
+	}
+	w.ResponseRecorder.WriteHeader(code)
+}
+
+func TestETagPassesOtherMethodsThrough(t *testing.T) {
+	for _, method := range []string{http.MethodPost, http.MethodPut, http.MethodDelete, "get"} {
+		t.Run(method, func(t *testing.T) {
+			rec := httptest.NewRecorder()
+			req := httptest.NewRequest(method, "/", nil)
+			req.Header.Set("If-None-Match", etagOf("hi"))
+			var got http.ResponseWriter
+			ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				got = w
+				w.Header().Set("Content-Type", "text/plain")
+				w.WriteHeader(http.StatusCreated)
+				w.Write([]byte("hi"))
+			})).ServeHTTP(rec, req)
+
+			assertEqual(t, got == rec, true)
+			assertEqual(t, rec.Code, http.StatusCreated)
+			assertEqual(t, rec.Body.String(), "hi")
+			assertEqual(t, rec.Header().Get("Content-Type"), "text/plain")
+			assertEqual(t, rec.Header().Get("ETag"), "")
+		})
+	}
+}
+
+func TestETagComputesStrongTag(t *testing.T) {
+	ts := etagServer(t, func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "text/plain")
+		w.Header().Set("Cache-Control", "max-age=60")
+		w.Header().Add("Set-Cookie", "a=1")
+		w.Write([]byte("hello"))
+	})
+
+	resp, body := etagRequest(t, ts, http.MethodGet)
+	assertEqual(t, resp.StatusCode, http.StatusOK)
+	assertEqual(t, body, "hello")
+	assertEqual(t, resp.Header.Get("ETag"), etagOf("hello"))
+	assertEqual(t, resp.Header.Get("Content-Type"), "text/plain")
+	assertEqual(t, resp.Header.Get("Cache-Control"), "max-age=60")
+	assertEqual(t, resp.Header.Values("Set-Cookie"), []string{"a=1"})
+}
+
+func TestETagTagFollowsBody(t *testing.T) {
+	tagFor := func(body string) string {
+		ts := etagServer(t, func(w http.ResponseWriter, r *http.Request) {
+			w.Write([]byte(body))
+		})
+		resp, _ := etagRequest(t, ts, http.MethodGet)
+		return resp.Header.Get("ETag")
+	}
+
+	assertEqual(t, tagFor("abc"), tagFor("abc"))
+	assertEqual(t, tagFor("abc") != tagFor("abd"), true)
+}
+
+func TestETagManySmallWrites(t *testing.T) {
+	ts := etagServer(t, func(w http.ResponseWriter, r *http.Request) {
+		for _, s := range []string{"a", "b", "c", "d"} {
+			w.Write([]byte(s))
+		}
+	})
+
+	resp, body := etagRequest(t, ts, http.MethodGet)
+	assertEqual(t, body, "abcd")
+	assertEqual(t, resp.Header.Get("ETag"), etagOf("abcd"))
+}
+
+func TestETagEmptyBody(t *testing.T) {
+	handlers := map[string]http.HandlerFunc{
+		"no writes": func(w http.ResponseWriter, r *http.Request) {},
+		"explicit 200": func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(http.StatusOK)
+		},
+	}
+	for name, h := range handlers {
+		t.Run(name, func(t *testing.T) {
+			ts := etagServer(t, h)
+			resp, body := etagRequest(t, ts, http.MethodGet)
+			assertEqual(t, resp.StatusCode, http.StatusOK)
+			assertEqual(t, body, "")
+			assertEqual(t, resp.Header.Get("ETag"), etagOf(""))
+		})
+	}
+}
+
+func TestETagLargeBody(t *testing.T) {
+	big := strings.Repeat("0123456789abcdef", 1<<19) // 8 MiB
+	ts := etagServer(t, func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte(big))
+	})
+
+	resp, body := etagRequest(t, ts, http.MethodGet)
+	if body != big {
+		t.Fatalf("body mismatch: got %d bytes, want %d", len(body), len(big))
+	}
+	assertEqual(t, resp.Header.Get("ETag"), etagOf(big))
+}
+
+func TestETagKeepsHandlerSetTag(t *testing.T) {
+	tests := []struct {
+		name string
+		tag  string
+		inm  string
+		want int
+	}{
+		{"strong", `"custom"`, `"custom"`, http.StatusNotModified},
+		{"weak is kept and matches weakly", `W/"v1"`, `"v1"`, http.StatusNotModified},
+		{"malformed is kept and never matches", `abc`, `abc`, http.StatusOK},
+		{"malformed matches only star", `abc`, `*`, http.StatusNotModified},
+	}
+	for _, c := range tests {
+		t.Run(c.name, func(t *testing.T) {
+			ts := etagServer(t, func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("ETag", c.tag)
+				w.Write([]byte("body"))
+			})
+
+			resp, body := etagRequest(t, ts, http.MethodGet)
+			assertEqual(t, resp.Header.Get("ETag"), c.tag)
+			assertEqual(t, body, "body")
+
+			resp, _ = etagRequest(t, ts, http.MethodGet, c.inm)
+			assertEqual(t, resp.StatusCode, c.want)
+			assertEqual(t, resp.Header.Get("ETag"), c.tag)
+		})
+	}
+}
+
+func TestETagHeadSameAsGet(t *testing.T) {
+	ts := etagServer(t, func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("hello"))
+	})
+
+	getResp, _ := etagRequest(t, ts, http.MethodGet)
+	headResp, headBody := etagRequest(t, ts, http.MethodHead)
+	assertEqual(t, headResp.StatusCode, http.StatusOK)
+	assertEqual(t, headResp.Header.Get("ETag"), getResp.Header.Get("ETag"))
+	assertEqual(t, headBody, "")
+
+	resp, body := etagRequest(t, ts, http.MethodHead, etagOf("hello"))
+	assertEqual(t, resp.StatusCode, http.StatusNotModified)
+	assertEqual(t, body, "")
+}
+
+func TestETagHeadRoutedToGetHandler(t *testing.T) {
+	r := chi.NewRouter()
+	r.Use(GetHead, ETag)
+	r.Get("/", func(w http.ResponseWriter, req *http.Request) {
+		w.Write([]byte("hello"))
+	})
+	ts := httptest.NewServer(r)
+	t.Cleanup(ts.Close)
+
+	getResp, _ := etagRequest(t, ts, http.MethodGet)
+	headResp, headBody := etagRequest(t, ts, http.MethodHead)
+	assertEqual(t, headResp.Header.Get("ETag"), etagOf("hello"))
+	assertEqual(t, headResp.Header.Get("ETag"), getResp.Header.Get("ETag"))
+	assertEqual(t, headBody, "")
+}
+
+func TestETagHeadKeepsContentLengthWithoutBody(t *testing.T) {
+	ts := etagServer(t, func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Length", "1234")
+	})
+
+	resp, body := etagRequest(t, ts, http.MethodHead)
+	assertEqual(t, resp.StatusCode, http.StatusOK)
+	assertEqual(t, resp.Header.Get("Content-Length"), "1234")
+	assertEqual(t, resp.Header.Get("ETag"), "")
+	assertEqual(t, body, "")
+}
+
+func TestETagHeadWithoutBodyGetsNoTag(t *testing.T) {
+	dir := t.TempDir()
+	assertNoError(t, os.WriteFile(filepath.Join(dir, "a.txt"), []byte("alpha"), 0o644))
+	assertNoError(t, os.WriteFile(filepath.Join(dir, "b.txt"), []byte("beta"), 0o644))
+	ts := httptest.NewServer(ETag(http.FileServer(http.Dir(dir))))
+	t.Cleanup(ts.Close)
+
+	head := func(path, inm string) *http.Response {
+		req, err := http.NewRequest(http.MethodHead, ts.URL+path, nil)
+		assertNoError(t, err)
+		if inm != "" {
+			req.Header.Set("If-None-Match", inm)
+		}
+		resp, err := http.DefaultClient.Do(req)
+		assertNoError(t, err)
+		resp.Body.Close()
+		return resp
+	}
+
+	for _, path := range []string{"/a.txt", "/b.txt"} {
