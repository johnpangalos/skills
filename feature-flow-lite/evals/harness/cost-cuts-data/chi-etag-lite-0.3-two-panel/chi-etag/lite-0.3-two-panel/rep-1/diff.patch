+// etagRequestEncoding sends a GET with the given Accept-Encoding and optional If-None-Match.
+func etagRequestEncoding(t *testing.T, ts *httptest.Server, encoding, inm string) (*http.Response, string) {
+	t.Helper()
+	req, err := http.NewRequest(http.MethodGet, ts.URL+"/", nil)
+	assertNoError(t, err)
+	req.Header.Set("Accept-Encoding", encoding)
+	if inm != "" {
+		req.Header.Set("If-None-Match", inm)
+	}
+	resp, err := http.DefaultClient.Do(req)
+	assertNoError(t, err)
+	defer resp.Body.Close()
+	body, err := io.ReadAll(resp.Body)
+	assertNoError(t, err)
+	return resp, string(body)
+}
+
+// etagRawGet sends a raw HTTP/1.1 GET to ts and returns the bytes the server
+// wrote, without the Date line.
+func etagRawGet(t *testing.T, ts *httptest.Server, inm string) string {
+	t.Helper()
+	conn, err := net.Dial("tcp", ts.Listener.Addr().String())
+	assertNoError(t, err)
+	defer conn.Close()
+	assertNoError(t, conn.SetDeadline(time.Now().Add(5*time.Second)))
+	_, err = io.WriteString(conn, "GET / HTTP/1.1\r\nHost: example\r\nConnection: close\r\nIf-None-Match: "+inm+"\r\n\r\n")
+	assertNoError(t, err)
+	raw, err := io.ReadAll(conn)
+	assertNoError(t, err)
+	var kept []string
+	for _, line := range strings.SplitAfter(string(raw), "\n") {
+		if !strings.HasPrefix(line, "Date: ") {
+			kept = append(kept, line)
+		}
+	}
+	return strings.Join(kept, "")
+}
