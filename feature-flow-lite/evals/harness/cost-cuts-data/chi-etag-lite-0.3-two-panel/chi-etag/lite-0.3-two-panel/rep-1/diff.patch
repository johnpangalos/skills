+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set(http.TrailerPrefix+"X-T", "early")
+				w.WriteHeader(c.status)
+				w.Write([]byte("a"))
+				if c.late {
+					w.Header().Set(http.TrailerPrefix+"X-T", "late")
+				}
+			})
+			plain := httptest.NewServer(handler)
+			t.Cleanup(plain.Close)
+			tagged := etagServer(t, handler)
+
+			for _, ts := range []*httptest.Server{plain, tagged} {
+				resp, body := etagRequest(t, ts, http.MethodGet)
+				assertEqual(t, resp.StatusCode, c.status)
+				assertEqual(t, body, "a")
+				assertEqual(t, resp.ContentLength, int64(-1))
+				assertEqual(t, resp.Trailer.Get("X-T"), c.wantTrailer)
+			}
+		})
+	}
+}
+
+func TestETagSecondHijackFailsAndWritesStop(t *testing.T) {
+	rec := &etagHijackWriter{ResponseRecorder: httptest.NewRecorder()}
+	etagServeGet(rec, func(w http.ResponseWriter, r *http.Request) {
+		if _, _, err := w.(http.Hijacker).Hijack(); err != nil {
+			t.Errorf("first Hijack() error: %v", err)
+		}
+		if _, _, err := w.(http.Hijacker).Hijack(); err != http.ErrHijacked {
+			t.Errorf("second Hijack() error = %v; want http.ErrHijacked", err)
+		}
+		n, err := w.Write([]byte("after hijack"))
+		if n != 0 || err != http.ErrHijacked {
+			t.Errorf("Write() = %d, %v; want 0, http.ErrHijacked", n, err)
+		}
+	})
+
+	assertEqual(t, rec.hijacked, true)
+	assertEqual(t, rec.Body.Len(), 0)
+	assertEqual(t, rec.Header().Get("ETag"), "")
+}
+
+// etagFailHijackWriter is a writer whose Hijack always fails.
+type etagFailHijackWriter struct {
+	*httptest.ResponseRecorder
+}
+
+func (w etagFailHijackWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	return nil, nil, errors.New("hijack refused")
+}
+
+func TestETagFailedHijackAfterCommitKeepsStreaming(t *testing.T) {
+	rec := etagFailHijackWriter{httptest.NewRecorder()}
+	etagServeGet(rec, func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("X-A", "1")
+		w.WriteHeader(http.StatusOK)
+		w.Write([]byte("pre-"))
+		if _, _, err := w.(http.Hijacker).Hijack(); err == nil {
+			t.Errorf("Hijack() error = nil; want error")
+		}
+		w.Write([]byte("post"))
+	})
+
+	assertEqual(t, rec.Code, http.StatusOK)
+	assertEqual(t, rec.Header().Get("X-A"), "1")
+	assertEqual(t, rec.Header().Get("ETag"), "")
+	assertEqual(t, rec.Body.String(), "pre-post")
+}
