+func TestETagFlushSendsNothingEarly(t *testing.T) {
+	for _, method := range []string{http.MethodGet, http.MethodHead} {
+		rec := httptest.NewRecorder()
+		h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Write([]byte("a"))
+			w.(http.Flusher).Flush()
+			if rec.Body.Len() != 0 || rec.Flushed {
+				t.Errorf("%s: Flusher.Flush sent data before the handler returned", method)
+			}
+
+			w.Write([]byte("b"))
+			if err := http.NewResponseController(w).Flush(); err != nil {
+				t.Errorf("%s: ResponseController.Flush() = %v, want nil", method, err)
+			}
+			if rec.Body.Len() != 0 || rec.Flushed {
+				t.Errorf("%s: ResponseController.Flush sent data before the handler returned", method)
+			}
+		})
+
+		ETag(h).ServeHTTP(rec, httptest.NewRequest(method, "/", nil))
+
+		if rec.Flushed {
+			t.Errorf("%s: recorder was flushed, want the buffer kept", method)
+		}
+		if got := rec.Header().Get("ETag"); got == "" {
+			t.Errorf("%s: ETag missing after flush", method)
+		}
+	}
+}
