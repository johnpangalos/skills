+func TestETagNonOKStatusUnchanged(t *testing.T) {
+	cases := []struct {
+		status int
+		body   string
+	}{
+		{http.StatusCreated, "created"},
+		{http.StatusNoContent, ""},
+		{http.StatusMovedPermanently, ""},
+		{http.StatusNotFound, "missing"},
+		{http.StatusInternalServerError, "boom"},
+	}
+
+	for _, tc := range cases {
+		for _, method := range []string{http.MethodGet, http.MethodHead} {
+			h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("ETag", `"b"`)
+				w.WriteHeader(tc.status)
+				w.Write([]byte(tc.body))
+			})
+
+			rec := serveETag(h, method, `"b"`)
+
+			if rec.Code != tc.status {
+				t.Errorf("%s status = %d, want %d", method, rec.Code, tc.status)
+			}
+			if method == http.MethodGet && rec.Body.String() != tc.body {
+				t.Errorf("%s %d body = %q, want %q", method, tc.status, rec.Body.String(), tc.body)
+			}
+			if got := rec.Header().Get("ETag"); got != `"b"` {
+				t.Errorf("%s %d ETag = %q, want handler value", method, tc.status, got)
+			}
+		}
+	}
+}
