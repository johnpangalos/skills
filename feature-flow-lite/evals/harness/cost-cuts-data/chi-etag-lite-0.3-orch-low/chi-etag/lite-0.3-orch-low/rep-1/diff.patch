+func TestETagIfNoneMatchList(t *testing.T) {
+	cases := []struct {
+		name        string
+		ifNoneMatch string
+		etag        string
+		want        int
+	}{
+		{"star matches", "*", `"b"`, http.StatusNotModified},
+		{"list with OWS and weak member", `"a", W/"b" , "c"`, `"b"`, http.StatusNotModified},
+		{"weak request matches strong response", `W/"b"`, `"b"`, http.StatusNotModified},
+		{"strong request matches weak response", `"b"`, `W/"b"`, http.StatusNotModified},
+		{"weak on both sides", `W/"b"`, `W/"b"`, http.StatusNotModified},
+		{"opaque tag is byte exact", `"B"`, `"b"`, http.StatusOK},
+		{"weak prefix is case sensitive", `w/"b"`, `"b"`, http.StatusOK},
+		{"no member matches", `"a", "c"`, `"b"`, http.StatusOK},
+		{"unquoted member", `abc`, `"b"`, http.StatusOK},
+		{"unquoted response etag never matches", `b`, `b`, http.StatusOK},
+		{"unterminated quote", `"b`, `"b"`, http.StatusOK},
+		{"empty members", `,,`, `"b"`, http.StatusOK},
+		{"whitespace only", `   `, `"b"`, http.StatusOK},
+		{"valid member beside malformed", `abc, ,, "b", "unterminated`, `"b"`, http.StatusNotModified},
+		{"quoted comma is one tag", `"a,b"`, `"a,b"`, http.StatusNotModified},
+		{"comma inside quotes is not a separator", `"a", "b,c"`, `"b"`, http.StatusOK},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			rec := serveETag(etagSetHandler(tc.etag), http.MethodGet, tc.ifNoneMatch)
+
+			if rec.Code != tc.want {
+				t.Errorf("status = %d, want %d", rec.Code, tc.want)
+			}
+			if got := rec.Header().Get("ETag"); got != tc.etag {
+				t.Errorf("ETag = %q, want handler value %q", got, tc.etag)
+			}
+		})
+	}
+}
