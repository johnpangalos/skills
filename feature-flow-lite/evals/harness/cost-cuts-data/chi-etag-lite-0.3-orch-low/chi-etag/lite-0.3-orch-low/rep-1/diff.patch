+// pushWriter is a ResponseWriter whose underlying writer implements http.Pusher.
+type pushWriter struct {
+	*httptest.ResponseRecorder
+	pushed []string
+}
+
+func (pw *pushWriter) Push(target string, opts *http.PushOptions) error {
+	pw.pushed = append(pw.pushed, target)
+	return nil
+}
+
+func TestETagForwardsPushToPusher(t *testing.T) {
+	pw := &pushWriter{ResponseRecorder: httptest.NewRecorder()}
+	var err error
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		err = w.(http.Pusher).Push("/style.css", nil)
+		w.Write([]byte("hello"))
+	})
+
+	ETag(h).ServeHTTP(pw, httptest.NewRequest(http.MethodGet, "/", nil))
+
+	if err != nil {
+		t.Errorf("Push() = %v, want nil", err)
+	}
+	if len(pw.pushed) != 1 || pw.pushed[0] != "/style.css" {
+		t.Errorf("pushed = %v, want [/style.css]", pw.pushed)
+	}
+}
