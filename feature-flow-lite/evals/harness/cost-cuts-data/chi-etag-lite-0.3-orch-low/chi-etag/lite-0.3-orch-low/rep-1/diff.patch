+func TestETagHijackForwardsAndSendsNothing(t *testing.T) {
+	const raw = "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nhi"
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("buffered"))
+		conn, rw, err := w.(http.Hijacker).Hijack()
+		if err != nil {
+			t.Errorf("Hijack() = %v, want nil", err)
+			return
+		}
+		defer conn.Close()
+		rw.WriteString(raw)
+		rw.Flush()
+	})
+	srv := httptest.NewServer(ETag(h))
+	t.Cleanup(srv.Close)
+
+	conn, err := net.Dial("tcp", srv.Listener.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	io.WriteString(conn, "GET / HTTP/1.1\r\nHost: test\r\n\r\n")
+	conn.SetReadDeadline(time.Now().Add(5 * time.Second))
+
+	got, err := io.ReadAll(conn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(got) != raw {
+		t.Errorf("wire bytes = %q, want only the handler's raw response %q", got, raw)
+	}
+}
