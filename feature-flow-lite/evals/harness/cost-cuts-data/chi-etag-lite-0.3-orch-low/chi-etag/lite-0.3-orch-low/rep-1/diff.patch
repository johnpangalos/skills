+func TestETagTrailersReachClient(t *testing.T) {
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Trailer", "X-Declared")
+		w.WriteHeader(http.StatusOK)
+		w.Write([]byte("hello"))
+		w.Header().Set("X-Declared", "d")
+		w.Header().Set(http.TrailerPrefix+"X-Prefixed", "p")
+	})
+
+	resp, body := liveResponse(t, ETag(h), http.MethodGet)
+
+	if body != "hello" {
+		t.Errorf("body = %q, want %q", body, "hello")
+	}
+	if got := resp.Trailer.Get("X-Declared"); got != "d" {
+		t.Errorf("declared trailer = %q, want d", got)
+	}
+	if got := resp.Trailer.Get("X-Prefixed"); got != "p" {
+		t.Errorf("prefixed trailer = %q, want p", got)
+	}
+	if got := resp.Header.Get("Content-Length"); got != "" {
+		t.Errorf("Content-Length = %q, want none when trailers are declared", got)
+	}
+}
