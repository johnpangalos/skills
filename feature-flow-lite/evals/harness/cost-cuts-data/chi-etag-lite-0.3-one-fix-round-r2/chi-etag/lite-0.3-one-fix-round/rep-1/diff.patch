+			w.Write([]byte("body"))
+			w.Header().Set("X-Checksum", "abc")
+		}, "", "abc"},
+		{"early header value, late trailer", func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Trailer", "X-Checksum")
+			w.Header().Set("X-Checksum", "early")
+			w.WriteHeader(http.StatusOK)
+			w.Header().Set("X-Checksum", "late")
+			w.Write([]byte("body"))
+		}, "early", "late"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			ts := httptest.NewServer(ETag(tt.h))
+			defer ts.Close()
+
+			resp, err := http.Get(ts.URL)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer resp.Body.Close()
+			if _, err := io.ReadAll(resp.Body); err != nil {
+				t.Fatal(err)
+			}
+			if got := resp.Header.Get("X-Checksum"); got != tt.wantHeader {
+				t.Errorf("expected header X-Checksum %q, got %q", tt.wantHeader, got)
+			}
+			if got := resp.Trailer.Get("X-Checksum"); got != tt.wantTrailer {
+				t.Errorf("expected trailer X-Checksum %q, got %q", tt.wantTrailer, got)
+			}
+		})
+	}
+}
