+		headers = append(headers, line)
+	}
+	if !slices.Contains(headers, "Upgrade: raw\r\n") {
+		t.Fatalf("expected Upgrade header in 101 response, got %q", headers)
+	}
+	raw := make([]byte, 3)
+	if _, err := io.ReadFull(br, raw); err != nil {
+		t.Fatal(err)
+	}
+	if string(raw) != "RAW" {
+		t.Fatalf("expected raw bytes RAW after the 101 headers, got %q", raw)
