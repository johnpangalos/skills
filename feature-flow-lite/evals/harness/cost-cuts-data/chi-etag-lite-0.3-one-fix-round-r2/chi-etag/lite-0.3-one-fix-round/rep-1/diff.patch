+	fmt.Fprint(conn, "GET / HTTP/1.1\r\nHost: example\r\nConnection: Upgrade\r\nUpgrade: raw\r\n\r\n")
+
+	br := bufio.NewReader(conn)
+	status, err := br.ReadString('\n')
+	if err != nil {
+		t.Fatal(err)
+	}
+	if status != "HTTP/1.1 101 Switching Protocols\r\n" {
+		t.Fatalf("expected 101 status line, got %q", status)
+	}
+	var headers []string
+	for {
+		line, err := br.ReadString('\n')
+		if err != nil {
