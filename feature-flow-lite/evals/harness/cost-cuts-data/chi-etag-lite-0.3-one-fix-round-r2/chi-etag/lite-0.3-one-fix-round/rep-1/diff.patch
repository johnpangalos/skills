diff --git a/middleware/etag.go b/middleware/etag.go
new file mode 100644
index 0000000..3cb95bf
--- /dev/null
+++ b/middleware/etag.go
@@ -0,0 +1,276 @@
+package middleware
+
+import (
+	"bufio"
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"net"
+	"net/http"
+	"slices"
+	"strings"
+)
+
+// ETag sets an ETag header on GET and HEAD responses and answers conditional
+// requests with 304 Not Modified.
+//
+// The response is buffered until the handler returns, so nothing reaches the
+// client before the final status is known, and Flush does nothing for these
+// requests. Only a 200 response is tagged. If the handler did not set a
+// non-empty ETag header, a strong tag is computed from the full body: the
+// SHA-256 of the body bytes, hex-encoded and double-quoted. For HEAD requests
+// the tag covers whatever the handler wrote, so GET and HEAD share a tag. A HEAD
+// response with no body bytes gets no computed tag.
+//
+// When If-None-Match matches the tag by weak comparison, or is "*", the
+// response becomes 304 Not Modified with no body. As in net/http, it keeps the
+// ETag and the handler's other headers but drops Content-Type, Content-Length
+// and Content-Encoding, and drops Last-Modified only when an ETag is present.
+// Responses with any other final status
+// are sent unchanged. Other methods are passed through untouched.
+//
+// Place ETag outside Compress if the tag should cover the encoded bytes. Place
+// ETag outside NoCache too, because NoCache deletes conditional request headers
+// and ETag would otherwise never see If-None-Match.
+func ETag(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet && r.Method != http.MethodHead {
+			next.ServeHTTP(w, r)
+			return
+		}
+		ew := &etagWriter{
+			ResponseWriter: w,
+			head:           r.Method == http.MethodHead,
+			inm:            slices.Clone(r.Header.Values("If-None-Match")),
+		}
+		next.ServeHTTP(ew, r)
+		ew.finish()
+	})
+}
+
+// etagWriter buffers a response until the handler returns, so ETag can choose
+// the final status and headers.
+type etagWriter struct {
+	http.ResponseWriter
+	body        bytes.Buffer
+	status      int
+	header      http.Header // header snapshot taken when the status was decided
+	wroteHeader bool
+	hijacked    bool
+	head        bool
+	inm         []string // If-None-Match lines as the request carried them
+}
+
+// WriteHeader records the first non-1xx status and snapshots the headers.
+// Informational 1xx responses (other than 101) are forwarded immediately.
+func (w *etagWriter) WriteHeader(code int) {
+	if w.wroteHeader {
+		return
+	}
+	if code >= 100 && code <= 199 && code != http.StatusSwitchingProtocols {
+		w.ResponseWriter.WriteHeader(code)
+		return
+	}
+	w.wroteHeader = true
+	w.status = code
+	w.header = w.ResponseWriter.Header().Clone()
+}
+
+func (w *etagWriter) Write(p []byte) (int, error) {
+	if !w.wroteHeader {
+		w.WriteHeader(http.StatusOK)
+	}
+	return w.body.Write(p)
+}
+
+// Flush does nothing: a buffered response is only sent once the handler returns.
+func (w *etagWriter) Flush() {}
+
+func (w *etagWriter) Unwrap() http.ResponseWriter {
+	return w.ResponseWriter
+}
+
+// Hijack sends the status, headers and body already decided, then hijacks the
+// connection. Nothing more is written after a successful hijack.
+func (w *etagWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	hj, ok := w.ResponseWriter.(http.Hijacker)
+	if !ok {
+		return nil, nil, errors.New("chi/middleware: http.Hijacker is unavailable on the writer")
+	}
+	if w.wroteHeader {
+		w.hijacked = true
+		w.send(w.status, w.body.Bytes())
+	}
+	conn, rw, err := hj.Hijack()
+	if err == nil {
+		w.hijacked = true
+	}
+	return conn, rw, err
+}
+
+func (w *etagWriter) Push(target string, opts *http.PushOptions) error {
+	ps, ok := w.ResponseWriter.(http.Pusher)
+	if !ok {
+		return errors.New("chi/middleware: http.Pusher is unavailable on the writer")
+	}
+	return ps.Push(target, opts)
+}
+
+// finish sends the buffered response once the handler has returned. It writes
+// nothing if the connection was hijacked.
+func (w *etagWriter) finish() {
+	if w.hijacked {
+		return
+	}
+	if !w.wroteHeader {
+		w.WriteHeader(http.StatusOK)
+	}
+	if w.status != http.StatusOK {
+		w.send(w.status, w.body.Bytes())
+		return
+	}
+
+	tag := w.etag()
+	if ifNoneMatch(w.inm, tag) {
+		w.header.Del("Content-Type")
+		w.header.Del("Content-Length")
+		w.header.Del("Content-Encoding")
+		if tag != "" {
+			w.header.Del("Last-Modified")
+		}
+		w.send(http.StatusNotModified, nil)
+		return
+	}
+	w.send(http.StatusOK, w.body.Bytes())
+}
+
+// etag returns the tag of a 200 response: the handler's ETag if it set one,
+// otherwise a strong tag computed from the body and stored in the header
+// snapshot. It returns "" for a HEAD response with no body bytes.
+func (w *etagWriter) etag() string {
+	if set := handlerETag(w.header); set != "" {
+		return set
+	}
+	if w.head && w.body.Len() == 0 {
+		return ""
+	}
+	sum := sha256.Sum256(w.body.Bytes())
+	tag := `"` + hex.EncodeToString(sum[:]) + `"`
+	w.header.Set("Etag", tag)
+	return tag
+}
+
+// send writes the status and the header snapshot, then the body. Trailer values
+// are copied into the live header map after the status is written, so they go
+// out as trailers and not as headers.
+func (w *etagWriter) send(code int, body []byte) {
+	live := w.ResponseWriter.Header()
+	trailers := liveTrailers(live, w.header)
+
+	clear(live)
+	for k, vs := range w.header {
+		live[k] = vs
+	}
+	w.ResponseWriter.WriteHeader(code)
+	for k, vs := range trailers {
+		live[k] = vs
+	}
+	w.ResponseWriter.Write(body)
+}
+
+// handlerETag returns the first non-empty ETag value in h, under any key case.
+func handlerETag(h http.Header) string {
+	for k, vs := range h {
+		if strings.EqualFold(k, "ETag") {
+			for _, v := range vs {
+				if v != "" {
+					return v
+				}
+			}
+		}
+	}
+	return ""
+}
+
+// liveTrailers returns the values in the live header map of the trailers that
+// the snapshot declares, plus the keys that use http.TrailerPrefix.
+func liveTrailers(live, snapshot http.Header) http.Header {
+	trailers := http.Header{}
+	for k, vs := range live {
+		if strings.HasPrefix(k, http.TrailerPrefix) {
+			trailers[k] = vs
+		}
+	}
+	for _, name := range declaredTrailers(snapshot) {
+		if vs, ok := live[name]; ok {
+			trailers[name] = vs
+		}
+	}
+	return trailers
+}
+
+// declaredTrailers returns the canonical names listed in a Trailer header.
+func declaredTrailers(h http.Header) []string {
+	var names []string
+	for _, v := range h.Values("Trailer") {
+		for _, name := range strings.Split(v, ",") {
+			names = append(names, http.CanonicalHeaderKey(strings.TrimSpace(name)))
+		}
+	}
+	return names
+}
+
+// ifNoneMatch reports whether the If-None-Match lines match etag by weak
+// comparison, or are "*". It follows net/http's checkIfNoneMatch: members are
+// comma-separated, optional whitespace is trimmed, and parsing stops at the
+// first malformed member.
+func ifNoneMatch(inm []string, etag string) bool {
+	buf := strings.Join(inm, ",")
+	for {
+		buf = strings.Trim(buf, " \t")
+		if buf == "" {
+			return false
+		}
+		if buf[0] == ',' {
+			buf = buf[1:]
+			continue
+		}
+		if buf[0] == '*' {
+			return true
+		}
+		member, rest := scanETag(buf)
+		if member == "" {
+			return false
+		}
+		if strings.TrimPrefix(member, "W/") == strings.TrimPrefix(etag, "W/") {
+			return true
+		}
+		buf = rest
+	}
+}
+
+// scanETag returns the entity-tag at the start of s, with any W/ prefix, and
+// the text after it. It returns an empty tag if s does not start with a
+// well-formed entity-tag.
+func scanETag(s string) (etag, rest string) {
+	start := 0
+	if strings.HasPrefix(s, "W/") {
+		start = 2
+	}
+	if len(s) < start+2 || s[start] != '"' {
+		return "", ""
+	}
+	for i := start + 1; i < len(s); i++ {
+		c := s[i]
+		switch {
+		case c == '"':
+			return s[:i+1], s[i+1:]
+		case c == 0x21 || (c >= 0x23 && c <= 0x7E) || c >= 0x80:
+			// etagc
+		default:
+			return "", ""
+		}
+	}
+	return "", ""
+}
diff --git a/middleware/etag_test.go b/middleware/etag_test.go
new file mode 100644
index 0000000..9c8c45a
--- /dev/null
+++ b/middleware/etag_test.go
@@ -0,0 +1,902 @@
+package middleware
+
+import (
+	"bufio"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/go-chi/chi/v5"
+)
+
+// etagSum is the tag the middleware computes for a body.
+func etagSum(body string) string {
+	sum := sha256.Sum256([]byte(body))
+	return `"` + hex.EncodeToString(sum[:]) + `"`
+}
+
+func etagRequest(method string, inm ...string) *http.Request {
+	req := httptest.NewRequest(method, "/", nil)
+	for _, v := range inm {
+		req.Header.Add("If-None-Match", v)
+	}
+	return req
+}
+
+// etagHandler sets ETag when etag is not empty and writes body.
+func etagHandler(etag, body string) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		if etag != "" {
+			w.Header().Set("ETag", etag)
+		}
+		w.Write([]byte(body))
+	}
+}
+
+// codeRecorder records every status the middleware sends. Informational
+// statuses are not passed to the embedded recorder, which would ignore the
+// final status after them.
+type codeRecorder struct {
+	*httptest.ResponseRecorder
+	codes []int
+}
+
+func (c *codeRecorder) WriteHeader(code int) {
+	c.codes = append(c.codes, code)
+	if code >= 200 {
+		c.ResponseRecorder.WriteHeader(code)
+	}
+}
+
+type hijackRecorder struct {
+	*httptest.ResponseRecorder
+	hijackErr error
+	hijacked  bool
+}
+
+func (h *hijackRecorder) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	if h.hijackErr != nil {
+		return nil, nil, h.hijackErr
+	}
+	h.hijacked = true
+	return nil, nil, nil
+}
+
+type pushRecorder struct {
+	*httptest.ResponseRecorder
+	pushed []string
+}
+
+func (p *pushRecorder) Push(target string, _ *http.PushOptions) error {
+	p.pushed = append(p.pushed, target)
+	return nil
+}
+
+type deadlineRecorder struct {
+	*httptest.ResponseRecorder
+	deadline time.Time
+}
+
+func (d *deadlineRecorder) SetWriteDeadline(t time.Time) error {
+	d.deadline = t
+	return nil
+}
+
+func TestETagSignature(t *testing.T) {
+	var _ func(http.Handler) http.Handler = ETag
+
+	r := chi.NewRouter()
+	r.Use(ETag)
+	r.Get("/", etagHandler("", "hi"))
+
+	rec := httptest.NewRecorder()
+	r.ServeHTTP(rec, etagRequest("GET"))
+	if got := rec.Header().Get("Etag"); got != etagSum("hi") {
+		t.Fatalf("expected computed ETag %s, got %q", etagSum("hi"), got)
+	}
+}
+
+func TestETagComputesStrongTag(t *testing.T) {
+	tests := []struct {
+		name string
+		h    http.HandlerFunc
+		body string
+	}{
+		{"nothing written", func(w http.ResponseWriter, r *http.Request) {}, ""},
+		{"explicit status only", func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(http.StatusOK) }, ""},
+		{"single write", etagHandler("", "hello"), "hello"},
+		{"many small writes", func(w http.ResponseWriter, r *http.Request) {
+			for _, s := range []string{"a", "b", "c"} {
+				w.Write([]byte(s))
+			}
+		}, "abc"},
+		{"io.Copy", func(w http.ResponseWriter, r *http.Request) {
+			io.Copy(w, strings.NewReader("streamed"))
+		}, "streamed"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			rec := httptest.NewRecorder()
+			ETag(tt.h).ServeHTTP(rec, etagRequest("GET"))
+
+			got := rec.Header().Get("Etag")
+			if got != etagSum(tt.body) {
+				t.Fatalf("expected ETag %s, got %q", etagSum(tt.body), got)
+			}
+			if rec.Body.String() != tt.body {
+				t.Fatalf("expected body %q, got %q", tt.body, rec.Body.String())
+			}
+		})
+	}
+}
+
+func TestETagEmptyBodyTag(t *testing.T) {
+	const emptyTag = `"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"`
+	rec := httptest.NewRecorder()
+	ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {})).ServeHTTP(rec, etagRequest("GET"))
+	if got := rec.Header().Get("Etag"); got != emptyTag {
+		t.Fatalf("expected empty-body tag %s, got %q", emptyTag, got)
+	}
+}
+
+func TestETagIsDeterministic(t *testing.T) {
+	first := httptest.NewRecorder()
+	ETag(etagHandler("", "same")).ServeHTTP(first, etagRequest("GET"))
+	second := httptest.NewRecorder()
+	ETag(etagHandler("", "same")).ServeHTTP(second, etagRequest("GET"))
+	other := httptest.NewRecorder()
+	ETag(etagHandler("", "different")).ServeHTTP(other, etagRequest("GET"))
+
+	if first.Header().Get("Etag") != second.Header().Get("Etag") {
+		t.Fatal("same body produced different tags")
+	}
+	if first.Header().Get("Etag") == other.Header().Get("Etag") {
+		t.Fatal("different bodies produced the same tag")
+	}
+}
+
+func TestETagBuffersUntilHandlerReturns(t *testing.T) {
+	tests := []struct {
+		name string
+		h    func(w http.ResponseWriter)
+		body string
+	}{
+		{"explicit status", func(w http.ResponseWriter) { w.WriteHeader(http.StatusOK); w.Write([]byte("body")) }, "body"},
+		{"implicit status", func(w http.ResponseWriter) { w.Write([]byte("body")) }, "body"},
+		{"io.Copy", func(w http.ResponseWriter) { io.Copy(w, strings.NewReader("body")) }, "body"},
+		{"nothing written", func(w http.ResponseWriter) {}, ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			rec := httptest.NewRecorder()
+			ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if _, ok := w.(io.ReaderFrom); ok {
+					t.Error("wrapper must not expose io.ReaderFrom")
+				}
+				tt.h(w)
+				if rec.Body.Len() != 0 || rec.Flushed {
+					t.Errorf("response reached the client before the handler returned: body %q", rec.Body.String())
+				}
+			})).ServeHTTP(rec, etagRequest("GET"))
+
+			if rec.Body.String() != tt.body {
+				t.Fatalf("expected body %q, got %q", tt.body, rec.Body.String())
+			}
+		})
+	}
+}
+
+func TestETagFlushIsNoOp(t *testing.T) {
+	rec := httptest.NewRecorder()
+	ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("X-Before", "1")
+		http.NewResponseController(w).Flush()
+		if rec.Flushed || rec.Body.Len() != 0 {
+			t.Error("Flush reached the underlying writer")
+		}
+		w.Write([]byte("body"))
+	})).ServeHTTP(rec, etagRequest("GET"))
+
+	if rec.Header().Get("X-Before") != "1" || rec.Header().Get("Etag") != etagSum("body") {
+		t.Fatalf("unexpected headers after Flush: %v", rec.Header())
+	}
+}
+
+func TestETagHandlerSetTags(t *testing.T) {
+	tests := []struct {
+		name string
+		set  string
+		want string
+	}{
+		{"canonical key counts as set", `"custom"`, `"custom"`},
+		{"weak tag kept as-is", `W/"v1"`, `W/"v1"`},
+		{"empty value treated as not set", "", etagSum("body")},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("ETag", tt.set)
+				w.Write([]byte("body"))
+			})
+			rec := httptest.NewRecorder()
+			ETag(h).ServeHTTP(rec, etagRequest("GET"))
+
+			if got := rec.Header().Get("Etag"); got != tt.want {
+				t.Fatalf("expected ETag %q, got %q", tt.want, got)
+			}
+			if rec.Body.String() != "body" {
+				t.Fatalf("expected body unchanged, got %q", rec.Body.String())
+			}
+		})
+	}
+}
+
+func TestETagIfNoneMatch(t *testing.T) {
+	tests := []struct {
+		name   string
+		method string
+		inm    []string
+		etag   string // handler-set ETag, empty for none
+		want   int
+	}{
+		{"weak request matches strong", "GET", []string{`W/"abc"`}, `"abc"`, http.StatusNotModified},
+		{"strong request matches weak", "GET", []string{`"abc"`}, `W/"abc"`, http.StatusNotModified},
+		{"list with OWS and weak member", "GET", []string{`"a", "b" , W/"c"`}, `"c"`, http.StatusNotModified},
+		{"separate header lines", "GET", []string{`"a"`, `"c"`}, `"c"`, http.StatusNotModified},
+		{"star matches", "GET", []string{"*"}, "", http.StatusNotModified},
+		{"computed tag matches", "GET", []string{etagSum("body")}, "", http.StatusNotModified},
+		{"HEAD computed tag matches", "HEAD", []string{etagSum("body")}, "", http.StatusNotModified},
+		{"unquoted request member never matches", "GET", []string{"abc"}, `"abc"`, http.StatusOK},
+		{"unquoted handler tag never matches", "GET", []string{"abc"}, "abc", http.StatusOK},
+		{"missing closing quote never matches", "GET", []string{`"abc`}, `"abc"`, http.StatusOK},
+		{"lone quote does not panic", "GET", []string{`"`}, `"abc"`, http.StatusOK},
+		{"lone weak prefix does not panic", "GET", []string{`W/`}, `"abc"`, http.StatusOK},
+		{"malformed member stops parsing", "GET", []string{`abc, "c"`}, `"c"`, http.StatusOK},
+		{"empty opaque tag matches empty", "GET", []string{`""`}, `W/""`, http.StatusNotModified},
+		{"empty opaque tag does not match computed", "GET", []string{`""`}, "", http.StatusOK},
+		{"case differs", "GET", []string{`"ABC"`}, `"abc"`, http.StatusOK},
+		{"empty header does not match", "GET", []string{""}, `"abc"`, http.StatusOK},
+		{"different tag does not match", "GET", []string{`"nope"`}, `"abc"`, http.StatusOK},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			rec := httptest.NewRecorder()
+			ETag(etagHandler(tt.etag, "body")).ServeHTTP(rec, etagRequest(tt.method, tt.inm...))
+
+			if rec.Code != tt.want {
+				t.Fatalf("expected status %d, got %d", tt.want, rec.Code)
+			}
+			if rec.Code == http.StatusNotModified && rec.Body.Len() != 0 {
+				t.Fatalf("304 must not write a body, got %q", rec.Body.String())
+			}
+		})
+	}
+}
+
+func TestETagNotModifiedKeepsAndDropsHeaders(t *testing.T) {
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		hdr := w.Header()
+		hdr.Set("ETag", `"v1"`)
+		hdr.Set("Cache-Control", "max-age=60")
+		hdr.Set("Vary", "Accept-Encoding")
+		hdr.Set("Expires", "Wed, 21 Oct 2026 07:28:00 GMT")
+		hdr.Set("Content-Location", "/other")
+		hdr.Set("Set-Cookie", "sid=1")
+		hdr.Set("Content-Type", "text/plain")
+		hdr.Set("Content-Length", "4")
+		hdr.Set("Content-Encoding", "gzip")
+		hdr.Set("Last-Modified", "Mon, 02 Jan 2006 15:04:05 GMT")
+		w.Write([]byte("body"))
+	})
+	rec := httptest.NewRecorder()
+	ETag(h).ServeHTTP(rec, etagRequest("GET", `"v1"`))
+
+	res := rec.Result()
+	if res.StatusCode != http.StatusNotModified {
+		t.Fatalf("expected 304, got %d", res.StatusCode)
+	}
