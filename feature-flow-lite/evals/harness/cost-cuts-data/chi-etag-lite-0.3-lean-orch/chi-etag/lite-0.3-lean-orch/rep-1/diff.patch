+func TestETagInformationalResponses(t *testing.T) {
+	tests := []struct {
+		name        string
+		inm         []string
+		handler     http.HandlerFunc
+		wantCode    int
+		wantBody    string
+		wantInterim []int
+	}{
+		{
+			name: "103 then 404 is forwarded and 404 is final",
+			handler: func(w http.ResponseWriter, r *http.Request) {
+				w.WriteHeader(http.StatusEarlyHints)
+				w.WriteHeader(http.StatusNotFound)
+				w.Write([]byte("nf"))
+			},
+			wantCode:    http.StatusNotFound,
+			wantBody:    "nf",
+			wantInterim: []int{http.StatusEarlyHints},
+		},
+		{
+			name: "103 then implicit 200 matching star is 304",
+			inm:  []string{"*"},
+			handler: func(w http.ResponseWriter, r *http.Request) {
+				w.WriteHeader(http.StatusEarlyHints)
+				w.Write([]byte("body"))
+			},
+			wantCode:    http.StatusNotModified,
+			wantBody:    "",
+			wantInterim: []int{http.StatusEarlyHints},
+		},
+		{
+			name: "103 after final 404 is not forwarded",
+			handler: func(w http.ResponseWriter, r *http.Request) {
+				w.WriteHeader(http.StatusNotFound)
+				w.Header().Set("X-Late", "1")
+				w.WriteHeader(http.StatusEarlyHints)
+				w.Write([]byte("nf"))
+			},
+			wantCode: http.StatusNotFound,
+			wantBody: "nf",
+		},
+		{
+			name: "103 after body is not forwarded",
+			handler: func(w http.ResponseWriter, r *http.Request) {
+				w.Write([]byte("hello"))
+				w.WriteHeader(http.StatusEarlyHints)
+			},
+			wantCode: http.StatusOK,
+			wantBody: "hello",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var interim []int
+			trace := &httptrace.ClientTrace{
+				Got1xxResponse: func(code int, _ textproto.MIMEHeader) error {
+					interim = append(interim, code)
+					return nil
+				},
+			}
+			resp, body := doETagServer(t, http.MethodGet, tt.inm, tt.handler, trace)
+			if resp.StatusCode != tt.wantCode {
+				t.Errorf("code: got %d, want %d", resp.StatusCode, tt.wantCode)
+			}
+			if body != tt.wantBody {
+				t.Errorf("body: got %q, want %q", body, tt.wantBody)
+			}
+			if !slices.Equal(interim, tt.wantInterim) {
+				t.Errorf("interim responses: got %v, want %v", interim, tt.wantInterim)
+			}
+		})
+	}
+}
