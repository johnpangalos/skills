+func TestETagHEADMatchesGETForFullBody(t *testing.T) {
+	handler := func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("hello"))
+	}
+	get := serveETag(http.MethodGet, nil, handler).Header().Get("ETag")
+	head := serveETag(http.MethodHead, nil, handler).Header().Get("ETag")
+	if head != get || head != etagOf("hello") {
+		t.Errorf("HEAD ETag: got %q, want the GET ETag %q", head, get)
