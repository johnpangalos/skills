diff --git a/middleware/etag.go b/middleware/etag.go
new file mode 100644
index 0000000..7f27536
--- /dev/null
+++ b/middleware/etag.go
@@ -0,0 +1,258 @@
+package middleware
+
+import (
+	"bufio"
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"net"
+	"net/http"
+	"strconv"
+	"strings"
+)
+
+// ETag is a middleware that sets a strong ETag on GET and HEAD responses and
+// answers conditional requests with 304 Not Modified.
+//
+// The response is buffered in full before anything is written to the client,
+// so Flush does not stream the body. When the handler responds 200 and sets no
+// ETag header (or sets an empty one), the ETag is the quoted SHA-256 hex digest
+// of the body. On HEAD an ETag is generated only when the body is non-empty and
+// matches any Content-Length the handler set, so it is the ETag GET would get.
+// If If-None-Match matches the response ETag, using weak
+// comparison and including "*" (RFC 9110 sections 8.8.3.2 and 13.1.2), the
+// client gets a 304 with no body and Content-Type, Content-Length,
+// Content-Encoding and Last-Modified removed. Other statuses, and all other
+// methods, pass through unchanged. Headers are fixed when the final status is
+// committed; only trailers set after that are still sent.
+//
+// NOTE: if NoCache runs before ETag, it strips If-None-Match from the request
+// and no 304 is ever sent.
+func ETag(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet && r.Method != http.MethodHead {
+			next.ServeHTTP(w, r)
+			return
+		}
+
+		ew := &etagResponseWriter{ResponseWriter: w}
+		next.ServeHTTP(ew, r)
+		if ew.hijacked {
+			return
+		}
+		if !ew.wroteHeader {
+			ew.commit(http.StatusOK)
+		}
+		trailers := ew.trailers()
+		ew.restoreHeader()
+
+		h := w.Header()
+		code := ew.status
+		if code == http.StatusOK {
+			// HEAD does not send the body, so the handler may have written less than
+			// GET would. Hash only a body that is complete for HEAD too.
+			full := r.Method == http.MethodGet || (ew.body.Len() > 0 && (h.Get("Content-Length") == "" || h.Get("Content-Length") == strconv.Itoa(ew.body.Len())))
+			if h.Get("ETag") == "" && full {
+				sum := sha256.Sum256(ew.body.Bytes())
+				h.Set("ETag", `"`+hex.EncodeToString(sum[:])+`"`)
+			}
+			if ifNoneMatchMatches(r.Header.Values("If-None-Match"), h.Get("ETag")) {
+				h.Del("Content-Type")
+				h.Del("Content-Length")
+				h.Del("Content-Encoding")
+				h.Del("Last-Modified")
+				code = http.StatusNotModified
+			}
+		}
+		w.WriteHeader(code)
+		// The body is written for HEAD too: net/http discards it, but it sets
+		// Content-Length and sniffs Content-Type from it.
+		if code != http.StatusNotModified && ew.body.Len() > 0 {
+			w.Write(ew.body.Bytes())
+		}
+		for k, v := range trailers {
+			h[k] = v
+		}
+	})
+}
+
+// etagResponseWriter holds the handler's status and body until the handler
+// returns. It does not implement io.ReaderFrom, so io.Copy goes through Write
+// and is buffered like any other write.
+type etagResponseWriter struct {
+	http.ResponseWriter
+	status      int
+	wroteHeader bool
+	hijacked    bool
+	header      http.Header // headers as of the commit
+	body        bytes.Buffer
+}
+
+// WriteHeader records the final status. Informational responses (1xx except
+// 101) are forwarded at once while no final status is committed, and are
+// ignored after that, as net/http does. They do not end the wait for the final
+// status. As in net/http, only the first final status counts.
+func (ew *etagResponseWriter) WriteHeader(code int) {
+	if code >= 100 && code <= 199 && code != http.StatusSwitchingProtocols {
+		if !ew.wroteHeader {
+			ew.ResponseWriter.WriteHeader(code)
+		}
+		return
+	}
+	if !ew.wroteHeader {
+		ew.commit(code)
+	}
+}
+
+// Write buffers p. The status defaults to 200, as it does in net/http.
+func (ew *etagResponseWriter) Write(p []byte) (int, error) {
+	if !ew.wroteHeader {
+		ew.commit(http.StatusOK)
+	}
+	return ew.body.Write(p)
+}
+
+// commit fixes the final status and snapshots the headers, as net/http does
+// when the status is first sent.
+func (ew *etagResponseWriter) commit(code int) {
+	ew.wroteHeader = true
+	ew.status = code
+	ew.header = ew.ResponseWriter.Header().Clone()
+}
+
+// restoreHeader resets the header map to the snapshot, so headers the handler
+// set after the commit are not sent.
+func (ew *etagResponseWriter) restoreHeader() {
+	h := ew.ResponseWriter.Header()
+	for k := range h {
+		delete(h, k)
+	}
+	for k, v := range ew.header {
+		h[k] = v
+	}
+}
+
+// trailers returns the values to send as trailers, read from the live header
+// map as net/http does at the end of the response. Keys with the
+// http.TrailerPrefix prefix and keys declared in the Trailer header are
+// trailers.
+func (ew *etagResponseWriter) trailers() http.Header {
+	live := ew.ResponseWriter.Header()
+	out := http.Header{}
+	for k, v := range live {
+		if strings.HasPrefix(k, http.TrailerPrefix) {
+			out[k] = v
+		}
+	}
+	for _, decl := range ew.header.Values("Trailer") {
+		for _, k := range strings.Split(decl, ",") {
+			k = http.CanonicalHeaderKey(strings.Trim(k, " \t"))
+			if v, ok := live[k]; ok {
+				out[k] = v
+			}
+		}
+	}
+	return out
+}
+
+// Flush is a no-op because the response is buffered until the handler returns.
+func (ew *etagResponseWriter) Flush() {}
+
+// Hijack takes over the connection. If a final status is already committed, its
+// headers, status and buffered body are written first, as net/http flushes a
+// committed header before hijacking, so a 101 reaches the client.
+func (ew *etagResponseWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	hj, ok := ew.ResponseWriter.(http.Hijacker)
+	if !ok {
+		return nil, nil, errors.New("chi/middleware: http.Hijacker is unavailable on the writer")
+	}
+	if ew.wroteHeader {
+		ew.restoreHeader()
+		ew.ResponseWriter.WriteHeader(ew.status)
+		// net/http drops a body that the status does not allow, such as the
+		// body of a 101, exactly as it would without the middleware.
+		if ew.body.Len() > 0 {
+			ew.ResponseWriter.Write(ew.body.Bytes())
+		}
+	}
+	conn, rw, err := hj.Hijack()
+	if err == nil {
+		ew.hijacked = true
+	}
+	return conn, rw, err
+}
+
+func (ew *etagResponseWriter) Push(target string, opts *http.PushOptions) error {
+	ps, ok := ew.ResponseWriter.(http.Pusher)
+	if !ok {
+		return http.ErrNotSupported
+	}
+	return ps.Push(target, opts)
+}
+
+func (ew *etagResponseWriter) Unwrap() http.ResponseWriter {
+	return ew.ResponseWriter
+}
+
+// ifNoneMatchMatches reports whether any If-None-Match line matches etag. A
+// member that is exactly "*" matches any etag, including an empty etag, which
+// means the response has no ETag. An empty etag never matches a tag member, so
+// an absent ETag is not the same as the empty opaque-tag "". Members are
+// comma-separated and empty members are skipped. A malformed member ends its
+// line without matching; the other lines are still checked.
+func ifNoneMatchMatches(lines []string, etag string) bool {
+	want := strings.TrimPrefix(etag, "W/")
+	for _, line := range lines {
+		s := strings.Trim(line, " \t")
+		for s != "" {
+			if s[0] == ',' {
+				s = strings.TrimLeft(s[1:], " \t")
+				continue
+			}
+			if s[0] == '*' {
+				s = strings.TrimLeft(s[1:], " \t")
+				if s == "" || s[0] == ',' {
+					return true
+				}
+				break
+			}
+			tag, rest, ok := scanETag(s)
+			if !ok {
+				break
+			}
+			if etag != "" && strings.TrimPrefix(tag, "W/") == want {
+				return true
+			}
+			s = strings.TrimLeft(rest, " \t")
+			if s != "" && s[0] != ',' {
+				break
+			}
+		}
+	}
+	return false
+}
+
+// scanETag splits the entity-tag at the start of s, which must not start with
+// whitespace, from the text after it. The tag is "opaque-tag" or W/"opaque-tag".
+// Commas inside the quotes belong to the tag.
+func scanETag(s string) (tag, rest string, ok bool) {
+	start := 0
+	if strings.HasPrefix(s, "W/") {
+		start = 2
+	}
+	if len(s) < start+2 || s[start] != '"' {
+		return "", "", false
+	}
+	for i := start + 1; i < len(s); i++ {
+		switch c := s[i]; {
+		case c == '"':
+			return s[:i+1], s[i+1:], true
+		case c == 0x21 || (c >= 0x23 && c <= 0x7E) || c >= 0x80:
+			// etagc: a character allowed inside an opaque-tag.
+		default:
+			return "", "", false
+		}
+	}
+	return "", "", false
+}
diff --git a/middleware/etag_test.go b/middleware/etag_test.go
new file mode 100644
index 0000000..f9aa8fd
--- /dev/null
+++ b/middleware/etag_test.go
@@ -0,0 +1,1004 @@
+package middleware
+
+import (
+	"bufio"
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"io"
+	"log"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/http/httptrace"
+	"net/textproto"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/go-chi/chi/v5"
+)
+
+// etagOf returns the ETag that the middleware generates for body.
+func etagOf(body string) string {
+	sum := sha256.Sum256([]byte(body))
+	return `"` + hex.EncodeToString(sum[:]) + `"`
+}
+
+// serveETag runs handler behind ETag for one request with the given method and
+// If-None-Match lines.
+func serveETag(method string, inm []string, handler http.HandlerFunc) *httptest.ResponseRecorder {
+	req := httptest.NewRequest(method, "/", http.NoBody)
+	req.Header["If-None-Match"] = inm
+	rec := httptest.NewRecorder()
+	ETag(handler).ServeHTTP(rec, req)
+	return rec
+}
+
+func TestETagOtherMethodsPassThrough(t *testing.T) {
+	for _, method := range []string{http.MethodPost, http.MethodPut, http.MethodDelete, "get"} {
+		t.Run(method, func(t *testing.T) {
+			req := httptest.NewRequest(method, "/", http.NoBody)
+			req.Header.Set("If-None-Match", "*")
+			rec := httptest.NewRecorder()
+			var got http.ResponseWriter
+			ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				got = w
+				w.Write([]byte("body"))
+			})).ServeHTTP(rec, req)
+
+			if got != rec {
+				t.Fatalf("handler got wrapped writer %T, want the original writer", got)
+			}
+			if rec.Code != http.StatusOK {
+				t.Errorf("code: got %d, want %d", rec.Code, http.StatusOK)
+			}
+			if rec.Body.String() != "body" {
+				t.Errorf("body: got %q, want %q", rec.Body.String(), "body")
+			}
+			if etag := rec.Header().Get("ETag"); etag != "" {
+				t.Errorf("ETag: got %q, want none", etag)
+			}
+		})
+	}
+}
+
+func TestETagStatusFromFirstWriteHeader(t *testing.T) {
+	tests := []struct {
+		name     string
+		handler  http.HandlerFunc
+		wantCode int
+		wantBody string
+		wantETag string
+	}{
+		{
+			name: "WriteHeader 200 then 500 keeps 200",
+			handler: func(w http.ResponseWriter, r *http.Request) {
+				w.WriteHeader(http.StatusOK)
+				w.WriteHeader(http.StatusInternalServerError)
+				w.Write([]byte("hi"))
+			},
+			wantCode: http.StatusOK,
+			wantBody: "hi",
+			wantETag: etagOf("hi"),
+		},
+		{
+			name: "Write without WriteHeader is 200",
+			handler: func(w http.ResponseWriter, r *http.Request) {
+				w.Write([]byte("hi"))
+			},
+			wantCode: http.StatusOK,
+			wantBody: "hi",
+			wantETag: etagOf("hi"),
+		},
+		{
+			name:     "no write and no status is 200 with empty body",
+			handler:  func(w http.ResponseWriter, r *http.Request) {},
+			wantCode: http.StatusOK,
+			wantBody: "",
+			wantETag: etagOf(""),
+		},
+		{
+			name: "many small writes equal one write",
+			handler: func(w http.ResponseWriter, r *http.Request) {
+				w.Write([]byte("a"))
+				w.Write([]byte("bc"))
+				w.Write([]byte("def"))
+			},
+			wantCode: http.StatusOK,
+			wantBody: "abcdef",
+			wantETag: etagOf("abcdef"),
+		},
+		{
+			name: "201 passes through without ETag",
+			handler: func(w http.ResponseWriter, r *http.Request) {
+				w.WriteHeader(http.StatusCreated)
+				w.Write([]byte("made"))
+			},
+			wantCode: http.StatusCreated,
+			wantBody: "made",
+			wantETag: "",
+		},
+		{
+			name: "500 passes through without ETag",
+			handler: func(w http.ResponseWriter, r *http.Request) {
+				w.WriteHeader(http.StatusInternalServerError)
+				w.Write([]byte("boom"))
+			},
+			wantCode: http.StatusInternalServerError,
+			wantBody: "boom",
+			wantETag: "",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			rec := serveETag(http.MethodGet, nil, tt.handler)
+			if rec.Code != tt.wantCode {
+				t.Errorf("code: got %d, want %d", rec.Code, tt.wantCode)
+			}
+			if rec.Body.String() != tt.wantBody {
+				t.Errorf("body: got %q, want %q", rec.Body.String(), tt.wantBody)
+			}
+			if etag := rec.Header().Get("ETag"); etag != tt.wantETag {
+				t.Errorf("ETag: got %q, want %q", etag, tt.wantETag)
+			}
+		})
+	}
+}
+
+func TestETagGeneratedFromBody(t *testing.T) {
+	respond := func(body string) string {
+		rec := serveETag(http.MethodGet, nil, func(w http.ResponseWriter, r *http.Request) {
+			w.Write([]byte(body))
+		})
+		return rec.Header().Get("ETag")
+	}
+
+	if a, b := respond("hello"), respond("hello"); a != b {
+		t.Errorf("same body gave different ETags: %q and %q", a, b)
+	}
+	if a, b := respond("hello"), respond("hellp"); a == b {
+		t.Errorf("one byte difference gave the same ETag %q", a)
+	}
+	if etag := respond("hello"); etag != etagOf("hello") {
+		t.Errorf("ETag: got %q, want %q", etag, etagOf("hello"))
+	}
+	if etag := respond(""); len(etag) < 2 || !strings.HasPrefix(etag, `"`) || !strings.HasSuffix(etag, `"`) {
+		t.Errorf("empty body ETag is not a quoted string: %q", etag)
+	}
+}
+
+func TestETagHandlerSetETagKept(t *testing.T) {
+	tests := []struct {
+		name    string
+		setETag string
+	}{
+		{name: "strong", setETag: `"v1"`},
+		{name: "weak", setETag: `W/"v1"`},
+		{name: "two quote characters", setETag: `""`},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			rec := serveETag(http.MethodGet, nil, func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("ETag", tt.setETag)
+				w.Write([]byte("body"))
+			})
+			if etag := rec.Header().Get("ETag"); etag != tt.setETag {
+				t.Errorf("ETag: got %q, want %q", etag, tt.setETag)
+			}
+		})
+	}
+
+	t.Run("empty value is replaced", func(t *testing.T) {
+		rec := serveETag(http.MethodGet, nil, func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("ETag", "")
+			w.Write([]byte("body"))
+		})
+		if etag := rec.Header().Get("ETag"); etag != etagOf("body") {
+			t.Errorf("ETag: got %q, want %q", etag, etagOf("body"))
+		}
+	})
+}
+
+func TestETagHEADUsesBodyETagWithoutBody(t *testing.T) {
+	resp, body := doETagServer(t, http.MethodHead, nil, func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("hello"))
+	}, nil)
+	if resp.StatusCode != http.StatusOK {
+		t.Errorf("code: got %d, want %d", resp.StatusCode, http.StatusOK)
+	}
+	if body != "" {
+		t.Errorf("body: got %q, want none", body)
+	}
+	if etag := resp.Header.Get("ETag"); etag != etagOf("hello") {
+		t.Errorf("ETag: got %q, want %q", etag, etagOf("hello"))
+	}
+}
+
+func TestETagBodyAndHeadersIntact(t *testing.T) {
+	tests := []struct {
+		name string
+		body []byte
+	}{
+		{name: "binary with NUL bytes", body: []byte("a\x00b\xff\x00")},
+		{name: "1 MiB plus", body: bytes.Repeat([]byte("x"), 1<<20+7)},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			rec := serveETag(http.MethodGet, nil, func(w http.ResponseWriter, r *http.Request) {
+				w.Write(tt.body)
+			})
+			if !bytes.Equal(rec.Body.Bytes(), tt.body) {
+				t.Errorf("body: got %d bytes, want %d intact bytes", rec.Body.Len(), len(tt.body))
+			}
+			if etag := rec.Header().Get("ETag"); etag != etagOf(string(tt.body)) {
+				t.Errorf("ETag: got %q, want %q", etag, etagOf(string(tt.body)))
+			}
+		})
+	}
+
+	t.Run("handler headers are kept", func(t *testing.T) {
+		rec := serveETag(http.MethodGet, nil, func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Content-Type", "text/plain")
+			w.Header().Set("Content-Length", "5")
+			w.Write([]byte("hello"))
+		})
+		if got := rec.Header().Get("Content-Type"); got != "text/plain" {
+			t.Errorf("Content-Type: got %q, want %q", got, "text/plain")
+		}
+		if got := rec.Header().Get("Content-Length"); got != "5" {
+			t.Errorf("Content-Length: got %q, want %q", got, "5")
+		}
+	})
+}
+
+func TestETagIfNoneMatch(t *testing.T) {
+	tests := []struct {
+		name     string
+		inm      []string
+		resp     string
+		wantCode int
+	}{
+		{name: "star matches", inm: []string{"*"}, resp: `"etag"`, wantCode: http.StatusNotModified},
+		{name: "star with surrounding whitespace matches", inm: []string{"  *  "}, resp: `"etag"`, wantCode: http.StatusNotModified},
+		{name: "list with weak member matches", inm: []string{`"x", W/"etag"`}, resp: `"etag"`, wantCode: http.StatusNotModified},
+		{name: "comma inside quotes is part of the tag", inm: []string{`"a,b"`}, resp: `"a"`, wantCode: http.StatusOK},
+		{name: "comma inside quotes matches itself", inm: []string{`"a,b"`}, resp: `"a,b"`, wantCode: http.StatusNotModified},
+		{name: "unquoted tag does not match", inm: []string{"etag"}, resp: `"etag"`, wantCode: http.StatusOK},
+		{name: "empty opaque tag matches", inm: []string{`""`}, resp: `""`, wantCode: http.StatusNotModified},
+		{name: "empty header value does not match", inm: []string{""}, resp: `"etag"`, wantCode: http.StatusOK},
+		{name: "second header line matches", inm: []string{`"x"`, `"etag"`}, resp: `"etag"`, wantCode: http.StatusNotModified},
+		{name: "star inside a list matches", inm: []string{`"x", *`}, resp: `"etag"`, wantCode: http.StatusNotModified},
+		{name: "star before other members matches", inm: []string{`*, "x"`}, resp: `"etag"`, wantCode: http.StatusNotModified},
+		{name: "leading empty member is skipped", inm: []string{`, "etag"`}, resp: `"etag"`, wantCode: http.StatusNotModified},
+		{name: "doubled comma is skipped", inm: []string{`"x",,"etag"`}, resp: `"etag"`, wantCode: http.StatusNotModified},
+		{name: "trailing comma is skipped", inm: []string{`"etag",`}, resp: `"etag"`, wantCode: http.StatusNotModified},
+		{name: "whitespace-only member is skipped", inm: []string{`"x", , "etag"`}, resp: `"etag"`, wantCode: http.StatusNotModified},
+		{name: "star with trailing junk does not match", inm: []string{`*x`}, resp: `"etag"`, wantCode: http.StatusOK},
