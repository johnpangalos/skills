+func TestETagHEADGeneratedOnlyForFullBody(t *testing.T) {
+	tests := []struct {
+		name     string
+		cl       string
+		body     string
+		wantETag string
+	}{
+		{name: "empty body gets no ETag", body: "", wantETag: ""},
+		{name: "non-empty body without Content-Length", body: "hello", wantETag: etagOf("hello")},
+		{name: "Content-Length matches body", cl: "5", body: "hello", wantETag: etagOf("hello")},
+		{name: "Content-Length differs from body", cl: "10", body: "hello", wantETag: ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			rec := serveETag(http.MethodHead, nil, func(w http.ResponseWriter, r *http.Request) {
+				if tt.cl != "" {
+					w.Header().Set("Content-Length", tt.cl)
+				}
+				w.Write([]byte(tt.body))
+			})
+			if rec.Code != http.StatusOK {
+				t.Errorf("code: got %d, want %d", rec.Code, http.StatusOK)
+			}
+			if etag := rec.Header().Get("ETag"); etag != tt.wantETag {
+				t.Errorf("ETag: got %q, want %q", etag, tt.wantETag)
+			}
+		})
+	}
+}
