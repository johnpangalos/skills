+func TestETagHEADFileServerHasNoETag(t *testing.T) {
+	dir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(dir, "a.txt"), []byte("hello"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	handler := ETag(http.FileServer(http.Dir(dir)))
+
+	get := httptest.NewRecorder()
+	handler.ServeHTTP(get, httptest.NewRequest(http.MethodGet, "/a.txt", http.NoBody))
+	if etag := get.Header().Get("ETag"); etag != etagOf("hello") {
+		t.Errorf("GET ETag: got %q, want %q", etag, etagOf("hello"))
+	}
+
+	for _, inm := range [][]string{nil, {etagOf("")}} {
+		req := httptest.NewRequest(http.MethodHead, "/a.txt", http.NoBody)
+		req.Header["If-None-Match"] = inm
+		rec := httptest.NewRecorder()
+		handler.ServeHTTP(rec, req)
+		if rec.Code != http.StatusOK {
+			t.Errorf("HEAD If-None-Match %q: code got %d, want %d", inm, rec.Code, http.StatusOK)
+		}
+		if etag := rec.Header().Get("ETag"); etag != "" {
+			t.Errorf("HEAD If-None-Match %q: ETag got %q, want none", inm, etag)
+		}
+	}
+}
