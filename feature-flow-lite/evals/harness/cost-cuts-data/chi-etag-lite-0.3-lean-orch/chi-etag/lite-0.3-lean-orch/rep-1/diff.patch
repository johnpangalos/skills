+// doETagServer sends one request through ETag on a real server and returns the
+// response and its body. trace may be nil.
+func doETagServer(t *testing.T, method string, inm []string, handler http.HandlerFunc, trace *httptrace.ClientTrace) (*http.Response, string) {
+	t.Helper()
+	ts := httptest.NewServer(ETag(handler))
+	defer ts.Close()
+	req, err := http.NewRequest(method, ts.URL+"/", http.NoBody)
+	if err != nil {
+		t.Fatal(err)
+	}
+	req.Header["If-None-Match"] = inm
+	if trace != nil {
+		req = req.WithContext(httptrace.WithClientTrace(req.Context(), trace))
+	}
+	resp, err := http.DefaultClient.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(resp.Body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return resp, string(body)
+}
