+func TestETagThroughChiRouter(t *testing.T) {
+	r := chi.NewRouter()
+	r.Use(ETag)
+	r.Get("/", func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "text/plain")
+		w.Write([]byte("hello"))
+	})
+	ts := httptest.NewServer(r)
+	defer ts.Close()
+
+	resp, body := testRequest(t, ts, http.MethodGet, "/", nil)
+	etag := resp.Header.Get("ETag")
+	if resp.StatusCode != http.StatusOK || body != "hello" || etag != etagOf("hello") {
+		t.Fatalf("first GET: got %d %q ETag %q", resp.StatusCode, body, etag)
+	}
+
+	req, err := http.NewRequest(http.MethodGet, ts.URL+"/", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	req.Header.Set("If-None-Match", etag)
+	resp, err = http.DefaultClient.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+	respBody, err := io.ReadAll(resp.Body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if resp.StatusCode != http.StatusNotModified || len(respBody) != 0 {
+		t.Errorf("conditional GET: got %d with %q, want 304 with no body", resp.StatusCode, respBody)
+	}
+}
