+func TestETagHijackAfterWriteKeepsBufferedBody(t *testing.T) {
+	handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		// net/http drops a write that stays in its 2 KiB buffer when the connection
+		// is hijacked, so the body is longer than that buffer.
+		w.Write([]byte("partial-" + strings.Repeat("x", 4096)))
+		w.Header().Set("X-Late", "1")
+		conn, rw, err := http.NewResponseController(w).Hijack()
+		if err != nil {
+			t.Errorf("Hijack: unexpected error %v", err)
+			return
+		}
+		defer conn.Close()
+		rw.WriteString("tail")
+		rw.Flush()
+	})
+
+	raw := rawGET(t, ETag(handler))
+	if !strings.HasPrefix(raw, "HTTP/1.1 200 OK\r\n") {
+		t.Errorf("status line: got %q, want HTTP/1.1 200 OK", raw)
+	}
+	if strings.Contains(raw, "X-Late") {
+		t.Errorf("raw response has a header set after the write: %q", raw)
+	}
+	if i, j := strings.Index(raw, "partial-"), strings.Index(raw, "tail"); i < 0 || j < i {
+		t.Errorf("body order: got %q, want partial- before tail", raw)
+	}
+
+	// Without the middleware, the same handler must produce the same bytes apart
+	// from the Date and ETag lines.
+	withoutDateAndETag := func(raw string) string {
+		var keep []string
+		for _, line := range strings.Split(raw, "\r\n") {
+			if strings.HasPrefix(line, "Date: ") || strings.HasPrefix(line, "Etag: ") {
+				continue
+			}
+			keep = append(keep, line)
+		}
+		return strings.Join(keep, "\r\n")
+	}
+	want := rawGET(t, handler)
+	if withoutDateAndETag(raw) != withoutDateAndETag(want) {
+		t.Errorf("raw response differs from the unwrapped handler:\ngot  %q\nwant %q", raw, want)
+	}
+}
