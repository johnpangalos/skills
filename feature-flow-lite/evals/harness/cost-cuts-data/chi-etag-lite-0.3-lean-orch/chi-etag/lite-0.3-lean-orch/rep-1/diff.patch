+// TestETagHEADWithoutETag uses a handler that sets Content-Length and skips the
+// body on HEAD, so the HEAD response has no ETag. GET gets one.
+func TestETagHEADWithoutETag(t *testing.T) {
+	handler := func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Length", "11")
+		if r.Method == http.MethodGet {
+			w.Write([]byte("hello world"))
+		}
+	}
+	tests := []struct {
+		name     string
+		inm      []string
+		wantCode int
+	}{
+		{name: "star matches any 200", inm: []string{"*"}, wantCode: http.StatusNotModified},
+		{name: "empty opaque tag does not match an absent ETag", inm: []string{`""`}, wantCode: http.StatusOK},
+		{name: "empty opaque tag in a list does not match an absent ETag", inm: []string{`"x", ""`}, wantCode: http.StatusOK},
+		{name: "no If-None-Match", inm: nil, wantCode: http.StatusOK},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			rec := serveETag(http.MethodHead, tt.inm, handler)
+			if rec.Code != tt.wantCode {
+				t.Errorf("code: got %d, want %d", rec.Code, tt.wantCode)
+			}
+			if etag := rec.Header().Get("ETag"); etag != "" {
+				t.Errorf("ETag: got %q, want none", etag)
+			}
+		})
+	}
+}
