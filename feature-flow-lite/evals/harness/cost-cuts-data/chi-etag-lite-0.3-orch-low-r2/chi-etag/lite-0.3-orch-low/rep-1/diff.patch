+func TestETagTrailersReachClient(t *testing.T) {
+	tests := []struct {
+		name   string
+		code   int
+		prefix bool
+	}{
+		{"declared trailer on 200", http.StatusOK, false},
+		{"declared trailer on 404", http.StatusNotFound, false},
+		{"TrailerPrefix on 200", http.StatusOK, true},
+		{"TrailerPrefix on 404", http.StatusNotFound, true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			// Without a declared Trailer, net/http only chunks, and so only sends
+			// trailers, once the body exceeds its buffer.
+			body := "body"
+			if tt.prefix {
+				body = strings.Repeat("b", 8192)
+			}
+			h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if !tt.prefix {
+					w.Header().Set("Trailer", "X-Sum")
+				}
+				w.WriteHeader(tt.code)
+				_, _ = io.WriteString(w, body)
+				if tt.prefix {
+					w.Header().Set(http.TrailerPrefix+"X-Sum", "abc")
+				} else {
+					w.Header().Set("X-Sum", "abc")
+				}
+			})
+			const trailer = "0\r\nX-Sum: abc\r\n\r\n"
+			wire := etagWire(t, ETag(h))
+			plain := etagWire(t, h)
+			if !strings.HasSuffix(plain, trailer) {
+				t.Fatalf("unwrapped response does not end with the X-Sum trailer: %q", etagTail(plain))
+			}
+			// Chunk sizes depend on how the body was written, so compare the
+			// header section and the trailer block rather than every byte.
+			if !strings.HasSuffix(wire, trailer) {
+				t.Errorf("wire response does not end with the X-Sum trailer: %q", etagTail(wire))
+			}
+			if strings.SplitN(wire, "\r\n\r\n", 2)[0] != strings.SplitN(plain, "\r\n\r\n", 2)[0] {
+				t.Errorf("wire header section differs from unwrapped\n got: %q\nwant: %q", strings.SplitN(wire, "\r\n\r\n", 2)[0], strings.SplitN(plain, "\r\n\r\n", 2)[0])
+			}
+		})
+	}
+}
+
+// etagTail returns the last 120 bytes of s, where trailers appear.
+func etagTail(s string) string {
+	if len(s) > 120 {
+		return s[len(s)-120:]
+	}
+	return s
+}
+
+// etagWire returns the raw HTTP/1.1 response to a GET, without the Date and
+// ETag lines, so framing and trailers can be compared byte for byte.
+func etagWire(t *testing.T, h http.Handler) string {
+	t.Helper()
+	srv := httptest.NewServer(h)
+	t.Cleanup(srv.Close)
+	conn, err := net.Dial("tcp", srv.Listener.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	if _, err := io.WriteString(conn, "GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n"); err != nil {
+		t.Fatal(err)
+	}
+	raw, err := io.ReadAll(conn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var kept []string
+	for _, line := range strings.Split(string(raw), "\r\n") {
+		if strings.HasPrefix(line, "Date: ") || strings.HasPrefix(line, "Etag: ") {
+			continue
+		}
+		kept = append(kept, line)
+	}
+	return strings.Join(kept, "\r\n")
+}
