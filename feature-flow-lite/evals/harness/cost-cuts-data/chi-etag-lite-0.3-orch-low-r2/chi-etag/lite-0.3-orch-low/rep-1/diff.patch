+// etagBodyWriteErr serves a Write of body after WriteHeader(code) over a
+// real server, with or without the wrapper, and returns the error Write got.
+func etagBodyWriteErr(t *testing.T, method string, code int, body []byte, wrap bool) error {
+	t.Helper()
+	errCh := make(chan error, 1)
+	var h http.Handler = http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(code)
+		_, err := w.Write(body)
+		errCh <- err
+	})
+	if wrap {
+		h = ETag(h)
+	}
+	srv := httptest.NewServer(h)
+	defer srv.Close()
+	req, err := http.NewRequest(method, srv.URL, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp, err := srv.Client().Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp.Body.Close()
+	if resp.StatusCode != code {
+		t.Fatalf("status = %d, want %d", resp.StatusCode, code)
+	}
+	return <-errCh
+}
