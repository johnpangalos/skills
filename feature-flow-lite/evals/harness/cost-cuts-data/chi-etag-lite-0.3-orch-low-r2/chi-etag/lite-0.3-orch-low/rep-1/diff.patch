+			for _, b := range bodies {
+				t.Run(c.name+" "+method+" "+b.name, func(t *testing.T) {
+					plain := etagBodyWriteErr(t, method, c.code, b.body, false)
+					wrapped := etagBodyWriteErr(t, method, c.code, b.body, true)
+					want := http.ErrBodyNotAllowed
+					if len(b.body) == 0 {
+						want = nil
+					}
+					if plain != want {
+						t.Fatalf("unwrapped Write error = %v, want %v", plain, want)
+					}
+					if wrapped != plain {
+						t.Errorf("wrapped Write error = %v, want %v", wrapped, plain)
