diff --git a/middleware/etag.go b/middleware/etag.go
new file mode 100644
index 0000000..e77d97d
--- /dev/null
+++ b/middleware/etag.go
@@ -0,0 +1,226 @@
+package middleware
+
+import (
+	"bufio"
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"maps"
+	"net"
+	"net/http"
+	"strings"
+)
+
+// ETag is a middleware that buffers GET and HEAD responses in memory and
+// adds a strong ETag, computed as the hex-encoded SHA-256 of the body, to
+// successful (200) responses that do not already set one. A handler-set ETag,
+// strong or weak, is never modified.
+//
+// If the request's If-None-Match header matches the response ETag (using weak
+// comparison, or "*" for any 200 response), the middleware responds with
+// 304 Not Modified and no body, keeping the ETag and other headers the handler
+// set while removing Content-Type, Content-Length, Content-Encoding and
+// Transfer-Encoding. Responses with any other status are replayed unchanged.
+// Other methods pass through to the handler untouched.
+//
+// Nothing is sent to the client until the handler returns, so Flush does not
+// stream a buffered response. Because ETag buffers the body, do not use it for
+// streaming or very large responses.
+//
+// NOTE: chaining ETag after NoCache prevents 304 responses, because NoCache
+// strips If-None-Match from the request.
+func ETag(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet && r.Method != http.MethodHead {
+			next.ServeHTTP(w, r)
+			return
+		}
+
+		ew := &etagResponseWriter{ResponseWriter: w}
+		next.ServeHTTP(ew, r)
+		ew.send(r)
+	})
+}
+
+type etagResponseWriter struct {
+	http.ResponseWriter
+
+	status   int         // final status, 0 until the first WriteHeader or Write
+	header   http.Header // header snapshot taken when the status is committed
+	body     bytes.Buffer
+	hijacked bool
+}
+
+// commit records the final status and a snapshot of the headers. Calls after
+// the first one are ignored, as net/http does.
+func (ew *etagResponseWriter) commit(code int) {
+	if ew.status != 0 {
+		return
+	}
+	ew.status = code
+	ew.header = ew.ResponseWriter.Header().Clone()
+}
+
+func (ew *etagResponseWriter) WriteHeader(code int) {
+	// Informational responses are sent immediately and are not the final status.
+	if code >= 100 && code <= 199 && code != http.StatusSwitchingProtocols {
+		if ew.status == 0 {
+			ew.ResponseWriter.WriteHeader(code)
+		}
+		return
+	}
+	ew.commit(code)
+}
+
+func (ew *etagResponseWriter) Write(p []byte) (int, error) {
+	if ew.hijacked {
+		return 0, http.ErrHijacked
+	}
+	ew.commit(http.StatusOK)
+	if len(p) == 0 {
+		return 0, nil
+	}
+	// As net/http does, refuse a body for statuses that cannot carry one.
+	if ew.status == http.StatusNoContent || ew.status == http.StatusNotModified {
+		return 0, http.ErrBodyNotAllowed
+	}
+	return ew.body.Write(p)
+}
+
+// Flush is a no-op: the buffered response is only sent once the handler returns.
+func (ew *etagResponseWriter) Flush() {}
+
+func (ew *etagResponseWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	hj, ok := ew.ResponseWriter.(http.Hijacker)
+	if !ok {
+		return nil, nil, errors.New("chi/middleware: http.Hijacker is unavailable on the writer")
+	}
+	conn, rw, err := hj.Hijack()
+	if err == nil {
+		ew.hijacked = true
+	}
+	return conn, rw, err
+}
+
+func (ew *etagResponseWriter) Push(target string, opts *http.PushOptions) error {
+	if ps, ok := ew.ResponseWriter.(http.Pusher); ok {
+		return ps.Push(target, opts)
+	}
+	return errors.New("chi/middleware: http.Pusher is unavailable on the writer")
+}
+
+func (ew *etagResponseWriter) Unwrap() http.ResponseWriter {
+	return ew.ResponseWriter
+}
+
+// send writes the buffered response to the underlying writer.
+func (ew *etagResponseWriter) send(r *http.Request) {
+	if ew.hijacked {
+		return
+	}
+	ew.commit(http.StatusOK)
+
+	h := ew.ResponseWriter.Header()
+	trailers := trailerEntries(h)
+	clear(h)
+	maps.Copy(h, ew.header)
+
+	body := ew.body.Bytes()
+	if ew.status == http.StatusOK {
+		if h.Get("ETag") == "" {
+			sum := sha256.Sum256(body)
+			h.Set("ETag", `"`+hex.EncodeToString(sum[:])+`"`)
+		}
+		if ifNoneMatch(r.Header.Values("If-None-Match"), h.Get("ETag")) {
+			h.Del("Content-Type")
+			h.Del("Content-Length")
+			h.Del("Content-Encoding")
+			h.Del("Transfer-Encoding")
+			ew.ResponseWriter.WriteHeader(http.StatusNotModified)
+			return
+		}
+	}
+
+	ew.ResponseWriter.WriteHeader(ew.status)
+	// Trailers are read from the header map after the body, so they are
+	// restored after WriteHeader to keep them out of the header section.
+	maps.Copy(h, trailers)
+	// net/http discards the body of a HEAD response but still derives
+	// Content-Length and Content-Type from it, as it does without the wrapper.
+	if len(body) > 0 {
+		_, _ = ew.ResponseWriter.Write(body)
+	}
+}
+
+// trailerEntries returns the header entries sent as trailers: those named in
+// the Trailer header and those written with the TrailerPrefix.
+func trailerEntries(h http.Header) http.Header {
+	trailers := make(http.Header)
+	for _, v := range h.Values("Trailer") {
+		for _, name := range strings.Split(v, ",") {
+			k := http.CanonicalHeaderKey(strings.TrimSpace(name))
+			if vals, ok := h[k]; ok {
+				trailers[k] = vals
+			}
+		}
+	}
+	for k, vals := range h {
+		if strings.HasPrefix(k, http.TrailerPrefix) {
+			trailers[k] = vals
+		}
+	}
+	return trailers
+}
+
+// ifNoneMatch reports whether the If-None-Match field lines match the entity
+// tag, following RFC 9110 section 13.1.2. The lines are combined before parsing.
+func ifNoneMatch(lines []string, tag string) bool {
+	value := strings.Trim(strings.Join(lines, ","), " \t")
+	if value == "*" {
+		return true
+	}
+	opaque, ok := parseETagOpaque(tag)
+	if !ok {
+		return false
+	}
+	for _, member := range splitETagList(value) {
+		if o, ok := parseETagOpaque(member); ok && o == opaque {
+			return true
+		}
+	}
+	return false
+}
+
+// splitETagList splits a comma-separated entity-tag list on commas outside
+// quoted strings. Each member has its optional whitespace trimmed and may be empty.
+func splitETagList(value string) []string {
+	var members []string
+	start, inQuotes := 0, false
+	for i := 0; i < len(value); i++ {
+		switch value[i] {
+		case '"':
+			inQuotes = !inQuotes
+		case ',':
+			if !inQuotes {
+				members = append(members, strings.Trim(value[start:i], " \t"))
+				start = i + 1
+			}
+		}
+	}
+	return append(members, strings.Trim(value[start:], " \t"))
+}
+
+// parseETagOpaque returns the opaque-tag of an entity-tag such as "abc" or W/"abc".
+// It reports false for anything that is not a well-formed entity-tag.
+func parseETagOpaque(tag string) (string, bool) {
+	tag = strings.TrimPrefix(tag, "W/")
+	if len(tag) < 2 || tag[0] != '"' || tag[len(tag)-1] != '"' {
+		return "", false
+	}
+	opaque := tag[1 : len(tag)-1]
+	if strings.Contains(opaque, `"`) {
+		return "", false
+	}
+	return opaque, true
+}
diff --git a/middleware/etag_test.go b/middleware/etag_test.go
new file mode 100644
index 0000000..afb81a5
--- /dev/null
+++ b/middleware/etag_test.go
@@ -0,0 +1,683 @@
+package middleware
+
+import (
+	"bufio"
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+// etagFakeWriter records what reaches the underlying writer. It also implements
+// Hijacker and Pusher so forwarding can be checked.
+type etagFakeWriter struct {
+	header   http.Header
+	codes    []int
+	body     bytes.Buffer
+	hijacked bool
+	pushed   bool
+}
+
+func newETagFakeWriter() *etagFakeWriter {
+	return &etagFakeWriter{header: make(http.Header)}
+}
+
+func (w *etagFakeWriter) Header() http.Header { return w.header }
+
+func (w *etagFakeWriter) WriteHeader(code int) { w.codes = append(w.codes, code) }
+
+func (w *etagFakeWriter) Write(p []byte) (int, error) { return w.body.Write(p) }
+
+func (w *etagFakeWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	w.hijacked = true
+	return nil, nil, nil
+}
+
+func (w *etagFakeWriter) Push(target string, opts *http.PushOptions) error {
+	w.pushed = true
+	return nil
+}
+
+func etagWant(body string) string {
+	sum := sha256.Sum256([]byte(body))
+	return `"` + hex.EncodeToString(sum[:]) + `"`
+}
+
+func etagServe(h http.Handler, method string, ifNoneMatch ...string) *httptest.ResponseRecorder {
+	r := httptest.NewRequest(method, "/", nil)
+	for _, v := range ifNoneMatch {
+		r.Header.Add("If-None-Match", v)
+	}
+	rec := httptest.NewRecorder()
+	ETag(h).ServeHTTP(rec, r)
+	return rec
+}
+
+func etagBodyHandler(body string) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		_, _ = io.WriteString(w, body)
+	}
+}
+
+func TestETagPassesThroughOtherMethods(t *testing.T) {
+	tests := []string{http.MethodPost, http.MethodPut, http.MethodDelete, http.MethodOptions, "get"}
+	for _, method := range tests {
+		t.Run(method, func(t *testing.T) {
+			var wrapped bool
+			h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				_, wrapped = w.(*etagResponseWriter)
+				w.Header().Set("Content-Type", "text/plain")
+				w.WriteHeader(http.StatusOK)
+				_, _ = io.WriteString(w, "body")
+			})
+			rec := etagServe(h, method, etagWant("body"))
+			if wrapped {
+				t.Error("handler received the ETag wrapper, want the original ResponseWriter")
+			}
+			if rec.Code != http.StatusOK {
+				t.Errorf("status = %d, want 200", rec.Code)
+			}
+			if rec.Body.String() != "body" {
+				t.Errorf("body = %q, want %q", rec.Body.String(), "body")
+			}
+			if got := rec.Header().Get("ETag"); got != "" {
+				t.Errorf("ETag = %q, want none", got)
+			}
+		})
+	}
+}
+
+func TestETagComputesStrongTag(t *testing.T) {
+	big := strings.Repeat("a", 10<<20)
+	tests := []struct {
+		name   string
+		writes []string
+	}{
+		{"empty body", nil},
+		{"single write", []string{"hello"}},
+		{"many small writes", []string{"he", "l", "", "lo"}},
+		{"10 MB body", []string{big}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				for _, p := range tt.writes {
+					_, _ = io.WriteString(w, p)
+				}
+			})
+			body := strings.Join(tt.writes, "")
+			rec := etagServe(h, http.MethodGet)
+			if rec.Code != http.StatusOK {
+				t.Errorf("status = %d, want 200", rec.Code)
+			}
+			if got := rec.Header().Get("ETag"); got != etagWant(body) {
+				t.Errorf("ETag = %q, want %q", got, etagWant(body))
+			}
+			if rec.Body.String() != body {
+				t.Errorf("body length = %d, want %d", rec.Body.Len(), len(body))
+			}
+		})
+	}
+}
+
+func TestETagTagDependsOnBody(t *testing.T) {
+	first := etagServe(etagBodyHandler("hello"), http.MethodGet).Header().Get("ETag")
+	again := etagServe(etagBodyHandler("hello"), http.MethodGet).Header().Get("ETag")
+	other := etagServe(etagBodyHandler("hellO"), http.MethodGet).Header().Get("ETag")
+	if first != again {
+		t.Errorf("same body gave different tags: %q and %q", first, again)
+	}
+	if first == other {
+		t.Errorf("different bodies gave the same tag %q", first)
+	}
+}
+
+func TestETagHEAD(t *testing.T) {
+	get := etagServe(etagBodyHandler("hello"), http.MethodGet)
+	head := etagServe(etagBodyHandler("hello"), http.MethodHead)
+	if head.Header().Get("ETag") != get.Header().Get("ETag") {
+		t.Errorf("HEAD ETag = %q, want %q", head.Header().Get("ETag"), get.Header().Get("ETag"))
+	}
+	if head.Code != http.StatusOK {
+		t.Errorf("HEAD status = %d, want 200", head.Code)
+	}
+}
+
+func TestETagBufferedStatusAndBody(t *testing.T) {
+	tests := []struct {
+		name     string
+		handler  func(w http.ResponseWriter)
+		wantBody string
+	}{
+		{"second WriteHeader ignored", func(w http.ResponseWriter) {
+			w.WriteHeader(http.StatusOK)
+			w.WriteHeader(http.StatusInternalServerError)
+		}, ""},
+		{"Write before WriteHeader is 200", func(w http.ResponseWriter) {
+			_, _ = io.WriteString(w, "hi")
+			w.WriteHeader(http.StatusNotFound)
+		}, "hi"},
+		{"headers only is 200 with empty body", func(w http.ResponseWriter) {
+			w.Header().Set("X-Test", "1")
+		}, ""},
+		{"io.Copy stays buffered", func(w http.ResponseWriter) {
+			_, _ = io.Copy(w, strings.NewReader("copied"))
+		}, "copied"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			rec := etagServe(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				tt.handler(w)
+			}), http.MethodGet)
+			if rec.Code != http.StatusOK {
+				t.Errorf("status = %d, want 200", rec.Code)
+			}
+			if rec.Body.String() != tt.wantBody {
+				t.Errorf("body = %q, want %q", rec.Body.String(), tt.wantBody)
+			}
+			if got := rec.Header().Get("ETag"); got != etagWant(tt.wantBody) {
+				t.Errorf("ETag = %q, want %q", got, etagWant(tt.wantBody))
+			}
+		})
+	}
+}
+
+func TestETagNothingSentBeforeHandlerReturns(t *testing.T) {
+	fake := newETagFakeWriter()
+	var early bool
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusOK)
+		_, _ = io.WriteString(w, "a")
+		w.(http.Flusher).Flush()
+		early = len(fake.codes) != 0 || fake.body.Len() != 0
+	})
+	ETag(h).ServeHTTP(fake, httptest.NewRequest(http.MethodGet, "/", nil))
+	if early {
+		t.Error("response reached the underlying writer before the handler returned")
+	}
+	if len(fake.codes) != 1 || fake.codes[0] != http.StatusOK || fake.body.String() != "a" {
+		t.Errorf("sent codes %v body %q, want [200] \"a\"", fake.codes, fake.body.String())
+	}
+}
+
+func TestETagInformationalStatusForwardedImmediately(t *testing.T) {
+	fake := newETagFakeWriter()
+	var early []int
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusEarlyHints)
+		early = append(early, fake.codes...)
+		w.WriteHeader(http.StatusNotFound)
+		_, _ = io.WriteString(w, "ok")
+	})
+	ETag(h).ServeHTTP(fake, httptest.NewRequest(http.MethodGet, "/", nil))
+	if len(early) != 1 || early[0] != http.StatusEarlyHints {
+		t.Errorf("codes sent during handler = %v, want [103]", early)
+	}
+	if len(fake.codes) != 2 || fake.codes[0] != http.StatusEarlyHints || fake.codes[1] != http.StatusNotFound {
+		t.Errorf("codes = %v, want [103 404]", fake.codes)
+	}
+}
+
+func TestETagHandlerSetETag(t *testing.T) {
+	tests := []struct {
+		name     string
+		set      func(h http.Header)
+		wantTag  string
+		ifNone   string
+		wantCode int
+	}{
+		{"strong kept", func(h http.Header) { h.Set("ETag", `"v1"`) }, `"v1"`, "", http.StatusOK},
+		{"weak kept", func(h http.Header) { h.Set("ETag", `W/"v1"`) }, `W/"v1"`, "", http.StatusOK},
+		{"lowercase name detected", func(h http.Header) { h.Set("etag", `"mine"`) }, `"mine"`, "", http.StatusOK},
+		{"weak handler tag matches strong INM", func(h http.Header) { h.Set("ETag", `W/"v1"`) }, `W/"v1"`, `"v1"`, http.StatusNotModified},
+		{"strong handler tag matches weak INM", func(h http.Header) { h.Set("ETag", `"v1"`) }, `"v1"`, `W/"v1"`, http.StatusNotModified},
+		{"handler tag not matching INM", func(h http.Header) { h.Set("ETag", `"v1"`) }, `"v1"`, `"v2"`, http.StatusOK},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				tt.set(w.Header())
+				_, _ = io.WriteString(w, "body")
+			})
+			rec := etagServe(h, http.MethodGet, tt.ifNone)
+			if rec.Code != tt.wantCode {
+				t.Errorf("status = %d, want %d", rec.Code, tt.wantCode)
+			}
+			if got := rec.Header().Get("ETag"); got != tt.wantTag {
+				t.Errorf("ETag = %q, want %q", got, tt.wantTag)
+			}
+		})
+	}
+}
+
+func TestETagNotModifiedResponse(t *testing.T) {
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "text/plain")
+		w.Header().Set("Content-Length", "5")
+		w.Header().Set("Content-Encoding", "gzip")
+		w.Header().Set("Transfer-Encoding", "chunked")
+		w.Header().Set("Cache-Control", "max-age=60")
+		w.Header().Set("Vary", "Accept")
+		w.Header().Set("Last-Modified", "Mon, 02 Jan 2006 15:04:05 GMT")
+		_, _ = io.WriteString(w, "hello")
+	})
+	for _, method := range []string{http.MethodGet, http.MethodHead} {
+		t.Run(method, func(t *testing.T) {
+			rec := etagServe(h, method, etagWant("hello"))
+			if rec.Code != http.StatusNotModified {
+				t.Errorf("status = %d, want 304", rec.Code)
+			}
+			if rec.Body.Len() != 0 {
+				t.Errorf("body = %q, want empty", rec.Body.String())
+			}
+			for _, k := range []string{"Content-Type", "Content-Length", "Content-Encoding", "Transfer-Encoding"} {
+				if _, ok := rec.Header()[k]; ok {
+					t.Errorf("%s present on 304, want removed", k)
+				}
+			}
+			for k, want := range map[string]string{
+				"ETag":          etagWant("hello"),
+				"Cache-Control": "max-age=60",
+				"Vary":          "Accept",
+				"Last-Modified": "Mon, 02 Jan 2006 15:04:05 GMT",
+			} {
+				if got := rec.Header().Get(k); got != want {
+					t.Errorf("%s = %q, want %q", k, got, want)
+				}
+			}
+		})
+	}
+}
+
+func TestETagNonOKStatusReplayed(t *testing.T) {
+	tests := []struct {
+		name     string
+		code     int
+		body     string
+		ifNone   string
+		wantBody string
+	}{
+		{"201 created", http.StatusCreated, "made", etagWant("made"), "made"},
+		{"204 no content", http.StatusNoContent, "", etagWant(""), ""},
+		{"206 partial", http.StatusPartialContent, "part", etagWant("part"), "part"},
+		{"301 redirect", http.StatusMovedPermanently, "", etagWant(""), ""},
+		{"304 from handler", http.StatusNotModified, "", "*", ""},
+		{"404 with star", http.StatusNotFound, "missing", "*", "missing"},
+		{"500 with star", http.StatusInternalServerError, "boom", "*", "boom"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("X-Custom", "1")
+				w.WriteHeader(tt.code)
+				_, _ = io.WriteString(w, tt.body)
+			})
+			rec := etagServe(h, http.MethodGet, tt.ifNone)
+			if rec.Code != tt.code {
+				t.Errorf("status = %d, want %d", rec.Code, tt.code)
+			}
+			if rec.Body.String() != tt.wantBody {
+				t.Errorf("body = %q, want %q", rec.Body.String(), tt.wantBody)
+			}
+			if got := rec.Header().Get("ETag"); got != "" {
+				t.Errorf("ETag = %q, want none", got)
+			}
