+	}{
+		{"sniffed content type and length", func(w http.ResponseWriter, r *http.Request) {
+			_, _ = io.WriteString(w, "<p>hello</p>")
+		}},
+		{"explicit content length", func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Content-Length", "5")
+			_, _ = io.WriteString(w, "hello")
+		}},
+		{"404 sniffed content type and length", func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(http.StatusNotFound)
+			_, _ = io.WriteString(w, "missing")
+		}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			wrapped, wrappedBody := etagRoundTrip(t, ETag(tt.handler), http.MethodHead)
+			plain, _ := etagRoundTrip(t, tt.handler, http.MethodHead)
+			if wrapped.StatusCode != plain.StatusCode {
+				t.Errorf("status = %d, want %d", wrapped.StatusCode, plain.StatusCode)
+			}
+			if len(wrappedBody) != 0 {
+				t.Errorf("HEAD body = %q, want empty", wrappedBody)
+			}
+			wh := wrapped.Header.Clone()
+			wh.Del("ETag")
+			wh.Del("Date")
+			ph := plain.Header.Clone()
+			ph.Del("Date")
+			if !reflect.DeepEqual(wh, ph) {
+				t.Errorf("headers = %v, want %v", wh, ph)
+			}
+		})
+	}
+}
