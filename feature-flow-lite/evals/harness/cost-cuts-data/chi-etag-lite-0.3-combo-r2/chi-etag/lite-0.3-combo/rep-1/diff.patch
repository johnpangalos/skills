+func TestETagHijack(t *testing.T) {
+	t.Run("forwarded", func(t *testing.T) {
+		rec := &etagHijacker{ResponseRecorder: httptest.NewRecorder()}
+		h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			if _, _, err := w.(http.Hijacker).Hijack(); err != nil {
+				t.Errorf("Hijack: %v", err)
+			}
+			w.Write([]byte("after hijack"))
+		}))
+		h.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/", nil))
+		if !rec.hijacked {
+			t.Error("Hijack was not forwarded")
+		}
+		if rec.Body.Len() != 0 || rec.Header().Get("ETag") != "" {
+			t.Errorf("middleware wrote after hijack: body=%q headers=%v", rec.Body.String(), rec.Header())
+		}
+	})
+	t.Run("unsupported", func(t *testing.T) {
+		h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			if _, _, err := w.(http.Hijacker).Hijack(); err != http.ErrNotSupported {
+				t.Errorf("Hijack error = %v, want %v", err, http.ErrNotSupported)
+			}
+		}))
+		h.ServeHTTP(httptest.NewRecorder(), httptest.NewRequest(http.MethodGet, "/", nil))
+	})
+}
