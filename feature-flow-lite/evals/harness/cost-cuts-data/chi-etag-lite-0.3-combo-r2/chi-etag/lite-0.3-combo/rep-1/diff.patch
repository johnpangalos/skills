+func TestETagHeadersSnapshotAtStatus(t *testing.T) {
+	cases := []struct {
+		name   string
+		status int
+		body   string
+	}{
+		{"404", http.StatusNotFound, "nf"},
+		{"500", http.StatusInternalServerError, "boom"},
+		{"200", http.StatusOK, "ok"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			ts := httptest.NewServer(ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Content-Type", "text/x-original")
+				w.WriteHeader(tc.status)
+				w.Write([]byte(tc.body))
+				w.Header().Del("Content-Type")
+				w.Header().Set("X-After", "1")
+			})))
+			defer ts.Close()
+
+			resp, err := http.Get(ts.URL)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer resp.Body.Close()
+			if resp.StatusCode != tc.status {
+				t.Errorf("code = %d, want %d", resp.StatusCode, tc.status)
+			}
+			if got := resp.Header.Get("Content-Type"); got != "text/x-original" {
+				t.Errorf("Content-Type = %q, want the value at status time", got)
+			}
+			if got := resp.Header.Get("X-After"); got != "" {
+				t.Errorf("X-After = %q, want it dropped as without the middleware", got)
+			}
+			if tc.status != http.StatusOK && resp.Header.Get("ETag") != "" {
+				t.Errorf("non-200 got ETag %q", resp.Header.Get("ETag"))
+			}
+		})
+	}
+}
