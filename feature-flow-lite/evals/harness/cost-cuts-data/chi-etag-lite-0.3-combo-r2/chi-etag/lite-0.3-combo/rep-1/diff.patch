+func TestETagInformationalResponsesForwarded(t *testing.T) {
+	t.Run("103 then 200", func(t *testing.T) {
+		ts := httptest.NewServer(ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(http.StatusEarlyHints)
+			w.WriteHeader(http.StatusOK)
+			w.Write([]byte("hello"))
+		})))
+		defer ts.Close()
+
+		resp, informational := etagGetWithTrace(t, ts.URL, nil)
+		if len(informational) != 1 || informational[0] != http.StatusEarlyHints {
+			t.Errorf("1xx responses = %v, want [103]", informational)
+		}
+		if resp.StatusCode != http.StatusOK || resp.Header.Get("ETag") != etagTag("hello") {
+			t.Errorf("final: code=%d etag=%q", resp.StatusCode, resp.Header.Get("ETag"))
+		}
+
+		resp, _ = etagGetWithTrace(t, ts.URL, map[string]string{"If-None-Match": "*"})
+		if resp.StatusCode != http.StatusNotModified {
+			t.Errorf("If-None-Match: * code = %d, want 304", resp.StatusCode)
+		}
+	})
+	t.Run("103 then 404", func(t *testing.T) {
+		ts := httptest.NewServer(ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(http.StatusEarlyHints)
+			w.WriteHeader(http.StatusNotFound)
+		})))
+		defer ts.Close()
+
+		resp, informational := etagGetWithTrace(t, ts.URL, nil)
+		if len(informational) != 1 || informational[0] != http.StatusEarlyHints {
+			t.Errorf("1xx responses = %v, want [103]", informational)
+		}
+		if resp.StatusCode != http.StatusNotFound {
+			t.Errorf("final code = %d, want 404", resp.StatusCode)
+		}
+	})
+}
