+func TestETagDeletedHeadersNotSent(t *testing.T) {
+	outer := func(next http.Handler) http.Handler {
+		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Cache-Control", "no-store")
+			w.Header().Set("X-Outer", "1")
+			next.ServeHTTP(w, r)
+		})
+	}
+	for _, status := range []int{http.StatusNotFound, http.StatusOK} {
+		t.Run(http.StatusText(status), func(t *testing.T) {
+			inner := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Del("Cache-Control")
+				w.Header().Del("X-Outer")
+				w.Header().Set("ETag", `"v1"`)
+				w.WriteHeader(status)
+				w.Write([]byte("body"))
+			})
+			want := etagResult(outer(inner))
+			got := etagResult(outer(ETag(inner)))
+			etagCheckSameHeaders(t, want, got)
+			if got.StatusCode != status {
+				t.Errorf("code = %d, want %d", got.StatusCode, status)
+			}
+			if got.Header.Get("Cache-Control") != "" || got.Header.Get("X-Outer") != "" {
+				t.Errorf("deleted headers were sent: %v", got.Header)
+			}
+		})
+	}
+}
