diff --git a/middleware/etag.go b/middleware/etag.go
new file mode 100644
index 0000000..3a965b7
--- /dev/null
+++ b/middleware/etag.go
@@ -0,0 +1,289 @@
+package middleware
+
+import (
+	"bufio"
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"maps"
+	"net"
+	"net/http"
+	"slices"
+	"strings"
+)
+
+// ETag is a middleware that adds a strong entity tag to GET and HEAD responses
+// and answers 304 Not Modified when If-None-Match matches it.
+//
+// The whole response is buffered until the handler returns, so Flush does not
+// stream anything to the client. When the final status is 200 and the handler
+// has not set an ETag header, the tag is the SHA-256 of the body. For HEAD the
+// tag is computed only if the handler wrote body bytes, so a HEAD response
+// without a body gets no computed tag; only a handler-set ETag or "*" can
+// match it. A handler-set ETag is never changed.
+//
+// A 200 whose tag matches If-None-Match (weak comparison, RFC 9110 section
+// 13.1.2) becomes a 304 with no body. Content-Type, Content-Length and
+// Content-Encoding are dropped, and Last-Modified is dropped when the tag is
+// non-empty, as net/http's writeNotModified does. Other statuses and other
+// methods pass through unchanged.
+//
+// ETag must run outside NoCache, which removes If-None-Match from the request,
+// and before Compress, so that each content-coding gets its own strong tag:
+//
+//	r.Use(middleware.ETag)
+//	r.Use(middleware.Compress(5))
+func ETag(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet && r.Method != http.MethodHead {
+			next.ServeHTTP(w, r)
+			return
+		}
+		ew := &etagWriter{w: w}
+		next.ServeHTTP(ew, r)
+		ew.finish(r)
+	})
+}
+
+// etagWriter buffers a GET or HEAD response until the handler returns.
+type etagWriter struct {
+	w           http.ResponseWriter
+	body        bytes.Buffer
+	status      int
+	wroteHeader bool
+	hijacked    bool
+	header      http.Header // snapshot of the header map at the final WriteHeader
+}
+
+func (ew *etagWriter) Header() http.Header {
+	return ew.w.Header()
+}
+
+func (ew *etagWriter) WriteHeader(code int) {
+	if code < 100 || code > 999 {
+		// Like net/http's checkWriteHeaderCode, so a Recoverer inside ETag sees it.
+		panic(fmt.Sprintf("invalid WriteHeader code %v", code))
+	}
+	if code >= 100 && code <= 199 && code != http.StatusSwitchingProtocols {
+		// Informational responses are forwarded only before the final status.
+		if !ew.wroteHeader {
+			ew.w.WriteHeader(code)
+		}
+		return
+	}
+	if ew.wroteHeader {
+		return
+	}
+	ew.wroteHeader = true
+	ew.status = code
+	ew.header = ew.w.Header().Clone()
+}
+
+func (ew *etagWriter) Write(p []byte) (int, error) {
+	if ew.hijacked {
+		return 0, http.ErrHijacked
+	}
+	ew.WriteHeader(http.StatusOK)
+	return ew.body.Write(p)
+}
+
+// Flush does not send anything: the response is sent once the handler returns.
+// Like net/http, it commits the implicit 200 and the header snapshot.
+func (ew *etagWriter) Flush() {
+	ew.WriteHeader(http.StatusOK)
+}
+
+func (ew *etagWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	hj, ok := ew.w.(http.Hijacker)
+	if !ok {
+		return nil, nil, fmt.Errorf("chi/middleware: hijack: %w", http.ErrNotSupported)
+	}
+	conn, rw, err := hj.Hijack()
+	if err == nil {
+		ew.hijacked = true
+	}
+	return conn, rw, err
+}
+
+func (ew *etagWriter) Push(target string, opts *http.PushOptions) error {
+	ps, ok := ew.w.(http.Pusher)
+	if !ok {
+		return fmt.Errorf("chi/middleware: push: %w", http.ErrNotSupported)
+	}
+	return ps.Push(target, opts)
+}
+
+func (ew *etagWriter) Unwrap() http.ResponseWriter {
+	return ew.w
+}
+
+// finish sends the buffered response. It is not deferred, so a panic in the
+// handler leaves the underlying writer untouched.
+func (ew *etagWriter) finish(r *http.Request) {
+	if ew.hijacked {
+		return
+	}
+	ew.WriteHeader(http.StatusOK)
+
+	// Trailers are read from the live map, which the handler may have changed
+	// after the snapshot. The header block is the snapshot without the
+	// http.TrailerPrefix keys, as net/http sends it.
+	trailers := collectTrailers(ew.w.Header(), ew.header)
+	h := ew.header
+	dropTrailers(h)
+
+	status := ew.status
+	etags, present := handlerETags(h)
+	if status == http.StatusOK {
+		if !present && (r.Method == http.MethodGet || ew.body.Len() > 0) {
+			sum := sha256.Sum256(ew.body.Bytes())
+			etags = []string{`"` + hex.EncodeToString(sum[:]) + `"`}
+			h.Set("ETag", etags[0])
+		}
+		if etagMatches(r.Header.Values("If-None-Match"), etags) {
+			status = http.StatusNotModified
+			delete(h, "Content-Type")
+			delete(h, "Content-Length")
+			delete(h, "Content-Encoding")
+			if slices.ContainsFunc(etags, func(etag string) bool { return etag != "" }) {
+				delete(h, "Last-Modified")
+			}
+			delete(h, "Trailer")
+			trailers = nil
+		}
+	}
+
+	clear(ew.w.Header())
+	maps.Copy(ew.w.Header(), h)
+	ew.w.WriteHeader(status)
+	if status != http.StatusNotModified && ew.body.Len() > 0 {
+		ew.w.Write(ew.body.Bytes())
+	}
+	// net/http reads declared trailers from the header map after the handler
+	// returns, so they are set only after the header block has been sent.
+	maps.Copy(ew.w.Header(), trailers)
+}
+
+// declaredTrailers returns the canonical names of the trailers h declares in
+// its Trailer header.
+func declaredTrailers(h http.Header) []string {
+	var names []string
+	for _, decl := range h.Values("Trailer") {
+		for _, name := range strings.Split(decl, ",") {
+			names = append(names, http.CanonicalHeaderKey(strings.TrimSpace(name)))
+		}
+	}
+	return names
+}
+
+// dropTrailers removes the http.TrailerPrefix keys from h. Declared trailer
+// names and the Trailer header are kept, as net/http sends them.
+func dropTrailers(h http.Header) {
+	for k := range h {
+		if strings.HasPrefix(k, http.TrailerPrefix) {
+			delete(h, k)
+		}
+	}
+}
+
+// collectTrailers returns the trailer values from live that the handler
+// declared in the snapshot's Trailer header or set with the http.TrailerPrefix.
+func collectTrailers(live, snapshot http.Header) http.Header {
+	trailers := http.Header{}
+	for _, name := range declaredTrailers(snapshot) {
+		if v, ok := live[name]; ok {
+			trailers[name] = v
+		}
+	}
+	for k, v := range live {
+		if strings.HasPrefix(k, http.TrailerPrefix) {
+			trailers[k] = v
+		}
+	}
+	return trailers
+}
+
+// handlerETags returns the values of the handler's ETag under any key
+// spelling, and whether the handler set the key at all. A nil value still
+// counts as set, which suppresses the computed tag.
+func handlerETags(h http.Header) ([]string, bool) {
+	var values []string
+	present := false
+	for k, v := range h {
+		if strings.EqualFold(k, "ETag") {
+			present = true
+			values = append(values, v...)
+		}
+	}
+	return values, present
+}
+
+// etagMatches reports whether If-None-Match (one or more header lines) matches
+// one of etags under weak comparison. A "*" member matches any response. A
+// malformed member never matches.
+func etagMatches(lines []string, etags []string) bool {
+	for _, line := range lines {
+		for {
+			line = strings.TrimSpace(line)
+			if line == "" {
+				break
+			}
+			if line[0] == ',' {
+				line = line[1:]
+				continue
+			}
+			if line[0] == '*' {
+				rest := strings.TrimSpace(line[1:])
+				if rest == "" || rest[0] == ',' {
+					return true
+				}
+				break
+			}
+			member, remain := scanETag(line)
+			if member == "" {
+				break
+			}
+			for _, etag := range etags {
+				if etagWeakMatch(member, etag) {
+					return true
+				}
+			}
+			line = remain
+		}
+	}
+	return false
+}
+
+// etagWeakMatch reports whether member matches etag under weak comparison.
+// A malformed etag never matches.
+func etagWeakMatch(member, etag string) bool {
+	tag, rest := scanETag(etag)
+	return tag != "" && strings.TrimSpace(rest) == "" &&
+		strings.TrimPrefix(member, "W/") == strings.TrimPrefix(tag, "W/")
+}
+
+// scanETag returns the entity tag at the start of s, including any W/ prefix,
+// and the remainder of s. It returns "" if s does not start with a valid tag.
+// Ported from net/http's scanETag.
+func scanETag(s string) (etag string, remain string) {
+	s = strings.TrimSpace(s)
+	start := 0
+	if strings.HasPrefix(s, "W/") {
+		start = 2
+	}
+	if len(s[start:]) < 2 || s[start] != '"' {
+		return "", ""
+	}
+	for i := start + 1; i < len(s); i++ {
+		c := s[i]
+		switch {
+		case c == 0x21 || c >= 0x23 && c <= 0x7E || c >= 0x80:
+		case c == '"':
+			return s[:i+1], s[i+1:]
+		default:
+			return "", ""
+		}
+	}
+	return "", ""
+}
diff --git a/middleware/etag_test.go b/middleware/etag_test.go
new file mode 100644
index 0000000..f10a617
--- /dev/null
+++ b/middleware/etag_test.go
@@ -0,0 +1,717 @@
+package middleware
+
+import (
+	"bufio"
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"io"
+	"log"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/http/httptrace"
+	"net/textproto"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func wantETag(body string) string {
+	sum := sha256.Sum256([]byte(body))
+	return `"` + hex.EncodeToString(sum[:]) + `"`
+}
+
+func newETagServer(t *testing.T, h http.HandlerFunc) *httptest.Server {
+	t.Helper()
+	ts := httptest.NewServer(ETag(h))
+	t.Cleanup(ts.Close)
+	return ts
+}
+
+func etagRequest(t *testing.T, ts *httptest.Server, method string, inm ...string) (*http.Response, string) {
+	t.Helper()
+	req, err := http.NewRequest(method, ts.URL, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, v := range inm {
+		req.Header.Add("If-None-Match", v)
+	}
+	resp, err := http.DefaultClient.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(resp.Body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return resp, string(body)
+}
+
+// syncBuffer is a bytes.Buffer safe for use as a server ErrorLog target.
+type syncBuffer struct {
+	mu  sync.Mutex
+	buf bytes.Buffer
+}
+
+func (b *syncBuffer) Write(p []byte) (int, error) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return b.buf.Write(p)
+}
+
+func (b *syncBuffer) String() string {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return b.buf.String()
+}
+
+func TestETagMethodGate(t *testing.T) {
+	const payload = "hello"
+	ts := newETagServer(t, func(w http.ResponseWriter, r *http.Request) {
+		if _, ok := w.(*etagWriter); ok {
+			t.Errorf("%s: handler received the buffering writer", r.Method)
+		}
+		io.WriteString(w, payload)
+	})
+
+	for _, method := range []string{"POST", "PUT", "DELETE", "PATCH", "OPTIONS", "get"} {
+		resp, body := etagRequest(t, ts, method, wantETag(payload))
+		if resp.StatusCode != http.StatusOK || body != payload {
+			t.Errorf("%s: got status %d body %q, want 200 %q", method, resp.StatusCode, body, payload)
+		}
+		if got := resp.Header.Get("ETag"); got != "" {
+			t.Errorf("%s: got ETag %q, want none", method, got)
+		}
+	}
+}
+
+func TestETagImplicit200EmptyBody(t *testing.T) {
+	ts := newETagServer(t, func(w http.ResponseWriter, r *http.Request) {})
+
+	resp, body := etagRequest(t, ts, "GET")
+	if resp.StatusCode != http.StatusOK || body != "" {
+		t.Errorf("got status %d body %q, want 200 empty", resp.StatusCode, body)
+	}
+	const emptySHA256 = `"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"`
+	if got := resp.Header.Get("ETag"); got != emptySHA256 {
+		t.Errorf("got ETag %q, want %q", got, emptySHA256)
+	}
+}
+
+func TestETagFirstWriteHeaderWins(t *testing.T) {
+	ts := newETagServer(t, func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusOK)
+		w.WriteHeader(http.StatusInternalServerError)
+		io.WriteString(w, "ok")
+	})
+
+	resp, body := etagRequest(t, ts, "GET")
+	if resp.StatusCode != http.StatusOK || body != "ok" {
+		t.Errorf("got status %d body %q, want 200 \"ok\"", resp.StatusCode, body)
+	}
+}
+
+func TestETagFlushCommitsStatus(t *testing.T) {
+	rec := httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodGet, "/", nil)
+	ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.(http.Flusher).Flush()
+		w.Header().Set("X-Late", "1")
+		w.WriteHeader(http.StatusNotFound)
+		io.WriteString(w, "ok")
+	})).ServeHTTP(rec, req)
+
+	if rec.Code != http.StatusOK || rec.Body.String() != "ok" {
+		t.Errorf("got status %d body %q, want 200 \"ok\"", rec.Code, rec.Body.String())
+	}
+	if got := rec.Header().Get("X-Late"); got != "" {
+		t.Errorf("X-Late set after Flush was sent: %q", got)
+	}
+}
+
+func TestETagLargeBodyManyWrites(t *testing.T) {
+	payload := strings.Repeat("abcdefgh", 512*1024)
+	ts := newETagServer(t, func(w http.ResponseWriter, r *http.Request) {
+		for i := 0; i < len(payload); i += 1024 {
+			io.WriteString(w, payload[i:i+1024])
+		}
+	})
+
+	resp, body := etagRequest(t, ts, "GET")
+	if body != payload {
+		t.Errorf("body mismatch: got %d bytes, want %d", len(body), len(payload))
+	}
+	if got := resp.Header.Get("ETag"); got != wantETag(payload) {
+		t.Errorf("got ETag %q, want %q", got, wantETag(payload))
+	}
+}
+
+func TestETagComputedTag(t *testing.T) {
+	bodies := map[string]string{
+		"hello":          "hello",
+		"equal length a": "aaaa",
+		"equal length b": "bbbb",
+		"quotes commas":  `a",b"c,"`,
+		"empty":          "",
+	}
+	for name, payload := range bodies {
+		ts := newETagServer(t, func(w http.ResponseWriter, r *http.Request) {
+			io.WriteString(w, payload)
+		})
+		resp, _ := etagRequest(t, ts, "GET")
+		if got := resp.Header.Get("ETag"); got != wantETag(payload) {
+			t.Errorf("%s: got ETag %q, want %q", name, got, wantETag(payload))
+		}
+	}
+
+	const helloSHA256 = `"2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824"`
+	ts := newETagServer(t, func(w http.ResponseWriter, r *http.Request) {
+		io.WriteString(w, "hello")
+	})
+	resp, _ := etagRequest(t, ts, "GET")
+	if got := resp.Header.Get("ETag"); got != helloSHA256 {
+		t.Errorf("got ETag %q, want %q", got, helloSHA256)
+	}
+	headResp, _ := etagRequest(t, ts, "HEAD")
+	if got := headResp.Header.Get("ETag"); got != helloSHA256 {
+		t.Errorf("HEAD: got ETag %q, want %q", got, helloSHA256)
+	}
+}
+
+func TestETagHEADServeContent(t *testing.T) {
+	ts := newETagServer(t, func(w http.ResponseWriter, r *http.Request) {
+		http.ServeContent(w, r, "file.txt", time.Time{}, strings.NewReader("hello"))
+	})
+
+	resp, _ := etagRequest(t, ts, "HEAD")
+	if got := resp.Header.Get("ETag"); got != "" {
+		t.Errorf("HEAD: got ETag %q, want none", got)
+	}
+	resp, _ = etagRequest(t, ts, "HEAD", wantETag("hello"))
+	if resp.StatusCode != http.StatusOK {
+		t.Errorf("HEAD with GET's tag: got status %d, want 200", resp.StatusCode)
+	}
+	resp, _ = etagRequest(t, ts, "HEAD", wantETag(""))
+	if resp.StatusCode != http.StatusOK {
+		t.Errorf("HEAD with empty-body tag: got status %d, want 200", resp.StatusCode)
+	}
+	resp, _ = etagRequest(t, ts, "GET", wantETag("hello"))
+	if resp.StatusCode != http.StatusNotModified {
+		t.Errorf("GET with its tag: got status %d, want 304", resp.StatusCode)
+	}
+}
+
+func TestETagHandlerSetTag(t *testing.T) {
+	tests := []struct {
+		name string
+		set  func(h http.Header)
+		want string
+	}{
+		{"weak kept", func(h http.Header) { h.Set("ETag", `W/"x"`) }, `W/"x"`},
+		{"malformed kept", func(h http.Header) { h.Set("ETag", "abc") }, "abc"},
+		{"nil suppresses", func(h http.Header) { h["Etag"] = nil }, ""},
+	}
+	for _, tc := range tests {
+		ts := newETagServer(t, func(w http.ResponseWriter, r *http.Request) {
+			tc.set(w.Header())
+			io.WriteString(w, "payload")
+		})
+		resp, _ := etagRequest(t, ts, "GET")
+		if got := resp.Header.Get("ETag"); got != tc.want {
+			t.Errorf("%s: got ETag %q, want %q", tc.name, got, tc.want)
+		}
+		if _, ok := resp.Header["Etag"]; ok != (tc.want != "") {
+			t.Errorf("%s: ETag presence %v, want %v", tc.name, ok, tc.want != "")
+		}
+	}
+}
+
+func TestETagNonCanonicalKey(t *testing.T) {
+	ts := newETagServer(t, func(w http.ResponseWriter, r *http.Request) {
+		w.Header()["ETag"] = []string{`"x"`}
+		io.WriteString(w, "payload")
+	})
+
+	resp, _ := etagRequest(t, ts, "GET")
+	if resp.StatusCode != http.StatusOK {
+		t.Errorf("got status %d, want 200", resp.StatusCode)
+	}
+	if got := resp.Header.Values("Etag"); len(got) != 1 || got[0] != `"x"` {
+		t.Errorf("got ETag values %q, want only \"x\"", got)
+	}
+
+	resp, _ = etagRequest(t, ts, "GET", `"x"`)
+	if resp.StatusCode != http.StatusNotModified {
+		t.Errorf("got status %d, want 304", resp.StatusCode)
+	}
+}
+
+func TestETag304OnMatch(t *testing.T) {
+	const payload = "hello"
+	ts := newETagServer(t, func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "text/plain")
+		w.Header().Set("Content-Length", "5")
+		// net/http's client does not decode br, so the header stays visible.
+		w.Header().Set("Content-Encoding", "br")
+		w.Header().Set("Cache-Control", "max-age=60")
+		w.Header().Set("Vary", "Accept")
+		io.WriteString(w, payload)
+	})
+
+	for _, method := range []string{"GET", "HEAD"} {
+		resp, body := etagRequest(t, ts, method, wantETag(payload))
+		if resp.StatusCode != http.StatusNotModified || body != "" {
+			t.Errorf("%s: got status %d body %q, want 304 empty", method, resp.StatusCode, body)
+		}
+		if got := resp.Header.Get("ETag"); got != wantETag(payload) {
+			t.Errorf("%s: got ETag %q, want %q", method, got, wantETag(payload))
+		}
+		if got := resp.Header.Get("Cache-Control"); got != "max-age=60" {
+			t.Errorf("%s: got Cache-Control %q, want kept", method, got)
+		}
+		if got := resp.Header.Get("Vary"); got != "Accept" {
+			t.Errorf("%s: got Vary %q, want kept", method, got)
+		}
+		if got := resp.Header.Get("Content-Type"); got != "" {
+			t.Errorf("%s: got Content-Type %q, want dropped", method, got)
+		}
+		if got := resp.Header.Get("Content-Encoding"); got != "" {
+			t.Errorf("%s: got Content-Encoding %q, want dropped", method, got)
+		}
+	}
+}
+
