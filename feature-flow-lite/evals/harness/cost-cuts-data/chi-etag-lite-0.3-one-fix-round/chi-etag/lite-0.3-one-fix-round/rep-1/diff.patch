+func TestETagTrailers(t *testing.T) {
+	handler := func(code int, early bool) http.HandlerFunc {
+		return func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Trailer", "X-Checksum")
+			if early {
+				w.Header().Set("X-Checksum", "early")
+			}
+			w.WriteHeader(code)
+			io.WriteString(w, "body")
+			w.Header().Set("X-Checksum", "abc")
+			w.Header().Set(http.TrailerPrefix+"X-Late", "late")
+		}
+	}
+
+	tests := []struct {
+		name       string
+		code       int
+		early      bool
+		wantHeader string
+	}{
+		{"200 early and late", http.StatusOK, true, "early"},
+		{"404 early and late", http.StatusNotFound, true, "early"},
+		{"200 late only", http.StatusOK, false, ""},
+	}
+	for _, tc := range tests {
+		ts := newETagServer(t, handler(tc.code, tc.early))
+
+		resp, body := etagRequest(t, ts, "GET")
+		if resp.StatusCode != tc.code || body != "body" {
+			t.Errorf("%s: got status %d body %q, want %d \"body\"", tc.name, resp.StatusCode, body, tc.code)
+		}
+		if got := resp.Header.Get("X-Checksum"); got != tc.wantHeader {
+			t.Errorf("%s: X-Checksum in header block %q, want %q", tc.name, got, tc.wantHeader)
+		}
+		if got := resp.Header.Values("X-Late"); len(got) != 0 {
+			t.Errorf("%s: X-Late in header block: %q", tc.name, got)
+		}
+		if got := resp.Trailer.Get("X-Checksum"); got != "abc" {
+			t.Errorf("%s: X-Checksum trailer %q, want \"abc\"", tc.name, got)
+		}
+		if got := resp.Trailer.Get("X-Late"); got != "late" {
+			t.Errorf("%s: X-Late trailer %q, want \"late\"", tc.name, got)
+		}
+	}
+
+	rec := httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodGet, "/", nil)
+	req.Header.Set("If-None-Match", wantETag("body"))
+	ETag(handler(http.StatusOK, true)).ServeHTTP(rec, req)
+
+	res := rec.Result()
+	if res.StatusCode != http.StatusNotModified || rec.Body.Len() != 0 {
+		t.Errorf("got status %d body %q, want 304 empty", res.StatusCode, rec.Body.String())
+	}
+	if got := res.Header.Get("Trailer"); got != "" {
+		t.Errorf("304: Trailer header %q, want dropped", got)
+	}
+	if got := res.Header.Get("X-Checksum"); got != "early" {
+		t.Errorf("304: X-Checksum in header block %q, want \"early\" like any header", got)
+	}
+	if len(res.Trailer) != 0 {
+		t.Errorf("304: got trailers %v, want none", res.Trailer)
+	}
+}
