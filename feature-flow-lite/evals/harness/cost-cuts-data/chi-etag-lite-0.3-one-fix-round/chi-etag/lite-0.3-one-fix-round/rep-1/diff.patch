+func TestETagMatching(t *testing.T) {
+	tests := []struct {
+		name string
+		etag string
+		inm  []string
+		want int
+	}{
+		{"comma inside quotes", `"a,b"`, []string{`"a,b"`}, http.StatusNotModified},
+		{"weak request strong response", `"abc"`, []string{`W/"abc"`}, http.StatusNotModified},
+		{"strong request weak response", `W/"abc"`, []string{`"abc"`}, http.StatusNotModified},
+		{"case sensitive", `"abc"`, []string{`"ABC"`}, http.StatusOK},
+		{"list", `"abc"`, []string{`"x", "abc"`}, http.StatusNotModified},
+		{"list with whitespace", `"abc"`, []string{`  "x" ,  W/"abc" `}, http.StatusNotModified},
+		{"two header lines", `"abc"`, []string{`"x"`, `"abc"`}, http.StatusNotModified},
+		{"star", `"abc"`, []string{`*`}, http.StatusNotModified},
+		{"star first in list", `"abc"`, []string{`*, "x"`}, http.StatusNotModified},
+		{"star last in list", `"abc"`, []string{`"x", *`}, http.StatusNotModified},
+		{"star with junk", `"abc"`, []string{`*x`}, http.StatusOK},
+		{"unquoted member", `"abc"`, []string{`abc`}, http.StatusOK},
+		{"unterminated member", `"abc"`, []string{`"abc`}, http.StatusOK},
+		{"empty value", `"abc"`, []string{``}, http.StatusOK},
+		{"commas only", `"abc"`, []string{`,,,`}, http.StatusOK},
+		{"malformed handler etag", `abc`, []string{`abc`}, http.StatusOK},
+	}
+	for _, tc := range tests {
+		ts := newETagServer(t, func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("ETag", tc.etag)
+			io.WriteString(w, "payload")
+		})
+		resp, _ := etagRequest(t, ts, "GET", tc.inm...)
+		if resp.StatusCode != tc.want {
+			t.Errorf("%s: got status %d, want %d", tc.name, resp.StatusCode, tc.want)
+		}
+	}
+}
