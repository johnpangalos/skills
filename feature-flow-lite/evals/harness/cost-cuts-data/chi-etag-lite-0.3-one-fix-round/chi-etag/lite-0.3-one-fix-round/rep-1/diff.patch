+func TestETagPanicWritesNothing(t *testing.T) {
+	rec := httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodGet, "/", nil)
+	h := func(w http.ResponseWriter, r *http.Request) {
+		io.WriteString(w, "partial")
+		panic("boom")
+	}
+
+	defer func() {
+		if v := recover(); v != "boom" {
+			t.Fatalf("recovered %v, want \"boom\"", v)
+		}
+		if rec.Body.Len() != 0 || rec.Flushed || rec.Header().Get("ETag") != "" {
+			t.Errorf("middleware wrote to the client after a panic: body %q", rec.Body.String())
+		}
+	}()
+	ETag(http.HandlerFunc(h)).ServeHTTP(rec, req)
