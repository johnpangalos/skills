+class DurationInfoDict(ParamTypeInfoDict):
+    min: timedelta | None
+    max: timedelta | None
+
+
+_DURATION_RE = re.compile(
+    r"(?:(?P<d>\d+)d)?(?:(?P<h>\d+)h)?(?:(?P<m>\d+)m(?!s))?"
+    r"(?:(?P<s>\d+)s)?(?:(?P<ms>\d+)ms)?"
+)
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts strings like ``90s``, ``5m``,
+    ``1h30m`` or ``2d4h`` into :class:`~datetime.timedelta` objects.
+
+    A value is one or more ``<integer><unit>`` parts, largest unit first
+    and each unit at most once, using ``d``, ``h``, ``m``, ``s`` and
+    ``ms``. A bare integer is a number of seconds.
+
+    :param min: The smallest accepted duration, inclusive.
+    :param max: The largest accepted duration, inclusive.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "duration"
+
+    def __init__(
+        self, min: timedelta | None = None, max: timedelta | None = None
+    ) -> None:
+        self.min = min
+        self.max = max
+
+    def to_info_dict(self) -> DurationInfoDict:
+        return {"min": self.min, "max": self.max, **super().to_info_dict()}
+
+    def _parse(self, value: str) -> timedelta | None:
+        value = value.strip()
+
+        if value.isdigit():
+            return timedelta(seconds=int(value))
+
+        match = _DURATION_RE.fullmatch(value)
+
+        if not value or match is None:
+            return None
+
+        parts = {k: int(v) for k, v in match.groupdict().items() if v is not None}
+        return timedelta(
+            days=parts.get("d", 0),
+            hours=parts.get("h", 0),
+            minutes=parts.get("m", 0),
+            seconds=parts.get("s", 0),
+            milliseconds=parts.get("ms", 0),
+        )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            rv: timedelta | None = value
+        elif isinstance(value, int) and not isinstance(value, bool):
+            rv = timedelta(seconds=value)
+        else:
+            try:
+                rv = self._parse(str(value))
+            except (OverflowError, ValueError):
+                self.fail(
+                    _("{value!r} is too long a duration.").format(value=value),
+                    param,
+                    ctx,
+                )
+
+        if rv is None:
+            self.fail(
+                _(
+                    "{value!r} is not a valid duration. Use values like"
+                    " '90s', '5m' or '1h30m'."
+                ).format(value=value),
+                param,
+                ctx,
+            )
+
+        if rv < timedelta(0):
+            self.fail(
+                _("{value!r} is a negative duration.").format(value=value), param, ctx
+            )
+
+        if (self.min is not None and rv < self.min) or (
+            self.max is not None and rv > self.max
+        ):
+            self.fail(
+                _("{value} is not in the range {range}.").format(
+                    value=rv, range=self._describe_range()
+                ),
+                param,
+                ctx,
+            )
+
+        return rv
+
+    def _describe_range(self) -> str:
+        if self.min is None:
+            return f"x<={self.max}"
+
+        if self.max is None:
+            return f"x>={self.min}"
+
+        return f"{self.min}<=x<={self.max}"
+
+    def __repr__(self) -> str:
+        if self.min is None and self.max is None:
+            return "Duration"
+
+        return f"<Duration {self._describe_range()}>"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
