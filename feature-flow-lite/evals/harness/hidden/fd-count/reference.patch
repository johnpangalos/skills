+/// Counting results (--count)
+#[test]
+fn test_count() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+
+    te.assert_output(&["--count", "c.foo"], "2");
+    te.assert_output(&["--count", "--max-results=1", "c.foo"], "1");
+    te.assert_output(&["--count", "nothing-matches-this"], "0");
+    te.assert_failure(&["--count", "--exec=cat"]);
+    te.assert_failure(&["--count", "--quiet"]);
+}
