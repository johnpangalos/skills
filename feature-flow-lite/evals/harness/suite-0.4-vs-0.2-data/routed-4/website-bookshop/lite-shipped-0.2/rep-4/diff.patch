+<!doctype html>
+<html lang="en">
+  <head>
+    <meta charset="utf-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1" />
+    <title>Browse books by genre, Marginalia Books</title>
+    <link rel="icon" href="data:," />
+    <link rel="stylesheet" href="css/styles.css" />
+    <script>
+      document.documentElement.classList.add("js");
+    </script>
+    <script type="module" src="js/nav.js"></script>
+    <script type="module" src="js/books.js"></script>
+  </head>
+  <body>
+    <a class="skip-link" href="#main">Skip to content</a>
+    <header class="site-header">
+      <div class="header-inner">
+        <a class="brand" href="index.html">Marginalia Books</a>
+        <button
+          type="button"
+          class="nav-toggle"
+          aria-expanded="false"
+          aria-controls="site-nav"
+        >
+          Menu
+        </button>
+        <nav id="site-nav" class="site-nav" aria-label="Main">
+          <ul>
+            <li><a href="index.html">Home</a></li>
+            <li><a href="books.html" aria-current="page">Books</a></li>
+            <li><a href="events.html">Events</a></li>
+            <li><a href="visit.html">Visit</a></li>
+          </ul>
+        </nav>
+      </div>
+    </header>
+
+    <main id="main">
+      <h1>Books</h1>
+      <p class="lede">
+        Every title on our shelves, from the poetry table by the door to the
+        history shelves under the window. Choose a genre to narrow the list.
+      </p>
+
+      <section aria-labelledby="catalogue-heading">
+        <h2 class="visually-hidden" id="catalogue-heading">Catalogue</h2>
+        <p class="filters-label" id="filter-label">Filter by genre</p>
+        <div
+          class="filters"
+          id="genre-filters"
+          role="group"
+          aria-labelledby="filter-label"
+        ></div>
+
+        <div class="status" id="status" aria-live="polite">
+          <p class="result-count" id="result-count">Loading the catalogue.</p>
+          <p class="filter-notice" id="filter-notice"></p>
+        </div>
+
+        <ul class="book-grid" id="book-list"></ul>
+      </section>
+    </main>
+
+    <footer class="site-footer">
+      <div>
+        <p>
+          Marginalia Books is a fictional independent bookshop. This is a demo
+          site.
+        </p>
+        <p><a href="visit.html">Opening hours and address</a></p>
+      </div>
+    </footer>
+  </body>
+</html>
