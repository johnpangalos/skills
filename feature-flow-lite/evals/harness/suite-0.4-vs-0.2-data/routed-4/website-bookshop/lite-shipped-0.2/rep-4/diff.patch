+++ b/tests/pages.test.mjs
@@ -0,0 +1,363 @@
+// Site-wide checks: structure, shared navigation, responsive layout, menu toggle, and network/console hygiene.
+import { test, before, after } from "node:test";
+import assert from "node:assert/strict";
+import { startServer, launchBrowser, openTracked } from "./helpers.mjs";
+
+const PAGES = [
+  {
+    path: "index.html",
+    current: "Home",
+    title: /Marginalia Books, an independent bookshop/,
+  },
+  { path: "books.html", current: "Books", title: /Browse books by genre/ },
+  { path: "events.html", current: "Events", title: /Readings, book club/ },
+  {
+    path: "visit.html",
+    current: "Visit",
+    title: /Visit, contact and opening hours/,
+  },
+];
+
+let server;
+let browser;
+
+before(async () => {
+  server = await startServer();
+  browser = await launchBrowser();
+});
+
+after(async () => {
+  await browser?.close();
+  await server?.close();
+});
+
+test("every page has the shared nav with aria-current on its own link only", async () => {
+  for (const { path, current } of PAGES) {
+    const { context, page, problems } = await openTracked(
+      browser,
+      server.origin,
+      path,
+    );
+    const links = await page.$$eval("#site-nav a", (anchors) =>
+      anchors.map((a) => ({
+        text: a.textContent,
+        current: a.getAttribute("aria-current"),
+      })),
+    );
+    assert.deepEqual(
+      links.map((link) => link.text),
+      ["Home", "Books", "Events", "Visit"],
+      path,
+    );
+    const marked = links
+      .filter((link) => link.current === "page")
+      .map((link) => link.text);
+    assert.deepEqual(marked, [current], `${path} aria-current`);
+    assert.deepEqual(problems, [], path);
+    await context.close();
+  }
+});
+
+test("every page has lang, a unique descriptive title, viewport, one h1 and named landmarks", async () => {
+  const titles = new Set();
+  for (const { path, title } of PAGES) {
+    const { context, page } = await openTracked(browser, server.origin, path);
+    const facts = await page.evaluate(() => ({
+      lang: document.documentElement.lang,
+      title: document.title,
+      viewport: document.querySelector('meta[name="viewport"]')?.content ?? "",
+      h1Count: document.querySelectorAll("h1").length,
+      headers: document.querySelectorAll("body > header").length,
+      mains: document.querySelectorAll("main").length,
+      footers: document.querySelectorAll("body > footer").length,
+      navLabel: document.querySelector("nav")?.getAttribute("aria-label"),
+      skipFirst: document
+        .querySelector("a, button, input, select, textarea")
+        ?.textContent.trim(),
+    }));
+    assert.equal(facts.lang, "en", path);
+    assert.match(facts.title, title, path);
+    assert.ok(!titles.has(facts.title), `duplicate title on ${path}`);
+    titles.add(facts.title);
+    assert.match(facts.viewport, /width=device-width/, path);
+    assert.equal(facts.h1Count, 1, path);
+    assert.equal(facts.headers, 1, path);
+    assert.equal(facts.mains, 1, path);
+    assert.equal(facts.footers, 1, path);
+    assert.equal(facts.navLabel, "Main", path);
+    assert.equal(facts.skipFirst, "Skip to content", path);
+    await context.close();
+  }
+});
+
+test("skip link is the first focusable element and moves focus past the header", async () => {
+  const { context, page } = await openTracked(
+    browser,
+    server.origin,
+    "books.html",
+  );
