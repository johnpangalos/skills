+:root {
+  --paper: #fbf6ec;
+  --card: #fffdf8;
+  --ink: #2b2118;
+  --muted: #5e4d3e;
+  --rule: #d9c9ae;
+  --control-edge: #8a7258;
+  --accent: #8a3b12;
+  --accent-fill: #6d2d0c;
+  --on-accent: #fffdf8;
+  --focus: #1d4e89;
+  --error: #a4262c;
+  --serif:
+    Georgia, "Iowan Old Style", "Palatino Linotype", Palatino,
+    "Times New Roman", serif;
+  --sans:
+    system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial,
+    sans-serif;
+  color-scheme: light;
+}
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    --paper: #1d1812;
+    --card: #2a2219;
+    --ink: #f3e9d8;
+    --muted: #c9b99f;
+    --rule: #4a3c2c;
+    --control-edge: #9c8a72;
+    --accent: #f0a46b;
+    --accent-fill: #f0a46b;
+    --on-accent: #1d1812;
+    --focus: #8ec5ff;
+    --error: #ff8a80;
+    color-scheme: dark;
+  }
+}
+
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+
+body {
+  margin: 0;
+  background: var(--paper);
+  color: var(--ink);
+  font: 1.0625rem / 1.6 var(--sans);
+  overflow-wrap: break-word;
+}
+
+[hidden] {
+  display: none !important;
+}
+
+h1,
+h2,
+h3 {
+  font-family: var(--serif);
+  line-height: 1.2;
+  color: var(--ink);
+  overflow-wrap: break-word;
+}
+
+h1 {
+  font-size: clamp(2rem, 7vw, 3rem);
+  margin: 0.5rem 0 0.5rem;
+}
+
+h2 {
+  font-size: 1.6rem;
+  margin: 2.25rem 0 0.75rem;
+}
+
+h3 {
+  font-size: 1.2rem;
+  margin: 0 0 0.3rem;
+}
+
+p {
+  margin: 0 0 1rem;
+}
+
+a {
+  color: var(--accent);
+  text-underline-offset: 0.2em;
+  overflow-wrap: anywhere;
+}
+
+a:hover {
+  text-decoration-thickness: 2px;
+}
+
+:focus-visible {
+  outline: 3px solid var(--focus);
+  outline-offset: 2px;
+}
+
+.visually-hidden {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  overflow: hidden;
+  clip: rect(0 0 0 0);
+  white-space: nowrap;
+}
+
+.skip-link {
+  position: absolute;
+  left: 1rem;
+  top: -4rem;
+  z-index: 10;
+  padding: 0.75rem 1rem;
+  border-radius: 6px;
+  background: var(--accent-fill);
+  color: var(--on-accent);
+  font-weight: 700;
+  text-decoration: none;
+}
+
+.skip-link:focus {
+  top: 1rem;
+}
+
+/* Header and navigation */
+
+.site-header {
+  background: var(--card);
+  border-bottom: 1px solid var(--rule);
+}
+
+.header-inner {
+  max-width: 1100px;
+  margin: 0 auto;
+  padding: 0.5rem 1rem;
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0.5rem 1rem;
+}
+
+.brand {
+  display: inline-flex;
+  align-items: center;
+  min-height: 44px;
+  font-family: var(--serif);
+  font-size: 1.4rem;
+  font-weight: 700;
+  color: var(--ink);
+  text-decoration: none;
+}
+
+.nav-toggle {
+  display: none;
+  align-items: center;
+  min-height: 44px;
+  min-width: 44px;
+  padding: 0 1rem;
+  font: inherit;
+  font-weight: 700;
+  color: var(--ink);
+  background: transparent;
+  border: 2px solid var(--ink);
+  border-radius: 6px;
+  cursor: pointer;
+}
+
+.site-nav {
+  width: 100%;
+}
+
+.site-nav ul {
+  list-style: none;
+  margin: 0;
+  padding: 0.25rem 0 0.5rem;
+  display: flex;
+  flex-direction: column;
+}
+
+.site-nav a {
+  display: flex;
+  align-items: center;
+  min-height: 44px;
+  padding: 0 0.5rem;
+  color: var(--ink);
+  text-decoration: none;
+  border-bottom: 1px solid var(--rule);
+}
+
+.site-nav a:hover {
+  text-decoration: underline;
+}
+
+.site-nav a[aria-current="page"] {
+  color: var(--accent);
+  font-weight: 700;
+  box-shadow: inset 4px 0 0 var(--accent);
+}
+
+.js .nav-toggle {
+  display: inline-flex;
+}
+
+.js .site-nav {
+  display: none;
+}
+
+.js .site-nav.is-open {
+  display: block;
+}
+
+@media (min-width: 760px) {
+  .nav-toggle {
+    display: none !important;
+  }
+
+  .site-nav,
+  .js .site-nav {
+    display: block !important;
+    width: auto;
+  }
+
+  .site-nav ul {
+    flex-direction: row;
+    gap: 0.25rem;
+    padding: 0;
+  }
+
+  .site-nav a {
+    padding: 0 0.75rem;
+    border-bottom: 0;
+  }
+
+  .site-nav a[aria-current="page"] {
+    box-shadow: inset 0 -3px 0 var(--accent);
+  }
+}
+
+/* Layout */
+
+/* Grid and flex children may shrink below their longest word, so long tokens wrap. */
+.book-grid > *,
+.event-list > *,
+.split > * {
+  min-width: 0;
+}
+
+main {
+  max-width: 1100px;
+  margin: 0 auto;
+  padding: 0.5rem 1rem 3rem;
+}
+
+.lede {
+  max-width: 40rem;
+  font-size: 1.2rem;
+  color: var(--muted);
+}
+
+.button-link {
+  display: inline-flex;
+  align-items: center;
+  min-height: 44px;
+  padding: 0 1.25rem;
+  border-radius: 999px;
+  background: var(--accent-fill);
+  color: var(--on-accent);
+  font-weight: 700;
+  text-decoration: none;
+}
+
+.button-link:hover {
+  text-decoration: underline;
+}
+
+.hero {
+  padding: 1.5rem 0 1rem;
+  border-bottom: 1px solid var(--rule);
+}
+
+.hours-summary {
+  max-width: 40rem;
+}
+
+.site-footer {
+  background: var(--card);
+  border-top: 1px solid var(--rule);
+  color: var(--muted);
+}
+
+.site-footer div {
+  max-width: 1100px;
+  margin: 0 auto;
+  padding: 1.5rem 1rem;
+  text-align: center;
+}
+
+.site-footer p {
+  margin: 0 0 0.5rem;
+}
+
+/* Books */
+
+.filters-label {
+  margin: 1.25rem 0 0.25rem;
+  font-weight: 700;
+}
+
+.filters {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.5rem;
+}
+
+.filter-button {
+  min-height: 44px;
+  padding: 0 1rem;
+  font: inherit;
+  color: var(--ink);
+  background: var(--card);
+  border: 2px solid var(--control-edge);
+  border-radius: 999px;
+  cursor: pointer;
+  transition:
+    background-color 0.2s,
+    border-color 0.2s;
+}
+
+.filter-button:hover {
+  border-color: var(--accent);
+}
+
+.filter-button[aria-pressed="true"] {
+  background: var(--accent-fill);
+  border-color: var(--accent-fill);
+  color: var(--on-accent);
+  font-weight: 700;
+}
+
+.filter-button[aria-pressed="true"]::before {
+  content: "\2713\00a0";
+}
+
+.status {
+  margin-top: 1rem;
+}
+
+.result-count {
+  margin: 0;
+  font-weight: 700;
+}
+
+.filter-notice {
+  margin: 0.25rem 0 0;
+  color: var(--muted);
+}
+
+.book-grid {
+  list-style: none;
+  margin: 1.5rem 0 0;
+  padding: 0;
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
+  gap: 1.5rem;
+}
+
+.book {
+  display: flex;
+  flex-direction: column;
+  gap: 0.75rem;
+  height: 100%;
+  padding: 1rem;
+  background: var(--card);
+  border: 1px solid var(--rule);
+  border-radius: 10px;
+}
+
+.cover {
+  position: relative;
+  aspect-ratio: 3 / 4;
+  overflow: hidden;
+  border-radius: 4px 8px 8px 4px;
+  background: var(--cover-bg);
+  box-shadow:
+    inset 8px 0 0 rgba(0, 0, 0, 0.18),
+    0 6px 14px rgba(0, 0, 0, 0.18);
+}
+
+.cover svg {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+}
+
+.cover .art {
+  fill: var(--cover-accent);
+}
+
+.cover .art-soft {
+  fill: var(--cover-accent);
+  opacity: 0.35;
+}
+
+.book-info {
+  flex: 1;
+}
+
+.genre-tag {
+  display: inline-block;
+  margin: 0 0 0.4rem;
+  padding: 0 0.6rem;
+  font-size: 0.85rem;
+  font-weight: 600;
+  color: var(--muted);
+  border: 1px solid var(--rule);
+  border-radius: 999px;
+}
+
+.book-author {
+  margin: 0;
+  font-style: italic;
+  color: var(--muted);
+}
+
+.book-desc {
+  margin: 0.4rem 0 0;
+  font-size: 0.98rem;
+}
+
+.price {
+  margin: 0.5rem 0 0;
+  font-weight: 700;
+}
+
+.book-grid + p {
+  margin-top: 1.5rem;
+}
+
+/* Narrow screens: a small cover sits beside the text so several books fit on one screen.
+   The text is 11rem wide at least, so when enlarged text no longer fits it wraps under the cover. */
+@media (max-width: 559px) {
+  .book {
+    flex-direction: row;
+    flex-wrap: wrap;
+    align-items: flex-start;
+    gap: 0.5rem 1rem;
+  }
+
+  .book .cover {
+    flex: 0 0 96px;
+  }
+
+  .book .book-info {
+    flex: 1 1 11rem;
+    min-width: 0;
+  }
+
+  .book .price {
+    flex: 1 1 100%;
+    margin: 0;
+  }
+}
+
+/* Events */
+
+.event-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: grid;
+  gap: 1rem;
+}
+
+.event {
+  padding: 1rem 1.2rem;
+  background: var(--card);
+  border: 1px solid var(--rule);
+  border-left: 6px solid var(--accent);
+  border-radius: 8px;
+}
+
+.event p {
+  margin: 0;
+}
+
+.event-list + p,
+.empty-state + p {
+  margin-top: 1.5rem;
+}
+
+.event-meta {
+  margin: 0.25rem 0 0.5rem !important;
+  font-weight: 600;
+  color: var(--muted);
+}
+
+.past-events .event {
+  border-left-style: dashed;
+}
+
+.empty-state {
+  padding: 1rem 1.2rem;
+  background: var(--card);
+  border: 1px dashed var(--rule);
+  border-radius: 8px;
+}
+
+/* Visit */
+
+.split {
+  display: grid;
+  gap: 2rem;
+}
+
+@media (min-width: 760px) {
+  .split {
+    grid-template-columns: 1fr 1fr;
+    align-items: start;
+  }
+}
+
+address {
+  font-style: normal;
+  font-size: 1.1rem;
+  overflow-wrap: anywhere;
+}
+
+.hours-table {
+  width: 100%;
+  max-width: 30rem;
+  border-collapse: collapse;
+}
+
+.hours-table caption {
+  text-align: left;
+  font-weight: 700;
+  padding-bottom: 0.5rem;
+}
+
+.hours-table th,
+.hours-table td {
+  padding: 0.6rem 0.5rem;
+  overflow-wrap: anywhere;
+  text-align: left;
+  vertical-align: top;
+  border-bottom: 1px solid var(--rule);
+}
+
+.map {
+  display: block;
+  width: 100%;
+  max-width: 480px;
+  height: auto;
+  background: var(--card);
+  border: 1px solid var(--rule);
+  border-radius: 8px;
+}
+
+.map text {
+  fill: var(--muted);
+  font-family: var(--sans);
+  font-size: 13px;
+}
+
+.map .road {
+  stroke: var(--rule);
+  stroke-width: 14;
+  fill: none;
+}
+
+.map .shop {
+  fill: var(--accent);
+}
+
+.map .park {
+  fill: var(--rule);
+  opacity: 0.6;
+}
+
+/* Contact form */
+
+.form {
+  display: grid;
+  gap: 1rem;
+  max-width: 36rem;
+}
+
+.field {
+  display: grid;
+  gap: 0.35rem;
+}
+
+.field label {
+  font-weight: 700;
+}
+
+.field input,
+.field select,
+.field textarea {
+  width: 100%;
+  min-height: 44px;
+  padding: 0.6rem 0.75rem;
+  font: inherit;
+  color: var(--ink);
+  background: var(--card);
+  border: 2px solid var(--muted);
+  border-radius: 6px;
+}
+
+.field textarea {
+  min-height: 10rem;
+  resize: vertical;
+}
+
+.field [aria-invalid="true"] {
+  border-color: var(--error);
+}
+
+.field-error {
+  margin: 0;
+  font-weight: 700;
+  color: var(--error);
+}
+
+.field-error::before {
+  content: "Error: ";
+}
+
+.error-summary {
+  max-width: 36rem;
+  padding: 1rem 1.2rem;
+  background: var(--card);
+  border: 2px solid var(--error);
+  border-radius: 8px;
+}
+
+.error-summary ul {
+  margin: 0.5rem 0 0;
+  padding-left: 1.25rem;
+}
+
+.primary-button {
+  justify-self: start;
+  min-height: 44px;
+  padding: 0 1.25rem;
+  font: inherit;
+  font-weight: 700;
+  color: var(--on-accent);
+  background: var(--accent-fill);
+  border: 0;
+  border-radius: 999px;
+  cursor: pointer;
+}
+
+.confirmation {
+  max-width: 36rem;
+  padding: 1.25rem;
+  background: var(--card);
+  border-left: 6px solid var(--accent);
+  border-radius: 8px;
+}
+
+.confirmation h3 {
+  font-size: 1.4rem;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    transition-duration: 0.01ms !important;
+    animation-duration: 0.01ms !important;
+    scroll-behavior: auto !important;
+  }
+}
