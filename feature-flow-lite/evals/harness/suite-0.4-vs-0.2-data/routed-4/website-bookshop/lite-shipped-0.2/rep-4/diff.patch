+    "books.html",
+    { width: 360, height: 740 },
+  );
+  const cover = await page.locator("#book-list .cover").first().boundingBox();
+  assert.ok(cover.width <= 100, `cover is ${cover.width}px wide`);
+  assert.ok(cover.height <= 140, `cover is ${cover.height}px tall`);
+  assert.deepEqual(problems, []);
+  await context.close();
+});
+
+test("at 1280px book covers keep their full-size portrait layout", async () => {
+  const { context, page } = await openTracked(
+    browser,
+    server.origin,
+    "books.html",
+    { width: 1280 },
+  );
+  const cover = await page.locator("#book-list .cover").first().boundingBox();
+  assert.ok(cover.width >= 200, `cover is ${cover.width}px wide`);
+  assert.ok(cover.height > cover.width, "cover is portrait");
+  await context.close();
+});
+
+// A word counts as split when its rendered text spans more than one line box (more than one client rect).
+for (const [width, textPercent] of [
+  [320, 200],
+  [320, 100],
+  [360, 200],
+  [360, 100],
+]) {
+  test(`at ${width}px with ${textPercent}% text no book title or genre tag splits a word`, async () => {
+    const { context, page, problems } = await openTracked(
+      browser,
+      server.origin,
+      "books.html",
+      { width, height: 740 },
+    );
+    if (textPercent !== 100) {
+      await page.addStyleTag({
+        content: `html { font-size: ${textPercent}%; }`,
+      });
+    }
+    const split = await page.$$eval(
+      ".book h3, .book .genre-tag",
+      (elements) => {
+        const broken = [];
+        for (const element of elements) {
+          const walker = document.createTreeWalker(
+            element,
+            NodeFilter.SHOW_TEXT,
+          );
+          for (let node = walker.nextNode(); node; node = walker.nextNode()) {
+            for (const match of node.textContent.matchAll(/\S+/g)) {
+              const range = document.createRange();
+              range.setStart(node, match.index);
+              range.setEnd(node, match.index + match[0].length);
+              if (range.getClientRects().length !== 1) {
+                broken.push(match[0]);
+              }
+            }
+          }
+        }
+        return broken;
+      },
+    );
+    const overflow = await page.evaluate(() => ({
+      scrollWidth: document.documentElement.scrollWidth,
+      innerWidth: window.innerWidth,
+    }));
+    assert.deepEqual(split, []);
+    assert.ok(
+      overflow.scrollWidth <= overflow.innerWidth,
+      JSON.stringify(overflow),
+    );
+    assert.deepEqual(problems, []);
+    await context.close();
+  });
+}
+
+test("at 360px with 100% text the cover still sits beside the book text", async () => {
+  const { context, page } = await openTracked(
+    browser,
+    server.origin,
+    "books.html",
+    { width: 360, height: 740 },
+  );
+  const boxes = await page.evaluate(() => {
+    const card = document.querySelector("#book-list .book");
+    const rect = (selector) =>
+      card.querySelector(selector).getBoundingClientRect();
+    return { cover: rect(".cover"), info: rect(".book-info") };
+  });
+  assert.ok(boxes.info.left >= boxes.cover.right, JSON.stringify(boxes));
+  assert.ok(boxes.info.top < boxes.cover.bottom, JSON.stringify(boxes));
+  await context.close();
+});
