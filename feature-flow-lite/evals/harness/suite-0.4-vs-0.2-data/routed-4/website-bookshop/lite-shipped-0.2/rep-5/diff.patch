@@ -0,0 +1,191 @@
+const { test, before, after } = require('node:test');
+const assert = require('node:assert/strict');
+const { startServer } = require('./server');
+const { launchBrowser, withPage } = require('./browser');
+
+const NAME_ERROR = 'Please enter your name.';
+const EMAIL_EMPTY = 'Please enter your email address.';
+const EMAIL_FORMAT = 'Please enter an email address like name@example.com.';
+const MESSAGE_ERROR = 'Please enter a message.';
+
+let server;
+let browser;
+
+before(async () => {
+  server = await startServer();
+  browser = await launchBrowser();
+});
+
+after(async () => {
+  await browser.close();
+  await server.close();
+});
+
+function openVisit(viewport, run) {
+  return withPage(browser, `${server.base}/visit.html`, run, viewport);
+}
+
+async function fill(page, name, value) {
+  await page.fill(`#contact-${name}`, value);
+}
+
+async function errorText(page, name) {
+  return page.textContent(`#contact-${name}-error`);
+}
+
+async function submit(page) {
+  await page.click('#contact-form button[type="submit"]');
+}
+
+test('submitting empty fields shows a specific error for each required field and focuses the first', async () => {
+  await openVisit(undefined, async (page) => {
+    await submit(page);
+    assert.equal(await errorText(page, 'name'), NAME_ERROR);
+    assert.equal(await errorText(page, 'email'), EMAIL_EMPTY);
+    assert.equal(await errorText(page, 'message'), MESSAGE_ERROR);
+    assert.equal(await page.getAttribute('#contact-name', 'aria-invalid'), 'true');
+    assert.equal(await page.getAttribute('#contact-email', 'aria-invalid'), 'true');
+    assert.equal(await page.getAttribute('#contact-message', 'aria-invalid'), 'true');
+    assert.equal(await page.getAttribute('#contact-name', 'aria-describedby'), 'contact-name-error');
+    assert.equal(await page.getAttribute('#contact-email', 'aria-describedby'), 'contact-email-error');
+    assert.equal(await page.getAttribute('#contact-message', 'aria-describedby'), 'contact-message-error');
+    assert.equal(await page.evaluate(() => document.activeElement.id), 'contact-name');
+    assert.equal(await page.getAttribute('#contact-form', 'novalidate'), '');
+  });
+});
+
+test('malformed emails show the format error and focus the email field', async () => {
+  for (const bad of ['a@', 'foo', 'a b@c.d', 'a@b..c', 'a@b.c.', 'a@.b.c', 'a@b.c..d']) {
+    await openVisit(undefined, async (page) => {
+      await fill(page, 'name', 'Ada Lovelace');
+      await fill(page, 'email', bad);
+      await fill(page, 'message', 'Do you stock poetry?');
+      await submit(page);
+      assert.equal(await errorText(page, 'email'), EMAIL_FORMAT, `error for "${bad}"`);
+      assert.equal(await errorText(page, 'name'), '', 'name is valid');
+      assert.equal(await page.getAttribute('#contact-email', 'aria-invalid'), 'true');
+      assert.equal(await page.evaluate(() => document.activeElement.id), 'contact-email', `focus for "${bad}"`);
+    });
+  }
+});
+
+test('a whitespace-only message shows the message error', async () => {
+  await openVisit(undefined, async (page) => {
+    await fill(page, 'name', 'Ada Lovelace');
+    await fill(page, 'email', 'ada@example.com');
+    await fill(page, 'message', '   \n\t  ');
+    await submit(page);
+    assert.equal(await errorText(page, 'message'), MESSAGE_ERROR);
+    assert.equal(await page.evaluate(() => document.activeElement.id), 'contact-message');
+  });
+});
+
