@@ -0,0 +1,428 @@
+:root {
+  --paper: #fbf8f3;
+  --ink: #1f2328;
+  --muted: #55514a;
+  --accent: #1e5a8e;
+  --header: #2c3e50;
+  --line: #ddd5c7;
+  --error: #9b1c1c;
+  --focus: #b35400;
+  --focus-dark: #ffd166;
+}
+
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+
+body {
+  margin: 0;
+  background: var(--paper);
+  color: var(--ink);
+  font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
+  font-size: 1rem;
+  line-height: 1.6;
+  overflow-wrap: break-word;
+}
+
+a {
+  color: var(--accent);
+}
+
+:focus-visible {
+  outline: 3px solid var(--focus);
+  outline-offset: 2px;
+}
+
+main:focus {
+  outline: none;
+}
+
+.visually-hidden {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  overflow: hidden;
+  clip: rect(0 0 0 0);
+  white-space: nowrap;
+}
+
+.skip-link {
+  position: absolute;
+  left: 0.5rem;
+  top: -3rem;
+  z-index: 10;
+  padding: 0.5rem 1rem;
+  background: #ffffff;
+  color: var(--ink);
+  font-weight: 700;
+}
+
+.skip-link:focus {
+  top: 0.5rem;
+}
+
+.wrap {
+  max-width: 64rem;
+  margin: 0 auto;
+  padding: 0 1rem;
+}
+
+/* Header and nav */
+
+.site-header {
+  background: var(--header);
+  color: #ffffff;
+}
+
+.site-header .wrap {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0.5rem 1.5rem;
+  padding-top: 0.75rem;
+  padding-bottom: 0.75rem;
+}
+
+.site-header :focus-visible {
+  outline-color: var(--focus-dark);
+}
+
+.brand {
+  color: #ffffff;
+  font-size: 1.2rem;
+  font-weight: 700;
+  text-decoration: none;
+}
+
+.site-nav ul {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.25rem 0.5rem;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.site-nav a {
+  display: inline-block;
+  padding: 0.25rem 0.6rem;
+  border-radius: 4px;
+  color: #ffffff;
+  text-decoration: none;
+}
+
+.site-nav a:hover {
+  text-decoration: underline;
+}
+
+.site-nav a[aria-current="page"] {
+  background: #43607d;
+  font-weight: 700;
+  text-decoration: underline;
+}
+
+/* Page content */
+
+main {
+  padding: 1.5rem 0 3rem;
+}
+
+h1 {
+  margin: 0.5rem 0 1rem;
+  font-size: clamp(1.75rem, 4vw, 2.5rem);
+  line-height: 1.2;
+}
+
+h2 {
+  margin: 2.25rem 0 0.5rem;
+  font-size: 1.4rem;
+  line-height: 1.3;
+}
+
+h3 {
+  margin: 1.5rem 0 0.5rem;
+  font-size: 1.15rem;
+}
+
+p {
+  margin: 0.75rem 0;
+}
+
+.lead {
+  font-size: 1.15rem;
+}
+
+.muted {
+  color: var(--muted);
+}
+
+.button,
+button[type="submit"] {
+  display: inline-block;
+  padding: 0.6rem 1.1rem;
+  border: 0;
+  border-radius: 4px;
+  background: var(--accent);
+  color: #ffffff;
+  font: inherit;
+  font-weight: 700;
+  text-decoration: none;
+  cursor: pointer;
+  transition: background-color 0.2s ease;
+}
+
+.button:hover,
+button[type="submit"]:hover {
+  background: #174a73;
+}
+
+/* Home */
+
+.featured-list {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
+  gap: 1rem;
+  margin: 1rem 0;
+  padding: 0;
+  list-style: none;
+}
+
+.pick {
+  padding: 1rem;
+  border: 1px solid var(--line);
+  border-radius: 6px;
+  background: #ffffff;
+}
+
+.pick strong {
+  display: block;
+  font-size: 1.05rem;
+}
+
+/* Books */
+
+.filter-bar {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 0.5rem 1rem;
+  margin: 1.25rem 0 0.5rem;
+}
+
+.filter-bar label {
+  font-weight: 700;
+}
+
+select,
+input,
+textarea {
+  max-width: 100%;
+  padding: 0.5rem 0.6rem;
+  border: 1px solid #8a8377;
+  border-radius: 4px;
+  background: #ffffff;
+  color: var(--ink);
+  font: inherit;
+}
+
+select {
+  min-width: min(12rem, 100%);
+  max-width: 100%;
+}
+
+.result-count {
+  margin: 0;
+  color: var(--muted);
+}
+
+.empty-note {
+  padding: 1rem;
+  border: 1px dashed #8a8377;
+  border-radius: 6px;
+}
+
+.book-list {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
+  gap: 1rem;
+  margin: 1rem 0 0;
+  padding: 0;
+  list-style: none;
+}
+
+.book {
+  display: flex;
+  flex-direction: column;
+  padding: 1rem 1rem 1rem 1.25rem;
+  border: 1px solid var(--line);
+  border-left: 6px solid var(--accent);
+  border-radius: 6px;
+  background: #ffffff;
+}
+
+.book-title {
+  margin: 0 0 0.25rem;
+  font-size: 1.1rem;
+  line-height: 1.3;
+}
+
+.book-meta {
+  margin: 0;
+  color: var(--muted);
+  font-size: 0.95rem;
+}
+
+.book-blurb {
+  margin: 0.5rem 0;
+}
+
+.book-price {
+  margin: auto 0 0;
+  font-weight: 700;
+}
+
+/* Events */
+
+.event-list {
+  margin: 1rem 0 0;
+  padding: 0;
+  list-style: none;
+}
+
+.event {
+  padding: 1rem 0;
+  border-top: 1px solid var(--line);
+}
+
+.event h2 {
+  margin-top: 0.25rem;
+  font-size: 1.25rem;
+}
+
+.event-when {
+  color: var(--muted);
+  font-weight: 700;
+}
+
+/* Visit */
+
+/* Lets the table scroll on its own at very large text sizes instead of widening the page or splitting words. */
+.table-scroll {
+  max-width: 100%;
+  overflow-x: auto;
+}
+
+.hours-table {
+  width: 100%;
+  max-width: 28rem;
+  border-collapse: collapse;
+}
+
+.hours-table th,
+.hours-table td {
+  padding: 0.5rem 10px;
+  border-bottom: 1px solid var(--line);
+  text-align: left;
+}
+
+address {
+  margin: 0.75rem 0;
+  font-style: normal;
+}
+
+.info-list dt {
+  margin-top: 0.75rem;
+  font-weight: 700;
+}
+
+.info-list dd {
+  margin: 0.15rem 0 0;
+}
+
+.contact-form {
+  max-width: 36rem;
+}
+
+.field {
+  margin-bottom: 1rem;
+}
+
+.field label {
+  display: block;
+  margin-bottom: 0.25rem;
+  font-weight: 700;
+}
+
+.field input,
+.field textarea {
+  display: block;
+  width: 100%;
+}
+
+.field textarea {
+  resize: vertical;
+}
+
+input[aria-invalid="true"],
+textarea[aria-invalid="true"] {
+  border: 2px solid var(--error);
+}
+
+.field-error {
+  margin: 0.3rem 0 0;
+  color: var(--error);
+  font-weight: 700;
+}
+
+.field-error:empty {
+  margin: 0;
+}
+
+.form-status {
+  max-width: 36rem;
+  margin-top: 1rem;
+  padding: 1rem;
+  border-left: 6px solid var(--accent);
+  background: #ffffff;
+}
+
+/* Empty status stays rendered so the live region is in the accessibility tree; only its box goes. */
+.form-status:empty {
+  margin-top: 0;
+  padding: 0;
+  border-left-width: 0;
+  background: none;
+}
+
+/* Footer */
+
+.site-footer {
+  padding: 1.5rem 0;
+  border-top: 1px solid var(--line);
+  font-size: 0.95rem;
+}
+
+.site-footer p {
+  margin: 0.25rem 0;
+}
+
+/* Wider screens */
+
+@media (min-width: 768px) {
+  .site-header .wrap {
+    flex-wrap: nowrap;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    transition-duration: 0.01ms !important;
+    animation-duration: 0.01ms !important;
+    scroll-behavior: auto !important;
+  }
+}
