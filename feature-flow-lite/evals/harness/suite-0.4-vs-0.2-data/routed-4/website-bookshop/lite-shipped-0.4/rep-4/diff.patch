@@ -0,0 +1,444 @@
+:root {
+  --bg: #fbf8f2;
+  --paper: #efe6d6;
+  --ink: #1f1b16;
+  --muted: #5b5349;
+  --accent: #7a2e1d;
+  --accent-dark: #5c2214;
+  --focus: #1f4e79;
+  --error: #9b1c1c;
+  --line: #d6cab6;
+  --sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
+  --serif: Georgia, "Iowan Old Style", "Palatino Linotype", "Times New Roman", serif;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+body {
+  margin: 0;
+  background: var(--bg);
+  color: var(--ink);
+  font-family: var(--sans);
+  font-size: 1rem;
+  line-height: 1.6;
+}
+
+h1,
+h2,
+h3 {
+  font-family: var(--serif);
+  line-height: 1.25;
+  margin: 0 0 0.75rem;
+}
+
+h1 {
+  font-size: 2rem;
+}
+
+h2 {
+  font-size: 1.5rem;
+  margin-top: 1.5rem;
+}
+
+h3 {
+  font-size: 1.2rem;
+}
+
+p {
+  margin: 0 0 1rem;
+}
+
+a {
+  color: var(--accent);
+  text-decoration: underline;
+  text-underline-offset: 0.2em;
+}
+
+a:hover {
+  text-decoration-thickness: 2px;
+}
+
+.wrap {
+  max-width: 1040px;
+  margin: 0 auto;
+  padding: 0 1rem;
+}
+
+.main {
+  padding-top: 2rem;
+  padding-bottom: 3rem;
+  outline: none;
+}
+
+.sr-only {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  overflow: hidden;
+  clip: rect(0 0 0 0);
+  white-space: nowrap;
+}
+
+.skip-link {
+  position: absolute;
+  left: 1rem;
+  top: -4rem;
+  z-index: 10;
+  padding: 0.5rem 1rem;
+  background: var(--ink);
+  color: #fff;
+}
+
+.skip-link:focus {
+  top: 1rem;
+}
+
+:focus-visible {
+  outline: 3px solid var(--focus);
+  outline-offset: 2px;
+}
+
+/* Header and navigation */
+
+.site-header {
+  background: var(--paper);
+  border-bottom: 1px solid var(--line);
+}
+
+.header-inner {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0.5rem 1rem;
+  padding-top: 0.75rem;
+  padding-bottom: 0.75rem;
+}
+
+.brand {
+  font-family: var(--serif);
+  font-size: 1.25rem;
+  font-weight: bold;
+  color: var(--ink);
+}
+
+.nav-toggle {
+  font: inherit;
+  padding: 0.4rem 0.9rem;
+  background: var(--ink);
+  color: #fff;
+  border: 0;
+  border-radius: 4px;
+  cursor: pointer;
+}
+
+.site-nav {
+  display: none;
+  width: 100%;
+}
+
+.site-header.is-open .site-nav {
+  display: block;
+}
+
+.site-nav ul {
+  list-style: none;
+  margin: 0;
+  padding: 0.5rem 0 0;
+  display: grid;
+  gap: 0.25rem;
+}
+
+.site-nav a {
+  display: block;
+  padding: 0.5rem 0;
+}
+
+.site-nav a[aria-current="page"] {
+  font-weight: bold;
+  text-decoration: none;
+}
+
+/* Buttons and form controls */
+
+.button {
+  display: inline-block;
+  padding: 0.6rem 1.1rem;
+  background: var(--accent);
+  color: #fff;
+  border-radius: 4px;
+  border: 0;
+  font: inherit;
+  text-decoration: none;
+  cursor: pointer;
+  transition: background-color 0.15s ease;
+}
+
+.button:hover {
+  background: var(--accent-dark);
+  text-decoration: none;
+}
+
+select,
+input,
+textarea {
+  font: inherit;
+  max-width: 100%;
+  padding: 0.5rem 0.6rem;
+  border: 1px solid #8a7f70;
+  border-radius: 4px;
+  background: #fff;
+  color: var(--ink);
+}
+
+select {
+  cursor: pointer;
+}
+
+/* Home */
+
+.lead {
+  font-size: 1.2rem;
+  color: var(--muted);
+}
+
+.teasers {
+  display: grid;
+  gap: 1rem;
+}
+
+.teaser {
+  background: #fff;
+  border: 1px solid var(--line);
+  border-radius: 6px;
+  padding: 1.25rem;
+}
+
+.teaser p:last-child {
+  margin-bottom: 0;
+}
+
+@media (min-width: 640px) {
+  .teasers {
+    grid-template-columns: repeat(3, 1fr);
+  }
+}
+
+/* Books */
+
+.filter {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 0.5rem 1rem;
+  margin-bottom: 0.5rem;
+}
+
+.result-count {
+  color: var(--muted);
+  margin-bottom: 1.5rem;
+}
+
+.book-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: grid;
+  gap: 1rem;
+  grid-template-columns: 1fr;
+}
+
+.book {
+  background: #fff;
+  border: 1px solid var(--line);
+  border-radius: 6px;
+  padding: 1rem;
+}
+
+.book h2 {
+  font-size: 1.2rem;
+  margin: 0.5rem 0 0.25rem;
+}
+
+.author,
+.price {
+  color: var(--muted);
+  margin: 0 0 0.25rem;
+}
+
+.badge {
+  display: inline-block;
+  padding: 0.1rem 0.6rem;
+  border-radius: 999px;
+  background: var(--paper);
+  color: var(--ink);
+  font-size: 0.875rem;
+}
+
+@media (min-width: 640px) {
+  .book-list {
+    grid-template-columns: repeat(2, 1fr);
+  }
+}
+
+@media (min-width: 960px) {
+  .book-list {
+    grid-template-columns: repeat(3, 1fr);
+  }
+}
+
+/* Events */
+
+.event-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: grid;
+  gap: 1.5rem;
+}
+
+.event {
+  border-top: 2px solid var(--accent);
+  padding-top: 0.75rem;
+}
+
+.event-when,
+.event-time {
+  color: var(--muted);
+  font-weight: bold;
+  margin-bottom: 0.25rem;
+}
+
+.event h2 {
+  margin-top: 0.25rem;
+  font-size: 1.3rem;
+}
+
+/* Visit */
+
+table {
+  width: 100%;
+  border-collapse: collapse;
+  margin-bottom: 1rem;
+}
+
+caption {
+  text-align: left;
+  font-weight: bold;
+  padding-bottom: 0.25rem;
+}
+
+th,
+td {
+  text-align: left;
+  vertical-align: top;
+  padding: 0.5rem 0.25rem;
+  border-bottom: 1px solid var(--line);
+}
+
+address {
+  font-style: normal;
+  margin-bottom: 1rem;
+}
+
+.note {
+  color: var(--muted);
+}
+
+.visit-grid {
+  display: grid;
+  gap: 2rem;
+}
+
+.contact-form {
+  margin-bottom: 1.5rem;
+}
+
+.form-field {
+  margin-bottom: 1.25rem;
+}
+
+.form-field label {
+  display: block;
+  font-weight: bold;
+  margin-bottom: 0.25rem;
+}
+
+.form-field input,
+.form-field textarea {
+  display: block;
+  width: 100%;
+}
+
+.form-field textarea {
+  min-height: 8rem;
+  resize: vertical;
+  overflow-wrap: anywhere;
+}
+
+.field-error {
+  margin: 0.25rem 0 0;
+  color: var(--error);
+  font-weight: bold;
+}
+
+[aria-invalid="true"] {
+  border: 2px solid var(--error);
+}
+
+.demo-note {
+  padding: 0.75rem 1rem;
+  background: #fff;
+  border-left: 4px solid var(--accent);
+}
+
+@media (min-width: 720px) {
+  .nav-toggle {
+    display: none;
+  }
+
+  .site-nav {
+    display: block;
+    width: auto;
+  }
+
+  .site-nav ul {
+    display: flex;
+    gap: 1.5rem;
+    padding: 0;
+  }
+
+  .site-nav a {
+    padding: 0;
+  }
+}
+
+@media (min-width: 760px) {
+  .visit-grid {
+    grid-template-columns: 1fr 1.2fr;
+  }
+}
+
+/* Footer */
+
+.site-footer {
+  background: var(--ink);
+  color: #f3ede2;
+  padding: 1.5rem 0;
+}
+
+.site-footer p {
+  margin: 0;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    transition: none !important;
+    animation: none !important;
+    scroll-behavior: auto !important;
+  }
+}
