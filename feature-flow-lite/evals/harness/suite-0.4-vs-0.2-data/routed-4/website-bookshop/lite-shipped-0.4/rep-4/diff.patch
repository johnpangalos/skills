+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Marginalia Books: an independent bookshop</title>
+  <link rel="icon" href="data:,">
+  <link rel="stylesheet" href="css/styles.css">
+</head>
+<body>
+  <a class="skip-link" href="#main">Skip to main content</a>
+
+  <header class="site-header">
+    <div class="wrap header-inner">
+      <a class="brand" href="index.html">Marginalia Books</a>
+      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
+      <nav id="site-nav" class="site-nav" aria-label="Main">
+        <ul>
+          <li><a href="index.html" aria-current="page">Home</a></li>
+          <li><a href="books.html">Books</a></li>
+          <li><a href="events.html">Events</a></li>
+          <li><a href="visit.html">Visit</a></li>
+        </ul>
+      </nav>
+    </div>
+  </header>
+
+  <main id="main" class="wrap main" tabindex="-1">
+    <section>
+      <h1>A small bookshop for slow reading</h1>
+      <p class="lead">Marginalia Books is an independent bookshop on Paper Lane in Little Haddon. We have sold books here since 2009, and we still read most of what we stock before it goes on the shelf.</p>
+      <p>The name comes from the notes people leave in the margins of the books they love. We would like the shop to feel like that: a place where you can linger, argue a little, and leave with something you did not know you were looking for.</p>
+    </section>
+
+    <section aria-labelledby="teasers-heading">
+      <h2 id="teasers-heading">Start here</h2>
+      <div class="teasers">
+        <section class="teaser" aria-labelledby="teaser-books">
+          <h3 id="teaser-books">Books</h3>
+          <p>Fiction, poetry, nature and science, and picture books for children. Every title on the catalog has a short note from a member of staff.</p>
+          <p><a href="books.html">Browse the catalog</a></p>
+        </section>
+        <section class="teaser" aria-labelledby="teaser-events">
+          <h3 id="teaser-events">Events</h3>
+          <p>Reading groups, a poetry evening, a nature walk on the fen, and our winter story morning for families.</p>
+          <p><a href="events.html">See what is coming up</a></p>
+        </section>
+        <section class="teaser" aria-labelledby="teaser-visit">
+          <h3 id="teaser-visit">Visit</h3>
+          <p>We are open seven days a week. The shop is a short walk from the bus stop on Mill Road, and we are happy to order anything in print.</p>
+          <p><a href="visit.html">Opening hours and contact</a></p>
+        </section>
+      </div>
+    </section>
+  </main>
+
+  <footer class="site-footer">
+    <div class="wrap">
+      <p>Marginalia Books, 21 Paper Lane, Little Haddon. Independent since 2009.</p>
+    </div>
+  </footer>
+
+  <script defer src="js/nav.js"></script>
+</body>
+</html>
