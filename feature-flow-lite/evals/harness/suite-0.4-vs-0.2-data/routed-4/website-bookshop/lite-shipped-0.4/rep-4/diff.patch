+  const columns = (page) => page.locator('#book-list').evaluate((el) => getComputedStyle(el).gridTemplateColumns.split(' ').length);
+  assert.equal(await columns(desktop.page), 3);
+  assert.equal(await desktop.page.locator('.nav-toggle').isVisible(), false);
+  const phone = await openPage('books.html', 360);
+  assert.equal(await columns(phone.page), 1);
+  assert.equal(await phone.page.locator('.nav-toggle').isVisible(), true);
+});
+
+test('text contrast is at least 4.5:1 on every page', async () => {
+  for (const path of PAGES) {
+    const { page } = await openPage(path);
+    const low = await page.evaluate(() => {
+      const parse = (css) => css.match(/[\d.]+/g).slice(0, 3).map(Number);
+      const luminance = ([r, g, b]) => {
+        const lin = (c) => {
+          const v = c / 255;
+          return v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4;
+        };
+        return 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b);
+      };
+      const backgroundOf = (el) => {
+        for (let node = el; node; node = node.parentElement) {
+          const css = getComputedStyle(node).backgroundColor;
+          if (css !== 'transparent' && !css.startsWith('rgba(0, 0, 0, 0)')) return parse(css);
+        }
+        return [255, 255, 255];
+      };
+      const failures = [];
+      for (const el of document.querySelectorAll('body *')) {
+        const hasText = [...el.childNodes].some((node) => node.nodeType === Node.TEXT_NODE && node.textContent.trim());
+        if (!hasText) continue;
+        const a = luminance(parse(getComputedStyle(el).color));
+        const b = luminance(backgroundOf(el));
+        const ratio = (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05);
+        if (ratio < 4.5) failures.push(`${el.tagName} "${el.textContent.trim().slice(0, 30)}" ${ratio.toFixed(2)}`);
+      }
+      return failures;
+    });
+    assert.deepEqual(low, [], path);
+  }
+});
+
+test('prefers-reduced-motion removes transitions', async () => {
+  const { page } = await openPage('visit.html');
+  await page.emulateMedia({ reducedMotion: 'reduce' });
+  const durations = await page.locator('.button').evaluateAll((els) => els.map((el) => getComputedStyle(el).transitionDuration));
+  assert.ok(durations.length > 0, 'visit.html has a .button with a transition');
+  assert.deepEqual(durations, durations.map(() => '0s'));
+});
+
+test('books.html loads straight from disk over file:// and renders the catalog', async () => {
+  const context = await browser.newContext();
+  contexts.push(context);
+  const page = await context.newPage();
+  const errors = [];
+  page.on('console', (msg) => { if (msg.type() === 'error') errors.push(msg.text()); });
+  page.on('pageerror', (err) => errors.push(err.message));
+  await page.goto(pathToFileURL(join(root, 'books.html')).href, { waitUntil: 'load' });
+  const total = (await readCards(page)).length;
+  assert.ok(total >= 8, `titles over file://: ${total}`);
+  await page.selectOption('#genre', 'Poetry');
+  assert.ok((await readCards(page)).every((card) => card.genre === 'Poetry'));
+  assert.deepEqual(errors, []);
+});
+
+test('non-link cards and badges do not look clickable', async () => {
+  const cases = [
+    ['books.html', '.book, .badge'],
+    ['events.html', '.event'],
+    ['index.html', '.teaser'],
+  ];
+  for (const [path, selector] of cases) {
+    const { page } = await openPage(path);
+    const cursors = await page.locator(selector).evaluateAll((els) => els.map((el) => getComputedStyle(el).cursor));
+    assert.ok(cursors.length > 0, `${path} has ${selector}`);
+    assert.ok(cursors.every((cursor) => cursor !== 'pointer'), `${path} ${selector} cursor`);
+  }
+});
+
+async function main() {
+  const chromium = await loadChromium();
+  const executablePath = existsSync(CHROME) ? CHROME : undefined;
+  browser = await chromium.launch({ executablePath, args: ['--no-sandbox'] });
+  const server = await startServer();
+  base = `http://127.0.0.1:${server.address().port}`;
+
+  let failures = 0;
+  for (const { name, fn } of tests) {
+    try {
+      await fn();
+      console.log(`ok    ${name}`);
+    } catch (err) {
+      failures += 1;
+      console.log(`FAIL  ${name}\n      ${err.message.split('\n')[0]}`);
+    }
+  }
+
+  for (const context of contexts) await context.close();
+  await browser.close();
+  server.close();
+  console.log(`\n${tests.length - failures} of ${tests.length} passed`);
+  process.exit(failures ? 1 : 0);
+}
+
+main().catch((err) => {
+  console.error(err);
+  process.exit(1);
+});
