+// Serves the site with a tiny static server and drives headless Chrome through Playwright.
+// Run from the repo root with: node tests/run.mjs
+import { createServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { existsSync } from 'node:fs';
+import { createRequire } from 'node:module';
+import { execSync } from 'node:child_process';
+import { dirname, extname, join, normalize } from 'node:path';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+import assert from 'node:assert/strict';
+
+const root = join(dirname(fileURLToPath(import.meta.url)), '..');
+const CHROME = '/usr/bin/google-chrome';
+const PAGES = ['index.html', 'books.html', 'events.html', 'visit.html'];
+const TYPES = {
+  '.html': 'text/html; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.js': 'text/javascript; charset=utf-8',
+};
+const VALID = { name: 'Jo Reader', email: 'jo@example.com', message: 'Do you stock poetry chapbooks?' };
+const DEMO_MESSAGE = 'This is a demo. No message was sent. To reach us for real, email hello@marginalia.example.';
+
+const tests = [];
+const test = (name, fn) => tests.push({ name, fn });
+const contexts = [];
+let browser;
+let base = '';
+
+async function loadChromium() {
+  try {
+    return (await import('playwright')).chromium;
+  } catch {
+    // ESM imports do not see the global node_modules, so fall back to the global install.
+    const require = createRequire(import.meta.url);
+    const globalRoot = execSync('npm root -g').toString().trim();
+    return require(join(globalRoot, 'playwright')).chromium;
+  }
+}
+
+function startServer() {
+  const server = createServer(async (req, res) => {
+    const pathname = decodeURIComponent(new URL(req.url, 'http://localhost').pathname);
+    const file = normalize(join(root, pathname === '/' ? 'index.html' : pathname));
+    try {
+      if (!file.startsWith(root)) throw new Error('outside root');
+      const body = await readFile(file);
+      res.writeHead(200, { 'Content-Type': TYPES[extname(file)] || 'application/octet-stream' });
+      res.end(body);
+    } catch {
+      res.writeHead(404, { 'Content-Type': 'text/plain' });
+      res.end('not found');
+    }
+  });
+  return new Promise((resolve) => {
+    server.listen(0, '127.0.0.1', () => resolve(server));
+  });
+}
+
+async function openPage(path, width = 1280) {
+  const context = await browser.newContext({ viewport: { width, height: 800 } });
+  contexts.push(context);
+  const page = await context.newPage();
+  const errors = [];
+  const requests = [];
+  page.on('console', (msg) => { if (msg.type() === 'error') errors.push(msg.text()); });
+  page.on('pageerror', (err) => errors.push(err.message));
+  page.on('dialog', (dialog) => { errors.push(`dialog: ${dialog.message()}`); dialog.dismiss(); });
+  page.on('request', (req) => requests.push(req.url()));
+  await page.goto(`${base}/${path}`, { waitUntil: 'load' });
+  return { page, errors, requests };
+}
+
+const scrollWidth = (page) => page.evaluate(() => document.scrollingElement.scrollWidth);
+
+const readCards = (page) => page.locator('#book-list > li').evaluateAll((items) => items.map((li) => ({
+  genre: li.querySelector('.badge')?.textContent,
+  title: li.querySelector('h2')?.textContent,
+})));
+
+async function submitWith(page, overrides = {}) {
+  const values = { ...VALID, ...overrides };
+  for (const [id, value] of Object.entries(values)) {
+    await page.fill(`#${id}`, value);
+  }
+  await page.click('button[type="submit"]');
+}
+
+test('every page loads without console errors or cross-origin requests', async () => {
+  for (const path of PAGES) {
+    const { page, errors, requests } = await openPage(path);
+    await page.waitForLoadState('networkidle');
+    assert.deepEqual(errors, [], `${path} console errors`);
+    const origin = new URL(base).origin;
+    const foreign = requests.filter((url) => new URL(url).origin !== origin);
+    assert.deepEqual(foreign, [], `${path} cross-origin requests`);
+  }
+});
