+  await submitWith(page);
+  await page.click('button[type="submit"]');
+  await page.waitForTimeout(300);
+  const status = page.locator('[role="status"]');
+  assert.equal(await status.count(), 1);
+  assert.equal(await status.textContent(), DEMO_MESSAGE);
+  assert.equal(requests.length, before, 'no network request on submit');
+});
+
+test('visit: a very long message is accepted without horizontal overflow at 360px', async () => {
+  const { page } = await openPage('visit.html', 360);
+  await submitWith(page, { message: `${'x'.repeat(5000)} ${'Long message. '.repeat(400)}` });
+  assert.equal(await page.isVisible('#form-status'), true);
+  assert.ok(await scrollWidth(page) <= 360, `scrollWidth ${await scrollWidth(page)}`);
+});
+
+test('every page has no horizontal scrolling at 360px, including with the menu open', async () => {
+  for (const path of PAGES) {
+    const { page } = await openPage(path, 360);
+    assert.ok(await scrollWidth(page) <= 360, `${path}: ${await scrollWidth(page)}`);
+  }
+  const { page } = await openPage('index.html', 360);
+  await page.locator('.nav-toggle').click();
+  assert.ok(await scrollWidth(page) <= 360, 'index with menu open');
+});
+
+test('layouts adapt between 360px and desktop widths', async () => {
