+    assert.ok(['2026', '2027'].includes(event.datetime.slice(0, 4)), `year for ${event.title}`);
+    const weekday = date.toLocaleDateString('en-GB', { weekday: 'long', timeZone: 'UTC' });
+    assert.ok(event.label.includes(weekday), `weekday ${weekday} in "${event.label}"`);
+    assert.match(event.time, /\d{2}:\d{2} to \d{2}:\d{2}/, `time for ${event.title}`);
+    assert.ok(event.title && event.description, `title and description for ${event.datetime}`);
+  }
+});
+
+test('visit form flags empty required fields and moves focus to the first', async ({ open }) => {
+  const page = await open('visit.html');
+  await page.getByRole('button', { name: 'Send message' }).click();
+  const expected = {
+    name: 'Enter your name.',
+    email: 'Enter your email address.',
+    message: 'Enter a message.'
+  };
+  for (const [id, message] of Object.entries(expected)) {
+    assert.equal(await page.locator(`#${id}`).getAttribute('aria-invalid'), 'true', `aria-invalid on ${id}`);
+    assert.equal(await page.locator(`#${id}`).getAttribute('aria-describedby'), `${id}-error`, `describedby on ${id}`);
+    assert.equal(await page.locator(`#${id}-error`).textContent(), message, `error text for ${id}`);
+    assert.equal(await page.locator(`#${id}-error`).isVisible(), true, `error visible for ${id}`);
+  }
+  assert.equal(await page.evaluate(() => document.activeElement.id), 'name');
+  assert.equal(await page.locator('#form-status').textContent(), '');
+});
+
+test('visit form rejects malformed email addresses', async ({ open }) => {
+  const page = await open('visit.html');
+  await page.fill('#name', 'Ann Reader');
+  await page.fill('#message', 'Do you stock poetry chapbooks?');
+  for (const bad of ['not-an-email', 'a@b']) {
+    await page.fill('#email', bad);
+    await page.getByRole('button', { name: 'Send message' }).click();
+    assert.equal(
+      await page.locator('#email-error').textContent(),
+      'Enter an email address like name@example.com.',
+      `email error for ${bad}`
+    );
+    assert.equal(await page.locator('#email').getAttribute('aria-invalid'), 'true');
+    assert.equal(await page.evaluate(() => document.activeElement.id), 'email', `focus for ${bad}`);
+    assert.equal(await page.locator('#name-error').isHidden(), true, 'valid name has no error');
+  }
+  await page.fill('#email', 'a@b.co');
+  await page.getByRole('button', { name: 'Send message' }).click();
+  assert.equal(await page.locator('#email').getAttribute('aria-invalid'), 'false');
+  assert.match(await page.locator('#form-status').textContent(), /demo/);
+});
+
+test('visit form treats whitespace-only name and message as empty', async ({ open }) => {
+  const page = await open('visit.html');
+  await page.fill('#name', '     ');
+  await page.fill('#email', 'ann@example.com');
+  await page.fill('#message', '\n   \t  \n');
