+  assert.equal(await page.locator('#name-error').textContent(), 'Enter your name.');
+  assert.equal(await page.locator('#message-error').textContent(), 'Enter a message.');
+  assert.equal(await page.locator('#email-error').isHidden(), true);
+  assert.equal(await page.evaluate(() => document.activeElement.id), 'name');
+  assert.equal(await page.locator('#form-status').textContent(), '');
+});
+
+test('visit form double submit stays consistent and sends nothing', async ({ open, session }) => {
+  const page = await open('visit.html');
+  await page.fill('#name', 'Ann Reader');
+  await page.fill('#email', 'ann@example.com');
+  await page.fill('#message', 'Hello');
+  session.requests.length = 0;
+  await page.getByRole('button', { name: 'Send message' }).click();
+  await page.getByRole('button', { name: 'Send message' }).click();
+  assert.match(await page.locator('#form-status').textContent(), /nothing was sent/);
+  assert.equal(await page.locator('.field-error:not([hidden])').count(), 0);
+  assert.equal(await page.locator('[aria-invalid="true"]').count(), 0);
+  assert.deepEqual(session.requests, [], 'no requests after double submit');
+});
+
+test('visit valid submit says it is a demo and makes no network request', async ({ open, session }) => {
+  const page = await open('visit.html');
+  await page.fill('#name', 'Ann Reader');
+  await page.fill('#email', 'ann@example.com');
+  await page.fill('#message', 'Do you hold a signed first edition of The Glass Orchard?');
+  session.requests.length = 0;
+  await page.getByRole('button', { name: 'Send message' }).click();
+  const status = page.locator('#form-status');
+  await status.filter({ hasText: /demo/ }).waitFor();
+  assert.equal(await status.getAttribute('role'), 'status');
+  assert.match(await status.textContent(), /This is a demo form and nothing was sent/);
+  assert.equal(page.url().endsWith('visit.html'), true, 'page did not navigate');
+  assert.deepEqual(session.requests, [], 'no requests after submit');
+});
+
+test('visit very long message does not widen the page at 360px', async ({ open }) => {
+  const page = await open('visit.html', 360);
+  await page.fill('#name', 'Ann Reader');
+  await page.fill('#email', 'ann@example.com');
+  await page.fill('#message', 'x'.repeat(5000) + ' ' + 'word '.repeat(400));
+  await page.getByRole('button', { name: 'Send message' }).click();
+  await page.locator('#form-status').filter({ hasText: /demo/ }).waitFor();
+  const scrollWidth = await page.evaluate(() => document.documentElement.scrollWidth);
+  assert.ok(scrollWidth <= 360, `scrollWidth ${scrollWidth}`);
+});
+
+// Console errors, page errors and non-local requests fail every test through the session; this one walks all pages.
+test('every page loads with no console errors and only local requests', async ({ open, session }) => {
+  for (const path of PAGES) {
+    const page = await open(path);
+    await page.waitForLoadState('load');
+  }
+  assert.ok(session.requests.length >= PAGES.length, 'pages were requested from the local server');
+  assert.ok(session.requests.every((r) => r.url.startsWith('http://127.0.0.1:')), 'all requests are local');
+});
+
+async function run() {
+  const filter = process.argv[2] || '';
+  const selected = tests.filter((t) => t.name.includes(filter));
+  if (selected.length === 0) {
+    console.error(`No tests match "${filter}"`);
+    process.exit(1);
+  }
+
+  const executablePath = existsSync(chromium.executablePath()) ? undefined : CHROME_FALLBACK;
+  const browser = await chromium.launch({ headless: true, executablePath });
+  const { server, origin } = await startServer();
+  let failures = 0;
+
+  try {
+    for (const item of selected) {
+      const { session, problems, contexts } = makeSession(browser, origin);
+      let error = null;
+      try {
+        await item.fn({ open: session.open, session });
+      } catch (caught) {
+        error = caught;
+      }
+      for (const context of contexts) {
+        await context.close();
+      }
+      if (!error && problems.length > 0) {
+        error = new Error(problems.join('\n  '));
+      }
+      if (error) {
+        failures++;
+        console.log(`FAIL ${item.name}\n  ${error.message.split('\n').join('\n  ')}`);
+      } else {
+        console.log(`PASS ${item.name}`);
+      }
+    }
+  } finally {
+    await browser.close();
+    server.close();
+  }
+
+  console.log(`\n${selected.length - failures} passed, ${failures} failed`);
+  process.exit(failures === 0 ? 0 : 1);
+}
+
+run().catch((error) => {
+  console.error(error);
+  process.exit(1);
+});
