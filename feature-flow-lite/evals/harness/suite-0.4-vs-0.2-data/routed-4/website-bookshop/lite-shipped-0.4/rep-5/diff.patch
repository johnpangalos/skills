+  assert.ok(events.length >= 4, `event count ${events.length}`);
+  for (const event of events) {
+    assert.match(event.datetime, /^\d{4}-\d{2}-\d{2}$/, `datetime format for ${event.title}`);
+    const date = new Date(`${event.datetime}T00:00:00Z`);
