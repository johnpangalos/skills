+:root {
+  --ink: #1d1b18;
+  --paper: #fbf8f1;
+  --card: #ffffff;
+  --muted: #4f4a42;
+  --accent: #1f4e79;
+  --accent-hover: #173a5a;
+  --header: #2c3e50;
+  --error: #a4161a;
+  --focus: #8a4b00;
+  --border: #d9d2c3;
+  --field-border: #8a8175;
+  --status-bg: #eef4fa;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+html {
+  -webkit-text-size-adjust: 100%;
+  scroll-behavior: smooth;
+}
+
+body {
+  margin: 0;
+  font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
+  font-size: 1rem;
+  line-height: 1.6;
+  color: var(--ink);
+  background: var(--paper);
+  overflow-wrap: anywhere;
+}
+
+[hidden] {
+  display: none !important;
+}
+
+h1, h2 {
+  line-height: 1.25;
+}
+
+h1 {
+  font-size: clamp(1.75rem, 5vw, 2.5rem);
+  margin: 0.5rem 0 1rem;
+}
+
+h2 {
+  font-size: 1.25rem;
+  margin: 0 0 0.25rem;
+}
+
+p {
+  margin: 0 0 1rem;
+}
+
+a {
+  color: var(--accent);
+}
+
+a:hover {
+  text-decoration-thickness: 2px;
+  text-decoration-line: underline;
+}
+
+:focus-visible {
+  outline: 3px solid var(--focus);
+  outline-offset: 3px;
+}
+
+main:focus {
+  outline: none;
+}
+
+/* Skip link */
+
+.skip-link {
+  position: absolute;
+  left: 0.5rem;
+  top: -4rem;
+  z-index: 10;
+  padding: 0.5rem 1rem;
+  background: var(--card);
+  color: var(--ink);
+}
+
+.skip-link:focus {
+  top: 0.5rem;
+}
+
+/* Header and navigation */
+
+.site-header {
+  background: var(--header);
+  color: #ffffff;
+}
+
+.header-inner {
+  max-width: 60rem;
+  margin: 0 auto;
+  padding: 0.75rem 1rem;
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0.5rem 1rem;
+}
+
+.site-name {
+  margin: 0;
+  font-size: 1.25rem;
+  font-weight: 700;
+}
+
+.site-name a {
+  color: #ffffff;
+  text-decoration: none;
+}
+
+.site-nav ul {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.25rem 1rem;
+}
+
+.site-nav a {
+  color: #ffffff;
+  padding: 0.25rem 0;
+}
+
+.site-nav a[aria-current="page"] {
+  font-weight: 700;
+  text-decoration: underline;
+  text-decoration-thickness: 2px;
+  text-underline-offset: 4px;
+}
+
+.site-header :focus-visible {
+  outline-color: #ffd166;
+}
+
+/* Layout */
+
+main {
+  max-width: 60rem;
+  min-width: 0;
+  margin: 0 auto;
+  padding: 1.5rem 1rem 3rem;
+}
+
+.lead {
+  font-size: 1.15rem;
+}
+
+.teasers {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  gap: 1rem;
+  margin-top: 2rem;
+}
+
+@media (min-width: 40rem) {
+  .teasers {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+  }
+}
+
+.teaser,
+.book,
+.event {
+  background: var(--card);
+  border: 1px solid var(--border);
+  border-radius: 6px;
+  padding: 1rem;
+}
+
+.site-footer {
+  margin-top: 2rem;
+  padding: 1.25rem 0;
+  background: #e9e2d3;
+  color: var(--ink);
+}
+
+.site-footer p {
+  max-width: 60rem;
+  margin: 0 auto;
+  padding: 0 1rem;
+}
+
+/* Books */
+
+.filter {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 0.5rem 0.75rem;
+  margin: 1rem 0 1.5rem;
+}
+
+.filter select {
+  font: inherit;
+  max-width: 100%;
+  padding: 0.5rem;
+  border: 1px solid var(--field-border);
+  border-radius: 4px;
+  background: var(--card);
+}
+
+.result-count {
+  margin: 0;
+  font-weight: 600;
+}
+
+.book-list,
+.event-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  gap: 1rem;
+}
+
+@media (min-width: 40rem) {
+  .book-list {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+}
+
+@media (min-width: 60rem) {
+  .book-list {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+  }
+}
+
+.book h2 {
+  margin-bottom: 0.25rem;
+}
+
+.book-author {
+  color: var(--muted);
+  margin-bottom: 0.5rem;
+}
+
+.book-meta {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 0.5rem;
+  margin-bottom: 0.5rem;
+}
+
+.genre {
+  font-size: 0.875rem;
+  font-weight: 600;
+  color: var(--muted);
+  cursor: default;
+}
+
+.price {
+  font-weight: 700;
+}
+
+.book-blurb {
+  margin: 0;
+}
+
+/* Events */
+
+.event-when {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.25rem 0.75rem;
+  margin-bottom: 0.5rem;
+  color: var(--muted);
+  font-weight: 600;
+}
+
+.event h2 {
+  margin-bottom: 0.5rem;
+}
+
+.event p:last-child {
+  margin-bottom: 0;
+}
+
+/* Visit */
+
+.hours dt {
+  font-weight: 700;
+}
+
+.hours dd {
+  margin: 0 0 0.75rem;
+}
+
+address {
+  font-style: normal;
+  margin-bottom: 1.5rem;
+}
+
+.contact-form {
+  max-width: 36rem;
+}
+
+.field {
+  display: flex;
+  flex-direction: column;
+  gap: 0.25rem;
+  margin-bottom: 1rem;
+}
+
+.field label {
+  font-weight: 600;
+}
+
+.field input,
+.field textarea {
+  width: 100%;
+  max-width: 100%;
+  font: inherit;
+  padding: 0.5rem;
+  border: 1px solid var(--field-border);
+  border-radius: 4px;
+  background: var(--card);
+}
+
+.field textarea {
+  min-height: 8rem;
+  resize: vertical;
+}
+
+.field input[aria-invalid="true"],
+.field textarea[aria-invalid="true"] {
+  border: 2px solid var(--error);
+}
+
+.field-error {
+  margin: 0;
+  color: var(--error);
+  font-weight: 600;
+}
+
+button {
+  font: inherit;
+  padding: 0.6rem 1.2rem;
+  border: 0;
+  border-radius: 4px;
+  background: var(--accent);
+  color: #ffffff;
+  cursor: pointer;
+  transition: background-color 0.2s;
+}
+
+button:hover {
+  background: var(--accent-hover);
+}
+
+.form-status {
+  max-width: 36rem;
+  margin-top: 1rem;
+}
+
+.form-status:not(:empty) {
+  padding: 0.75rem 1rem;
+  border-left: 4px solid var(--accent);
+  background: var(--status-bg);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  html {
+    scroll-behavior: auto;
+  }
+
+  *,
+  *::before,
+  *::after {
+    transition-duration: 0.01ms !important;
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+  }
+}
