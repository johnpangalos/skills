+// Browser tests for the Marginalia Books site.
+// Usage: node tests/run.mjs [name-substring]
+// Needs the globally installed Playwright and a Chrome binary (/usr/bin/google-chrome if the bundled one is missing).
+
+import { createRequire } from 'module';
+import { createServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { existsSync } from 'node:fs';
+import { dirname, extname, join, normalize } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import assert from 'node:assert/strict';
+
+const require = createRequire(import.meta.url);
+const { chromium } = require(require('child_process').execSync('npm root -g').toString().trim() + '/playwright');
+
+const ROOT = normalize(join(dirname(fileURLToPath(import.meta.url)), '..'));
+const PAGES = ['index.html', 'books.html', 'events.html', 'visit.html'];
+const TYPES = {
+  '.html': 'text/html; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.js': 'text/javascript; charset=utf-8',
+  '.svg': 'image/svg+xml'
+};
+const TODAY = '2026-11-17';
+const CHROME_FALLBACK = '/usr/bin/google-chrome';
+
+function startServer() {
+  const server = createServer(async (req, res) => {
+    let file;
+    try {
+      const pathname = decodeURIComponent(new URL(req.url, 'http://127.0.0.1').pathname);
+      file = normalize(join(ROOT, pathname.endsWith('/') ? pathname + 'index.html' : pathname));
+    } catch {
+      res.writeHead(400).end();
+      return;
+    }
+    if (!file.startsWith(ROOT + '/')) {
+      res.writeHead(403).end();
+      return;
+    }
+    try {
+      const body = await readFile(file);
+      res.writeHead(200, { 'Content-Type': TYPES[extname(file)] || 'application/octet-stream' });
+      res.end(body);
+    } catch {
+      res.writeHead(404).end();
+    }
+  });
+  return new Promise((resolve) => {
+    server.listen(0, '127.0.0.1', () => {
+      resolve({ server, origin: `http://127.0.0.1:${server.address().port}` });
+    });
+  });
+}
+
+// Opens pages in fresh contexts. Anything that is not served by this server is aborted and recorded,
+// and console errors, page errors and dialogs are recorded. The runner fails the test if any were recorded.
+function makeSession(browser, origin) {
+  const problems = [];
+  const requests = [];
+  const contexts = [];
+
+  const session = {
+    requests,
+    async open(path, width = 1024) {
+      const context = await browser.newContext({ viewport: { width, height: 900 } });
+      contexts.push(context);
+      await context.route('**/*', (route) => {
+        const request = route.request();
+        requests.push({ method: request.method(), url: request.url() });
+        if (request.url().startsWith(origin + '/')) {
+          return route.continue();
+        }
+        problems.push(`non-local request to ${request.url()}`);
+        return route.abort();
+      });
+      const page = await context.newPage();
+      page.on('console', (message) => {
+        if (message.type() === 'error') {
+          problems.push(`console error on ${path}: ${message.text()}`);
+        }
+      });
+      page.on('pageerror', (error) => problems.push(`page error on ${path}: ${error.message}`));
+      page.on('dialog', (dialog) => {
+        problems.push(`unexpected dialog on ${path}: ${dialog.message()}`);
+        dialog.dismiss();
+      });
+      await page.goto(`${origin}/${path}`);
+      return page;
+    }
+  };
+
+  return { session, problems, contexts };
+}
+
+const tests = [];
+const test = (name, fn) => tests.push({ name, fn });
+
+const countVisibleBooks = (page) => page.locator('.book:not([hidden])').count();
