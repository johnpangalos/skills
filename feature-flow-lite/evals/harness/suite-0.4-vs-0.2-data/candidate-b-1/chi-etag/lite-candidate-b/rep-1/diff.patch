+func TestETagReadmeListsMiddleware(t *testing.T) {
+	readme, err := os.ReadFile("../README.md")
+	if err != nil {
+		t.Fatal(err)
+	}
+	const link = "[ETag]: https://pkg.go.dev/github.com/go-chi/chi/v5/middleware#ETag"
+	if !strings.Contains(string(readme), link) {
+		t.Fatalf("README is missing %q", link)
+	}
+	row := regexp.MustCompile(`(?m)^\| \[ETag\] +\| .+\|$`).FindStringIndex(string(readme))
+	if row == nil {
+		t.Fatal("README table has no [ETag] row")
+	}
+	clean := strings.Index(string(readme), "| [CleanPath]")
+	getHead := strings.Index(string(readme), "| [GetHead]")
+	if !(clean < row[0] && row[0] < getHead) {
+		t.Fatal("[ETag] row is not between [CleanPath] and [GetHead]")
+	}
+}
+
+// etagInterim sends one request to h over a real server and returns the final
+// response and body, plus the 1xx codes and Link headers the client saw.
+func etagInterim(t *testing.T, h http.Handler, method string, hdr http.Header) (resp *http.Response, body string, codes []int, links []string) {
+	t.Helper()
+	ts := httptest.NewServer(h)
+	t.Cleanup(ts.Close)
+	trace := &httptrace.ClientTrace{
+		Got1xxResponse: func(code int, header textproto.MIMEHeader) error {
+			codes = append(codes, code)
+			links = append(links, header.Get("Link"))
+			return nil
+		},
+	}
+	req, err := http.NewRequestWithContext(httptrace.WithClientTrace(context.Background(), trace), method, ts.URL, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for k, v := range hdr {
+		req.Header[k] = v
+	}
+	resp, err = etagClient(t).Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+	b, err := io.ReadAll(resp.Body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return resp, string(b), codes, links
+}
+
+func TestETagInterimResponsesMatchPlainHandler(t *testing.T) {
+	const link = "</style.css>; rel=preload"
+	cases := []struct {
+		name  string
+		write func(w http.ResponseWriter)
+		want  []int
+	}{
+		{"103 then 200 body", func(w http.ResponseWriter) {
+			w.Header().Set("Link", link)
+			w.WriteHeader(http.StatusEarlyHints)
+			w.WriteHeader(http.StatusOK)
+			w.Write([]byte("hello body"))
+		}, []int{103}},
+		{"103 then body without 200", func(w http.ResponseWriter) {
+			w.Header().Set("Link", link)
+			w.WriteHeader(http.StatusEarlyHints)
+			w.Write([]byte("hello body"))
+		}, []int{103}},
+		{"100 then body", func(w http.ResponseWriter) {
+			w.WriteHeader(http.StatusContinue)
+			w.Write([]byte("hello body"))
+		}, []int{100}},
+	}
+	for _, tt := range cases {
+		for _, method := range []string{http.MethodGet, http.MethodHead} {
+			t.Run(tt.name+" "+method, func(t *testing.T) {
+				handler := func(w http.ResponseWriter, r *http.Request) { tt.write(w) }
+				plainResp, plainBody, plainCodes, plainLinks := etagInterim(t, http.HandlerFunc(handler), method, nil)
+				h := ETag(http.HandlerFunc(handler))
+				resp, body, codes, links := etagInterim(t, h, method, nil)
+
+				if !slices.Equal(codes, tt.want) || !slices.Equal(plainCodes, tt.want) {
+					t.Fatalf("1xx codes: plain %v, wrapped %v, want %v", plainCodes, codes, tt.want)
+				}
+				if !slices.Equal(links, plainLinks) {
+					t.Fatalf("1xx Link headers: wrapped %q, plain %q", links, plainLinks)
+				}
+				if resp.StatusCode != plainResp.StatusCode || resp.StatusCode != http.StatusOK {
+					t.Fatalf("status = %d, plain %d, want 200", resp.StatusCode, plainResp.StatusCode)
+				}
+				if method == http.MethodGet && body != plainBody {
+					t.Fatalf("body = %q, plain %q", body, plainBody)
+				}
+				for _, k := range []string{"Content-Type", "Content-Length"} {
+					if resp.Header.Get(k) != plainResp.Header.Get(k) {
+						t.Fatalf("%s = %q, plain %q", k, resp.Header.Get(k), plainResp.Header.Get(k))
+					}
+				}
+				if method == http.MethodHead && resp.Header.Get("Content-Length") != "10" {
+					t.Fatalf("HEAD Content-Length = %q, want 10", resp.Header.Get("Content-Length"))
+				}
+				want := etagValue(t, ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					w.Write([]byte("hello body"))
+				})))
+				if resp.Header.Get("ETag") != want {
+					t.Fatalf("ETag = %q, want %q", resp.Header.Get("ETag"), want)
+				}
+				// A matching If-None-Match after the 1xx must still give 304.
+				nm, _, _, _ := etagInterim(t, h, method, http.Header{"If-None-Match": {want}})
+				if nm.StatusCode != http.StatusNotModified {
+					t.Fatalf("If-None-Match status = %d, want 304", nm.StatusCode)
+				}
+			})
+		}
+	}
+}
