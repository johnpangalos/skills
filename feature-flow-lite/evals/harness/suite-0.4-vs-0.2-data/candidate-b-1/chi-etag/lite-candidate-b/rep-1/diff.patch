diff --git a/middleware/etag.go b/middleware/etag.go
new file mode 100644
index 0000000..3ffcc7e
--- /dev/null
+++ b/middleware/etag.go
@@ -0,0 +1,204 @@
+package middleware
+
+import (
+	"bufio"
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"maps"
+	"net"
+	"net/http"
+	"slices"
+	"strings"
+)
+
+// ETag adds a strong ETag to 200 responses to GET and HEAD requests, and answers
+// 304 Not Modified when the If-None-Match request header matches it.
+//
+// The ETag is derived from the response body, unless the handler sets its own
+// ETag header, which is kept as it is. Responses to GET and HEAD are buffered in
+// memory until the handler returns, so Flush sends nothing early. A HEAD response
+// with no body and no handler ETag gets no ETag. Other methods pass through
+// unchanged.
+//
+// ETag reads If-None-Match before it calls the next handler, so place it ahead of
+// NoCache in the chain (r.Use(ETag) before r.Use(NoCache)). NoCache deletes that
+// request header, so an ETag placed after it never sees the header and never
+// answers 304.
+func ETag(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet && r.Method != http.MethodHead {
+			next.ServeHTTP(w, r)
+			return
+		}
+		// Copy If-None-Match before the handler runs, since the handler may delete it.
+		ew := &etagResponseWriter{
+			ResponseWriter: w,
+			req:            r,
+			ifNoneMatch:    slices.Clone(r.Header.Values("If-None-Match")),
+		}
+		next.ServeHTTP(ew, r)
+		ew.send()
+	})
+}
+
+type etagResponseWriter struct {
+	http.ResponseWriter
+
+	req         *http.Request
+	ifNoneMatch []string
+	// header is the header as it was at the first WriteHeader or Write, which is
+	// what net/http would have sent.
+	header      http.Header
+	status      int
+	body        bytes.Buffer
+	wroteHeader bool
+	hijacked    bool
+}
+
+func (ew *etagResponseWriter) WriteHeader(code int) {
+	if ew.wroteHeader {
+		return // The first code wins, as in net/http.
+	}
+	if code >= 100 && code <= 199 && code != http.StatusSwitchingProtocols {
+		// An informational status is sent now and does not end the response, as in net/http.
+		ew.ResponseWriter.WriteHeader(code)
+		return
+	}
+	ew.wroteHeader = true
+	ew.status = code
+	ew.header = http.Header{}
+	maps.Copy(ew.header, ew.ResponseWriter.Header())
+}
+
+func (ew *etagResponseWriter) Write(p []byte) (int, error) {
+	if !ew.wroteHeader {
+		ew.WriteHeader(http.StatusOK)
+	}
+	if len(p) > 0 && !bodyAllowedForStatus(ew.status) {
+		return 0, http.ErrBodyNotAllowed
+	}
+	return ew.body.Write(p)
+}
+
+// Flush is a no-op: the response is sent when the handler returns.
+func (ew *etagResponseWriter) Flush() {}
+
+func (ew *etagResponseWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	hj, ok := ew.ResponseWriter.(http.Hijacker)
+	if !ok {
+		return nil, nil, errors.New("chi/middleware: http.Hijacker is unavailable on the writer")
+	}
+	conn, rw, err := hj.Hijack()
+	if err == nil {
+		ew.hijacked = true
+	}
+	return conn, rw, err
+}
+
+func (ew *etagResponseWriter) Push(target string, opts *http.PushOptions) error {
+	if ps, ok := ew.ResponseWriter.(http.Pusher); ok {
+		return ps.Push(target, opts)
+	}
+	return errors.New("chi/middleware: http.Pusher is unavailable on the writer")
+}
+
+func (ew *etagResponseWriter) Unwrap() http.ResponseWriter {
+	return ew.ResponseWriter
+}
+
+// send writes the buffered response to the underlying writer, unless the
+// connection was hijacked. The body goes out in one Write, so net/http sniffs
+// the Content-Type from it exactly as it would for an unbuffered handler.
+func (ew *etagResponseWriter) send() {
+	if !ew.wroteHeader {
+		ew.WriteHeader(http.StatusOK)
+	}
+	if ew.hijacked {
+		return
+	}
+	h := ew.ResponseWriter.Header()
+	clear(h)
+	maps.Copy(h, ew.header)
+	body := ew.body.Bytes()
+
+	if ew.status == http.StatusOK {
+		if h.Get("ETag") == "" && (ew.req.Method == http.MethodGet || len(body) > 0) {
+			sum := sha256.Sum256(body)
+			h.Set("ETag", `"`+hex.EncodeToString(sum[:16])+`"`)
+		}
+		if etagIfNoneMatch(ew.ifNoneMatch, h.Get("ETag")) {
+			h.Del("Content-Type")
+			h.Del("Content-Length")
+			h.Del("Content-Encoding")
+			ew.ResponseWriter.WriteHeader(http.StatusNotModified)
+			return
+		}
+	}
+	ew.ResponseWriter.WriteHeader(ew.status)
+	if len(body) > 0 {
+		ew.ResponseWriter.Write(body)
+	}
+}
+
+// bodyAllowedForStatus reports whether a response with the status code may have
+// a body, as net/http decides it.
+func bodyAllowedForStatus(status int) bool {
+	switch {
+	case status >= 100 && status <= 199:
+		return false
+	case status == http.StatusNoContent, status == http.StatusNotModified:
+		return false
+	}
+	return true
+}
+
+// etagIfNoneMatch reports whether the If-None-Match header values match etag
+// under weak comparison (RFC 9110 section 13.1.2). A "*" member matches any
+// current representation. Parsing stops at the first malformed member.
+func etagIfNoneMatch(values []string, etag string) bool {
+	list := strings.Join(values, ",")
+	for {
+		list = strings.TrimLeft(list, " \t")
+		switch {
+		case list == "":
+			return false
+		case list[0] == ',':
+			list = list[1:]
+		case list[0] == '*':
+			return true
+		default:
+			tag, rest := etagScan(list)
+			if tag == "" {
+				return false
+			}
+			if strings.TrimPrefix(tag, "W/") == strings.TrimPrefix(etag, "W/") {
+				return true
+			}
+			list = rest
+		}
+	}
+}
+
+// etagScan returns the entity-tag at the start of s and the text after it, or
+// empty strings if s does not start with a well-formed entity-tag.
+func etagScan(s string) (tag, rest string) {
+	start := 0
+	if strings.HasPrefix(s, "W/") {
+		start = 2
+	}
+	if len(s) < start+2 || s[start] != '"' {
+		return "", ""
+	}
+	for i := start + 1; i < len(s); i++ {
+		switch c := s[i]; {
+		case c == 0x21 || c >= 0x23 && c <= 0x7e || c >= 0x80:
+		case c == '"':
+			return s[:i+1], s[i+1:]
+		default:
+			return "", ""
+		}
+	}
+	return "", ""
+}
diff --git a/middleware/etag_test.go b/middleware/etag_test.go
new file mode 100644
index 0000000..2eae817
--- /dev/null
+++ b/middleware/etag_test.go
@@ -0,0 +1,1011 @@
+package middleware
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"go/ast"
+	"go/parser"
+	gotoken "go/token"
+	"io"
+	"math/rand"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/http/httptrace"
+	"net/textproto"
+	"os"
+	"regexp"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/go-chi/chi/v5"
+)
+
+var etagStrong = regexp.MustCompile(`^"[\x21\x23-\x7e]+"$`)
+
+// etagClient returns a client that does not decode Content-Encoding, so the
+// test sees the headers exactly as the handler sent them.
+func etagClient(t *testing.T) *http.Client {
+	tr := &http.Transport{DisableCompression: true}
+	t.Cleanup(tr.CloseIdleConnections)
+	return &http.Client{Transport: tr}
+}
+
+// etagGet sends one request to url and returns the response and its body.
+func etagGet(t *testing.T, client *http.Client, url, method string, hdr http.Header) (*http.Response, string) {
+	t.Helper()
+	req, err := http.NewRequest(method, url, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for k, v := range hdr {
+		req.Header[k] = v
+	}
+	resp, err := client.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(resp.Body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return resp, string(body)
+}
+
+// etagServe runs h on a test server and sends one request to it.
+func etagServe(t *testing.T, h http.Handler, method string, hdr http.Header) (*http.Response, string) {
+	t.Helper()
+	ts := httptest.NewServer(h)
+	t.Cleanup(ts.Close)
+	return etagGet(t, etagClient(t), ts.URL, method, hdr)
+}
+
+// etagValue returns the ETag of a plain GET of h, which must be wrapped by ETag.
+func etagValue(t *testing.T, h http.Handler) string {
+	t.Helper()
+	resp, _ := etagServe(t, h, http.MethodGet, nil)
+	return resp.Header.Get("ETag")
+}
+
+// etagRecord serves h in process with an optional If-None-Match value.
+func etagRecord(h http.Handler, inm string) *httptest.ResponseRecorder {
+	rec := httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodGet, "/", nil)
+	if inm != "" {
+		req.Header.Set("If-None-Match", inm)
+	}
+	h.ServeHTTP(rec, req)
+	return rec
+}
+
+// etagFormatHeaders formats h without the named keys, so two responses can be compared.
+func etagFormatHeaders(h http.Header, skip ...string) string {
+	c := h.Clone()
+	c.Del("Date")
+	c.Del("ETag")
+	for _, k := range skip {
+		c.Del(k)
+	}
+	return fmt.Sprint(c)
+}
+
+func TestETagSignatureAndDoc(t *testing.T) {
+	var mw func(http.Handler) http.Handler = ETag
+	if mw == nil {
+		t.Fatal("ETag is nil")
+	}
+	f, err := parser.ParseFile(gotoken.NewFileSet(), "etag.go", nil, parser.ParseComments)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, decl := range f.Decls {
+		if fn, ok := decl.(*ast.FuncDecl); ok && fn.Name.Name == "ETag" {
+			if fn.Doc == nil {
+				t.Fatal("ETag has no doc comment")
+			}
+			return
+		}
+	}
+	t.Fatal("ETag is not declared in etag.go")
+}
+
+func TestETagComputesStrongValidator(t *testing.T) {
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("X-Custom", "yes")
+		w.Write([]byte("hello"))
+	}))
+	resp, body := etagServe(t, h, http.MethodGet, nil)
+	if resp.StatusCode != http.StatusOK || body != "hello" || resp.Header.Get("X-Custom") != "yes" {
+		t.Fatalf("got %d %q with X-Custom %q", resp.StatusCode, body, resp.Header.Get("X-Custom"))
+	}
+	etag := resp.Header.Get("ETag")
+	if !etagStrong.MatchString(etag) {
+		t.Fatalf("ETag %q is not a strong entity-tag", etag)
+	}
+	if again := etagValue(t, h); again != etag {
+		t.Fatalf("same body gave ETag %q then %q", etag, again)
+	}
+	other := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("hellp"))
+	}))
+	if got := etagValue(t, other); got == etag {
+		t.Fatalf("different body gave the same ETag %q", got)
+	}
+}
+
+func TestETagBodyEdgeCases(t *testing.T) {
+	whole := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("hello"))
+	}))
+	chunked := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		for _, s := range []string{"h", "e", "l", "l", "o"} {
+			w.Write([]byte(s))
+		}
+	}))
+	if got, want := etagValue(t, chunked), etagValue(t, whole); got != want {
+		t.Fatalf("many small writes gave ETag %q, one write gave %q", got, want)
+	}
+
+	empty := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusOK)
+	}))
+	resp, body := etagServe(t, empty, http.MethodGet, nil)
+	if resp.StatusCode != http.StatusOK || body != "" || !etagStrong.MatchString(resp.Header.Get("ETag")) {
+		t.Fatalf("empty 200 gave %d %q ETag %q", resp.StatusCode, body, resp.Header.Get("ETag"))
+	}
+
+	large := bytes.Repeat([]byte("0123456789abcdef"), 1<<16) // 1 MiB
+	big := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write(large)
+	}))
+	_, body = etagServe(t, big, http.MethodGet, nil)
+	if body != string(large) {
+		t.Fatalf("1 MiB body changed in transit: got %d bytes", len(body))
+	}
+}
+
+func TestETagKeepsHandlerETag(t *testing.T) {
+	for _, tag := range []string{`W/"v1"`, `"v1"`} {
+		h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("ETag", tag)
+			w.Write([]byte("hello"))
+		}))
+		resp, _ := etagServe(t, h, http.MethodGet, nil)
+		if got := resp.Header.Values("ETag"); len(got) != 1 || got[0] != tag {
+			t.Fatalf("ETag = %q, want exactly %q", got, tag)
+		}
+	}
+}
+
+func TestETagIfNoneMatch(t *testing.T) {
+	tests := []struct {
+		name string
+		set  string   // handler-set ETag; empty means the middleware computes it
+		inm  []string // If-None-Match lines; {etag} and {prefix} are replaced
+		want int
+	}{
+		{"strong match", "", []string{"{etag}"}, 304},
+		{"weak inm vs strong etag", "", []string{"W/{etag}"}, 304},
+		{"strong inm vs weak handler etag", `W/"v1"`, []string{`"v1"`}, 304},
+		{"weak vs weak", `W/"v1"`, []string{`W/"v1"`}, 304},
+		{"list with whitespace", "", []string{`"a", "b" ,{etag}`}, 304},
+		{"star", "", []string{"*"}, 304},
+		{"multiple header lines", "", []string{`"a"`, "{etag}"}, 304},
+		{"no match in list", "", []string{`"a", W/"b"`}, 200},
+		{"unquoted tag", "", []string{"abc"}, 200},
+		{"empty header value", "", []string{""}, 200},
+		{"empty quoted tag", "", []string{`""`}, 200},
+		{"prefix of etag", "", []string{"{prefix}"}, 200},
+		{"malformed member stops parsing", "", []string{`"a", garbage, {etag}`}, 200},
+		{"match before malformed member", "", []string{`{etag}, garbage`}, 304},
+		{"unquoted handler etag", "v1", []string{"v1"}, 200},
+		{"unquoted handler etag vs quoted", "v1", []string{`"v1"`}, 200},
+		{"star matches unquoted handler etag", "v1", []string{"*"}, 304},
+	}
+	for _, tt := range tests {
+		for _, method := range []string{http.MethodGet, http.MethodHead} {
+			t.Run(tt.name+" "+method, func(t *testing.T) {
+				h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					if tt.set != "" {
+						w.Header().Set("ETag", tt.set)
+					}
+					w.Write([]byte("hello"))
+				}))
+				etag := etagValue(t, h)
+				inner := strings.Trim(etag, `"`)
+				repl := strings.NewReplacer("{etag}", etag, "{prefix}", `"`+inner[:len(inner)-1]+`"`)
+				var hdr http.Header = http.Header{}
+				for _, v := range tt.inm {
+					hdr.Add("If-None-Match", repl.Replace(v))
+				}
+				resp, body := etagServe(t, h, method, hdr)
+				if resp.StatusCode != tt.want {
+					t.Fatalf("status = %d, want %d (If-None-Match %q)", resp.StatusCode, tt.want, hdr.Values("If-None-Match"))
+				}
+				if tt.want == http.StatusNotModified && body != "" {
+					t.Fatalf("304 carried body %q", body)
+				}
+				if tt.want == http.StatusOK && method == http.MethodGet && body != "hello" {
+					t.Fatalf("200 body = %q", body)
+				}
+			})
+		}
+	}
+}
+
+func TestETagNotModifiedKeepsHeaders(t *testing.T) {
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Cache-Control", "max-age=60")
+		w.Header().Set("Vary", "Accept")
+		w.Header().Set("Expires", "Wed, 21 Oct 2037 07:28:00 GMT")
+		w.Header().Set("Content-Location", "/hello.txt")
+		w.Header().Set("X-Custom", "yes")
+		w.Header().Set("Content-Type", "text/plain")
+		w.Header().Set("Content-Length", "5")
+		w.Header().Set("Content-Encoding", "gzip")
+		w.Write([]byte("hello"))
+	}))
+	etag := etagValue(t, h)
+	resp, body := etagServe(t, h, http.MethodGet, http.Header{"If-None-Match": {etag}})
+	if resp.StatusCode != http.StatusNotModified || body != "" {
+		t.Fatalf("got %d %q, want 304 with empty body", resp.StatusCode, body)
+	}
+	if resp.Header.Get("ETag") != etag {
+		t.Fatalf("304 ETag = %q, want %q", resp.Header.Get("ETag"), etag)
+	}
+	kept := map[string]string{
+		"Cache-Control":    "max-age=60",
+		"Vary":             "Accept",
+		"Expires":          "Wed, 21 Oct 2037 07:28:00 GMT",
+		"Content-Location": "/hello.txt",
+		"X-Custom":         "yes",
+	}
+	for k, v := range kept {
+		if got := resp.Header.Get(k); got != v {
+			t.Fatalf("304 %s = %q, want %q", k, got, v)
+		}
+	}
+	for _, k := range []string{"Content-Type", "Content-Length", "Content-Encoding"} {
+		if got := resp.Header.Get(k); got != "" {
+			t.Fatalf("304 kept %s = %q", k, got)
+		}
+	}
+}
+
+func TestETagHEAD(t *testing.T) {
+	hello := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("hello"))
+	})
+	etag := etagValue(t, ETag(hello))
+
+	t.Run("ETag from bytes matches GET", func(t *testing.T) {
+		resp, _ := etagServe(t, ETag(hello), http.MethodHead, nil)
+		if resp.Header.Get("ETag") != etag {
+			t.Fatalf("HEAD ETag = %q, want %q", resp.Header.Get("ETag"), etag)
+		}
+	})
+
+	t.Run("no bytes and no ETag adds none", func(t *testing.T) {
+		empty := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(http.StatusOK)
+		}))
+		resp, _ := etagServe(t, empty, http.MethodHead, nil)
+		if vals := resp.Header.Values("ETag"); len(vals) != 0 {
+			t.Fatalf("empty HEAD got ETag %q", vals)
+		}
+	})
+}
+
+func TestETagNonOKPassesThrough(t *testing.T) {
+	tests := []struct {
+		name string
+		code int
+		body string
+	}{
+		{"201 created", http.StatusCreated, "made"},
+		{"204 no content", http.StatusNoContent, ""},
+		{"206 partial", http.StatusPartialContent, "part"},
+		{"301 moved", http.StatusMovedPermanently, "moved"},
+		{"404 not found", http.StatusNotFound, "missing"},
+		{"500 error", http.StatusInternalServerError, "boom"},
+	}
+	for _, tt := range tests {
+		for _, method := range []string{http.MethodGet, http.MethodHead} {
+			t.Run(tt.name+" "+method, func(t *testing.T) {
+				h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					w.WriteHeader(tt.code)
+					w.Write([]byte(tt.body))
+				}))
+				resp, body := etagServe(t, h, method, nil)
+				if resp.StatusCode != tt.code || (method == http.MethodGet && body != tt.body) {
+					t.Fatalf("got %d %q, want %d %q", resp.StatusCode, body, tt.code, tt.body)
+				}
+				if vals := resp.Header.Values("ETag"); len(vals) != 0 {
+					t.Fatalf("non-200 got ETag %q", vals)
+				}
+			})
+		}
+	}
+
+	t.Run("404 with matching If-None-Match stays 404", func(t *testing.T) {
+		h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("ETag", `"v1"`)
+			w.WriteHeader(http.StatusNotFound)
+			w.Write([]byte("missing"))
+		}))
+		resp, body := etagServe(t, h, http.MethodGet, http.Header{"If-None-Match": {`"v1"`}})
+		if resp.StatusCode != http.StatusNotFound || body != "missing" {
+			t.Fatalf("got %d %q, want 404 missing", resp.StatusCode, body)
+		}
+	})
+
+	t.Run("second WriteHeader is ignored", func(t *testing.T) {
+		h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(http.StatusCreated)
+			w.WriteHeader(http.StatusInternalServerError)
+			w.Write([]byte("x"))
+		}))
+		resp, body := etagServe(t, h, http.MethodGet, nil)
+		if resp.StatusCode != http.StatusCreated || body != "x" {
+			t.Fatalf("got %d %q, want 201 x", resp.StatusCode, body)
+		}
+	})
+}
