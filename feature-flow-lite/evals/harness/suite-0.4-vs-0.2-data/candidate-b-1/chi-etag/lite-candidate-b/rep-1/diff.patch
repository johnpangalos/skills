+			t.Run(fmt.Sprintf("%d %s", status, name), func(t *testing.T) {
+				// errs receives the result of a zero-length Write, then of a Write with a body.
+				errs := make(chan error, 2)
+				h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					w.WriteHeader(status)
+					_, err := w.Write(nil)
+					errs <- err
+					_, err = w.Write([]byte("text"))
+					errs <- err
+				})
+				etagServe(t, mw(h), http.MethodGet, nil)
+				if err := <-errs; err != nil {
+					t.Fatalf("zero-length Write returned %v, want nil", err)
+				}
+				if err := <-errs; err != http.ErrBodyNotAllowed {
+					t.Fatalf("Write returned %v, want http.ErrBodyNotAllowed", err)
+				}
+			})
+		}
+	}
+}
