+func TestETagPropertyConditionalMatch(t *testing.T) {
+	rnd := rand.New(rand.NewSource(1))
+	seps := []string{", ", ",", " , ", ",\t"}
+	const alnum = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
+	noise := func() string {
+		b := make([]byte, 1+rnd.Intn(8))
+		for i := range b {
+			b[i] = alnum[rnd.Intn(len(alnum))]
+		}
+		tag := `"` + string(b) + `"`
+		if rnd.Intn(2) == 0 {
+			tag = "W/" + tag
+		}
+		return tag
+	}
+	for i := 0; i < 1000; i++ {
+		body := make([]byte, rnd.Intn(300))
+		for j := range body {
+			body[j] = byte(rnd.Intn(256))
+		}
+		chunk := 1 + rnd.Intn(16)
+		chunked := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			for p := body; len(p) > 0; {
+				n := min(chunk, len(p))
+				w.Write(p[:n])
+				p = p[n:]
+			}
+		}))
+		whole := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Write(body)
+		}))
+
+		got := etagRecord(chunked, "")
+		etag := got.Header().Get("ETag")
+		if got.Code != http.StatusOK || !bytes.Equal(got.Body.Bytes(), body) || !etagStrong.MatchString(etag) || etagRecord(whole, "").Header().Get("ETag") != etag {
+			t.Fatalf("iteration %d: body %x, chunk %d: code %d, ETag %q", i, body, chunk, got.Code, etag)
+		}
+
+		// Build a list with the real ETag at a random position among noise tags.
+		n := rnd.Intn(4)
+		k := rnd.Intn(n + 1)
+		parts := make([]string, n+1)
+		for m := range parts {
+			if m != k {
+				parts[m] = noise()
+			}
+		}
+		gaps := make([]string, n)
+		for m := range gaps {
+			gaps[m] = seps[rnd.Intn(len(seps))]
+		}
+		join := func(target string) string {
+			var sb strings.Builder
+			for m := range parts {
+				if m > 0 {
+					sb.WriteString(gaps[m-1])
+				}
+				if m == k {
+					sb.WriteString(target)
+				} else {
+					sb.WriteString(parts[m])
+				}
+			}
+			return sb.String()
+		}
+		target := etag
+		if rnd.Intn(2) == 0 {
+			target = "W/" + etag
+		}
+
+		inm := join(target)
+		if got := etagRecord(whole, inm); got.Code != http.StatusNotModified || got.Body.Len() != 0 {
+			t.Fatalf("iteration %d: If-None-Match %q against ETag %q: got %d, want 304", i, inm, etag, got.Code)
+		}
+		mutated := join(`"z` + etag[2:])
+		if got := etagRecord(whole, mutated); got.Code != http.StatusOK {
+			t.Fatalf("iteration %d: If-None-Match %q against ETag %q: got %d, want 200", i, mutated, etag, got.Code)
+		}
+	}
+}
