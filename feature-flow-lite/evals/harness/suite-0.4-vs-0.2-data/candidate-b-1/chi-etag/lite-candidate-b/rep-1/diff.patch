+// etagFlushProbe serves ETag(before, Flush, block until released, write "b")
+// and reports whether the response headers reached the client before the
+// handler returned. It returns that flag, the response and the body.
+func etagFlushProbe(t *testing.T, method string, hdr http.Header, before func(w http.ResponseWriter)) (bool, *http.Response, string) {
+	t.Helper()
+	release := make(chan struct{})
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		before(w)
+		w.(http.Flusher).Flush()
+		select {
+		case <-release:
+		case <-time.After(5 * time.Second):
+		}
+		w.Write([]byte("b"))
+	}))
+	ts := httptest.NewServer(h)
+	defer ts.Close()
+	client := etagClient(t)
+
+	// Do returns once the response headers arrive, which is when Flush
+	// reaches the client or, when buffered, when the handler returns.
+	type result struct {
+		resp *http.Response
+		err  error
+	}
+	ch := make(chan result, 1)
+	go func() {
+		req, err := http.NewRequest(method, ts.URL, nil)
+		if err != nil {
+			ch <- result{err: err}
+			return
+		}
+		for k, v := range hdr {
+			req.Header[k] = v
+		}
+		resp, err := client.Do(req)
+		ch <- result{resp: resp, err: err}
+	}()
+
+	var res result
+	early := false
+	select {
+	case res = <-ch:
+		early = true
+		close(release)
+	case <-time.After(300 * time.Millisecond):
+		close(release)
+		res = <-ch
+	}
+	if res.err != nil {
+		t.Fatal(res.err)
+	}
+	defer res.resp.Body.Close()
+	body, err := io.ReadAll(res.resp.Body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return early, res.resp, string(body)
+}
