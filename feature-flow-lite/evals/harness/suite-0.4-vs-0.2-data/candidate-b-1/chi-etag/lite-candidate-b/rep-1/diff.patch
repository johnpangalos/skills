+func TestETagOuterWrapperSeesFinalStatus(t *testing.T) {
+	outer := func(seen *int) func(http.Handler) http.Handler {
+		return func(next http.Handler) http.Handler {
+			return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				ww := NewWrapResponseWriter(w, r.ProtoMajor)
+				next.ServeHTTP(ww, r)
+				*seen = ww.Status()
+			})
+		}
+	}
+	h := func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("hello"))
+	}
+	etag := etagValue(t, ETag(http.HandlerFunc(h)))
+
+	var seen int
+	wrapped := outer(&seen)(ETag(http.HandlerFunc(h)))
+	req := httptest.NewRequest(http.MethodGet, "/", nil)
+	req.Header.Set("If-None-Match", etag)
+	wrapped.ServeHTTP(httptest.NewRecorder(), req)
+	if seen != http.StatusNotModified {
+		t.Fatalf("outer saw %d on match, want 304", seen)
+	}
+
+	wrapped.ServeHTTP(httptest.NewRecorder(), httptest.NewRequest(http.MethodGet, "/", nil))
+	if seen != http.StatusOK {
+		t.Fatalf("outer saw %d without match, want 200", seen)
+	}
+}
