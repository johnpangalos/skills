+func TestETagWrapperForwarding(t *testing.T) {
+	t.Run("hijack on real server writes only the handler bytes", func(t *testing.T) {
+		h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			conn, rw, err := w.(http.Hijacker).Hijack()
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			rw.WriteString("raw")
+			rw.Flush()
+			conn.Close()
+		}))
+		ts := httptest.NewServer(h)
+		defer ts.Close()
+		conn, err := net.Dial("tcp", ts.Listener.Addr().String())
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer conn.Close()
+		if _, err := conn.Write([]byte("GET / HTTP/1.1\r\nHost: test\r\nConnection: close\r\n\r\n")); err != nil {
+			t.Fatal(err)
+		}
+		raw, err := io.ReadAll(conn)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if string(raw) != "raw" {
+			t.Fatalf("client received %q, want only the handler's bytes", raw)
+		}
+	})
+
+	t.Run("hijack unavailable", func(t *testing.T) {
+		var err error
+		h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			_, _, err = w.(http.Hijacker).Hijack()
+		}))
+		h.ServeHTTP(httptest.NewRecorder(), httptest.NewRequest(http.MethodGet, "/", nil))
+		if err == nil || err.Error() != "chi/middleware: http.Hijacker is unavailable on the writer" {
+			t.Fatalf("err = %v", err)
+		}
+	})
+
+	t.Run("hijack error is forwarded", func(t *testing.T) {
+		sentinel := errors.New("sentinel")
+		var got error
+		h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			_, _, got = w.(http.Hijacker).Hijack()
+		}))
+		h.ServeHTTP(&etagHijacker{ResponseRecorder: httptest.NewRecorder(), err: sentinel}, httptest.NewRequest(http.MethodGet, "/", nil))
+		if got != sentinel {
+			t.Fatalf("err = %v, want the underlying error", got)
+		}
+	})
+
+	t.Run("successful hijack leaves the writer untouched", func(t *testing.T) {
+		w := &etagHijacker{ResponseRecorder: httptest.NewRecorder()}
+		h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Write([]byte("x"))
+			w.(http.Hijacker).Hijack()
+		}))
+		h.ServeHTTP(w, httptest.NewRequest(http.MethodGet, "/", nil))
+		if w.Body.Len() != 0 || len(w.Header()) != 0 {
+			t.Fatalf("writer got body %q and headers %v after hijack", w.Body.String(), w.Header())
+		}
+	})
+
+	t.Run("push forwards to the underlying writer", func(t *testing.T) {
+		p := &etagPusher{ResponseRecorder: httptest.NewRecorder()}
+		var err error
+		h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			err = w.(http.Pusher).Push("/style.css", nil)
+		}))
+		h.ServeHTTP(p, httptest.NewRequest(http.MethodGet, "/", nil))
+		if err != nil || p.target != "/style.css" {
+			t.Fatalf("err = %v, pushed %q", err, p.target)
+		}
+	})
+
+	t.Run("push unavailable", func(t *testing.T) {
+		var err error
+		h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			err = w.(http.Pusher).Push("/style.css", nil)
+		}))
+		h.ServeHTTP(httptest.NewRecorder(), httptest.NewRequest(http.MethodGet, "/", nil))
+		if err == nil || err.Error() != "chi/middleware: http.Pusher is unavailable on the writer" {
+			t.Fatalf("err = %v", err)
+		}
+	})
+
+	t.Run("unwrap returns the underlying writer", func(t *testing.T) {
+		rec := httptest.NewRecorder()
+		var got http.ResponseWriter
+		h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			got = w.(interface{ Unwrap() http.ResponseWriter }).Unwrap()
+		}))
+		h.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/", nil))
+		if got != http.ResponseWriter(rec) {
+			t.Fatalf("Unwrap returned %T, want the underlying writer", got)
+		}
+	})
+}
