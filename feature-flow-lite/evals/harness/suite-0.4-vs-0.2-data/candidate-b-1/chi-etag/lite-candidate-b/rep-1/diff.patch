+func TestETagDifferentialAgainstPlainHandler(t *testing.T) {
+	handlers := map[string]http.HandlerFunc{
+		"write only":   func(w http.ResponseWriter, r *http.Request) { w.Write([]byte("hello")) },
+		"explicit 200": func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(200); w.Write([]byte("hello")) },
+		"small writes": func(w http.ResponseWriter, r *http.Request) { w.Write([]byte("he")); w.Write([]byte("llo")) },
+		"sniffed html": func(w http.ResponseWriter, r *http.Request) { w.Write([]byte("<!DOCTYPE html><p>hi</p>")) },
+		"flush mid body": func(w http.ResponseWriter, r *http.Request) {
+			w.Write([]byte("he"))
+			w.(http.Flusher).Flush()
+			w.Write([]byte("llo"))
+		},
+		"header after write": func(w http.ResponseWriter, r *http.Request) { w.Write([]byte("hello")); w.Header().Set("X-Late", "1") },
+		"created":            func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(201); w.Write([]byte("made")) },
+		"not found":          func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(404); w.Write([]byte("missing")) },
+		"double WriteHeader": func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(202)
+			w.WriteHeader(500)
+			w.Write([]byte("x"))
+		},
+		"no write": func(w http.ResponseWriter, r *http.Request) {},
+		"handler ETag": func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("ETag", `W/"v1"`)
+			w.Write([]byte("hello"))
+		},
+	}
+	for name, h := range handlers {
+		t.Run(name, func(t *testing.T) {
+			plain := httptest.NewServer(h)
+			defer plain.Close()
+			wrapped := httptest.NewServer(ETag(h))
+			defer wrapped.Close()
+			client := etagClient(t)
+			// A handler that flushes is sent chunked by net/http; buffering lets
+			// the middleware send a Content-Length instead. That framing is the
+			// only header difference allowed for it.
+			var framing []string
+			if name == "flush mid body" {
+				framing = []string{"Content-Length"}
+			}
+
+			_, getBody := etagGet(t, client, plain.URL, http.MethodGet, nil)
+			for _, method := range []string{http.MethodGet, http.MethodHead, http.MethodPost} {
+				for _, hdr := range []http.Header{nil, {"If-None-Match": {"*"}}} {
+					for call := 0; call < 2; call++ {
+						pr, pb := etagGet(t, client, plain.URL, method, hdr)
+						wr, wb := etagGet(t, client, wrapped.URL, method, hdr)
+						ok := method == http.MethodGet || method == http.MethodHead
+						// Approved: a 200 GET/HEAD with a matching If-None-Match becomes 304.
+						notModified := hdr != nil && pr.StatusCode == http.StatusOK && ok
+						if notModified {
+							if wr.StatusCode != http.StatusNotModified || wb != "" {
+								t.Fatalf("%s call %d: got %d %q, want 304", method, call, wr.StatusCode, wb)
+							}
+							skip := []string{"Content-Type", "Content-Length", "Content-Encoding"}
+							if got, want := etagFormatHeaders(wr.Header, skip...), etagFormatHeaders(pr.Header, skip...); got != want {
+								t.Fatalf("%s call %d: 304 headers %s, want %s", method, call, got, want)
+							}
+						} else {
+							if wr.StatusCode != pr.StatusCode || (method == http.MethodGet && wb != pb) {
+								t.Fatalf("%s call %d: got %d %q, plain %d %q", method, call, wr.StatusCode, wb, pr.StatusCode, pb)
+							}
+							if got, want := etagFormatHeaders(wr.Header, framing...), etagFormatHeaders(pr.Header, framing...); got != want {
+								t.Fatalf("%s call %d: headers %s, want %s", method, call, got, want)
+							}
+						}
+						// Approved: a computed ETag is added on 200 GET, and on HEAD when bytes were written.
+						switch plainETag := pr.Header.Get("ETag"); {
+						case plainETag != "":
+							if got := wr.Header.Get("ETag"); got != plainETag {
+								t.Fatalf("%s call %d: ETag %q, handler set %q", method, call, got, plainETag)
+							}
+						case pr.StatusCode == http.StatusOK && ok && (method == http.MethodGet || getBody != ""):
+							if got := wr.Header.Get("ETag"); !etagStrong.MatchString(got) {
+								t.Fatalf("%s call %d: ETag %q is not a strong entity-tag", method, call, got)
+							}
+						default:
+							if vals := wr.Header.Values("ETag"); len(vals) != 0 {
+								t.Fatalf("%s call %d: unexpected ETag %q", method, call, vals)
+							}
+						}
+					}
+				}
+			}
+		})
+	}
+}
