+func TestETagOtherMethodsPassThrough(t *testing.T) {
+	for _, method := range []string{http.MethodPost, http.MethodPut, http.MethodPatch, http.MethodDelete, http.MethodOptions} {
+		t.Run(method, func(t *testing.T) {
+			early, resp, body := etagFlushProbe(t, method, http.Header{"If-None-Match": {"*"}}, func(w http.ResponseWriter) {
