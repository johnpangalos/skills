+			defer wrapped.Close()
+			request := "GET / HTTP/1.1\r\nHost: test\r\nConnection: close\r\n\r\n"
+			want := dateLine.ReplaceAllString(rawResponse(t, bare.Listener.Addr().String(), request), "")
+			got := dateLine.ReplaceAllString(rawResponse(t, wrapped.Listener.Addr().String(), request), "")
+			if got != want {
+				t.Fatalf("raw response = %q, want %q", got, want)
