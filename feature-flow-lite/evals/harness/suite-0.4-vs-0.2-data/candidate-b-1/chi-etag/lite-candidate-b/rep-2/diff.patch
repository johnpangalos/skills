+			hijackAndSend(t, w)
+		}},
+		{"Flush before any write", func(w http.ResponseWriter, r *http.Request) {
+			http.NewResponseController(w).Flush()
+			hijackAndSend(t, w)
+		}},
+		{"after WriteHeader, Write and Flush", func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(http.StatusOK)
+			w.Write([]byte("hello"))
+			http.NewResponseController(w).Flush()
+			hijackAndSend(t, w)
+		}},
