+func TestETagFlush(t *testing.T) {
+	tests := []struct {
+		name        string
+		steps       func(w http.ResponseWriter)
+		wantSeen    string // what the recorder held before the handler returned
+		wantFlushed bool
+	}{
+		{"200 flush before write holds bytes", func(w http.ResponseWriter) {
+			http.NewResponseController(w).Flush()
+			w.Write([]byte("hello"))
+			http.NewResponseController(w).Flush()
+		}, "", false},
+		{"200 write then flush holds bytes", func(w http.ResponseWriter) {
+			w.Write([]byte("hello"))
+			http.NewResponseController(w).Flush()
+		}, "", false},
+		{"201 write then flush goes through", func(w http.ResponseWriter) {
+			w.WriteHeader(http.StatusCreated)
+			w.Write([]byte("hello"))
+			http.NewResponseController(w).Flush()
+		}, "hello", true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			rec := httptest.NewRecorder()
+			var seen string
+			var flushed bool
+			h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				tt.steps(w)
+				seen = rec.Body.String()
+				flushed = rec.Flushed
+			})
+			ETag(h).ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/", nil))
+			if seen != tt.wantSeen {
+				t.Fatalf("recorder held %q before return, want %q", seen, tt.wantSeen)
+			}
+			if flushed != tt.wantFlushed {
+				t.Fatalf("recorder flushed = %v, want %v", flushed, tt.wantFlushed)
+			}
+			if rec.Body.String() != "hello" {
+				t.Fatalf("final body = %q, want %q", rec.Body.String(), "hello")
+			}
+		})
+	}
