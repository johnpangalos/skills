diff --git a/middleware/etag.go b/middleware/etag.go
new file mode 100644
index 0000000..ffc0344
--- /dev/null
+++ b/middleware/etag.go
@@ -0,0 +1,292 @@
+package middleware
+
+import (
+	"bufio"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"maps"
+	"net"
+	"net/http"
+	"strings"
+)
+
+// ETag adds a strong ETag to GET and HEAD responses that have status 200 and no
+// ETag of their own, and answers 304 Not Modified when If-None-Match matches it.
+//
+// The response is buffered until the handler returns so the ETag can be computed
+// from the body. Until then, Flush sends nothing to the client. The ETag is the
+// hex SHA-256 digest of the body, quoted. On HEAD, a body-derived ETag is only
+// set when the handler wrote a body, so an empty HEAD response never gets one.
+// If-None-Match uses the weak comparison from RFC 9110 §13.1.2 and also accepts
+// "*". Matching responses are sent as 304 with no body. Responses with any other
+// status, and all other methods, pass through unchanged.
+func ETag(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet && r.Method != http.MethodHead {
+			next.ServeHTTP(w, r)
+			return
+		}
+		ew := &etagResponseWriter{ResponseWriter: w, req: r}
+		next.ServeHTTP(ew, r)
+		ew.finish()
+	})
+}
+
+type etagResponseWriter struct {
+	http.ResponseWriter
+	req *http.Request
+
+	// header is the snapshot of the handler's headers taken when status 200 was
+	// written, so later header changes are not sent, as in net/http.
+	header      http.Header
+	body        []byte
+	wroteHeader bool
+	// passthrough is set once a non-200 final status is written. Writes and
+	// Flush then go straight to the underlying writer.
+	passthrough bool
+	// flushed is set when the handler calls Flush while the 200 is buffered.
+	flushed  bool
+	hijacked bool
+}
+
+func (cw *etagResponseWriter) WriteHeader(code int) {
+	if code >= 100 && code <= 199 && code != http.StatusSwitchingProtocols {
+		// Informational responses are sent now and do not set the final status.
+		cw.ResponseWriter.WriteHeader(code)
+		return
+	}
+	if cw.wroteHeader {
+		if cw.passthrough {
+			cw.ResponseWriter.WriteHeader(code) // Let net/http report the superfluous call.
+		}
+		return
+	}
+	cw.wroteHeader = true
+	if code != http.StatusOK {
+		cw.passthrough = true
+		cw.ResponseWriter.WriteHeader(code)
+		return
+	}
+	cw.header = cw.ResponseWriter.Header().Clone()
+}
+
+func (cw *etagResponseWriter) Write(p []byte) (int, error) {
+	if cw.hijacked {
+		return 0, http.ErrHijacked
+	}
+	if !cw.wroteHeader {
+		cw.WriteHeader(http.StatusOK)
+	}
+	if cw.passthrough {
+		return cw.ResponseWriter.Write(p)
+	}
+	cw.body = append(cw.body, p...)
+	return len(p), nil
+}
+
+func (cw *etagResponseWriter) Flush() {
+	if !cw.wroteHeader {
+		cw.WriteHeader(http.StatusOK)
+	}
+	if !cw.passthrough {
+		cw.flushed = true
+		return // A buffered 200 is held until the handler returns.
+	}
+	if f, ok := cw.ResponseWriter.(http.Flusher); ok {
+		f.Flush()
+	}
+}
+
+func (cw *etagResponseWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	hj, ok := cw.ResponseWriter.(http.Hijacker)
+	if !ok {
+		return nil, nil, errors.New("chi/middleware: http.Hijacker is unavailable on the writer")
+	}
+	if cw.wroteHeader && !cw.passthrough {
+		// Send the buffered 200 as the handler wrote it, as the bare handler would.
+		cw.sendBuffered()
+		cw.passthrough = true
+	}
+	conn, rw, err := hj.Hijack()
+	if err == nil {
+		cw.hijacked = true
+	}
+	return conn, rw, err
+}
+
+func (cw *etagResponseWriter) Push(target string, opts *http.PushOptions) error {
+	if ps, ok := cw.ResponseWriter.(http.Pusher); ok {
+		return ps.Push(target, opts)
+	}
+	return errors.New("chi/middleware: http.Pusher is unavailable on the writer")
+}
+
+func (cw *etagResponseWriter) Unwrap() http.ResponseWriter {
+	return cw.ResponseWriter
+}
+
+// finish sends the buffered 200 response, adding the ETag and answering 304 when
+// If-None-Match matches.
+func (cw *etagResponseWriter) finish() {
+	if cw.passthrough || cw.hijacked {
+		return
+	}
+	if !cw.wroteHeader {
+		cw.WriteHeader(http.StatusOK)
+	}
+	trailers := cw.restoreHeader()
+
+	h := cw.ResponseWriter.Header()
+	if h.Get("ETag") == "" && (cw.req.Method == http.MethodGet || len(cw.body) > 0) {
+		sum := sha256.Sum256(cw.body)
+		h.Set("ETag", `"`+hex.EncodeToString(sum[:])+`"`)
+	}
+
+	if ifNoneMatchMatches(cw.req.Header.Values("If-None-Match"), h.Get("ETag")) {
+		h.Del("Content-Type")
+		h.Del("Content-Length")
+		h.Del("Content-Encoding")
+		h.Del("Transfer-Encoding")
+		cw.ResponseWriter.WriteHeader(http.StatusNotModified)
+		maps.Copy(h, trailers)
+		return
+	}
+
+	cw.ResponseWriter.WriteHeader(http.StatusOK)
+	maps.Copy(h, trailers)
+	cw.ResponseWriter.Write(cw.body) // net/http drops the body of a HEAD response.
+}
+
+// sendBuffered sends the buffered 200 response as the handler wrote it, with no
+// ETag and no 304 handling. If the handler flushed, it flushes too. Otherwise the
+// body stays unsent, as in net/http, whose Hijack does not flush the response body.
+func (cw *etagResponseWriter) sendBuffered() {
+	trailers := cw.restoreHeader()
+	cw.ResponseWriter.WriteHeader(http.StatusOK)
+	maps.Copy(cw.ResponseWriter.Header(), trailers)
+	cw.ResponseWriter.Write(cw.body)
+	if f, ok := cw.ResponseWriter.(http.Flusher); ok && cw.flushed {
+		f.Flush()
+	}
+}
+
+// restoreHeader replaces the handler's headers with the snapshot taken when status
+// 200 was written, and returns the trailers set since then. net/http reads the
+// headers when the status is written, so the caller copies the trailers back only
+// after that, where net/http reads them when the response ends.
+func (cw *etagResponseWriter) restoreHeader() http.Header {
+	h := cw.ResponseWriter.Header()
+	trailers := make(http.Header)
+	for k, v := range h {
+		if strings.HasPrefix(k, http.TrailerPrefix) {
+			trailers[k] = v
+		}
+	}
+	for _, line := range cw.header.Values("Trailer") {
+		for _, name := range strings.Split(line, ",") {
+			key := http.CanonicalHeaderKey(strings.TrimSpace(name))
+			if v, ok := h[key]; ok {
+				trailers[key] = v
+			}
+		}
+	}
+	clear(h)
+	maps.Copy(h, cw.header)
+	return trailers
+}
+
+// ifNoneMatchMatches reports whether any member of the If-None-Match header lines
+// matches etag by weak comparison (RFC 9110 §8.8.3.2). A "*" member matches any
+// current representation. An empty etag matches only "*".
+func ifNoneMatchMatches(lines []string, etag string) bool {
+	current, ok := parseETag(etag)
+	for _, line := range lines {
+		for _, member := range etagListMembers(line) {
+			if member == "*" {
+				return true
+			}
+			if tag, valid := parseETag(member); ok && valid && tag == current {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// etagListMembers returns the valid members of an If-None-Match line, as written.
+// Commas and optional whitespace separate members. Malformed members are dropped.
+func etagListMembers(line string) []string {
+	var members []string
+	rest := line
+	for {
+		rest = strings.TrimLeft(rest, " \t,")
+		if rest == "" {
+			return members
+		}
+		var member string
+		var ok bool
+		member, rest, ok = scanETagMember(rest)
+		if ok {
+			members = append(members, member)
+		}
+	}
+}
+
+// scanETagMember reads the If-None-Match member at the start of s, which begins
+// with neither whitespace nor a comma. It returns the member, the text after it,
+// and whether the member is valid. A malformed member is skipped up to the next
+// comma. A malformed quoted member is skipped up to the first comma after its
+// opening quote, so a quote without a closing quote cannot hide the members after it.
+func scanETagMember(s string) (string, string, bool) {
+	quoted := strings.TrimPrefix(s, "W/")
+	if strings.HasPrefix(quoted, `"`) {
+		if i := strings.IndexByte(quoted[1:], '"'); i >= 0 {
+			if rest, ok := afterETagMember(quoted[i+2:]); ok {
+				return s[:len(s)-len(quoted)+i+2], rest, true
+			}
+		}
+		return "", afterComma(quoted), false
+	}
+	if s[0] == '*' {
+		if rest, ok := afterETagMember(s[1:]); ok {
+			return "*", rest, true
+		}
+	}
+	return "", afterComma(s), false
+}
+
+// afterETagMember checks that tail, the text after a member, is empty or starts with
+// a comma after optional whitespace. It returns the text after that comma.
+func afterETagMember(tail string) (string, bool) {
+	tail = strings.TrimLeft(tail, " \t")
+	if tail == "" {
+		return "", true
+	}
+	if tail[0] == ',' {
+		return tail[1:], true
+	}
+	return "", false
+}
+
+// afterComma returns the text after the first comma in s, or "" if s has no comma.
+func afterComma(s string) string {
+	if i := strings.IndexByte(s, ','); i >= 0 {
+		return s[i+1:]
+	}
+	return ""
+}
+
+// parseETag returns the opaque-tag of an entity-tag, with any weak prefix removed.
+// The weak prefix is case-sensitive. The bool is false if s is not an entity-tag.
+func parseETag(s string) (string, bool) {
+	s = strings.TrimPrefix(s, "W/")
+	if len(s) < 2 || s[0] != '"' || s[len(s)-1] != '"' {
+		return "", false
+	}
+	opaque := s[1 : len(s)-1]
+	if strings.Contains(opaque, `"`) {
+		return "", false
+	}
+	return opaque, true
+}
diff --git a/middleware/etag_test.go b/middleware/etag_test.go
new file mode 100644
index 0000000..363b73f
--- /dev/null
+++ b/middleware/etag_test.go
@@ -0,0 +1,928 @@
+package middleware
+
+import (
+	"bufio"
+	"context"
+	"errors"
+	"io"
+	"maps"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/http/httptrace"
+	"net/textproto"
+	"regexp"
+	"slices"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+)
+
+var strongETag = regexp.MustCompile(`^"[0-9a-f]+"$`)
+
+func etagBody(body string) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte(body))
+	})
+}
+
+// serveETag runs ETag around h, sending each ifNoneMatch value as its own header line.
+func serveETag(h http.Handler, method string, ifNoneMatch ...string) *httptest.ResponseRecorder {
+	req := httptest.NewRequest(method, "/", nil)
+	for _, v := range ifNoneMatch {
+		req.Header.Add("If-None-Match", v)
+	}
+	rec := httptest.NewRecorder()
+	ETag(h).ServeHTTP(rec, req)
+	return rec
+}
+
+func TestETagSignature(t *testing.T) {
+	var mw func(http.Handler) http.Handler = ETag
+	rec := httptest.NewRecorder()
+	mw(etagBody("hello")).ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/", nil))
+	if rec.Header().Get("ETag") == "" {
+		t.Fatalf("ETag header missing, want a strong ETag added by the middleware")
+	}
+}
+
+func TestETagStrongValidator(t *testing.T) {
+	tests := []struct {
+		name    string
+		handler http.Handler
+	}{
+		{"explicit WriteHeader(200)", http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(http.StatusOK)
+			w.Write([]byte("hello"))
+		})},
+		{"implicit 200 from Write", etagBody("hello")},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			rec := serveETag(tt.handler, http.MethodGet)
+			if rec.Code != http.StatusOK {
+				t.Fatalf("status = %d, want 200", rec.Code)
+			}
+			if got := rec.Body.String(); got != "hello" {
+				t.Fatalf("body = %q, want %q", got, "hello")
+			}
+			if etag := rec.Header().Get("ETag"); !strongETag.MatchString(etag) {
+				t.Fatalf("ETag = %q, want a strong quoted hex digest", etag)
+			}
+		})
+	}
+}
+
+func TestETagFollowsBody(t *testing.T) {
+	alpha := serveETag(etagBody("alpha"), http.MethodGet).Header().Get("ETag")
+	again := serveETag(etagBody("alpha"), http.MethodGet).Header().Get("ETag")
+	beta := serveETag(etagBody("beta"), http.MethodGet).Header().Get("ETag")
+	chunked := serveETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("al"))
+		w.Write([]byte("pha"))
+	}), http.MethodGet).Header().Get("ETag")
+	if alpha == "" || alpha != again {
+		t.Fatalf("same body gave ETags %q and %q, want equal", alpha, again)
+	}
+	if chunked != alpha {
+		t.Fatalf("ETag over two writes = %q, want %q from one write", chunked, alpha)
+	}
+	if beta == alpha {
+		t.Fatalf("different bodies share ETag %q", beta)
+	}
+}
+
+func TestETagHostileBodies(t *testing.T) {
+	tests := []struct {
+		name    string
+		handler http.Handler
+		body    string
+	}{
+		{"empty body", etagBody(""), ""},
+		{"1000 one-byte writes", http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			for i := 0; i < 1000; i++ {
+				w.Write([]byte("x"))
+			}
+		}), strings.Repeat("x", 1000)},
+		{"no Write or WriteHeader", http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}), ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			rec := serveETag(tt.handler, http.MethodGet)
+			if rec.Code != http.StatusOK {
+				t.Fatalf("status = %d, want 200", rec.Code)
+			}
+			if got := rec.Body.String(); got != tt.body {
+				t.Fatalf("body length = %d, want %d", len(got), len(tt.body))
+			}
+			etag := rec.Header().Get("ETag")
+			if !strongETag.MatchString(etag) {
+				t.Fatalf("ETag = %q, want a strong quoted hex digest", etag)
+			}
+			if want := serveETag(etagBody(tt.body), http.MethodGet).Header().Get("ETag"); etag != want {
+				t.Fatalf("ETag = %q, want %q (same bytes in one Write)", etag, want)
+			}
+		})
+	}
+}
+
+func TestETagHead(t *testing.T) {
+	t.Run("empty body gets no ETag", func(t *testing.T) {
+		rec := serveETag(etagBody(""), http.MethodHead)
+		if rec.Code != http.StatusOK {
+			t.Fatalf("status = %d, want 200", rec.Code)
+		}
+		if etag := rec.Header().Get("ETag"); etag != "" {
+			t.Fatalf("ETag = %q on empty HEAD body, want none", etag)
+		}
+	})
+
+	t.Run("body gets the GET ETag and sends no body", func(t *testing.T) {
+		get := serveETag(etagBody("hello"), http.MethodGet).Header().Get("ETag")
+		srv := httptest.NewServer(ETag(etagBody("hello")))
+		defer srv.Close()
+		raw := rawResponse(t, srv.Listener.Addr().String(), "HEAD / HTTP/1.1\r\nHost: test\r\nConnection: close\r\n\r\n")
+		br := bufio.NewReader(strings.NewReader(raw))
+		resp, err := http.ReadResponse(br, httptest.NewRequest(http.MethodHead, "/", nil))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if etag := resp.Header.Get("ETag"); etag != get {
+			t.Fatalf("HEAD ETag = %q, want GET ETag %q", etag, get)
+		}
+		if cl := resp.Header.Get("Content-Length"); cl != "5" {
+			t.Fatalf("Content-Length = %q, want 5", cl)
+		}
+		if rest, _ := io.ReadAll(br); len(rest) != 0 {
+			t.Fatalf("HEAD sent %q after the headers, want no body bytes", rest)
+		}
+	})
+
+	t.Run("handler Content-Length is kept", func(t *testing.T) {
+		h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Content-Length", "42")
+			w.Write([]byte("hello"))
+		})
+		rec := serveETag(h, http.MethodHead)
+		if cl := rec.Header().Get("Content-Length"); cl != "42" {
+			t.Fatalf("Content-Length = %q, want handler value 42", cl)
+		}
+	})
+}
+
+func TestETagKeepsHandlerValidator(t *testing.T) {
+	for _, etag := range []string{`"v1"`, `W/"v1"`} {
+		t.Run(etag, func(t *testing.T) {
+			withBody := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("ETag", etag)
+				w.Write([]byte("hello"))
+			})
+			empty := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("ETag", etag)
+			})
+			if got := serveETag(withBody, http.MethodGet).Header().Get("ETag"); got != etag {
+				t.Fatalf("GET ETag = %q, want handler value %q", got, etag)
+			}
+			if got := serveETag(empty, http.MethodHead).Header().Get("ETag"); got != etag {
+				t.Fatalf("empty HEAD ETag = %q, want handler value %q", got, etag)
+			}
+		})
+	}
+}
+
+func TestETagIfNoneMatch(t *testing.T) {
+	tests := []struct {
+		name string
+		etag string // validator the handler sets
+		inm  []string
+		want int
+	}{
+		{"strong match", `"v1"`, []string{`"v1"`}, http.StatusNotModified},
+		{"weak request matches strong", `"v1"`, []string{`W/"v1"`}, http.StatusNotModified},
+		{"strong request matches weak", `W/"v1"`, []string{`"v1"`}, http.StatusNotModified},
+		{"weak matches weak", `W/"v1"`, []string{`W/"v1"`}, http.StatusNotModified},
+		{"list with spaces and tabs", `"v1"`, []string{" \"x\" ,\t\"v1\"  "}, http.StatusNotModified},
+		{"multiple header lines", `"v1"`, []string{`"x"`, `"v1"`}, http.StatusNotModified},
+		{"star matches", `"v1"`, []string{`*`}, http.StatusNotModified},
+		{"no match", `"v1"`, []string{`"x"`}, http.StatusOK},
+		{"quoted comma stays in one tag", `"a,b"`, []string{`"a,b"`}, http.StatusNotModified},
+		{"comma inside a tag does not split", `"a,b"`, []string{`"a", "b"`}, http.StatusOK},
+		{"junk members skipped", `"v1"`, []string{`junk, ,, W/junk, "v1"`}, http.StatusNotModified},
+		{"unterminated member skipped", `"v1"`, []string{`"v1", "unterminated`}, http.StatusNotModified},
+		{"unterminated alone", `"v1"`, []string{`"unterminated`}, http.StatusOK},
+		{"junk alone", `"v1"`, []string{`junk`}, http.StatusOK},
+		{"empty members", `"v1"`, []string{`,,`}, http.StatusOK},
+		{"empty header", `"v1"`, []string{""}, http.StatusOK},
+		{"empty opaque tag does not match", `"v1"`, []string{`""`}, http.StatusOK},
+		{"opaque tags are case sensitive", `"abc"`, []string{`"ABC"`}, http.StatusOK},
+		{"lowercase w is not a weak prefix", `"v1"`, []string{`w/"v1"`}, http.StatusOK},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("ETag", tt.etag)
+				w.Write([]byte("hello"))
+			})
+			rec := serveETag(h, http.MethodGet, tt.inm...)
+			if rec.Code != tt.want {
+				t.Fatalf("status = %d, want %d", rec.Code, tt.want)
+			}
+			body := rec.Body.String()
+			if tt.want == http.StatusNotModified && body != "" {
+				t.Fatalf("304 body = %q, want empty", body)
+			}
+			if tt.want == http.StatusOK && body != "hello" {
+				t.Fatalf("200 body = %q, want %q", body, "hello")
+			}
+		})
+	}
+}
+
+func TestETagNotModifiedHeaders(t *testing.T) {
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "text/plain")
+		w.Header().Set("Content-Length", "5")
+		w.Header().Set("Content-Encoding", "identity")
+		w.Header().Set("Transfer-Encoding", "identity")
+		w.Header().Set("Cache-Control", "max-age=60")
+		w.Header().Add("Vary", "Accept")
+		w.Write([]byte("hello"))
+	})
+	etag := serveETag(h, http.MethodGet).Header().Get("ETag")
+	rec := serveETag(h, http.MethodGet, etag)
+	if rec.Code != http.StatusNotModified {
+		t.Fatalf("status = %d, want 304", rec.Code)
+	}
+	if rec.Body.Len() != 0 {
+		t.Fatalf("304 body = %q, want empty", rec.Body.String())
+	}
+	header := rec.Result().Header
+	if got := header.Get("ETag"); got != etag {
+		t.Fatalf("ETag = %q, want %q kept", got, etag)
+	}
+	for _, key := range []string{"Content-Type", "Content-Length", "Content-Encoding", "Transfer-Encoding"} {
+		if v := header.Values(key); len(v) != 0 {
+			t.Fatalf("%s = %q on 304, want removed", key, v)
+		}
+	}
+	if got := header.Get("Cache-Control"); got != "max-age=60" {
+		t.Fatalf("Cache-Control = %q, want kept", got)
+	}
+	if got := header.Get("Vary"); got != "Accept" {
+		t.Fatalf("Vary = %q, want kept", got)
+	}
+}
