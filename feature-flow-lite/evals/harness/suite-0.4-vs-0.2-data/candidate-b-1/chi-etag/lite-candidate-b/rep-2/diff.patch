+func TestETagInformationalResponse(t *testing.T) {
+	forwarded := make(chan struct{})
+	srv := httptest.NewServer(ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Link", "</style.css>; rel=preload")
+		w.WriteHeader(http.StatusEarlyHints)
+		body := "late"
+		select {
+		case <-forwarded:
+			body = "hello"
+		case <-time.After(5 * time.Second):
+		}
+		w.Write([]byte(body))
+	})))
+	defer srv.Close()
+
+	var codes []int
+	trace := &httptrace.ClientTrace{
+		Got1xxResponse: func(code int, _ textproto.MIMEHeader) error {
+			codes = append(codes, code)
+			close(forwarded)
+			return nil
+		},
+	}
+	req, err := http.NewRequestWithContext(httptrace.WithClientTrace(context.Background(), trace), http.MethodGet, srv.URL, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp, err := http.DefaultClient.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(resp.Body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !slices.Equal(codes, []int{http.StatusEarlyHints}) {
+		t.Fatalf("informational codes = %v, want [103] forwarded immediately", codes)
+	}
+	if resp.StatusCode != http.StatusOK {
+		t.Fatalf("final status = %d, want 200", resp.StatusCode)
+	}
+	if string(body) != "hello" {
+		t.Fatalf("body = %q, want %q (103 was not forwarded before the handler wrote)", body, "hello")
+	}
+	want := serveETag(etagBody("hello"), http.MethodGet).Header().Get("ETag")
+	if !strongETag.MatchString(want) {
+		t.Fatalf("reference ETag = %q, want a strong quoted hex digest", want)
+	}
+	if got := resp.Header.Get("ETag"); got != want {
+		t.Fatalf("ETag = %q, want %q", got, want)
+	}
+}
