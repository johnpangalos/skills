+			w.Header().Set("X-Sum", "abc")
+		}, "X-Sum", "abc"},
+		{"Trailer prefix set after the body", func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Trailer", "X-Late")
+			w.Write([]byte("hello"))
+			w.Header()[http.TrailerPrefix+"X-Late"] = []string{"late"}
+		}, "X-Late", "late"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			bare := httptest.NewServer(tt.handler)
+			defer bare.Close()
+			wrapped := httptest.NewServer(ETag(tt.handler))
+			defer wrapped.Close()
+			if got := trailerValue(t, bare.URL, tt.trailer); got != tt.value {
+				t.Fatalf("bare trailer %s = %q, want %q", tt.trailer, got, tt.value)
+			}
+			if got := trailerValue(t, wrapped.URL, tt.trailer); got != tt.value {
+				t.Fatalf("wrapped trailer %s = %q, want %q", tt.trailer, got, tt.value)
+			}
+		})
+	}
+}
+
+// TestETagTrailerPrefixAfterShortBody compares the raw bytes of a short body whose trailer is
+// set with the TrailerPrefix after the body. The bare handler sends Content-Length and drops
+// the trailer, and the wrapped handler must do the same.
+func TestETagTrailerPrefixAfterShortBody(t *testing.T) {
+	handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("hello"))
+		w.Header()[http.TrailerPrefix+"X-Pfx2"] = []string{"p2"}
+	})
+	bare := httptest.NewServer(handler)
+	defer bare.Close()
+	wrapped := httptest.NewServer(ETag(handler))
+	defer wrapped.Close()
+	request := "GET / HTTP/1.1\r\nHost: test\r\nConnection: close\r\n\r\n"
+	dateAndETag := regexp.MustCompile(`(?im)^(Date|ETag): .*\r\n`)
+	want := dateAndETag.ReplaceAllString(rawResponse(t, bare.Listener.Addr().String(), request), "")
+	got := dateAndETag.ReplaceAllString(rawResponse(t, wrapped.Listener.Addr().String(), request), "")
+	if !strings.Contains(want, "Content-Length: 5\r\n") {
+		t.Fatalf("bare response = %q, want Content-Length: 5 framing", want)
+	}
+	if got != want {
+		t.Fatalf("raw response = %q, want %q", got, want)
+	}
+}
+
+// TestETagDifferential compares the wrapped handler with the bare one over a real server.
+// The only expected difference is the added ETag header.
+func TestETagDifferential(t *testing.T) {
+	tests := []struct {
+		name    string
+		handler http.HandlerFunc
+	}{
+		{"write only", func(w http.ResponseWriter, r *http.Request) {
+			w.Write([]byte("hello"))
+		}},
+		{"large body", func(w http.ResponseWriter, r *http.Request) {
+			w.Write([]byte(strings.Repeat("x", 5000)))
+		}},
+		{"explicit 200 and headers", func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Content-Type", "text/plain; charset=utf-8")
+			w.Header().Set("Cache-Control", "no-cache")
+			w.WriteHeader(http.StatusOK)
+			w.Write([]byte("hello"))
+		}},
+		{"headers after WriteHeader", func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("X-Test", "before")
+			w.WriteHeader(http.StatusOK)
+			w.Header().Set("X-Test", "after")
+			w.Write([]byte("hello"))
+		}},
+		{"second WriteHeader ignored", func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(http.StatusOK)
+			w.WriteHeader(http.StatusInternalServerError)
+			w.Write([]byte("hello"))
+		}},
+		{"empty", func(w http.ResponseWriter, r *http.Request) {}},
+		{"created", func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(http.StatusCreated)
+			w.Write([]byte("hello"))
+		}},
+		{"not found", func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(http.StatusNotFound)
+			w.Write([]byte("hello"))
+		}},
+	}
+	for _, tt := range tests {
+		plain := httptest.NewServer(tt.handler)
+		defer plain.Close()
+		wrapped := httptest.NewServer(ETag(tt.handler))
+		defer wrapped.Close()
+		for _, method := range []string{http.MethodGet, http.MethodHead, http.MethodPost} {
+			t.Run(tt.name+" "+method, func(t *testing.T) {
+				want := fetchETag(t, plain.URL, method)
+				got := fetchETag(t, wrapped.URL, method)
+				if got.code != want.code {
+					t.Fatalf("status = %d, want %d", got.code, want.code)
+				}
+				if got.body != want.body {
+					t.Fatalf("body = %q, want %q", got.body, want.body)
+				}
+				if !maps.EqualFunc(got.header, want.header, slices.Equal) {
+					t.Fatalf("headers = %v, want %v", got.header, want.header)
+				}
+			})
+		}
+	}
+}
