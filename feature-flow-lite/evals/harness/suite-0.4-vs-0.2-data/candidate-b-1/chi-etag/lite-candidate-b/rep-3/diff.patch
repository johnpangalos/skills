+// etagSignalDone returns h, closing done once h has returned.
+func etagSignalDone(h http.Handler, done chan<- struct{}) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		defer close(done)
+		h.ServeHTTP(w, r)
+	})
+}
+
+// etagRawHijack serves h on a real connection and sends a raw GET. It returns
+// what the server wrote to the connection, without the Date header, and what it
+// logged. h must close done when it has returned.
+func etagRawHijack(t *testing.T, h http.Handler, done <-chan struct{}) (string, string) {
+	t.Helper()
+	var logs bytes.Buffer
+	ts := httptest.NewUnstartedServer(h)
+	ts.Config.ErrorLog = log.New(&logs, "", 0)
+	ts.Start()
+	t.Cleanup(ts.Close)
+
+	conn, err := net.Dial("tcp", ts.Listener.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	conn.SetDeadline(time.Now().Add(5 * time.Second))
+	if _, err := io.WriteString(conn, "GET / HTTP/1.1\r\nHost: example.com\r\n\r\n"); err != nil {
+		t.Fatal(err)
+	}
+	out, err := io.ReadAll(conn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	<-done
+	return regexp.MustCompile(`(?m)^Date: .*\r\n`).ReplaceAllString(string(out), ""), logs.String()
+}
