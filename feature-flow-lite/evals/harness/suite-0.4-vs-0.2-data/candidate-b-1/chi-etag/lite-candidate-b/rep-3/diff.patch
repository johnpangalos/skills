diff --git a/middleware/etag.go b/middleware/etag.go
new file mode 100644
index 0000000..107391e
--- /dev/null
+++ b/middleware/etag.go
@@ -0,0 +1,232 @@
+package middleware
+
+import (
+	"bufio"
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"net"
+	"net/http"
+	"sort"
+	"strings"
+)
+
+// ETag sets a strong ETag on GET and HEAD responses and answers requests whose
+// If-None-Match header matches it with 304 Not Modified.
+//
+// The response is buffered until the handler returns, so the ETag covers the
+// whole body. A 200 response with no ETag set by the handler gets one: a strong
+// tag made from the hex-encoded SHA-256 of the body. An ETag the handler set is
+// left as it is. If If-None-Match matches the response's ETag (weak comparison;
+// "*" matches any ETag), the response becomes a 304 with no body, and
+// Content-Type, Content-Length and Content-Encoding are removed.
+//
+// A HEAD response with no body and no ETag set by the handler gets no ETag.
+// Other methods pass straight through. So does any response once a status other
+// than 200 is set: from then on writes and Flush reach the client directly.
+//
+// With Compress, mount ETag outside it: r.Use(middleware.ETag) before
+// r.Use(middleware.Compress(...)). The computed tag then covers the encoded
+// bytes, so the gzip and identity representations get different tags, as RFC
+// 9110 section 8.8.3 requires. Mounted inside Compress, both would share a tag.
+func ETag(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet && r.Method != http.MethodHead {
+			next.ServeHTTP(w, r)
+			return
+		}
+		ew := &etagResponseWriter{ResponseWriter: w, head: r.Method == http.MethodHead}
+		next.ServeHTTP(ew, r)
+		ew.finish(r.Header)
+	})
+}
+
+type etagResponseWriter struct {
+	http.ResponseWriter
+
+	head        bool // the request method is HEAD
+	wroteHeader bool // the final status has been set
+	status      int  // the final status, once wroteHeader is set
+	streaming   bool // writes go straight through: the final status is not 200, or the connection was hijacked
+	buf         bytes.Buffer
+}
+
+func (ew *etagResponseWriter) WriteHeader(code int) {
+	// 1xx informational responses go out now and do not set the final status.
+	if code >= 100 && code <= 199 && code != http.StatusSwitchingProtocols {
+		ew.ResponseWriter.WriteHeader(code)
+		return
+	}
+	if !ew.wroteHeader {
+		ew.wroteHeader = true
+		ew.status = code
+		ew.streaming = code != http.StatusOK
+	}
+	// Once the status is fixed as non-200, later calls go to the underlying
+	// writer, which logs them as superfluous.
+	if ew.streaming {
+		ew.ResponseWriter.WriteHeader(code)
+	}
+}
+
+func (ew *etagResponseWriter) Write(p []byte) (int, error) {
+	if !ew.wroteHeader {
+		ew.WriteHeader(http.StatusOK)
+	}
+	if ew.streaming {
+		return ew.ResponseWriter.Write(p)
+	}
+	return ew.buf.Write(p)
+}
+
+// Flush sends the response so far only when it is streaming. A buffered
+// response is sent when the handler returns.
+func (ew *etagResponseWriter) Flush() {
+	if !ew.streaming {
+		return
+	}
+	if f, ok := ew.ResponseWriter.(http.Flusher); ok {
+		f.Flush()
+	}
+}
+
+// Hijack sends what the handler has written so far, as net/http would, and then
+// hands the connection over. Nothing is sent after that.
+func (ew *etagResponseWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	hj, ok := ew.ResponseWriter.(http.Hijacker)
+	if !ok {
+		return nil, nil, errors.New("chi/middleware: http.Hijacker is unavailable on the writer")
+	}
+	if ew.wroteHeader && !ew.streaming {
+		ew.ResponseWriter.WriteHeader(ew.status)
+		ew.ResponseWriter.Write(ew.buf.Bytes())
+	}
+	// Set before hijacking, so finish does nothing and a later WriteHeader does
+	// not start a new buffered response, even if the hijack fails.
+	ew.wroteHeader = true
+	ew.streaming = true
+	return hj.Hijack()
+}
+
+func (ew *etagResponseWriter) Push(target string, opts *http.PushOptions) error {
+	if ps, ok := ew.ResponseWriter.(http.Pusher); ok {
+		return ps.Push(target, opts)
+	}
+	return errors.New("chi/middleware: http.Pusher is unavailable on the writer")
+}
+
+func (ew *etagResponseWriter) Unwrap() http.ResponseWriter {
+	return ew.ResponseWriter
+}
+
+// finish sends the buffered response once the handler has returned.
+func (ew *etagResponseWriter) finish(reqHeader http.Header) {
+	if ew.streaming {
+		return
+	}
+	h := ew.Header()
+	body := ew.buf.Bytes()
+	etag, set := handlerETag(h)
+	// A HEAD response with no body says nothing about the resource, so it
+	// gets no computed ETag.
+	if !set && (!ew.head || len(body) > 0) {
+		sum := sha256.Sum256(body)
+		etag = `"` + hex.EncodeToString(sum[:]) + `"`
+		h.Set("ETag", etag)
+	}
+	if etag != "" && ifNoneMatch(reqHeader, etag) {
+		h.Del("Content-Type")
+		h.Del("Content-Length")
+		h.Del("Content-Encoding")
+		ew.ResponseWriter.WriteHeader(http.StatusNotModified)
+		return
+	}
+	ew.ResponseWriter.WriteHeader(http.StatusOK)
+	ew.ResponseWriter.Write(body)
+}
+
+// handlerETag returns the ETag the handler set and whether it set one. The header
+// map may hold the ETag under any letter case of the name, such as "etag" or
+// "ETAG", so every key that equals "Etag" under strings.EqualFold counts. If
+// there is more than one, "Etag" wins, then "ETag", then the rest in sorted order.
+func handlerETag(h http.Header) (string, bool) {
+	for _, key := range []string{"Etag", "ETag"} {
+		if v := h[key]; len(v) > 0 {
+			return v[0], true
+		}
+	}
+	var keys []string
+	for key, v := range h {
+		if len(v) > 0 && strings.EqualFold(key, "Etag") {
+			keys = append(keys, key)
+		}
+	}
+	if len(keys) == 0 {
+		return "", false
+	}
+	sort.Strings(keys)
+	return h[keys[0]][0], true
+}
+
+// ifNoneMatch reports whether the If-None-Match lines in h match etag. The
+// comparison is weak, as RFC 9110 section 13.1.2 requires for this header.
+func ifNoneMatch(h http.Header, etag string) bool {
+	etag = strings.TrimPrefix(etag, "W/")
+	for _, line := range h.Values("If-None-Match") {
+		for _, tag := range parseIfNoneMatch(line) {
+			if tag == "*" || tag == etag {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// parseIfNoneMatch returns the members of one If-None-Match line: "*" and the
+// entity-tags, without their W/ prefixes. Empty members are skipped. Parsing
+// stops at the first malformed member, so nothing after it is returned.
+func parseIfNoneMatch(line string) []string {
+	var tags []string
+	for {
+		line = strings.TrimLeft(line, " \t,")
+		if line == "" {
+			return tags
+		}
+		tag, rest, ok := scanIfNoneMatchMember(line)
+		rest = strings.TrimLeft(rest, " \t")
+		if !ok || (rest != "" && rest[0] != ',') {
+			return tags
+		}
+		tags = append(tags, tag)
+		line = rest
+	}
+}
+
+// scanIfNoneMatchMember parses the "*" or entity-tag at the start of s and
+// returns it with the rest of s. ok is false if s does not start with one.
+func scanIfNoneMatchMember(s string) (tag, rest string, ok bool) {
+	if strings.HasPrefix(s, "*") {
+		return "*", s[1:], true
+	}
+	s = strings.TrimPrefix(s, "W/")
+	if s == "" || s[0] != '"' {
+		return "", s, false
+	}
+	closing := strings.IndexByte(s[1:], '"')
+	if closing < 0 {
+		return "", s, false
+	}
+	for i := 1; i <= closing; i++ {
+		if !isETagc(s[i]) {
+			return "", s, false
+		}
+	}
+	return s[:closing+2], s[closing+2:], true
+}
+
+// isETagc reports whether c may appear between the quotes of an entity-tag:
+// any visible ASCII character except '"', or obs-text.
+func isETagc(c byte) bool {
+	return c == 0x21 || (c >= 0x23 && c <= 0x7e) || c >= 0x80
+}
diff --git a/middleware/etag_test.go b/middleware/etag_test.go
new file mode 100644
index 0000000..d7981d0
--- /dev/null
+++ b/middleware/etag_test.go
@@ -0,0 +1,1073 @@
+package middleware
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"io"
+	"log"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/http/httptrace"
+	"net/textproto"
+	"os"
+	"reflect"
+	"regexp"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+// etagSum is the ETag the middleware computes for body.
+func etagSum(body string) string {
+	sum := sha256.Sum256([]byte(body))
+	return `"` + hex.EncodeToString(sum[:]) + `"`
+}
+
+// etagBody returns a handler that writes body with the implicit 200 status.
+func etagBody(body string) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte(body))
+	}
+}
+
+// etagSetETag returns a handler that sets ETag to etag and writes "body".
+func etagSetETag(etag string) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("ETag", etag)
+		w.Write([]byte("body"))
+	}
+}
+
+// etagStatusHandler returns a handler that sets etag (if not empty), then
+// writes code and "body".
+func etagStatusHandler(code int, etag string) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		if etag != "" {
+			w.Header().Set("ETag", etag)
+		}
+		w.WriteHeader(code)
+		w.Write([]byte("body"))
+	}
+}
+
+// etagGatedFlush returns a handler that writes body, flushes, then blocks
+// until gate is closed.
+func etagGatedFlush(body string, gate <-chan struct{}) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte(body))
+		http.NewResponseController(w).Flush()
+		<-gate
+	}
+}
+
+func newETagServer(t *testing.T, h http.Handler) *httptest.Server {
+	t.Helper()
+	ts := httptest.NewServer(ETag(h))
+	t.Cleanup(ts.Close)
+	return ts
+}
+
+// etagRequest sends one request to ts and returns the response and its body.
+func etagRequest(t *testing.T, ts *httptest.Server, method string, header http.Header) (*http.Response, string) {
+	t.Helper()
+	req, err := http.NewRequest(method, ts.URL, http.NoBody)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for name, values := range header {
+		for _, v := range values {
+			req.Header.Add(name, v)
+		}
+	}
+	resp, err := http.DefaultClient.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(resp.Body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return resp, string(body)
+}
+
+// etagGet sends a GET to url with an optional If-None-Match line. Unlike
+// etagRequest it returns errors, so it is safe to call from goroutines.
+func etagGet(url, inm string) (*http.Response, string, error) {
+	req, err := http.NewRequest(http.MethodGet, url, http.NoBody)
+	if err != nil {
+		return nil, "", err
+	}
+	if inm != "" {
+		req.Header.Set("If-None-Match", inm)
+	}
+	resp, err := http.DefaultClient.Do(req)
+	if err != nil {
+		return nil, "", err
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(resp.Body)
+	return resp, string(body), err
+}
+
+// etagStatus returns the status of a request to a handler that sets etag, or
+// writes a plain body if etag is empty, sent with the If-None-Match lines inm.
+func etagStatus(t *testing.T, method, etag string, inm ...string) int {
+	t.Helper()
+	h := etagBody("body")
+	if etag != "" {
+		h = etagSetETag(etag)
+	}
+	header := http.Header{}
+	for _, v := range inm {
+		header.Add("If-None-Match", v)
+	}
+	resp, _ := etagRequest(t, newETagServer(t, h), method, header)
+	return resp.StatusCode
+}
+
+// etagGatedRequest sends method to ts and reports whether the response headers
+// arrived while the handler was blocked on gate. It then closes gate and reads
+// the whole response.
+func etagGatedRequest(t *testing.T, ts *httptest.Server, method string, gate chan struct{}) (bool, *http.Response, string) {
+	t.Helper()
+	type result struct {
+		resp *http.Response
+		err  error
+	}
+	ch := make(chan result, 1)
+	go func() {
+		req, err := http.NewRequest(method, ts.URL, http.NoBody)
+		if err != nil {
+			ch <- result{err: err}
+			return
+		}
+		resp, err := http.DefaultClient.Do(req)
+		ch <- result{resp: resp, err: err}
+	}()
+
+	var res result
+	early := false
+	select {
+	case res = <-ch:
+		early = true
+	case <-time.After(time.Second):
+	}
+	close(gate)
+	if res.resp == nil && res.err == nil {
+		res = <-ch
+	}
+	if res.err != nil {
+		t.Fatal(res.err)
+	}
+	defer res.resp.Body.Close()
+	body, err := io.ReadAll(res.resp.Body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return early, res.resp, string(body)
+}
+
+func TestETagSignature(t *testing.T) {
+	var mw func(http.Handler) http.Handler = ETag
+	if mw == nil {
+		t.Fatal("ETag is nil")
+	}
+}
+
+func TestETagComputesStrongETag(t *testing.T) {
+	manyWrites := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		for _, c := range []byte(strings.Repeat("ab", 500)) {
+			w.Write([]byte{c})
+		}
+	})
+	tests := []struct {
+		name string
+		h    http.Handler
+		body string
+	}{
+		{"single write", etagBody("hello"), "hello"},
+		{"many small writes", manyWrites, strings.Repeat("ab", 500)},
+		{"no writes", http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}), ""},
+		{"1.5 MiB", etagBody(strings.Repeat("0123456789abcdef", 96<<10)), strings.Repeat("0123456789abcdef", 96<<10)},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			ts := newETagServer(t, tc.h)
+			// The same body gives the same ETag on every request.
+			for range 2 {
+				resp, body := etagRequest(t, ts, http.MethodGet, nil)
+				if resp.StatusCode != http.StatusOK {
+					t.Errorf("status: got %d, want %d", resp.StatusCode, http.StatusOK)
+				}
+				if body != tc.body {
+					t.Errorf("body: got %d bytes, want %d", len(body), len(tc.body))
+				}
+				if got, want := resp.Header.Get("ETag"), etagSum(tc.body); got != want {
+					t.Errorf("ETag: got %q, want %q", got, want)
+				}
+			}
+		})
+	}
+}
+
+func TestETagKeepsHandlerSetETag(t *testing.T) {
+	tests := []struct {
+		name string
+		etag string
+	}{
+		{"weak", `W/"v1"`},
+		{"strong", `"v2"`},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			resp, _ := etagRequest(t, newETagServer(t, etagSetETag(tc.etag)), http.MethodGet, nil)
+			if got := resp.Header.Get("ETag"); got != tc.etag {
+				t.Errorf("ETag: got %q, want %q", got, tc.etag)
+			}
+		})
+	}
+}
+
+func TestETagHandlerSetETagAfterWrite(t *testing.T) {
+	ts := newETagServer(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("body"))
+		w.Header().Set("ETag", `"v2"`)
+	}))
+
+	resp, _ := etagRequest(t, ts, http.MethodGet, nil)
+	if got := resp.Header.Get("ETag"); got != `"v2"` {
+		t.Errorf("ETag: got %q, want %q", got, `"v2"`)
+	}
+}
+
+func TestETagIfNoneMatch(t *testing.T) {
+	const notModified, ok = http.StatusNotModified, http.StatusOK
+	tests := []struct {
+		name string
+		etag string // "" means the middleware computes the ETag
+		inm  []string
+		want int
+	}{
+		// Weak comparison.
+		{"weak If-None-Match matches strong ETag", `"x"`, []string{`W/"x"`}, notModified},
+		{"strong If-None-Match matches weak ETag", `W/"x"`, []string{`"x"`}, notModified},
+		{"weak on both sides", `W/"x"`, []string{`W/"x"`}, notModified},
+		// Opaque tags are case-sensitive and must match in full.
+		{"same tag matches", `"x"`, []string{`"x"`}, notModified},
+		{"case differs", `"abc"`, []string{`"ABC"`}, ok},
+		{"X does not match x", `"x"`, []string{`"X"`}, ok},
+		{"longer tag does not match", `"x"`, []string{`"xy"`}, ok},
+		// Lists: whitespace, empty members and multiple header lines.
+		{"whitespace and empty members", `"x"`, []string{`  ,  ,"x" `}, notModified},
+		{"comma separated", `"x"`, []string{`"a", "x"`}, notModified},
+		{"second header line matches", `"x"`, []string{`"a"`, `"x"`}, notModified},
+		{"no line matches", `"x"`, []string{`"a"`, `"b"`}, ok},
+		// "*" matches any ETag, handler-set or computed.
+		{"star matches handler ETag", `"v1"`, []string{"*"}, notModified},
+		{"star matches computed ETag", "", []string{"*"}, notModified},
+		// A quoted comma is part of the tag, not a list separator.
+		{"comma inside tag matches", `"a,b"`, []string{`"a,b"`}, notModified},
+		{"comma inside tag is not split", `"a,b"`, []string{`"a", "b"`}, ok},
+		// Malformed members never match.
+		{"bare token", `"abc"`, []string{`abc`}, ok},
+		{"unclosed quote", `"abc"`, []string{`"abc`}, ok},
+		{"weak prefix only", `"abc"`, []string{`W/`}, ok},
+		{"lowercase weak prefix", `"abc"`, []string{`w/"abc"`}, ok},
+		{"weak prefix without quotes", `"abc"`, []string{`W/abc`}, ok},
+		{"trailing junk after tag", `"abc"`, []string{`"abc"x`}, ok},
+		// Parsing stops at the first malformed member, so later valid tags
+		// do not match.
+		{"valid tag after bare token", `"x"`, []string{`abc, "x"`}, ok},
+		{"valid tag after unclosed quote", `"x"`, []string{`"abc, "x"`}, ok},
+		{"valid tag after trailing junk", `"x"`, []string{`"x"junk, "x"`}, ok},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := etagStatus(t, http.MethodGet, tc.etag, tc.inm...); got != tc.want {
+				t.Errorf("status: got %d, want %d", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestETagNotModifiedHeaders(t *testing.T) {
+	ts := newETagServer(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		h := w.Header()
+		h.Set("Content-Type", "text/plain; charset=utf-8")
+		h.Set("Content-Length", "4")
+		h.Set("Content-Encoding", "identity")
+		h.Set("Cache-Control", "max-age=60")
+		h.Set("Vary", "Accept")
+		h.Set("Expires", "Thu, 01 Jan 2099 00:00:00 GMT")
+		h.Set("Content-Location", "/other")
+		h.Set("Last-Modified", "Mon, 02 Jan 2006 15:04:05 GMT")
+		w.Write([]byte("body"))
+	}))
+
+	resp, body := etagRequest(t, ts, http.MethodGet, http.Header{"If-None-Match": {etagSum("body")}})
+	if resp.StatusCode != http.StatusNotModified {
+		t.Fatalf("status: got %d, want %d", resp.StatusCode, http.StatusNotModified)
+	}
+	if body != "" {
+		t.Errorf("body: got %q, want empty", body)
+	}
+	for _, name := range []string{"ETag", "Cache-Control", "Vary", "Expires", "Content-Location", "Last-Modified", "Date"} {
+		if resp.Header.Get(name) == "" {
+			t.Errorf("%s: missing from 304", name)
+		}
+	}
+	for _, name := range []string{"Content-Type", "Content-Length", "Content-Encoding"} {
+		if _, ok := resp.Header[name]; ok {
+			t.Errorf("%s: present on 304, want removed", name)
+		}
+	}
+}
+
+func TestETagHEAD(t *testing.T) {
+	ts := newETagServer(t, etagBody("hello"))
+
+	get, _ := etagRequest(t, ts, http.MethodGet, nil)
+	head, body := etagRequest(t, ts, http.MethodHead, nil)
+	if got, want := head.Header.Get("ETag"), get.Header.Get("ETag"); got != want || got != etagSum("hello") {
+		t.Errorf("HEAD ETag: got %q, want %q (GET ETag)", got, want)
+	}
+	if body != "" {
+		t.Errorf("HEAD body: got %q, want empty", body)
+	}
+
+	resp, _ := etagRequest(t, ts, http.MethodHead, http.Header{"If-None-Match": {etagSum("hello")}})
+	if resp.StatusCode != http.StatusNotModified {
+		t.Errorf("conditional HEAD: status got %d, want %d", resp.StatusCode, http.StatusNotModified)
+	}
+
+	if got := etagStatus(t, http.MethodHead, `"v1"`, `"v1"`); got != http.StatusNotModified {
+		t.Errorf("HEAD with handler ETag, matching: status got %d, want %d", got, http.StatusNotModified)
+	}
+	if got := etagStatus(t, http.MethodHead, `"v1"`, `"v2"`); got != http.StatusOK {
+		t.Errorf("HEAD with handler ETag, not matching: status got %d, want %d", got, http.StatusOK)
+	}
