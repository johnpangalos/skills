+// TestETagOutsideCompressTagsEncodedBytes mounts ETag outside Compress. The
+// tag must cover the gzip bytes, so the gzip and identity representations get
+// different tags, and the identity tag does not match the gzip response.
+func TestETagOutsideCompressTagsEncodedBytes(t *testing.T) {
+	ts := newETagServer(t, Compress(5)(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "text/plain")
+		w.Write([]byte(strings.Repeat("hello ", 100)))
+	})))
+
+	gz, gzBody := etagRequest(t, ts, http.MethodGet, http.Header{"Accept-Encoding": {"gzip"}})
+	if got := gz.Header.Get("Content-Encoding"); got != "gzip" {
+		t.Fatalf("Content-Encoding: got %q, want gzip", got)
+	}
+	id, _ := etagRequest(t, ts, http.MethodGet, http.Header{"Accept-Encoding": {"identity"}})
+	gzTag, idTag := gz.Header.Get("ETag"), id.Header.Get("ETag")
+	if gzTag != etagSum(gzBody) {
+		t.Errorf("gzip ETag: got %q, want the tag of the encoded bytes %q", gzTag, etagSum(gzBody))
+	}
+	if gzTag == idTag {
+		t.Errorf("gzip and identity share ETag %q", gzTag)
+	}
+
+	resp, _ := etagRequest(t, ts, http.MethodGet, http.Header{"Accept-Encoding": {"gzip"}, "If-None-Match": {idTag}})
+	if resp.StatusCode != http.StatusOK {
+		t.Errorf("gzip request with identity tag: status got %d, want %d", resp.StatusCode, http.StatusOK)
+	}
+	resp, _ = etagRequest(t, ts, http.MethodGet, http.Header{"Accept-Encoding": {"gzip"}, "If-None-Match": {gzTag}})
+	if resp.StatusCode != http.StatusNotModified {
+		t.Errorf("gzip request with gzip tag: status got %d, want %d", resp.StatusCode, http.StatusNotModified)
+	}
+}
+
+// etagComparable returns h without the headers the middleware may change:
+// Date always, ETag and X-Late by design, and Content-Length and Content-Type
+// when the unwrapped response was flushed early. Headers sent by an early
+// flush are sent before the body exists, so their length and sniffed type
+// differ from a buffered response; that is the approved flush difference.
+func etagComparable(h http.Header, flushed bool) http.Header {
+	c := h.Clone()
+	for _, name := range []string{"Date", "ETag", "X-Late"} {
+		c.Del(name)
+	}
+	if flushed {
+		c.Del("Content-Length")
+		c.Del("Content-Type")
+	}
+	return c
+}
+
+// TestETagDifferentialAgainstUnwrapped runs each handler script with and
+// without the middleware and diffs status, headers and body. Only the approved
+// differences may appear.
+func TestETagDifferentialAgainstUnwrapped(t *testing.T) {
+	flush := func(w http.ResponseWriter) { http.NewResponseController(w).Flush() }
+	scripts := []struct {
+		name    string
+		run     func(w http.ResponseWriter)
+		late    bool // sets a header after the first write
+		flushes bool // flushes mid-response
+	}{
+		{name: "write only", run: func(w http.ResponseWriter) { w.Write([]byte("body")) }},
+		{name: "nothing written", run: func(w http.ResponseWriter) {}},
+		{name: "write then WriteHeader 500", run: func(w http.ResponseWriter) {
+			w.Write([]byte("body"))
+			w.WriteHeader(http.StatusInternalServerError)
+		}},
+		{name: "WriteHeader 200 then write", run: func(w http.ResponseWriter) {
+			w.WriteHeader(http.StatusOK)
+			w.Write([]byte("body"))
+		}},
+		{name: "WriteHeader 404 then write", run: func(w http.ResponseWriter) {
+			w.WriteHeader(http.StatusNotFound)
+			w.Write([]byte("body"))
+		}},
+		{name: "WriteHeader 404 then 200", run: func(w http.ResponseWriter) {
+			w.WriteHeader(http.StatusNotFound)
+			w.WriteHeader(http.StatusOK)
+			w.Write([]byte("body"))
+		}},
+		{name: "WriteHeader 200 then 404", run: func(w http.ResponseWriter) {
+			w.WriteHeader(http.StatusOK)
+			w.WriteHeader(http.StatusNotFound)
+			w.Write([]byte("body"))
+		}},
+		{name: "many writes", run: func(w http.ResponseWriter) {
+			for range 8 {
+				w.Write([]byte("ab"))
+			}
+		}},
+		{name: "write flush write", flushes: true, run: func(w http.ResponseWriter) {
+			w.Write([]byte("a"))
+			flush(w)
+			w.Write([]byte("b"))
+		}},
+		{name: "flush then write", flushes: true, run: func(w http.ResponseWriter) {
+			flush(w)
+			w.Write([]byte("body"))
+		}},
+		{name: "header set after write", late: true, run: func(w http.ResponseWriter) {
+			w.Write([]byte("body"))
+			w.Header().Set("X-Late", "1")
+		}},
+		{name: "201 then write", run: func(w http.ResponseWriter) {
+			w.WriteHeader(http.StatusCreated)
+			w.Write([]byte("body"))
+		}},
+		{name: "103 then write", run: func(w http.ResponseWriter) {
+			w.WriteHeader(http.StatusEarlyHints)
+			w.Write([]byte("body"))
+		}},
+	}
+
+	for _, s := range scripts {
+		for _, method := range []string{http.MethodGet, http.MethodHead, http.MethodPost} {
+			t.Run(s.name+" "+method, func(t *testing.T) {
+				plain := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					s.run(w)
+				}))
+				t.Cleanup(plain.Close)
+				wrapped := newETagServer(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					s.run(w)
+				}))
+
+				resp1, body1 := etagRequest(t, plain, method, nil)
+				resp2, body2 := etagRequest(t, wrapped, method, nil)
+				_, getBody := etagRequest(t, plain, http.MethodGet, nil)
+
+				if resp1.StatusCode != resp2.StatusCode {
+					t.Errorf("status: plain %d, wrapped %d", resp1.StatusCode, resp2.StatusCode)
+				}
+				if body1 != body2 {
+					t.Errorf("body: plain %q, wrapped %q", body1, body2)
+				}
+				if got, want := etagComparable(resp2.Header, s.flushes), etagComparable(resp1.Header, s.flushes); !reflect.DeepEqual(got, want) {
+					t.Errorf("headers: plain %v, wrapped %v", want, got)
+				}
+
+				wantETag := method != http.MethodPost && resp1.StatusCode == http.StatusOK &&
+					(method == http.MethodGet || getBody != "")
+				if got := resp2.Header.Get("ETag"); wantETag && got != etagSum(getBody) {
+					t.Errorf("ETag: got %q, want %q", got, etagSum(getBody))
+				} else if !wantETag && got != "" {
+					t.Errorf("ETag: got %q, want none", got)
+				}
+				if s.late && method != http.MethodPost {
+					if got := resp2.Header.Get("X-Late"); got != "1" {
+						t.Errorf("approved late header: wrapped X-Late %q, want %q", got, "1")
+					}
+				}
+				if got := resp1.Header.Get("X-Late"); got != "" {
+					t.Errorf("unwrapped X-Late: got %q, want none", got)
+				}
+			})
+		}
+	}
+}
