+// TestETagHijackSendsBufferedResponse hijacks with and without a buffered
+// write. The bytes on the connection must match the unwrapped handler's, and
+// net/http must not log a write to the hijacked connection.
+func TestETagHijackSendsBufferedResponse(t *testing.T) {
+	hijack := func(write bool) http.HandlerFunc {
+		return func(w http.ResponseWriter, r *http.Request) {
+			if write {
+				w.Write([]byte("hello"))
+			}
+			conn, _, err := w.(http.Hijacker).Hijack()
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			conn.Write([]byte("RAW"))
+			conn.Close()
+		}
+	}
+	for _, write := range []bool{false, true} {
+		t.Run(fmt.Sprintf("write before hijack %v", write), func(t *testing.T) {
+			plainDone := make(chan struct{})
+			want, _ := etagRawHijack(t, etagSignalDone(hijack(write), plainDone), plainDone)
+			done := make(chan struct{})
+			got, logs := etagRawHijack(t, etagSignalDone(ETag(hijack(write)), done), done)
+			if got != want {
+				t.Errorf("connection bytes: got %q, want %q", got, want)
+			}
+			if !strings.HasSuffix(got, "RAW") {
+				t.Errorf("connection bytes: got %q, want the hijacked payload last", got)
+			}
+			if logs != "" {
+				t.Errorf("server logged %q, want nothing", logs)
+			}
+		})
+	}
+}
