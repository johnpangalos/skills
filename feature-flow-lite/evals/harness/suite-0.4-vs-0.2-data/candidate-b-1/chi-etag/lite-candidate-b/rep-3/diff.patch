+// TestETagLiteralETagKey sets the handler's ETag under literal header-map keys
+// that net/http sends as given, in any letter case. The middleware must keep it,
+// add no second ETag, and match If-None-Match against it.
+func TestETagLiteralETagKey(t *testing.T) {
+	keys := []string{"etag", "ETAG", "eTag", "ETag", "Etag"}
+	for _, key := range keys {
+		t.Run(key, func(t *testing.T) {
+			ts := newETagServer(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header()[key] = []string{`"mine"`}
+				w.Write([]byte("body"))
+			}))
+
+			resp, body := etagRequest(t, ts, http.MethodGet, nil)
+			if resp.StatusCode != http.StatusOK || body != "body" {
+				t.Errorf("no If-None-Match: got %d %q, want %d %q", resp.StatusCode, body, http.StatusOK, "body")
+			}
+			if got := resp.Header.Values("ETag"); !reflect.DeepEqual(got, []string{`"mine"`}) {
+				t.Errorf("ETag: got %q, want one ETag %q", got, `"mine"`)
+			}
+
+			resp, body = etagRequest(t, ts, http.MethodGet, http.Header{"If-None-Match": {`"mine"`}})
+			if resp.StatusCode != http.StatusNotModified || body != "" {
+				t.Errorf("matching If-None-Match: got %d %q, want %d with no body", resp.StatusCode, body, http.StatusNotModified)
+			}
+			if got := resp.Header.Values("ETag"); !reflect.DeepEqual(got, []string{`"mine"`}) {
+				t.Errorf("304 ETag: got %q, want one ETag %q", got, `"mine"`)
+			}
+		})
+	}
+}
