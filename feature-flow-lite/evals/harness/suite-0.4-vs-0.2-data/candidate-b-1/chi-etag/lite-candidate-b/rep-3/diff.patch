+// TestETagBufferedFlushHoldsResponse checks, for each call order that flushes
+// a buffered 200, that nothing reaches the client until the handler returns.
+func TestETagBufferedFlushHoldsResponse(t *testing.T) {
+	scripts := []struct {
+		name string
+		run  func(w http.ResponseWriter, flush func())
+		body string
+	}{
+		{"flush first", func(w http.ResponseWriter, flush func()) {
+			flush()
+			w.Write([]byte("body"))
+		}, "body"},
+		{"write then flush", func(w http.ResponseWriter, flush func()) {
+			w.Write([]byte("body"))
+			flush()
+		}, "body"},
+		{"flush between writes", func(w http.ResponseWriter, flush func()) {
+			w.Write([]byte("a"))
+			flush()
+			w.Write([]byte("b"))
+		}, "ab"},
+		{"WriteHeader 200 then flush", func(w http.ResponseWriter, flush func()) {
+			w.WriteHeader(http.StatusOK)
+			flush()
+			w.Write([]byte("body"))
+		}, "body"},
+		{"WriteHeader 200 twice then flush", func(w http.ResponseWriter, flush func()) {
+			w.WriteHeader(http.StatusOK)
+			w.WriteHeader(http.StatusNotFound)
+			flush()
+			w.Write([]byte("body"))
+		}, "body"},
+	}
+
+	for _, s := range scripts {
+		for _, method := range []string{http.MethodGet, http.MethodHead} {
+			t.Run(s.name+" "+method, func(t *testing.T) {
+				gate := make(chan struct{})
+				ts := newETagServer(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					s.run(w, func() {
+						http.NewResponseController(w).Flush()
+						<-gate
+					})
+				}))
+
+				early, resp, body := etagGatedRequest(t, ts, method, gate)
+				if early {
+					t.Fatal("buffered response reached the client before the handler returned")
+				}
+				if resp.StatusCode != http.StatusOK {
+					t.Errorf("status: got %d, want %d", resp.StatusCode, http.StatusOK)
+				}
+				if method == http.MethodGet && body != s.body {
+					t.Errorf("body: got %q, want %q", body, s.body)
+				}
+				if got := resp.Header.Get("ETag"); got != etagSum(s.body) {
+					t.Errorf("ETag: got %q, want %q", got, etagSum(s.body))
+				}
+			})
+		}
+	}
+}
