+      </Dialog>,
+    );
+    const seen: string[] = [];
+    for (let press = 0; press < 4; press++) {
+      await user.tab();
+      seen.push(document.activeElement?.textContent ?? "");
+    }
+    expect(seen).toEqual(["B", "A", "B", "A"]);
