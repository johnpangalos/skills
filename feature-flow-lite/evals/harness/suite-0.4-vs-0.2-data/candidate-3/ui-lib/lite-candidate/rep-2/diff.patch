+import { StrictMode, useState, type ReactNode } from "react";
+import { render, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { describe, expect, it, vi } from "vitest";
+import { Combobox } from "../Combobox/Combobox";
+import { Tab, TabList, TabPanel, Tabs } from "../Tabs/Tabs";
+import { Dialog } from "./Dialog";
+
+const backdropOf = () => document.querySelector<HTMLElement>("[data-dialog-backdrop]");
+
+// Opener button outside the dialog; dialog content is one "Save" button by default.
+function Harness({
+  onOpenChange,
+  description,
+  children = <button>Save</button>,
+}: {
+  onOpenChange?: (open: boolean) => void;
+  description?: ReactNode;
+  children?: ReactNode;
+}) {
+  const [open, setOpen] = useState(false);
+  return (
+    <>
+      <button onClick={() => setOpen(true)}>Open dialog</button>
+      <Dialog
+        open={open}
+        onOpenChange={(next) => {
+          onOpenChange?.(next);
+          setOpen(next);
+        }}
+        title="Settings"
+        description={description}
+      >
+        {children}
+      </Dialog>
+    </>
+  );
+}
+
+describe("Dialog rendering (D1)", () => {
+  it("renders nothing when closed", () => {
+    render(
+      <Dialog open={false} onOpenChange={() => {}} title="Settings">
+        body text
+      </Dialog>,
+    );
+    expect(screen.queryByRole("dialog", { hidden: true })).toBeNull();
+    expect(backdropOf()).toBeNull();
+    expect(screen.queryByText("body text")).toBeNull();
+  });
+
+  it("portals a backdrop and a modal dialog into document.body", () => {
+    const { container } = render(
+      <Dialog open onOpenChange={() => {}} title="Settings">
+        body text
+      </Dialog>,
+    );
+    const dialog = screen.getByRole("dialog", { name: "Settings" });
+    expect(dialog).toHaveAttribute("aria-modal", "true");
+    expect(dialog.parentElement).toBe(document.body);
+    expect(container).not.toContainElement(dialog);
+    expect(backdropOf()).toBeInTheDocument();
+  });
+
+  it("is named by its title and described by its description", () => {
+    render(
+      <Dialog open onOpenChange={() => {}} title="Delete file" description="This cannot be undone.">
+        body text
+      </Dialog>,
+    );
+    const dialog = screen.getByRole("dialog");
+    expect(dialog).toHaveAccessibleName("Delete file");
+    expect(dialog).toHaveAccessibleDescription("This cannot be undone.");
+  });
+
+  it("sets no aria-describedby when description is omitted", () => {
+    render(
+      <Dialog open onOpenChange={() => {}} title="Settings">
+        body text
+      </Dialog>,
+    );
+    expect(screen.getByRole("dialog")).not.toHaveAttribute("aria-describedby");
+  });
+
+  it("accepts a ReactNode title", () => {
+    render(
+      <Dialog open onOpenChange={() => {}} title={<span>Hello <b>you</b></span>}>
+        body text
+      </Dialog>,
+    );
+    expect(screen.getByRole("dialog")).toHaveAccessibleName("Hello you");
+  });
+
+  it("forwards className, style and data attributes to the dialog element", () => {
+    render(
+      <Dialog open onOpenChange={() => {}} title="Settings" className="sheet" data-kind="modal" style={{ color: "red" }}>
+        body text
+      </Dialog>,
+    );
+    const dialog = screen.getByRole("dialog");
+    expect(dialog).toHaveClass("sheet");
+    expect(dialog).toHaveAttribute("data-kind", "modal");
+    expect(dialog.style.color).toBe("red");
+  });
+});
+
+describe("Dialog initial focus (D2)", () => {
+  it("focuses the first tabbable element in the dialog", () => {
+    render(
+      <Dialog open onOpenChange={() => {}} title="Settings">
+        <button>First</button>
+        <button>Second</button>
+      </Dialog>,
+    );
+    expect(screen.getByRole("button", { name: "First" })).toHaveFocus();
+  });
+
