+
+  it("omits aria-controls when a Tab has no matching TabPanel", () => {
+    render(
+      <Tabs defaultValue="ghost">
+        <TabList aria-label="Sections">
+          <Tab value="ghost">Ghost</Tab>
+        </TabList>
+      </Tabs>,
+    );
+    expect(tab("Ghost")).not.toHaveAttribute("aria-controls");
