+          {values.map((value) => (
+            <Tab key={value} value={value}>
+              {value}
+            </Tab>
+          ))}
+        </TabList>
+        {values.map((value) => (
+          <TabPanel key={value} value={value}>
+            {`panel ${value}`}
+          </TabPanel>
+        ))}
+      </Tabs>,
