+import { Tab, TabList, TabPanel, Tabs, type TabsProps } from "./Tabs";
+
+const THREE = ["one", "two", "three"];
+
+// One Tab and one TabPanel per value; the tab and panel text is the value.
+function tabsOf(values: string[], props: TabsProps = {}, disabled: string[] = []) {
+  return (
+    <Tabs {...props}>
+      <TabList aria-label="Sections">
+        {values.map((value) => (
+          <Tab key={value} value={value} disabled={disabled.includes(value)}>
+            {value}
+          </Tab>
+        ))}
+      </TabList>
+      {values.map((value) => (
+        <TabPanel key={value} value={value}>
+          {`panel ${value}`}
+        </TabPanel>
+      ))}
+    </Tabs>
+  );
+}
+
+const tab = (name: string) => screen.getByRole("tab", { name });
+
+describe("Tabs structure and ARIA (T1)", () => {
+  it("gives TabList role tablist with the aria-label", () => {
+    render(tabsOf(THREE));
+    expect(screen.getByRole("tablist", { name: "Sections" })).toBeInTheDocument();
+  });
+
+  it("accepts aria-labelledby on TabList", () => {
+    render(
+      <>
+        <h2 id="sections-heading">Sections</h2>
+        <Tabs>
+          <TabList aria-labelledby="sections-heading">
+            <Tab value="a">A</Tab>
+          </TabList>
+          <TabPanel value="a">panel a</TabPanel>
+        </Tabs>
+      </>,
+    );
+    expect(screen.getByRole("tablist", { name: "Sections" })).toBeInTheDocument();
+  });
+
+  it("renders each Tab as a button with role tab and aria-selected", () => {
+    render(tabsOf(THREE, { defaultValue: "two" }, ["three"]));
+    const tabs = screen.getAllByRole("tab");
+    expect(tabs).toHaveLength(3);
+    for (const element of tabs) {
+      expect(element.tagName).toBe("BUTTON");
+      expect(element).toHaveAttribute("type", "button");
+    }
+    expect(tab("two")).toHaveAttribute("aria-selected", "true");
+    expect(tab("one")).toHaveAttribute("aria-selected", "false");
+  });
+
+  it("links a Tab to its panel and the panel back to the Tab", () => {
+    render(tabsOf(THREE));
+    const panel = screen.getByRole("tabpanel", { name: "one" });
+    expect(tab("one")).toHaveAttribute("aria-controls", panel.id);
+    expect(panel).toHaveAttribute("aria-labelledby", tab("one").id);
+    expect(panel).toHaveAttribute("tabindex", "0");
+  });
