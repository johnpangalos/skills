+import { useState } from "react";
+import { fireEvent, render, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { Tab, TabList, TabPanel, Tabs, type TabsProps } from "./index";
+
+function tabsTree(props: Omit<TabsProps, "children"> = {}, disabled: string[] = []) {
+  return (
+    <Tabs {...props}>
+      <TabList aria-label="Sections">
+        <Tab value="one" disabled={disabled.includes("one")}>One</Tab>
+        <Tab value="two" disabled={disabled.includes("two")}>Two</Tab>
+        <Tab value="three" disabled={disabled.includes("three")}>Three</Tab>
+      </TabList>
+      <TabPanel value="one">Panel one</TabPanel>
+      <TabPanel value="two">Panel two</TabPanel>
+      <TabPanel value="three">Panel three</TabPanel>
+    </Tabs>
+  );
+}
+
+function renderTabs(props: Omit<TabsProps, "children"> = {}, disabled: string[] = []) {
+  return render(tabsTree(props, disabled));
+}
+
+const tab = (name: string) => screen.getByRole("tab", { name });
+
+function DynamicTabs() {
+  const [addZero, setAddZero] = useState(false);
+  const [keepTwo, setKeepTwo] = useState(true);
+  return (
+    <>
+      <button type="button" onClick={() => setAddZero(true)}>
+        Add zero
+      </button>
+      <button type="button" onClick={() => setKeepTwo(false)}>
+        Remove two
+      </button>
+      <Tabs defaultValue="one">
+        <TabList aria-label="Dynamic">
+          {addZero && <Tab value="zero">Zero</Tab>}
+          <Tab value="one">One</Tab>
+          {keepTwo && <Tab value="two">Two</Tab>}
+          <Tab value="three">Three</Tab>
+        </TabList>
+      </Tabs>
+    </>
+  );
+}
+
+describe("Tabs", () => {
+  it("T1 exposes tablist, tab and tabpanel roles, names and links", () => {
+    renderTabs();
+    const list = screen.getByRole("tablist", { name: "Sections" });
+    expect(list).toHaveAttribute("aria-orientation", "horizontal");
+
+    const tabs = screen.getAllByRole("tab");
+    expect(tabs).toHaveLength(3);
+    for (const t of tabs) {
+      expect(t.tagName).toBe("BUTTON");
+      expect(t).toHaveAttribute("type", "button");
+      expect(t.id).not.toBe("");
+    }
+    expect(tabs[0]).toHaveAttribute("aria-selected", "true");
+    expect(tabs[1]).toHaveAttribute("aria-selected", "false");
+    expect(tabs[2]).toHaveAttribute("aria-selected", "false");
+
+    const panels = screen.getAllByRole("tabpanel", { hidden: true });
+    expect(panels).toHaveLength(3);
+    const visible = screen.getByRole("tabpanel");
+    expect(visible).toHaveTextContent("Panel one");
+    expect(visible).toHaveAttribute("aria-labelledby", tabs[0].id);
+    expect(visible).toHaveAttribute("tabindex", "0");
+    expect(tabs[0]).toHaveAttribute("aria-controls", visible.id);
+
+    expect(panels[1]).toHaveAttribute("hidden");
+    expect(panels[2]).toHaveAttribute("hidden");
+    expect(panels[1]).toHaveAttribute("aria-labelledby", tabs[1].id);
+    expect(tabs[1]).toHaveAttribute("aria-controls", panels[1].id);
+  });
+
+  it("T2 only the selected tab is in the tab order, and Tab moves from it to the panel", async () => {
