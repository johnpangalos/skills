+    expect(document.querySelector("[data-backdrop]")).toBeNull();
+  });
+
+  it("D1: when open, renders a backdrop and a modal dialog portaled into document.body", () => {
+    const { container } = render(
+      <Dialog open onOpenChange={() => {}} title="Confirm" description="Are you sure?">
+        <button type="button">First</button>
+      </Dialog>,
