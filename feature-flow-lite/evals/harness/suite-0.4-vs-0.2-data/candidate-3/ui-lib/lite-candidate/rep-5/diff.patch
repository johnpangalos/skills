+import { act, fireEvent, render, screen, within } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { useState, type KeyboardEvent } from "react";
+import { Tab, TabList, TabPanel, Tabs, type TabListProps, type TabsProps } from "./Tabs";
+
+function Basic(props: Omit<TabsProps, "children">) {
+  return (
+    <Tabs {...props}>
+      <TabList aria-label="Sections">
+        <Tab value="one">One</Tab>
+        <Tab value="two">Two</Tab>
+        <Tab value="three" disabled>
+          Three
+        </Tab>
+        <Tab value="four">Four</Tab>
+      </TabList>
+      <TabPanel value="one">Panel one</TabPanel>
+      <TabPanel value="two">Panel two</TabPanel>
+      <TabPanel value="three">Panel three</TabPanel>
+      <TabPanel value="four">Panel four</TabPanel>
+    </Tabs>
+  );
+}
+
+function getTab(name: string): HTMLElement {
+  return screen.getByRole("tab", { name });
+}
+
+function focusTab(name: string) {
+  act(() => getTab(name).focus());
+}
+
+function panelFor(tab: HTMLElement): HTMLElement {
+  const panel = document.getElementById(tab.getAttribute("aria-controls") ?? "");
+  if (!panel) throw new Error(`no panel for tab ${tab.textContent}`);
+  return panel;
+}
+
+describe("Tabs structure (T1)", () => {
+  it("T1: TabList is a horizontal tablist with the given label", () => {
+    render(<Basic defaultValue="one" />);
+    const list = screen.getByRole("tablist", { name: "Sections" });
+    expect(list).toHaveAttribute("aria-orientation", "horizontal");
+  });
+
+  it("T1: Tab is a type=button tab whose aria-controls points at its panel", () => {
+    render(<Basic defaultValue="one" />);
+    const one = getTab("One");
+    expect(one.tagName).toBe("BUTTON");
+    expect(one).toHaveAttribute("type", "button");
+    expect(one).toHaveAttribute("aria-selected", "true");
+    const panel = panelFor(one);
+    expect(panel).toHaveAttribute("role", "tabpanel");
+    expect(panel).toHaveAttribute("aria-labelledby", one.id);
+    expect(panel).toHaveTextContent("Panel one");
+  });
+
+  it("T1: TabPanel is focusable and non-selected panels are hidden", () => {
+    render(<Basic defaultValue="one" />);
+    expect(screen.getByRole("tabpanel")).toHaveTextContent("Panel one");
+    expect(panelFor(getTab("One"))).toHaveAttribute("tabindex", "0");
+    expect(panelFor(getTab("Two"))).toHaveAttribute("hidden");
+    expect(getTab("Two")).toHaveAttribute("aria-selected", "false");
+  });
+});
+
+describe("Tabs selection (T2)", () => {
+  it("T2: defaultValue selects the initial tab", () => {
+    render(<Basic defaultValue="two" />);
+    expect(getTab("Two")).toHaveAttribute("aria-selected", "true");
+  });
+
+  it("T2: the first enabled tab is selected when defaultValue is omitted", () => {
+    render(<Basic />);
+    expect(getTab("One")).toHaveAttribute("aria-selected", "true");
+  });
+
+  it.each(["missing", "three"])("T2: defaultValue %s falls back to the first enabled tab", (defaultValue) => {
+    render(<Basic defaultValue={defaultValue} />);
+    expect(getTab("One")).toHaveAttribute("aria-selected", "true");
+    expect(getTab("Three")).toHaveAttribute("aria-selected", "false");
+  });
+
+  it("T2: uncontrolled click selects the tab and reports the new value", async () => {
+    const user = userEvent.setup();
+    const onValueChange = vi.fn();
+    render(<Basic defaultValue="one" onValueChange={onValueChange} />);
+    await user.click(getTab("Two"));
+    expect(getTab("Two")).toHaveAttribute("aria-selected", "true");
+    expect(onValueChange).toHaveBeenCalledTimes(1);
+    expect(onValueChange).toHaveBeenCalledWith("two");
+  });
+
+  it("T2: re-selecting the selected tab does not report a change", async () => {
+    const user = userEvent.setup();
+    const onValueChange = vi.fn();
+    render(<Basic defaultValue="one" onValueChange={onValueChange} />);
+    await user.click(getTab("One"));
+    expect(onValueChange).not.toHaveBeenCalled();
