+    expect(box()).toHaveAttribute("aria-expanded", "false");
+    expect(box()).toHaveValue("Apple");
+    expect(onChange).not.toHaveBeenCalled();
+  });
+});
+
+describe("Combobox controlled value (C9)", () => {
+  it("C9: changing the value prop updates the input text", () => {
+    const { rerender } = render(<Fixed value="apple" />);
+    rerender(<Fixed value="cherry" />);
+    expect(box()).toHaveValue("Cherry");
