+    const dialog = screen.getByRole("dialog", { name: "Confirm" });
+    expect(dialog).toHaveAttribute("aria-modal", "true");
+    expect(document.body.contains(dialog)).toBe(true);
+    expect(container.contains(dialog)).toBe(false);
+    expect(backdrop()).toBeInTheDocument();
+    expect(screen.getByRole("heading", { name: "Confirm" })).toBe(
+      document.getElementById(dialog.getAttribute("aria-labelledby") ?? ""),
+    );
+    expect(document.getElementById(dialog.getAttribute("aria-describedby") ?? "")).toHaveTextContent("Are you sure?");
+  });
+
+  it("D1: omits aria-describedby when no description is given", () => {
+    render(
+      <Dialog open onOpenChange={() => {}} title="Confirm">
+        <button type="button">First</button>
+      </Dialog>,
