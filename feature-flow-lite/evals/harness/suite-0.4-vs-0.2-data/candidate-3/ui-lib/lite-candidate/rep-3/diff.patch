+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { useState } from "react";
+import { describe, expect, it, vi } from "vitest";
+import { Tabs, TabList, Tab, TabPanel } from "../Tabs/Tabs";
+import { Dialog } from "./Dialog";
+
+function Harness({
+  onClose,
+  description,
+  initialOpen = false,
+  children,
+}: {
+  onClose?: (open: boolean) => void;
+  description?: string;
+  initialOpen?: boolean;
+  children?: React.ReactNode;
+}) {
+  const [open, setOpen] = useState(initialOpen);
+  return (
+    <>
+      <button onClick={() => setOpen(true)}>Open</button>
+      <Dialog
+        open={open}
+        title="Confirm"
+        description={description}
+        onOpenChange={(next) => {
+          onClose?.(next);
+          setOpen(next);
+        }}
+      >
+        {children ?? (
+          <>
+            <button>First</button>
+            <button>Second</button>
+          </>
+        )}
+      </Dialog>
+    </>
+  );
+}
+
+const dialogEl = () => screen.getByRole("dialog");
+const backdropEl = () => document.querySelector("[data-backdrop]") as HTMLElement;
+
+describe("Dialog", () => {
+  it("D1 renders nothing when closed", () => {
+    render(
+      <Dialog open={false} onOpenChange={() => {}} title="Confirm">
+        <button>Inside</button>
+      </Dialog>,
+    );
+    expect(screen.queryByRole("dialog", { hidden: true })).toBeNull();
+    expect(document.querySelector("[data-backdrop]")).toBeNull();
+    expect(document.body.textContent).toBe("");
+  });
+
+  it("D1 when open renders a backdrop and a modal dialog labelled by its title, portaled into body", () => {
+    const { container } = render(
+      <Dialog open onOpenChange={() => {}} title="Confirm">
+        <button>Inside</button>
+      </Dialog>,
+    );
+    const dialog = dialogEl();
+    expect(dialog.getAttribute("aria-modal")).toBe("true");
+    expect(dialog.getAttribute("aria-labelledby")).toBe(screen.getByRole("heading", { name: "Confirm" }).id);
+    expect(dialog.hasAttribute("aria-describedby")).toBe(false);
+    expect(backdropEl()).not.toBeNull();
+    expect(backdropEl().contains(dialog)).toBe(true);
+    expect(backdropEl().parentElement).toBe(document.body);
+    expect(container.contains(dialog)).toBe(false);
+  });
+
+  it("D1 aria-describedby points at the description only when one is given", () => {
+    render(
+      <Dialog open onOpenChange={() => {}} title="Confirm" description="Delete the file?">
+        <button>Inside</button>
+      </Dialog>,
+    );
+    const describedBy = dialogEl().getAttribute("aria-describedby");
+    expect(describedBy).not.toBeNull();
+    expect(document.getElementById(describedBy ?? "")?.textContent).toBe("Delete the file?");
+  });
+
+  it("D2 on open moves focus to the first tabbable element inside the dialog", async () => {
+    const user = userEvent.setup();
+    render(<Harness />);
+    await user.click(screen.getByRole("button", { name: "Open" }));
+    expect(document.activeElement).toBe(screen.getByRole("button", { name: "First" }));
+  });
+
+  it("D2 focuses the dialog container itself when nothing inside is tabbable", async () => {
+    const user = userEvent.setup();
+    render(
+      <Harness>
+        <p>Just text</p>
+      </Harness>,
+    );
+    await user.click(screen.getByRole("button", { name: "Open" }));
+    expect(document.activeElement).toBe(dialogEl());
+    expect(dialogEl().getAttribute("tabindex")).toBe("-1");
+  });
+
+  it("D2 a child with autoFocus keeps focus", async () => {
+    const user = userEvent.setup();
+    render(
+      <Harness>
+        <button>First</button>
+        <input aria-label="Name" autoFocus />
+      </Harness>,
+    );
+    await user.click(screen.getByRole("button", { name: "Open" }));
+    expect(document.activeElement).toBe(screen.getByRole("textbox", { name: "Name" }));
+  });
+
+  it("D3 Tab from the last tabbable element wraps to the first", async () => {
+    const user = userEvent.setup();
+    render(<Harness />);
+    await user.click(screen.getByRole("button", { name: "Open" }));
+    await user.tab();
+    expect(document.activeElement).toBe(screen.getByRole("button", { name: "Second" }));
+    await user.tab();
+    expect(document.activeElement).toBe(screen.getByRole("button", { name: "First" }));
+  });
+
+  it("D3 Shift+Tab from the first tabbable element wraps to the last", async () => {
+    const user = userEvent.setup();
+    render(<Harness />);
+    await user.click(screen.getByRole("button", { name: "Open" }));
+    await user.tab({ shift: true });
+    expect(document.activeElement).toBe(screen.getByRole("button", { name: "Second" }));
+  });
+
+  it("D3 with no tabbable children, Tab and Shift+Tab keep focus on the dialog", async () => {
+    const user = userEvent.setup();
+    render(
+      <Harness>
+        <p>Just text</p>
+      </Harness>,
+    );
+    await user.click(screen.getByRole("button", { name: "Open" }));
+    await user.tab();
+    expect(document.activeElement).toBe(dialogEl());
+    await user.tab({ shift: true });
+    expect(document.activeElement).toBe(dialogEl());
+  });
+
+  it("D3 hostile: disabled, tabIndex=-1, hidden and inert content is never reached by Tab", async () => {
+    const user = userEvent.setup();
+    render(
+      <Harness>
+        <button>First</button>
+        <button disabled>Disabled</button>
+        <button tabIndex={-1}>Negative</button>
+        <div hidden>
+          <button>Hidden</button>
+        </div>
+        <div inert>
+          <button>Inert</button>
+        </div>
+        <button>Last</button>
+      </Harness>,
+    );
+    await user.click(screen.getByRole("button", { name: "Open" }));
+    const seen: string[] = [];
+    for (let i = 0; i < 4; i++) {
+      await user.tab();
+      seen.push(document.activeElement?.textContent ?? "");
+    }
+    expect(seen).toEqual(["Last", "First", "Last", "First"]);
+  });
+
+  it("D3 elements added after the dialog opened are part of the trap", async () => {
+    const user = userEvent.setup();
+    const { rerender } = render(
+      <Dialog open onOpenChange={() => {}} title="Confirm">
+        <button>First</button>
+      </Dialog>,
+    );
+    rerender(
+      <Dialog open onOpenChange={() => {}} title="Confirm">
+        <button>First</button>
+        <button>Late</button>
+      </Dialog>,
+    );
+    await user.tab();
+    expect(document.activeElement).toBe(screen.getByRole("button", { name: "Late" }));
+    await user.tab();
+    expect(document.activeElement).toBe(screen.getByRole("button", { name: "First" }));
+  });
+
+  it("D3 focus that escapes the dialog is pulled back inside", async () => {
+    const user = userEvent.setup();
+    render(
+      <>
+        <button>Outside</button>
+        <Harness />
+      </>,
+    );
+    await user.click(screen.getByRole("button", { name: "Open" }));
+    await user.click(screen.getByRole("button", { name: "Outside" }));
+    expect(dialogEl().contains(document.activeElement)).toBe(true);
+    expect(document.activeElement).toBe(screen.getByRole("button", { name: "First" }));
+  });
+
+  it("D4 Escape calls onOpenChange(false)", async () => {
+    const user = userEvent.setup();
+    const onOpenChange = vi.fn();
+    render(
+      <Dialog open onOpenChange={onOpenChange} title="Confirm">
+        <button>First</button>
+      </Dialog>,
+    );
+    await user.keyboard("{Escape}");
+    expect(onOpenChange.mock.calls).toEqual([[false]]);
+  });
+
+  it("D4 a click on the backdrop calls onOpenChange(false)", async () => {
+    const user = userEvent.setup();
+    const onOpenChange = vi.fn();
+    render(
+      <Dialog open onOpenChange={onOpenChange} title="Confirm">
+        <button>First</button>
+      </Dialog>,
+    );
+    await user.click(backdropEl());
+    expect(onOpenChange.mock.calls).toEqual([[false]]);
+  });
+
+  it("D4 clicks inside the content never close the dialog", async () => {
+    const user = userEvent.setup();
+    const onOpenChange = vi.fn();
+    render(
+      <Dialog open onOpenChange={onOpenChange} title="Confirm" description="Body text">
+        <button>First</button>
+      </Dialog>,
+    );
+    await user.click(screen.getByRole("button", { name: "First" }));
+    await user.click(screen.getByText("Body text"));
+    await user.click(dialogEl());
+    expect(onOpenChange).not.toHaveBeenCalled();
+  });
+
+  it("D4 hostile: a drag that starts inside the content and ends on the backdrop does not close", async () => {
+    const user = userEvent.setup();
+    const onOpenChange = vi.fn();
+    render(
+      <Dialog open onOpenChange={onOpenChange} title="Confirm">
+        <button>First</button>
+      </Dialog>,
+    );
+    await user.pointer([
+      { keys: "[MouseLeft>]", target: screen.getByRole("button", { name: "First" }) },
+      { target: backdropEl() },
+      { keys: "[/MouseLeft]", target: backdropEl() },
+    ]);
+    expect(onOpenChange).not.toHaveBeenCalled();
+  });
+
+  it("D5 closing returns focus to the element that had it before opening", async () => {
+    const user = userEvent.setup();
+    render(<Harness />);
+    const opener = screen.getByRole("button", { name: "Open" });
+    await user.click(opener);
+    expect(document.activeElement).toBe(screen.getByRole("button", { name: "First" }));
+    await user.keyboard("{Escape}");
+    expect(screen.queryByRole("dialog")).toBeNull();
+    expect(document.activeElement).toBe(opener);
+  });
+
+  it("D5 unmounting an open dialog returns focus to the opener", async () => {
+    const opener = document.createElement("button");
+    document.body.appendChild(opener);
+    opener.focus();
+    const { rerender, unmount } = render(
+      <Dialog open={false} onOpenChange={() => {}} title="Confirm">
+        <button>First</button>
+      </Dialog>,
+    );
+    rerender(
+      <Dialog open onOpenChange={() => {}} title="Confirm">
+        <button>First</button>
+      </Dialog>,
+    );
+    await waitFor(() => expect(document.activeElement).toBe(screen.getByRole("button", { name: "First" })));
+    unmount();
+    expect(document.activeElement).toBe(opener);
+    opener.remove();
+  });
+
+  it("D5 hostile: an opener removed from the DOM while open is not focused on close", () => {
+    const opener = document.createElement("button");
+    document.body.appendChild(opener);
+    opener.focus();
+    const { rerender } = render(
+      <Dialog open onOpenChange={() => {}} title="Confirm">
+        <button>First</button>
+      </Dialog>,
+    );
+    opener.remove();
+    rerender(
+      <Dialog open={false} onOpenChange={() => {}} title="Confirm">
+        <button>First</button>
+      </Dialog>,
+    );
+    expect(document.activeElement).toBe(document.body);
