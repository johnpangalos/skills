+    expect(tabList.map((tab) => tab.tagName)).toEqual(["BUTTON", "BUTTON", "BUTTON", "BUTTON"]);
+    expect(tabList.map((tab) => tab.getAttribute("type"))).toEqual(["button", "button", "button", "button"]);
