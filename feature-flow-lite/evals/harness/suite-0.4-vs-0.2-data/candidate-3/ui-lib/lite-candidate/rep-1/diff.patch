+import { StrictMode, useState } from "react";
+import { render, screen, fireEvent } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { describe, expect, it, vi } from "vitest";
+import * as library from "../src/index";
+import { Tab, TabList, TabPanel, Tabs } from "../src/index";
+import type { TabListProps, TabPanelProps, TabProps, TabsProps } from "../src/index";
+
+// No @types/node in this project; declare only the Node API the README check uses.
+declare const process: {
+  cwd(): string;
+  getBuiltinModule(id: "node:fs"): { readFileSync(path: string, encoding: "utf8"): string };
+};
+
+type ExampleProps = Omit<TabsProps, "children"> & { labels?: string[]; disabled?: string[] };
+
+function Example({ labels = ["one", "two", "three"], disabled = [], ...props }: ExampleProps) {
+  return (
+    <Tabs {...props}>
+      <TabList aria-label="Sections">
+        {labels.map((label) => (
+          <Tab key={label} value={label} disabled={disabled.includes(label)}>
+            {label}
+          </Tab>
+        ))}
+      </TabList>
+      {labels.map((label) => (
+        <TabPanel key={label} value={label}>
+          <button type="button">{`${label} action`}</button>
+        </TabPanel>
+      ))}
+    </Tabs>
+  );
+}
+
+const tab = (name: string) => screen.getByRole("tab", { name });
+
+describe("exports (G1)", () => {
+  it("exports the components and their prop types from src/index", () => {
+    expect(Object.keys(library).sort()).toEqual(["Combobox", "Dialog", "Tab", "TabList", "TabPanel", "Tabs"]);
+    const types: [TabsProps?, TabListProps?, TabProps?, TabPanelProps?] = [];
+    expect(types).toEqual([]);
+  });
+});
+
+describe("README (G5)", () => {
+  const readme = process.getBuiltinModule("node:fs").readFileSync(`${process.cwd()}/README.md`, "utf8");
+
+  it("has a section per component with a usage example, props table and keyboard table", () => {
+    for (const heading of ["## Tabs", "## Dialog", "## Combobox"]) {
+      const section = readme.split(heading)[1]?.split(/\n## /)[0] ?? "";
+      expect(section, heading).toContain("```tsx");
+      expect(section, heading).toContain("| Prop |");
+      expect(section, heading).toContain("| Key |");
+    }
+  });
+});
+
+describe("Tabs", () => {
+  describe("structure (T1)", () => {
+    it("renders role=tablist with the given aria-label", () => {
+      render(<Example />);
+      expect(screen.getByRole("tablist", { name: "Sections" })).toBeInTheDocument();
+    });
+
+    it("renders each Tab as a type=button role=tab with aria-selected and aria-controls", () => {
+      render(<Example defaultValue="two" />);
+      const two = tab("two");
+      expect(two.tagName).toBe("BUTTON");
+      expect(two).toHaveAttribute("type", "button");
+      expect(two).toHaveAttribute("aria-selected", "true");
+      expect(tab("one")).toHaveAttribute("aria-selected", "false");
+      expect(two).toHaveAttribute("aria-controls", screen.getByRole("tabpanel", { name: "two" }).id);
