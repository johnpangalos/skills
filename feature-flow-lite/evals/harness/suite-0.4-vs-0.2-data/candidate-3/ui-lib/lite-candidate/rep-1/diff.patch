+// A parent that owns `open`, the way a real page would.
+function Page({
+  onOpenChange,
+  children,
+  description,
+}: {
+  onOpenChange?: (open: boolean) => void;
+  children?: ReactNode;
+  description?: string;
+}) {
+  const [open, setOpen] = useState(false);
+  return (
+    <>
+      <button type="button" onClick={() => setOpen(true)}>
+        Open
+      </button>
+      <Dialog
+        open={open}
+        onOpenChange={(next) => {
+          onOpenChange?.(next);
+          setOpen(next);
+        }}
+        title="Confirm"
+        description={description}
+      >
+        {children ?? (
+          <>
+            <button type="button">Yes</button>
+            <button type="button">No</button>
+          </>
+        )}
+      </Dialog>
+    </>
+  );
+}
+
+// Two stacked dialogs: the inner one is opened from a button inside the outer one.
+function Nested({ onOuterChange, onInnerChange }: { onOuterChange: (open: boolean) => void; onInnerChange: (open: boolean) => void }) {
+  const [outer, setOuter] = useState(true);
+  const [inner, setInner] = useState(false);
+  return (
+    <>
+      <Dialog
+        open={outer}
+        onOpenChange={(next) => {
+          onOuterChange(next);
+          setOuter(next);
+        }}
+        title="Outer"
+      >
+        <button type="button" onClick={() => setInner(true)}>
+          Open inner
+        </button>
+        <Dialog
+          open={inner}
+          onOpenChange={(next) => {
+            onInnerChange(next);
+            setInner(next);
+          }}
+          title="Inner"
+        >
+          <button type="button">Inner action</button>
+        </Dialog>
+        <button type="button">Outer action</button>
+      </Dialog>
+    </>
+  );
+}
