+// TestETagTrailers compares what the client sees of a wrapped and a plain handler. Trailer values
+// set after the first write must reach the client as trailers only, never as headers, on a 200,
+// a 304, HEAD and a response flushed after the trailer is set. Declared names are canonicalized
+// from the Trailer header, and Trailer:-prefixed keys are sent too, but undeclared keys are not.
+func TestETagTrailers(t *testing.T) {
+	scenarios := []struct {
+		name     string
+		buffered bool // a 200 that is held in memory, so a matching If-None-Match gives a 304
+		h        http.HandlerFunc
+	}{
+		{"declared and prefixed", true, func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Trailer", "X-First, x-second")
+			w.Write([]byte("body"))
+			w.Header().Set("X-First", "1")
+			w.Header().Set("X-Second", "2")
+			w.Header()[http.TrailerPrefix+"X-Prefixed"] = []string{"3"}
+			w.Header().Set("X-Undeclared", "4")
+		}},
+		{"declared key set before and after write", true, func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Trailer", "X-Pre")
+			w.Header().Set("X-Pre", "1")
+			w.Write([]byte("body"))
+			w.Header().Set("X-Pre", "2")
+		}},
+		{"declared key deleted after write", true, func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Trailer", "X-Pre")
+			w.Header().Set("X-Pre", "1")
+			w.Write([]byte("body"))
+			w.Header().Del("X-Pre")
+		}},
+		{"odd trailer names", true, func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Trailer", "x-a ,  X-B")
+			w.Write([]byte("body"))
+			w.Header().Set("X-A", "1")
+			w.Header().Set("X-B", "2")
+		}},
+		{"set after write before flush", false, func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Trailer", "X-T")
+			w.Write([]byte("body"))
+			w.Header().Set("X-T", "v")
+			w.(http.Flusher).Flush()
+		}},
+	}
+	for _, sc := range scenarios {
+		t.Run(sc.name, func(t *testing.T) {
+			plain := httptest.NewServer(sc.h)
+			defer plain.Close()
+			wrapped := httptest.NewServer(ETag(sc.h))
+			defer wrapped.Close()
+			for _, method := range []string{"GET", "HEAD"} {
+				pStatus, pHeader, pTrailer, pBody := fetchView(t, plain.URL, method, "")
+				status, header, trailer, body := fetchView(t, wrapped.URL, method, "")
+				assertEqual(t, status, pStatus)
+				assertEqual(t, comparableHeader(header, false), comparableHeader(pHeader, false))
+				assertEqual(t, fmt.Sprint(trailer), fmt.Sprint(pTrailer))
+				assertEqual(t, body, pBody)
+
+				// The same request with a matching If-None-Match.
+				status, header, _, body = fetchView(t, wrapped.URL, method, wantTag("body"))
+				if sc.buffered {
+					assertEqual(t, status, http.StatusNotModified)
+					assertEqual(t, comparableHeader(header, true), comparableHeader(pHeader, true))
+					assertEqual(t, body, "")
+				} else {
+					assertEqual(t, status, http.StatusOK)
+					assertEqual(t, comparableHeader(header, false), comparableHeader(pHeader, false))
+				}
+			}
+		})
+	}
+}
+
+// fetchView sends method to url, with an If-None-Match header unless inm is empty, and returns
+// the status, headers, trailers and body the client sees.
+func fetchView(t *testing.T, url, method, inm string) (int, http.Header, http.Header, string) {
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	req, err := http.NewRequestWithContext(ctx, method, url, nil)
+	assertNoError(t, err)
+	if inm != "" {
+		req.Header.Set("If-None-Match", inm)
+	}
+	resp, err := http.DefaultClient.Do(req)
+	assertNoError(t, err)
+	defer resp.Body.Close()
+	body, err := io.ReadAll(resp.Body)
+	assertNoError(t, err)
+	return resp.StatusCode, resp.Header, resp.Trailer, string(body)
+}
+
+// comparableHeader returns h without the Etag, Date and Content-Length headers, which differ
+// between a plain and a wrapped response, and, when notModified, without the Content-Type and
+// Content-Encoding headers that a 304 drops too. The client takes the Trailer header off a 200
+// with a body but leaves it on a 304, so it is dropped as well.
+func comparableHeader(h http.Header, notModified bool) string {
+	c := h.Clone()
+	c.Del("Etag")
+	c.Del("Date")
+	c.Del("Content-Length")
+	if notModified {
+		c.Del("Content-Type")
+		c.Del("Content-Encoding")
+		c.Del("Trailer")
+	}
+	return fmt.Sprint(c)
+}
+
+// A 1xx written after the response has started is ignored, as net/http ignores it.
+func TestETagInformationalAfterWrite(t *testing.T) {
+	ts := httptest.NewServer(ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("x"))
+		w.WriteHeader(http.StatusEarlyHints)
+		w.Write([]byte("y"))
+	})))
+	defer ts.Close()
+	informational := 0
+	trace := &httptrace.ClientTrace{
+		Got1xxResponse: func(code int, _ textproto.MIMEHeader) error {
+			informational++
+			return nil
+		},
+	}
+	req := timedRequest(t, ts.URL)
+	req = req.WithContext(httptrace.WithClientTrace(req.Context(), trace))
+	resp, err := http.DefaultClient.Do(req)
+	assertNoError(t, err)
+	defer resp.Body.Close()
+	body, err := io.ReadAll(resp.Body)
+	assertNoError(t, err)
+	assertEqual(t, informational, 0)
+	assertEqual(t, resp.StatusCode, http.StatusOK)
+	assertEqual(t, string(body), "xy")
+	assertEqual(t, resp.Header.Get("ETag"), wantTag("xy"))
+}
