+// Differential: the wrapped and plain handler give the same bytes on the wire, apart from
+// the ETag header and the Date header, and the ETag appears exactly when a tag is expected.
+func TestETagDifferential(t *testing.T) {
+	hijackWrite := func(w http.ResponseWriter, s string) {
+		conn, rw, err := w.(http.Hijacker).Hijack()
+		if err != nil {
+			return
+		}
+		rw.WriteString(s)
+		rw.Flush()
+		conn.Close()
+	}
+	scenarios := []struct {
+		name   string
+		body   string // bytes the handler writes for a GET
+		tagged bool   // a 200 that is buffered and tagged
+		h      func(w http.ResponseWriter, r *http.Request)
+	}{
+		{"implicit write", "hello", true, func(w http.ResponseWriter, r *http.Request) {
+			w.Write([]byte("hello"))
+		}},
+		{"explicit 200", "hello", true, func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(200)
+			w.Write([]byte("hello"))
+		}},
+		{"200 with no body", "", true, func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(200)
+		}},
+		{"no writes", "", true, func(w http.ResponseWriter, r *http.Request) {}},
+		{"many writes", "abc", true, func(w http.ResponseWriter, r *http.Request) {
+			w.Write([]byte("a"))
+			w.Write([]byte("b"))
+			w.Write([]byte("c"))
+		}},
+		{"header changed after write", "ab", true, func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("X-Early", "1")
+			w.Write([]byte("a"))
+			w.Header().Set("X-Late", "2")
+			w.Write([]byte("b"))
+		}},
+		{"second WriteHeader", "a", true, func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(200)
+			w.Write([]byte("a"))
+			w.WriteHeader(500)
+		}},
+		{"early hints then 200", "hi", true, func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Link", "</a.css>; rel=preload")
+			w.WriteHeader(103)
+			w.WriteHeader(200)
+			w.Write([]byte("hi"))
+		}},
+		{"201", "x", false, func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(201)
+			w.Write([]byte("x"))
+		}},
+		{"404", "nope", false, func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(404)
+			w.Write([]byte("nope"))
+		}},
+		{"WriteHeader(500) after implicit 200", "x", true, func(w http.ResponseWriter, r *http.Request) {
+			w.Write([]byte("x"))
+			w.WriteHeader(500)
+		}},
+		{"flush after write", "ab", false, func(w http.ResponseWriter, r *http.Request) {
+			w.Write([]byte("a"))
+			w.(http.Flusher).Flush()
+			w.Write([]byte("b"))
+		}},
+		{"header changed before flush", "ab", false, func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("X-Early", "1")
+			w.Write([]byte("a"))
+			w.Header().Set("X-Late", "2")
+			w.(http.Flusher).Flush()
+			w.Write([]byte("b"))
+		}},
+		{"flush only", "", false, func(w http.ResponseWriter, r *http.Request) {
+			w.(http.Flusher).Flush()
+		}},
+		{"hijack after write", "", false, func(w http.ResponseWriter, r *http.Request) {
+			w.Write([]byte("hi"))
+			hijackWrite(w, "RAW")
+		}},
+		{"hijack first", "", false, func(w http.ResponseWriter, r *http.Request) {
+			hijackWrite(w, "RAW")
+		}},
+		{"write after hijack", "", false, func(w http.ResponseWriter, r *http.Request) {
+			hijackWrite(w, "RAW")
+			w.Write([]byte("late"))
+		}},
+	}
+	for _, sc := range scenarios {
+		t.Run(sc.name, func(t *testing.T) {
+			plain := httptest.NewServer(http.HandlerFunc(sc.h))
+			defer plain.Close()
+			wrapped := httptest.NewServer(ETag(http.HandlerFunc(sc.h)))
+			defer wrapped.Close()
+			for _, method := range []string{"GET", "HEAD"} {
+				want := stripVolatile(rawResponse(t, plain, method))
+				raw := rawResponse(t, wrapped, method)
+				assertEqual(t, stripVolatile(raw), want)
+
+				tag := rawHeader(raw, "ETag")
+				if sc.tagged && (method == "GET" || sc.body != "") {
+					assertEqual(t, tag, wantTag(sc.body))
+				} else {
+					assertEqual(t, tag, "")
+				}
+			}
+		})
+	}
+}
