+func TestETagIfNoneMatch(t *testing.T) {
+	cases := []struct {
+		name  string
+		tag   string   // ETag the handler sets; empty leaves the generated tag
+		lines []string // If-None-Match header lines
+		want  int
+	}{
+		{"exact strong", `"a"`, []string{`"a"`}, 304},
+		{"weak request matches strong", `"a"`, []string{`W/"a"`}, 304},
+		{"strong request matches weak", `W/"a"`, []string{`"a"`}, 304},
+		{"weak both sides", `W/"a"`, []string{`W/"a"`}, 304},
+		{"case sensitive", `"A"`, []string{`"a"`}, 200},
+		{"different tag", `"a"`, []string{`"b"`}, 200},
+		{"list with spaces", `"a"`, []string{` "x" ,  "a" ,W/"c"`}, 304},
+		{"list with tabs", `"b"`, []string{"\t\"a\",\t\"b\""}, 304},
+		{"list no match", `"z"`, []string{`"a", "b",W/"c"`}, 200},
+		{"multiple lines combined", `"c"`, []string{`"a"`, `"b", "c"`}, 304},
+		{"star alone", `"a"`, []string{"*"}, 304},
+		{"star with spaces", `"a"`, []string{"  *  "}, 304},
+		{"star on generated tag", "", []string{"*"}, 304},
+		{"star with valid match", `"x"`, []string{`"x", *`}, 304},
+		{"star with no valid match", `"b"`, []string{`"x", *`}, 200},
+		{"comma inside quotes matches", `"a,b"`, []string{`"a,b"`}, 304},
+		{"comma inside quotes is not a", `"a"`, []string{`"a,b"`}, 200},
+		{"comma inside quotes is not b", `"b"`, []string{`"a,b"`}, 200},
+		{"unquoted member", `abc`, []string{`abc`}, 200},
+		{"unquoted member beside valid", `"a"`, []string{`abc, "a"`}, 200},
+		{"unterminated quote", `"abc`, []string{`"abc`}, 200},
+		{"unterminated quote in list", `"a"`, []string{`"a, "b"`}, 200},
+		{"weak without quotes", `W/abc`, []string{`W/abc`}, 200},
+		{"lowercase weak prefix", `"x"`, []string{`w/"x"`}, 200},
+		{"empty value", "", []string{""}, 200},
+		{"only commas and spaces", `"x"`, []string{" , , "}, 200},
+		{"empty list elements skipped", `"x"`, []string{`, "x",`}, 304},
+		{"malformed response tag", `abc`, []string{`abc`}, 200},
+		{"malformed response tag vs quoted", `abc`, []string{`"abc"`}, 200},
+		{"malformed response tag vs star", `abc`, []string{"*"}, 304},
+		{"control character in member", `"a"`, []string{"\"a\x01\""}, 200},
+		{"quote inside member", `"a"`, []string{`"a""`}, 200},
+		{"non-ASCII obs-text", `"é"`, []string{`"é"`}, 304},
+		{"empty opaque tag", `""`, []string{`""`}, 304},
+		{"space inside response tag", `"a b"`, []string{`"a b"`}, 200},
+		{"quote inside response tag", `"a"b"`, []string{`"a"b"`}, 200},
+		{"control inside response tag", "\"a\x01b\"", []string{"\"a\x01b\""}, 200},
+		{"DEL inside response tag", "\"a\x7fb\"", []string{"\"a\x7fb\""}, 200},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if tc.tag != "" {
+					w.Header().Set("ETag", tc.tag)
+				}
+				w.Write([]byte("body"))
+			})
+			assertEqual(t, etagRecord(h, "GET", tc.lines...).Code, tc.want)
+		})
+	}
+}
