+// Headers changed after the first WriteHeader or Write do not reach the client; the first WriteHeader wins.
+func TestETagHeaderSnapshot(t *testing.T) {
+	ts := httptest.NewServer(ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("X-Early", "1")
+		if r.URL.Path == "/missing" {
+			w.WriteHeader(http.StatusNotFound)
+			w.Header().Set("X-Late", "2")
+			w.Write([]byte("nope"))
+			return
+		}
+		w.WriteHeader(http.StatusOK)
+		w.Header().Set("X-Late", "2")
+		w.Write([]byte("x"))
+		w.WriteHeader(http.StatusInternalServerError)
+		w.Header().Set("X-Later", "3")
+		w.Write([]byte("y"))
+	})))
+	defer ts.Close()
+
+	resp, body := testRequest(t, ts, "GET", "/", nil)
+	assertEqual(t, resp.StatusCode, http.StatusOK)
+	assertEqual(t, resp.Header.Get("X-Early"), "1")
+	assertEqual(t, resp.Header.Get("X-Late"), "")
+	assertEqual(t, resp.Header.Get("X-Later"), "")
+	assertEqual(t, body, "xy")
+
+	resp, body = testRequest(t, ts, "GET", "/missing", nil)
+	assertEqual(t, resp.StatusCode, http.StatusNotFound)
+	assertEqual(t, resp.Header.Get("X-Early"), "1")
+	assertEqual(t, resp.Header.Get("X-Late"), "")
+	assertEqual(t, body, "nope")
+}
