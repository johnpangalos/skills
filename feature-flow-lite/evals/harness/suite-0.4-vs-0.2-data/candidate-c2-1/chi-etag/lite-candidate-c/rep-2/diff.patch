+func TestETagPassThroughStatuses(t *testing.T) {
+	for _, code := range []int{201, 204, 206, 301, 304, 404, 500} {
+		h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("ETag", `"a"`)
