+func TestETagOptionalInterfaces(t *testing.T) {
+	var hijackErr, pushErr error
+	rec := httptest.NewRecorder()
+	ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, _, hijackErr = w.(http.Hijacker).Hijack()
+		pushErr = w.(http.Pusher).Push("/x", nil)
+	})).ServeHTTP(rec, httptest.NewRequest("GET", "/", nil))
+	assertEqual(t, fmt.Sprint(hijackErr), "chi/middleware: http.Hijacker is unavailable on the writer")
+	assertEqual(t, fmt.Sprint(pushErr), "chi/middleware: http.Pusher is unavailable on the writer")
+
+	// Unwrap lets ResponseController reach the server's writer.
+	deadlines := make(chan error, 2)
+	ts := httptest.NewServer(ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		rc := http.NewResponseController(w)
+		deadlines <- rc.SetWriteDeadline(time.Now().Add(time.Minute))
+		deadlines <- rc.EnableFullDuplex()
+		w.Write([]byte("ok"))
+	})))
+	defer ts.Close()
+	testRequest(t, ts, "GET", "/", nil)
+	for i := 0; i < 2; i++ {
+		if err := <-deadlines; err != nil {
+			t.Fatalf("ResponseController call %d: %v", i, err)
+		}
+	}
+
+	// After a successful Hijack the middleware writes nothing more, and later writes fail as net/http's do.
+	writeErr := make(chan error, 1)
+	hj := httptest.NewServer(ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		conn, rw, err := w.(http.Hijacker).Hijack()
+		if err != nil {
+			writeErr <- err
+			return
+		}
+		rw.WriteString("RAW")
+		rw.Flush()
+		_, err = w.Write([]byte("late"))
+		writeErr <- err
+		conn.Close()
+	})))
+	defer hj.Close()
+	assertEqual(t, rawResponse(t, hj, "GET"), "RAW")
+	if err := <-writeErr; !errors.Is(err, http.ErrHijacked) {
+		t.Fatalf("write after hijack: got %v", err)
+	}
+}
