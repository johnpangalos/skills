diff --git a/middleware/etag.go b/middleware/etag.go
new file mode 100644
index 0000000..44641cf
--- /dev/null
+++ b/middleware/etag.go
@@ -0,0 +1,288 @@
+package middleware
+
+import (
+	"bufio"
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"maps"
+	"net"
+	"net/http"
+	"strings"
+)
+
+// ETag buffers the whole response to a GET or HEAD request in memory. A 200 response
+// that doesn't set its own ETag gets a strong one: a hex SHA-256 of the bytes the
+// handler writes. If the If-None-Match request header matches the response's ETag,
+// the client gets 304 Not Modified with no body. The ETag is computed from the body
+// bytes, so use ETag before Compress if both are used, so each encoding gets its own tag.
+// Use ETag before NoCache too, since NoCache strips If-None-Match from the request.
+//
+// A handler Flush switches the response to streaming: from then on it is sent as
+// written, with no generated ETag and no 304. Other methods and statuses pass through
+// unchanged.
+func ETag(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet && r.Method != http.MethodHead {
+			next.ServeHTTP(w, r)
+			return
+		}
+		ew := &etagResponseWriter{
+			ResponseWriter: w,
+			head:           r.Method == http.MethodHead,
+			ifNoneMatch:    r.Header.Values("If-None-Match"),
+		}
+		next.ServeHTTP(ew, r)
+		ew.finish()
+	})
+}
+
+// etagResponseWriter holds a GET or HEAD response until the handler returns, so the
+// ETag can be computed from the whole body.
+type etagResponseWriter struct {
+	http.ResponseWriter
+	head        bool
+	ifNoneMatch []string
+	wroteHeader bool        // the handler's final status is recorded
+	code        int         // the handler's final status
+	header      http.Header // headers as they were at the first WriteHeader or Write
+	buf         bytes.Buffer
+	sent        bool // status and headers went to the client; later calls pass through
+}
+
+func (w *etagResponseWriter) WriteHeader(code int) {
+	if w.wroteHeader {
+		return
+	}
+	if code >= 100 && code <= 199 && code != http.StatusSwitchingProtocols {
+		w.ResponseWriter.WriteHeader(code) // informational, not the final status
+		return
+	}
+	w.wroteHeader = true
+	w.code = code
+	w.header = w.ResponseWriter.Header().Clone()
+	if code != http.StatusOK {
+		w.stream()
+	}
+}
+
+func (w *etagResponseWriter) Write(p []byte) (int, error) {
+	if !w.wroteHeader {
+		w.WriteHeader(http.StatusOK)
+	}
+	if w.sent {
+		return w.ResponseWriter.Write(p)
+	}
+	return w.buf.Write(p)
+}
+
+func (w *etagResponseWriter) Flush() {
+	if !w.wroteHeader {
+		w.WriteHeader(http.StatusOK)
+	}
+	if !w.sent {
+		w.stream()
+	}
+	if f, ok := w.ResponseWriter.(http.Flusher); ok {
+		f.Flush()
+	}
+}
+
+func (w *etagResponseWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	hj, ok := w.ResponseWriter.(http.Hijacker)
+	if !ok {
+		return nil, nil, errors.New("chi/middleware: http.Hijacker is unavailable on the writer")
+	}
+	if w.wroteHeader && !w.sent {
+		w.stream()
+	}
+	conn, rw, err := hj.Hijack()
+	if err == nil {
+		w.sent = true // the connection is no longer ours to write to
+	}
+	return conn, rw, err
+}
+
+func (w *etagResponseWriter) Push(target string, opts *http.PushOptions) error {
+	if ps, ok := w.ResponseWriter.(http.Pusher); ok {
+		return ps.Push(target, opts)
+	}
+	return errors.New("chi/middleware: http.Pusher is unavailable on the writer")
+}
+
+func (w *etagResponseWriter) Unwrap() http.ResponseWriter {
+	return w.ResponseWriter
+}
+
+// stream sends the recorded status, the headers from the first write and any buffered
+// body. Later calls pass straight through.
+func (w *etagResponseWriter) stream() {
+	w.sent = true
+	trailers := w.restoreHeader()
+	w.ResponseWriter.WriteHeader(w.code)
+	w.putTrailers(trailers)
+	if w.buf.Len() > 0 {
+		w.ResponseWriter.Write(w.buf.Bytes())
+	}
+	w.buf = bytes.Buffer{}
+}
+
+// restoreHeader resets the live header map to the snapshot, so headers changed after the
+// first write are dropped, as net/http drops them. It returns the live value of each trailer,
+// nil where the handler has deleted it. net/http reads trailers from the live map after the
+// handler returns, so the caller puts them back with putTrailers once the underlying
+// WriteHeader has taken its snapshot.
+func (w *etagResponseWriter) restoreHeader() http.Header {
+	h := w.ResponseWriter.Header()
+	trailers := make(http.Header)
+	for k, v := range h {
+		if w.isTrailer(k) {
+			trailers[k] = v
+		}
+	}
+	for k := range w.header {
+		if _, ok := trailers[k]; !ok && w.isTrailer(k) {
+			trailers[k] = nil
+		}
+	}
+	clear(h)
+	maps.Copy(h, w.header)
+	return trailers
+}
+
+// putTrailers puts the trailers from restoreHeader back in the live header map. A nil
+// value removes the key.
+func (w *etagResponseWriter) putTrailers(trailers http.Header) {
+	h := w.ResponseWriter.Header()
+	for k, v := range trailers {
+		if v == nil {
+			delete(h, k)
+		} else {
+			h[k] = v
+		}
+	}
+}
+
+// isTrailer reports whether key is a trailer: a name the snapshot's Trailer header declares,
+// or a key with the http.TrailerPrefix prefix.
+func (w *etagResponseWriter) isTrailer(key string) bool {
+	if strings.HasPrefix(key, http.TrailerPrefix) {
+		return true
+	}
+	for _, v := range w.header.Values("Trailer") {
+		for _, name := range strings.Split(v, ",") {
+			if http.CanonicalHeaderKey(strings.TrimSpace(name)) == key {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// finish sends a buffered response once the handler has returned. A handler that
+// panics never reaches finish, so nothing is sent.
+func (w *etagResponseWriter) finish() {
+	if w.sent {
+		return
+	}
+	if !w.wroteHeader {
+		w.WriteHeader(http.StatusOK)
+	}
+	trailers := w.restoreHeader()
+	h := w.ResponseWriter.Header()
+	if h.Get("ETag") == "" && (!w.head || w.buf.Len() > 0) {
+		h.Set("ETag", strongTag(w.buf.Bytes()))
+	}
+	code := http.StatusOK
+	if matchesIfNoneMatch(w.ifNoneMatch, h.Get("ETag")) {
+		h.Del("Content-Length")
+		h.Del("Content-Type")
+		h.Del("Content-Encoding")
+		code = http.StatusNotModified
+	}
+	w.ResponseWriter.WriteHeader(code)
+	w.putTrailers(trailers)
+	if code == http.StatusOK && w.buf.Len() > 0 {
+		w.ResponseWriter.Write(w.buf.Bytes())
+	}
+}
+
+// strongTag returns the strong entity-tag for body: its SHA-256 digest in quotes.
+func strongTag(body []byte) string {
+	sum := sha256.Sum256(body)
+	return `"` + hex.EncodeToString(sum[:]) + `"`
+}
+
+// matchesIfNoneMatch reports whether the If-None-Match lines match etag, the ETag of a
+// 200 response to GET or HEAD. etag is empty when the response has none. The comparison
+// is weak (RFC 9110 section 13.1.2): a W/ prefix is ignored on both sides.
+func matchesIfNoneMatch(lines []string, etag string) bool {
+	members, ok := parseIfNoneMatch(lines)
+	if !ok {
+		return false
+	}
+	if len(members) == 1 && members[0] == "*" {
+		return true
+	}
+	want, ok := opaqueTag(etag)
+	if !ok {
+		return false
+	}
+	for _, m := range members {
+		if got, ok := opaqueTag(m); ok && got == want {
+			return true
+		}
+	}
+	return false
+}
+
+// parseIfNoneMatch returns the members of the If-None-Match lines, which form one list.
+// ok is false if any member is neither "*" nor a valid entity-tag.
+func parseIfNoneMatch(lines []string) (members []string, ok bool) {
+	for _, line := range lines {
+		for _, m := range splitMembers(line) {
+			m = strings.Trim(m, " \t")
+			if m == "" {
+				continue // empty list elements are allowed (RFC 9110 section 5.6.1)
+			}
+			if _, valid := opaqueTag(m); !valid && m != "*" {
+				return nil, false
+			}
+			members = append(members, m)
+		}
+	}
+	return members, true
+}
+
+// splitMembers splits a list header value on the commas outside quoted strings.
+func splitMembers(line string) []string {
+	var members []string
+	start, quoted := 0, false
+	for i := 0; i < len(line); i++ {
+		switch {
+		case line[i] == '"':
+			quoted = !quoted
+		case line[i] == ',' && !quoted:
+			members = append(members, line[start:i])
+			start = i + 1
+		}
+	}
+	return append(members, line[start:])
+}
+
+// opaqueTag strips a W/ prefix from an entity-tag and returns the quoted opaque-tag. It
+// reports false if s is not a valid entity-tag: the opaque-tag may not hold DQUOTE,
+// control characters, space or DEL.
+func opaqueTag(s string) (string, bool) {
+	s = strings.TrimPrefix(s, "W/")
+	if len(s) < 2 || s[0] != '"' || s[len(s)-1] != '"' {
+		return "", false
+	}
+	for i := 1; i < len(s)-1; i++ {
+		if c := s[i]; c < 0x21 || c == '"' || c == 0x7f {
+			return "", false
+		}
+	}
+	return s, true
+}
diff --git a/middleware/etag_test.go b/middleware/etag_test.go
new file mode 100644
index 0000000..0d77a90
--- /dev/null
+++ b/middleware/etag_test.go
@@ -0,0 +1,948 @@
+package middleware
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"io"
+	"math/rand"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/http/httptrace"
+	"net/textproto"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/go-chi/chi/v5"
+)
+
+var _ func(http.Handler) http.Handler = ETag
+
+// wantTag is the strong ETag the middleware should generate for body.
+func wantTag(body string) string {
+	sum := sha256.Sum256([]byte(body))
+	return `"` + hex.EncodeToString(sum[:]) + `"`
+}
+
+func writeBody(s string) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte(s))
+	}
+}
+
+// etagRecord runs h through ETag with a recorder, sending one If-None-Match line per argument.
+func etagRecord(h http.Handler, method string, ifNoneMatch ...string) *httptest.ResponseRecorder {
+	req := httptest.NewRequest(method, "/", nil)
+	for _, v := range ifNoneMatch {
+		req.Header.Add("If-None-Match", v)
+	}
+	rec := httptest.NewRecorder()
+	ETag(h).ServeHTTP(rec, req)
+	return rec
+}
+
+// timedRequest builds a GET that gives up after five seconds, so a stuck exchange fails the test.
+func timedRequest(t *testing.T, url string, ifNoneMatch ...string) *http.Request {
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	t.Cleanup(cancel)
+	req, err := http.NewRequestWithContext(ctx, "GET", url, nil)
+	assertNoError(t, err)
+	for _, v := range ifNoneMatch {
+		req.Header.Add("If-None-Match", v)
+	}
+	return req
+}
+
+// getAsync sends req in the background, so a test can see when the response headers arrive.
+// It sends nil if the request fails.
+func getAsync(t *testing.T, req *http.Request) <-chan *http.Response {
+	out := make(chan *http.Response, 1)
+	go func() {
+		resp, err := http.DefaultClient.Do(req)
+		if err != nil {
+			t.Error(err)
+		}
+		out <- resp
+	}()
+	return out
+}
+
+// rawResponse sends method to ts over a plain TCP connection and returns every byte the server wrote.
+func rawResponse(t *testing.T, ts *httptest.Server, method string) string {
+	conn, err := net.Dial("tcp", ts.Listener.Addr().String())
+	assertNoError(t, err)
+	defer conn.Close()
+	fmt.Fprintf(conn, "%s / HTTP/1.1\r\nHost: test\r\nConnection: close\r\n\r\n", method)
+	assertNoError(t, conn.SetReadDeadline(time.Now().Add(5*time.Second)))
+	raw, err := io.ReadAll(conn)
+	assertNoError(t, err)
+	return string(raw)
+}
+
+// stripVolatile drops the Date and ETag header lines, which differ between a plain and a wrapped response.
+func stripVolatile(raw string) string {
+	var keep []string
+	for _, line := range strings.SplitAfter(raw, "\r\n") {
+		if _, ok := rawHeaderValue(line, "Date"); ok {
+			continue
+		}
+		if _, ok := rawHeaderValue(line, "ETag"); ok {
+			continue
+		}
+		keep = append(keep, line)
+	}
+	return strings.Join(keep, "")
+}
+
+// rawHeader returns the value of the first header called name in a raw response.
+// Header names are matched case-insensitively, because net/http writes ETag as Etag.
+func rawHeader(raw, name string) string {
+	for _, line := range strings.Split(raw, "\r\n") {
+		if v, ok := rawHeaderValue(line, name); ok {
+			return v
+		}
+	}
+	return ""
+}
+
+func rawHeaderValue(line, name string) (string, bool) {
+	key, value, found := strings.Cut(line, ":")
+	if !found || !strings.EqualFold(strings.TrimSpace(key), name) {
+		return "", false
+	}
+	return strings.TrimSpace(value), true
+}
+
+func TestETagAPI(t *testing.T) {
+	h := writeBody("hi")
+	r := chi.NewRouter()
+	r.Use(ETag)
+	r.Get("/", h)
+	ts := httptest.NewServer(r)
+	defer ts.Close()
+
+	resp, body := testRequest(t, ts, "GET", "/", nil)
+	assertEqual(t, body, "hi")
+	assertEqual(t, resp.Header.Get("ETag"), wantTag("hi"))
+
+	rec := etagRecord(h, "GET")
+	assertEqual(t, rec.Header().Get("ETag"), wantTag("hi"))
+}
+
+func TestETagGeneratedTag(t *testing.T) {
+	explicit := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("X-Test", "yes")
+		w.WriteHeader(http.StatusOK)
+		w.Write([]byte("hello"))
+	})
+	implicit := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("X-Test", "yes")
+		w.Write([]byte("hello"))
+	})
+	for _, h := range []http.Handler{explicit, implicit} {
+		rec := etagRecord(h, "GET")
+		assertEqual(t, rec.Code, http.StatusOK)
+		assertEqual(t, rec.Header().Get("ETag"), wantTag("hello"))
+		assertEqual(t, rec.Header().Get("X-Test"), "yes")
+		assertEqual(t, rec.Body.String(), "hello")
+	}
+
+	assertEqual(t, etagRecord(writeBody("hello"), "GET").Header().Get("ETag"), wantTag("hello"))
+	if etagRecord(writeBody("world"), "GET").Header().Get("ETag") == wantTag("hello") {
+		t.Fatal("different bodies got the same ETag")
+	}
+}
+
+func TestETagEmptyBody(t *testing.T) {
+	onlyStatus := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusOK)
+	})
+	nothing := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {})
+	for _, h := range []http.Handler{onlyStatus, nothing} {
+		rec := etagRecord(h, "GET")
+		assertEqual(t, rec.Code, http.StatusOK)
+		assertEqual(t, rec.Header().Get("ETag"), wantTag(""))
+		assertEqual(t, rec.Body.String(), "")
+	}
+}
+
+func TestETagChunkedWrites(t *testing.T) {
+	chunked := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		for i := 0; i < 1000; i++ {
+			w.Write([]byte("ab"))
+		}
+	})
+	rec := etagRecord(chunked, "GET")
+	assertEqual(t, rec.Body.String(), strings.Repeat("ab", 1000))
+	assertEqual(t, rec.Header().Get("ETag"), wantTag(strings.Repeat("ab", 1000)))
+}
+
+func TestETagLargeBody(t *testing.T) {
+	big := strings.Repeat("0123456789abcdef", 4<<20/16)
+	ts := httptest.NewServer(ETag(writeBody(big)))
+	defer ts.Close()
+
+	resp, body := testRequest(t, ts, "GET", "/", nil)
+	assertEqual(t, len(body), len(big))
+	assertEqual(t, body == big, true)
+	assertEqual(t, resp.Header.Get("ETag"), wantTag(big))
+}
+
+// Property: however a body is split across Writes, the tag and bytes are those of one Write.
+func TestETagPropertyRandomSplits(t *testing.T) {
+	rnd := rand.New(rand.NewSource(1))
+	for i := 0; i < 200; i++ {
+		body := make([]byte, rnd.Intn(5000))
+		for j := range body {
+			body[j] = byte(rnd.Intn(256))
+		}
+		h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			for rest := body; len(rest) > 0; {
+				n := 1 + rnd.Intn(len(rest))
+				w.Write(rest[:n])
+				rest = rest[n:]
+			}
+		})
+		rec := etagRecord(h, "GET")
+		if !bytes.Equal(rec.Body.Bytes(), body) {
+			t.Fatalf("iteration %d: body changed", i)
+		}
+		assertEqual(t, rec.Header().Get("ETag"), wantTag(string(body)))
+	}
+}
+
+// Concurrency: many goroutines hit one handler on the same key and each gets its own body and tag.
+func TestETagConcurrent(t *testing.T) {
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("payload " + r.URL.Path))
+	}))
+	var wg sync.WaitGroup
+	for g := 0; g < 16; g++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for i := 0; i < 50; i++ {
+				req := httptest.NewRequest("GET", "/same", nil)
+				conditional := i%2 == 1
+				if conditional {
+					req.Header.Set("If-None-Match", wantTag("payload /same"))
+				}
+				rec := httptest.NewRecorder()
+				h.ServeHTTP(rec, req)
+				if conditional {
+					if rec.Code != http.StatusNotModified || rec.Body.Len() != 0 {
+						t.Errorf("conditional: got %d with %d body bytes", rec.Code, rec.Body.Len())
+					}
+				} else if rec.Code != http.StatusOK || rec.Body.String() != "payload /same" {
+					t.Errorf("got %d %q", rec.Code, rec.Body.String())
+				}
+				if rec.Header().Get("ETag") != wantTag("payload /same") {
+					t.Errorf("ETag %q", rec.Header().Get("ETag"))
+				}
+			}
+		}()
+	}
+	wg.Wait()
+}
+
+func TestETagHandlerSetTag(t *testing.T) {
+	for _, tag := range []string{`"mine"`, `W/"weak"`} {
+		h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("ETag", tag)
+			w.Write([]byte("body"))
+		})
+		assertEqual(t, etagRecord(h, "GET").Header().Get("ETag"), tag)
+		assertEqual(t, etagRecord(h, "GET", tag).Code, http.StatusNotModified)
+	}
+}
+
+func TestETagHEAD(t *testing.T) {
+	assertEqual(t, etagRecord(writeBody("full"), "HEAD").Header().Get("ETag"), wantTag("full"))
+	assertEqual(t, etagRecord(writeBody("full"), "GET").Header().Get("ETag"), wantTag("full"))
+
+	none := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {})
+	assertEqual(t, etagRecord(none, "HEAD").Header().Get("ETag"), "")
+
+	withLength := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Length", "10")
+	})
+	rec := etagRecord(withLength, "HEAD")
+	assertEqual(t, rec.Header().Get("ETag"), "")
+	assertEqual(t, rec.Header().Get("Content-Length"), "10")
+
+	tagged := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("ETag", `"h"`)
+	})
+	assertEqual(t, etagRecord(tagged, "HEAD").Header().Get("ETag"), `"h"`)
+	assertEqual(t, etagRecord(tagged, "HEAD", `"h"`).Code, http.StatusNotModified)
+	assertEqual(t, etagRecord(none, "HEAD", "*").Code, http.StatusNotModified)
+
+	// GetHead routes HEAD to the GET handler, which writes the body.
+	r := chi.NewRouter()
+	r.Use(GetHead)
+	r.Use(ETag)
+	r.Get("/x", writeBody("full"))
+	ts := httptest.NewServer(r)
+	defer ts.Close()
+	resp, body := testRequest(t, ts, "HEAD", "/x", nil)
+	assertEqual(t, body, "")
+	assertEqual(t, resp.Header.Get("ETag"), wantTag("full"))
+}
+
+func TestETag304(t *testing.T) {
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Cache-Control", "max-age=60")
+		w.Header().Set("Vary", "Accept")
+		w.Header().Set("Expires", "Thu, 01 Jan 2099 00:00:00 GMT")
+		w.Header().Set("Content-Location", "/other")
+		w.Header().Set("Set-Cookie", "sid=1")
+		w.Header().Set("X-Custom", "c")
+		w.Header().Set("Content-Type", "text/plain")
+		w.Header().Set("Content-Encoding", "gzip")
+		w.Header().Set("Content-Length", "5")
+		w.Write([]byte("hello"))
+	})
+	for _, method := range []string{"GET", "HEAD"} {
+		rec := etagRecord(h, method, wantTag("hello"))
+		assertEqual(t, rec.Code, http.StatusNotModified)
+		assertEqual(t, rec.Body.String(), "")
+		assertEqual(t, rec.Header().Get("ETag"), wantTag("hello"))
+		assertEqual(t, rec.Header().Get("Cache-Control"), "max-age=60")
+		assertEqual(t, rec.Header().Get("Vary"), "Accept")
+		assertEqual(t, rec.Header().Get("Expires"), "Thu, 01 Jan 2099 00:00:00 GMT")
+		assertEqual(t, rec.Header().Get("Content-Location"), "/other")
+		assertEqual(t, rec.Header().Get("Set-Cookie"), "sid=1")
+		assertEqual(t, rec.Header().Get("X-Custom"), "c")
+		assertEqual(t, rec.Header().Get("Content-Length"), "")
+		assertEqual(t, rec.Header().Get("Content-Type"), "")
+		assertEqual(t, rec.Header().Get("Content-Encoding"), "")
+	}
+
+	rec := etagRecord(h, "GET", `"other"`)
+	assertEqual(t, rec.Code, http.StatusOK)
+	assertEqual(t, rec.Body.String(), "hello")
+	assertEqual(t, rec.Header().Get("Content-Type"), "text/plain")
+}
