+// A 1xx is forwarded before the handler finishes, and the later 200 is still buffered and tagged.
+func TestETagInformational(t *testing.T) {
+	early := make(chan struct{})
+	release := make(chan struct{})
+	ts := httptest.NewServer(ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusEarlyHints)
+		<-release
+		w.Write([]byte("hi"))
+	})))
+	defer ts.Close()
+	done := sync.OnceFunc(func() { close(release) })
+	defer done()
+
+	var once sync.Once
+	trace := &httptrace.ClientTrace{
+		Got1xxResponse: func(code int, _ textproto.MIMEHeader) error {
+			if code == http.StatusEarlyHints {
+				once.Do(func() { close(early) })
+			}
+			return nil
+		},
+	}
+	req := timedRequest(t, ts.URL)
+	req = req.WithContext(httptrace.WithClientTrace(req.Context(), trace))
+	out := getAsync(t, req)
+
+	select {
+	case <-early:
+	case <-time.After(5 * time.Second):
+		t.Fatal("103 was not forwarded before the handler finished")
+	}
+	done()
+	resp := <-out
+	if resp == nil {
+		t.FailNow()
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(resp.Body)
+	assertNoError(t, err)
+	assertEqual(t, string(body), "hi")
+	assertEqual(t, resp.StatusCode, http.StatusOK)
+	assertEqual(t, resp.Header.Get("ETag"), wantTag("hi"))
+}
