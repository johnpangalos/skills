+// Trailers set after the first write are delivered as trailers, as net/http does.
+func TestETag_TrailersAfterWriteMatchNetHTTP(t *testing.T) {
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Trailer", "X-Sum")
+		w.Write([]byte("hello"))
+		w.Header().Set("X-Sum", "abc")
+		w.Header().Set(http.TrailerPrefix+"X-Late", "1")
+		w.Header().Set("X-Not-Trailer", "2")
+	})
+	plain, plainBody := etagGet(t, h)
+	wrapped, wrappedBody := etagGet(t, ETag(h))
+	assertEqual(t, wrapped.StatusCode, plain.StatusCode)
+	assertEqual(t, wrappedBody, plainBody)
+	assertEqual(t, wrapped.Trailer.Get("X-Sum"), "abc")
+	assertEqual(t, wrapped.Trailer.Get("X-Late"), "1")
+	assertEqual(t, wrapped.Trailer, plain.Trailer)
+}
