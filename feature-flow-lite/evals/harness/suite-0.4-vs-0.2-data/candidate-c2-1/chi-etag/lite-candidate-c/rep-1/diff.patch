+// etagRawHijack serves h on a real server and returns the bytes it writes to a
+// raw connection, with the Date header removed.
+func etagRawHijack(t *testing.T, h http.Handler) string {
+	t.Helper()
+	srv := httptest.NewServer(h)
+	defer srv.Close()
+	conn, err := net.Dial("tcp", srv.Listener.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	fmt.Fprint(conn, "GET / HTTP/1.1\r\nHost: example.com\r\n\r\n")
+	out, err := io.ReadAll(conn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return regexp.MustCompile(`Date: [^\r]*\r\n`).ReplaceAllString(string(out), "")
+}
