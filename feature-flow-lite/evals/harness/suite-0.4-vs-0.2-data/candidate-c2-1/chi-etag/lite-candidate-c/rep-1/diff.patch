+// Criterion 9: Flusher, Hijacker, Pusher and Unwrap as compress.go has them.
+func TestETag_WrapperCapabilities(t *testing.T) {
+	t.Run("Flush is forwarded once a non-200 status passes through", func(t *testing.T) {
+		rec := httptest.NewRecorder()
+		h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(http.StatusNotFound)
+			w.Write([]byte("missing"))
+			if err := http.NewResponseController(w).Flush(); err != nil {
+				t.Errorf("ResponseController.Flush: %v", err)
+			}
+			if !rec.Flushed {
+				t.Errorf("Flush was not forwarded for a 404")
+			}
+		})
+		ETag(h).ServeHTTP(rec, etagRequest(http.MethodGet))
+		assertEqual(t, rec.Code, http.StatusNotFound)
+	})
+	t.Run("Unwrap returns the original writer", func(t *testing.T) {
+		rec := httptest.NewRecorder()
+		h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			u, ok := w.(interface{ Unwrap() http.ResponseWriter })
+			if !ok || u.Unwrap() != http.ResponseWriter(rec) {
+				t.Errorf("Unwrap did not return the original writer")
+			}
+		})
+		ETag(h).ServeHTTP(rec, etagRequest(http.MethodGet))
+	})
+	t.Run("Hijack forwards and nothing is written afterwards", func(t *testing.T) {
+		tw := &etagTestWriter{ResponseRecorder: httptest.NewRecorder()}
+		h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Write([]byte("hello"))
+			if _, _, err := http.NewResponseController(w).Hijack(); err != nil {
+				t.Errorf("Hijack: %v", err)
+			}
+		})
+		ETag(h).ServeHTTP(tw, etagRequest(http.MethodGet))
+		if !tw.hijacked {
+			t.Fatalf("Hijack was not forwarded")
+		}
+		assertEqual(t, tw.writesAfterHijack, 0)
+		assertEqual(t, tw.Body.String(), "hello")
+	})
+	t.Run("Push forwards to the writer", func(t *testing.T) {
+		tw := &etagTestWriter{ResponseRecorder: httptest.NewRecorder()}
+		h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			if err := w.(http.Pusher).Push("/style.css", nil); err != nil {
+				t.Errorf("Push: %v", err)
+			}
+		})
+		ETag(h).ServeHTTP(tw, etagRequest(http.MethodGet))
+		assertEqual(t, tw.pushed, "/style.css")
+	})
+	t.Run("Hijack and Push report unavailable on a plain writer", func(t *testing.T) {
+		h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			_, _, err := w.(http.Hijacker).Hijack()
+			if err == nil || err.Error() != "chi/middleware: http.Hijacker is unavailable on the writer" {
+				t.Errorf("Hijack error = %v", err)
+			}
+			err = w.(http.Pusher).Push("/x", nil)
+			if err == nil || err.Error() != "chi/middleware: http.Pusher is unavailable on the writer" {
+				t.Errorf("Push error = %v", err)
+			}
+		})
+		ETag(h).ServeHTTP(httptest.NewRecorder(), etagRequest(http.MethodGet))
+	})
+	t.Run("1xx is forwarded immediately and does not fix the status", func(t *testing.T) {
+		tw := &etagTestWriter{ResponseRecorder: httptest.NewRecorder()}
+		h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Link", "</style.css>; rel=preload")
+			w.WriteHeader(http.StatusEarlyHints)
+			assertEqual(t, tw.codes, []int{103})
+			w.Write([]byte("hello"))
+		})
+		ETag(h).ServeHTTP(tw, etagRequest(http.MethodGet))
+		// The final 200 is implicit, so the recorder sees only the 103 plus the body write.
+		assertEqual(t, tw.codes, []int{103})
+		assertEqual(t, tw.Body.String(), "hello")
+	})
+}
