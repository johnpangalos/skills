+// TestETag_SeededProperty checks the ETag and If-None-Match rules over 1000
+// seeded random bodies, each written in random pieces. It stops at the first
+// failing input and prints it.
+func TestETag_SeededProperty(t *testing.T) {
+	const seed = 20260517
+	rng := rand.New(rand.NewSource(seed))
+	validTag := regexp.MustCompile(`^"[\x21\x23-\x7e]*"$`)
+	for i := range 1000 {
+		size := rng.Intn(4097)
+		if i%10 == 0 {
+			size = 0
+		}
+		body := make([]byte, size)
+		for j := range body {
+			body[j] = byte(rng.Intn(256))
+		}
+		writes := etagSplit(rng, body)
+		h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			for _, p := range writes {
+				w.Write(p)
+			}
+		})
+		want := etagOf(string(body))
+		check := func(ok bool, what, inm string) {
+			if !ok {
+				t.Fatalf("seed %d case %d: %s\n  If-None-Match=%q\n  writes=%d\n  body=%x", seed, i, what, inm, len(writes), body)
+			}
+		}
+
+		get := etagServe(h, http.MethodGet)
+		check(get.Code == http.StatusOK && get.Body.String() == string(body), "GET is 200 with the body", "")
+		check(get.Header().Get("ETag") == want && validTag.MatchString(want), "GET ETag is the strong SHA-256 tag", "")
+		check(etagServe(h, http.MethodGet).Header().Get("ETag") == want, "GET ETag is stable", "")
+		wantHead := want
+		if size == 0 {
+			wantHead = ""
+		}
+		check(etagServe(h, http.MethodHead).Header().Get("ETag") == wantHead, "HEAD ETag equals GET ETag, or is absent for an empty body", "")
+
+		other := fmt.Sprintf(`"%016x"`, rng.Uint64())
+		for _, inm := range []string{want, "W/" + want, etagList(rng, want), etagList(rng, "W/"+want)} {
+			rec := etagServe(h, http.MethodGet, inm)
+			check(rec.Code == http.StatusNotModified && rec.Body.Len() == 0 && rec.Header().Get("ETag") == want, "matching If-None-Match gives 304 with the ETag", inm)
+		}
+		for _, inm := range []string{other, etagList(rng, other)} {
+			rec := etagServe(h, http.MethodGet, inm)
+			check(rec.Code == http.StatusOK && rec.Body.String() == string(body) && rec.Header().Get("ETag") == want, "non-matching If-None-Match gives 200 with the body", inm)
+		}
+	}
+}
