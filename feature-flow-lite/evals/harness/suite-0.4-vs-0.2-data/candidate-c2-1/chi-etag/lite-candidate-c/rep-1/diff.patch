+// etagSplit cuts body into writes of random length, empty writes included.
+func etagSplit(rng *rand.Rand, body []byte) [][]byte {
+	var writes [][]byte
+	for {
+		n := rng.Intn(len(body) + 1)
+		writes = append(writes, body[:n])
+		body = body[n:]
+		if len(body) == 0 {
+			return writes
+		}
+	}
+}
+
+// etagList builds an If-None-Match value holding member among random other
+// tags and empty or whitespace-only elements, with a random tail (see below). Sometimes it ends with a "*" or
+// an unquoted junk member, which must not hide a match before it.
+func etagList(rng *rand.Rand, member string) string {
+	members := []string{member}
+	for range rng.Intn(4) {
+		switch rng.Intn(4) {
+		case 0:
+			members = append(members, fmt.Sprintf(`"%016x"`, rng.Uint64()))
+		case 1:
+			members = append(members, fmt.Sprintf(`W/"%016x"`, rng.Uint64()))
+		case 2:
+			members = append(members, "")
+		default:
+			members = append(members, " \t")
+		}
+	}
+	rng.Shuffle(len(members), func(i, j int) { members[i], members[j] = members[j], members[i] })
+	seps := []string{",", ", ", " ,", ",,", " , ,", ", \t"}
+	var b strings.Builder
+	for i, m := range members {
+		if i > 0 {
+			b.WriteString(seps[rng.Intn(len(seps))])
+		}
+		b.WriteString(m)
+	}
+	// A "*" or junk member after the tags must not hide a match before it.
+	tails := []string{"", ", *", ", abc"}
+	b.WriteString(tails[rng.Intn(len(tails))])
+	return b.String()
+}
