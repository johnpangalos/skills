+// Hijack after a buffered write puts the same bytes on the wire as net/http:
+// status line and headers, then the body, then the raw connection.
+func TestETag_HijackMatchesNetHTTP(t *testing.T) {
+	hijackAfterWrite := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("hello"))
+		conn, _, err := http.NewResponseController(w).Hijack()
+		if err != nil {
+			t.Errorf("Hijack: %v", err)
+			return
+		}
+		conn.Close()
+	})
+	hijackBeforeWrite := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		conn, _, err := http.NewResponseController(w).Hijack()
+		if err != nil {
+			t.Errorf("Hijack: %v", err)
+			return
+		}
+		conn.Close()
+	})
+	for name, h := range map[string]http.Handler{"after write": hijackAfterWrite, "before write": hijackBeforeWrite} {
+		t.Run(name, func(t *testing.T) {
+			plain := etagRawHijack(t, h)
+			wrapped := etagRawHijack(t, ETag(h))
+			assertEqual(t, wrapped, plain)
+		})
+	}
+	wrapped := etagRawHijack(t, ETag(hijackAfterWrite))
+	if !strings.HasPrefix(wrapped, "HTTP/1.1 200 OK\r\n") || !strings.Contains(wrapped, "Transfer-Encoding: chunked\r\n") {
+		t.Fatalf("hijack after write sent %q, want a 200 status line and chunked headers", wrapped)
+	}
+}
