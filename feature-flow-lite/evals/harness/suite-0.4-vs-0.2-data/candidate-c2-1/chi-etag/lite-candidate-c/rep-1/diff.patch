+// Wrappers: the same handler run through the middleware and without it. Status,
+// body and headers must match, except the ETag that the approved differences add.
+func TestETag_DifferentialAgainstUnwrapped(t *testing.T) {
+	scripts := map[string]func(w http.ResponseWriter){
+		"no writes":           func(w http.ResponseWriter) {},
+		"write only":          func(w http.ResponseWriter) { w.Write([]byte("abc")) },
+		"several writes":      func(w http.ResponseWriter) { w.Write([]byte("a")); w.Write([]byte("bc")) },
+		"header before write": func(w http.ResponseWriter) { w.Header().Set("X-A", "1"); w.WriteHeader(200); w.Write([]byte("abc")) },
+		"header after write":  func(w http.ResponseWriter) { w.Write([]byte("abc")); w.Header().Set("X-Late", "1") },
+		"flush after write":   func(w http.ResponseWriter) { w.Write([]byte("abc")); w.(http.Flusher).Flush() },
+		"status twice":        func(w http.ResponseWriter) { w.WriteHeader(404); w.WriteHeader(200); w.Write([]byte("abc")) },
+		"404 with body":       func(w http.ResponseWriter) { w.WriteHeader(404); w.Write([]byte("missing")) },
+		"201 with body":       func(w http.ResponseWriter) { w.Header().Set("X-A", "1"); w.WriteHeader(201); w.Write([]byte("made")) },
+		"500 no body":         func(w http.ResponseWriter) { w.WriteHeader(500) },
+		"explicit empty 200":  func(w http.ResponseWriter) { w.WriteHeader(200) },
+	}
+	for name, script := range scripts {
+		for _, method := range []string{http.MethodGet, http.MethodHead, http.MethodPost} {
+			t.Run(name+" "+method, func(t *testing.T) {
+				h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { script(w) })
+				plain := httptest.NewRecorder()
+				h.ServeHTTP(plain, etagRequest(method))
+				wrapped := httptest.NewRecorder()
+				ETag(h).ServeHTTP(wrapped, etagRequest(method))
+
+				want, got := plain.Result(), wrapped.Result()
+				assertEqual(t, got.StatusCode, want.StatusCode)
+				assertEqual(t, wrapped.Body.String(), plain.Body.String())
+
+				wantETag := ""
+				if want.StatusCode == http.StatusOK && (method == http.MethodGet || (method == http.MethodHead && plain.Body.Len() > 0)) {
+					wantETag = etagOf(plain.Body.String())
+				}
+				assertEqual(t, got.Header.Get("ETag"), wantETag)
+				got.Header.Del("ETag")
+				assertEqual(t, fmt.Sprint(got.Header), fmt.Sprint(want.Header))
+			})
+		}
+	}
+}
