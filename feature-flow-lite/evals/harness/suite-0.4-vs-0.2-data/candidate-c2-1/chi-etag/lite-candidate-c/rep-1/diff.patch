+// Criterion 8: nothing reaches the client before the handler returns.
+func TestETag_NothingSentBeforeHandlerReturns(t *testing.T) {
+	t.Run("headers changed after first write are not sent", func(t *testing.T) {
+		rec := httptest.NewRecorder()
+		h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("X-Before", "1")
+			w.Write([]byte("hello"))
+			w.Header().Set("X-After", "1")
+			if rec.Body.Len() != 0 || rec.Flushed {
+				t.Errorf("sent early: body=%q flushed=%v", rec.Body.String(), rec.Flushed)
+			}
+		})
+		ETag(h).ServeHTTP(rec, etagRequest(http.MethodGet))
+		assertEqual(t, rec.Header().Get("X-Before"), "1")
+		assertEqual(t, rec.Header().Get("X-After"), "")
+	})
+	t.Run("flush sends nothing while buffering", func(t *testing.T) {
+		rec := httptest.NewRecorder()
+		h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			check := func(stage string) {
+				if rec.Body.Len() != 0 || rec.Flushed {
+					t.Errorf("%s: sent early: body=%q flushed=%v", stage, rec.Body.String(), rec.Flushed)
+				}
+			}
+			w.(http.Flusher).Flush()
+			check("flush before write")
+			if err := http.NewResponseController(w).Flush(); err != nil {
+				t.Errorf("ResponseController.Flush: %v", err)
+			}
+			check("controller flush before write")
+			w.Write([]byte("hello"))
+			w.(http.Flusher).Flush()
+			check("flush after write")
+		})
+		ETag(h).ServeHTTP(rec, etagRequest(http.MethodGet))
+		assertEqual(t, rec.Body.String(), "hello")
+	})
+}
