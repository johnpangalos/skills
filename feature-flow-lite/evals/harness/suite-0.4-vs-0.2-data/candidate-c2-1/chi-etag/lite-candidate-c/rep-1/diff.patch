+// Criterion 7: other methods are not buffered and get no ETag or 304.
+func TestETag_OtherMethodsBypassBuffering(t *testing.T) {
+	for _, method := range []string{http.MethodPost, http.MethodPut, http.MethodPatch, http.MethodDelete, http.MethodOptions} {
