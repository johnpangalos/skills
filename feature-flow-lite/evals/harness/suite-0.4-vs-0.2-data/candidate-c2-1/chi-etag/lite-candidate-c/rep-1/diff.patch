diff --git a/middleware/etag.go b/middleware/etag.go
new file mode 100644
index 0000000..5a33470
--- /dev/null
+++ b/middleware/etag.go
@@ -0,0 +1,252 @@
+package middleware
+
+import (
+	"bufio"
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"maps"
+	"net"
+	"net/http"
+	"strings"
+)
+
+// ETag sets a strong ETag, computed from the response body with SHA-256, on
+// successful GET and HEAD responses that do not already carry one. When the
+// request's If-None-Match matches the ETag, it answers 304 Not Modified without
+// a body. Other methods, and responses with a status other than 200, pass
+// through unchanged.
+func ETag(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet && r.Method != http.MethodHead {
+			next.ServeHTTP(w, r)
+			return
+		}
+		ew := &etagResponseWriter{ResponseWriter: w}
+		next.ServeHTTP(ew, r)
+		ew.finish(r)
+	})
+}
+
+type etagResponseWriter struct {
+	http.ResponseWriter
+
+	// status is the committed status, or 0 while undecided. Only 200 is
+	// buffered in body; any other status streams straight through.
+	status int
+	// implicit is set when the 200 was committed by Write, not WriteHeader.
+	implicit bool
+	// sent is set once the buffered 200 has been written to the underlying writer.
+	sent bool
+	// hijacked is set once the connection has been hijacked.
+	hijacked bool
+	// header is the snapshot of the handler's headers taken at commit time.
+	header http.Header
+	body   bytes.Buffer
+}
+
+func (ew *etagResponseWriter) WriteHeader(code int) {
+	if code >= 100 && code <= 199 && code != http.StatusSwitchingProtocols {
+		ew.ResponseWriter.WriteHeader(code)
+		return
+	}
+	ew.commit(code)
+}
+
+// commit fixes the status on the first call and snapshots the headers.
+func (ew *etagResponseWriter) commit(code int) {
+	if ew.status != 0 || ew.hijacked {
+		return
+	}
+	ew.status = code
+	ew.header = ew.ResponseWriter.Header().Clone()
+	if code != http.StatusOK {
+		ew.ResponseWriter.WriteHeader(code)
+	}
+}
+
+func (ew *etagResponseWriter) Write(p []byte) (int, error) {
+	if ew.hijacked {
+		return 0, http.ErrHijacked
+	}
+	if ew.status == 0 {
+		ew.implicit = true
+		ew.commit(http.StatusOK)
+	}
+	if ew.buffering() {
+		return ew.body.Write(p)
+	}
+	return ew.ResponseWriter.Write(p)
+}
+
+// buffering reports whether a 200 is held in body rather than sent.
+func (ew *etagResponseWriter) buffering() bool {
+	return ew.status == http.StatusOK && !ew.sent
+}
+
+func (ew *etagResponseWriter) Flush() {
+	if ew.hijacked || ew.status == 0 || ew.buffering() {
+		return
+	}
+	if f, ok := ew.ResponseWriter.(http.Flusher); ok {
+		f.Flush()
+	}
+}
+
+// Hijack sends a buffered 200 first, as net/http does, so the client receives
+// the status line and headers before the connection is handed over.
+func (ew *etagResponseWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	hj, ok := ew.ResponseWriter.(http.Hijacker)
+	if !ok {
+		return nil, nil, errors.New("chi/middleware: http.Hijacker is unavailable on the writer")
+	}
+	if ew.buffering() {
+		ew.writeBuffered()
+	}
+	conn, rw, err := hj.Hijack()
+	ew.hijacked = err == nil
+	return conn, rw, err
+}
+
+func (ew *etagResponseWriter) Push(target string, opts *http.PushOptions) error {
+	if ps, ok := ew.ResponseWriter.(http.Pusher); ok {
+		return ps.Push(target, opts)
+	}
+	return errors.New("chi/middleware: http.Pusher is unavailable on the writer")
+}
+
+func (ew *etagResponseWriter) Unwrap() http.ResponseWriter {
+	return ew.ResponseWriter
+}
+
+// finish writes out a buffered 200 response, or answers 304 when it matches.
+func (ew *etagResponseWriter) finish(r *http.Request) {
+	if ew.hijacked || ew.sent {
+		return
+	}
+	ew.commit(http.StatusOK)
+	if ew.status != http.StatusOK {
+		return
+	}
+
+	trailers := ew.trailers()
+	etag := ew.header.Get("ETag")
+	if etag == "" && (r.Method == http.MethodGet || ew.body.Len() > 0) {
+		sum := sha256.Sum256(ew.body.Bytes())
+		etag = `"` + hex.EncodeToString(sum[:]) + `"`
+		ew.header.Set("ETag", etag)
+	}
+	ew.restoreHeader()
+
+	if etagNotModified(r.Header.Values("If-None-Match"), etag) {
+		h := ew.ResponseWriter.Header()
+		h.Del("Content-Type")
+		h.Del("Content-Length")
+		h.Del("Content-Encoding")
+		h.Del("Last-Modified")
+		ew.ResponseWriter.WriteHeader(http.StatusNotModified)
+		return
+	}
+
+	ew.writeBuffered()
+	h := ew.ResponseWriter.Header()
+	for k, vals := range trailers {
+		h[k] = vals
+	}
+}
+
+// writeBuffered sends the buffered 200 with the headers snapshotted at commit.
+func (ew *etagResponseWriter) writeBuffered() {
+	ew.restoreHeader()
+	ew.sent = true
+	if !ew.implicit {
+		ew.ResponseWriter.WriteHeader(http.StatusOK)
+	}
+	ew.ResponseWriter.Write(ew.body.Bytes())
+}
+
+// restoreHeader replaces the underlying header with the snapshot from commit.
+func (ew *etagResponseWriter) restoreHeader() {
+	h := ew.ResponseWriter.Header()
+	clear(h)
+	maps.Copy(h, ew.header)
+}
+
+// trailers returns the values the handler set on the live header after the
+// commit, for the names listed in the snapshot's Trailer header and for keys
+// with the http.TrailerPrefix. net/http sends these as trailers and ignores
+// other late header changes.
+func (ew *etagResponseWriter) trailers() http.Header {
+	live := ew.ResponseWriter.Header()
+	out := http.Header{}
+	for _, v := range ew.header.Values("Trailer") {
+		for _, name := range strings.Split(v, ",") {
+			name = http.CanonicalHeaderKey(strings.TrimSpace(name))
+			if vals, ok := live[name]; ok {
+				out[name] = vals
+			}
+		}
+	}
+	for k, vals := range live {
+		if strings.HasPrefix(k, http.TrailerPrefix) {
+			out[k] = vals
+		}
+	}
+	return out
+}
+
+// etagNotModified reports whether any If-None-Match member matches etag under
+// the weak comparison of RFC 9110 §13.1.2. A field value of "*" alone matches
+// any representation. Empty list elements are skipped, as RFC 9110 §5.6.1
+// requires.
+func etagNotModified(lines []string, etag string) bool {
+	for _, line := range lines {
+		if strings.Trim(line, " \t") == "*" {
+			return true
+		}
+		for {
+			line = strings.TrimLeft(line, " \t,")
+			if line == "" {
+				break
+			}
+			member, rest, ok := scanMember(line)
+			if !ok {
+				break
+			}
+			rest = strings.TrimLeft(rest, " \t")
+			if rest != "" && rest[0] != ',' {
+				break
+			}
+			if strings.TrimPrefix(member, "W/") == strings.TrimPrefix(etag, "W/") {
+				return true
+			}
+			line = rest
+		}
+	}
+	return false
+}
+
+// scanMember parses the entity-tag (RFC 9110 §8.8.3) at the start of s. It
+// returns the tag with the rest of s, and reports false if s does not start
+// with a well-formed tag; a "*" is not a tag, so it ends the list. Control
+// characters and DEL are not allowed inside the quotes.
+func scanMember(s string) (member, rest string, ok bool) {
+	start := 0
+	if strings.HasPrefix(s, "W/") {
+		start = 2
+	}
+	if start >= len(s) || s[start] != '"' {
+		return "", "", false
+	}
+	for i := start + 1; i < len(s); i++ {
+		c := s[i]
+		if c == '"' {
+			return s[:i+1], s[i+1:], true
+		}
+		if c <= 0x20 || c == 0x7f {
+			return "", "", false
+		}
+	}
+	return "", "", false
+}
diff --git a/middleware/etag_test.go b/middleware/etag_test.go
new file mode 100644
index 0000000..bc1bc86
--- /dev/null
+++ b/middleware/etag_test.go
@@ -0,0 +1,702 @@
+package middleware
+
+import (
+	"bufio"
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"io"
+	"math/rand"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"regexp"
+	"strings"
+	"testing"
+
+	"github.com/go-chi/chi/v5"
+)
+
+// etagOf is the strong ETag ETag must compute for body.
+func etagOf(body string) string {
+	sum := sha256.Sum256([]byte(body))
+	return `"` + hex.EncodeToString(sum[:]) + `"`
+}
+
+func etagRequest(method string, ifNoneMatch ...string) *http.Request {
+	req := httptest.NewRequest(method, "/", http.NoBody)
+	for _, v := range ifNoneMatch {
+		req.Header.Add("If-None-Match", v)
+	}
+	return req
+}
+
+func etagServe(h http.Handler, method string, ifNoneMatch ...string) *httptest.ResponseRecorder {
+	rec := httptest.NewRecorder()
+	ETag(h).ServeHTTP(rec, etagRequest(method, ifNoneMatch...))
+	return rec
+}
+
+func etagWrite(body string) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte(body))
+	}
+}
+
+var etagNoBody = http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {})
+
+// etagTestWriter adds the optional writer interfaces to a recorder and records
+// what the middleware forwards to the underlying writer.
+type etagTestWriter struct {
+	*httptest.ResponseRecorder
+	codes             []int
+	hijacked          bool
+	writesAfterHijack int
+	pushed            string
+}
+
+func (tw *etagTestWriter) WriteHeader(code int) {
+	tw.codes = append(tw.codes, code)
+	tw.ResponseRecorder.WriteHeader(code)
+}
+
+func (tw *etagTestWriter) Write(p []byte) (int, error) {
+	if tw.hijacked {
+		tw.writesAfterHijack++
+		return 0, http.ErrHijacked
+	}
+	return tw.ResponseRecorder.Write(p)
+}
+
+func (tw *etagTestWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	tw.hijacked = true
+	return nil, nil, nil
+}
+
+func (tw *etagTestWriter) Push(target string, _ *http.PushOptions) error {
+	tw.pushed = target
+	return nil
+}
+
+// Criterion 1: the type and r.Use, plus implicit 200 and empty bodies.
+func TestETag_IsMiddleware(t *testing.T) {
+	var _ func(http.Handler) http.Handler = ETag
+
+	r := chi.NewRouter()
+	r.Use(ETag)
+	r.Get("/", func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("a"))
+		w.Write([]byte("bc"))
+	})
+
+	rec := httptest.NewRecorder()
+	r.ServeHTTP(rec, etagRequest(http.MethodGet))
+	assertEqual(t, rec.Code, http.StatusOK)
+	assertEqual(t, rec.Body.String(), "abc")
+	assertEqual(t, rec.Header().Get("ETag"), etagOf("abc"))
+}
+
+func TestETag_ImplicitAndEmptyResponses(t *testing.T) {
+	t.Run("implicit 200 without WriteHeader", func(t *testing.T) {
+		rec := etagServe(etagWrite("hello"), http.MethodGet)
+		assertEqual(t, rec.Code, http.StatusOK)
+		assertEqual(t, rec.Body.String(), "hello")
+		assertEqual(t, rec.Header().Get("ETag"), etagOf("hello"))
+	})
+	t.Run("no writes on GET", func(t *testing.T) {
+		rec := etagServe(etagNoBody, http.MethodGet)
+		assertEqual(t, rec.Code, http.StatusOK)
+		assertEqual(t, rec.Body.String(), "")
+		assertEqual(t, rec.Header().Get("ETag"), etagOf(""))
+	})
+}
+
+// Criterion 2: strong SHA-256 ETag over the full body, HEAD rules, large bodies.
+func TestETag_ComputesStrongETagFromBody(t *testing.T) {
+	t.Run("GET tag is computed from the body", func(t *testing.T) {
+		rec := etagServe(etagWrite("hello"), http.MethodGet)
+		assertEqual(t, rec.Header().Get("ETag"), etagOf("hello"))
+		assertEqual(t, rec.Body.String(), "hello")
+	})
+	t.Run("same body same tag, different body different tag", func(t *testing.T) {
+		a := etagServe(etagWrite("hello"), http.MethodGet).Header().Get("ETag")
+		b := etagServe(etagWrite("hello"), http.MethodGet).Header().Get("ETag")
+		c := etagServe(etagWrite("hellO"), http.MethodGet).Header().Get("ETag")
+		assertEqual(t, a, b)
+		if a == c {
+			t.Fatalf("different bodies produced the same ETag %q", a)
+		}
+	})
+	t.Run("HEAD with body gets the GET tag", func(t *testing.T) {
+		get := etagServe(etagWrite("hello"), http.MethodGet).Header().Get("ETag")
+		head := etagServe(etagWrite("hello"), http.MethodHead).Header().Get("ETag")
+		assertEqual(t, head, get)
+	})
+	t.Run("HEAD without body sets no ETag", func(t *testing.T) {
+		rec := etagServe(etagNoBody, http.MethodHead)
+		assertEqual(t, rec.Code, http.StatusOK)
+		if v := rec.Header().Get("ETag"); v != "" {
+			t.Fatalf("HEAD with empty body got ETag %q", v)
+		}
+	})
+	t.Run("body over 1 MiB is sent intact and hashed in full", func(t *testing.T) {
+		body := strings.Repeat("x", 1<<20+17)
+		rec := etagServe(etagWrite(body), http.MethodGet)
+		assertEqual(t, rec.Body.String(), body)
+		assertEqual(t, rec.Header().Get("ETag"), etagOf(body))
+	})
+}
+
+// Criterion 3: a handler-set ETag, strong or weak, is kept as set.
+func TestETag_HandlerETagIsKept(t *testing.T) {
+	for _, tag := range []string{`"v1"`, `W/"v1"`} {
+		t.Run(tag, func(t *testing.T) {
+			h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("ETag", tag)
+				w.Write([]byte("hello"))
+			})
+			rec := etagServe(h, http.MethodGet)
+			assertEqual(t, rec.Header().Get("ETag"), tag)
+			assertEqual(t, rec.Body.String(), "hello")
+		})
+	}
+}
+
+// Criterion 4: 304 keeps the validator and cache headers, drops representation headers.
+func TestETag_NotModifiedDropsRepresentationHeaders(t *testing.T) {
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		hd := w.Header()
+		hd.Set("Content-Type", "text/plain")
+		hd.Set("Content-Length", "5")
+		hd.Set("Content-Encoding", "identity")
+		hd.Set("Last-Modified", "Mon, 02 Jan 2006 15:04:05 GMT")
+		hd.Set("Cache-Control", "max-age=60")
+		hd.Set("Vary", "Accept")
+		hd.Set("Expires", "Mon, 02 Jan 2030 15:04:05 GMT")
+		hd.Set("Content-Location", "/other")
+		hd.Add("Set-Cookie", "a=b")
+		hd.Set("X-Custom", "1")
+		w.Write([]byte("hello"))
+	})
+	for _, method := range []string{http.MethodGet, http.MethodHead} {
+		t.Run(method, func(t *testing.T) {
+			rec := etagServe(h, method, etagOf("hello"))
+			assertEqual(t, rec.Code, http.StatusNotModified)
+			assertEqual(t, rec.Body.String(), "")
+			assertEqual(t, rec.Header().Get("ETag"), etagOf("hello"))
+			for _, k := range []string{"Content-Type", "Content-Length", "Content-Encoding", "Last-Modified"} {
+				if v := rec.Header().Get(k); v != "" {
+					t.Errorf("%s = %q, want it deleted", k, v)
+				}
+			}
+			kept := map[string]string{
+				"Cache-Control":    "max-age=60",
+				"Vary":             "Accept",
+				"Expires":          "Mon, 02 Jan 2030 15:04:05 GMT",
+				"Content-Location": "/other",
+				"X-Custom":         "1",
+			}
+			for k, want := range kept {
+				assertEqual(t, rec.Header().Get(k), want)
+			}
+			assertEqual(t, rec.Header().Values("Set-Cookie"), []string{"a=b"})
+		})
+	}
+}
+
+// Criterion 5: If-None-Match matching rules, with the hostile inputs listed.
+func TestETag_IfNoneMatchRules(t *testing.T) {
+	tests := []struct {
+		name        string
+		handlerETag string
+		ifNoneMatch []string
+		want304     bool
+	}{
+		{"exact computed tag", "", []string{"{E}"}, true},
+		{"weak request matches strong response", "", []string{"W/{E}"}, true},
+		{"strong request matches weak response", `W/"v1"`, []string{`"v1"`}, true},
+		{"weak request matches weak response", `W/"v1"`, []string{`W/"v1"`}, true},
+		{"list with optional whitespace", "", []string{`"zz" ,   {E}  ,"yy"`}, true},
+		{"multiple header lines are combined", "", []string{`"zz"`, "{E}"}, true},
+		{"leading empty element is skipped", "", []string{`, {E}`}, true},
+		{"empty elements between members are skipped", "", []string{`"zz",,{E}`}, true},
+		{"whitespace-only element is skipped", "", []string{`"zz", ,{E}`}, true},
+		{"only empty elements match nothing", "", []string{`, ,`}, false},
+		{"empty element before a malformed member", "", []string{`, "zz"junk`}, false},
+		{"star matches any 200", "", []string{"*"}, true},
+		{"star matches with handler ETag", `"v1"`, []string{"*"}, true},
+		{"star with surrounding whitespace matches", "", []string{" * "}, true},
+		{"star on its own line matches", "", []string{`"zz"`, "*"}, true},
+		{"star after a tag does not match", "", []string{`"zz", *`}, false},
+		{"star before a tag does not match", "", []string{`*, "zz"`}, false},
+		{"star after an empty element does not match", "", []string{`, *`}, false},
+		{"star after a tag without space does not match", "", []string{`"zz",*`}, false},
+		{"comma inside quotes is one tag", `"a,b"`, []string{`"a,b"`}, true},
+		{"comma tag does not match its part", `"a,b"`, []string{`"a"`}, false},
+		{"unquoted tag never matches", `"abc"`, []string{"abc"}, false},
+		{"empty header does not match", "", []string{""}, false},
+		{"case-sensitive comparison", `"x"`, []string{`"X"`}, false},
+		{"unterminated tag does not match", `"x"`, []string{`"x`}, false},
+		{"junk after tag does not match", `"x"`, []string{`"x"junk`}, false},
+		{"lowercase w prefix is not weak", `"x"`, []string{`w/"x"`}, false},
+		{"different tag does not match", "", []string{`"other"`}, false},
+		{"no header does not match", "", nil, false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if tt.handlerETag != "" {
+					w.Header().Set("ETag", tt.handlerETag)
+				}
+				w.Write([]byte("hello"))
+			})
+			inm := make([]string, len(tt.ifNoneMatch))
+			for i, v := range tt.ifNoneMatch {
+				inm[i] = strings.ReplaceAll(v, "{E}", etagOf("hello"))
+			}
+			rec := etagServe(h, http.MethodGet, inm...)
+			if tt.want304 {
+				assertEqual(t, rec.Code, http.StatusNotModified)
+				assertEqual(t, rec.Body.String(), "")
+			} else {
+				assertEqual(t, rec.Code, http.StatusOK)
+				assertEqual(t, rec.Body.String(), "hello")
+			}
+		})
+	}
+}
+
+func TestETag_StarMatchesHeadWithoutETag(t *testing.T) {
+	rec := etagServe(etagNoBody, http.MethodHead, "*")
+	assertEqual(t, rec.Code, http.StatusNotModified)
+	assertEqual(t, rec.Header().Get("ETag"), "")
+}
+
+// Criterion 6: non-200 final statuses pass through unchanged.
+func TestETag_NonOKStatusPassesThrough(t *testing.T) {
+	for _, code := range []int{201, 204, 206, 301, 304, 404, 500} {
+		for _, method := range []string{http.MethodGet, http.MethodHead} {
+			t.Run(fmt.Sprintf("%s %d", method, code), func(t *testing.T) {
+				h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					w.Header().Set("X-Custom", "1")
+					w.WriteHeader(code)
+					w.Write([]byte("body"))
+				})
+				rec := etagServe(h, method, "*", `"v1"`)
+				assertEqual(t, rec.Code, code)
+				assertEqual(t, rec.Body.String(), "body")
+				assertEqual(t, rec.Header().Get("ETag"), "")
+				assertEqual(t, rec.Header().Get("X-Custom"), "1")
+			})
+		}
+	}
+
+	t.Run("handler ETag matching If-None-Match on 404 keeps the 404", func(t *testing.T) {
+		h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("ETag", `"v1"`)
+			w.WriteHeader(http.StatusNotFound)
+			w.Write([]byte("missing"))
+		})
+		rec := etagServe(h, http.MethodGet, `"v1"`)
+		assertEqual(t, rec.Code, http.StatusNotFound)
+		assertEqual(t, rec.Body.String(), "missing")
+		assertEqual(t, rec.Header().Get("ETag"), `"v1"`)
+	})
+}
