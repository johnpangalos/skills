+			conn.Write([]byte("RAW"))
+			conn.Close()
+		})
+	}
+	for _, writeFirst := range []bool{true, false} {
+		want := rawExchange(t, hijack(writeFirst))
+		got := rawExchange(t, ETag(hijack(writeFirst)))
+		if writeFirst && !strings.HasPrefix(want, "HTTP/1.1 200 OK") {
+			t.Fatalf("plain reference lacks a status line: %q", want)
+		}
+		if got != want {
+			t.Fatalf("writeFirst %v: got %q, want %q", writeFirst, got, want)
+		}
+	}
