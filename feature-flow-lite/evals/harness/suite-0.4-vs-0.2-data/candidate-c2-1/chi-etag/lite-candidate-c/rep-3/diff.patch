diff --git a/middleware/etag.go b/middleware/etag.go
new file mode 100644
index 0000000..5f85dca
--- /dev/null
+++ b/middleware/etag.go
@@ -0,0 +1,268 @@
+package middleware
+
+import (
+	"bufio"
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"maps"
+	"net"
+	"net/http"
+	"strings"
+)
+
+// ETag adds a strong ETag to GET and HEAD responses and answers conditional
+// requests with 304 Not Modified.
+//
+// For GET and HEAD requests whose final status is 200, the whole response body
+// is buffered in memory until the handler returns. Nothing is sent early, not
+// even on Flush. When the handler sets no ETag, one is computed as a hash of
+// the body bytes. The ETag is then compared with the If-None-Match request
+// header, using weak comparison as in RFC 9110 section 13.1.2. On a match the
+// response becomes a 304 with no body. Responses with any other status, and
+// requests with other methods, are passed through unchanged and streamed.
+//
+// Headers that outer middleware sets after ETag returns are not sent for a
+// buffered response, because its head is already sent by then.
+//
+// Register ETag before Compress (r.Use(ETag) then r.Use(Compress(...))), so
+// that ETag wraps Compress and sees the compressed bytes. Otherwise a single
+// strong ETag would cover different content encodings.
+func ETag(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet && r.Method != http.MethodHead {
+			next.ServeHTTP(w, r)
+			return
+		}
+		ew := &etagResponseWriter{ResponseWriter: w, hdr: w.Header().Clone()}
+		next.ServeHTTP(ew, r)
+		ew.finish(r)
+	})
+}
+
+type etagResponseWriter struct {
+	http.ResponseWriter
+	hdr      http.Header // the handler's headers, copied to the underlying writer when committed
+	snap     http.Header // hdr as of the buffered 200 WriteHeader
+	code     int         // final status; 0 until WriteHeader, Write or Flush
+	buf      bytes.Buffer
+	flushed  bool // Flush committed the 200 before any body bytes
+	sent     bool // the buffered 200 head and body have been sent
+	hijacked bool
+}
+
+// streaming reports whether writes go straight through: the final status is not
+// 200, or the buffered 200 has already been sent.
+func (ew *etagResponseWriter) streaming() bool {
+	return ew.sent || (ew.code != 0 && ew.code != http.StatusOK)
+}
+
+// Header returns the handler's own headers. Trailers set through it after the
+// first write are forwarded by finish.
+func (ew *etagResponseWriter) Header() http.Header {
+	return ew.hdr
+}
+
+func (ew *etagResponseWriter) WriteHeader(code int) {
+	if ew.hijacked {
+		return
+	}
+	if code >= 100 && code <= 199 && code != http.StatusSwitchingProtocols {
+		if ew.code == 0 {
+			ew.copyHeader(ew.hdr)
+			ew.ResponseWriter.WriteHeader(code)
+		}
+		return
+	}
+	if ew.code != 0 {
+		return
+	}
+	ew.code = code
+	if code == http.StatusOK {
+		ew.snap = ew.hdr.Clone()
+		return
+	}
+	ew.copyHeader(ew.hdr)
+	ew.ResponseWriter.WriteHeader(code)
+}
+
+func (ew *etagResponseWriter) Write(p []byte) (int, error) {
+	if ew.hijacked {
+		return 0, http.ErrHijacked
+	}
+	if ew.code == 0 {
+		ew.WriteHeader(http.StatusOK)
+	}
+	if ew.streaming() {
+		return ew.ResponseWriter.Write(p)
+	}
+	return ew.buf.Write(p)
+}
+
+// Flush commits a 200 when no status is known yet, as net/http does. A buffered
+// 200 is still not sent, so Flush does nothing for it.
+func (ew *etagResponseWriter) Flush() {
+	if ew.hijacked {
+		return
+	}
+	if ew.code == 0 {
+		ew.WriteHeader(http.StatusOK)
+		ew.flushed = true
+	}
+	if f, ok := ew.ResponseWriter.(http.Flusher); ok && ew.streaming() {
+		f.Flush()
+	}
+}
+
+func (ew *etagResponseWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	if ew.hijacked {
+		return nil, nil, http.ErrHijacked
+	}
+	hj, ok := ew.ResponseWriter.(http.Hijacker)
+	if !ok {
+		return nil, nil, errors.New("chi/middleware: http.Hijacker is unavailable on the writer")
+	}
+	if ew.code == http.StatusOK && !ew.sent {
+		ew.sendBuffered()
+	}
+	conn, rw, err := hj.Hijack()
+	if err == nil {
+		ew.hijacked = true
+	}
+	return conn, rw, err
+}
+
+func (ew *etagResponseWriter) Push(target string, opts *http.PushOptions) error {
+	if ps, ok := ew.ResponseWriter.(http.Pusher); ok {
+		return ps.Push(target, opts)
+	}
+	return errors.New("chi/middleware: http.Pusher is unavailable on the writer")
+}
+
+func (ew *etagResponseWriter) Unwrap() http.ResponseWriter {
+	return ew.ResponseWriter
+}
+
+// finish sends a buffered 200 response, or a 304 when If-None-Match matches. A
+// 304 is sent without trailers.
+func (ew *etagResponseWriter) finish(r *http.Request) {
+	if ew.hijacked {
+		return
+	}
+	if ew.code == 0 {
+		ew.WriteHeader(http.StatusOK)
+	}
+	if ew.streaming() {
+		ew.sendTrailers()
+		return
+	}
+	h := ew.snap
+	body := ew.buf.Bytes()
+	if h.Get("ETag") == "" && (r.Method == http.MethodGet || len(body) > 0) {
+		sum := sha256.Sum256(body)
+		h.Set("ETag", `"`+hex.EncodeToString(sum[:16])+`"`)
+	}
+	if etagMatches(r.Header.Values("If-None-Match"), h.Get("ETag")) {
+		h.Del("Content-Type")
+		h.Del("Content-Length")
+		h.Del("Content-Encoding")
+		if h.Get("ETag") != "" {
+			h.Del("Last-Modified")
+		}
+		ew.copyHeader(h)
+		ew.ResponseWriter.WriteHeader(http.StatusNotModified)
+		return
+	}
+	ew.sendBuffered()
+	ew.sendTrailers()
+}
+
+// sendBuffered sends the buffered 200 head and body as the handler wrote them.
+func (ew *etagResponseWriter) sendBuffered() {
+	ew.sent = true
+	h := ew.snap
+	if _, ok := h["Content-Type"]; !ok && ew.flushed {
+		// net/http sent the head at Flush, before any body bytes, so it never
+		// sniffed a Content-Type. A nil value stops the underlying writer from
+		// sniffing one now, and sends no header.
+		h["Content-Type"] = nil
+	}
+	ew.copyHeader(h)
+	ew.ResponseWriter.WriteHeader(http.StatusOK)
+	// net/http does not send the body of a HEAD response.
+	ew.ResponseWriter.Write(ew.buf.Bytes())
+}
+
+// sendTrailers gives the underlying writer the trailers the handler set after
+// its first write. net/http reads them when the response ends. The declared
+// names are the Trailer header the underlying writer committed.
+func (ew *etagResponseWriter) sendTrailers() {
+	under := ew.ResponseWriter.Header()
+	for k, vv := range ew.hdr {
+		if strings.HasPrefix(k, http.TrailerPrefix) {
+			under[k] = vv
+		}
+	}
+	for _, v := range under.Values("Trailer") {
+		for _, name := range strings.Split(v, ",") {
+			name = http.CanonicalHeaderKey(strings.TrimSpace(name))
+			if vv, ok := ew.hdr[name]; ok {
+				under[name] = vv
+			}
+		}
+	}
+}
+
+// copyHeader makes the underlying writer's header map a copy of h.
+func (ew *etagResponseWriter) copyHeader(h http.Header) {
+	under := ew.ResponseWriter.Header()
+	clear(under)
+	maps.Copy(under, h)
+}
+
+// etagMatches reports whether any If-None-Match member matches etag under weak
+// comparison. A "*" member matches any representation.
+func etagMatches(lines []string, etag string) bool {
+	etag = strings.TrimPrefix(etag, "W/")
+	for _, line := range lines {
+		rest := line
+		for {
+			rest = strings.TrimLeft(rest, " \t,")
+			if rest == "" {
+				break
+			}
+			if rest[0] == '*' {
+				return true
+			}
+			tag, after, ok := cutETag(rest)
+			if !ok {
+				break
+			}
+			if tag == etag {
+				return true
+			}
+			rest = after
+		}
+	}
+	return false
+}
+
+// cutETag splits one entity-tag off the front of s. It returns the tag without
+// its W/ prefix and the text after it. ok is false if s does not start with a
+// well-formed entity-tag.
+func cutETag(s string) (tag, rest string, ok bool) {
+	s = strings.TrimPrefix(s, "W/")
+	if len(s) < 2 || s[0] != '"' {
+		return "", "", false
+	}
+	end := strings.IndexByte(s[1:], '"')
+	if end < 0 {
+		return "", "", false
+	}
+	tag = s[:end+2]
+	if strings.ContainsFunc(tag[1:len(tag)-1], func(r rune) bool { return r <= 0x20 || r == 0x7f }) {
+		return "", "", false
+	}
+	return tag, s[end+2:], true
+}
diff --git a/middleware/etag_test.go b/middleware/etag_test.go
new file mode 100644
index 0000000..97de18f
--- /dev/null
+++ b/middleware/etag_test.go
@@ -0,0 +1,887 @@
+package middleware
+
+import (
+	"bufio"
+	"bytes"
+	"errors"
+	"io"
+	"math/rand"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"reflect"
+	"regexp"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/go-chi/chi/v5"
+)
+
+func newETagRequest(method string, ifNoneMatch ...string) *http.Request {
+	req := httptest.NewRequest(method, "/", nil)
+	for _, v := range ifNoneMatch {
+		req.Header.Add("If-None-Match", v)
+	}
+	return req
+}
+
+func serveETag(next http.Handler, method string, ifNoneMatch ...string) *httptest.ResponseRecorder {
+	rec := httptest.NewRecorder()
+	ETag(next).ServeHTTP(rec, newETagRequest(method, ifNoneMatch...))
+	return rec
+}
+
+func writeBody(body string) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte(body))
+	})
+}
+
+// codeRecorder records every WriteHeader call that reaches the underlying writer.
+type codeRecorder struct {
+	*httptest.ResponseRecorder
+	codes []int
+}
+
+func (c *codeRecorder) WriteHeader(code int) {
+	c.codes = append(c.codes, code)
+	c.ResponseRecorder.WriteHeader(code)
+}
+
+type hijackRecorder struct {
+	*httptest.ResponseRecorder
+	hijacked bool
+}
+
+func (h *hijackRecorder) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	h.hijacked = true
+	return nil, nil, nil
+}
+
+type pushRecorder struct {
+	*httptest.ResponseRecorder
+	pushed string
+}
+
+func (p *pushRecorder) Push(target string, _ *http.PushOptions) error {
+	p.pushed = target
+	return nil
+}
+
+func TestETagSignature(t *testing.T) {
+	var fn func(http.Handler) http.Handler = ETag
+	if fn == nil {
+		t.Fatal("ETag is nil")
+	}
+}
+
+func TestETagComputesStrongTagFromBody(t *testing.T) {
+	implicit := serveETag(writeBody("hello"), http.MethodGet)
+	explicit := serveETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusOK)
+		w.Write([]byte("hello"))
+	}), http.MethodGet)
+	none := serveETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}), http.MethodGet)
+	other := serveETag(writeBody("hello!"), http.MethodGet)
+
+	tag := implicit.Header().Get("ETag")
+	if len(tag) < 3 || tag[0] != '"' || tag[len(tag)-1] != '"' {
+		t.Fatalf("expected strong ETag, got %q", tag)
+	}
+	if explicit.Header().Get("ETag") != tag {
+		t.Fatalf("explicit WriteHeader(200) ETag %q, want %q", explicit.Header().Get("ETag"), tag)
+	}
+	if implicit.Body.String() != "hello" {
+		t.Fatalf("body changed: %q", implicit.Body.String())
+	}
+	if other.Header().Get("ETag") == tag {
+		t.Fatalf("different bodies share ETag %q", tag)
+	}
+	if none.Code != http.StatusOK || none.Header().Get("ETag") == "" {
+		t.Fatalf("empty GET: status %d, ETag %q", none.Code, none.Header().Get("ETag"))
+	}
+}
+
+func TestETagChunkedWritesAndLargeBody(t *testing.T) {
+	big := bytes.Repeat([]byte("x"), 1<<20)
+	one := serveETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write(big)
+	}), http.MethodGet)
+	chunks := serveETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		for i := 0; i < len(big); i += 4096 {
+			w.Write(big[i : i+4096])
+		}
+	}), http.MethodGet)
+	if one.Header().Get("ETag") == "" || one.Header().Get("ETag") != chunks.Header().Get("ETag") {
+		t.Fatalf("1 MiB ETag %q, chunked %q", one.Header().Get("ETag"), chunks.Header().Get("ETag"))
+	}
+	if !bytes.Equal(one.Body.Bytes(), big) || !bytes.Equal(chunks.Body.Bytes(), big) {
+		t.Fatal("1 MiB body changed")
+	}
+	small := serveETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("a"))
+		w.Write([]byte("b"))
+	}), http.MethodGet)
+	if small.Header().Get("ETag") != serveETag(writeBody("ab"), http.MethodGet).Header().Get("ETag") {
+		t.Fatal("two small writes differ from one write")
+	}
+}
+
+func TestETagKeepsHandlerTag(t *testing.T) {
+	for _, tag := range []string{`"mine"`, `W/"mine"`} {
+		rec := serveETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("ETag", tag)
+			w.Header().Set("Content-Type", "text/x-custom")
+			w.Write([]byte("hello"))
+		}), http.MethodGet)
+		if got := rec.Header().Get("ETag"); got != tag {
+			t.Fatalf("handler ETag %q replaced by %q", tag, got)
+		}
+		if got := rec.Header().Get("Content-Type"); got != "text/x-custom" {
+			t.Fatalf("handler Content-Type lost: %q", got)
+		}
+	}
+}
+
+func TestETagHead(t *testing.T) {
+	get := serveETag(writeBody("hello"), http.MethodGet)
+	head := serveETag(writeBody("hello"), http.MethodHead)
+	if head.Header().Get("ETag") == "" || head.Header().Get("ETag") != get.Header().Get("ETag") {
+		t.Fatalf("HEAD ETag %q, GET ETag %q", head.Header().Get("ETag"), get.Header().Get("ETag"))
+	}
+	if body := serveWire(t, ETag(writeBody("hello")), http.MethodHead).body; body != "" {
+		t.Fatalf("HEAD carried a body: %q", body)
+	}
+
+	empty := serveETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}), http.MethodHead)
+	if empty.Header().Get("ETag") != "" {
+		t.Fatalf("empty HEAD got computed ETag %q", empty.Header().Get("ETag"))
+	}
+	if wire := serveWire(t, ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {})), http.MethodHead); wire.header.Get("ETag") != "" || wire.header.Get("Content-Length") != "" {
+		t.Fatalf("empty HEAD on the wire: ETag %q, Content-Length %q", wire.header.Get("ETag"), wire.header.Get("Content-Length"))
+	}
+
+	validator := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("ETag", `"v1"`)
+	})
+	if rec := serveETag(validator, http.MethodHead, `"v1"`); rec.Code != http.StatusNotModified || rec.Body.Len() != 0 {
+		t.Fatalf("HEAD If-None-Match match: status %d", rec.Code)
+	}
+	if rec := serveETag(validator, http.MethodHead, `"v0"`); rec.Code != http.StatusOK {
+		t.Fatalf("HEAD If-None-Match mismatch: status %d", rec.Code)
+	}
+}
+
+func TestETagIfNoneMatch(t *testing.T) {
+	cases := []struct {
+		name   string
+		server string
+		inm    []string
+		want   int
+	}{
+		{"strong equal", `"abc"`, []string{`"abc"`}, 304},
+		{"weak request vs strong", `"abc"`, []string{`W/"abc"`}, 304},
+		{"strong request vs weak", `W/"abc"`, []string{`"abc"`}, 304},
+		{"weak both", `W/"abc"`, []string{`W/"abc"`}, 304},
+		{"list with spaces", `"abc"`, []string{`"x" , W/"abc"`}, 304},
+		{"list with leading and trailing spaces", `"abc"`, []string{` "x" ,  "abc" `}, 304},
+		{"header lines combined", `"abc"`, []string{`"x"`, `"abc"`}, 304},
+		{"star", `"abc"`, []string{`*`}, 304},
+		{"star in list", `"abc"`, []string{`"x", *`}, 304},
+		{"unquoted token", `"a"`, []string{`a`}, 200},
+		{"empty header", `"abc"`, []string{``}, 200},
+		{"empty quoted string", `"abc"`, []string{`""`}, 200},
+		{"unterminated member", `"abc"`, []string{`"abc`}, 200},
+		{"unterminated before valid member", `"abc"`, []string{`"x, "abc"`}, 200},
+		{"unterminated line before valid line", `"abc"`, []string{`"x`, `"abc"`}, 304},
+		{"prefix is not a match", `"ab"`, []string{`"a"`}, 200},
+		{"suffix is not a match", `"ab"`, []string{`"b"`}, 200},
+		{"malformed server tag", `"abc`, []string{`"abc`}, 200},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			rec := serveETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("ETag", tc.server)
+				w.Write([]byte("body"))
+			}), http.MethodGet, tc.inm...)
+			if rec.Code != tc.want {
+				t.Fatalf("status %d, want %d", rec.Code, tc.want)
+			}
+			if tc.want == http.StatusOK && rec.Body.String() != "body" {
+				t.Fatalf("body %q, want %q", rec.Body.String(), "body")
+			}
+		})
+	}
+}
+
+func TestETagStarIsNotMatchedOnNon200(t *testing.T) {
+	rec := serveETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusNotFound)
+		w.Write([]byte("missing"))
+	}), http.MethodGet, "*")
+	if rec.Code != http.StatusNotFound || rec.Body.String() != "missing" {
+		t.Fatalf("star on 404: status %d, body %q", rec.Code, rec.Body.String())
+	}
+}
+
+func TestETagNotModifiedHeaders(t *testing.T) {
+	rec := serveETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		h := w.Header()
+		h.Set("ETag", `"v1"`)
+		h.Set("Cache-Control", "max-age=60")
+		h.Set("Content-Location", "/alt")
+		h.Set("Date", "Mon, 02 Jan 2006 15:04:05 GMT")
+		h.Set("Expires", "Thu, 01 Jan 2099 00:00:00 GMT")
+		h.Set("Vary", "Accept")
+		h.Set("Last-Modified", "Mon, 02 Jan 2006 15:04:05 GMT")
+		h.Set("Content-Type", "text/plain")
+		h.Set("Content-Length", "4")
+		h.Set("Content-Encoding", "gzip")
+		w.Write([]byte("body"))
+	}), http.MethodGet, `"v1"`)
+	if rec.Code != http.StatusNotModified || rec.Body.Len() != 0 {
+		t.Fatalf("status %d, body %q", rec.Code, rec.Body.String())
+	}
+	for _, k := range []string{"ETag", "Cache-Control", "Content-Location", "Date", "Expires", "Vary"} {
+		if rec.Header().Get(k) == "" {
+			t.Fatalf("304 dropped %s", k)
+		}
+	}
+	for _, k := range []string{"Content-Type", "Content-Length", "Content-Encoding", "Last-Modified"} {
+		if _, ok := rec.Header()[k]; ok {
+			t.Fatalf("304 kept %s", k)
+		}
+	}
+}
+
+func TestETagOtherMethodsAreNotWrapped(t *testing.T) {
+	for _, method := range []string{http.MethodPost, http.MethodPut, http.MethodDelete, http.MethodOptions, http.MethodPatch} {
+		var got http.ResponseWriter
+		rec := httptest.NewRecorder()
+		ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			got = w
+			w.Write([]byte("body"))
+		})).ServeHTTP(rec, newETagRequest(method, `"abc"`))
+		if got != http.ResponseWriter(rec) {
+			t.Fatalf("%s: handler got a wrapped writer", method)
+		}
+		if rec.Code != http.StatusOK || rec.Header().Get("ETag") != "" || rec.Body.String() != "body" {
+			t.Fatalf("%s: status %d, ETag %q, body %q", method, rec.Code, rec.Header().Get("ETag"), rec.Body.String())
+		}
+	}
+}
+
+func TestETagNon200PassThrough(t *testing.T) {
+	for _, status := range []int{201, 204, 206, 301, 304, 404, 500} {
+		h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("X-Probe", "1")
+			w.Header().Set("Content-Type", "text/x-probe")
+			w.WriteHeader(status)
+			w.Write([]byte("body"))
+		})
+		for _, method := range []string{http.MethodGet, http.MethodHead} {
+			want := httptest.NewRecorder()
+			h.ServeHTTP(want, newETagRequest(method, "*"))
+			got := serveETag(h, method, "*")
+			if got.Code != want.Code || !reflect.DeepEqual(got.Header(), want.Header()) || got.Body.String() != want.Body.String() {
+				t.Fatalf("%s %d: got %d %v %q, want %d %v %q", method, status,
+					got.Code, got.Header(), got.Body.String(), want.Code, want.Header(), want.Body.String())
+			}
+		}
+	}
+}
