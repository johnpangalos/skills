+// getWith sends a GET to ts with the given header name/value pairs.
+func getWith(t *testing.T, ts *httptest.Server, kv ...string) (*http.Response, string) {
+	t.Helper()
+	req, err := http.NewRequest(http.MethodGet, ts.URL, nil)
+	assertNoError(t, err)
+	for i := 0; i < len(kv); i += 2 {
+		req.Header.Add(kv[i], kv[i+1])
