+func genIfNoneMatch(rng *rand.Rand) string {
+	pieces := []string{`"abc"`, `W/"abc"`, `"ab"`, `"a`, `a`, `""`, `W/`, `"`, ` `, "\t", `,`, `*`, `b`, `c`}
+	var sb strings.Builder
+	for n := rng.Intn(8); n > 0; n-- {
+		sb.WriteString(pieces[rng.Intn(len(pieces))])
+	}
+	return sb.String()
+}
