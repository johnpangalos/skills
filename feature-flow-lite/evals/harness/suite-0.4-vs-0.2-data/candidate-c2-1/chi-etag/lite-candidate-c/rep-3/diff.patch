+// serveWire sends one request to a real net/http server running h.
+func serveWire(t *testing.T, h http.Handler, method string) wireResponse {
+	t.Helper()
+	ts := httptest.NewServer(h)
+	defer ts.Close()
+	req, err := http.NewRequest(method, ts.URL, nil)
+	assertNoError(t, err)
+	resp, err := http.DefaultClient.Do(req)
+	assertNoError(t, err)
+	defer resp.Body.Close()
+	body, err := io.ReadAll(resp.Body)
+	assertNoError(t, err)
+	resp.Header.Del("Date")
+	return wireResponse{code: resp.StatusCode, header: resp.Header, body: string(body), trailer: resp.Trailer}
+}
