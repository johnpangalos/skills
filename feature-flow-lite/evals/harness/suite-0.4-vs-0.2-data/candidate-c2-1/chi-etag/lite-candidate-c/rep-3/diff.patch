+func TestETagDifferentialAgainstPlainHandler(t *testing.T) {
+	scripts := map[string]func(http.ResponseWriter, int){
+		"no write": func(w http.ResponseWriter, code int) {
+			if code != 0 {
+				w.WriteHeader(code)
+			}
+		},
+		"one write": func(w http.ResponseWriter, code int) {
+			if code != 0 {
+				w.WriteHeader(code)
+			}
+			w.Write([]byte("hello"))
+		},
+		"chunked writes": func(w http.ResponseWriter, code int) {
+			if code != 0 {
+				w.WriteHeader(code)
+			}
+			w.Write([]byte("he"))
+			w.Write([]byte("llo"))
+		},
+		"headers then write": func(w http.ResponseWriter, code int) {
+			w.Header().Set("Content-Type", "text/x-test")
+			w.Header().Set("X-Probe", "1")
+			if code != 0 {
+				w.WriteHeader(code)
+			}
+			w.Write([]byte("hello"))
+		},
+		"second WriteHeader": func(w http.ResponseWriter, code int) {
+			if code != 0 {
+				w.WriteHeader(code)
+			}
+			w.WriteHeader(599)
+			w.Write([]byte("hello"))
+		},
+		"informational": func(w http.ResponseWriter, code int) {
+			w.WriteHeader(http.StatusEarlyHints)
+			if code != 0 {
+				w.WriteHeader(code)
+			}
+			w.Write([]byte("hello"))
+		},
+		"flush mid-body": func(w http.ResponseWriter, code int) {
+			if code != 0 {
+				w.WriteHeader(code)
+			}
+			w.Write([]byte("a"))
+			w.(http.Flusher).Flush()
+			w.Write([]byte("b"))
+		},
+		"flush only": func(w http.ResponseWriter, code int) {
+			if code != 0 {
+				w.WriteHeader(code)
+			}
+			w.(http.Flusher).Flush()
+		},
+		"flush before WriteHeader": func(w http.ResponseWriter, code int) {
+			w.(http.Flusher).Flush()
+			if code != 0 {
+				w.WriteHeader(code)
+			}
+			w.Write([]byte("hello"))
+		},
+		"trailer prefix after write": func(w http.ResponseWriter, code int) {
+			w.Header().Set("Trailer", "X-Sum")
+			if code != 0 {
+				w.WriteHeader(code)
+			}
+			w.Write([]byte("abc"))
+			w.Header().Set(http.TrailerPrefix+"X-Sum", "v1")
+		},
+		"declared trailer after write": func(w http.ResponseWriter, code int) {
+			w.Header().Set("Trailer", "X-Sum")
+			if code != 0 {
+				w.WriteHeader(code)
+			}
+			w.Write([]byte("abc"))
+			w.Header().Set("X-Sum", "v1")
+		},
+	}
+	for name, script := range scripts {
+		wrote := name != "no write" && name != "flush only"
+		for _, code := range []int{0, 200, 201, 204, 206, 301, 304, 404, 500} {
+			h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { script(w, code) })
+			for _, method := range []string{http.MethodGet, http.MethodHead} {
+				label := name + " " + method + " " + http.StatusText(code)
+				plain := serveWire(t, h, method)
+				wrapped := serveWire(t, ETag(h), method)
+				if wrapped.code != plain.code {
+					t.Fatalf("%s: status %d, want %d", label, wrapped.code, plain.code)
+				}
+				headers := wrapped.header.Clone()
+				if plain.code == http.StatusOK {
+					// Approved: a 200 gains a computed ETag (none for an empty HEAD).
+					wantTag := method == http.MethodGet || wrote
+					if (headers.Get("ETag") != "") != wantTag {
+						t.Fatalf("%s: ETag %q", label, headers.Get("ETag"))
+					}
+					headers.Del("ETag")
+					// Buffering changes the framing of a 200, so Content-Length is not compared.
+					headers.Del("Content-Length")
+					plain.header.Del("Content-Length")
+				}
+				if !reflect.DeepEqual(headers, plain.header) {
+					t.Fatalf("%s: headers %v, want %v", label, headers, plain.header)
+				}
+				if wrapped.body != plain.body {
+					t.Fatalf("%s: body %q, want %q", label, wrapped.body, plain.body)
+				}
+				if !reflect.DeepEqual(wrapped.trailer, plain.trailer) {
+					t.Fatalf("%s: trailers %v, want %v", label, wrapped.trailer, plain.trailer)
+				}
+			}
+		}
+	}
+}
