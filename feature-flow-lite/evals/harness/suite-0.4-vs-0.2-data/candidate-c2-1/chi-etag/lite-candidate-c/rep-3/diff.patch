+		w.Write([]byte(strings.Repeat("hello ", 200)))
+	}))
+	ts := httptest.NewServer(r)
+	defer ts.Close()
+
+	plain, plainBody := getWith(t, ts, "Accept-Encoding", "identity")
+	zipped, _ := getWith(t, ts, "Accept-Encoding", "gzip")
+	plainTag, zippedTag := plain.Header.Get("ETag"), zipped.Header.Get("ETag")
+	if plainTag == "" || zippedTag == "" || plainTag == zippedTag {
+		t.Fatalf("identity ETag %q, gzip ETag %q: want two different tags", plainTag, zippedTag)
+	}
+	if zipped.Header.Get("Content-Encoding") != "gzip" {
+		t.Fatalf("gzip response Content-Encoding %q", zipped.Header.Get("Content-Encoding"))
+	}
+	if resp, body := getWith(t, ts, "Accept-Encoding", "identity", "If-None-Match", zippedTag); resp.StatusCode != http.StatusOK || body != plainBody {
+		t.Fatalf("identity request with gzip ETag: status %d", resp.StatusCode)
+	}
+	if resp, _ := getWith(t, ts, "Accept-Encoding", "gzip", "If-None-Match", zippedTag); resp.StatusCode != http.StatusNotModified {
+		t.Fatalf("gzip request with its own ETag: status %d", resp.StatusCode)
+	}
