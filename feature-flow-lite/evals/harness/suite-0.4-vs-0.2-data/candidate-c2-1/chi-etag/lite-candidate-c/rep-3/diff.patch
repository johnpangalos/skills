+		var chunks [][]byte
+		for rest := body; len(rest) > 0; {
+			n := 1 + rng.Intn(len(rest))
+			chunks = append(chunks, rest[:n])
+			rest = rest[n:]
+		}
+		one := serveETag(writeBody(string(body)), http.MethodGet)
+		many := serveETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			for _, c := range chunks {
+				w.Write(c)
+			}
+		}), http.MethodGet)
+		if one.Header().Get("ETag") != many.Header().Get("ETag") || many.Body.String() != string(body) {
+			t.Fatalf("body %q in %d writes: ETag %q, one write %q; body %q",
+				body, len(chunks), many.Header().Get("ETag"), one.Header().Get("ETag"), many.Body.String())
+		}
+	}
+}
+
+// hijackFailRecorder is a writer whose Hijack always fails.
+type hijackFailRecorder struct {
+	*codeRecorder
+}
+
+func (h *hijackFailRecorder) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	return nil, nil, errors.New("hijack refused")
+}
+
+func TestETagFailedHijackSendsHeadOnce(t *testing.T) {
+	rec := &hijackFailRecorder{codeRecorder: &codeRecorder{ResponseRecorder: httptest.NewRecorder()}}
+	var hijackErrs []error
+	var writeErr error
+	ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("abc"))
+		for i := 0; i < 2; i++ {
+			_, _, err := w.(http.Hijacker).Hijack()
+			hijackErrs = append(hijackErrs, err)
+		}
+		_, writeErr = w.Write([]byte("def"))
+	})).ServeHTTP(rec, newETagRequest(http.MethodGet))
+	for _, err := range hijackErrs {
+		if err == nil || err.Error() != "hijack refused" {
+			t.Fatalf("Hijack errors %v, want hijack refused", hijackErrs)
+		}
+	}
+	if writeErr != nil {
+		t.Fatalf("write after failed hijack: %v", writeErr)
+	}
+	if !reflect.DeepEqual(rec.codes, []int{http.StatusOK}) || rec.Body.String() != "abcdef" {
+		t.Fatalf("codes %v, body %q; want [200] and abcdef", rec.codes, rec.Body.String())
+	}
+}
+
+func TestETagTrailerSetThroughHeldHeaderReference(t *testing.T) {
+	cases := []struct {
+		name string
+		code int
+		h    http.HandlerFunc
+	}{
+		{"404 held reference", http.StatusNotFound, func(w http.ResponseWriter, r *http.Request) {
+			hd := w.Header()
+			hd.Set("Trailer", "X-Sum")
+			w.WriteHeader(http.StatusNotFound)
+			w.Write([]byte("abc"))
+			hd.Set("X-Sum", "v1")
+		}},
+		{"200 held reference", http.StatusOK, func(w http.ResponseWriter, r *http.Request) {
+			hd := w.Header()
+			hd.Set("Trailer", "X-Sum")
+			w.Write([]byte("abc"))
+			hd.Set("X-Sum", "v1")
+		}},
+		{"404 fresh Header call", http.StatusNotFound, func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Trailer", "X-Sum")
+			w.WriteHeader(http.StatusNotFound)
+			w.Write([]byte("abc"))
+			w.Header().Set("X-Sum", "v1")
+		}},
+	}
+	for _, tc := range cases {
+		ts := httptest.NewServer(ETag(tc.h))
+		resp, body := testRequest(t, ts, http.MethodGet, "/", nil)
+		ts.Close()
+		if resp.StatusCode != tc.code || body != "abc" || resp.Trailer.Get("X-Sum") != "v1" {
+			t.Fatalf("%s: status %d, body %q, trailer %v", tc.name, resp.StatusCode, body, resp.Trailer)
+		}
+	}
+}
