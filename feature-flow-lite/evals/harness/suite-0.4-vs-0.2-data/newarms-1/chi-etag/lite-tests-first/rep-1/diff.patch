+func TestETagTrailers(t *testing.T) {
+	t.Parallel()
+
+	var tests = []struct {
+		name    string
+		handler http.Handler
+		trailer string
+		want    string
+	}{
+		{
+			"declared Trailer on 200",
+			http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Trailer", "X-Sum")
+				io.WriteString(w, "hello")
+				w.Header().Set("X-Sum", "abc")
+			}),
+			"X-Sum",
+			"abc",
+		},
+		{
+			"declared Trailer on non-200 pass-through",
+			http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Trailer", "X-Sum")
+				w.WriteHeader(http.StatusCreated)
+				io.WriteString(w, "hello")
+				w.Header().Set("X-Sum", "abc")
+			}),
+			"X-Sum",
+			"abc",
+		},
+		{
+			"TrailerPrefix on 200",
+			http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				io.WriteString(w, "hello")
+				w.(http.Flusher).Flush()
+				w.Header().Set(http.TrailerPrefix+"X-Sum", "abc")
+			}),
+			"X-Sum",
+			"abc",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			srv := httptest.NewServer(ETag(tt.handler))
+			defer srv.Close()
+
+			// Read the raw wire: net/http only exposes undeclared trailers there.
+			conn, err := net.Dial("tcp", srv.Listener.Addr().String())
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer conn.Close()
+			io.WriteString(conn, "GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n")
+			raw, err := io.ReadAll(conn)
+			if err != nil {
+				t.Fatal(err)
+			}
+
+			want := "0\r\n" + tt.trailer + ": " + tt.want + "\r\n\r\n"
+			if !strings.HasSuffix(string(raw), want) {
+				t.Errorf("response does not end with trailer section %q:\n%q", want, raw)
+			}
+		})
+	}
+}
