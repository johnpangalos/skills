+// etagHijackRecorder hijacks successfully and counts the header and body writes made after that.
+type etagHijackRecorder struct {
+	*httptest.ResponseRecorder
+	hijacked   bool
+	afterCalls int
+}
+
+func (w *etagHijackRecorder) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	w.hijacked = true
+	return nil, nil, nil
+}
+
+func (w *etagHijackRecorder) WriteHeader(code int) {
+	w.count()
+	w.ResponseRecorder.WriteHeader(code)
+}
+
+func (w *etagHijackRecorder) Write(p []byte) (int, error) {
+	w.count()
+	return w.ResponseRecorder.Write(p)
+}
+
+func (w *etagHijackRecorder) count() {
+	if w.hijacked {
+		w.afterCalls++
+	}
+}
+
+func TestETagHijackThenReturn(t *testing.T) {
+	t.Parallel()
+
+	t.Run("successful Hijack writes nothing", func(t *testing.T) {
+		rec := &etagHijackRecorder{ResponseRecorder: httptest.NewRecorder()}
+		h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.(http.Hijacker).Hijack()
+		})
+		ETag(h).ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/", http.NoBody))
+
+		if !rec.hijacked {
+			t.Fatal("Hijack was not forwarded to the underlying writer")
+		}
+		if rec.afterCalls != 0 {
+			t.Errorf("WriteHeader or Write called %d times after Hijack, want 0", rec.afterCalls)
+		}
+	})
+
+	t.Run("failed Hijack still sends the response", func(t *testing.T) {
+		rec := etagHijackWriter{httptest.NewRecorder()}
+		h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			if _, _, err := w.(http.Hijacker).Hijack(); !errors.Is(err, errETagHijack) {
+				t.Errorf("Hijack error = %v, want %v", err, errETagHijack)
+			}
+			io.WriteString(w, "hello")
+		})
+		ETag(h).ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/", http.NoBody))
+
+		if rec.Body.String() != "hello" {
+			t.Errorf("body = %q, want %q", rec.Body.String(), "hello")
