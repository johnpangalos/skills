+func TestETagPanicWritesNothing(t *testing.T) {
+	t.Run("panic propagates and nothing is written", func(t *testing.T) {
+		rec := httptest.NewRecorder()
+		h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Write([]byte("partial"))
+			panic("boom")
+		}))
+
+		var recovered any
+		func() {
+			defer func() { recovered = recover() }()
+			h.ServeHTTP(rec, httptest.NewRequest("GET", "/", nil))
+		}()
+
+		assertEqual(t, recovered, "boom")
+		assertEqual(t, rec.Body.String(), "")
+		assertEqual(t, rec.Header().Get("ETag"), "")
+	})
+
+	t.Run("Recoverer outside still produces its 500", func(t *testing.T) {
+		r := chi.NewRouter()
+		r.Use(Recoverer, ETag)
+		r.Get("/", func(w http.ResponseWriter, req *http.Request) {
+			w.Write([]byte("partial"))
+			panic("boom")
+		})
+		rec := httptest.NewRecorder()
+		r.ServeHTTP(rec, httptest.NewRequest("GET", "/", nil))
+
+		assertEqual(t, rec.Code, http.StatusInternalServerError)
+		assertEqual(t, strings.Contains(rec.Body.String(), "partial"), false)
+		assertEqual(t, rec.Header().Get("ETag"), "")
+	})
+}
