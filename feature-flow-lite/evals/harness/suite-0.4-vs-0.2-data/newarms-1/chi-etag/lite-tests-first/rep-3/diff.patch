+func TestETagNonOKStatusPassesThrough(t *testing.T) {
+	for _, code := range []int{201, 204, 206, 301, 304, 404, 500} {
+		t.Run(strconv.Itoa(code), func(t *testing.T) {
+			h := func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("X-Custom", "kept")
+				w.WriteHeader(code)
+				w.Write([]byte("body"))
+			}
+			rec := etagServe(h, "GET", "*")
+
+			assertEqual(t, rec.Code, code)
+			assertEqual(t, rec.Header().Get("ETag"), "")
+			assertEqual(t, rec.Header().Get("X-Custom"), "kept")
+			assertEqual(t, rec.Body.String(), "body")
+		})
+	}
+
+	t.Run("writes and flush go straight through", func(t *testing.T) {
+		rec := httptest.NewRecorder()
+		var before string
+		var flushed bool
+		h := func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(http.StatusCreated)
+			w.Write([]byte("a"))
+			before = rec.Body.String()
+			http.NewResponseController(w).Flush()
+			flushed = rec.Flushed
+		}
+		etagServeTo(rec, h, "GET")
+
+		assertEqual(t, before, "a")
+		assertEqual(t, flushed, true)
+	})
+
+	t.Run("second WriteHeader is ignored", func(t *testing.T) {
+		h := func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(http.StatusNotFound)
+			w.WriteHeader(http.StatusInternalServerError)
+			w.Write([]byte("nope"))
+		}
+		rec := etagServe(h, "GET")
+
+		assertEqual(t, rec.Code, http.StatusNotFound)
+		assertEqual(t, rec.Body.String(), "nope")
+	})
+
+	t.Run("body before WriteHeader makes the implicit 200 win", func(t *testing.T) {
+		h := func(w http.ResponseWriter, r *http.Request) {
+			w.Write([]byte("hi"))
+			w.WriteHeader(http.StatusInternalServerError)
+		}
+		rec := etagServe(h, "GET")
+
+		assertEqual(t, rec.Code, http.StatusOK)
+		assertEqual(t, rec.Header().Get("ETag"), etagOf("hi"))
+		assertEqual(t, rec.Body.String(), "hi")
+	})
+}
