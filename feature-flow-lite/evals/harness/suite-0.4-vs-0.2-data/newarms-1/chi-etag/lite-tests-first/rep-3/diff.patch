+func TestETagInformationalResponse(t *testing.T) {
+	r := chi.NewRouter()
+	r.Use(ETag)
+	r.Get("/", func(w http.ResponseWriter, req *http.Request) {
+		w.Header().Set("Link", "</style.css>; rel=preload")
+		w.WriteHeader(http.StatusEarlyHints)
+		w.Write([]byte("hello"))
+	})
+	ts := httptest.NewServer(r)
+	defer ts.Close()
+
+	var codes []int
+	var links []string
+	trace := &httptrace.ClientTrace{
+		Got1xxResponse: func(code int, header textproto.MIMEHeader) error {
+			codes = append(codes, code)
+			links = append(links, header.Get("Link"))
+			return nil
+		},
+	}
+	req, err := http.NewRequestWithContext(httptrace.WithClientTrace(context.Background(), trace), "GET", ts.URL+"/", nil)
+	assertNoError(t, err)
+	resp, err := http.DefaultClient.Do(req)
+	assertNoError(t, err)
+	defer resp.Body.Close()
+
+	assertEqual(t, codes, []int{http.StatusEarlyHints})
+	assertEqual(t, links, []string{"</style.css>; rel=preload"})
+	assertEqual(t, resp.StatusCode, http.StatusOK)
+	assertEqual(t, resp.Header.Get("ETag"), etagOf("hello"))
+}
