+func TestETagConcurrentRequests(t *testing.T) {
+	r := chi.NewRouter()
+	r.Use(ETag)
+	r.Get("/{body}", func(w http.ResponseWriter, req *http.Request) {
+		w.Write([]byte(chi.URLParam(req, "body")))
+	})
+	ts := httptest.NewServer(r)
+	defer ts.Close()
+
+	var wg sync.WaitGroup
+	for i := range 50 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			body := "body-" + strconv.Itoa(i)
+			resp, err := http.Get(ts.URL + "/" + body)
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			defer resp.Body.Close()
+			io.Copy(io.Discard, resp.Body)
+			if got := resp.Header.Get("ETag"); got != etagOf(body) {
+				t.Errorf("ETag for %q: got %q", body, got)
+			}
+		}()
+	}
+	wg.Wait()
+}
