diff --git a/middleware/etag.go b/middleware/etag.go
new file mode 100644
index 0000000..02b0321
--- /dev/null
+++ b/middleware/etag.go
@@ -0,0 +1,239 @@
+package middleware
+
+import (
+	"bufio"
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"io"
+	"maps"
+	"net"
+	"net/http"
+	"strings"
+)
+
+// ETag sets a strong ETag on GET and HEAD responses that are 200 OK and have no
+// ETag of the handler's own. The ETag is the hex SHA-256 of the response body, in
+// quotes. A HEAD response gets one only when the handler writes body bytes. When
+// If-None-Match matches the response's ETag, the client gets 304 Not Modified
+// with no body.
+//
+// The whole body is held in memory until the handler returns. Streaming is not
+// supported for a 200 response: Flush is a no-op while it is held, so nothing is
+// sent early. Any other final status is passed through unchanged and streams as
+// usual. Other methods are not touched.
+//
+// With Compress, place ETag before it, so the ETag is computed from the encoded
+// body and each content-coding gets its own strong ETag:
+//
+//	r.Use(middleware.ETag, middleware.Compress(5))
+func ETag(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet && r.Method != http.MethodHead {
+			next.ServeHTTP(w, r)
+			return
+		}
+		ew := &etagWriter{ResponseWriter: w}
+		next.ServeHTTP(ew, r)
+		ew.finish(r)
+	})
+}
+
+// etagWriter holds a 200 response until the handler returns, so the ETag can be
+// computed from the whole body. Any other final status is passed through.
+type etagWriter struct {
+	http.ResponseWriter
+
+	wroteHeader bool        // the final status (explicit or implicit) is decided
+	passthrough bool        // the final status is not 200, so writes go straight through
+	hijacked    bool        // the connection was taken over; nothing more is sent
+	snapshot    http.Header // headers as they were when the status was decided
+	body        bytes.Buffer
+}
+
+func (ew *etagWriter) WriteHeader(code int) {
+	if code >= 100 && code < 200 && code != http.StatusSwitchingProtocols {
+		ew.ResponseWriter.WriteHeader(code) // informational: forwarded, not final
+		return
+	}
+	if ew.wroteHeader {
+		if ew.passthrough {
+			ew.ResponseWriter.WriteHeader(code) // lets net/http log the superfluous call
+		}
+		return
+	}
+	ew.wroteHeader = true
+	if code != http.StatusOK {
+		ew.passthrough = true
+		ew.ResponseWriter.WriteHeader(code)
+		return
+	}
+	// Headers changed after this point must not reach the client.
+	ew.snapshot = ew.ResponseWriter.Header().Clone()
+}
+
+// bodyWriter decides the status if the handler has not, then returns where body bytes go.
+func (ew *etagWriter) bodyWriter() io.Writer {
+	if !ew.wroteHeader {
+		ew.WriteHeader(http.StatusOK)
+	}
+	if ew.passthrough {
+		return ew.ResponseWriter
+	}
+	return &ew.body
+}
+
+func (ew *etagWriter) Write(p []byte) (int, error) {
+	return ew.bodyWriter().Write(p)
+}
+
+func (ew *etagWriter) ReadFrom(src io.Reader) (int64, error) {
+	return io.Copy(ew.bodyWriter(), src)
+}
+
+func (ew *etagWriter) Flush() {
+	if !ew.passthrough {
+		return // a buffered 200 has nothing to send yet
+	}
+	if f, ok := ew.ResponseWriter.(http.Flusher); ok {
+		f.Flush()
+	}
+}
+
+func (ew *etagWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	hj, ok := ew.ResponseWriter.(http.Hijacker)
+	if !ok {
+		return nil, nil, errors.New("chi/middleware: http.Hijacker is unavailable on the writer")
+	}
+	conn, rw, err := hj.Hijack()
+	ew.hijacked = err == nil
+	return conn, rw, err
+}
+
+func (ew *etagWriter) Push(target string, opts *http.PushOptions) error {
+	if ps, ok := ew.ResponseWriter.(http.Pusher); ok {
+		return ps.Push(target, opts)
+	}
+	return errors.New("chi/middleware: http.Pusher is unavailable on the writer")
+}
+
+func (ew *etagWriter) Unwrap() http.ResponseWriter {
+	return ew.ResponseWriter
+}
+
+// finish sends the held response once the handler has returned.
+func (ew *etagWriter) finish(r *http.Request) {
+	if ew.hijacked {
+		return
+	}
+	if !ew.wroteHeader {
+		ew.WriteHeader(http.StatusOK)
+	}
+	if ew.passthrough {
+		return
+	}
+
+	h := ew.ResponseWriter.Header()
+	trailers := lateTrailers(h, ew.snapshot)
+	clear(h)
+	maps.Copy(h, ew.snapshot)
+	maps.Copy(h, trailers)
+	if len(h.Values("ETag")) == 0 && (r.Method == http.MethodGet || ew.body.Len() > 0) {
+		h.Set("ETag", etagFor(ew.body.Bytes()))
+	}
+
+	if ifNoneMatch(r.Header.Values("If-None-Match"), h.Get("ETag")) {
+		h.Del("Content-Type")
+		h.Del("Content-Length")
+		h.Del("Content-Encoding")
+		if h.Get("ETag") != "" {
+			h.Del("Last-Modified")
+		}
+		ew.ResponseWriter.WriteHeader(http.StatusNotModified)
+		return
+	}
+	ew.ResponseWriter.WriteHeader(http.StatusOK)
+	ew.ResponseWriter.Write(ew.body.Bytes())
+}
+
+// lateTrailers returns the current values of the trailers the handler declared in
+// the snapshot's Trailer header, and of any key with http.TrailerPrefix.
+func lateTrailers(cur, snapshot http.Header) http.Header {
+	out := http.Header{}
+	for _, v := range snapshot.Values("Trailer") {
+		for _, k := range strings.Split(v, ",") {
+			k = http.CanonicalHeaderKey(strings.TrimSpace(k))
+			if vals, ok := cur[k]; ok {
+				out[k] = vals
+			}
+		}
+	}
+	for k, vals := range cur {
+		if strings.HasPrefix(k, http.TrailerPrefix) {
+			out[k] = vals
+		}
+	}
+	return out
+}
+
+// etagFor returns the strong entity-tag for body: its hex SHA-256 in quotes.
+func etagFor(body []byte) string {
+	sum := sha256.Sum256(body)
+	return `"` + hex.EncodeToString(sum[:]) + `"`
+}
+
+// ifNoneMatch reports whether any entity-tag in the If-None-Match header lines
+// matches etag by weak comparison (RFC 9110 section 13.1.2), or whether the
+// header is "*". Malformed members never match.
+func ifNoneMatch(lines []string, etag string) bool {
+	tag, rest, ok := cutETag(etag)
+	want, wantOK := strings.TrimPrefix(tag, "W/"), ok && rest == ""
+	for _, line := range lines {
+		if strings.Trim(line, " \t") == "*" {
+			return true
+		}
+		for {
+			line = strings.TrimLeft(line, " \t")
+			if line == "" {
+				break
+			}
+			if line[0] == ',' {
+				line = line[1:]
+				continue
+			}
+			tag, rest, ok := cutETag(line)
+			rest = strings.TrimLeft(rest, " \t")
+			if !ok || (rest != "" && rest[0] != ',') {
+				break // malformed: ignore the rest of this line
+			}
+			if wantOK && strings.TrimPrefix(tag, "W/") == want {
+				return true
+			}
+			line = rest
+		}
+	}
+	return false
+}
+
+// cutETag splits a leading entity-tag, W/"..." or "...", off s.
+func cutETag(s string) (tag, rest string, ok bool) {
+	start := 0
+	if strings.HasPrefix(s, "W/") {
+		start = 2
+	}
+	if len(s) < start+2 || s[start] != '"' {
+		return "", "", false
+	}
+	for i := start + 1; i < len(s); i++ {
+		c := s[i]
+		switch {
+		case c == '"':
+			return s[:i+1], s[i+1:], true
+		case c == 0x21 || c >= 0x23 && c <= 0x7E || c >= 0x80: // etagc
+		default:
+			return "", "", false
+		}
+	}
+	return "", "", false
+}
diff --git a/middleware/etag_test.go b/middleware/etag_test.go
new file mode 100644
index 0000000..e3a6db5
--- /dev/null
+++ b/middleware/etag_test.go
@@ -0,0 +1,636 @@
+package middleware
+
+import (
+	"bufio"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/http/httptrace"
+	"net/textproto"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/go-chi/chi/v5"
+)
+
+var (
+	errETagHijack = errors.New("hijack forwarded")
+	errETagPush   = errors.New("push forwarded")
+)
+
+// etagHijackWriter and etagPushWriter stand in for writers that implement the optional interfaces.
+type etagHijackWriter struct{ *httptest.ResponseRecorder }
+
+func (etagHijackWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	return nil, nil, errETagHijack
+}
+
+type etagPushWriter struct{ *httptest.ResponseRecorder }
+
+func (etagPushWriter) Push(string, *http.PushOptions) error {
+	return errETagPush
+}
+
+func etagOf(body string) string {
+	sum := sha256.Sum256([]byte(body))
+	return `"` + hex.EncodeToString(sum[:]) + `"`
+}
+
+func etagBody(body string) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte(body))
+	}
+}
+
+// etagServeTo routes one request through ETag on a chi router, writing to w.
+func etagServeTo(w http.ResponseWriter, h http.HandlerFunc, method string, inm ...string) {
+	r := chi.NewRouter()
+	r.Use(ETag)
+	r.Handle("/", h)
+	req := httptest.NewRequest(method, "/", nil)
+	for _, v := range inm {
+		req.Header.Add("If-None-Match", v)
+	}
+	r.ServeHTTP(w, req)
+}
+
+func etagServe(h http.HandlerFunc, method string, inm ...string) *httptest.ResponseRecorder {
+	rec := httptest.NewRecorder()
+	etagServeTo(rec, h, method, inm...)
+	return rec
+}
+
+func TestETagUsableAsMiddleware(t *testing.T) {
+	var mw func(http.Handler) http.Handler = ETag
+
+	r := chi.NewRouter()
+	r.Use(mw)
+	r.Get("/", etagBody("hello"))
+	rec := httptest.NewRecorder()
+	r.ServeHTTP(rec, httptest.NewRequest("GET", "/", nil))
+
+	assertEqual(t, rec.Header().Get("ETag"), etagOf("hello"))
+}
+
+func TestETagGeneratesFromBody(t *testing.T) {
+	t.Run("strong digest of the body with body and headers unchanged", func(t *testing.T) {
+		h := func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Content-Type", "text/plain")
+			w.Header().Set("X-Custom", "kept")
+			w.Write([]byte("hello"))
+		}
+		rec := etagServe(h, "GET")
+
+		assertEqual(t, rec.Code, http.StatusOK)
+		assertEqual(t, rec.Header().Get("ETag"), etagOf("hello"))
+		assertEqual(t, rec.Header().Get("Content-Type"), "text/plain")
+		assertEqual(t, rec.Header().Get("X-Custom"), "kept")
+		assertEqual(t, rec.Body.String(), "hello")
+	})
+
+	t.Run("same body gives same ETag and different body differs", func(t *testing.T) {
+		a := etagServe(etagBody("one"), "GET").Header().Get("ETag")
+		b := etagServe(etagBody("one"), "GET").Header().Get("ETag")
+		c := etagServe(etagBody("two"), "GET").Header().Get("ETag")
+
+		assertEqual(t, a, b)
+		assertEqual(t, a == c, false)
+	})
+
+	t.Run("many small writes equal one write", func(t *testing.T) {
+		h := func(w http.ResponseWriter, r *http.Request) {
+			for _, b := range []byte("hello") {
+				w.Write([]byte{b})
+			}
+		}
+		assertEqual(t, etagServe(h, "GET").Header().Get("ETag"), etagOf("hello"))
+	})
+
+	t.Run("io.Copy and ReadFrom equal one write", func(t *testing.T) {
+		copyH := func(w http.ResponseWriter, r *http.Request) {
+			io.Copy(w, io.MultiReader(strings.NewReader("hel"), strings.NewReader("lo")))
+		}
+		readFromH := func(w http.ResponseWriter, r *http.Request) {
+			w.(io.ReaderFrom).ReadFrom(strings.NewReader("hello"))
+		}
+		assertEqual(t, etagServe(copyH, "GET").Header().Get("ETag"), etagOf("hello"))
+		assertEqual(t, etagServe(readFromH, "GET").Header().Get("ETag"), etagOf("hello"))
+	})
+
+	t.Run("empty GET body gets the ETag of the empty body", func(t *testing.T) {
+		h := func(w http.ResponseWriter, r *http.Request) {}
+		rec := etagServe(h, "GET")
+
+		assertEqual(t, rec.Code, http.StatusOK)
+		assertEqual(t, rec.Header().Get("ETag"), etagOf(""))
+	})
+
+	t.Run("explicit WriteHeader(200) then body", func(t *testing.T) {
+		h := func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(http.StatusOK)
+			w.Write([]byte("hello"))
+		}
+		assertEqual(t, etagServe(h, "GET").Header().Get("ETag"), etagOf("hello"))
+	})
+}
+
+func TestETagHead(t *testing.T) {
+	t.Run("HEAD with body has the GET ETag and sends no body", func(t *testing.T) {
+		r := chi.NewRouter()
+		r.Use(GetHead, ETag)
+		r.Get("/", etagBody("hello"))
+		ts := httptest.NewServer(r)
+		defer ts.Close()
+
+		getResp, _ := testRequest(t, ts, "GET", "/", nil)
+		headResp, headBody := testRequest(t, ts, "HEAD", "/", nil)
+
+		assertEqual(t, getResp.Header.Get("ETag"), etagOf("hello"))
+		assertEqual(t, headResp.Header.Get("ETag"), getResp.Header.Get("ETag"))
+		assertEqual(t, headBody, "")
+	})
+
+	t.Run("HEAD handler writing body gets the body ETag", func(t *testing.T) {
+		rec := etagServe(etagBody("hello"), "HEAD")
+		assertEqual(t, rec.Header().Get("ETag"), etagOf("hello"))
+	})
+
+	t.Run("HEAD writing no body bytes gets no ETag", func(t *testing.T) {
+		explicit := func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(http.StatusOK) }
+		silent := func(w http.ResponseWriter, r *http.Request) {}
+
+		assertEqual(t, etagServe(explicit, "HEAD").Header().Get("ETag"), "")
+		assertEqual(t, etagServe(silent, "HEAD").Header().Get("ETag"), "")
+	})
+
+	t.Run("HEAD handler-set ETag is kept with no body", func(t *testing.T) {
+		h := func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("ETag", `"set"`)
+		}
+		assertEqual(t, etagServe(h, "HEAD").Header().Get("ETag"), `"set"`)
+	})
+}
+
+func TestETagKeepsHandlerETag(t *testing.T) {
+	for _, etag := range []string{`"v1"`, `W/"v1"`} {
+		t.Run(etag, func(t *testing.T) {
+			h := func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("ETag", etag)
+				w.Write([]byte("hello"))
+			}
+			assertEqual(t, etagServe(h, "GET").Header().Get("ETag"), etag)
+		})
+	}
+}
+
+func TestETagNotModified(t *testing.T) {
+	const lastModified = "Mon, 02 Jan 2006 15:04:05 GMT"
+
+	caching := func(w http.ResponseWriter) {
+		w.Header().Set("Cache-Control", "max-age=60")
+		w.Header().Set("Vary", "Accept")
+		w.Header().Set("Expires", "Thu, 01 Jan 2099 00:00:00 GMT")
+		w.Header().Set("Content-Location", "/other")
+		w.Header().Set("Date", lastModified)
+		w.Header().Set("Last-Modified", lastModified)
+		w.Header().Set("Content-Type", "text/plain")
+		w.Header().Set("Content-Length", "5")
+		w.Header().Set("Content-Encoding", "identity")
+	}
+	h := func(w http.ResponseWriter, r *http.Request) {
+		caching(w)
+		w.Write([]byte("hello"))
+	}
+
+	t.Run("matching GET is 304 with no body and kept and removed headers", func(t *testing.T) {
+		rec := etagServe(h, "GET", etagOf("hello"))
+
+		assertEqual(t, rec.Code, http.StatusNotModified)
+		assertEqual(t, rec.Body.String(), "")
+		assertEqual(t, rec.Header().Get("ETag"), etagOf("hello"))
+		assertEqual(t, rec.Header().Get("Cache-Control"), "max-age=60")
+		assertEqual(t, rec.Header().Get("Vary"), "Accept")
+		assertEqual(t, rec.Header().Get("Expires"), "Thu, 01 Jan 2099 00:00:00 GMT")
+		assertEqual(t, rec.Header().Get("Content-Location"), "/other")
+		assertEqual(t, rec.Header().Get("Date"), lastModified)
+		assertEqual(t, rec.Header().Get("Content-Type"), "")
+		assertEqual(t, rec.Header().Get("Content-Length"), "")
+		assertEqual(t, rec.Header().Get("Content-Encoding"), "")
+		assertEqual(t, rec.Header().Get("Last-Modified"), "")
+	})
+
+	t.Run("matching HEAD is 304", func(t *testing.T) {
+		rec := etagServe(h, "HEAD", etagOf("hello"))
+
+		assertEqual(t, rec.Code, http.StatusNotModified)
+		assertEqual(t, rec.Body.String(), "")
+	})
+
+	t.Run("matching handler-set ETag is 304", func(t *testing.T) {
+		set := func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("ETag", `"v1"`)
+			w.Write([]byte("hello"))
+		}
+		rec := etagServe(set, "GET", `"v1"`)
+
+		assertEqual(t, rec.Code, http.StatusNotModified)
+		assertEqual(t, rec.Header().Get("ETag"), `"v1"`)
+	})
+}
+
+func TestETagIfNoneMatch(t *testing.T) {
+	want := etagOf("hello")
+
+	cases := []struct {
+		name  string
+		set   string // handler-set ETag; empty means the generated one
+		inm   []string
+		match bool
+	}{
+		{"weak request matches strong response", "", []string{"W/" + want}, true},
+		{"strong request matches weak response", `W/"v1"`, []string{`"v1"`}, true},
+		{"weak both sides matches", `W/"v1"`, []string{`W/"v1"`}, true},
+		{"comma list without spaces", `"b"`, []string{`"a","b"`}, true},
+		{"empty members", `"v1"`, []string{`, ,"v1"`}, true},
+		{"spaces and tabs around members", `"v1"`, []string{" \t\"x\" \t, \t\"v1\" "}, true},
+		{"second If-None-Match line matches", `"v1"`, []string{`"x"`, `"v1"`}, true},
+		{"comma inside quoted tag", `"a,b"`, []string{`"a,b"`}, true},
+		{"star matches any 200", "", []string{"*"}, true},
+		{"star with surrounding whitespace", "", []string{" * "}, true},
+		{"unquoted tag", "", []string{"abc"}, false},
+		{"unterminated tag", `"v1`, []string{`"v1`}, false},
+		{"lone quote", "", []string{`"`}, false},
+		{"weak prefix without tag", "", []string{"W/"}, false},
+		{"weak prefix on unquoted tag", "", []string{"W/abc"}, false},
+		{"tag prefix of ETag", `"abc"`, []string{`"ab"`}, false},
+		{"tag case differs", `"abc"`, []string{`"ABC"`}, false},
+		{"empty header", "", []string{""}, false},
+		{"whitespace and commas only", "", []string{" , \t,"}, false},
+		{"trailing junk after tag", `"v1"`, []string{`"v1"x`}, false},
+		{"star with junk", "", []string{"*x"}, false},
+		{"star inside a list", "", []string{`"x", *`}, false},
+		{"handler ETag unquoted only matches star", "abc", []string{"abc"}, false},
+		{"handler ETag unquoted vs quoted request", "abc", []string{`"abc"`}, false},
+		{"handler ETag unterminated only matches star", `"v1`, []string{`"v1`}, false},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			h := func(w http.ResponseWriter, r *http.Request) {
+				if tc.set != "" {
+					w.Header().Set("ETag", tc.set)
+				}
+				w.Write([]byte("hello"))
+			}
+			rec := etagServe(h, "GET", tc.inm...)
+
+			if tc.match {
+				assertEqual(t, rec.Code, http.StatusNotModified)
+				assertEqual(t, rec.Body.String(), "")
+			} else {
+				assertEqual(t, rec.Code, http.StatusOK)
+				assertEqual(t, rec.Body.String(), "hello")
+			}
+		})
+	}
+}
+
+func TestETagOtherMethodsPassThrough(t *testing.T) {
+	for _, method := range []string{"POST", "PUT", "DELETE", "OPTIONS", "PATCH"} {
+		t.Run(method, func(t *testing.T) {
+			rec := httptest.NewRecorder()
+			var got http.ResponseWriter
+			h := func(w http.ResponseWriter, r *http.Request) {
+				got = w
+				w.Write([]byte("hello"))
+			}
+			etagServeTo(rec, h, method, "*")
+
+			assertEqual(t, got == http.ResponseWriter(rec), true)
+			assertEqual(t, rec.Code, http.StatusOK)
+			assertEqual(t, rec.Header().Get("ETag"), "")
+			assertEqual(t, rec.Body.String(), "hello")
+		})
+	}
+}
