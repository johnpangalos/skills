+func TestETagWriterCapabilities(t *testing.T) {
+	t.Run("Flush during a buffered 200 sends nothing", func(t *testing.T) {
+		rec := httptest.NewRecorder()
+		var flushed bool
+		var midBody string
+		h := func(w http.ResponseWriter, r *http.Request) {
+			w.Write([]byte("part1"))
+			assertNoError(t, http.NewResponseController(w).Flush())
+			flushed = rec.Flushed
+			midBody = rec.Body.String()
+			w.Write([]byte("part2"))
+		}
+		etagServeTo(rec, h, "GET")
+
+		assertEqual(t, flushed, false)
+		assertEqual(t, midBody, "")
+		assertEqual(t, rec.Body.String(), "part1part2")
+	})
+
+	t.Run("Hijack without a Hijacker returns the wording error", func(t *testing.T) {
+		var err error
+		h := func(w http.ResponseWriter, r *http.Request) {
+			_, _, err = http.NewResponseController(w).Hijack()
+		}
+		etagServe(h, "GET")
+
+		if err == nil || err.Error() != "chi/middleware: http.Hijacker is unavailable on the writer" {
+			t.Fatalf("unexpected hijack error: %v", err)
+		}
+	})
+
+	t.Run("Hijack forwards to the underlying writer", func(t *testing.T) {
+		var err error
+		h := func(w http.ResponseWriter, r *http.Request) {
+			_, _, err = http.NewResponseController(w).Hijack()
+		}
+		etagServeTo(etagHijackWriter{httptest.NewRecorder()}, h, "GET")
+
+		assertEqual(t, err == errETagHijack, true)
+	})
+
+	t.Run("Push without a Pusher returns the wording error", func(t *testing.T) {
+		var err error
+		h := func(w http.ResponseWriter, r *http.Request) {
+			err = etagPush(w)
+		}
+		etagServe(h, "GET")
+
+		if err == nil || err.Error() != "chi/middleware: http.Pusher is unavailable on the writer" {
+			t.Fatalf("unexpected push error: %v", err)
+		}
+	})
+
+	t.Run("Push forwards to the underlying writer", func(t *testing.T) {
+		var err error
+		h := func(w http.ResponseWriter, r *http.Request) {
+			err = etagPush(w)
+		}
+		etagServeTo(etagPushWriter{httptest.NewRecorder()}, h, "GET")
+
+		assertEqual(t, err == errETagPush, true)
+	})
+
+	t.Run("Unwrap returns the underlying writer", func(t *testing.T) {
+		rec := httptest.NewRecorder()
+		var same bool
+		h := func(w http.ResponseWriter, r *http.Request) {
+			u, ok := w.(interface{ Unwrap() http.ResponseWriter })
+			same = ok && u.Unwrap() == http.ResponseWriter(rec)
+		}
+		etagServeTo(rec, h, "GET")
+
+		assertEqual(t, same, true)
+	})
+}
