+// Hijack after a buffered write sends the status, headers and buffered bytes
+// before the handler takes the connection, with no ETag.
+func TestETagHijackAfterBufferedWrite(t *testing.T) {
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("X-A", "1")
+		w.WriteHeader(http.StatusCreated)
+		w.Write([]byte("PREFIX"))
+		conn, _, err := http.NewResponseController(w).Hijack()
+		if err != nil {
+			t.Errorf("Hijack: %v", err)
+			return
+		}
+		conn.Write([]byte("RAW"))
+		conn.Close()
+	})
+	with := httptest.NewServer(ETag(h))
+	defer with.Close()
+	without := httptest.NewServer(h)
+	defer without.Close()
+	got, want := etagTestRawGet(t, with), etagTestRawGet(t, without)
+	// The Date header can differ between the two responses.
+	dateRE := regexp.MustCompile(`Date: [^\r]*\r\n`)
+	got, want = dateRE.ReplaceAllString(got, ""), dateRE.ReplaceAllString(want, "")
+	if got != want {
+		t.Errorf("raw output with ETag: got %q, want %q (as without ETag)", got, want)
+	}
+	for _, s := range []string{"HTTP/1.1 201 Created", "X-A: 1", "RAW"} {
+		if !strings.Contains(got, s) {
+			t.Errorf("raw output %q does not contain %q", got, s)
+		}
+	}
+}
