+// Hijack with nothing written sends no response head, as before.
+func TestETagHijackWithoutWriteSendsNothing(t *testing.T) {
+	ts := etagTestServer(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		conn, _, err := http.NewResponseController(w).Hijack()
+		if err != nil {
+			t.Errorf("Hijack: %v", err)
+			return
+		}
+		conn.Write([]byte("RAW"))
+		conn.Close()
+	}))
+	if out := etagTestRawGet(t, ts); out != "RAW" {
+		t.Errorf("raw output: got %q, want %q", out, "RAW")
+	}
+}
