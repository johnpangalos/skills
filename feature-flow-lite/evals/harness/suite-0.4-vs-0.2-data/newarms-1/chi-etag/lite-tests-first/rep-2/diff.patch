+// Criterion 9: optional interfaces are forwarded or report the exact error.
+func TestETagWriterInterfaces(t *testing.T) {
+	t.Run("Unwrap returns the underlying writer", func(t *testing.T) {
+		rec := httptest.NewRecorder()
+		ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			u, ok := w.(interface{ Unwrap() http.ResponseWriter })
+			if !ok {
+				t.Fatal("writer has no Unwrap method")
+			}
+			if u.Unwrap() != http.ResponseWriter(rec) {
+				t.Errorf("Unwrap did not return the underlying writer")
+			}
+		})).ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/", nil))
+	})
+
+	t.Run("Hijack reports the exact error without a Hijacker", func(t *testing.T) {
+		rec := httptest.NewRecorder()
+		ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			_, _, err := w.(http.Hijacker).Hijack()
+			if err == nil || err.Error() != "chi/middleware: http.Hijacker is unavailable on the writer" {
+				t.Errorf("Hijack error: got %v", err)
+			}
+		})).ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/", nil))
+	})
+
+	t.Run("Hijack delegates to a real Hijacker", func(t *testing.T) {
+		hijacked := make(chan error, 1)
+		ts := etagTestServer(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			conn, _, err := http.NewResponseController(w).Hijack()
+			if err == nil {
+				conn.Close()
+			}
+			hijacked <- err
+		}))
+		if resp, err := etagTestClient.Get(ts.URL + "/"); err == nil {
+			resp.Body.Close()
+		}
+		if err := <-hijacked; err != nil {
+			t.Errorf("Hijack: got %v, want nil", err)
+		}
+	})
+
+	t.Run("Push reports the exact error without a Pusher", func(t *testing.T) {
+		rec := httptest.NewRecorder()
+		ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			err := w.(http.Pusher).Push("/style.css", nil)
+			if err == nil || err.Error() != "chi/middleware: http.Pusher is unavailable on the writer" {
+				t.Errorf("Push error: got %v", err)
+			}
+		})).ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/", nil))
+	})
+
+	// Flush stops buffering: no ETag, no 304, bytes written once, later writes stream.
+	tests := []struct {
+		name     string
+		setETag  string
+		inm      string
+		wantETag string
+	}{
+		{"generated ETag is not added", "", etagTestDigest("onetwo"), ""},
+		{"handler ETag is kept and not converted", `"x"`, `"x"`, `"x"`},
+	}
+	for _, tc := range tests {
+		t.Run("Flush "+tc.name, func(t *testing.T) {
+			rec := httptest.NewRecorder()
+			req := httptest.NewRequest(http.MethodGet, "/", nil)
+			req.Header.Set("If-None-Match", tc.inm)
+			ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if tc.setETag != "" {
+					w.Header().Set("ETag", tc.setETag)
+				}
+				w.Write([]byte("one"))
+				http.NewResponseController(w).Flush()
+				if !rec.Flushed || rec.Body.String() != "one" {
+					t.Errorf("Flush did not send buffered bytes: flushed=%v body=%q", rec.Flushed, rec.Body.String())
+				}
+				w.Write([]byte("two"))
+				if rec.Body.String() != "onetwo" {
+					t.Errorf("write after Flush was not streamed: body=%q", rec.Body.String())
+				}
+			})).ServeHTTP(rec, req)
+			if rec.Code != http.StatusOK {
+				t.Errorf("status: got %d, want %d", rec.Code, http.StatusOK)
+			}
+			if rec.Body.String() != "onetwo" {
+				t.Errorf("body: got %q, want %q", rec.Body.String(), "onetwo")
+			}
+			if got := rec.Header().Get("ETag"); got != tc.wantETag {
+				t.Errorf("ETag: got %q, want %q", got, tc.wantETag)
+			}
+		})
+	}
+}
