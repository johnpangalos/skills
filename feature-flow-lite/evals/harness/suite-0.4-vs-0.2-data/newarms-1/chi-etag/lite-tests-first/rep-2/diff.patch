+// Criterion 7: other methods are not buffered and never get an ETag or 304.
+func TestETagUnbufferedMethods(t *testing.T) {
+	for _, method := range []string{http.MethodPost, http.MethodPut, http.MethodDelete, http.MethodPatch} {
+		t.Run(method, func(t *testing.T) {
+			rec := httptest.NewRecorder()
+			h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if w != http.ResponseWriter(rec) {
+					t.Errorf("handler got a wrapped writer, want the original")
+				}
+				w.Write([]byte("a"))
+				w.(http.Flusher).Flush()
+				if !rec.Flushed {
+					t.Errorf("Flush did not reach the original writer")
+				}
+				w.Write([]byte("b"))
+			})
+			ETag(h).ServeHTTP(rec, httptest.NewRequest(method, "/", nil))
+			if rec.Header().Get("ETag") != "" {
+				t.Errorf("ETag: got %q, want none", rec.Header().Get("ETag"))
+			}
+			if rec.Body.String() != "ab" {
+				t.Errorf("body: got %q, want %q", rec.Body.String(), "ab")
+			}
+		})
+	}
+
+	t.Run("If-None-Match ignored", func(t *testing.T) {
+		ts := etagTestServer(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("ETag", `"x"`)
+			w.Write([]byte("body"))
+		}))
+		req, err := http.NewRequest(http.MethodPost, ts.URL+"/", http.NoBody)
+		if err != nil {
+			t.Fatal(err)
+		}
+		req.Header.Set("If-None-Match", `"x"`)
+		resp, err := etagTestClient.Do(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer resp.Body.Close()
+		if resp.StatusCode != http.StatusOK {
+			t.Errorf("status: got %d, want %d", resp.StatusCode, http.StatusOK)
+		}
+	})
+}
