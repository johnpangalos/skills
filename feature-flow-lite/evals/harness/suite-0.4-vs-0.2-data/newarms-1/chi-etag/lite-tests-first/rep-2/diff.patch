+// Criterion 8: non-200 final statuses pass through unchanged.
+func TestETagNonOKPassesThrough(t *testing.T) {
+	tests := []struct {
+		code int
+		body string
+	}{
+		{http.StatusCreated, "body"},
+		{http.StatusNoContent, ""},
+		{http.StatusPartialContent, "body"},
+		{http.StatusMovedPermanently, "body"},
+		{http.StatusNotFound, "body"},
+		{http.StatusInternalServerError, "body"},
+	}
+	for _, tc := range tests {
+		t.Run(http.StatusText(tc.code), func(t *testing.T) {
+			ts := etagTestServer(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Location", "/elsewhere")
+				w.WriteHeader(tc.code)
+				w.Write([]byte(tc.body))
+			}))
+			resp, body := etagTestGet(t, ts, http.MethodGet, nil)
+			if resp.StatusCode != tc.code {
+				t.Errorf("status: got %d, want %d", resp.StatusCode, tc.code)
+			}
+			if body != tc.body {
+				t.Errorf("body: got %q, want %q", body, tc.body)
+			}
+			if got := resp.Header.Get("ETag"); got != "" {
+				t.Errorf("ETag: got %q, want none", got)
+			}
+		})
+	}
+
+	t.Run("handler ETag matched is not converted", func(t *testing.T) {
+		ts := etagTestServer(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("ETag", `"x"`)
+			w.WriteHeader(http.StatusNotFound)
+			w.Write([]byte("body"))
+		}))
+		resp, body := etagTestGet(t, ts, http.MethodGet, etagTestIfNoneMatch(`"x"`))
+		if resp.StatusCode != http.StatusNotFound || body != "body" {
+			t.Errorf("got %d %q, want 404 %q", resp.StatusCode, body, "body")
+		}
+	})
+
+	t.Run("handler sent 304 is passed through", func(t *testing.T) {
+		rec := httptest.NewRecorder()
+		req := httptest.NewRequest(http.MethodGet, "/", nil)
+		req.Header.Set("If-None-Match", `"x"`)
+		ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("ETag", `"x"`)
+			w.Header().Set("Content-Type", "text/plain")
+			w.WriteHeader(http.StatusNotModified)
+		})).ServeHTTP(rec, req)
+		if rec.Code != http.StatusNotModified {
+			t.Errorf("status: got %d, want %d", rec.Code, http.StatusNotModified)
+		}
+		if rec.Header().Get("Content-Type") != "text/plain" {
+			t.Errorf("Content-Type: got %q, want %q", rec.Header().Get("Content-Type"), "text/plain")
+		}
+	})
+
+	t.Run("second WriteHeader is ignored", func(t *testing.T) {
+		ts := etagTestServer(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(http.StatusCreated)
+			w.WriteHeader(http.StatusInternalServerError)
+		}))
+		resp, _ := etagTestGet(t, ts, http.MethodGet, nil)
+		if resp.StatusCode != http.StatusCreated {
+			t.Errorf("status: got %d, want %d", resp.StatusCode, http.StatusCreated)
+		}
+	})
+
+	t.Run("1xx is forwarded immediately and is not final", func(t *testing.T) {
+		early := make(chan struct{})
+		ts := etagTestServer(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Link", "</style.css>; rel=preload")
+			w.WriteHeader(http.StatusEarlyHints)
+			select {
+			case <-early:
+			case <-time.After(5 * time.Second):
+				t.Error("103 Early Hints was not forwarded before the handler continued")
+				return
+			}
+			w.WriteHeader(http.StatusOK)
+			w.Write([]byte("body"))
+		}))
+		var got1xx int
+		trace := &httptrace.ClientTrace{
+			Got1xxResponse: func(code int, _ textproto.MIMEHeader) error {
+				got1xx = code
+				close(early)
+				return nil
+			},
+		}
+		req, err := http.NewRequest(http.MethodGet, ts.URL+"/", http.NoBody)
+		if err != nil {
+			t.Fatal(err)
+		}
+		req = req.WithContext(httptrace.WithClientTrace(req.Context(), trace))
+		resp, err := etagTestClient.Do(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer resp.Body.Close()
+		if got1xx != http.StatusEarlyHints {
+			t.Errorf("1xx: got %d, want %d", got1xx, http.StatusEarlyHints)
+		}
+		if resp.StatusCode != http.StatusOK {
+			t.Errorf("final status: got %d, want %d", resp.StatusCode, http.StatusOK)
+		}
+	})
+}
