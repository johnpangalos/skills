+// WriteHeader panics on a code outside 100-999 with net/http's message.
+func TestETagWriteHeaderInvalidCode(t *testing.T) {
+	for _, code := range []int{-1, 0, 99, 1000} {
+		t.Run(fmt.Sprint(code), func(t *testing.T) {
+			var got any
+			ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				defer func() { got = recover() }()
+				w.WriteHeader(code)
+			})).ServeHTTP(httptest.NewRecorder(), httptest.NewRequest(http.MethodGet, "/", nil))
+			want := fmt.Sprintf("invalid WriteHeader code %v", code)
+			if got != want {
+				t.Errorf("panic at WriteHeader: got %v, want %q", got, want)
+			}
+		})
+	}
