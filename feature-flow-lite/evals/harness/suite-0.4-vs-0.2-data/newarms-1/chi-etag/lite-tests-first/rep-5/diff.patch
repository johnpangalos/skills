+func TestETagHijackWritesNothingAfter(t *testing.T) {
+	tests := []struct {
+		name  string
+		write bool
+		inm   string
+	}{
+		{"hijack with no writes", false, ""},
+		{"hijack after buffered write", true, ""},
+		{"hijack with If-None-Match star", false, "*"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var logs bytes.Buffer
+			var hijackErr error
+			done := make(chan struct{})
+			inner := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if tt.write {
+					w.Write([]byte("hello"))
+				}
+				conn, _, err := w.(http.Hijacker).Hijack()
+				hijackErr = err
+				if conn != nil {
+					conn.Close()
+				}
+			})
+			outer := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				defer close(done)
+				ETag(inner).ServeHTTP(w, r)
+			})
+			srv := httptest.NewUnstartedServer(outer)
+			srv.Config.ErrorLog = log.New(&logs, "", 0)
+			srv.Start()
+			defer srv.Close()
+
+			req, err := http.NewRequest(http.MethodGet, srv.URL, nil)
+			assertNoError(t, err)
+			if tt.inm != "" {
+				req.Header.Set("If-None-Match", tt.inm)
+			}
+			// The hijacked connection is closed by the handler, so the client
+			// gets an error or no response. Only the server log matters here.
+			if resp, err := http.DefaultClient.Do(req); err == nil {
+				resp.Body.Close()
+			}
+			<-done
+			assertNoError(t, hijackErr)
+			assertEqual(t, logs.String(), "")
+		})
+	}
+}
