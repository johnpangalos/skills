+func TestETagUnwrapReturnsUnderlyingWriter(t *testing.T) {
+	rec := httptest.NewRecorder()
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		u, ok := w.(interface{ Unwrap() http.ResponseWriter })
+		assertEqual(t, ok, true)
+		assertEqual(t, u.Unwrap() == http.ResponseWriter(rec), true)
+		assertNoError(t, http.NewResponseController(w).Flush())
+	}))
+	h.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/", nil))
+	assertEqual(t, rec.Flushed, true)
+}
