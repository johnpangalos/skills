+func TestETagInformationalResponse(t *testing.T) {
+	ts := etagServer(t, func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Link", `</style.css>; rel=preload`)
+		w.WriteHeader(http.StatusEarlyHints)
+		io.WriteString(w, "hello")
+	})
+
+	var informational []int
+	trace := &httptrace.ClientTrace{
+		Got1xxResponse: func(code int, _ textproto.MIMEHeader) error {
+			informational = append(informational, code)
+			return nil
+		},
+	}
+	req, err := http.NewRequestWithContext(httptrace.WithClientTrace(context.Background(), trace), http.MethodGet, ts.URL+"/", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp, err := etagClient.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+
+	if len(informational) != 1 || informational[0] != http.StatusEarlyHints {
+		t.Errorf("informational responses %v, want [103]", informational)
+	}
+	if resp.StatusCode != http.StatusOK || resp.Header.Get("ETag") != wantETag("hello") {
+		t.Errorf("final status %d, ETag %q; want 200 and generated ETag", resp.StatusCode, resp.Header.Get("ETag"))
+	}
+}
