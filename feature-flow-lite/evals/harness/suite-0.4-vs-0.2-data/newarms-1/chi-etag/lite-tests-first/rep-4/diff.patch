+func TestETagHead(t *testing.T) {
+	t.Run("generated ETag equals GET", func(t *testing.T) {
+		ts := etagServer(t, etagHandler("", "hello"))
+		get, _ := etagRequest(t, ts, http.MethodGet)
+		head, body := etagRequest(t, ts, http.MethodHead)
+		if head.Header.Get("ETag") != get.Header.Get("ETag") || head.Header.Get("ETag") != wantETag("hello") {
+			t.Errorf("HEAD ETag %q, GET ETag %q, want %q", head.Header.Get("ETag"), get.Header.Get("ETag"), wantETag("hello"))
+		}
+		if body != "" {
+			t.Errorf("HEAD body %q, want none", body)
+		}
+	})
+
+	t.Run("no body means no generated ETag", func(t *testing.T) {
+		ts := etagServer(t, func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Content-Length", "5")
+		})
+		resp, _ := etagRequest(t, ts, http.MethodHead)
+		if resp.StatusCode != http.StatusOK || resp.Header.Get("ETag") != "" {
+			t.Errorf("status %d, ETag %q; want 200 and no ETag", resp.StatusCode, resp.Header.Get("ETag"))
+		}
+	})
+
+	t.Run("handler ETag matched", func(t *testing.T) {
+		ts := etagServer(t, etagHandler(`W/"v1"`, "hello"))
+		resp, body := etagRequest(t, ts, http.MethodHead, `"v1"`)
+		if resp.StatusCode != http.StatusNotModified || body != "" {
+			t.Errorf("status %d, body %q; want 304 and no body", resp.StatusCode, body)
+		}
+	})
+
+	t.Run("generated ETag matched", func(t *testing.T) {
+		ts := etagServer(t, etagHandler("", "hello"))
+		resp, body := etagRequest(t, ts, http.MethodHead, wantETag("hello"))
+		if resp.StatusCode != http.StatusNotModified || body != "" {
+			t.Errorf("status %d, body %q; want 304 and no body", resp.StatusCode, body)
+		}
+	})
+}
