+func TestETagHijackAndPushErrors(t *testing.T) {
+	var hijackErr, pushErr error
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, _, hijackErr = w.(http.Hijacker).Hijack()
+		pushErr = w.(http.Pusher).Push("/style.css", nil)
+		io.WriteString(w, "hello")
+	}))
+	h.ServeHTTP(httptest.NewRecorder(), httptest.NewRequest(http.MethodGet, "/", nil))
+
+	if hijackErr == nil || hijackErr.Error() != "chi/middleware: http.Hijacker is unavailable on the writer" {
+		t.Errorf("Hijack error %v, want the unavailable error", hijackErr)
+	}
+	if pushErr == nil || pushErr.Error() != "chi/middleware: http.Pusher is unavailable on the writer" {
+		t.Errorf("Push error %v, want the unavailable error", pushErr)
+	}
+}
