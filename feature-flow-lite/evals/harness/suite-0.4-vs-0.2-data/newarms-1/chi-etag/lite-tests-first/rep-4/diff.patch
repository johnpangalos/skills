+func TestETagStar(t *testing.T) {
+	cases := []struct {
+		name       string
+		method     string
+		h          http.HandlerFunc
+		inm        string
+		wantStatus int
+		wantBody   string
+	}{
+		{"no ETag on handler", http.MethodGet, etagHandler("", "hello"), "*", http.StatusNotModified, ""},
+		{"handler ETag", http.MethodGet, etagHandler(`"v1"`, "hello"), "*", http.StatusNotModified, ""},
+		{"surrounding OWS", http.MethodGet, etagHandler("", "hello"), " * ", http.StatusNotModified, ""},
+		{"404 passes through", http.MethodGet, func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(http.StatusNotFound)
+			io.WriteString(w, "nope")
+		}, "*", http.StatusNotFound, "nope"},
+		{"POST passes through", http.MethodPost, etagHandler("", "hello"), "*", http.StatusOK, "hello"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			ts := etagServer(t, tc.h)
+			resp, body := etagRequest(t, ts, tc.method, tc.inm)
+			if resp.StatusCode != tc.wantStatus || body != tc.wantBody {
+				t.Errorf("status %d, body %q; want %d, %q", resp.StatusCode, body, tc.wantStatus, tc.wantBody)
+			}
+		})
+	}
+}
