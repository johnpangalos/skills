+// etagRawGet sends a GET over a raw connection to a server running h and
+// returns the response bytes without the Date header, which changes per run.
+func etagRawGet(t *testing.T, h http.Handler) string {
+	t.Helper()
+	srv := httptest.NewServer(h)
+	defer srv.Close()
+	conn, err := net.Dial("tcp", srv.Listener.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	conn.SetDeadline(time.Now().Add(5 * time.Second))
+	if _, err := conn.Write([]byte("GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n")); err != nil {
+		t.Fatal(err)
+	}
+	raw, err := io.ReadAll(conn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var kept []string
+	for _, line := range strings.SplitAfter(string(raw), "\n") {
+		if !strings.HasPrefix(line, "Date: ") {
+			kept = append(kept, line)
+		}
+	}
+	return strings.Join(kept, "")
+}
+
+func etagHijackHandler(t *testing.T, prewrite bool) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		if prewrite {
+			w.Write([]byte("PRE"))
+		}
+		conn, _, err := http.NewResponseController(w).Hijack()
+		if err != nil {
+			t.Errorf("Hijack() error = %v", err)
+			return
+		}
+		defer conn.Close()
+		if _, err := conn.Write([]byte("POST")); err != nil {
+			t.Errorf("conn.Write() error = %v", err)
+		}
+	}
+}
+
+func TestETagHijackMatchesUnwrapped(t *testing.T) {
+	for _, prewrite := range []bool{true, false} {
+		t.Run(fmt.Sprintf("prewrite=%v", prewrite), func(t *testing.T) {
+			h := etagHijackHandler(t, prewrite)
+			wrapped := etagRawGet(t, ETag(h))
+			unwrapped := etagRawGet(t, h)
+			if !strings.HasSuffix(wrapped, "POST") {
+				t.Errorf("wrapped output %q does not end with the hijacked bytes", wrapped)
+			}
+			if wrapped != unwrapped {
+				t.Errorf("wrapped output %q, want %q", wrapped, unwrapped)
+			}
+		})
+	}
+}
