+func TestETagFlush(t *testing.T) {
+	t.Run("flush after write", func(t *testing.T) {
+		rec := newEtagRecorder()
+		handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Write([]byte("a"))
+			w.(http.Flusher).Flush()
+			w.Write([]byte("b"))
+		})
+		ETag(handler).ServeHTTP(rec, etagRequest(http.MethodGet, "*"))
+		if !rec.flushed {
+			t.Fatal("underlying writer was not flushed")
+		}
+		if rec.Code != http.StatusOK || rec.Body.String() != "ab" {
+			t.Fatalf("got %d %q, want 200 \"ab\"", rec.Code, rec.Body.String())
+		}
+		if got, ok := rec.Header()["Etag"]; ok {
+			t.Fatalf("ETag = %q, want no ETag after Flush", got)
+		}
+	})
+
+	t.Run("flush before write", func(t *testing.T) {
+		rec := newEtagRecorder()
+		handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.(http.Flusher).Flush()
+			w.Write([]byte("x"))
+		})
+		ETag(handler).ServeHTTP(rec, etagRequest(http.MethodGet, ""))
+		if !rec.flushed || rec.Code != http.StatusOK || rec.Body.String() != "x" {
+			t.Fatalf("flushed=%v got %d %q, want flushed 200 \"x\"", rec.flushed, rec.Code, rec.Body.String())
+		}
+		if got, ok := rec.Header()["Etag"]; ok {
+			t.Fatalf("ETag = %q, want no ETag after Flush", got)
+		}
+	})
+
+	t.Run("response controller flush", func(t *testing.T) {
+		rec := newEtagRecorder()
+		handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Write([]byte("a"))
+			if err := http.NewResponseController(w).Flush(); err != nil {
+				t.Errorf("ResponseController.Flush: %v", err)
+			}
+		})
+		ETag(handler).ServeHTTP(rec, etagRequest(http.MethodGet, ""))
+		if !rec.flushed || rec.Body.String() != "a" {
+			t.Fatalf("flushed=%v body=%q, want flushed \"a\"", rec.flushed, rec.Body.String())
+		}
+		if got, ok := rec.Header()["Etag"]; ok {
+			t.Fatalf("ETag = %q, want no ETag after Flush", got)
+		}
+	})
+
+	t.Run("underlying writer is not a Flusher", func(t *testing.T) {
+		rec := newEtagRecorder()
+		handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Write([]byte("a"))
+			w.(http.Flusher).Flush()
+			w.Write([]byte("b"))
+		})
+		ETag(handler).ServeHTTP(&plainWriter{rec}, etagRequest(http.MethodGet, ""))
+		if rec.Body.String() != "ab" {
+			t.Fatalf("body = %q, want \"ab\"", rec.Body.String())
+		}
+		if rec.flushed {
+			t.Fatal("plain writer should not have been flushed")
+		}
+	})
+}
