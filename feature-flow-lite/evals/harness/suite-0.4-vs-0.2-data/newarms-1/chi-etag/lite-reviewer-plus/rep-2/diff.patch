+func TestETagPrefixedTrailerKept(t *testing.T) {
+	// The client only reads trailers declared in a Trailer header, so the
+	// prefixed form is checked in the underlying header map.
+	rec := newEtagRecorder()
+	handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("hello"))
+		w.Header().Set(http.TrailerPrefix+"X-Sum", "abc")
