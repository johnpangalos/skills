+				resp, body := testRequest(t, ts, http.MethodGet, "/", nil)
+				if body != "hello" {
+					t.Fatalf("body = %q, want \"hello\"", body)
+				}
+				if got := resp.Trailer.Get("X-Sum"); got != "abc" {
+					t.Fatalf("trailer X-Sum = %q, want \"abc\"", got)
+				}
+			})
+		}
+	}
