+func TestETagTrailers(t *testing.T) {
+	tests := []struct {
+		name    string
+		handler http.HandlerFunc
+	}{
+		{"declared trailer", func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Trailer", "X-Sum")
+			w.Write([]byte("hello"))
+			w.Header().Set("X-Sum", "abc")
+		}},
+	}
+	for _, tt := range tests {
+		for _, wrapped := range []bool{false, true} {
+			name := tt.name + " without ETag"
+			var handler http.Handler = tt.handler
+			if wrapped {
+				name = tt.name + " with ETag"
+				handler = ETag(tt.handler)
+			}
+			t.Run(name, func(t *testing.T) {
+				ts := httptest.NewServer(handler)
+				defer ts.Close()
