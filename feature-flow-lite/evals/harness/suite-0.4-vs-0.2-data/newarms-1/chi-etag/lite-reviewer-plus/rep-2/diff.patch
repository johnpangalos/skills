+func TestETagWriterCapabilities(t *testing.T) {
+	t.Run("unwrap", func(t *testing.T) {
+		rec := newEtagRecorder()
+		ew := &etagResponseWriter{ResponseWriter: rec}
+		if ew.Unwrap() != http.ResponseWriter(rec) {
+			t.Fatal("Unwrap did not return the underlying writer")
+		}
+	})
+
+	t.Run("hijack unavailable", func(t *testing.T) {
+		ew := &etagResponseWriter{ResponseWriter: &plainWriter{newEtagRecorder()}}
+		_, _, err := ew.Hijack()
+		if err == nil || err.Error() != "chi/middleware: http.Hijacker is unavailable on the writer" {
+			t.Fatalf("Hijack error = %v", err)
+		}
+	})
+
+	t.Run("push unavailable", func(t *testing.T) {
+		ew := &etagResponseWriter{ResponseWriter: &plainWriter{newEtagRecorder()}}
+		err := ew.Push("/x", nil)
+		if err == nil || err.Error() != "chi/middleware: http.Pusher is unavailable on the writer" {
+			t.Fatalf("Push error = %v", err)
+		}
+	})
+
+	t.Run("hijack and push forwarded", func(t *testing.T) {
+		ew := &etagResponseWriter{ResponseWriter: capWriter{newEtagRecorder()}}
+		if _, _, err := ew.Hijack(); err != errEtagHijack {
+			t.Fatalf("Hijack error = %v, want forwarded error", err)
+		}
+		if err := ew.Push("/x", nil); err != errEtagPush {
+			t.Fatalf("Push error = %v, want forwarded error", err)
+		}
+	})
+
+	t.Run("response controller hijack", func(t *testing.T) {
+		rec := newEtagRecorder()
+		var got error
+		handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			_, _, got = http.NewResponseController(w).Hijack()
+		})
+		ETag(handler).ServeHTTP(capWriter{rec}, etagRequest(http.MethodGet, ""))
+		if got != errEtagHijack {
+			t.Fatalf("ResponseController.Hijack error = %v, want forwarded error", got)
+		}
+	})
+}
