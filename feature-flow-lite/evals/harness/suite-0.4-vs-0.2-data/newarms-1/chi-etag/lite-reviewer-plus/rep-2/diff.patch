+func TestETagNonCanonicalKeyCountsAsSet(t *testing.T) {
+	for _, key := range []string{"ETag", "etag", "eTAG"} {
+		t.Run(key, func(t *testing.T) {
+			handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header()[key] = []string{`"mine"`}
+				w.Write([]byte("hello"))
+			})
+
+			rec := newEtagRecorder()
+			ETag(handler).ServeHTTP(rec, etagRequest(http.MethodGet, ""))
+			n := 0
+			for k := range rec.Header() {
+				if strings.EqualFold(k, "ETag") {
+					n++
+				}
+			}
+			if n != 1 {
+				t.Fatalf("ETag headers = %d, want 1; header = %v", n, rec.Header())
+			}
+			if got := rec.Header()[key]; len(got) != 1 || got[0] != `"mine"` {
+				t.Fatalf("%s = %q, want [\"mine\"]", key, got)
+			}
+
+			rec = newEtagRecorder()
+			ETag(handler).ServeHTTP(rec, etagRequest(http.MethodGet, `"mine"`))
+			if rec.Code != http.StatusNotModified {
+				t.Fatalf("status = %d, want 304", rec.Code)
+			}
+		})
+	}
