+func TestETagHijackSendsBufferedResponse(t *testing.T) {
+	t.Run("buffered 200 is sent before hijack", func(t *testing.T) {
+		probe := &hijackProbe{etagRecorder: newEtagRecorder()}
+		handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Write([]byte("hello"))
+			if _, _, err := w.(http.Hijacker).Hijack(); err != errEtagHijack {
+				t.Errorf("Hijack error = %v, want forwarded error", err)
+			}
+		})
+		ETag(handler).ServeHTTP(probe, etagRequest(http.MethodGet, ""))
+		if probe.bodyAtHijack != "hello" || !probe.flushedAtHijack || len(probe.codesAtHijack) != 1 || probe.codesAtHijack[0] != http.StatusOK {
+			t.Fatalf("at hijack: body %q flushed %v codes %v, want \"hello\" flushed with [200]",
+				probe.bodyAtHijack, probe.flushedAtHijack, probe.codesAtHijack)
+		}
+		if got, ok := probe.Header()["Etag"]; ok {
+			t.Fatalf("ETag = %q, want no ETag after hijack", got)
+		}
+	})
+
+	t.Run("nothing written hijacks directly", func(t *testing.T) {
+		probe := &hijackProbe{etagRecorder: newEtagRecorder()}
+		handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.(http.Hijacker).Hijack()
+		})
+		ETag(handler).ServeHTTP(probe, etagRequest(http.MethodGet, ""))
+		if len(probe.codesAtHijack) != 0 || probe.bodyAtHijack != "" || probe.flushedAtHijack {
+			t.Fatalf("at hijack: codes %v body %q flushed %v, want nothing sent",
+				probe.codesAtHijack, probe.bodyAtHijack, probe.flushedAtHijack)
+		}
+		if len(probe.codes) != 0 || probe.Body.Len() != 0 {
+			t.Fatalf("response written after hijack: codes %v body %q", probe.codes, probe.Body.String())
+		}
+	})
+}
