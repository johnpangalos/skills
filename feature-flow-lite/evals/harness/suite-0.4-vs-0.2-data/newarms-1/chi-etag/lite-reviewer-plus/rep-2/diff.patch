+func TestETagNonGetHeadPassesThrough(t *testing.T) {
+	for _, method := range []string{http.MethodPost, http.MethodPut, http.MethodDelete, http.MethodOptions, http.MethodPatch} {
+		t.Run(method, func(t *testing.T) {
+			rec := newEtagRecorder()
+			var seen http.ResponseWriter
+			handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				seen = w
+				w.Write([]byte("hello"))
+			})
+			ETag(handler).ServeHTTP(rec, etagRequest(method, "*"))
+			if seen != http.ResponseWriter(rec) {
+				t.Fatalf("handler got writer %T, want the original writer", seen)
+			}
+			if rec.Code != http.StatusOK || rec.Body.String() != "hello" {
+				t.Fatalf("got %d %q, want 200 \"hello\"", rec.Code, rec.Body.String())
+			}
+			if got, ok := rec.Header()["Etag"]; ok {
+				t.Fatalf("ETag = %q, want no ETag header", got)
+			}
+		})
+	}
