+// hijackProbe records what the underlying writer held when Hijack was called.
+type hijackProbe struct {
+	*etagRecorder
+	bodyAtHijack    string
+	codesAtHijack   []int
+	flushedAtHijack bool
+}
+
+func (p *hijackProbe) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	p.bodyAtHijack = p.Body.String()
+	p.codesAtHijack = append([]int(nil), p.codes...)
+	p.flushedAtHijack = p.flushed
+	return nil, nil, errEtagHijack
+}
