+// etagHijackWire serves h over a real server and returns the raw bytes the client
+// reads after the handler hijacks the connection, plus the server's error log.
+// h must return normally so that the log is complete when it is read.
+func etagHijackWire(t *testing.T, h http.Handler) (string, string) {
+	t.Helper()
+	var logs bytes.Buffer
+	done := make(chan struct{})
+	srv := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		defer close(done)
+		h.ServeHTTP(w, r)
+	}))
+	srv.Config.ErrorLog = log.New(&logs, "", 0)
+	srv.Start()
+	defer srv.Close()
+
+	conn, err := net.Dial("tcp", srv.Listener.Addr().String())
+	if err != nil {
+		t.Fatalf("Dial: %v", err)
+	}
+	defer conn.Close()
+	conn.SetDeadline(time.Now().Add(5 * time.Second))
+	if _, err := io.WriteString(conn, "GET / HTTP/1.1\r\nHost: example.com\r\n\r\n"); err != nil {
+		t.Fatalf("writing request: %v", err)
+	}
+	wire, err := io.ReadAll(conn)
+	if err != nil {
+		t.Fatalf("reading response: %v", err)
+	}
+	<-done
+	return string(wire), logs.String()
+}
+
+// etagSendRaw hijacks the connection, writes raw to it and closes it.
+func etagSendRaw(t *testing.T, w http.ResponseWriter, raw string) {
+	t.Helper()
+	conn, _, err := w.(http.Hijacker).Hijack()
+	if err != nil {
+		t.Errorf("Hijack: %v", err)
+		return
+	}
+	defer conn.Close()
+	io.WriteString(conn, raw)
+}
