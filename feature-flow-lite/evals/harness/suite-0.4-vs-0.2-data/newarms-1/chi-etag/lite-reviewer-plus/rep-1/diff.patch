+func TestETagRoundTrip(t *testing.T) {
+	srv := httptest.NewServer(etagRouter(writeBody("hello")))
+	defer srv.Close()
+
+	do := func(method, inm string) (*http.Response, string) {
+		req, err := http.NewRequest(method, srv.URL+"/", nil)
+		if err != nil {
+			t.Fatalf("NewRequest: %v", err)
+		}
+		if inm != "" {
+			req.Header.Set("If-None-Match", inm)
+		}
+		resp, err := srv.Client().Do(req)
+		if err != nil {
+			t.Fatalf("%s: %v", method, err)
+		}
+		defer resp.Body.Close()
+		body, err := io.ReadAll(resp.Body)
+		if err != nil {
+			t.Fatalf("reading body: %v", err)
+		}
+		return resp, string(body)
+	}
+
+	resp, body := do(http.MethodGet, "")
+	etag := resp.Header.Get("ETag")
+	if resp.StatusCode != http.StatusOK || body != "hello" || len(etag) != 66 {
+		t.Fatalf("GET = %d %q ETag %q, want 200 hello with a strong ETag", resp.StatusCode, body, etag)
+	}
+
+	resp, body = do(http.MethodGet, etag)
+	if resp.StatusCode != http.StatusNotModified || body != "" {
+		t.Fatalf("conditional GET = %d %q, want 304 with no body", resp.StatusCode, body)
+	}
+
+	resp, body = do(http.MethodHead, "")
+	if resp.StatusCode != http.StatusOK || body != "" || resp.Header.Get("ETag") != etag {
+		t.Fatalf("HEAD = %d ETag %q, want 200 with the GET ETag %q", resp.StatusCode, resp.Header.Get("ETag"), etag)
+	}
+
+	resp, _ = do(http.MethodHead, etag)
+	if resp.StatusCode != http.StatusNotModified {
+		t.Fatalf("conditional HEAD = %d, want 304", resp.StatusCode)
+	}
+}
