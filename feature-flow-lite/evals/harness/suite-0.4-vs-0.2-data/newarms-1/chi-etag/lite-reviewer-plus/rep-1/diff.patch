+func TestETagLateHeaderChangeIgnoredAfter200(t *testing.T) {
+	cases := []struct {
+		name    string
+		handler http.HandlerFunc
+	}{
+		{"explicit WriteHeader", func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(http.StatusOK)
+			w.Header().Set("Content-Type", "text/csv")
+			w.Header().Set("X-Late", "1")
+			w.Write([]byte("hi"))
+		}},
+		{"implicit WriteHeader", func(w http.ResponseWriter, r *http.Request) {
+			w.Write([]byte("hi"))
+			w.Header().Set("Content-Type", "text/csv")
+			w.Header().Set("X-Late", "1")
+			w.Write([]byte("!"))
+		}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			plain := etagGetHeader(t, tc.handler)
+			wrapped := etagGetHeader(t, etagRouter(tc.handler))
+			if plain.Get("X-Late") != "" {
+				t.Fatalf("plain net/http sent X-Late %q", plain.Get("X-Late"))
+			}
+			for _, k := range []string{"Content-Type", "X-Late"} {
+				if got, want := wrapped.Get(k), plain.Get(k); got != want {
+					t.Fatalf("%s = %q, plain net/http sent %q", k, got, want)
+				}
+			}
+		})
+	}
+}
