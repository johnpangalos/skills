+// etagGetHeader serves h over httptest.NewServer, sends one GET and returns the response headers.
+func etagGetHeader(t *testing.T, h http.Handler) http.Header {
+	t.Helper()
+	srv := httptest.NewServer(h)
+	defer srv.Close()
+	resp, err := srv.Client().Get(srv.URL + "/")
+	if err != nil {
+		t.Fatalf("GET: %v", err)
+	}
+	defer resp.Body.Close()
+	io.Copy(io.Discard, resp.Body)
+	return resp.Header
+}
