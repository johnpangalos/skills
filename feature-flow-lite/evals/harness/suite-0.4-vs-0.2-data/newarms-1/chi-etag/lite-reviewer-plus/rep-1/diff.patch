+func TestETagHijackWithoutWriteSendsNothingExtra(t *testing.T) {
+	wire, logs := etagHijackWire(t, ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		etagSendRaw(t, w, "RAW")
+	})))
+	if wire != "RAW" {
+		t.Fatalf("wire = %q, want only the raw bytes", wire)
+	}
+	if logs != "" {
+		t.Fatalf("server logged %q, want nothing", logs)
+	}
+}
