+func TestETagWriterCapabilities(t *testing.T) {
+	req := httptest.NewRequest(http.MethodGet, "/", nil)
+
+	var hijackErr, pushErr error
+	ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, _, hijackErr = w.(http.Hijacker).Hijack()
+		pushErr = w.(http.Pusher).Push("/x", nil)
+	})).ServeHTTP(httptest.NewRecorder(), req)
+	if hijackErr == nil || hijackErr.Error() != "chi/middleware: http.Hijacker is unavailable on the writer" {
+		t.Fatalf("Hijack error = %v, want the unavailable error", hijackErr)
+	}
+	if pushErr == nil || pushErr.Error() != "chi/middleware: http.Pusher is unavailable on the writer" {
+		t.Fatalf("Push error = %v, want the unavailable error", pushErr)
+	}
+
+	hijackErr, pushErr = nil, nil
+	ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, _, hijackErr = w.(http.Hijacker).Hijack()
+		pushErr = w.(http.Pusher).Push("/x", nil)
+	})).ServeHTTP(etagFullRecorder{httptest.NewRecorder()}, req)
+	if !errors.Is(hijackErr, errEtagSentinel) || !errors.Is(pushErr, errEtagSentinel) {
+		t.Fatalf("Hijack error %v, Push error %v, want the underlying writer's errors", hijackErr, pushErr)
+	}
+
+	rec := httptest.NewRecorder()
+	var unwrapped http.ResponseWriter
+	ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		unwrapped = w.(interface{ Unwrap() http.ResponseWriter }).Unwrap()
+	})).ServeHTTP(rec, req)
+	if unwrapped != rec {
+		t.Fatalf("Unwrap returned %v, want the underlying writer", unwrapped)
+	}
+}
