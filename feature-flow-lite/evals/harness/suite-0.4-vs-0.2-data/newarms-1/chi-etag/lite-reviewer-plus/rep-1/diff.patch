+func TestETagHijackAfterWriteMatchesNetHTTP(t *testing.T) {
+	handler := func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("X-A", "1")
+		w.Write([]byte("hello"))
+		etagSendRaw(t, w, "RAW")
+	}
+	plain, _ := etagHijackWire(t, http.HandlerFunc(handler))
+	wrapped, logs := etagHijackWire(t, ETag(http.HandlerFunc(handler)))
+	if logs != "" {
+		t.Fatalf("server logged %q, want nothing", logs)
+	}
+	if !strings.HasPrefix(wrapped, "HTTP/1.1 200 OK\r\nX-A: 1\r\n") || !strings.HasSuffix(wrapped, "RAW") {
+		t.Fatalf("wire = %q, want the status line, X-A, the body and then the raw bytes", wrapped)
+	}
+	date := regexp.MustCompile(`Date: [^\r]*\r\n`)
+	if date.ReplaceAllString(wrapped, "") != date.ReplaceAllString(plain, "") {
+		t.Fatalf("wire = %q, plain net/http sent %q", wrapped, plain)
+	}
+}
