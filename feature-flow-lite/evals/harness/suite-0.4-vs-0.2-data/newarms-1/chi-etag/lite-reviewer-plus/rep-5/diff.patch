+func TestETagHijackSkipsFinish(t *testing.T) {
+	var logBuf bytes.Buffer
+	done := make(chan struct{})
+	ts := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		defer close(done)
+		ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			conn, rw, err := http.NewResponseController(w).Hijack()
+			if err != nil {
+				t.Errorf("Hijack: %v", err)
+				return
+			}
+			defer conn.Close()
+			rw.WriteString("HTTP/1.1 200 OK\r\nContent-Length: 5\r\nConnection: close\r\n\r\nhello")
+			rw.Flush()
+		})).ServeHTTP(w, r)
+	}))
+	ts.Config.ErrorLog = log.New(&logBuf, "", 0)
+	ts.Start()
+	defer ts.Close()
+
+	resp, err := http.Get(ts.URL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	body, err := io.ReadAll(resp.Body)
+	resp.Body.Close()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if resp.StatusCode != http.StatusOK || string(body) != "hello" {
+		t.Fatalf("status %d, body %q, want 200 and hello", resp.StatusCode, body)
+	}
+
+	<-done
+	if logBuf.Len() != 0 {
+		t.Fatalf("server logged %q, want nothing", logBuf.String())
+	}
+}
