+func TestETagConcurrentRequests(t *testing.T) {
+	var wg sync.WaitGroup
+	for i := 0; i < 50; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			body := fmt.Sprintf("body-%d", i)
+			rec := etagServe("GET", etagBodyHandler(body))
+			if rec.Header().Get("ETag") != etagBodyTag(body) || rec.Body.String() != body {
+				t.Errorf("request %d: ETag %q, body %q", i, rec.Header().Get("ETag"), rec.Body.String())
+			}
+			rec = etagServe("GET", etagBodyHandler(body), etagBodyTag(body))
+			if rec.Code != http.StatusNotModified {
+				t.Errorf("request %d: status = %d, want 304", i, rec.Code)
+			}
+		}(i)
+	}
+	wg.Wait()
+}
