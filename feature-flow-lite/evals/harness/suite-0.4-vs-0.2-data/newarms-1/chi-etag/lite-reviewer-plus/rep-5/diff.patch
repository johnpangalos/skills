+func TestETagFlushStopsBuffering(t *testing.T) {
+	rec := httptest.NewRecorder()
+	req := httptest.NewRequest("GET", "/", nil)
+	req.Header.Set("If-None-Match", "*")
+
+	ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("a"))
+		w.(http.Flusher).Flush()
+		if rec.Body.String() != "a" || !rec.Flushed {
+			t.Errorf("after Flush: body %q, flushed %v", rec.Body.String(), rec.Flushed)
+		}
+		w.Write([]byte("b"))
+	})).ServeHTTP(rec, req)
+
+	if rec.Code != http.StatusOK || rec.Body.String() != "ab" {
+		t.Fatalf("status %d, body %q", rec.Code, rec.Body.String())
+	}
+	if rec.Header().Get("ETag") != "" {
+		t.Fatalf("ETag = %q, want none after Flush", rec.Header().Get("ETag"))
+	}
+}
