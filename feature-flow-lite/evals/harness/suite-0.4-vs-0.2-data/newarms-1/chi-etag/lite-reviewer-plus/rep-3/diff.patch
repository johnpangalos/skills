+func TestETagRouter(t *testing.T) {
+	r := chi.NewRouter()
+	r.Use(ETag)
+	hello := func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "text/plain; charset=utf-8")
+		w.Write([]byte("hello"))
+	}
+	r.Get("/hello", hello)
+	r.Head("/hello", hello)
+	r.Post("/hello", func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("posted"))
+	})
+	ts := httptest.NewServer(r)
+	defer ts.Close()
+
+	resp, body := etagRequest(t, ts, http.MethodGet, "/hello", nil)
+	assertEqual(t, resp.StatusCode, http.StatusOK)
+	assertEqual(t, body, "hello")
+	etag := resp.Header.Get("ETag")
+	assertEqual(t, etag, etagFromBody("hello"))
+
+	resp, body = etagRequest(t, ts, http.MethodGet, "/hello", http.Header{"If-None-Match": {etag}})
+	assertEqual(t, resp.StatusCode, http.StatusNotModified)
+	assertEqual(t, body, "")
+
+	resp, body = etagRequest(t, ts, http.MethodHead, "/hello", nil)
+	assertEqual(t, resp.StatusCode, http.StatusOK)
+	assertEqual(t, body, "")
+	assertEqual(t, resp.Header.Get("ETag"), etag)
+	assertEqual(t, resp.Header.Get("Content-Length"), "5")
+
+	resp, body = etagRequest(t, ts, http.MethodPost, "/hello", http.Header{"If-None-Match": {etag}})
+	assertEqual(t, resp.StatusCode, http.StatusOK)
+	assertEqual(t, body, "posted")
+	assertEqual(t, resp.Header.Get("ETag"), "")
+}
