+func TestETagOptionalInterfaces(t *testing.T) {
+	rec := httptest.NewRecorder()
+	var unwrapped http.ResponseWriter
+	var hijackErr, pushErr error
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		unwrapped = w.(interface{ Unwrap() http.ResponseWriter }).Unwrap()
+		_, _, hijackErr = w.(http.Hijacker).Hijack()
+		pushErr = w.(http.Pusher).Push("/x", nil)
+	})
+	ETag(h).ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/", nil))
+	if unwrapped != http.ResponseWriter(rec) {
+		t.Fatalf("Unwrap did not return the underlying writer")
+	}
+	assertEqual(t, hijackErr.Error(), "chi/middleware: http.Hijacker is unavailable on the writer")
+	assertEqual(t, pushErr.Error(), "chi/middleware: http.Pusher is unavailable on the writer")
+
+	forwarded := hijackRecorder{httptest.NewRecorder()}
+	h = http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, _, hijackErr = w.(http.Hijacker).Hijack()
+		pushErr = w.(http.Pusher).Push("/x", nil)
+	})
+	ETag(h).ServeHTTP(forwarded, httptest.NewRequest(http.MethodGet, "/", nil))
+	if !errors.Is(hijackErr, errTestHijacked) {
+		t.Fatalf("Hijack not forwarded: %v", hijackErr)
+	}
+	if !errors.Is(pushErr, errTestPushed) {
+		t.Fatalf("Push not forwarded: %v", pushErr)
+	}
+}
