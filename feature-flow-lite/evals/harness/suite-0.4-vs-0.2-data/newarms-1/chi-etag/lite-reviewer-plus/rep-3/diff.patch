+func TestETagOutsideCompress(t *testing.T) {
+	const text = "hello hello hello hello"
+
+	r := chi.NewRouter()
+	r.Use(ETag)
+	r.Use(Compress(5))
+	r.Get("/", func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "text/plain")
+		w.Write([]byte(text))
+	})
+	ts := httptest.NewServer(r)
+	defer ts.Close()
+
+	gzipResp, gzipBody := etagRequest(t, ts, http.MethodGet, "/", http.Header{"Accept-Encoding": {"gzip"}})
+	assertEqual(t, gzipResp.Header.Get("Content-Encoding"), "gzip")
+	gzipETag := gzipResp.Header.Get("ETag")
+	assertEqual(t, gzipETag, etagFromBody(gzipBody))
+
+	identityResp, identityBody := etagRequest(t, ts, http.MethodGet, "/", http.Header{"Accept-Encoding": {"identity"}})
+	assertEqual(t, identityResp.Header.Get("Content-Encoding"), "")
+	assertEqual(t, identityBody, text)
+	identityETag := identityResp.Header.Get("ETag")
+	assertEqual(t, identityETag, etagFromBody(text))
+	if gzipETag == identityETag {
+		t.Fatalf("gzip and identity responses share ETag %q", gzipETag)
+	}
+
+	resp, body := etagRequest(t, ts, http.MethodGet, "/", http.Header{"Accept-Encoding": {"gzip"}, "If-None-Match": {gzipETag}})
+	assertEqual(t, resp.StatusCode, http.StatusNotModified)
+	assertEqual(t, body, "")
+}
