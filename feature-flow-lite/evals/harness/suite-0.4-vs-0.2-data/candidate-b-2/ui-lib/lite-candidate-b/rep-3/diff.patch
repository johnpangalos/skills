+import { useState } from "react";
+import { render, screen, within } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { Combobox, type ComboboxOption } from "../src/Combobox";
+
+const OPTIONS: ComboboxOption[] = [
+  { value: "apple", label: "Apple" },
+  { value: "banana", label: "Banana", disabled: true },
+  { value: "cherry", label: "Cherry" },
+  { value: "kiwi", label: "Kiwi (green)" },
+];
+
+function Harness({
+  options = OPTIONS,
+  initial = null,
+  onChange = () => {},
+  onSubmit = () => {},
+}: {
+  options?: ComboboxOption[];
+  initial?: string | null;
+  onChange?: (value: string | null) => void;
+  onSubmit?: () => void;
+}) {
+  const [value, setValue] = useState<string | null>(initial);
+  return (
+    <form
+      onSubmit={(event) => {
+        event.preventDefault();
+        onSubmit();
+      }}
+    >
+      <Combobox
+        label="Fruit"
+        options={options}
+        value={value}
+        placeholder="Pick a fruit"
+        onChange={(next) => {
+          setValue(next);
+          onChange(next);
+        }}
+      />
+    </form>
+  );
+}
+
+const input = () => screen.getByRole("combobox", { name: "Fruit" });
+const optionLabels = () => screen.queryAllByRole("option").map((el) => el.textContent);
+
+describe("Combobox", () => {
+  it("C1 renders a labelled input with ARIA wiring, and a listbox of options when open", async () => {
+    const user = userEvent.setup();
+    render(<Harness initial="cherry" />);
+    const combo = input();
+    expect(combo).toHaveAccessibleName("Fruit");
+    expect(screen.getByText("Fruit").tagName).toBe("LABEL");
+    expect(combo).toHaveAttribute("aria-expanded", "false");
+    expect(combo).toHaveAttribute("aria-autocomplete", "list");
+    expect(combo).toHaveAttribute("placeholder", "Pick a fruit");
+    await user.click(combo);
+    await user.keyboard("{ArrowDown}");
+    expect(combo).toHaveAttribute("aria-expanded", "true");
+    const listbox = screen.getByRole("listbox", { name: "Fruit" });
+    expect(combo.getAttribute("aria-controls")).toBe(listbox.id);
+    const options = within(listbox).getAllByRole("option");
+    expect(options.map((el) => el.textContent)).toEqual(["Apple", "Banana", "Cherry", "Kiwi (green)"]);
+    expect(new Set(options.map((el) => el.id)).size).toBe(4);
+    expect(options[2]).toHaveAttribute("aria-selected", "true");
+    expect(options[0]).toHaveAttribute("aria-selected", "false");
+    expect(options[1]).toHaveAttribute("aria-disabled", "true");
+  });
+
+  it("C2 shows the selected label, or empty for null or an unknown value, and follows value changes", () => {
+    const combo = (value: string | null) => (
+      <Combobox label="Fruit" options={OPTIONS} value={value} onChange={vi.fn()} />
+    );
+    const { rerender } = render(combo("cherry"));
+    expect(input()).toHaveValue("Cherry");
+    rerender(combo(null));
+    expect(input()).toHaveValue("");
+    rerender(combo("nope"));
