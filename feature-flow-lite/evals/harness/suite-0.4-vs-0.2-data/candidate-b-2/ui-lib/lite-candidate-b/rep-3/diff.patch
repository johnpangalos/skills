+import { useState } from "react";
+import { render, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { Combobox } from "../src/Combobox";
+import { Dialog } from "../src/Dialog";
+import { Tab, TabList, TabPanel, Tabs } from "../src/Tabs";
+
+function Basic({
+  open = true,
+  description,
+  onOpenChange = () => {},
+}: {
+  open?: boolean;
+  description?: string;
+  onOpenChange?: (open: boolean) => void;
+}) {
+  return (
+    <Dialog open={open} onOpenChange={onOpenChange} title="Delete file" description={description}>
+      <button>Confirm</button>
+      <button>Cancel</button>
+    </Dialog>
+  );
+}
+
+function Harness() {
+  const [open, setOpen] = useState(false);
+  return (
+    <>
+      <button onClick={() => setOpen(true)}>Open</button>
+      <Dialog open={open} onOpenChange={setOpen} title="Settings">
+        <input aria-label="Name" autoFocus />
+        <button>Save</button>
+      </Dialog>
+    </>
+  );
+}
+
+function Nested() {
+  const [outer, setOuter] = useState(false);
+  const [inner, setInner] = useState(false);
+  return (
+    <>
+      <button onClick={() => setOuter(true)}>Open outer</button>
+      <Dialog open={outer} onOpenChange={setOuter} title="Outer">
+        <button onClick={() => setInner(true)}>Open inner</button>
+        <Dialog open={inner} onOpenChange={setInner} title="Inner">
+          <button>Inside</button>
+        </Dialog>
+      </Dialog>
+    </>
+  );
+}
+
+// The backdrop is the element that wraps the dialog content.
+const backdropOf = () => screen.getByRole("dialog").parentElement as HTMLElement;
+
+describe("Dialog", () => {
+  it("D1 renders nothing when closed", () => {
+    render(<Basic open={false} />);
+    expect(screen.queryByRole("dialog")).toBeNull();
+    expect(screen.queryByText("Delete file")).toBeNull();
+  });
+
+  it("D1 renders a modal dialog in document.body labelled by its title", () => {
+    const { container } = render(<Basic />);
+    const dialog = screen.getByRole("dialog", { name: "Delete file" });
+    expect(dialog).toHaveAttribute("aria-modal", "true");
+    expect(container.contains(dialog)).toBe(false);
+    expect(dialog.getAttribute("aria-labelledby")).toBe(screen.getByRole("heading", { name: "Delete file" }).id);
+  });
+
+  it("D1 links aria-describedby only when a description is given", () => {
+    const { unmount } = render(<Basic description="This cannot be undone." />);
+    const described = screen.getByRole("dialog");
+    expect(described.getAttribute("aria-describedby")).toBe(screen.getByText("This cannot be undone.").id);
+    unmount();
+    render(<Basic />);
+    expect(screen.getByRole("dialog")).not.toHaveAttribute("aria-describedby");
+  });
+
+  it("D2 focuses the first tabbable element on open", () => {
+    render(<Basic />);
+    expect(screen.getByRole("button", { name: "Confirm" })).toHaveFocus();
+  });
+
+  it("D2 focuses the dialog container when it has no tabbable children", () => {
+    render(
+      <Dialog open title="Notice" onOpenChange={vi.fn()}>
+        <p>Saved.</p>
+      </Dialog>,
+    );
+    expect(screen.getByRole("dialog")).toHaveFocus();
+    expect(screen.getByRole("dialog")).toHaveAttribute("tabindex", "-1");
+  });
+
+  it("D2 keeps focus on a child with autoFocus", () => {
+    render(
+      <Dialog open title="Rename" onOpenChange={vi.fn()}>
+        <button>First</button>
+        <input aria-label="Name" autoFocus />
+      </Dialog>,
+    );
+    expect(screen.getByRole("textbox", { name: "Name" })).toHaveFocus();
+  });
+
+  it("D3 Tab wraps from last to first and Shift+Tab from first to last", async () => {
+    const user = userEvent.setup();
+    render(<Basic />);
+    expect(screen.getByRole("button", { name: "Confirm" })).toHaveFocus();
+    await user.tab();
+    expect(screen.getByRole("button", { name: "Cancel" })).toHaveFocus();
+    await user.tab();
+    expect(screen.getByRole("button", { name: "Confirm" })).toHaveFocus();
+    await user.tab({ shift: true });
+    expect(screen.getByRole("button", { name: "Cancel" })).toHaveFocus();
+  });
+
+  it("D3 skips disabled, tabIndex=-1 and hidden elements", async () => {
+    const user = userEvent.setup();
+    render(
+      <Dialog open title="Trap" onOpenChange={vi.fn()}>
+        <button>One</button>
+        <button disabled>Off</button>
+        <button tabIndex={-1}>Skip</button>
+        <button hidden>Gone</button>
+        <button>Two</button>
+      </Dialog>,
+    );
+    expect(screen.getByRole("button", { name: "One" })).toHaveFocus();
+    await user.tab();
+    expect(screen.getByRole("button", { name: "Two" })).toHaveFocus();
