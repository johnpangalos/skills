+import { useState, type ReactNode } from 'react';
+import { act, render, screen } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import { renderToString } from 'react-dom/server';
+import { Dialog } from '../src/Dialog';
+import { Tab, TabList, TabPanel, Tabs } from '../src/Tabs';
+
+type AppProps = {
+  spy?: (open: boolean) => void;
+  description?: string;
+  children?: ReactNode;
+};
+
+// A page with an opener button and a dialog that the opener toggles.
+function App({ spy = vi.fn(), description, children }: AppProps) {
+  const [open, setOpen] = useState(false);
+  return (
+    <>
+      <button onClick={() => setOpen(true)}>Open</button>
+      <Dialog
+        open={open}
+        onOpenChange={(next) => {
+          spy(next);
+          setOpen(next);
+        }}
+        title="Settings"
+        description={description}
+      >
+        {children ?? (
+          <>
+            <button>First</button>
+            <button>Second</button>
+          </>
+        )}
+      </Dialog>
+    </>
+  );
+}
+
+// Two levels: the outer dialog holds the button that opens the inner one.
+function Nested({ outerSpy = vi.fn(), innerSpy = vi.fn() }: { outerSpy?: (o: boolean) => void; innerSpy?: (o: boolean) => void }) {
+  const [outer, setOuter] = useState(false);
+  const [inner, setInner] = useState(false);
+  return (
+    <>
+      <button onClick={() => setOuter(true)}>Open outer</button>
+      <Dialog
+        open={outer}
+        onOpenChange={(next) => {
+          outerSpy(next);
+          setOuter(next);
+        }}
+        title="Outer"
+      >
+        <button onClick={() => setInner(true)}>Open inner</button>
+        <Dialog
+          open={inner}
+          onOpenChange={(next) => {
+            innerSpy(next);
+            setInner(next);
+          }}
+          title="Inner"
+        >
+          <button>Inner action</button>
+        </Dialog>
+      </Dialog>
+    </>
+  );
+}
+
+const button = (name: string) => screen.getByRole('button', { name });
+const dialog = () => screen.getByRole('dialog');
+const backdrop = () => document.querySelector('[data-backdrop]') as HTMLElement;
+
+describe('Dialog', () => {
+  it('D1 renders a backdrop and a labelled modal dialog in a portal on document.body, and nothing when closed', async () => {
+    const user = userEvent.setup();
+    render(<App description="Change things" />);
+    expect(screen.queryByRole('dialog')).toBeNull();
+    expect(backdrop()).toBeNull();
+
+    await user.click(button('Open'));
+    const modal = dialog();
+    expect(modal).toHaveAttribute('aria-modal', 'true');
+    const heading = screen.getByRole('heading', { name: 'Settings' });
+    expect(modal).toHaveAttribute('aria-labelledby', heading.id);
+    expect(modal).toHaveAccessibleDescription('Change things');
+    expect(backdrop().parentElement).toBe(document.body);
