+  it('G2 two instances have distinct ids and do not affect each other', async () => {
+    const user = userEvent.setup();
+    render(
+      <>
+        <Example defaultValue="one" />
+        <Example defaultValue="one" />
+      </>,
+    );
+    const [first, second] = screen.getAllByRole('tablist').map((list) => within(list));
+    expect(first.getByRole('tab', { name: 'one' }).id).not.toBe(second.getByRole('tab', { name: 'one' }).id);
+    await user.click(first.getByRole('tab', { name: 'two' }));
+    expect(first.getByRole('tab', { name: 'two' })).toHaveAttribute('aria-selected', 'true');
+    expect(second.getByRole('tab', { name: 'one' })).toHaveAttribute('aria-selected', 'true');
+  });
+
+  it('nested Tabs: arrows in the inner tablist move only the inner tabs', async () => {
+    const user = userEvent.setup();
+    render(
+      <Tabs defaultValue="outer-a">
+        <TabList aria-label="Outer">
+          <Tab value="outer-a">Outer A</Tab>
+          <Tab value="outer-b">Outer B</Tab>
+        </TabList>
+        <TabPanel value="outer-a">
+          <Example defaultValue="one" />
+        </TabPanel>
+        <TabPanel value="outer-b">outer b</TabPanel>
+      </Tabs>,
+    );
+    await user.click(tab('one'));
+    await user.keyboard('{ArrowRight}');
+    expect(tab('two')).toHaveFocus();
+    expect(screen.getByRole('tab', { name: 'Outer A' })).toHaveAttribute('aria-selected', 'true');
+    expect(screen.getByRole('tab', { name: 'Outer B' })).toHaveAttribute('aria-selected', 'false');
+  });
+
+  it('T3 the tab stop moves when a tab becomes disabled, without TabList re-rendering', () => {
+    let toggle: () => void = () => {};
+    function LeafTab() {
+      const [off, setOff] = useState(false);
+      toggle = () => setOff((v) => !v);
+      return (
+        <Tab value="a" disabled={off}>
+          a
+        </Tab>
+      );
+    }
+    render(
+      <Tabs value="a" onValueChange={() => {}}>
+        <TabList aria-label="Sections">
+          <LeafTab />
+          <Tab value="b">b</Tab>
+        </TabList>
+      </Tabs>,
+    );
+    expect(tab('a')).toHaveAttribute('tabindex', '0');
+    act(() => toggle());
+    expect(tab('b')).toHaveAttribute('tabindex', '0');
+    expect(tab('a')).toHaveAttribute('tabindex', '-1');
+  });
+
+  it('T2 uncontrolled: removing the selected tab without TabList re-rendering selects the first enabled tab', () => {
+    let remove: () => void = () => {};
+    function LeafTab() {
+      const [gone, setGone] = useState(false);
+      remove = () => setGone(true);
+      return gone ? null : <Tab value="a">a</Tab>;
+    }
+    render(
+      <Tabs defaultValue="a">
+        <TabList aria-label="Sections">
+          <LeafTab />
+          <Tab value="b">b</Tab>
+        </TabList>
+        <TabPanel value="b">b panel</TabPanel>
+      </Tabs>,
+    );
+    act(() => remove());
+    expect(tab('b')).toHaveAttribute('aria-selected', 'true');
+    const stops = screen.getAllByRole('tab').filter((t) => t.getAttribute('tabindex') === '0');
+    expect(stops).toHaveLength(1);
+    expect(stops[0]).toBe(tab('b'));
+  });
+
+  it('G1 passes className and data attributes to the root of each part', () => {
+    render(
+      <Tabs data-testid="root" className="r">
+        <TabList aria-label="x" data-testid="list" className="l">
+          <Tab value="a" data-testid="tab" className="t">
+            A
+          </Tab>
+        </TabList>
+        <TabPanel value="a" data-testid="panel" className="p">
+          P
+        </TabPanel>
+      </Tabs>,
+    );
+    expect(screen.getByTestId('root')).toHaveClass('r');
+    expect(screen.getByTestId('list')).toHaveClass('l');
+    expect(screen.getByTestId('tab')).toHaveClass('t');
+    expect(screen.getByTestId('panel')).toHaveClass('p');
+  });
+});
