@@ -1,3 +1,121 @@
 # @acme/ui
 
-Accessible React components.
+Accessible React components. No CSS is shipped: every component accepts `className` and passes other native props to its root element, so you bring your own styles.
+
+Requires React 19. No runtime dependencies.
+
+## Running
+
+```sh
+pnpm install
+pnpm test        # Vitest with jsdom
+pnpm typecheck   # tsc --noEmit
+```
+
+## Tabs
+
+A tab set following the WAI-ARIA Tabs pattern. Compose `Tabs`, `TabList`, `Tab` and `TabPanel`.
+
+### Tabs
+
+| Prop            | Type                       | Notes                                                                  |
+| --------------- | -------------------------- | ---------------------------------------------------------------------- |
+| `defaultValue`  | `string`                   | Initially selected tab. Without it the first enabled tab is selected. |
+| `value`         | `string`                   | Controlled selection. The selection changes only when this changes.   |
+| `onValueChange` | `(value: string) => void`  | Called when the user selects a different tab, in both modes.          |
+
+Native `div` props are passed to the root element.
+
+### TabList
+
+| Prop         | Type     | Notes                                  |
+| ------------ | -------- | -------------------------------------- |
+| `aria-label` | `string` | Required. Names the `tablist`.         |
+
+Native `div` props are passed through. Renders `role="tablist"`.
+
+### Tab
+
+| Prop       | Type      | Notes                                                    |
+| ---------- | --------- | -------------------------------------------------------- |
+| `value`    | `string`  | Required. Identifies the tab and its panel.              |
+| `disabled` | `boolean` | Disabled tabs cannot be clicked or reached by the keyboard. |
+
+Native `button` props are passed through. Renders `<button type="button" role="tab">`.
+
+### TabPanel
+
+| Prop    | Type     | Notes                                                  |
+| ------- | -------- | ------------------------------------------------------ |
+| `value` | `string` | Required. Shown only while its tab is selected.       |
+
+Native `div` props are passed through. Renders `role="tabpanel"`, labelled by its tab.
+
+### Keyboard (tablist)
+
+| Key                | Behaviour                                                                     |
+| ------------------ | ----------------------------------------------------------------------------- |
+| `ArrowRight`       | Focuses and selects the next enabled tab, wrapping from the last to the first. |
+| `ArrowLeft`        | Focuses and selects the previous enabled tab, wrapping from the first to the last. |
+| `Home` / `End`     | Focuses and selects the first / last enabled tab.                             |
+| `Tab`              | Moves focus out of the tablist to the selected tab.                           |
+
+Selection follows focus. Other keys are ignored. Only the selected tab has `tabIndex=0`; when no tab is selected, the first enabled tab does.
+
+## Dialog
+
+A modal dialog rendered into `document.body` with a backdrop.
+
+| Prop          | Type                         | Notes                                                                      |
+| ------------- | ---------------------------- | -------------------------------------------------------------------------- |
+| `open`        | `boolean`                    | Required. Nothing renders while `false`.                                   |
+| `onOpenChange`| `(open: boolean) => void`    | Required. Called with `false` on Escape or a backdrop click.               |
+| `title`       | `ReactNode`                  | Required. Rendered in an `h2` and used as the accessible name.             |
+| `description` | `ReactNode`                  | Optional. Rendered in a `p` and used as the accessible description.        |
+
+Native `div` props (including `className`) are passed to the `role="dialog"` element. The backdrop has `data-backdrop`.
+
+On open, focus moves to the first focusable element in the dialog (or to a child with `autoFocus`), or to the dialog itself if there is none. Closing returns focus to the element that was focused before opening, if it is still in the document.
+
+Nested dialogs are supported: only the topmost one handles Escape and the focus trap.
+
+### Keyboard
+
+| Key                | Behaviour                                                                                  |
+| ------------------ | ------------------------------------------------------------------------------------------ |
+| `Tab`              | Moves to the next focusable element, wrapping from the last to the first. Skips disabled, `hidden`, `inert` and `tabIndex=-1` elements. |
+| `Shift+Tab`        | Moves to the previous focusable element, wrapping from the first to the last.              |
+| `Escape`           | Calls `onOpenChange(false)`, unless a child already handled the key (see Combobox).      |
+
+## Combobox
+
+A text input that filters a list of options, following the WAI-ARIA combobox (list autocomplete) pattern.
+
+| Prop          | Type                                      | Notes                                                                 |
+| ------------- | ----------------------------------------- | --------------------------------------------------------------------- |
+| `label`       | `string`                                  | Required. Rendered in a `label` for the input.                        |
+| `options`     | `ComboboxOption[]`                        | Required. `ComboboxOption` is `{ value: string; label: string; disabled?: boolean }`. |
+| `value`       | `string \| null`                          | Required. The selected option's `value`, or `null` for none.          |
+| `onChange`    | `(value: string \| null) => void`         | Required. Called when an option is committed, or when the text is cleared and the field is left or Enter is pressed. |
+| `placeholder` | `string`                                  | Shown in the input.                                                   |
+
+Native `input` props (including `className`) are passed to the input. Its `value` and `onChange` are managed by the component.
+
+Behaviour:
+
+- While not typing, the input shows the label of the selected option (empty if `value` matches no option). Changing `value` updates the text.
+- Typing opens the listbox and shows options whose label contains the text (case-insensitive, literal match).
+- The active option is tracked by `value`. When the list changes, the same option stays active if it is still visible and enabled; otherwise no option is active.
+- Committing an option calls `onChange(option.value)` and closes the list. With a controlled `value`, the input shows the new label only once the parent updates `value`.
+- Clearing the text to empty and then pressing Enter or leaving the field calls `onChange(null)` (only if `value` was not already `null`). Leaving the field with other text reverts the text to the selected label without calling `onChange`.
+
+### Keyboard
+
+| Key                | Behaviour                                                                                             |
+| ------------------ | ----------------------------------------------------------------------------------------------------- |
+| `ArrowDown`        | Opens the listbox if closed (activating the first enabled option), otherwise moves the active option to the next enabled one, wrapping. |
+| `ArrowUp`          | Opens the listbox if closed (activating the last enabled option), otherwise moves to the previous enabled option, wrapping. |
+| `Enter`            | Commits the active option. With no active option, applies the cleared-text rule above.              |
+| `Escape`           | Closes the listbox without calling `onChange` and restores the selected label. If the listbox is already closed, the key is not consumed, so an enclosing Dialog closes. |
+
+Clicking an enabled option commits it and keeps focus in the input. Clicking a disabled option does nothing.
diff --git a/src/Combobox.tsx b/src/Combobox.tsx
new file mode 100644
index 0000000..9c1e4d6
--- /dev/null
+++ b/src/Combobox.tsx
@@ -0,0 +1,141 @@
+import * as React from "react";
+
+export type ComboboxOption = {
+  value: string;
+  label: string;
+  disabled?: boolean;
+};
+
+export type ComboboxProps = Omit<React.InputHTMLAttributes<HTMLInputElement>, "value" | "defaultValue" | "onChange"> & {
+  label: string;
+  options: ComboboxOption[];
+  value: string | null;
+  onChange: (value: string | null) => void;
+};
+
+function filterOptions(options: ComboboxOption[], query: string): ComboboxOption[] {
+  const needle = query.toLowerCase();
+  return options.filter((option) => option.label.toLowerCase().includes(needle));
+}
+
+export function Combobox({ label, options, value, onChange, onKeyDown, onBlur, ...rest }: ComboboxProps) {
+  const baseId = React.useId();
+  const inputId = `${baseId}-input`;
+  const labelId = `${baseId}-label`;
+  const listboxId = `${baseId}-listbox`;
+  const [open, setOpen] = React.useState(false);
+  // The text being typed. Null while the input shows the selected option's label.
+  const [draft, setDraft] = React.useState<string | null>(null);
+  // Tracked by value, so a list that changes while open keeps the same option active.
+  const [activeValue, setActiveValue] = React.useState<string | null>(null);
+
+  const selectedLabel = options.find((option) => option.value === value)?.label ?? "";
+  const visible = filterOptions(options, draft ?? "");
+  const enabled = visible.filter((option) => !option.disabled);
+  const active = open ? enabled.find((option) => option.value === activeValue) : undefined;
+
+  const closeList = () => {
+    setOpen(false);
+    setActiveValue(null);
+  };
+
+  const commit = (option: ComboboxOption) => {
+    onChange(option.value);
+    setDraft(null);
+    closeList();
+  };
+
+  // Enter without an active option, or leaving the input. Clearing the text clears the selection.
+  const settle = () => {
+    if (draft === "" && value !== null) onChange(null);
+    setDraft(null);
+    closeList();
+  };
+
+  const handleInput = (event: React.ChangeEvent<HTMLInputElement>) => {
+    const query = event.target.value;
+    setDraft(query);
+    setOpen(true);
+    if (!filterOptions(options, query).some((option) => option.value === activeValue && !option.disabled)) {
+      setActiveValue(null);
+    }
+  };
+
+  const handleKeyDown = (event: React.KeyboardEvent<HTMLInputElement>) => {
+    onKeyDown?.(event);
+    switch (event.key) {
+      case "ArrowDown":
+      case "ArrowUp": {
+        event.preventDefault();
+        setOpen(true);
+        if (enabled.length === 0) return;
+        const step = event.key === "ArrowDown" ? 1 : -1;
+        const index = active ? enabled.indexOf(active) : -1;
+        const next =
+          index === -1
+            ? enabled[step > 0 ? 0 : enabled.length - 1]
+            : enabled[(index + step + enabled.length) % enabled.length];
+        setActiveValue(next.value);
+        return;
+      }
+      case "Enter":
+        if (active) {
+          event.preventDefault();
+          commit(active);
+        } else {
+          settle();
+        }
+        return;
+      case "Escape":
+        if (open) event.preventDefault();
+        setDraft(null);
+        closeList();
+        return;
+    }
+  };
+
+  const handleBlur = (event: React.FocusEvent<HTMLInputElement>) => {
+    onBlur?.(event);
+    settle();
+  };
+
+  return (
+    <div>
+      <label id={labelId} htmlFor={inputId}>
+        {label}
+      </label>
+      <input
+        {...rest}
+        id={inputId}
+        role="combobox"
+        autoComplete="off"
+        value={draft ?? selectedLabel}
+        aria-autocomplete="list"
+        aria-expanded={open}
+        aria-controls={listboxId}
+        aria-activedescendant={active ? `${baseId}-option-${encodeURIComponent(active.value)}` : undefined}
+        onChange={handleInput}
+        onKeyDown={handleKeyDown}
+        onBlur={handleBlur}
+      />
+      <ul id={listboxId} role="listbox" aria-labelledby={labelId} hidden={!open}>
+        {visible.map((option) => (
+          <li
+            key={option.value}
+            id={`${baseId}-option-${encodeURIComponent(option.value)}`}
+            role="option"
+            aria-selected={option.value === value}
+            aria-disabled={option.disabled ? "true" : undefined}
+            onMouseDown={(event) => event.preventDefault()}
+            onClick={() => {
+              if (!option.disabled) commit(option);
+            }}
+          >
+            {option.label}
+          </li>
+        ))}
+      </ul>
+      {open && visible.length === 0 && <div>No results</div>}
+    </div>
+  );
+}
diff --git a/src/Dialog.tsx b/src/Dialog.tsx
new file mode 100644
index 0000000..b8069a4
--- /dev/null
+++ b/src/Dialog.tsx
@@ -0,0 +1,129 @@
+import * as React from "react";
+import { createPortal } from "react-dom";
+
+export type DialogProps = Omit<React.HTMLAttributes<HTMLDivElement>, "title"> & {
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+  title: React.ReactNode;
+  description?: React.ReactNode;
+};
+
+type PanelProps = Omit<DialogProps, "open">;
+
+type Layer = {
+  // The dialog this one is rendered inside, if any. Portals hide that from the DOM.
+  parent: Layer | null;
+  dialog: React.RefObject<HTMLDivElement | null>;
+};
+
+const DialogLayerContext = React.createContext<Layer | null>(null);
+
+// Open dialogs in registration order. Effects run child first, so a dialog mounted open inside
+// another one can register before its parent does.
+const openDialogs: Layer[] = [];
+
+// Only the top layer handles Escape and Tab: the latest one with no open dialog inside it.
+function topLayer(): Layer | undefined {
+  return openDialogs.filter((layer) => !openDialogs.some((other) => other.parent === layer)).pop();
+}
+
+const FOCUSABLE = 'a[href], button, input:not([type="hidden"]), select, textarea, [tabindex]';
+
+function focusables(dialog: HTMLElement): HTMLElement[] {
+  return Array.from(dialog.querySelectorAll<HTMLElement>(FOCUSABLE)).filter(
+    (element) => element.tabIndex >= 0 && !element.matches(":disabled") && !element.closest("[hidden], [inert]"),
+  );
+}
+
+export function Dialog({ open, ...rest }: DialogProps) {
+  if (!open) return null;
+  return createPortal(<DialogPanel {...rest} />, document.body);
+}
+
+function DialogPanel({ onOpenChange, title, description, children, ...rest }: PanelProps) {
+  const titleId = React.useId();
+  const descriptionId = React.useId();
+  const dialogRef = React.useRef<HTMLDivElement>(null);
+  const parent = React.useContext(DialogLayerContext);
+  const [layer] = React.useState<Layer>(() => ({ parent, dialog: dialogRef }));
+  // Read on mount, before any autoFocus child takes focus, so close can return to the opener.
+  const [opener] = React.useState(() => document.activeElement);
+  const hasDescription = description !== undefined && description !== null;
+
+  React.useEffect(() => {
+    const dialog = dialogRef.current!;
+    // A dialog mounted open inside this one has already taken focus.
+    const childOpen = openDialogs.some((other) => other.parent === layer);
+    if (!childOpen && !dialog.contains(document.activeElement)) {
+      (focusables(dialog)[0] ?? dialog).focus();
+    }
+    return () => {
+      // An opener outside the parent dialog (or the body, when mounted open) is not a place to return to
+      // while the parent is still open, so return to the parent instead.
+      const insideParent = parent === null || (parent.dialog.current?.contains(opener) ?? false);
+      const restorable = opener instanceof HTMLElement && opener !== document.body && opener.isConnected && insideParent;
+      (restorable ? opener : parent?.dialog.current)?.focus();
+    };
+  }, [opener, layer, parent]);
+
+  React.useEffect(() => {
+    openDialogs.push(layer);
+    return () => {
+      openDialogs.splice(openDialogs.indexOf(layer), 1);
+    };
+  }, [layer]);
+
+  React.useEffect(() => {
+    const onKeyDown = (event: KeyboardEvent) => {
+      const dialog = dialogRef.current!;
+      if (topLayer() !== layer) return;
+      if (event.key === "Escape") {
+        // A child that handled Escape (such as an open Combobox listbox) keeps the dialog open.
+        // Marking the event handled stops an outer dialog from also closing on this keypress.
+        if (event.defaultPrevented) return;
+        event.preventDefault();
+        onOpenChange(false);
+      } else if (event.key === "Tab") {
+        const items = focusables(dialog);
+        event.preventDefault();
+        if (items.length === 0) {
+          dialog.focus();
+          return;
+        }
+        const index = items.indexOf(document.activeElement as HTMLElement);
+        const last = items.length - 1;
+        const next = event.shiftKey
+          ? items[index <= 0 ? last : index - 1]
+          : items[index === -1 || index === last ? 0 : index + 1];
+        next.focus();
+      }
+    };
+    document.addEventListener("keydown", onKeyDown);
+    return () => document.removeEventListener("keydown", onKeyDown);
+  }, [layer, onOpenChange]);
+
+  return (
+    <DialogLayerContext.Provider value={layer}>
+      <div
+        data-backdrop=""
+        onClick={(event) => {
+          if (event.target === event.currentTarget) onOpenChange(false);
+        }}
+      >
+        <div
+          {...rest}
+          ref={dialogRef}
+          role="dialog"
+          aria-modal="true"
+          aria-labelledby={titleId}
+          aria-describedby={hasDescription ? descriptionId : undefined}
+          tabIndex={-1}
+        >
+          <h2 id={titleId}>{title}</h2>
+          {hasDescription && <p id={descriptionId}>{description}</p>}
+          {children}
+        </div>
+      </div>
+    </DialogLayerContext.Provider>
+  );
+}
diff --git a/src/Tabs.tsx b/src/Tabs.tsx
new file mode 100644
index 0000000..d77b51f
--- /dev/null
+++ b/src/Tabs.tsx
@@ -0,0 +1,167 @@
+import * as React from "react";
+
+export type TabsProps = Omit<React.HTMLAttributes<HTMLDivElement>, "defaultValue"> & {
+  defaultValue?: string;
+  value?: string;
+  onValueChange?: (value: string) => void;
+};
+
+export type TabListProps = React.HTMLAttributes<HTMLDivElement> & {
+  "aria-label": string;
+};
+
+export type TabProps = Omit<React.ButtonHTMLAttributes<HTMLButtonElement>, "value"> & {
+  value: string;
+  disabled?: boolean;
+};
+
+export type TabPanelProps = React.HTMLAttributes<HTMLDivElement> & {
+  value: string;
+};
+
+type TabsContextValue = {
+  baseId: string;
+  selected: string | null;
+  isTabStop: (value: string, disabled?: boolean) => boolean;
+  select: (value: string) => void;
+  setEnabled: (values: string[]) => void;
+};
+
+const TabsContext = React.createContext<TabsContextValue | null>(null);
+
+function useTabsContext() {
+  const context = React.useContext(TabsContext);
+  if (!context) {
+    throw new Error("Tab, TabList and TabPanel must be rendered inside Tabs");
+  }
+  return context;
+}
+
+function enabledTabs(list: HTMLElement | null): HTMLButtonElement[] {
+  return list ? Array.from(list.querySelectorAll<HTMLButtonElement>('[role="tab"]:not(:disabled)')) : [];
+}
+
+export function Tabs({ defaultValue, value, onValueChange, ...rest }: TabsProps) {
+  const baseId = React.useId();
+  const [internal, setInternal] = React.useState(defaultValue);
+  // Null until TabList has measured the DOM (after the first commit).
+  const [enabled, setEnabled] = React.useState<string[] | null>(null);
+  const controlled = value !== undefined;
+  const current = controlled ? value : internal;
+  // With no defaultValue, the first enabled tab is selected.
+  const selected = current === undefined ? (enabled?.[0] ?? null) : current;
+  const list = enabled ?? [];
+  // The selected tab is the tab-stop when it is enabled; otherwise the first enabled tab is.
+  const tabbable = selected !== null && list.includes(selected) ? selected : (list[0] ?? null);
+  // Before measuring, a Tab cannot know if it is the first enabled one. Until then every
+  // enabled tab is a tab-stop, so a Dialog that focuses on open still lands on a tab.
+  const isTabStop = (value: string, disabled = false) => {
+    if (enabled !== null) return tabbable === value;
+    return selected === null ? !disabled : selected === value;
+  };
+
+  const select = (next: string) => {
+    if (next === selected) return;
+    if (!controlled) setInternal(next);
+    onValueChange?.(next);
+  };
+
+  // TabList reports the enabled tabs after each render; keep state stable so this does not loop.
+  const updateEnabled = React.useCallback(
+    (next: string[]) => setEnabled((prev) => (JSON.stringify(prev) === JSON.stringify(next) ? prev : next)),
+    [],
+  );
+
+  return (
+    <TabsContext.Provider value={{ baseId, selected, isTabStop, select, setEnabled: updateEnabled }}>
+      <div {...rest} />
+    </TabsContext.Provider>
+  );
+}
+
+export function TabList({ onKeyDown, ...rest }: TabListProps) {
+  const { setEnabled, select } = useTabsContext();
+  const ref = React.useRef<HTMLDivElement>(null);
+
+  const measure = () => setEnabled(enabledTabs(ref.current).map((tab) => tab.value));
+
+  React.useLayoutEffect(() => {
+    measure();
+  });
+
+  // A child that owns its state can add, remove or disable tabs without re-rendering TabList,
+  // so watch the DOM as well.
+  React.useLayoutEffect(() => {
+    const observer = new MutationObserver(measure);
+    observer.observe(ref.current!, { childList: true, subtree: true, attributes: true, attributeFilter: ["disabled"] });
+    return () => observer.disconnect();
+  }, [setEnabled]);
+
+  const handleKeyDown = (event: React.KeyboardEvent<HTMLDivElement>) => {
+    onKeyDown?.(event);
+    const tabs = enabledTabs(ref.current);
+    const index = tabs.indexOf(event.target as HTMLButtonElement);
+    if (index === -1) return;
+
+    let next: HTMLButtonElement;
+    switch (event.key) {
+      case "ArrowRight":
+        next = tabs[(index + 1) % tabs.length];
+        break;
+      case "ArrowLeft":
+        next = tabs[(index - 1 + tabs.length) % tabs.length];
+        break;
+      case "Home":
+        next = tabs[0];
+        break;
+      case "End":
+        next = tabs[tabs.length - 1];
+        break;
+      default:
+        return;
+    }
+    event.preventDefault();
+    next.focus();
+    select(next.value);
+  };
+
+  return <div {...rest} ref={ref} role="tablist" onKeyDown={handleKeyDown} />;
+}
+
+export function Tab({ value, disabled, onClick, ...rest }: TabProps) {
+  const { baseId, selected, isTabStop, select } = useTabsContext();
+  const key = encodeURIComponent(value);
+  return (
+    <button
+      {...rest}
+      type="button"
+      role="tab"
+      id={`${baseId}-tab-${key}`}
+      value={value}
+      aria-selected={selected === value}
+      aria-controls={`${baseId}-panel-${key}`}
+      tabIndex={isTabStop(value, disabled) ? 0 : -1}
+      disabled={disabled}
+      onClick={(event) => {
+        onClick?.(event);
+        if (!disabled) select(value);
+      }}
+    />
+  );
+}
+
+export function TabPanel({ value, ...rest }: TabPanelProps) {
+  const { baseId, selected } = useTabsContext();
+  const key = encodeURIComponent(value);
+  const isSelected = selected === value;
+  return (
+    <div
+      {...rest}
+      role="tabpanel"
+      id={`${baseId}-panel-${key}`}
+      aria-labelledby={`${baseId}-tab-${key}`}
+      hidden={!isSelected}
+      tabIndex={isSelected ? 0 : undefined}
+    />
+  );
+}
