+        <TabPanel value="b">B panel</TabPanel>
+        <TabPanel value="c">C panel</TabPanel>
+      </Tabs>,
+    );
+    await user.click(screen.getByRole("button", { name: "Hide A" }));
+    const b = screen.getByRole("tab", { name: "B" });
+    await waitFor(() => expect(b).toHaveAttribute("tabindex", "0"));
+    expect(screen.getByRole("tab", { name: "C" })).toHaveAttribute("tabindex", "-1");
+    await user.tab();
+    expect(b).toHaveFocus();
+  });
+
+  it("T3 keeps a tab-stop when a child component disables the tab that was tabbable", async () => {
+    const user = userEvent.setup();
+    // The child owns its state, so only the child re-renders when it disables tab "a".
+    function ChildList() {
+      const [disabled, setDisabled] = React.useState(false);
+      return (
+        <>
+          <button type="button" onClick={() => setDisabled(true)}>
+            Disable A
+          </button>
+          <Tab value="a" disabled={disabled}>
+            A
+          </Tab>
+          <Tab value="b">B</Tab>
+          <Tab value="c">C</Tab>
+        </>
+      );
+    }
+    render(
+      <Tabs defaultValue="a">
+        <TabList aria-label="x">
+          <ChildList />
+        </TabList>
+        <TabPanel value="a">A panel</TabPanel>
+        <TabPanel value="b">B panel</TabPanel>
+        <TabPanel value="c">C panel</TabPanel>
+      </Tabs>,
+    );
+    await user.click(screen.getByRole("button", { name: "Disable A" }));
+    const b = screen.getByRole("tab", { name: "B" });
+    await waitFor(() => expect(b).toHaveAttribute("tabindex", "0"));
+    expect(screen.getByRole("tab", { name: "C" })).toHaveAttribute("tabindex", "-1");
+    await user.tab();
+    expect(b).toHaveFocus();
+  });
+});
