+// Save comes before the name input, so the first focusable is Save unless autoFocus is set.
+function Harness({ autoFocus = false, description, onOpenChange }: {
+  autoFocus?: boolean;
+  description?: string;
+  onOpenChange?: (open: boolean) => void;
+}) {
+  const [open, setOpen] = React.useState(false);
+  return (
+    <>
+      <button type="button" onClick={() => setOpen(true)}>
+        Open
+      </button>
+      <Dialog
+        open={open}
+        onOpenChange={(next) => {
+          onOpenChange?.(next);
+          setOpen(next);
+        }}
+        title="Edit profile"
+        description={description}
+      >
+        <button type="button">Save</button>
+        <input aria-label="Name" autoFocus={autoFocus} />
+      </Dialog>
+    </>
+  );
+}
+
+function Shell({ open, showTrigger = true }: { open: boolean; showTrigger?: boolean }) {
