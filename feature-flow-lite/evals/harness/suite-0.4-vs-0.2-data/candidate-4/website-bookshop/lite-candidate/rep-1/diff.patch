@@ -0,0 +1,88 @@
+// Highlights today's opening hours (local time) and checks the contact form. Nothing is sent.
+(function () {
+  var DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
+  var DEMO_MESSAGE = 'This is a demo site, so your message wasn\'t sent. To reach us for real, email hello@marginalia.test or call (555) 010-0142.';
+
+  var form = document.getElementById('contact-form');
+  var statusBox = document.getElementById('form-status');
+
+  var RULES = [
+    { id: 'name', message: 'Enter your name.', valid: nonBlank },
+    { id: 'email', message: 'Enter an email address such as name@example.com.', valid: validEmail },
+    { id: 'subject', message: 'Enter a subject for your message.', valid: nonBlank },
+    { id: 'message', message: 'Enter a message.', valid: nonBlank }
+  ];
+
+  function nonBlank(value) {
+    return value.trim() !== '';
+  }
+
+  function validEmail(value) {
+    var email = value.trim();
+    // No leading or trailing dot, no empty label next to a dot and no dot touching the @.
+    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) && !/^\.|\.$|\.\.|\.@|@\./.test(email);
+  }
+
+  function highlightToday() {
+    var today = DAYS[new Date().getDay()];
+    document.querySelectorAll('.hours-table tr[data-day]').forEach(function (row) {
+      if (row.getAttribute('data-day') !== today) return;
+      row.classList.add('is-today');
+      var note = document.createElement('span');
+      note.className = 'today-note';
+      note.textContent = ' (today)';
+      row.querySelector('th').appendChild(note);
+    });
+  }
+
+  // Sets aria-invalid, the linked error text and its visibility for one field.
+  function checkField(rule) {
+    var field = document.getElementById(rule.id);
+    var error = document.getElementById(rule.id + '-error');
+    var ok = rule.valid(field.value);
+    field.setAttribute('aria-invalid', ok ? 'false' : 'true');
+    error.textContent = ok ? '' : rule.message;
+    error.hidden = ok;
+    if (ok) {
+      field.removeAttribute('aria-describedby');
+    } else {
+      field.setAttribute('aria-describedby', error.id);
+    }
+    return ok;
+  }
+
+  // Clears the status, then sets it a moment later so a repeated message is announced again.
+  var statusTimer = null;
+  function setStatus(text) {
+    clearTimeout(statusTimer);
+    statusBox.textContent = '';
+    statusTimer = setTimeout(function () {
+      statusBox.textContent = text;
+    }, 50);
+  }
+
+  function onSubmit(event) {
+    event.preventDefault();
+    // Check every field so all errors show at once, then focus the first invalid one.
+    var firstInvalid = null;
+    RULES.forEach(function (rule) {
+      if (!checkField(rule) && firstInvalid === null) firstInvalid = rule;
+    });
+    if (firstInvalid !== null) {
+      setStatus('');
+      document.getElementById(firstInvalid.id).focus();
+      return;
+    }
+    setStatus(DEMO_MESSAGE);
+  }
+
+  highlightToday();
+  // The send button ships disabled, so without JavaScript nothing can be submitted into the URL.
+  form.querySelector('button[type="submit"]').disabled = false;
+  form.addEventListener('submit', onSubmit);
+  RULES.forEach(function (rule) {
+    document.getElementById(rule.id).addEventListener('input', function () {
+      if (this.getAttribute('aria-invalid') === 'true') checkField(rule);
+    });
+  });
+})();
diff --git a/tests/a11y.test.mjs b/tests/a11y.test.mjs
new file mode 100644
index 0000000..be20618
--- /dev/null
+++ b/tests/a11y.test.mjs
@@ -0,0 +1,153 @@
+// Criterion 10: keyboard order, visible focus, contrast, decorative graphics, motion, affordances.
+import assert from 'node:assert/strict';
+import { PAGES, auditContrast, contrastRatio } from './helpers.mjs';
+
+const TEXT_SELECTORS = [
+  'main p', 'main h1', 'main h2', 'main h3', 'main a', 'main button', 'main label', 'main th', 'main td',
+  'main caption', 'nav a', 'nav button', '[aria-current="page"]', 'header .brand', 'footer', 'footer a',
+  '.skip-link',
+];
+
+async function tabTo(page, selector, limit = 60) {
+  for (let i = 0; i < limit; i += 1) {
+    await page.keyboard.press('Tab');
+    if (await page.evaluate((sel) => document.activeElement.matches(sel), selector)) return;
+  }
+  throw new Error(`Tab never reached ${selector}`);
+}
+
+async function focusStyle(page) {
+  return page.evaluate(() => {
+    const el = document.activeElement;
+    const cs = getComputedStyle(el);
+    return {
+      visible: el.matches(':focus-visible'),
+      style: cs.outlineStyle,
+      width: parseFloat(cs.outlineWidth),
+      color: cs.outlineColor,
+      bg: (() => {
+        for (let node = el; node; node = node.parentElement) {
+          const c = getComputedStyle(node).backgroundColor;
+          if (!/rgba\(\s*\d+,\s*\d+,\s*\d+,\s*0\)|transparent/.test(c)) return c;
+        }
+        return 'rgb(255, 255, 255)';
+      })(),
+    };
+  });
+}
+
+function rgb(text) {
+  return text.match(/\d+(\.\d+)?/g).slice(0, 3).map(Number);
+}
+
+export const tests = [
+  {
+    name: 'criterion 10: every control on the visit form is reachable by Tab in logical order',
+    async run(ctx) {
+      const { page } = await ctx.open();
+      await page.goto(ctx.url('visit.html'));
+      const order = [];
+      for (let i = 0; i < 80; i += 1) {
+        await page.keyboard.press('Tab');
+        const id = await page.evaluate(() => document.activeElement.id || document.activeElement.textContent.trim());
+        order.push(id);
+        if (id === 'Send message') break;
+      }
+      const seen = ['name', 'email', 'subject', 'message', 'Send message'].map((id) => order.indexOf(id));
+      assert.ok(seen.every((n) => n >= 0), `all fields reachable, saw ${order.join(', ')}`);
+      assert.deepEqual(seen, [...seen].sort((a, b) => a - b), 'fields are reached in reading order');
+    },
+  },
+  {
+    name: 'criterion 10: a visible focus style shows on links, buttons and form fields',
+    async run(ctx) {
+      const { page } = await ctx.open();
+      await page.goto(ctx.url('visit.html'));
+      await tabTo(page, 'a[href="index.html"]');
+      let f = await focusStyle(page);
+      assert.equal(f.visible, true, 'link matches :focus-visible');
+      assert.ok(f.style !== 'none' && f.width >= 2, `link outline ${f.style} ${f.width}px`);
+      assert.ok(contrastRatio(rgb(f.color), rgb(f.bg)) >= 3, 'focus ring contrast at least 3:1');
+      await tabTo(page, '#name');
+      f = await focusStyle(page);
+      assert.ok(f.visible && f.style !== 'none' && f.width >= 2, 'form field focus ring');
+      await tabTo(page, 'button[type="submit"]');
+      f = await focusStyle(page);
+      assert.ok(f.visible && f.style !== 'none' && f.width >= 2, 'button focus ring');
+    },
+  },
+  {
+    name: 'criterion 10: text, links, buttons, current nav item, error text and focus ring meet contrast on every page',
+    async run(ctx) {
+      const { page } = await ctx.open();
+      for (const file of PAGES) {
+        await page.goto(ctx.url(file));
+        const pairs = await auditContrast(page, TEXT_SELECTORS);
+        assert.ok(pairs.length > 10, `${file} should have measurable text`);
+        for (const pair of pairs) {
+          assert.ok(pair.ratio >= 4.5, `${file}: "${pair.text}" (${pair.sel}) contrast ${pair.ratio.toFixed(2)}:1`);
+        }
+      }
+      await page.goto(ctx.url('visit.html'));
+      await page.locator('#contact-form button[type="submit"]').click();
+      const errors = await auditContrast(page, ['.field-error']);
+      assert.ok(errors.length >= 4, 'error messages shown');
+      for (const pair of errors) assert.ok(pair.ratio >= 4.5, `error text contrast ${pair.ratio.toFixed(2)}:1`);
+    },
+  },
+  {
+    name: 'criterion 10: the nav menu button meets contrast when collapsed at 360px',
+    async run(ctx) {
+      const { page } = await ctx.open({ viewport: { width: 360, height: 740 } });
+      await page.goto(ctx.url('books.html'));
+      await page.getByRole('button', { name: 'Menu' }).click();
+      const pairs = await auditContrast(page, ['nav button', 'nav a', '.skip-link', 'main h1']);
+      assert.ok(pairs.length >= 6, `menu button and open menu links are measured (${pairs.length})`);
+      for (const pair of pairs) assert.ok(pair.ratio >= 4.5, `${pair.sel} "${pair.text}" ${pair.ratio.toFixed(2)}:1`);
+    },
+  },
+  {
+    name: 'criterion 10: decorative SVG is hidden from assistive technology and every image has alt text',
+    async run(ctx) {
+      const { page } = await ctx.open();
+      let svgs = 0;
+      for (const file of PAGES) {
+        await page.goto(ctx.url(file));
+        const audit = await page.evaluate(() => ({
+          svgs: Array.from(document.querySelectorAll('svg')).map((s) => s.getAttribute('aria-hidden')),
+          imgsWithoutAlt: Array.from(document.querySelectorAll('img')).filter((i) => !i.hasAttribute('alt')).length,
+        }));
+        svgs += audit.svgs.length;
+        assert.deepEqual(audit.svgs.filter((v) => v !== 'true'), [], `${file} has an SVG not aria-hidden`);
+        assert.equal(audit.imgsWithoutAlt, 0, `${file} has an image without alt`);
+      }
+      assert.ok(svgs >= 1, 'the site uses at least one decorative SVG for this check to mean something');
+    },
+  },
+  {
+    name: 'criterion 10: transitions are removed when the user prefers reduced motion',
+    async run(ctx) {
+      const motion = async (reducedMotion) => {
+        const { page } = await ctx.open({ reducedMotion });
+        await page.goto(ctx.url('visit.html'));
+        return page.evaluate(() => parseFloat(getComputedStyle(document.querySelector('#contact-form button[type="submit"]')).transitionDuration));
+      };
+      assert.ok((await motion('no-preference')) > 0, 'button has a transition by default');
+      assert.equal(await motion('reduce'), 0, 'transition removed under prefers-reduced-motion: reduce');
+    },
+  },
+  {
+    name: 'criterion 10: nothing looks clickable unless it is a link, button or form control',
+    async run(ctx) {
+      const { page } = await ctx.open();
+      for (const file of PAGES) {
+        await page.goto(ctx.url(file));
+        const offenders = await page.evaluate(() => Array.from(document.querySelectorAll('body *'))
+          .filter((el) => getComputedStyle(el).cursor === 'pointer')
+          .filter((el) => !el.closest('a[href], button, select, input, textarea, label, summary'))
+          .map((el) => el.tagName.toLowerCase() + '.' + el.className));
+        assert.deepEqual(offenders, [], `${file} shows a pointer cursor on non-controls`);
+      }
+    },
+  },
+];
diff --git a/tests/books.test.mjs b/tests/books.test.mjs
new file mode 100644
index 0000000..b499d30
--- /dev/null
+++ b/tests/books.test.mjs
@@ -0,0 +1,208 @@
+// Criterion 6 (books catalog and genre filter) and the filtered-list triggered check.
+import assert from 'node:assert/strict';
+
+const TOTAL = 14;
+
+async function readState(page) {
+  return page.evaluate(() => ({
+    value: document.getElementById('genre-filter').value,
+    param: new URL(location.href).searchParams.get('genre'),
+    visibleGenres: Array.from(document.querySelectorAll('.book-list > li'))
+      .filter((li) => !li.hidden)
+      .map((li) => li.dataset.genre),
+    count: document.getElementById('result-count').textContent,
+    emptyVisible: !document.getElementById('empty-state').hidden,
+  }));
+}
+
+// genre is '' for All. Checks control, URL, visible list and count all agree.
+async function expectState(page, genre, shown) {
+  const state = await readState(page);
+  assert.equal(state.value, genre, 'select shows the effective genre');
+  assert.equal(state.param, genre === '' ? null : genre, 'URL genre parameter');
+  assert.equal(state.visibleGenres.length, shown, 'visible book count');
+  if (genre !== '') assert.ok(state.visibleGenres.every((g) => g === genre), 'only matching books visible');
+  assert.equal(state.count, `Showing ${shown} of ${TOTAL} books`, 'result count');
+  return state;
+}
+
+export const tests = [
+  {
+    name: 'criterion 6: catalog has at least 12 titles across at least 5 genres, some genres with several titles',
+    async run(ctx) {
+      const { page } = await ctx.open();
+      await page.goto(ctx.url('books.html'));
+      const books = await page.$$eval('.book-list > li[data-genre]', (items) => items.map((li) => ({
+        genre: li.dataset.genre,
+        title: li.querySelector('h2')?.textContent.trim() ?? '',
+        author: li.querySelector('.book-author')?.textContent.trim() ?? '',
+        description: li.querySelector('.book-description')?.textContent.trim() ?? '',
+        price: li.querySelector('.book-price')?.textContent.trim() ?? '',
+        genreLabel: li.querySelector('.book-genre')?.textContent.trim() ?? '',
+      })));
+      assert.equal(books.length, TOTAL);
+      assert.ok(books.length >= 12);
+      for (const book of books) {
+        assert.ok(book.title && book.author && book.description, `book "${book.title}" needs title, author and description`);
+        assert.match(book.price, /^\$\d+\.\d{2}$/, `price for "${book.title}"`);
+        assert.equal(book.genreLabel, book.genre, 'genre shown matches data genre');
+      }
+      assert.equal(new Set(books.map((b) => b.title)).size, books.length, 'titles unique');
+      const counts = {};
+      for (const book of books) counts[book.genre] = (counts[book.genre] ?? 0) + 1;
+      assert.ok(Object.keys(counts).length >= 5, 'at least five genres');
+      assert.ok(Object.values(counts).some((n) => n >= 2), 'some genre has several titles');
+    },
+  },
+  {
+    name: 'criterion 6: the genre filter is a labelled select with an All option and one option per genre',
+    async run(ctx) {
+      const { page } = await ctx.open();
+      await page.goto(ctx.url('books.html'));
+      const select = page.getByLabel('Genre', { exact: true });
+      assert.equal(await select.evaluate((el) => el.tagName), 'SELECT');
+      const options = await select.evaluate((el) => Array.from(el.options).map((o) => [o.value, o.textContent]));
+      assert.deepEqual(options[0], ['', 'All genres']);
+      assert.deepEqual(options.slice(1).map(([v]) => v), ['Cookery', 'Literary Fiction', 'Mystery', 'Nature & Place', 'Science Fiction']);
+    },
+  },
+  {
+    name: 'criterion 6: choosing a genre shows only its books and updates the count in a polite live region',
+    async run(ctx) {
+      const { page } = await ctx.open();
+      await page.goto(ctx.url('books.html'));
+      await expectState(page, '', TOTAL);
+      assert.equal(await page.locator('#result-count').getAttribute('aria-live'), 'polite');
+      await page.selectOption('#genre-filter', 'Mystery');
+      await expectState(page, 'Mystery', 4);
+      assert.equal(await page.locator('#result-count').textContent(), 'Showing 4 of 14 books');
+    },
+  },
+  {
+    name: 'criterion 6: the selected genre is written to the URL, restored on reload, and restored by back and forward',
+    async run(ctx) {
+      const { page } = await ctx.open();
+      await page.goto(ctx.url('books.html'));
+      await page.selectOption('#genre-filter', 'Mystery');
+      await page.selectOption('#genre-filter', 'Cookery');
+      await expectState(page, 'Cookery', 2);
+      await page.goBack();
+      await expectState(page, 'Mystery', 4);
+      await page.goForward();
+      await expectState(page, 'Cookery', 2);
+      await page.reload();
+      await expectState(page, 'Cookery', 2);
+    },
+  },
+  {
+    name: 'criterion 6 hostile: an unknown genre in the URL is treated as All without an error',
+    async run(ctx) {
+      const { page, errors } = await ctx.open();
+      await page.goto(ctx.url('books.html?genre=unknown-value'));
+      await expectState(page, '', TOTAL);
+      assert.deepEqual(errors, []);
+    },
+  },
+  {
+    name: 'criterion 6 hostile: an empty genre parameter is treated as All',
+    async run(ctx) {
+      const { page, errors } = await ctx.open();
+      await page.goto(ctx.url('books.html?genre='));
+      await expectState(page, '', TOTAL);
+      assert.deepEqual(errors, []);
+    },
+  },
+  {
+    name: 'criterion 6 hostile: a genre in the wrong case is matched and the URL is normalised',
+    async run(ctx) {
+      const { page } = await ctx.open();
+      await page.goto(ctx.url('books.html?genre=MYSTERY'));
+      await expectState(page, 'Mystery', 4);
+    },
+  },
+  {
+    name: 'criterion 6 hostile: a script tag in the genre parameter is inert and treated as All',
+    async run(ctx) {
+      const { page, dialogs, errors } = await ctx.open();
+      const payload = encodeURIComponent('<script>alert(1)</script>');
+      await page.goto(ctx.url(`books.html?genre=${payload}`));
+      await expectState(page, '', TOTAL);
+      assert.deepEqual(dialogs, [], 'no alert should fire');
+      assert.deepEqual(errors, []);
+      assert.equal(await page.evaluate(() => document.body.innerHTML.includes('<script>alert')), false);
+    },
+  },
+  {
+    name: 'criterion 6 hostile: genres with spaces and punctuation round-trip through the URL',
+    async run(ctx) {
+      const { page } = await ctx.open();
+      await page.goto(ctx.url('books.html'));
+      await page.selectOption('#genre-filter', 'Science Fiction');
+      const param = await page.evaluate(() => new URL(location.href).searchParams.get('genre'));
+      assert.equal(param, 'Science Fiction');
+      await page.reload();
+      await expectState(page, 'Science Fiction', 3);
+      await page.selectOption('#genre-filter', 'Nature & Place');
+      await page.reload();
+      await expectState(page, 'Nature & Place', 2);
+      await page.goto(ctx.url('books.html?genre=Science%20Fiction'));
+      await expectState(page, 'Science Fiction', 3);
+    },
+  },
+  {
+    name: 'criterion 6 hostile: a genre with zero books shows the empty-state message',
+    async run(ctx) {
+      const { page, errors } = await ctx.open();
+      await page.goto(ctx.url('books.html'));
+      await page.evaluate(() => document.getElementById('genre-filter').add(new Option('Poetry', 'Poetry')));
+      await page.selectOption('#genre-filter', 'Poetry');
+      const state = await expectState(page, 'Poetry', 0);
+      assert.equal(state.emptyVisible, true, 'empty-state message shown');
+      assert.ok((await page.locator('#empty-state').textContent()).includes('No books'));
+      assert.deepEqual(errors, []);
+    },
+  },
+  {
+    name: 'triggered filtered list: changing the filter while viewing keeps control, URL and results in sync; All restores everything',
+    async run(ctx) {
+      const { page } = await ctx.open();
+      await page.goto(ctx.url('books.html?genre=Mystery'));
+      await expectState(page, 'Mystery', 4);
+      await page.selectOption('#genre-filter', 'Literary Fiction');
+      await expectState(page, 'Literary Fiction', 3);
+      await page.selectOption('#genre-filter', '');
+      await expectState(page, '', TOTAL);
+      await page.goBack();
+      await expectState(page, 'Literary Fiction', 3);
+    },
+  },
+  {
+    name: 'triggered filtered list: the genre select works from the keyboard and updates list and URL',
+    async run(ctx) {
+      const { page } = await ctx.open();
+      await page.goto(ctx.url('books.html'));
+      for (let i = 0; i < 30; i += 1) {
+        if (await page.evaluate(() => document.activeElement.id === 'genre-filter')) break;
+        await page.keyboard.press('Tab');
+      }
+      assert.equal(await page.evaluate(() => document.activeElement.id), 'genre-filter', 'select reached by Tab');
+      await page.keyboard.press('ArrowDown');
+      await expectState(page, 'Cookery', 2);
+      await page.keyboard.press('ArrowUp');
+      await expectState(page, '', TOTAL);
+    },
+  },
+  {
+    name: 'finding 3: with JavaScript off the genre options are in the HTML and match the catalog genres exactly',
+    async run(ctx) {
+      const { page } = await ctx.open({ javaScriptEnabled: false });
+      await page.goto(ctx.url('books.html'));
+      const options = await page.$$eval('#genre-filter option', (opts) => opts.map((o) => [o.value, o.textContent.trim()]));
+      assert.deepEqual(options[0], ['', 'All genres']);
+      const catalog = await page.$$eval('.book-list > li[data-genre]', (items) => items.map((li) => li.dataset.genre));
+      const genres = [...new Set(catalog)].sort();
+      assert.deepEqual(options.slice(1).map(([value]) => value), genres, 'option values match the catalog genres');
+      assert.deepEqual(options.slice(1).map(([, label]) => label), genres, 'option labels match the catalog genres');
+    },
+  },
+];
