+/* Marginalia Books: one stylesheet shared by every page. */
+
+:root {
+  --paper: #fbf7f0;
+  --card: #ffffff;
+  --ink: #211c17;
+  --muted: #554a3f;
+  --accent: #1f4d3a;
+  --accent-hover: #163a2b;
+  --link: #1f4d3a;
+  --rule: #d8cdbd;
+  --field-border: #7a6d5e;
+  --tint: #efe6d7;
+  --focus: #9a4300;
+  --error: #9b1c1c;
+  --serif: Georgia, "Iowan Old Style", "Times New Roman", serif;
+  --sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
+}
+
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+
+[hidden] {
+  display: none !important;
+}
+
+body {
+  margin: 0;
+  font-family: var(--sans);
+  font-size: 1.0625rem;
+  line-height: 1.6;
+  color: var(--ink);
+  background: var(--paper);
+  overflow-wrap: anywhere;
+}
+
+h1,
+h2,
+h3 {
+  font-family: var(--serif);
+  line-height: 1.2;
+  margin: 0 0 0.5rem;
+}
+
+h1 {
+  font-size: 2rem;
+  margin-top: 0;
+}
+
+h2 {
+  font-size: 1.5rem;
+  margin-top: 2rem;
+}
+
+h3 {
+  font-size: 1.2rem;
+}
+
+p {
+  margin: 0 0 1rem;
+}
+
+a {
+  color: var(--link);
+  text-decoration-thickness: 1px;
+  text-underline-offset: 0.15em;
+}
+
+:focus-visible {
+  outline: 3px solid var(--focus);
+  outline-offset: 2px;
+}
+
+main:focus {
+  outline: none;
+}
+
+/* Skip link: off-screen until it receives focus. */
+.skip-link {
+  position: absolute;
+  left: 1rem;
+  top: -4rem;
+  z-index: 10;
+  padding: 0.5rem 1rem;
+  background: var(--ink);
+  color: var(--paper);
+  font-weight: 600;
+  border-radius: 4px;
+}
+
+.skip-link:focus {
+  top: 1rem;
+}
+
+/* Header and navigation */
+.site-header {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0.5rem 1rem;
+  padding: 0.75rem 1rem;
+  border-bottom: 1px solid var(--rule);
+}
+
+.brand {
+  margin: 0;
+  font-family: var(--serif);
+  font-size: 1.3rem;
+  font-weight: 700;
+}
+
+.brand a {
+  color: var(--ink);
+  text-decoration: none;
+}
+
+.site-nav {
+  width: 100%;
+}
+
+/* The menu button is hidden unless JavaScript runs (html.js), so the links stay reachable without it. */
+.nav-toggle {
+  display: none;
+  font: inherit;
+  font-weight: 600;
+  padding: 0.5rem 1rem;
+  color: var(--accent);
+  background: var(--paper);
+  border: 2px solid var(--accent);
+  border-radius: 4px;
+  cursor: pointer;
+}
+
+.site-nav-list {
+  display: block;
+  list-style: none;
+  margin: 0.5rem 0 0;
+  padding: 0;
+  border-top: 1px solid var(--rule);
+}
+
+/* Narrow screens with JavaScript: the list collapses behind the menu button. */
+@media not all and (min-width: 40rem) {
+  .js .nav-toggle {
+    display: inline-block;
+  }
+
+  .js .site-nav-list {
+    display: none;
+  }
+
+  .js .site-nav.is-open .site-nav-list {
+    display: block;
+  }
+}
+
+.site-nav-list a {
+  display: block;
+  padding: 0.6rem 0;
+  color: var(--ink);
+}
+
+.site-nav-list a[aria-current="page"] {
+  font-weight: 700;
+  text-decoration: underline;
+  text-decoration-thickness: 2px;
+}
+
+main {
+  display: block;
+  max-width: 64rem;
+  margin: 0 auto;
+  padding: 1rem 1rem 3rem;
+}
+
+/* Buttons and shared blocks */
+.button {
+  display: inline-block;
+  padding: 0.7rem 1.2rem;
+  font: inherit;
+  font-weight: 600;
+  color: var(--paper);
+  background: var(--accent);
+  border: 0;
+  border-radius: 4px;
+  text-decoration: none;
+  cursor: pointer;
+  transition: background-color 0.2s ease;
+}
+
+.button:hover {
+  background: var(--accent-hover);
+}
+
+/* A disabled button (the contact form send button without JavaScript) must not look clickable. */
+.button:disabled {
+  background: var(--muted);
+  cursor: not-allowed;
+}
+
+.card {
+  margin: 0;
+  padding: 1rem;
+  background: var(--card);
+  border: 1px solid var(--rule);
+  border-radius: 6px;
+}
+
+.lede {
+  font-size: 1.15rem;
+  max-width: 40rem;
+}
+
+.ornament {
+  display: block;
+  width: 120px;
+  height: 24px;
+  margin: 0 0 1rem;
+  color: var(--muted);
+}
+
+/* Home */
+.home-section {
+  margin-top: 1.5rem;
+}
+
+.featured-list {
+  list-style: none;
+  margin: 0 0 1rem;
+  padding: 0;
+  display: grid;
+  gap: 1rem;
+  grid-template-columns: minmax(0, 1fr);
+}
+
+/* Books */
+.filter {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 0.5rem 0.75rem;
+  margin: 1.5rem 0 0.5rem;
+}
+
+.filter label {
+  font-weight: 600;
+}
+
+select {
+  font: inherit;
+  max-width: 100%;
+  min-width: 12rem;
+  padding: 0.5rem 0.6rem;
+  color: var(--ink);
+  background: var(--card);
+  border: 1px solid var(--field-border);
+  border-radius: 4px;
+}
+
+.result-count {
+  font-weight: 600;
+}
+
+.empty-state {
+  padding: 1rem;
+  border: 1px dashed var(--muted);
+  border-radius: 6px;
+}
+
+.book-list {
+  list-style: none;
+  margin: 1rem 0 0;
+  padding: 0;
+  display: grid;
+  gap: 1rem;
+  grid-template-columns: minmax(0, 1fr);
+}
+
+.book-card {
+  min-width: 0;
+  padding: 1rem;
+  background: var(--card);
+  border: 1px solid var(--rule);
+  border-radius: 6px;
+}
+
+.book-title {
+  font-size: 1.2rem;
+  margin: 0 0 0.25rem;
+}
+
+.book-author,
+.book-description {
+  margin: 0 0 0.5rem;
+}
+
+.book-meta {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: space-between;
+  gap: 0.25rem 1rem;
+  color: var(--muted);
+  font-size: 0.95rem;
+}
+
+.book-genre {
+  font-weight: 600;
+}
+
+/* Events */
+.event-list {
+  list-style: none;
+  margin: 1.5rem 0 0;
+  padding: 0;
+  display: grid;
+  gap: 1rem;
+  grid-template-columns: minmax(0, 1fr);
+}
+
+.event {
+  margin: 0;
+  padding: 1.1rem 1.25rem;
+  background: var(--card);
+  border: 1px solid var(--rule);
+  border-radius: 6px;
+}
+
+.event h2 {
+  margin: 0 0 0.3rem;
+  font-size: 1.3rem;
+}
+
+.event-when {
+  margin: 0 0 0.5rem;
+  color: var(--muted);
+  font-weight: 600;
+}
+
+/* Visit: hours table, address and form */
+table {
+  width: 100%;
+  border-collapse: collapse;
+  margin-bottom: 1rem;
+}
+
+caption {
+  text-align: left;
+  font-weight: 600;
+  padding-bottom: 0.5rem;
+}
+
+th,
+td {
+  padding: 0.5rem 0.6rem;
+  text-align: left;
+  vertical-align: top;
+  border-bottom: 1px solid var(--rule);
+}
+
+tr.is-today th,
+tr.is-today td {
+  background: var(--tint);
+  font-weight: 700;
+}
+
+.today-note {
+  font-weight: 600;
+}
+
+address {
+  font-style: normal;
+  margin: 0 0 1rem;
+  padding: 0.75rem 1rem;
+  background: var(--card);
+  border-left: 4px solid var(--accent);
+}
+
+.visit-grid {
+  display: grid;
+  gap: 2rem;
+  grid-template-columns: minmax(0, 1fr);
+}
+
+.form-note {
+  color: var(--muted);
+}
+
+.contact-form {
+  display: grid;
+  gap: 1rem;
+  max-width: 36rem;
+}
+
+.field {
+  display: grid;
+  gap: 0.35rem;
+}
+
+.field label {
+  font-weight: 600;
+}
+
+input,
+textarea {
+  font: inherit;
+  width: 100%;
+  padding: 0.6rem 0.7rem;
+  color: var(--ink);
+  background: var(--card);
+  border: 1px solid var(--field-border);
+  border-radius: 4px;
+}
+
+input[aria-invalid="true"],
+textarea[aria-invalid="true"] {
+  border: 2px solid var(--error);
+}
+
+.field-error {
+  margin: 0;
+  color: var(--error);
+  font-weight: 600;
+  font-size: 0.95rem;
+}
+
+.form-status:not(:empty) {
+  margin: 0;
+  padding: 0.75rem 1rem;
+  font-weight: 600;
+  background: var(--card);
+  border-left: 4px solid var(--accent);
+}
+
+/* Footer */
+.site-footer {
+  padding: 1.5rem 1rem;
+  background: var(--tint);
+  border-top: 1px solid var(--rule);
+}
+
+.site-footer p {
+  max-width: 64rem;
+  margin: 0 0 0.4rem;
+}
+
+/* Wider screens: inline nav, multi-column lists */
+@media (min-width: 40rem) {
+  .site-nav {
+    width: auto;
+  }
+
+  .site-nav-list {
+    display: flex;
+    gap: 1.25rem;
+    margin: 0;
+    border-top: 0;
+  }
+
+  .site-nav-list a {
+    padding: 0.25rem 0;
+  }
+
+  .featured-list {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+  }
+
+  .book-list {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+}
+
+@media (min-width: 60rem) {
+  .book-list {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+  }
+
+  .visit-grid {
+    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    transition: none !important;
+    animation: none !important;
+    scroll-behavior: auto !important;
+  }
+}
