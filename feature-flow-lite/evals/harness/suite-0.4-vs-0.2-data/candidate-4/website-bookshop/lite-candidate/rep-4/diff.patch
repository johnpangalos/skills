+    { day: 'Wednesday', weekday: 3, open: '10:00', close: '18:30' },
+    { day: 'Thursday', weekday: 4, open: '10:00', close: '20:00' },
+    { day: 'Friday', weekday: 5, open: '10:00', close: '18:30' },
