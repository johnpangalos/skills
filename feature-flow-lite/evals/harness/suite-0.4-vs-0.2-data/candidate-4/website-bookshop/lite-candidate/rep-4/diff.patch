@@ -0,0 +1,552 @@
+/* Marginalia Books. System font stacks only, rem units throughout, no animation. */
+
+:root {
+  --paper: #f7f1e5;
+  --paper-deep: #efe3cc;
+  --card: #fffaf1;
+  --ink: #2b2219;
+  --ink-soft: #5a4b3c;
+  --oxblood: #7b2d1e;
+  --oxblood-deep: #5f2114;
+  --rule: #d8c7a6;
+  --field-border: #8a7a66;
+  --focus: #1d4e5f;
+  --error: #9b1c1c;
+  --error-tint: #fbe9e5;
+  --today: #efdcb8;
+  --serif-text: Charter, "Bitstream Charter", "Sitka Text", Cambria, Georgia, "Times New Roman", serif;
+  --serif-display: "Iowan Old Style", "Palatino Linotype", Palatino, "Book Antiqua", Georgia, serif;
+}
+
+[hidden] {
+  display: none !important;
+}
+
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+
+html {
+  -webkit-text-size-adjust: 100%;
+}
+
+body {
+  margin: 0;
+  background: var(--paper);
+  color: var(--ink);
+  font-family: var(--serif-text);
+  font-size: 1.0625rem;
+  line-height: 1.65;
+  overflow-wrap: anywhere;
+  text-rendering: optimizeLegibility;
+}
+
+h1,
+h2,
+h3 {
+  font-family: var(--serif-display);
+  line-height: 1.2;
+  color: var(--ink);
+  letter-spacing: -0.01em;
+}
+
+h1 {
+  margin: 0 0 0.75rem;
+  font-size: clamp(2rem, 6vw, 2.9rem);
+  font-weight: 600;
+}
+
+h2 {
+  margin: 0 0 0.75rem;
+  font-size: clamp(1.4rem, 4vw, 1.8rem);
+  font-weight: 600;
+}
+
+h3 {
+  margin: 0 0 0.4rem;
+  font-size: 1.2rem;
+  font-weight: 600;
+}
+
+p {
+  margin: 0 0 1rem;
+  max-width: 42rem;
+}
+
+a {
+  color: var(--oxblood);
+  text-decoration-thickness: 1px;
+  text-underline-offset: 0.2em;
+}
+
+a:hover {
+  color: var(--oxblood-deep);
+}
+
+:focus-visible {
+  outline: 3px solid var(--focus);
+  outline-offset: 3px;
+}
+
+main:focus {
+  outline: none;
+}
+
+.skip-link {
+  position: absolute;
+  top: -4rem;
+  left: 1rem;
+  z-index: 10;
+  padding: 0.6rem 1rem;
+  background: var(--card);
+  color: var(--ink);
+  border: 2px solid var(--focus);
+  font-weight: 600;
+}
+
+.skip-link:focus {
+  top: 1rem;
+}
+
+/* Masthead and navigation */
+
+.site-header {
+  border-bottom: 1px solid var(--rule);
+  background: var(--paper-deep);
+  padding: 1rem;
+}
+
+.masthead {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0.75rem 1.5rem;
+  max-width: 60rem;
+  margin: 0 auto;
+}
+
+.brand {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.5rem;
+  font-family: var(--serif-display);
+  font-size: 1.35rem;
+  font-weight: 600;
+  color: var(--ink);
+  text-decoration: none;
+}
+
+.brand svg {
+  width: 1.4rem;
+  height: 1.4rem;
+  flex: none;
+  fill: none;
+  stroke: var(--oxblood);
+  stroke-width: 1.5;
+}
+
+.site-nav {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.25rem 1.25rem;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.site-nav a {
+  display: inline-block;
+  min-height: 2.75rem;
+  padding: 0.55rem 0;
+  color: var(--ink);
+  text-decoration-color: var(--oxblood);
+}
+
+.site-nav a[aria-current="page"] {
+  color: var(--oxblood);
+  font-weight: 700;
+  text-decoration: underline;
+  text-decoration-thickness: 2px;
+}
+
+/* Page layout */
+
+main {
+  max-width: 60rem;
+  margin: 0 auto;
+  padding: 2rem 1rem 3rem;
+}
+
+.lede {
+  font-size: 1.2rem;
+  line-height: 1.6;
+}
+
+section + section {
+  margin-top: 2.5rem;
+}
+
+.site-footer {
+  border-top: 1px solid var(--rule);
+  background: var(--paper-deep);
+  padding: 1.5rem 1rem;
+  color: var(--ink-soft);
+  font-size: 0.95rem;
+}
+
+.site-footer p {
+  max-width: 60rem;
+  margin: 0 auto 0.4rem;
+}
+
+/* Catalogue */
+
+.genre-filter {
+  margin: 0 0 1.5rem;
+  padding: 0;
+  border: 0;
+}
+
+.genre-filter legend {
+  padding: 0;
+  margin-bottom: 0.6rem;
+  font-family: var(--serif-display);
+  font-weight: 600;
+}
+
+.genre-options {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.5rem;
+}
+
+.genre-option {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.4rem;
+  min-height: 2.75rem;
+  padding: 0.2rem 0.9rem 0.2rem 0.6rem;
+  border: 1px solid var(--field-border);
+  border-radius: 999px;
+  background: var(--card);
+}
+
+.genre-option:has(input:checked) {
+  background: var(--ink);
+  border-color: var(--ink);
+}
+
+.genre-option:has(input:checked) label {
+  color: var(--card);
+}
+
+.genre-option input {
+  width: 1.1rem;
+  height: 1.1rem;
+  margin: 0;
+  accent-color: var(--oxblood);
+}
+
+.genre-option label {
+  cursor: pointer;
+}
+
+.result-count {
+  margin: 0 0 1.25rem;
+  color: var(--ink-soft);
+  font-style: italic;
+}
+
+.book-list,
+.featured-list {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
+  gap: 1.25rem;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.book-card,
+.featured-item {
+  padding: 1.25rem 1.25rem 1.25rem 1.1rem;
+  border: 1px solid var(--rule);
+  border-left: 0.3rem solid var(--oxblood);
+  border-radius: 0.25rem;
+  background: var(--card);
+}
+
+.book-card p,
+.featured-item p {
+  margin-bottom: 0.5rem;
+}
+
+.book-author {
+  font-style: italic;
+  color: var(--ink-soft);
+}
+
+.book-genre {
+  font-size: 0.8rem;
+  font-weight: 600;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: var(--ink-soft);
+}
+
+.book-blurb {
+  font-size: 0.98rem;
+  line-height: 1.55;
+}
+
+.book-price {
+  margin: 0.75rem 0 0;
+  font-weight: 600;
+}
+
+/* Events */
+
+.event-list {
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.event-card {
+  padding: 1.25rem 0;
+  border-top: 1px solid var(--rule);
+}
+
+.event-when {
+  margin-bottom: 0.2rem;
+  font-weight: 600;
+  color: var(--oxblood);
+}
+
+.event-time {
+  margin-bottom: 0.5rem;
+  color: var(--ink-soft);
+}
+
+.event-booking {
+  margin: 0.5rem 0 0;
+  font-size: 0.95rem;
+  font-weight: 600;
+}
+
+/* Visit */
+
+.open-status {
+  font-weight: 600;
+  font-size: 1.1rem;
+}
+
+.table-wrap {
+  max-width: 40rem;
+}
+
+.hours-table {
+  width: 100%;
+  border-collapse: collapse;
+  margin-bottom: 1.5rem;
+}
+
+.hours-table caption {
+  text-align: left;
+  font-family: var(--serif-display);
+  font-size: 1.2rem;
+  font-weight: 600;
+  margin-bottom: 0.5rem;
+}
+
+.hours-table th,
+.hours-table td {
+  padding: 0.6rem 0.5rem;
+  border-bottom: 1px solid var(--rule);
+  text-align: left;
+  vertical-align: top;
+}
+
+.hours-table thead th {
+  font-size: 0.85rem;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  color: var(--ink-soft);
+}
+
+.hours-table tr.is-today {
+  background: var(--today);
+}
+
+.hours-table tr.is-today th {
+  font-weight: 700;
+}
+
+.today-label {
+  font-weight: 400;
+  color: var(--oxblood);
+}
+
+address {
+  font-style: normal;
+  margin-bottom: 1rem;
+}
+
+.visit-grid {
+  display: grid;
+  gap: 1.5rem;
+}
+
+.note-list {
+  margin: 0 0 1rem;
+  padding-left: 1.25rem;
+}
+
+.note-list li {
+  margin-bottom: 0.4rem;
+}
+
+/* Contact form */
+
+.contact-form {
+  display: grid;
+  gap: 1.1rem;
+  max-width: 36rem;
+  padding: 1.5rem;
+  border: 1px solid var(--rule);
+  border-radius: 0.25rem;
+  background: var(--card);
+}
+
+.field {
+  display: grid;
+  gap: 0.35rem;
+}
+
+.field label {
+  font-weight: 600;
+}
+
+.field input,
+.field select,
+.field textarea {
+  width: 100%;
+  max-width: 100%;
+  padding: 0.6rem 0.75rem;
+  border: 1px solid var(--field-border);
+  border-radius: 0.2rem;
+  background: #ffffff;
+  color: var(--ink);
+  font: inherit;
+}
+
+.field textarea {
+  min-height: 9rem;
+  resize: vertical;
+}
+
+.field input[aria-invalid="true"],
+.field textarea[aria-invalid="true"] {
+  border: 2px solid var(--error);
+  background: var(--error-tint);
+}
+
+.field-error {
+  margin: 0;
+  min-height: 0;
+  font-weight: 600;
+  color: var(--error);
+}
+
+.field-error:empty {
+  display: none;
+}
+
+.form-summary {
+  margin: 0;
+  padding: 0.75rem 1rem;
+  border-left: 0.3rem solid var(--error);
+  background: var(--error-tint);
+  font-weight: 600;
+}
+
+.form-summary:empty {
+  display: none;
+}
+
+.form-result {
+  margin: 0;
+  padding: 0.75rem 1rem;
+  border: 1px solid var(--focus);
+  background: #e7f0f2;
+}
+
+.form-result:empty {
+  display: none;
+}
+
+.button {
+  justify-self: start;
+  min-height: 2.75rem;
+  padding: 0.6rem 1.4rem;
+  border: 0;
+  border-radius: 0.25rem;
+  background: var(--oxblood);
+  color: var(--card);
+  font: inherit;
+  font-weight: 600;
+  cursor: pointer;
+}
+
+.button:hover {
+  background: var(--oxblood-deep);
+}
+
+.form-note {
+  margin: 0;
+  font-size: 0.95rem;
+  color: var(--ink-soft);
+}
+
+/* Home */
+
+.next-events {
+  margin: 0 0 1rem;
+  padding: 0;
+  list-style: none;
+}
+
+.next-events li {
+  padding: 0.9rem 0;
+  border-top: 1px solid var(--rule);
+}
+
+.next-events time {
+  display: block;
+  font-weight: 600;
+  color: var(--oxblood);
+}
+
+.summary-card {
+  padding: 1.25rem 1.5rem;
+  border: 1px solid var(--rule);
+  border-left: 0.3rem solid var(--focus);
+  border-radius: 0.25rem;
+  background: var(--card);
+}
+
+/* Wider screens */
+
+@media (min-width: 48rem) {
+  .masthead {
+    flex-wrap: nowrap;
+  }
+
+  .visit-grid {
+    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
+    align-items: start;
+  }
+}
