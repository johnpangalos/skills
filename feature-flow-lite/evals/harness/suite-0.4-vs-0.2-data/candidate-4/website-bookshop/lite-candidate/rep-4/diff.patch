+  function pad(value) {
+    return value < 10 ? '0' + value : String(value);
+  }
+
+  // The browser's local calendar date as YYYY-MM-DD. Never UTC.
+  function localDateString(date) {
+    return date.getFullYear() + '-' + pad(date.getMonth() + 1) + '-' + pad(date.getDate());
