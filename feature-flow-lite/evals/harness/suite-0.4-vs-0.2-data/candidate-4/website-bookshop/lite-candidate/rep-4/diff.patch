diff --git a/js/books.js b/js/books.js
new file mode 100644
index 0000000..dce23ab
--- /dev/null
+++ b/js/books.js
@@ -0,0 +1,112 @@
+/*
+ * Catalogue page: renders the books and the genre filter. The filter lives in
+ * the ?genre= query string so a result can be bookmarked, shared and restored
+ * with back and forward.
+ */
+(function () {
+  'use strict';
+
+  var Marginalia = window.Marginalia;
+  var genres = Marginalia.genres(Marginalia.books);
+  var optionsBox = document.getElementById('genre-options');
+  var list = document.getElementById('book-list');
+  var count = document.getElementById('result-count');
+
+  // The first ?genre= value, matched case-insensitively. Anything unknown is All.
+  function genreFromUrl() {
+    var requested = (new URLSearchParams(window.location.search).get('genre') || '').trim().toLowerCase();
+    var known = genres.some(function (genre) {
+      return genre.slug === requested;
+    });
+    return known ? requested : 'all';
+  }
+
+  function buildOptions() {
+    [{ name: 'All', slug: 'all' }].concat(genres).forEach(function (genre) {
+      var wrapper = document.createElement('div');
+      wrapper.className = 'genre-option';
+      var input = document.createElement('input');
+      input.type = 'radio';
+      input.name = 'genre';
+      input.id = 'genre-' + genre.slug;
+      input.value = genre.slug;
+      var label = document.createElement('label');
+      label.htmlFor = input.id;
+      label.textContent = genre.name;
+      wrapper.appendChild(input);
+      wrapper.appendChild(label);
+      optionsBox.appendChild(wrapper);
+    });
+  }
+
+  function bookCard(book) {
+    var item = document.createElement('li');
+    item.className = 'book-card';
+
+    var title = document.createElement('h2');
+    title.className = 'book-title';
+    title.textContent = book.title;
+
+    var author = document.createElement('p');
+    author.className = 'book-author';
+    author.textContent = 'by ' + book.author;
+
+    var genre = document.createElement('p');
+    genre.className = 'book-genre';
+    genre.textContent = book.genre;
+
+    var blurb = document.createElement('p');
+    blurb.className = 'book-blurb';
+    blurb.textContent = book.blurb;
+
+    var price = document.createElement('p');
+    price.className = 'book-price';
+    price.textContent = '£' + book.price.toFixed(2);
+
+    item.appendChild(title);
+    item.appendChild(author);
+    item.appendChild(genre);
+    item.appendChild(blurb);
+    item.appendChild(price);
+    return item;
+  }
+
+  function render(slug) {
+    var shown = Marginalia.books.filter(function (book) {
+      return slug === 'all' || Marginalia.genreSlug(book.genre) === slug;
+    });
+    list.textContent = '';
+    shown.forEach(function (book) {
+      list.appendChild(bookCard(book));
+    });
+    document.getElementById('genre-' + slug).checked = true;
+    count.textContent = 'Showing ' + shown.length + ' of ' + Marginalia.books.length + ' books';
+  }
+
+  // One history entry per real change: arrow keys move through the radios, and
+  // choosing the genre the URL already names adds nothing.
+  optionsBox.addEventListener('change', function (event) {
+    var slug = event.target.value;
+    if (slug === genreFromUrl()) return;
+    var url = new URL(window.location.href);
+    if (slug === 'all') {
+      url.searchParams.delete('genre');
+    } else {
+      url.searchParams.set('genre', slug);
+    }
+    window.history.pushState({ genre: slug }, '', url.pathname + url.search);
+    render(slug);
+  });
+
+  // Back and forward restore the control. If focus was on the group, it moves
+  // to the radio that is now checked, so it never sits on an unchecked one.
+  window.addEventListener('popstate', function () {
+    var focusInGroup = optionsBox.contains(document.activeElement);
+    var slug = genreFromUrl();
+    render(slug);
+    if (focusInGroup) document.getElementById('genre-' + slug).focus();
+  });
+
+  buildOptions();
+  render(genreFromUrl());
+})();
diff --git a/js/contact.js b/js/contact.js
new file mode 100644
index 0000000..3304f44
--- /dev/null
+++ b/js/contact.js
@@ -0,0 +1,82 @@
+/*
+ * Contact form: custom validation with novalidate. Invalid fields get
+ * aria-invalid and an aria-describedby error, focus moves to the first one, and
+ * the summary is announced. Nothing is sent: this is a demo site, and the
+ * confirmation says so.
+ */
+(function () {
+  'use strict';
+
+  var form = document.getElementById('contact-form');
+  if (!form) return;
+
+  var summary = document.getElementById('form-summary');
+  var result = document.getElementById('form-result');
+  var fields = ['name', 'email', 'message'];
+  var rules = {
+    name: function (value) {
+      return value.trim() ? '' : 'Please enter your name.';
+    },
+    email: function (value) {
+      var address = value.trim();
+      if (!address) return 'Please enter your email address.';
+      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(address) ? '' : 'Please enter an email address like name@example.com.';
+    },
+    message: function (value) {
+      var text = value.trim();
+      if (!text) return 'Please write a message.';
+      return text.length >= 10 ? '' : 'Please write at least 10 characters.';
+    }
+  };
+
+  function field(id) {
+    return document.getElementById(id);
+  }
+
+  // Sets or clears one field's error. Returns the message, or '' when valid.
+  function setError(id, message) {
+    var input = field(id);
+    document.getElementById(id + '-error').textContent = message;
+    if (message) {
+      input.setAttribute('aria-invalid', 'true');
+      input.setAttribute('aria-describedby', id + '-error');
+    } else {
+      input.removeAttribute('aria-invalid');
+      input.removeAttribute('aria-describedby');
+    }
+    return message;
+  }
+
+  function invalidFields() {
+    return fields.filter(function (id) {
+      return field(id).getAttribute('aria-invalid') === 'true';
+    });
+  }
+
+  function summaryText(count) {
+    if (count === 0) return '';
+    return count === 1 ? 'Please fix 1 field.' : 'Please fix ' + count + ' fields.';
+  }
+
+  form.addEventListener('submit', function (event) {
+    event.preventDefault();
+    var failing = fields.filter(function (id) {
+      return setError(id, rules[id](field(id).value));
+    });
+    summary.textContent = summaryText(failing.length);
+    if (failing.length > 0) {
+      result.textContent = '';
+      field(failing[0]).focus();
+      return;
+    }
+    result.textContent = 'Thanks, ' + field('name').value.trim() + " — this is a demo site, so your message wasn't sent anywhere.";
+  });
+
+  fields.forEach(function (id) {
+    field(id).addEventListener('input', function () {
+      if (field(id).getAttribute('aria-invalid') !== 'true') return;
+      setError(id, rules[id](field(id).value));
+      summary.textContent = summaryText(invalidFields().length);
+    });
+  });
+})();
