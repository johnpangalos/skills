+// local static server started here. Exits non-zero if any test fails.
+//
+//   NODE_PATH=/opt/node22/lib/node_modules node tests/site.test.cjs
+//   NODE_PATH=/opt/node22/lib/node_modules node tests/site.test.cjs --grep AC5
+
