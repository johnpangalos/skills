+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Books | Marginalia Books</title>
+  <link rel="icon" href="favicon.svg" type="image/svg+xml">
+  <link rel="stylesheet" href="css/styles.css">
+  <script src="js/data.js" defer></script>
+  <script src="js/nav.js" defer></script>
+  <script src="js/books.js" defer></script>
+</head>
+<body>
+  <a class="skip-link" href="#main">Skip to main content</a>
+  <header class="site-header">
+    <div class="masthead">
+      <a class="brand" href="index.html">
+        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 6C10 4.5 7 4 4 4.5v13C7 17 10 17.5 12 19c2-1.5 5-2 8-1.5v-13C17 4 14 4.5 12 6zM12 6v13"/></svg>
+        Marginalia Books
+      </a>
+      <nav aria-label="Main">
+        <ul class="site-nav">
+          <li><a href="index.html">Home</a></li>
+          <li><a href="books.html" aria-current="page">Books</a></li>
+          <li><a href="events.html">Events</a></li>
+          <li><a href="visit.html">Visit</a></li>
+        </ul>
+      </nav>
+    </div>
+  </header>
+
+  <main id="main" tabindex="-1">
+    <h1>Books</h1>
+    <p class="lede">Our shelves, chosen by the people who work here. Pick a genre to narrow the list. Your choice is kept in the address bar, so you can bookmark it or send it to a friend.</p>
+
+    <fieldset class="genre-filter">
+      <legend>Filter by genre</legend>
+      <div class="genre-options" id="genre-options"></div>
+    </fieldset>
+
+    <p class="result-count" id="result-count" role="status" aria-live="polite"></p>
+    <ul class="book-list" id="book-list"></ul>
+  </main>
+
+  <footer class="site-footer">
+    <p>Marginalia Books is a fictional bookshop, built as a demonstration site. Nothing here is a real offer.</p>
+    <p>27 Tallow Street, Wrenfield, Eastshire. hello@marginalia.example</p>
+  </footer>
+</body>
+</html>
