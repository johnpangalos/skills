+function startServer() {
+  return new Promise((resolve) => {
+    const server = http.createServer((req, res) => {
+      let pathname = decodeURIComponent(new URL(req.url, 'http://local').pathname);
+      if (pathname.endsWith('/')) pathname += 'index.html';
+      const file = path.normalize(path.join(ROOT, pathname));
+      const blocked = file.startsWith(path.join(ROOT, 'tests') + path.sep) || file.startsWith(path.join(ROOT, '.git') + path.sep);
+      if (!file.startsWith(ROOT + path.sep) || blocked) {
+        res.writeHead(404, { 'Content-Type': 'text/plain' });
+        return res.end('Not found');
+      }
+      fs.readFile(file, (error, data) => {
+        if (error) {
+          res.writeHead(404, { 'Content-Type': 'text/plain' });
+          return res.end('Not found');
+        }
+        res.writeHead(200, { 'Content-Type': MIME[path.extname(file)] || 'application/octet-stream' });
+        res.end(data);
+      });
+    });
+    server.listen(0, '127.0.0.1', () => resolve(server));
+  });
+}
+
+// Opens a fresh context with a fixed clock, recording requests, errors and dialogs.
+async function open(route, options = {}) {
+  const context = await browser.newContext({
+    timezoneId: options.timezoneId || LA,
+    viewport: { width: options.width || 1280, height: 900 },
+  });
+  const page = await context.newPage();
+  const log = { requests: [], responses: [], errors: [], dialogs: 0 };
+  page.on('request', (request) => log.requests.push({ url: request.url(), method: request.method() }));
+  page.on('response', (response) => log.responses.push({ url: response.url(), status: response.status() }));
+  page.on('console', (message) => {
+    if (message.type() === 'error') log.errors.push(message.text());
+  });
+  page.on('pageerror', (error) => log.errors.push(error.message));
+  page.on('dialog', (dialog) => {
+    log.dialogs += 1;
+    dialog.dismiss();
+  });
+  await page.clock.setFixedTime(new Date(options.now || TODAY_LA));
+  await page.goto(base + route);
+  return { context, page, log };
+}
+
+async function withPage(route, options, fn) {
+  const session = await open(route, options);
+  try {
+    return await fn(session);
+  } finally {
+    await session.context.close();
+  }
+}
+
+function assertLocalOnly(log) {
+  const remote = log.requests
+    .map((request) => request.url)
+    .filter((url) => {
+      const parsed = new URL(url);
+      return parsed.protocol !== 'http:' || !LOCAL_HOSTS.includes(parsed.hostname);
+    });
+  assert.deepStrictEqual(remote, [], 'requests left the local server');
+}
