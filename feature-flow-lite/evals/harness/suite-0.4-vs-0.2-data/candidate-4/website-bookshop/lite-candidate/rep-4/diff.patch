+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Marginalia Books | Independent bookshop</title>
+  <link rel="icon" href="favicon.svg" type="image/svg+xml">
+  <link rel="stylesheet" href="css/styles.css">
+  <script src="js/data.js" defer></script>
+  <script src="js/nav.js" defer></script>
+  <script src="js/home.js" defer></script>
+</head>
+<body>
+  <a class="skip-link" href="#main">Skip to main content</a>
+  <header class="site-header">
+    <div class="masthead">
+      <a class="brand" href="index.html">
+        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 6C10 4.5 7 4 4 4.5v13C7 17 10 17.5 12 19c2-1.5 5-2 8-1.5v-13C17 4 14 4.5 12 6zM12 6v13"/></svg>
+        Marginalia Books
+      </a>
+      <nav aria-label="Main">
+        <ul class="site-nav">
+          <li><a href="index.html" aria-current="page">Home</a></li>
+          <li><a href="books.html">Books</a></li>
+          <li><a href="events.html">Events</a></li>
+          <li><a href="visit.html">Visit</a></li>
+        </ul>
+      </nav>
+    </div>
+  </header>
+
+  <main id="main" tabindex="-1">
+    <h1>Marginalia Books</h1>
+    <p class="lede">Marginalia is an independent bookshop on Tallow Street in Wrenfield. We sell new and secondhand books across six genres, host readings most weeks in the back room, and will order anything we don't have on the shelf.</p>
+    <p>We began with a single shelf of poetry and a wobbly ladder. Today six booksellers run the shop, read widely and talk about it often. Come in to browse, stay for the tea, and ask us what we are reading. The answer is usually better than the bestseller list.</p>
+
+    <section aria-labelledby="picks-heading">
+      <h2 id="picks-heading">Staff picks</h2>
+      <ul class="featured-list" id="featured-list"></ul>
+      <p><a href="books.html">Browse the whole catalogue</a></p>
+    </section>
+
+    <section aria-labelledby="coming-up-heading">
+      <h2 id="coming-up-heading">Coming up</h2>
+      <ol class="next-events" id="next-events"></ol>
+      <p id="next-empty" hidden>No events scheduled right now. Check back soon.</p>
+      <p><a href="events.html">See all events</a></p>
+    </section>
