+// Reads the data the pages render, so expectations follow the data file.
+async function siteData(page) {
+  return page.evaluate(() => ({
+    books: window.Marginalia.books,
+    events: window.Marginalia.events,
+    hours: window.Marginalia.hours,
+  }));
