+
+// Contrast ratios computed in the browser from getComputedStyle, walking up
+// to the nearest opaque background for each text-bearing element.
+function contrastRatios(page, selectors) {
+  return page.evaluate((list) => {
+    const parse = (value) => {
+      const match = value.match(/rgba?\(([^)]+)\)/);
+      if (!match) return null;
+      const parts = match[1].split(/[ ,/]+/).filter(Boolean).map(Number);
+      return { r: parts[0], g: parts[1], b: parts[2], a: parts.length > 3 ? parts[3] : 1 };
+    };
+    const luminance = ({ r, g, b }) => {
+      const [R, G, B] = [r, g, b].map((channel) => {
+        const c = channel / 255;
+        return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
+      });
+      return 0.2126 * R + 0.7152 * G + 0.0722 * B;
+    };
+    const backgroundOf = (el) => {
+      for (let node = el; node; node = node.parentElement) {
+        const color = parse(getComputedStyle(node).backgroundColor);
+        if (color && color.a > 0) return color;
+      }
+      return { r: 255, g: 255, b: 255, a: 1 };
+    };
+    const results = [];
+    document.querySelectorAll(list.join(', ')).forEach((el) => {
+      if (!el.textContent.trim() || el.getClientRects().length === 0) return;
+      const fg = parse(getComputedStyle(el).color);
+      const bg = backgroundOf(el);
+      const [hi, lo] = [luminance(fg), luminance(bg)].sort((x, y) => y - x);
+      results.push({ text: el.textContent.trim().slice(0, 40), ratio: (hi + 0.05) / (lo + 0.05) });
+    });
+    return results;
+  }, selectors);
+}
