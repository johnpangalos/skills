+  assert.equal(await page.getByRole('radio', { name: 'Essays' }).isChecked(), true);
+  assert.equal((await visibleTitles(page)).length, 2);
+  assert.deepEqual(t.problems, []);
+  await t.context.close();
+});
+
+// Malformed or hostile genre values must fall back to All, never break the page, and never
+// inject anything from the URL into the document.
+const HOSTILE_GENRE_QUERIES = [
+  ['genre=', null],
+  ['genre=nonexistent', null],
+  ['genre=%3Cscript%3Ealert(1)%3C%2Fscript%3E', null],
+  ['genre=MYSTERY', 'mystery'],
+  ['genre=mystery&genre=poetry', null],
+  ['genre=%20essays%20', 'essays'],
+  ['genre=literary-fiction', 'literary-fiction'],
+];
+
+for (const [query, expectedSlug] of HOSTILE_GENRE_QUERIES) {
+  test(`hostile ?${query} falls back to All or matches the genre, without errors or injection`, async () => {
+    const t = await openCatalogue(`books.html?${query}`);
+    const { page } = t;
+    const books = await catalogueData(page);
+    const expectedId = expectedSlug ? `genre-${expectedSlug}` : 'genre-all';
+    const expectedCount = expectedSlug
+      ? books.filter((book) => slugOf(book.genre) === expectedSlug).length
+      : books.length;
+
+    const checked = await page.locator('input[name=genre]:checked').getAttribute('id');
+    assert.equal(checked, expectedId);
+    assert.equal((await visibleTitles(page)).length, expectedCount);
+    assert.equal(await page.locator('#book-list script, #genre-filter script').count(), 0);
+    const html = await page.content();
+    assert.equal(html.includes('alert(1)'), false, 'URL text must never be injected');
+    assert.equal(t.dialogs.length, 0);
+    assert.deepEqual(t.problems, []);
+    await t.context.close();
+  });
+}
+
+// Property test: generated query values, checked against a reference rule.
+test('generated genre values always yield a valid filtered state with no errors', async () => {
+  let seed = 20261117;
+  const random = () => {
+    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+    return seed / 0x7fffffff;
+  };
+  const alphabet = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 -_<>&=%\'"/+';
+  const slugs = ['mystery', 'poetry', 'essays', 'science-fiction', 'natural-history', 'literary-fiction'];
+  const cases = [];
+  for (let i = 0; i < 25; i += 1) {
+    const length = Math.floor(random() * 18);
+    let value = '';
+    for (let j = 0; j < length; j += 1) value += alphabet[Math.floor(random() * alphabet.length)];
+    cases.push(value);
+    const base = slugs[i % slugs.length];
+    cases.push(base.split('').map((ch) => (random() < 0.5 ? ch.toUpperCase() : ch)).join(''));
+  }
+
+  const t = await openCatalogue();
+  const { page } = t;
+  const books = await catalogueData(page);
+  for (const value of cases) {
+    await visit(t, `${suite.base}/books.html?genre=${encodeURIComponent(value)}`);
+    const normalised = value.trim().toLowerCase().replace(/\s+/g, '-');
+    const match = slugs.includes(normalised) ? normalised : null;
+    const checked = await page.locator('input[name=genre]:checked').getAttribute('id');
+    assert.equal(checked, match ? `genre-${match}` : 'genre-all', `value ${JSON.stringify(value)}`);
+    const expected = match ? books.filter((book) => slugOf(book.genre) === match).length : books.length;
+    assert.equal((await visibleTitles(page)).length, expected, `count for ${JSON.stringify(value)}`);
+  }
+  assert.equal(t.dialogs.length, 0);
+  assert.deepEqual(t.problems, []);
+  await t.context.close();
+});
