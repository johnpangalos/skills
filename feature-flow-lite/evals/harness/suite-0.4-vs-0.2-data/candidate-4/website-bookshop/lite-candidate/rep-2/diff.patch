+
+test('file:// books page filters from the query string', async () => {
+  const t = await openTracked(suite, { origin: null });
+  await visit(t, `file://${ROOT}/books.html?genre=mystery`);
+  assert.equal(await t.page.getByRole('radio', { name: 'Mystery' }).isChecked(), true);
+  assert.equal(await t.page.locator('#book-list .book-card:not([hidden])').count(), 3);
+  await t.context.close();
+});
+
+test('every request stays on the local origin; no fonts, CDNs, analytics or iframes', async () => {
+  for (const name of PAGES) {
