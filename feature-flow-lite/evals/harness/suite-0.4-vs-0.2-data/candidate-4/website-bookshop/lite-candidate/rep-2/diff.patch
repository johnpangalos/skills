+  for (const [name, selector] of cases) {
+    const t = await openTracked(suite, { origin: null });
+    await visit(t, `file://${ROOT}/${name}`);
+    assert.ok(await t.page.locator(selector).count() > 0, `${name} renders ${selector}`);
+    assert.deepEqual(t.problems, [], name);
+    await t.context.close();
+  }
