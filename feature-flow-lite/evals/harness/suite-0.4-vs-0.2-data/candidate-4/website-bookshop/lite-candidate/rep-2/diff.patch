+test('every text colour pair on every page meets 4.5:1, or 3:1 for large text', async () => {
+  const failures = [];
+  for (const name of PAGES) {
+    const t = await openPage(name);
+    assert.equal(await t.page.locator('main').count(), 1, `${name} rendered`);
+    const results = await t.page.evaluate(() => {
+      const parse = (value) => {
+        const parts = value.match(/[\d.]+/g).map(Number);
+        return { r: parts[0], g: parts[1], b: parts[2], a: parts.length > 3 ? parts[3] : 1 };
+      };
+      const luminance = ({ r, g, b }) => {
+        const channel = (c) => {
+          const s = c / 255;
+          return s <= 0.03928 ? s / 12.92 : Math.pow((s + 0.055) / 1.055, 2.4);
+        };
+        return 0.2126 * channel(r) + 0.7152 * channel(g) + 0.0722 * channel(b);
+      };
+      const backgroundOf = (el) => {
+        for (let node = el; node; node = node.parentElement) {
+          const bg = parse(getComputedStyle(node).backgroundColor);
+          if (bg.a === 1) return bg;
+        }
+        return { r: 255, g: 255, b: 255, a: 1 };
+      };
+      const out = [];
+      for (const el of document.querySelectorAll('body *')) {
+        const hasText = [...el.childNodes].some((n) => n.nodeType === 3 && n.textContent.trim());
+        if (!hasText || el.getClientRects().length === 0) continue;
+        const style = getComputedStyle(el);
+        const fg = parse(style.color);
+        const bg = backgroundOf(el);
+        const l1 = luminance(fg);
+        const l2 = luminance(bg);
+        const ratio = (Math.max(l1, l2) + 0.05) / (Math.min(l1, l2) + 0.05);
+        const size = parseFloat(style.fontSize);
+        const bold = parseInt(style.fontWeight, 10) >= 700;
+        const large = size >= 24 || (size >= 18.66 && bold);
+        const needed = large ? 3 : 4.5;
+        if (ratio < needed) out.push(`${el.tagName.toLowerCase()} "${el.textContent.trim().slice(0, 30)}" ${ratio.toFixed(2)}:1`);
+      }
+      return out;
+    });
+    failures.push(...results.map((r) => `${name} ${r}`));
+    await t.context.close();
+  }
+  assert.deepEqual(failures, []);
+});
