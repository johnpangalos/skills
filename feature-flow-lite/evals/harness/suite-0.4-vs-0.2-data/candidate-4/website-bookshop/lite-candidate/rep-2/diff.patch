+    await t.page.waitForLoadState('networkidle');
+    assert.equal(await t.page.locator('main').count(), 1, `${name} rendered`);
+    assert.deepEqual(t.problems.filter((p) => p.startsWith('offsite')), [], name);
+    const remote = await t.page.$$eval('link[href], script[src], img[src], iframe, source[src], video, audio', (nodes) =>
+      nodes.map((node) => node.getAttribute('href') || node.getAttribute('src') || node.tagName).filter((value) => /^(https?:)?\/\//.test(value) || value === 'IFRAME'),
+    );
+    assert.deepEqual(remote, [], `${name} references`);
+    assert.equal(await t.page.locator('link[rel="preconnect"], link[rel="dns-prefetch"]').count(), 0);
+    assert.equal(await t.page.evaluate(() => document.fonts.size), 0, `${name} loads no web fonts`);
+    await t.context.close();
