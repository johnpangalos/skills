+/* Marginalia Books: shared styles for every page.
+   Palette: warm paper, oxblood ink accents, deep moss header. Text pairs are checked
+   against 4.5:1 in the test suite. Fonts are system stacks only: nothing is downloaded. */
+
+:root {
+  --paper: #f7f1e3;
+  --paper-deep: #ebdfc8;
+  --card: #fffaf0;
+  --rule: #e0cfae;
+  --ink: #2a1f16;
+  --ink-soft: #55443a;
+  --oxblood: #7a2e26;
+  --oxblood-deep: #5e211b;
+  --moss: #2f4637;
+  --moss-deep: #223427;
+  --gold: #f2cc7a;
+  --focus: #8a4b00;
+  --error: #8c1d18;
+  --serif: Georgia, "Iowan Old Style", "Palatino Linotype", Palatino, "Book Antiqua", "Times New Roman", serif;
+  --sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
+  --radius: 4px;
+  --max: 74rem;
+}
+
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+
+html {
+  -webkit-text-size-adjust: 100%;
+}
+
+body {
+  margin: 0;
+  background: var(--paper);
+  color: var(--ink);
+  font-family: var(--serif);
+  font-size: 1.05rem;
+  line-height: 1.65;
+  overflow-wrap: anywhere;
+}
+
+main {
+  display: block;
+}
+
+main:focus {
+  outline: none;
+}
+
+svg {
+  max-width: 100%;
+}
+
+h1,
+h2,
+h3 {
+  font-family: var(--serif);
+  color: var(--ink);
+  line-height: 1.2;
+  margin: 0 0 0.6em;
+}
+
+h1 {
+  font-size: clamp(2rem, 6vw, 3.25rem);
+}
+
+h2 {
+  font-size: clamp(1.5rem, 4vw, 2rem);
+}
+
+h3 {
+  font-size: 1.25rem;
+}
+
+p {
+  margin: 0 0 1em;
+}
+
+a {
+  color: var(--oxblood);
+  text-underline-offset: 0.2em;
+  transition: color 150ms ease;
+}
+
+a:hover {
+  color: var(--oxblood-deep);
+}
+
+:focus-visible {
+  outline: 3px solid var(--focus);
+  outline-offset: 3px;
+}
+
+.site-header :focus-visible,
+.site-footer :focus-visible {
+  outline-color: var(--gold);
+}
+
+.visually-hidden {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  margin: -1px;
+  padding: 0;
+  overflow: hidden;
+  clip: rect(0 0 0 0);
+  white-space: nowrap;
+  border: 0;
+}
+
+.skip-link {
+  position: absolute;
+  left: 0.5rem;
+  top: 0.5rem;
+  z-index: 10;
+  padding: 0.6rem 1rem;
+  background: var(--card);
+  color: var(--ink);
+  border: 2px solid var(--focus);
+  border-radius: var(--radius);
+  font-family: var(--sans);
+  font-weight: 700;
+  text-decoration: none;
+  transform: translateY(-250%);
+}
+
+.skip-link:focus {
+  transform: none;
+}
+
+/* Header and navigation */
+
+.site-header {
+  background: var(--moss);
+  color: var(--paper);
+}
+
+.site-header-inner {
+  max-width: var(--max);
+  margin: 0 auto;
+  padding: 0.5rem 1rem;
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0.25rem 1.5rem;
+}
+
+.site-title {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.5rem;
+  min-height: 44px;
+  color: var(--paper);
+  font-family: var(--serif);
+  font-size: 1.3rem;
+  font-weight: 700;
+  text-decoration: none;
+}
+
+.site-title:hover {
+  color: var(--gold);
+}
+
+.site-nav ul {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0 0.25rem;
+}
+
+.site-nav a {
+  display: inline-flex;
+  align-items: center;
+  min-height: 44px;
+  padding: 0.5rem 0.8rem;
+  color: var(--paper);
+  font-family: var(--sans);
+  text-decoration: none;
+  border-bottom: 2px solid transparent;
+  transition: border-color 150ms ease;
+}
+
+.site-nav a:hover {
+  color: var(--paper);
+  border-bottom-color: var(--gold);
+}
+
+.site-nav a[aria-current="page"] {
+  color: var(--gold);
+  border-bottom-color: var(--gold);
+  font-weight: 700;
+}
+
+/* Shared blocks */
+
+.page-intro {
+  max-width: var(--max);
+  margin: 0 auto;
+  padding: 2.5rem 1rem 0.5rem;
+}
+
+.page-intro p {
+  max-width: 44rem;
+  color: var(--ink-soft);
+}
+
+.section {
+  max-width: var(--max);
+  margin: 0 auto;
+  padding: 2.5rem 1rem 0;
+}
+
+.section p {
+  max-width: 44rem;
+}
+
+.button {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-height: 44px;
+  padding: 0.6rem 1.2rem;
+  border: 2px solid var(--oxblood);
+  border-radius: var(--radius);
+  background: var(--oxblood);
+  color: var(--paper);
+  font-family: var(--sans);
+  font-size: 1rem;
+  font-weight: 600;
+  text-decoration: none;
+  cursor: pointer;
+  transition: background-color 150ms ease;
+}
+
+.button:hover {
+  background: var(--oxblood-deep);
+  border-color: var(--oxblood-deep);
+  color: var(--paper);
+}
+
+.button-quiet {
+  background: transparent;
+  color: var(--oxblood);
+}
+
+.button-quiet:hover {
+  background: var(--card);
+  color: var(--oxblood-deep);
+}
+
+.empty-message {
+  padding: 1rem 1.1rem;
+  background: var(--card);
+  border-left: 4px solid var(--moss);
+  font-family: var(--sans);
+  color: var(--ink);
+}
+
+/* Home */
+
+.hero {
+  background: var(--paper-deep);
+  border-bottom: 1px solid #d8c6a4;
+}
+
+.hero-inner {
+  max-width: var(--max);
+  margin: 0 auto;
+  padding: 3.5rem 1rem 3rem;
+}
+
+.hero h1 {
+  max-width: 14ch;
+}
+
+.lead {
+  max-width: 40rem;
+  font-size: 1.2rem;
+}
+
+.ornament {
+  display: block;
+  width: 180px;
+  max-width: 60%;
+  height: auto;
+  margin: 1.5rem 0 0;
+  color: var(--oxblood);
+}
+
+.actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.75rem;
+  margin-top: 1.5rem;
+}
+
+.pick-list {
+  list-style: none;
+  margin: 1.5rem 0 0;
+  padding: 0;
+  display: grid;
+  gap: 1.25rem;
+  grid-template-columns: 1fr;
+}
+
+.pick {
+  height: 100%;
+  margin: 0;
+  padding: 1.25rem;
+  background: var(--card);
+  border: 1px solid var(--rule);
+  border-top: 4px solid var(--moss);
+  border-radius: var(--radius);
+}
+
+.pick-meta {
+  margin: 0 0 0.5rem;
+  font-family: var(--sans);
+  font-size: 0.9rem;
+  color: var(--ink-soft);
+}
+
+.pick p:last-child {
+  margin-bottom: 0;
+}
+
+.section-more {
+  margin-top: 1rem;
+  font-family: var(--sans);
+  font-weight: 600;
+}
+
+/* Footer and "more" links are plain text, so give them a touch-sized box. */
+.site-footer a,
+.section-more a {
+  display: inline-flex;
+  align-items: center;
+  min-height: 44px;
+}
+
+/* Catalogue */
+
+.catalogue {
+  max-width: var(--max);
+  margin: 0 auto;
+  padding: 1.25rem 1rem 3rem;
+  display: grid;
+  gap: 1.5rem;
+  align-items: start;
+}
+
+.filter-panel {
+  padding: 1rem 1.1rem;
+  background: var(--card);
+  border: 1px solid var(--rule);
+  border-radius: var(--radius);
+}
+
+.genre-filter {
+  min-width: 0;
+  margin: 0;
+  padding: 0;
+  border: 0;
+}
+
+.genre-filter legend {
+  padding: 0;
+  margin-bottom: 0.5rem;
+  font-family: var(--sans);
+  font-weight: 700;
+}
+
+.filter-options {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.4rem;
+}
+
+.filter-option {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.5rem;
+  min-height: 44px;
+  padding: 0.4rem 0.8rem;
+  background: var(--paper);
+  border: 1px solid #b9a27c;
+  border-radius: 999px;
+  font-family: var(--sans);
+  cursor: pointer;
+}
+
+.filter-option input {
+  width: 24px;
+  height: 24px;
+  margin: 0;
+  accent-color: var(--oxblood);
+}
+
+.filter-option:has(input:checked) {
+  background: #f1dfd2;
+  border-color: var(--oxblood);
+  font-weight: 700;
+}
+
+.results-count {
+  margin: 1rem 0 0;
+  font-family: var(--sans);
+  color: var(--ink-soft);
+}
+
+.book-grid {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: grid;
+  gap: 1.25rem;
+  grid-template-columns: 1fr;
+}
+
+.book-card {
+  margin: 0;
+  padding: 1.1rem 1.2rem;
+  background: var(--card);
+  border: 1px solid var(--rule);
+  border-left: 4px solid var(--oxblood);
+  border-radius: var(--radius);
+}
+
+.book-title {
+  margin-bottom: 0.2rem;
+  font-size: 1.25rem;
+}
+
+.book-author {
+  margin-bottom: 0.4rem;
+  font-style: italic;
+  color: var(--ink-soft);
+}
+
+.book-meta {
+  margin-bottom: 0.6rem;
+  font-family: var(--sans);
+  font-size: 0.9rem;
+  color: var(--ink-soft);
+}
+
+.book-genre {
+  color: var(--oxblood);
+  font-weight: 700;
+}
+
+.book-blurb {
+  margin: 0;
+}
+
+/* Events */
+
+.event-list {
+  list-style: none;
+  margin: 1.25rem 0 0;
+  padding: 0;
+  display: grid;
+  gap: 1rem;
+}
+
+.event {
+  margin: 0;
+  padding: 1.1rem 1.25rem;
+  background: var(--card);
+  border: 1px solid var(--rule);
+  border-radius: var(--radius);
+}
+
+.past .event {
+  background: var(--paper-deep);
+}
+
+.event h3 {
+  margin-bottom: 0.25rem;
+}
+
+.event-when {
+  margin: 0 0 0.25rem;
+  font-family: var(--sans);
+  font-weight: 700;
+  color: var(--oxblood);
+}
+
+.event-admission {
+  margin: 0 0 0.5rem;
+  font-family: var(--sans);
+  font-size: 0.9rem;
+  color: var(--ink-soft);
+}
+
+.event p:last-child {
+  margin-bottom: 0;
+}
+
+/* Visit */
+
+.visit-grid {
+  max-width: var(--max);
+  margin: 0 auto;
+  padding: 1rem 1rem 3rem;
+  display: grid;
+  gap: 2rem;
+  align-items: start;
+}
+
+.hours-table {
+  width: 100%;
+  max-width: 28rem;
+  border-collapse: collapse;
+  font-family: var(--sans);
+}
+
+.hours-table th,
+.hours-table td {
+  padding: 0.5rem 0.4rem;
+  text-align: left;
+  vertical-align: top;
+  border-bottom: 1px solid #d8c6a4;
+}
+
+address {
+  padding: 0.9rem 1rem;
+  background: var(--card);
+  border-left: 4px solid var(--moss);
+  font-family: var(--sans);
+  font-style: normal;
+}
+
+.contact-form {
+  display: grid;
+  gap: 1.1rem;
+  max-width: 36rem;
+  padding: 1.25rem;
+  background: var(--card);
+  border: 1px solid var(--rule);
+  border-radius: var(--radius);
+}
+
+.field {
+  display: grid;
+  gap: 0.35rem;
+}
+
+.field label {
+  font-family: var(--sans);
+  font-weight: 600;
+}
+
+.field input,
+.field select,
+.field textarea {
+  width: 100%;
+  min-height: 44px;
+  padding: 0.6rem 0.7rem;
+  font: inherit;
+  font-size: 1rem;
+  color: var(--ink);
+  background: #fff;
+  border: 1px solid #8f7758;
+  border-radius: var(--radius);
+}
+
+.field textarea {
+  min-height: 9rem;
+  resize: vertical;
+}
+
+.field [aria-invalid="true"] {
+  border: 2px solid var(--error);
+}
+
+.field-hint {
+  margin: 0;
+  font-family: var(--sans);
+  font-size: 0.9rem;
+  color: var(--ink-soft);
+}
+
+.field-error {
+  margin: 0;
+  font-family: var(--sans);
+  font-size: 0.95rem;
+  font-weight: 600;
+  color: var(--error);
+}
+
+.form-status {
+  max-width: 36rem;
+  margin: 1rem 0 0;
+  padding: 0.75rem 1rem;
+  font-family: var(--sans);
+}
+
+.form-status:not(:empty) {
+  background: #efe6d0;
+  border-left: 4px solid var(--moss);
+}
+
+/* Footer */
+
+.site-footer {
+  margin-top: 3rem;
+  background: var(--moss-deep);
+  color: var(--paper);
+}
+
+.site-footer-inner {
+  max-width: var(--max);
+  margin: 0 auto;
+  padding: 2rem 1rem;
+  display: grid;
+  gap: 0.5rem;
+  font-family: var(--sans);
+  font-size: 0.95rem;
+}
+
+.site-footer p {
+  margin: 0;
+}
+
+.site-footer a {
+  color: var(--gold);
+}
+
+/* Wider screens */
+
+@media (min-width: 560px) {
+  .book-grid {
+    grid-template-columns: repeat(2, 1fr);
+  }
+}
+
+@media (min-width: 720px) {
+  .pick-list {
+    grid-template-columns: repeat(3, 1fr);
+  }
+}
+
+@media (min-width: 900px) {
+  .catalogue {
+    grid-template-columns: 16rem 1fr;
+  }
+
+  .filter-panel {
+    position: sticky;
+    top: 1rem;
+  }
+
+  .visit-grid {
+    grid-template-columns: 1fr 1fr;
+  }
+}
+
+@media (min-width: 1100px) {
+  .book-grid {
+    grid-template-columns: repeat(3, 1fr);
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    transition-duration: 0s !important;
+    animation-duration: 0s !important;
+    animation-iteration-count: 1 !important;
+    scroll-behavior: auto !important;
+  }
+}
