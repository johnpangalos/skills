diff --git a/js/books.js b/js/books.js
new file mode 100644
index 0000000..0c52ca1
--- /dev/null
+++ b/js/books.js
@@ -0,0 +1,106 @@
+// Catalogue page. Builds the genre filter and the book cards from window.BOOKS, and keeps
+// the chosen genre in the ?genre= query string. Text is always set with textContent, so
+// nothing read from the URL or the data is ever parsed as HTML.
+(function () {
+  'use strict';
+
+  const books = window.BOOKS || [];
+  const genres = uniqueGenres(books);
+  const optionsGroup = document.getElementById('genre-options');
+  const list = document.getElementById('book-list');
+  const countText = document.getElementById('results-count');
+  const emptyMessage = document.getElementById('empty-message');
+
+  function uniqueGenres(items) {
+    return [...new Set(items.map((book) => book.genre))];
+  }
+
+  function slugify(genre) {
+    return genre.toLowerCase().replace(/\s+/g, '-');
+  }
+
+  function makeElement(tag, className, text) {
+    const element = document.createElement(tag);
+    if (className) element.className = className;
+    if (text !== undefined) element.textContent = text;
+    return element;
+  }
+
+  function formatPrice(price) {
+    return '£' + price.toFixed(2);
+  }
+
+  function bookCard(book) {
+    const item = makeElement('li', 'book-card');
+    item.dataset.genre = slugify(book.genre);
+    item.appendChild(makeElement('h2', 'book-title', book.title));
+    item.appendChild(makeElement('p', 'book-author', 'by ' + book.author));
+    const meta = makeElement('p', 'book-meta');
+    meta.appendChild(makeElement('span', 'book-genre', book.genre));
+    meta.appendChild(document.createTextNode(' · '));
+    meta.appendChild(makeElement('span', 'book-price', formatPrice(book.price)));
+    item.appendChild(meta);
+    item.appendChild(makeElement('p', 'book-blurb', book.blurb));
+    return item;
+  }
+
+  function genreOption(value, label, checked) {
+    const wrapper = makeElement('label', 'filter-option');
+    wrapper.htmlFor = 'genre-' + value;
+    const input = document.createElement('input');
+    input.type = 'radio';
+    input.name = 'genre';
+    input.id = 'genre-' + value;
+    input.value = value;
+    input.checked = checked;
+    wrapper.appendChild(input);
+    wrapper.appendChild(document.createTextNode(label));
+    return wrapper;
+  }
+
+  // Returns the genre named by ?genre=, or null for All. Only a single value that matches a
+  // genre once slugified (so "Literary Fiction", "literary+fiction" and "literary-fiction" all
+  // match, ignoring case and surrounding spaces) counts; anything else means All.
+  function genreFromUrl() {
+    const values = new URLSearchParams(window.location.search).getAll('genre');
+    if (values.length !== 1) return null;
+    const wanted = slugify(values[0].trim());
+    return genres.find((genre) => slugify(genre) === wanted) || null;
+  }
+
+  function writeUrl(genre) {
+    const params = new URLSearchParams(window.location.search);
+    params.delete('genre');
+    if (genre) params.set('genre', slugify(genre));
+    const query = params.toString();
+    history.replaceState(null, '', window.location.pathname + (query ? '?' + query : '') + window.location.hash);
+  }
+
+  function applyFilter(genre) {
+    const slug = genre ? slugify(genre) : null;
+    const cards = Array.from(list.children);
+    let shown = 0;
+    cards.forEach((card) => {
+      const visible = !slug || card.dataset.genre === slug;
+      card.hidden = !visible;
+      if (visible) shown += 1;
+    });
+    countText.textContent = `Showing ${shown} of ${cards.length} books` + (genre ? ` in ${genre}` : '');
+    emptyMessage.hidden = shown > 0;
+    writeUrl(genre);
+  }
+
+  function init() {
+    const selected = genreFromUrl();
+    optionsGroup.appendChild(genreOption('all', 'All', selected === null));
+    genres.forEach((genre) => optionsGroup.appendChild(genreOption(slugify(genre), genre, genre === selected)));
+    books.forEach((book) => list.appendChild(bookCard(book)));
+    optionsGroup.addEventListener('change', (event) => {
+      const chosen = genres.find((genre) => slugify(genre) === event.target.value) || null;
+      applyFilter(chosen);
+    });
+    applyFilter(selected);
+  }
+
+  init();
+})();
diff --git a/js/contact.js b/js/contact.js
new file mode 100644
index 0000000..42929f1
--- /dev/null
+++ b/js/contact.js
@@ -0,0 +1,95 @@
+// Contact form on the visit page. This is a demonstration: validation runs here, nothing is
+// sent anywhere, and the status message says so. Errors are announced through aria-invalid
+// and aria-describedby, and focus moves to the first invalid field.
+(function () {
+  'use strict';
+
+  const form = document.getElementById('contact-form');
+  if (!form) return;
+
+  const status = document.getElementById('contact-status');
+  const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+  const MESSAGE_MAX_LENGTH = 5000;
+  const CONTACT_EMAIL = 'hello@marginaliabooks.example';
+
+  const fields = [
+    {
+      input: document.getElementById('contact-name'),
+      error: document.getElementById('contact-name-error'),
+      check(value) {
+        return value.trim() ? '' : 'Please tell us your name.';
+      },
+    },
+    {
+      input: document.getElementById('contact-email'),
+      error: document.getElementById('contact-email-error'),
+      check(value) {
+        if (!value.trim()) return 'Please enter your email address.';
+        if (!EMAIL_PATTERN.test(value.trim())) return 'Please enter an email address like name@example.com.';
+        return '';
+      },
+    },
+    {
+      input: document.getElementById('contact-message'),
+      error: document.getElementById('contact-message-error'),
+      check(value) {
+        if (!value.trim()) return 'Please write a message before sending.';
+        if (value.length > MESSAGE_MAX_LENGTH) return `Please keep your message to ${MESSAGE_MAX_LENGTH} characters.`;
+        return '';
+      },
+    },
+  ];
+
+  // Shows or clears one field's error. Returns true when the field is valid.
+  function applyCheck(field) {
+    const message = field.check(field.input.value);
+    field.error.textContent = message;
+    field.error.hidden = message === '';
+    if (message) {
+      field.input.setAttribute('aria-invalid', 'true');
+    } else {
+      field.input.removeAttribute('aria-invalid');
+    }
+    return message === '';
+  }
+
+  // True after a successful demo submit, until the visitor types into the form again.
+  let showingConfirmation = false;
+
+  function allEmpty() {
+    return fields.every((field) => !field.input.value.trim());
+  }
+
+  function submitDemo() {
+    const name = fields[0].input.value.trim();
+    // Clear first so a repeated confirmation is announced again.
+    status.textContent = '';
+    status.textContent = `Thanks, ${name}. This demo form doesn't send messages, so please email us at ${CONTACT_EMAIL} instead.`;
+    form.reset();
+    showingConfirmation = true;
+  }
+
+  form.addEventListener('submit', (event) => {
+    event.preventDefault();
+    // A second submit on the form we just reset keeps the confirmation and shows no errors.
+    if (showingConfirmation && allEmpty()) return;
+    const results = fields.map((field) => applyCheck(field));
+    const firstInvalid = fields[results.indexOf(false)];
+    if (firstInvalid) {
+      status.textContent = '';
+      firstInvalid.input.focus();
+      return;
+    }
+    submitDemo();
+  });
+
+  // Typing ends the confirmed state. Once a field has an error, re-check it as the visitor
+  // types so the error clears when fixed.
+  form.addEventListener('input', (event) => {
+    showingConfirmation = false;
+    const field = fields.find((candidate) => candidate.input === event.target);
+    if (field && field.input.getAttribute('aria-invalid') === 'true') {
+      applyCheck(field);
+    }
+  });
+})();
