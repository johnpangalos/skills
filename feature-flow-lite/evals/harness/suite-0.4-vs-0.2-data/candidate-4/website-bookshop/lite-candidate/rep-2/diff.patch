+
+const suite = setupSuite();
+
+const SHARED_FILES = [
+  ['css/styles.css', 'text/css'],
+  ['js/books-data.js', 'javascript'],
+  ['js/books.js', 'javascript'],
+  ['js/events-data.js', 'javascript'],
+  ['js/events.js', 'javascript'],
+  ['js/contact.js', 'javascript'],
+  ['favicon.svg', 'image/svg+xml'],
+  ['README.md', 'text/markdown'],
+];
+
+function rawGet(url) {
+  return new Promise((resolve, reject) => {
+    http.get(url, (res) => {
+      res.resume();
+      res.on('end', () => resolve(res.statusCode));
+    }).on('error', reject);
+  });
+}
+
+test('the four pages and shared assets are served with correct content types', async () => {
+  for (const name of PAGES) {
