+  await page.evaluate(() => {
+    window.statusMutations = 0;
+    new MutationObserver(() => { window.statusMutations += 1; })
+      .observe(document.getElementById('contact-status'), { childList: true, characterData: true, subtree: true });
+  });
+  await fillForm(page, { name: 'Grace Hopper' });
+  await submit(page);
+  assert.ok(await page.evaluate(() => window.statusMutations) >= 1, 'status element was updated');
+  assert.match(await page.locator('#contact-status').textContent(), /Thanks, Grace Hopper/);
+  assert.equal(t.requests.length, before, 'no network request is made');
+  await t.context.close();
+});
+
+test('accessibility copy does not send wheelchair users up stairs to the reading room', async () => {
+  const t = await openVisit();
+  const text = await t.page.locator('#access-heading').evaluate((heading) =>
+    heading.parentElement.textContent.replace(/\s+/g, ' ').trim(),
+  );
+  assert.match(text, /step-free/);
+  assert.doesNotMatch(text, /stairs to the reading room/i);
+  assert.match(text, /reading room is on the ground floor|lift to the reading room/i);
+  await t.context.close();
+});
+
+test('the form layout stays within 360px and the email link does not overflow', async () => {
+  const t = await openVisit({ width: 360, height: 800 });
+  const { page } = t;
+  const email = await page.locator('a[href^="mailto:"]').first().boundingBox();
+  assert.ok(email.x + email.width <= 360, 'email link fits the viewport');
+  await t.context.close();
+});
