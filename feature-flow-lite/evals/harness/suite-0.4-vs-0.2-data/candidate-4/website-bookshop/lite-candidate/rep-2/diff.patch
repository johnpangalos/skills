+    assert.equal(response.status, 200, name);
+    assert.match(response.headers.get('content-type'), /^text\/html/, name);
+  }
+  for (const [name, type] of SHARED_FILES) {
+    const response = await fetch(`${suite.base}/${name}`);
+    assert.equal(response.status, 200, name);
+    assert.ok(response.headers.get('content-type').includes(type), name);
+  }
+});
+
