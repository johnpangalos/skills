diff --git a/js/catalog.js b/js/catalog.js
new file mode 100644
index 0000000..4b5aca6
--- /dev/null
+++ b/js/catalog.js
@@ -0,0 +1,94 @@
+(function () {
+  'use strict';
+
+  const books = window.MARGINALIA_BOOKS;
+  const genres = [...new Set(books.map((book) => book.genre))];
+  const filter = document.getElementById('genre-filter');
+  const list = document.getElementById('book-list');
+  const count = document.getElementById('result-count');
+
+  function slugify(name) {
+    return name.toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
+  }
+
+  // Accepts a genre name or its slug in any case. Anything unknown means All genres.
+  function genreFromParam(param) {
+    const wanted = (param || '').trim().toLowerCase();
+    if (!wanted) return '';
+    return genres.find((genre) => genre.toLowerCase() === wanted || slugify(genre) === wanted) || '';
+  }
+
+  function genreFromUrl() {
+    return genreFromParam(new URLSearchParams(location.search).get('genre'));
+  }
+
+  function urlFor(genre) {
+    const params = new URLSearchParams(location.search);
+    if (genre) params.set('genre', genre);
+    else params.delete('genre');
+    const query = params.toString();
+    return location.pathname + (query ? '?' + query : '') + location.hash;
+  }
+
+  function textElement(tag, className, text) {
+    const element = document.createElement(tag);
+    element.className = className;
+    element.textContent = text;
+    return element;
+  }
+
+  function makeBookItem(book) {
+    const item = document.createElement('li');
+    item.className = 'book';
+    item.append(
+      textElement('h2', 'book-title', book.title),
+      textElement('p', 'book-author', 'by ' + book.author),
+      textElement('p', 'book-genre', book.genre),
+      textElement('p', 'book-desc', book.description),
+      textElement('p', 'book-price', book.price),
+    );
+    return item;
+  }
+
+  function makeOption(genre) {
+    const id = 'genre-' + (genre ? slugify(genre) : 'all');
+    const label = document.createElement('label');
+    const input = document.createElement('input');
+    input.type = 'radio';
+    input.name = 'genre';
+    input.id = id;
+    input.value = genre;
+    label.htmlFor = id;
+    label.append(input, genre || 'All genres');
+    return label;
+  }
+
+  function buildFilter() {
+    const options = document.createElement('div');
+    options.className = 'genre-options';
+    options.append(...[''].concat(genres).map(makeOption));
+    filter.append(options);
+  }
+
+  function render(genre) {
+    const shown = genre ? books.filter((book) => book.genre === genre) : books;
+    list.replaceChildren(...shown.map(makeBookItem));
+    count.textContent = `Showing ${shown.length} of ${books.length} books`;
+    filter.querySelectorAll('input').forEach((input) => {
+      input.checked = input.value === genre;
+    });
+  }
+
+  filter.addEventListener('change', (event) => {
+    const genre = event.target.value;
+    render(genre);
+    history.pushState(null, '', urlFor(genre));
+  });
+
+  window.addEventListener('popstate', () => render(genreFromUrl()));
+
+  buildFilter();
+  const initial = genreFromUrl();
+  render(initial);
+  history.replaceState(null, '', urlFor(initial));
+})();
diff --git a/js/contact.js b/js/contact.js
new file mode 100644
index 0000000..795632e
--- /dev/null
+++ b/js/contact.js
@@ -0,0 +1,74 @@
+(function () {
+  'use strict';
+
+  const DEMO_MESSAGE = 'This is a demo site — your message was not sent. Please email or phone us instead.';
+  const FIX_MESSAGE = 'Please fix the highlighted fields.';
+  const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+  const MAX_MESSAGE_LENGTH = 5000;
+
+  const validators = {
+    name: (value) => (value.trim() ? '' : 'Please enter your name.'),
+    email: (value, field) => {
+      const address = value.trim();
+      if (!address) return 'Please enter your email address.';
+      const valid = !field.validity.typeMismatch && EMAIL_PATTERN.test(address) && !address.includes('..');
+      return valid ? '' : 'Please enter an email address like name@example.com.';
+    },
+    message: (value) => {
+      if (!value.trim()) return 'Please write a message.';
+      return value.length <= MAX_MESSAGE_LENGTH ? '' : 'Please keep your message to 5,000 characters or fewer.';
+    },
+  };
+
+  const form = document.getElementById('contact-form');
+  const statusMessage = document.getElementById('form-status');
+
+  // The button ships disabled so a browser without JavaScript cannot submit the form as a GET request.
+  form.querySelector('button[type="submit"]').disabled = false;
+
+  function problemWith(field) {
+    return validators[field.id](field.value, field);
+  }
+
+  function showProblem(field, message) {
+    const error = document.getElementById(field.id + '-error');
+    error.textContent = message;
+    if (message) {
+      field.setAttribute('aria-invalid', 'true');
+      field.setAttribute('aria-describedby', error.id);
+    } else {
+      field.removeAttribute('aria-invalid');
+      field.removeAttribute('aria-describedby');
+    }
+  }
+
+  // Checks every field and returns the first invalid one, or null.
+  function checkAll() {
+    let first = null;
+    form.querySelectorAll('input, textarea').forEach((field) => {
+      const message = problemWith(field);
+      showProblem(field, message);
+      if (message && !first) first = field;
+    });
+    return first;
+  }
+
+  form.addEventListener('submit', (event) => {
+    event.preventDefault();
+    const firstInvalid = checkAll();
+    if (firstInvalid) {
+      firstInvalid.focus();
+      statusMessage.textContent = FIX_MESSAGE;
+      return;
+    }
+    statusMessage.textContent = DEMO_MESSAGE;
+  });
+
+  form.addEventListener('input', (event) => {
+    const field = event.target;
+    if (field.getAttribute('aria-invalid') === 'true') showProblem(field, problemWith(field));
+    if (statusMessage.textContent === FIX_MESSAGE && !form.querySelector('[aria-invalid="true"]')) {
+      statusMessage.textContent = '';
+    }
+  });
+})();
diff --git a/tests/a11y.test.js b/tests/a11y.test.js
new file mode 100644
index 0000000..82da899
--- /dev/null
+++ b/tests/a11y.test.js
@@ -0,0 +1,138 @@
+'use strict';
+
+const { test, before, after } = require('node:test');
+const assert = require('node:assert/strict');
+const { startSite, launchBrowser, openSite, closeContexts } = require('./helpers');
+
+const PAGES = ['index.html', 'books.html', 'events.html', 'visit.html'];
+
+let site;
+let browser;
+
+before(async () => {
+  site = await startSite();
+  browser = await launchBrowser();
+});
+
+after(async () => {
+  await closeContexts();
+  await browser.close();
+  await site.close();
+});
+
+// Criterion 11: body text and links reach 4.5:1 against their background.
+test('body text and links have at least 4.5:1 contrast on every page (criterion 11)', async () => {
+  for (const file of PAGES) {
+    const { page } = await openSite(browser, site.origin, file);
+    const failures = await page.evaluate(() => {
+      const parse = (value) => value.match(/[\d.]+/g).slice(0, 3).map(Number);
+      const luminance = ([r, g, b]) => {
+        const [R, G, B] = [r, g, b].map((c) => {
+          const s = c / 255;
+          return s <= 0.03928 ? s / 12.92 : Math.pow((s + 0.055) / 1.055, 2.4);
+        });
+        return 0.2126 * R + 0.7152 * G + 0.0722 * B;
+      };
+      const background = (el) => {
+        for (let node = el; node; node = node.parentElement) {
+          const value = getComputedStyle(node).backgroundColor;
+          if (value && !/rgba\(.*,\s*0\)$/.test(value) && value !== 'transparent') return parse(value);
+        }
+        return [255, 255, 255];
+      };
+      const selector = 'main p, main li, main a, main label, main td, main th, main h1, main h2, main h3, main legend, main caption, nav a, footer p, footer a, footer li';
+      const bad = [];
+      let checked = 0;
+      for (const el of document.querySelectorAll(selector)) {
+        if (el.getClientRects().length === 0 || !el.textContent.trim()) continue;
+        checked++;
+        const fg = parse(getComputedStyle(el).color);
+        const bg = background(el);
+        const [hi, lo] = [luminance(fg), luminance(bg)].sort((a, b) => b - a);
+        const ratio = (hi + 0.05) / (lo + 0.05);
+        if (ratio < 4.5) bad.push(`${el.tagName} "${el.textContent.trim().slice(0, 30)}" ${ratio.toFixed(2)}`);
+      }
+      return { checked, bad };
+    });
+    assert.ok(failures.checked >= 20, `${file} checked ${failures.checked} text elements`);
+    assert.deepEqual(failures.bad, [], file);
+  }
+});
+
+// Criterion 11: visible focus indicator on every interactive element reached by keyboard.
+test('every element reached by Tab has a visible :focus-visible outline (criterion 11)', async () => {
+  for (const file of PAGES) {
+    const { page } = await openSite(browser, site.origin, file);
+    const reached = [];
+    const problems = [];
+    for (let i = 0; i < 60; i++) {
+      await page.keyboard.press('Tab');
+      const state = await page.evaluate(() => {
+        const el = document.activeElement;
+        const style = getComputedStyle(el);
+        return {
+          label: el.tagName + ':' + (el.textContent.trim().slice(0, 25) || el.id || el.name),
+          focusVisible: el.matches(':focus-visible'),
+          outline: style.outlineStyle !== 'none' && parseFloat(style.outlineWidth) > 0,
+        };
+      });
+      if (state.label.startsWith('BODY') || (reached.length && reached[0] === state.label)) break;
+      reached.push(state.label);
+      if (!state.focusVisible || !state.outline) problems.push(state.label);
+    }
+    assert.ok(reached.length >= 5, `${file} keyboard stops: ${reached.length}`);
+    assert.deepEqual(problems, [], file);
+  }
+});
+
+// Criterion 11: heading levels never skip.
+test('heading levels never skip and each page has one h1 (criterion 11)', async () => {
+  for (const file of PAGES) {
+    const { page } = await openSite(browser, site.origin, file);
+    const levels = await page.$$eval('h1, h2, h3, h4, h5, h6', (hs) => hs.map((h) => Number(h.tagName[1])));
+    assert.equal(levels[0], 1, `${file} starts at h1`);
+    assert.equal(levels.filter((l) => l === 1).length, 1, `${file} one h1`);
+    for (let i = 1; i < levels.length; i++) {
+      assert.ok(levels[i] <= levels[i - 1] + 1, `${file} heading ${i} jumps from h${levels[i - 1]} to h${levels[i]}`);
+    }
+  }
+});
+
+// Criterion 11: no animation or transition runs (so reduced motion has nothing to override).
+test('no CSS animation or transition runs unless reduced motion is respected (criterion 11)', async () => {
+  for (const file of PAGES) {
+    const { page } = await openSite(browser, site.origin, file);
+    const moving = await page.evaluate(() => [...document.querySelectorAll('*')]
+      .filter((el) => {
+        const style = getComputedStyle(el);
+        return style.animationName !== 'none' || parseFloat(style.transitionDuration) > 0;
+      })
+      .map((el) => el.tagName));
+    assert.deepEqual(moving, [], file);
+  }
+});
+
+// Criterion 12: no external requests, no console errors, every page loads cleanly.
+test('every page makes requests only to the local origin with no errors (criterion 12)', async () => {
+  for (const file of PAGES) {
+    const { page, log } = await openSite(browser, site.origin, file);
+    await page.waitForLoadState('networkidle');
+    const foreign = log.requests.filter((url) => !url.startsWith(site.origin + '/'));
+    assert.deepEqual(foreign, [], `${file} foreign requests`);
+    assert.deepEqual(log.failed, [], `${file} failed responses`);
+    assert.deepEqual(log.consoleErrors, [], `${file} console errors`);
+    assert.deepEqual(log.pageErrors, [], `${file} page errors`);
+  }
+});
+
+test('no element points at an http(s) or protocol-relative URL, and fonts are system stacks (criterion 12)', async () => {
+  for (const file of PAGES) {
+    const { page } = await openSite(browser, site.origin, file);
+    const remote = await page.evaluate(() => [...document.querySelectorAll('[src], [href]')]
+      .map((el) => el.getAttribute('src') || el.getAttribute('href'))
+      .filter((value) => /^(https?:)?\/\//i.test(value)));
+    assert.deepEqual(remote, [], file);
+    const webFonts = await page.evaluate(() => document.fonts.size);
+    assert.equal(webFonts, 0, `${file} web fonts`);
+  }
+});
diff --git a/tests/books.test.js b/tests/books.test.js
new file mode 100644
index 0000000..38169f5
--- /dev/null
+++ b/tests/books.test.js
@@ -0,0 +1,168 @@
+'use strict';
+
+const { test, before, after } = require('node:test');
+const assert = require('node:assert/strict');
+const { startSite, launchBrowser, openSite, closeContexts } = require('./helpers');
+
+let site;
+let browser;
+
+before(async () => {
+  site = await startSite();
+  browser = await launchBrowser();
+});
+
+after(async () => {
+  await closeContexts();
+  await browser.close();
+  await site.close();
+});
+
+const renderedTitles = (page) => page.$$eval('#book-list > li h2', (headings) => headings.map((h) => h.textContent.trim()));
+const expectedTitles = (books, genre) => books
+  .filter((book) => book.genre === genre)
+  .map((book) => book.title);
+const allTitles = (books) => books.map((book) => book.title);
+const waitForCount = (page, count) => page.waitForFunction(
+  (n) => document.querySelectorAll('#book-list > li').length === n,
+  count,
+);
+const checkedGenre = (page) => page.$eval('input[name="genre"]:checked', (input) => input.value);
+
+// Criterion 4: catalog data and rendering.
+test('catalog has at least 12 books across 5 genres with 2+ titles each, rendered from js/books.js (criterion 4)', async () => {
+  const { page, log } = await openSite(browser, site.origin, 'books.html');
+  const books = await page.evaluate(() => window.MARGINALIA_BOOKS);
+  assert.ok(books.length >= 12, `books: ${books.length}`);
+  const counts = {};
+  for (const book of books) {
+    for (const field of ['title', 'author', 'genre', 'description']) {
+      assert.ok(typeof book[field] === 'string' && book[field].trim().length > 0, `${book.title} ${field}`);
+    }
+    assert.match(book.price, /^\$\d+\.\d{2}$/, `${book.title} price`);
+    counts[book.genre] = (counts[book.genre] || 0) + 1;
+  }
+  assert.ok(Object.keys(counts).length >= 5, 'at least 5 genres');
+  for (const [genre, count] of Object.entries(counts)) assert.ok(count >= 2, `${genre} has ${count}`);
+  const rendered = await page.$$eval('#book-list > li', (items) => items.map((li) => ({
+    title: li.querySelector('h2').textContent.trim(),
+    text: li.textContent,
+  })));
+  assert.equal(rendered.length, books.length);
+  books.forEach((book, i) => {
+    assert.equal(rendered[i].title, book.title);
+    for (const field of ['author', 'genre', 'description', 'price']) {
+      assert.ok(rendered[i].text.includes(book[field]), `${book.title} shows ${field}`);
+    }
+  });
+  assert.deepEqual(log.pageErrors, []);
+});
+
+// Criterion 5: labelled genre filter.
+test('genre filter is a labelled radio group with All genres plus each genre (criterion 5)', async () => {
+  const { page } = await openSite(browser, site.origin, 'books.html');
+  const books = await page.evaluate(() => window.MARGINALIA_BOOKS);
+  const genres = [...new Set(books.map((b) => b.genre))];
+  const group = page.getByRole('group', { name: 'Filter by genre' });
+  assert.equal(await group.count(), 1);
+  const labels = await group.getByRole('radio').evaluateAll((inputs) => inputs.map((input) => input.labels[0].textContent.trim()));
+  assert.deepEqual(labels, ['All genres', ...genres]);
+});
+
+test('choosing a genre shows exactly its books and All shows everything, announced politely (criterion 5)', async () => {
+  const { page } = await openSite(browser, site.origin, 'books.html');
+  const books = await page.evaluate(() => window.MARGINALIA_BOOKS);
+  const count = page.locator('#result-count');
+  assert.equal(await count.getAttribute('aria-live'), 'polite');
+  assert.equal(await count.textContent(), `Showing ${books.length} of ${books.length} books`);
+
+  await page.getByRole('radio', { name: 'Mystery', exact: true }).check();
+  await waitForCount(page, expectedTitles(books, 'Mystery').length);
+  assert.deepEqual(await renderedTitles(page), expectedTitles(books, 'Mystery'));
+  assert.equal(await count.textContent(), `Showing ${expectedTitles(books, 'Mystery').length} of ${books.length} books`);
+
+  await page.getByRole('radio', { name: 'All genres', exact: true }).check();
+  await waitForCount(page, books.length);
+  assert.deepEqual(await renderedTitles(page), allTitles(books));
+  assert.equal(await count.textContent(), `Showing ${books.length} of ${books.length} books`);
+});
+
+// Criterion 5 keyboard and the triggered selection check: the selected genre is tracked by value.
+test('genre filter works by keyboard alone and keeps the selected genre by value (criterion 5, keyboard)', async () => {
+  const { page } = await openSite(browser, site.origin, 'books.html');
+  const books = await page.evaluate(() => window.MARGINALIA_BOOKS);
+  await page.getByRole('radio', { name: 'All genres', exact: true }).focus();
+  await page.keyboard.press('ArrowDown');
+  const first = books[0].genre;
+  assert.equal(await checkedGenre(page), first);
+  await waitForCount(page, expectedTitles(books, first).length);
+  assert.deepEqual(await renderedTitles(page), expectedTitles(books, first));
+  // Clearing the selection with All empties the genre state and the URL.
+  await page.keyboard.press('ArrowUp');
+  assert.equal(await checkedGenre(page), '');
+  await waitForCount(page, books.length);
+  assert.equal(new URL(page.url()).searchParams.get('genre'), null);
+});
+
+// Criterion 5 hostile inputs and criterion 6 URL state.
+test('books.html?genre=mystery loads with Mystery selected and filtered (criterion 5, hostile)', async () => {
+  const { page, log } = await openSite(browser, site.origin, 'books.html?genre=mystery');
+  const books = await page.evaluate(() => window.MARGINALIA_BOOKS);
+  assert.equal(await checkedGenre(page), 'Mystery');
+  assert.deepEqual(await renderedTitles(page), expectedTitles(books, 'Mystery'));
+  assert.deepEqual(log.pageErrors, []);
+});
+
+for (const query of ['?genre=nonexistent', '?genre=', '?genre=%3Cscript%3E']) {
+  test(`books.html${query} falls back to All without errors or injected markup (criterion 5, hostile)`, async () => {
+    const { page, log } = await openSite(browser, site.origin, `books.html${query}`);
+    const books = await page.evaluate(() => window.MARGINALIA_BOOKS);
+    assert.equal(await checkedGenre(page), '');
+    assert.deepEqual(await renderedTitles(page), allTitles(books));
+    assert.equal(await page.locator('#book-list script, main script').count(), 0);
+    assert.equal(await page.locator('#book-list img').count(), 0);
+    assert.doesNotMatch(await page.locator('main').innerHTML(), /<script>/i);
+    assert.deepEqual(log.pageErrors, []);
+    assert.deepEqual(log.consoleErrors, []);
+  });
+}
+
+test('genre names with a space or ampersand round-trip through the URL (criterion 5, hostile)', async () => {
+  const { page } = await openSite(browser, site.origin, 'books.html?genre=Science%20Fiction');
+  const books = await page.evaluate(() => window.MARGINALIA_BOOKS);
+  assert.equal(await checkedGenre(page), 'Science Fiction');
+  assert.deepEqual(await renderedTitles(page), expectedTitles(books, 'Science Fiction'));
+
+  await page.getByRole('radio', { name: 'Poetry & Drama', exact: true }).check();
+  await waitForCount(page, expectedTitles(books, 'Poetry & Drama').length);
+  assert.equal(new URL(page.url()).searchParams.get('genre'), 'Poetry & Drama');
+
+  await page.reload();
+  assert.equal(await checkedGenre(page), 'Poetry & Drama');
+  assert.deepEqual(await renderedTitles(page), expectedTitles(books, 'Poetry & Drama'));
+});
+
+// Criterion 6: filter state in the URL, with pushState and Back.
+test('choosing a genre updates the query string and reloading restores it (criterion 6)', async () => {
+  const { page } = await openSite(browser, site.origin, 'books.html');
+  const books = await page.evaluate(() => window.MARGINALIA_BOOKS);
+  await page.getByRole('radio', { name: 'Mystery', exact: true }).check();
+  await waitForCount(page, expectedTitles(books, 'Mystery').length);
+  assert.equal(new URL(page.url()).searchParams.get('genre'), 'Mystery');
+  await page.reload();
+  assert.equal(await checkedGenre(page), 'Mystery');
+  assert.deepEqual(await renderedTitles(page), expectedTitles(books, 'Mystery'));
+});
+
+test('Back restores the previous filter after a pushState change (criterion 6)', async () => {
+  const { page } = await openSite(browser, site.origin, 'books.html');
+  const books = await page.evaluate(() => window.MARGINALIA_BOOKS);
+  await page.getByRole('radio', { name: 'Mystery', exact: true }).check();
+  await waitForCount(page, expectedTitles(books, 'Mystery').length);
+  await page.getByRole('radio', { name: 'Science Fiction', exact: true }).check();
+  await waitForCount(page, expectedTitles(books, 'Science Fiction').length);
+  await page.goBack();
+  await waitForCount(page, expectedTitles(books, 'Mystery').length);
+  assert.equal(await checkedGenre(page), 'Mystery');
+  assert.deepEqual(await renderedTitles(page), expectedTitles(books, 'Mystery'));
+});
