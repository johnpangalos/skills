+test('a 5000-character message is accepted and 5001 characters is rejected with focus on the message (criterion 9, hostile)', async () => {
+  const { page } = await openSite(browser, site.origin, 'visit.html');
+  await page.fill('#name', 'Ada Okafor');
+  await page.fill('#email', 'ada@example.org');
+  await page.fill('#message', 'a'.repeat(5000));
+  await page.getByRole('button', { name: /send|submit/i }).click();
+  assert.equal(await status(page), DEMO_TEXT);
+  assert.equal((await fieldState(page, 'message')).invalid, null);
+
+  // Typed into the real textarea: the field must keep all 5001 characters, not cut them off silently.
+  await page.fill('#message', 'a'.repeat(5001));
+  assert.equal(await page.inputValue('#message'), 'a'.repeat(5001));
+  await page.getByRole('button', { name: /send|submit/i }).click();
+  const state = await fieldState(page, 'message');
+  assert.equal(state.invalid, 'true');
+  assert.equal(state.describedBy, 'message-error');
+  assert.equal(state.error, 'Please keep your message to 5,000 characters or fewer.');
+  assert.equal(await activeId(page), 'message');
+  assert.equal(await status(page), 'Please fix the highlighted fields.');
+});
