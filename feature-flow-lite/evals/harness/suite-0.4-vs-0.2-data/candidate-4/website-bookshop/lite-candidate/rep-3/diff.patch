+test('markup in the name is never rendered as HTML and runs no script (criterion 9, hostile)', async () => {
+  const { page, log } = await openSite(browser, site.origin, 'visit.html');
+  const payload = '<img src=x onerror=alert(1)>';
+  await page.fill('#name', payload);
+  await page.fill('#email', 'ada@example.org');
+  await page.fill('#message', 'Hello from the Lantern Row shop.');
+  await page.getByRole('button', { name: /send|submit/i }).click();
+  assert.equal(await status(page), DEMO_TEXT);
+  assert.equal(await page.locator('img').count(), 0);
+  assert.equal(await page.locator('main').evaluate((main) => main.querySelectorAll('[onerror]').length), 0);
+  assert.equal(await page.inputValue('#name'), payload);
+  assert.deepEqual(log.dialogs, []);
+  assert.deepEqual(log.pageErrors, []);
+});
