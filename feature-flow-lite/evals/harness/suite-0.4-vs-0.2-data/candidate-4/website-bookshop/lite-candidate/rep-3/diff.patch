+// Triggered check: keyboard-only use of the form, focus moves to the first invalid field.
+test('contact form can be submitted from the keyboard and focus moves to the first error (keyboard)', async () => {
+  const { page } = await openSite(browser, site.origin, 'visit.html');
+  await page.click('#message');
+  await page.keyboard.press('Tab');
