+/* Marginalia Books. System font stacks only; no animation or transition anywhere. */
+
+:root {
+  --paper: #fbf7ef;
+  --card: #fffdf8;
+  --band: #efe6d4;
+  --ink: #2b2620;
+  --muted: #5a4f42;
+  --accent: #7a3e12;
+  --error: #9b1c1c;
+  --focus: #1f5f8b;
+  --rule: #d8cbb4;
+  --serif: Georgia, "Iowan Old Style", "Palatino Linotype", Palatino, "Times New Roman", serif;
+  --sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
+}
+
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+
+body {
+  margin: 0;
+  background: var(--paper);
+  color: var(--ink);
+  font-family: var(--sans);
+  font-size: 1.0625rem;
+  line-height: 1.6;
+  overflow-wrap: break-word;
+}
+
+h1,
+h2,
+h3 {
+  font-family: var(--serif);
+  line-height: 1.25;
+  color: var(--ink);
+}
+
+h1 {
+  font-size: 2rem;
+  margin: 0 0 0.5rem;
+}
+
+h2 {
+  font-size: 1.5rem;
+  margin: 0 0 0.4rem;
+}
+
+h3 {
+  font-size: 1.2rem;
+  margin: 0 0 0.3rem;
+}
+
+p {
+  margin: 0 0 1rem;
+}
+
+a {
+  color: var(--accent);
+  text-underline-offset: 0.2em;
+}
+
+:focus-visible {
+  outline: 3px solid var(--focus);
+  outline-offset: 2px;
+}
+
+main:focus {
+  outline: none;
+}
+
+.wrap {
+  max-width: 64rem;
+  margin: 0 auto;
+  padding: 0 1rem;
+}
+
+.skip-link {
+  position: absolute;
+  left: 1rem;
+  top: -4rem;
+  z-index: 10;
+  padding: 0.6rem 1rem;
+  background: var(--card);
+  color: var(--ink);
+  border: 2px solid var(--accent);
+  border-radius: 4px;
+}
+
+.skip-link:focus {
+  top: 1rem;
+}
+
+/* Header and navigation */
+
+.site-header {
+  border-bottom: 1px solid var(--rule);
+  background: var(--card);
+}
+
+.header-inner {
+  display: flex;
+  flex-direction: column;
+  gap: 0.25rem;
+  padding-top: 0.75rem;
+  padding-bottom: 0.5rem;
+}
+
+.brand {
+  font-family: var(--serif);
+  font-size: 1.4rem;
+  font-weight: 700;
+  color: var(--ink);
+  text-decoration: none;
+  align-self: flex-start;
+  padding: 0.25rem 0;
+}
+
+.site-nav {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.25rem;
+}
+
+.site-nav a {
+  display: inline-flex;
+  align-items: center;
+  min-height: 44px;
+  padding: 0 0.85rem;
+  border-radius: 4px;
+  color: var(--ink);
+  text-decoration: none;
+}
+
+.site-nav a:hover {
+  text-decoration: underline;
+}
+
+.site-nav a[aria-current="page"] {
+  background: var(--band);
+  font-weight: 700;
+  text-decoration: underline;
+}
+
+@media (min-width: 40rem) {
+  .header-inner {
+    flex-direction: row;
+    align-items: center;
+    justify-content: space-between;
+    flex-wrap: wrap;
+  }
+
+  .brand {
+    align-self: center;
+  }
+}
+
+/* Main content */
+
+main {
+  padding-top: 2rem;
+  padding-bottom: 2.5rem;
+}
+
+main section + section {
+  margin-top: 2.5rem;
+}
+
+.lead {
+  font-size: 1.15rem;
+  color: var(--muted);
+  max-width: 42rem;
+}
+
+.card {
+  background: var(--card);
+  border: 1px solid var(--rule);
+  border-radius: 6px;
+  padding: 1.25rem;
+}
+
+/* Home */
+
+.pick-grid {
+  display: grid;
+  gap: 1rem;
+  grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
+}
+
+.pick-grid article {
+  background: var(--card);
+  border: 1px solid var(--rule);
+  border-radius: 6px;
+  padding: 1.1rem;
+}
+
+.pick-author {
+  color: var(--muted);
+  margin-bottom: 0.5rem;
+}
+
+.teaser {
+  background: var(--band);
+  border-left: 4px solid var(--accent);
+  border-radius: 4px;
+  padding: 1rem 1.25rem;
+}
+
+/* Books */
+
+.genre-filter {
+  border: 1px solid var(--rule);
+  border-radius: 6px;
+  background: var(--card);
+  padding: 0.75rem 1rem 1rem;
+  margin: 0 0 1.25rem;
+  min-width: 0;
+}
+
+.genre-filter legend {
+  font-family: var(--serif);
+  font-weight: 700;
+  padding: 0 0.25rem;
+}
+
+.genre-options {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.5rem;
+}
+
+.genre-options label {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.5rem;
+  min-height: 44px;
+  padding: 0 0.9rem;
+  border: 1px solid #8a7a66;
+  border-radius: 999px;
+  background: var(--card);
+  cursor: pointer;
+}
+
+.genre-options input {
+  width: 1.1rem;
+  height: 1.1rem;
+  margin: 0;
+  accent-color: var(--accent);
+}
+
+.result-count {
+  font-weight: 700;
+  margin-bottom: 1rem;
+}
+
+.book-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: grid;
+  gap: 1rem;
+  grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
+}
+
+.book {
+  background: var(--card);
+  border: 1px solid var(--rule);
+  border-radius: 6px;
+  padding: 1.1rem;
+  display: flex;
+  flex-direction: column;
+}
+
+.book-title {
+  font-size: 1.25rem;
+}
+
+.book-author,
+.book-genre {
+  margin-bottom: 0.25rem;
+}
+
+.book-genre {
+  color: var(--muted);
+  font-size: 0.92rem;
+  text-transform: uppercase;
+  letter-spacing: 0.04em;
+}
+
+.book-desc {
+  flex-grow: 1;
+}
+
+.book-price {
+  font-weight: 700;
+  margin: 0;
+}
+
+/* Events */
+
+.event {
+  background: var(--card);
+  border: 1px solid var(--rule);
+  border-left: 4px solid var(--accent);
+  border-radius: 6px;
+  padding: 1.1rem 1.25rem;
+  margin-bottom: 1rem;
+}
+
+.event-when {
+  color: var(--muted);
+  font-weight: 700;
+  margin-bottom: 0.4rem;
+}
+
+/* Visit */
+
+table {
+  width: 100%;
+  max-width: 30rem;
+  border-collapse: collapse;
+  background: var(--card);
+}
+
+caption {
+  text-align: left;
+  font-family: var(--serif);
+  font-size: 1.2rem;
+  font-weight: 700;
+  padding-bottom: 0.5rem;
+}
+
+th,
+td {
+  text-align: left;
+  padding: 0.6rem 0.75rem;
+  border-bottom: 1px solid var(--rule);
+  vertical-align: top;
+}
+
+address {
+  font-style: normal;
+  background: var(--card);
+  border: 1px solid var(--rule);
+  border-radius: 6px;
+  padding: 1rem 1.25rem;
+  max-width: 30rem;
+}
+
+.contact-form {
+  max-width: 36rem;
+}
+
+.field {
+  margin-bottom: 1.1rem;
+}
+
+.field label {
+  display: block;
+  font-weight: 700;
+  margin-bottom: 0.3rem;
+}
+
+.field input,
+.field textarea {
+  display: block;
+  width: 100%;
+  min-height: 44px;
+  padding: 0.6rem 0.75rem;
+  font: inherit;
+  color: var(--ink);
+  background: var(--card);
+  border: 1px solid #8a7a66;
+  border-radius: 4px;
+}
+
+.field textarea {
+  min-height: 9rem;
+  resize: vertical;
+}
+
+.field input[aria-invalid="true"],
+.field textarea[aria-invalid="true"] {
+  border: 2px solid var(--error);
+}
+
+.field-error {
+  color: var(--error);
+  font-weight: 700;
+  margin: 0.35rem 0 0;
+}
+
+.button {
+  display: inline-block;
+  min-height: 44px;
+  padding: 0.6rem 1.3rem;
+  font: inherit;
+  font-weight: 700;
+  color: #fff;
+  background: var(--accent);
+  border: 0;
+  border-radius: 4px;
+  cursor: pointer;
+}
+
+.form-status {
+  margin-top: 1rem;
+  font-weight: 700;
+}
+
+/* Footer */
+
+.site-footer {
+  background: var(--band);
+  border-top: 1px solid var(--rule);
+  padding: 1.5rem 0 2rem;
+}
+
+.site-footer p {
+  margin-bottom: 0.5rem;
+}
