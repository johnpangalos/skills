+// Round 2: with JavaScript off the form must not fall back to a GET submit that puts the message in the URL.
+test('with JavaScript off the submit button is disabled, Enter and click do not submit, and the noscript note shows (criterion 9, hostile)', async () => {
+  const context = await browser.newContext({ javaScriptEnabled: false, viewport: { width: 1280, height: 900 } });
+  try {
+    const page = await context.newPage();
+    const requests = [];
+    page.on('request', (request) => requests.push(request.url()));
+    const response = await page.goto(`${site.origin}/visit.html`);
+    assert.equal(response.status(), 200);
+    const url = page.url();
+    assert.equal(await page.locator('button[type="submit"]').isDisabled(), true);
+    assert.equal(await page.getByText(/needs JavaScript/).isVisible(), true);
+    await page.fill('#name', 'Ada Okafor');
+    await page.fill('#email', 'ada@example.org');
+    await page.fill('#message', 'Do you hold a copy of the Lantern Murders?');
+    const before = requests.length;
+    await page.locator('button[type="submit"]').click({ force: true, timeout: 2000 });
+    await page.press('#email', 'Enter');
+    await page.waitForTimeout(300);
+    assert.equal(page.url(), url, 'no navigation');
+    assert.equal(requests.length, before, 'no request after click or Enter');
+    assert.ok(!requests.some((u) => u.includes('message=')), 'message never in a URL');
+  } finally {
+    await context.close();
+  }
+});
