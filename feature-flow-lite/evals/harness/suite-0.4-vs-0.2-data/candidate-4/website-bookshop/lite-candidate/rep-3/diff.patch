+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Home | Marginalia Books</title>
+  <meta name="description" content="Marginalia Books is an independent bookshop on Lantern Row in Alder Bend, Oregon.">
+  <link rel="icon" href="data:,">
+  <link rel="stylesheet" href="css/styles.css">
+</head>
+<body>
+  <a class="skip-link" href="#main">Skip to main content</a>
+  <header class="site-header">
+    <div class="wrap header-inner">
+      <a class="brand" href="index.html">Marginalia Books</a>
+      <nav aria-label="Main">
+        <ul class="site-nav">
+          <li><a href="index.html" aria-current="page">Home</a></li>
+          <li><a href="books.html">Books</a></li>
+          <li><a href="events.html">Events</a></li>
+          <li><a href="visit.html">Visit</a></li>
+        </ul>
+      </nav>
+    </div>
+  </header>
+
+  <main id="main" tabindex="-1">
+    <div class="wrap">
+      <h1>Marginalia Books</h1>
+      <p class="lead">Marginalia Books is an independent bookshop on Lantern Row in Alder Bend, Oregon. We have sold new and secondhand books since 2009, and every shelf has a handwritten card from someone who has actually read the book. Come in for a long conversation about what to read next, or leave with a stack chosen for you.</p>
+
+      <section aria-labelledby="picks-title">
+        <h2 id="picks-title">Staff picks</h2>
+        <div class="pick-grid">
+          <article class="card">
+            <h3>The Salt Ledger</h3>
+            <p class="pick-author">Ines Corrado, literary fiction</p>
+            <p>Our bookseller Dana read this on a late ferry and missed her stop. The money plot is quiet, and the ending earns every page.</p>
+          </article>
+          <article class="card">
+            <h3>Brine and Bone</h3>
+            <p class="pick-author">Hana Mizrahi, poetry</p>
+            <p>Read one poem a night through a wet February. These are short, precise, and kind to people who work with their hands.</p>
+          </article>
+          <article class="card">
+            <h3>Field Notes from a Wet Summer</h3>
+            <p class="pick-author">Ellen Strand, essays</p>
+            <p>The best thing to take on a walk you already know well. Ellen notices the same stretch of river every week and never gets bored.</p>
+          </article>
+        </div>
+      </section>
+
+      <section class="teaser" aria-labelledby="next-title">
+        <h2 id="next-title">Next at the shop</h2>
+        <p>Winter Reading Night is on Saturday 12 December at 6:30 pm, when three local poets read new work over mulled cider. <a href="events.html">See all upcoming events</a>.</p>
+      </section>
+    </div>
+  </main>
+
+  <footer class="site-footer">
+    <div class="wrap">
+      <p>Marginalia Books, 14 Lantern Row, Alder Bend, OR 97420. Phone (541) 555-0148.</p>
+      <p>Open every day. <a href="visit.html">Hours, directions and contact</a>.</p>
+    </div>
+  </footer>
+</body>
+</html>
