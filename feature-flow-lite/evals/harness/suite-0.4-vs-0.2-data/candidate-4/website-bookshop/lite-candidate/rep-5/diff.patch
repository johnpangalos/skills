+// Catalog data for the books page and the staff picks on the home page.
+// All titles and authors are invented. Genre labels are the source for the genre filter.
+window.MARGINALIA_BOOKS = [
+  {
+    title: "The Clockmaker's Last Witness",
+    author: 'Evander Holt',
+    genre: 'Mystery',
+    price: 9.99,
+    blurb: "When a repairer of church clocks is found dead in his workshop, the village insists it was an accident. His apprentice, who counts the ticks in every room, disagrees.",
+  },
+  {
+    title: 'Salt Under the Bridge',
+    author: 'Ines Carrow',
+    genre: 'Mystery',
+    price: 8.5,
+    blurb: 'A harbour town in the rain, a body under the old bridge and a lighthouse keeper who saw everything and said nothing. A slow, careful puzzle with a lot of heart.',
+  },
+  {
+    title: 'Nine Keys to Ferrin Hall',
+    author: 'Dorothea Plume',
+    genre: 'Mystery',
+    price: 10,
+    blurb: 'A country house, nine locked doors and a family that would rather not explain the missing heir. Each chapter opens a door and closes a lie.',
+  },
+  {
+    title: 'The Orchard at Low Tide',
+    author: 'Ambrose Wieland',
+    genre: 'Literary Fiction',
+    price: 12,
+    blurb: 'Three generations share one farm on a windswept coast. Over a single harvest they confront debts, first loves and the land that will outlive them all.',
+  },
+  {
+    title: 'Letters to a Lighthouse Cook',
+    author: 'Nadia Brennock',
+    genre: 'Literary Fiction',
+    price: 11.5,
+    blurb: 'A cook writes letters she never posts to the man who taught her to bake bread in a storm. Funny, unsentimental and very hungry.',
+  },
+  {
+    title: 'Every Window Facing East',
+    author: 'Tomas Lindqvist',
+    genre: 'Literary Fiction',
+    price: 13,
+    blurb: 'Ten apartments in one city building, ten strangers and one winter that changes all of them. Quiet, precise and unexpectedly tender.',
