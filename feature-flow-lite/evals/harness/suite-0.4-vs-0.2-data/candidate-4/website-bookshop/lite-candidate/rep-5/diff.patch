+    const before = await state(once.page);
+    const canonical = new URL(once.page.url()).search;
+    const again = await openBooks(canonical);
+    assert.deepEqual(await state(again.page), before, `round trip for "${raw}"`);
+    assert.deepEqual(once.problems, []);
