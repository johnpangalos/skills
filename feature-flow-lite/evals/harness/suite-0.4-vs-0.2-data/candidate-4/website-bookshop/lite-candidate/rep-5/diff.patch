+const { chromium } = require('playwright');
+const { startServer, ROOT } = require('./server');
+
+const PAGES = [
+  { file: 'index.html', label: 'Home' },
+  { file: 'books.html', label: 'Books' },
+  { file: 'events.html', label: 'Events' },
+  { file: 'visit.html', label: 'Visit' },
+];
+
+let server;
+let browser;
+
+before(async () => {
+  server = await startServer();
