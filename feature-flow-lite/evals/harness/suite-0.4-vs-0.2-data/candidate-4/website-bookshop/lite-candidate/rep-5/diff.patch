@@ -0,0 +1,488 @@
+/* Marginalia Books. System font stacks only, no external requests. */
+
+:root {
+  --paper: #faf6ee;
+  --paper-deep: #f1e8d6;
+  --card: #fffdf8;
+  --ink: #2b2118;
+  --muted: #5c4f42;
+  --rule: #e0d3ba;
+  --green: #1f4d3a;
+  --green-deep: #163828;
+  --focus: #9a3f16;
+  --error: #8a1c1c;
+  --serif: Georgia, "Iowan Old Style", "Times New Roman", serif;
+  --sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
+}
+
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+
+[hidden] {
+  display: none !important;
+}
+
+body {
+  margin: 0;
+  background: var(--paper);
+  color: var(--ink);
+  font-family: var(--sans);
+  font-size: 1.0625rem;
+  line-height: 1.6;
+  overflow-wrap: anywhere;
+}
+
+a {
+  color: var(--green);
+  text-underline-offset: 0.2em;
+}
+
+a:hover {
+  color: var(--green-deep);
+}
+
+:focus-visible {
+  outline: 3px solid var(--focus);
+  outline-offset: 2px;
+}
+
+.skip-link {
+  position: absolute;
+  left: -10000px;
+  top: 0.5rem;
+  z-index: 10;
+  padding: 0.75rem 1rem;
+  background: var(--card);
+  color: var(--ink);
+  font-weight: 700;
+}
+
+.skip-link:focus {
+  left: 0.5rem;
+}
+
+/* Header and navigation */
+
+.site-header {
+  background: var(--paper-deep);
+  border-bottom: 1px solid var(--rule);
+}
+
+.site-header-inner {
+  max-width: 64rem;
+  margin: 0 auto;
+  padding: 0.75rem 1rem;
+  display: flex;
+  flex-direction: column;
+  gap: 0.25rem;
+}
+
+.brand {
+  margin: 0;
+  font-family: var(--serif);
+  font-size: 1.35rem;
+  font-weight: 700;
+}
+
+.brand a {
+  color: var(--ink);
+  text-decoration: none;
+}
+
+.nav-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.25rem 0.5rem;
+}
+
+.nav-list a {
+  display: inline-flex;
+  align-items: center;
+  min-height: 44px;
+  padding: 0 0.75rem;
+  border-radius: 4px;
+  color: var(--green);
+  font-weight: 600;
+  text-decoration: none;
+}
+
+.nav-list a:hover {
+  background: var(--rule);
+  text-decoration: underline;
+}
+
+.nav-list a[aria-current="page"] {
+  text-decoration: underline;
+  text-decoration-thickness: 2px;
+  text-underline-offset: 0.3em;
+}
+
+@media (min-width: 48rem) {
+  .site-header-inner {
+    flex-direction: row;
+    align-items: center;
+    justify-content: space-between;
+  }
+}
+
+/* Main content */
+
+main {
+  max-width: 64rem;
+  margin: 0 auto;
+  padding: 2rem 1rem 3rem;
+}
+
+main:focus {
+  outline: none;
+}
+
+h1,
+h2 {
+  font-family: var(--serif);
+  line-height: 1.25;
+  color: var(--ink);
+}
+
+h1 {
+  margin: 0 0 1rem;
+  font-size: clamp(1.9rem, 5vw, 2.6rem);
+}
+
+h2 {
+  margin: 2.5rem 0 0.75rem;
+  font-size: 1.6rem;
+}
+
+p {
+  max-width: 42rem;
+  margin: 0 0 1rem;
+  overflow-wrap: anywhere;
+}
+
+.hero {
+  margin-bottom: 1rem;
+  padding: 2rem 1.5rem;
+  border-radius: 6px;
+  background: var(--green);
+  color: var(--paper);
+}
+
+.hero h1,
+.hero p {
+  color: var(--paper);
+}
+
+.card-list,
+.book-grid,
+.event-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.card-list {
+  display: grid;
+  gap: 1rem;
+  grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
+}
+
+.card {
+  margin: 0;
+  padding: 1rem 1.25rem;
+  border: 1px solid var(--rule);
+  border-radius: 6px;
+  background: var(--card);
+}
+
+.card p {
+  margin: 0;
+  max-width: none;
+}
+
+.card p + p {
+  margin-top: 0.35rem;
+  color: var(--muted);
+}
+
+/* Buttons and form controls */
+
+button {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-height: 44px;
+  padding: 0 1.25rem;
+  border: 0;
+  border-radius: 4px;
+  background: var(--green);
+  color: var(--paper);
+  font: inherit;
+  font-weight: 600;
+  cursor: pointer;
+  transition: background-color 150ms ease;
+}
+
+button:hover {
+  background: var(--green-deep);
+}
+
+input,
+select,
+textarea {
+  display: block;
+  width: 100%;
+  min-height: 44px;
+  padding: 0.5rem 0.75rem;
+  border: 1px solid #6e5f4c;
+  border-radius: 4px;
+  background: var(--card);
+  color: var(--ink);
+  font: inherit;
+}
+
+textarea {
+  min-height: 8rem;
+  resize: vertical;
+}
+
+label {
+  display: block;
+  margin-bottom: 0.35rem;
+  font-weight: 600;
+}
+
+[aria-invalid="true"] {
+  border: 2px solid var(--error);
+}
+
+.filter {
+  margin: 0 0 1rem;
+}
+
+.filter select {
+  width: auto;
+  min-width: min(100%, 14rem);
+  max-width: 100%;
+}
+
+.result-count {
+  margin-bottom: 1rem;
+  color: var(--muted);
+  font-weight: 600;
+}
+
+.no-books {
+  padding: 1rem;
+  border-radius: 6px;
+  background: var(--paper-deep);
+}
+
+/* Catalog and events */
+
+.book-grid {
+  display: grid;
+  gap: 1.25rem;
+  grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
+}
+
+.book {
+  display: flex;
+  flex-direction: column;
+  gap: 0.5rem;
+  padding: 1rem;
+  border: 1px solid var(--rule);
+  border-radius: 6px;
+  background: var(--card);
+}
+
+.book h2 {
+  margin: 0.25rem 0 0;
+  font-size: 1.2rem;
+}
+
+.book p {
+  margin: 0;
+  max-width: none;
+}
+
+.book-author {
+  color: var(--muted);
+}
+
+.book-genre {
+  color: var(--muted);
+  font-size: 1rem;
+  font-weight: 600;
+  text-transform: uppercase;
+  letter-spacing: 0.04em;
+}
+
+.book-price {
+  font-weight: 700;
+}
+
+.cover {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  min-height: 9rem;
+  padding: 1rem;
+  border-radius: 3px;
+  color: var(--paper);
+  font-family: var(--serif);
+  font-size: 1.1rem;
+  font-weight: 700;
+  line-height: 1.3;
+  text-align: center;
+}
+
+.genre-mystery {
+  background: #2e3f6e;
+}
+
+.genre-literary-fiction {
+  background: #6b2d3c;
+}
+
+.genre-science-fiction {
+  background: #1f4d3a;
+}
+
+.genre-poetry {
+  background: #7a5c1e;
+}
+
+.genre-nature-essays {
+  background: #3d5a2a;
+}
+
+.event-list {
+  display: grid;
+  gap: 1rem;
+}
+
+.event {
+  padding: 1.25rem;
+  border: 1px solid var(--rule);
+  border-radius: 6px;
+  background: var(--card);
+}
+
+.event h2 {
+  margin: 0 0 0.35rem;
+  font-size: 1.25rem;
+}
+
+.event p {
+  margin: 0 0 0.5rem;
+  max-width: none;
+}
+
+.event-when {
+  color: var(--muted);
+  font-weight: 600;
+}
+
+.event-for {
+  color: var(--muted);
+}
+
+/* Visit page */
+
+.hours {
+  width: 100%;
+  max-width: 32rem;
+  border-collapse: collapse;
+  background: var(--card);
+}
+
+.hours th,
+.hours td {
+  padding: 0.6rem 0.75rem;
+  border-bottom: 1px solid var(--rule);
+  text-align: left;
+}
+
+.hours thead th {
+  background: var(--paper-deep);
+}
+
+address {
+  max-width: 32rem;
+  padding: 1rem 1.25rem;
+  border-left: 4px solid var(--green);
+  background: var(--paper-deep);
+  font-style: normal;
+  line-height: 1.7;
+}
+
+.contact-form {
+  max-width: 36rem;
+}
+
+.form-field {
+  margin-bottom: 1.25rem;
+}
+
+.hint {
+  margin: 0 0 0.35rem;
+  color: var(--muted);
+}
+
+.field-error {
+  margin: 0.35rem 0 0;
+  color: var(--error);
+  font-weight: 600;
+}
+
+.field-error:empty {
+  display: none;
+}
+
+.form-note {
+  color: var(--muted);
+}
+
+.form-status:empty {
+  padding: 0;
+  border: 0;
+}
+
+.form-status {
+  margin-top: 1.25rem;
+  padding: 1rem;
+  border-left: 4px solid var(--green);
+  background: var(--paper-deep);
+}
+
+/* Footer */
+
+.site-footer {
+  padding: 1.5rem 1rem;
+  border-top: 1px solid var(--rule);
+  background: var(--paper-deep);
+}
+
+.site-footer p {
+  margin: 0 auto 0.5rem;
+  max-width: 64rem;
+  color: var(--muted);
+  font-size: 1rem;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    transition: none !important;
+    animation: none !important;
+    scroll-behavior: auto !important;
+  }
+}
