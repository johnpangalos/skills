+  await addFixture(page, 'events-data.js', 'MARGINALIA_EVENTS', {
+    title: longWord, start: '2027-01-10T10:00', description: 'A fixture event whose title is one unbroken word, to check the card wraps it.',
+    audience: 'everyone',
