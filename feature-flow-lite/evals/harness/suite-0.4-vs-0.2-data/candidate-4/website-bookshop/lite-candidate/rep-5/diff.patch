+// Home page: fills in the staff picks and the next upcoming event from the shared data.
+(function () {
+  'use strict';
+
+  var picks = document.getElementById('staff-picks');
+  var next = document.getElementById('next-event');
+  var dates = window.MarginaliaDates;
+
+  function createPick(book) {
+    var item = document.createElement('li');
+    item.className = 'card';
+
+    var title = document.createElement('p');
+    var link = document.createElement('a');
+    link.href = 'books.html';
+    link.textContent = book.title;
+    title.appendChild(link);
+
+    var meta = document.createElement('p');
+    meta.textContent = 'by ' + book.author + ' · £' + book.price.toFixed(2);
+
+    item.append(title, meta);
+    return item;
+  }
+
+  if (picks && window.MARGINALIA_BOOKS) {
+    var featured = window.MARGINALIA_BOOKS.filter(function (book) { return book.featured; });
+    picks.replaceChildren.apply(picks, featured.map(createPick));
+  }
+
+  if (next && dates) {
+    var event = dates.upcoming(window.MARGINALIA_EVENTS || [])[0];
+    next.textContent = '';
+    if (event) {
+      var link = document.createElement('a');
+      link.href = 'events.html';
+      link.textContent = event.title;
+      next.append(link, ' on ' + dates.formatWhen(event.start) + '.');
+    } else {
+      next.textContent = 'There are no upcoming events at the moment. Please check back soon.';
+    }
+  }
+})();
diff --git a/tests/books.test.js b/tests/books.test.js
new file mode 100644
index 0000000..0b1af12
--- /dev/null
+++ b/tests/books.test.js
@@ -0,0 +1,269 @@
+'use strict';
+
+const { test, before, after } = require('node:test');
+const assert = require('node:assert/strict');
+const { chromium } = require('playwright');
+const { startServer } = require('./server');
+
+let server;
+let browser;
+
+before(async () => {
+  server = await startServer();
+  browser = await chromium.launch();
+});
+
+after(async () => {
+  await browser.close();
+  await server.close();
+});
+
+// Opens books.html with a query string and records console errors, page errors and dialogs.
+async function openBooks(query = '') {
+  const page = await browser.newPage();
+  const problems = [];
+  page.on('console', (msg) => {
+    if (msg.type() === 'error') problems.push(msg.text());
+  });
+  page.on('pageerror', (err) => problems.push(err.message));
+  page.on('dialog', (dialog) => {
+    problems.push(`dialog: ${dialog.message()}`);
+    dialog.dismiss();
+  });
+  await page.goto(`${server.origin}/books.html${query}`);
+  await page.waitForSelector('#book-list > li');
+  return { page, problems };
+}
+
+const dataBooks = (page) => page.evaluate(() => window.MARGINALIA_BOOKS);
+const titles = (page) => page.$$eval('#book-list h2', (els) => els.map((el) => el.textContent));
+const genreTags = (page) => page.$$eval('#book-list .book-genre', (els) => els.map((el) => el.textContent));
+const selectedGenre = (page) => page.getByLabel('Genre').inputValue();
+const countText = (page) => page.getByRole('status').textContent();
+
+async function waitForGenre(page, value) {
+  await page.waitForFunction((v) => document.getElementById('genre-filter').value === v, value);
+}
+
+async function state(page) {
+  return {
+    genre: await selectedGenre(page),
+    count: await countText(page),
+    titles: await titles(page),
+  };
+}
+
+test('catalog has at least 12 books across at least 5 genres, each genre with at least 2 titles', async () => {
+  const { page, problems } = await openBooks();
+  const books = await dataBooks(page);
+  assert.ok(books.length >= 12, `only ${books.length} books`);
+  const counts = {};
+  for (const book of books) counts[book.genre] = (counts[book.genre] || 0) + 1;
+  assert.ok(Object.keys(counts).length >= 5, 'at least five genres');
+  for (const [genre, n] of Object.entries(counts)) assert.ok(n >= 2, `${genre} has ${n} titles`);
+  assert.equal(await page.locator('#book-list > li').count(), books.length);
+  assert.deepEqual(problems, []);
+  await page.close();
+});
+
+test('each book shows title, author, genre, price and a blurb', async () => {
+  const { page } = await openBooks();
+  const cards = await page.$$eval('#book-list > li', (items) =>
+    items.map((li) => ({
+      title: li.querySelector('h2')?.textContent.trim() || '',
+      author: li.querySelector('.book-author')?.textContent.trim() || '',
+      genre: li.querySelector('.book-genre')?.textContent.trim() || '',
+      price: li.querySelector('.book-price')?.textContent.trim() || '',
+      blurb: li.querySelector('.book-blurb')?.textContent.trim() || '',
+    })),
+  );
+  assert.ok(cards.length >= 12);
+  for (const card of cards) {
+    assert.ok(card.title, 'title');
+    assert.match(card.author, /^by \S/, `author for ${card.title}`);
+    assert.ok(card.genre, `genre for ${card.title}`);
+    assert.match(card.price, /^£\d+\.\d{2}$/, `price for ${card.title}`);
+    assert.ok(card.blurb.length >= 40, `blurb for ${card.title}`);
+  }
+  await page.close();
+});
+
+test('genre control is labelled and offers All genres plus every genre from the data, in order', async () => {
+  const { page } = await openBooks();
+  const books = await dataBooks(page);
+  const options = await page.getByLabel('Genre').locator('option').allTextContents();
+  const genres = [...new Set(books.map((b) => b.genre))];
+  assert.deepEqual(options, ['All genres', ...genres]);
+  await page.close();
+});
+
+test('choosing a genre shows only its books, updates the count, and All restores every book', async () => {
+  const { page } = await openBooks();
+  const books = await dataBooks(page);
+  const mystery = books.filter((b) => b.genre === 'Mystery').length;
+  await page.getByLabel('Genre').selectOption('mystery');
+  assert.deepEqual(await genreTags(page), Array(mystery).fill('Mystery'));
+  assert.equal(await countText(page), `Showing ${mystery} of ${books.length} books`);
+  await page.getByLabel('Genre').selectOption('');
+  assert.equal((await titles(page)).length, books.length);
+  assert.equal(await countText(page), `Showing ${books.length} of ${books.length} books`);
+  await page.close();
+});
+
+test('the result count sits in a polite live region', async () => {
+  const { page } = await openBooks();
+  const status = page.getByRole('status');
+  assert.equal(await status.count(), 1);
+  const live = await status.getAttribute('aria-live');
+  assert.ok(live === null || live === 'polite', `aria-live is ${live}`);
+  await page.close();
+});
+
+test('choosing a genre writes it to the query string', async () => {
+  const { page } = await openBooks();
+  await page.getByLabel('Genre').selectOption('poetry');
+  assert.equal(new URL(page.url()).search, '?genre=poetry');
+  await page.close();
+});
+
+test('loading a genre URL restores the control and the list', async () => {
