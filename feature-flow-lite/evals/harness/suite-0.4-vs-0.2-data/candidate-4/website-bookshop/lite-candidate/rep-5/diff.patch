diff --git a/js/books.js b/js/books.js
new file mode 100644
index 0000000..0441168
--- /dev/null
+++ b/js/books.js
@@ -0,0 +1,123 @@
+// Catalog page: renders the books, filters them by genre, and keeps the genre in the query string.
+(function () {
+  'use strict';
+
+  var books = window.MARGINALIA_BOOKS || [];
+  var select = document.getElementById('genre-filter');
+  var list = document.getElementById('book-list');
+  var count = document.getElementById('result-count');
+  var empty = document.getElementById('no-books');
+  if (!select || !list || !count || !empty) return;
+
+  var genres = listGenres(books);
+
+  function slugify(label) {
+    return String(label).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
+  }
+
+  // Unique genres in data order, each with a URL slug and its display label.
+  function listGenres(items) {
+    var result = [];
+    items.forEach(function (book) {
+      var slug = slugify(book.genre);
+      var known = result.some(function (genre) { return genre.slug === slug; });
+      if (!known) result.push({ slug: slug, label: book.genre });
+    });
+    return result;
+  }
+
+  // Maps a raw query value to a known genre slug, ignoring case and spaces. Unknown values map to '' (All).
+  function resolveGenre(raw) {
+    var wanted = String(raw || '').trim().toLowerCase();
+    var match = genres.find(function (genre) { return genre.slug === wanted; });
+    return match ? match.slug : '';
+  }
+
+  function filterBooks(slug) {
+    if (!slug) return books.slice();
+    return books.filter(function (book) { return slugify(book.genre) === slug; });
+  }
+
+  function renderOptions() {
+    genres.forEach(function (genre) {
+      var option = document.createElement('option');
+      option.value = genre.slug;
+      option.textContent = genre.label;
+      select.appendChild(option);
+    });
+  }
+
+  function createCard(book) {
+    var item = document.createElement('li');
+    item.className = 'book';
+
+    var cover = document.createElement('div');
+    cover.className = 'cover genre-' + slugify(book.genre);
+    cover.setAttribute('aria-hidden', 'true');
+    cover.textContent = book.title;
+
+    var title = document.createElement('h2');
+    title.textContent = book.title;
+
+    var author = document.createElement('p');
+    author.className = 'book-author';
+    author.textContent = 'by ' + book.author;
+
+    var genre = document.createElement('p');
+    genre.className = 'book-genre';
+    genre.textContent = book.genre;
+
+    var blurb = document.createElement('p');
+    blurb.className = 'book-blurb';
+    blurb.textContent = book.blurb;
+
+    var price = document.createElement('p');
+    price.className = 'book-price';
+    price.textContent = '£' + book.price.toFixed(2);
+
+    item.append(cover, title, author, genre, blurb, price);
+    return item;
+  }
+
+  function renderBooks(items) {
+    list.replaceChildren.apply(list, items.map(createCard));
+  }
+
+  function showGenre(slug) {
+    var items = filterBooks(slug);
+    select.value = slug;
+    renderBooks(items);
+    count.textContent = 'Showing ' + items.length + ' of ' + books.length + ' books';
+    empty.hidden = items.length > 0;
+  }
+
+  // The page address for a genre: ?genre=slug, or no query for All.
+  function urlFor(slug) {
+    var url = new URL(window.location.href);
+    if (slug) {
+      url.searchParams.set('genre', slug);
+    } else {
+      url.searchParams.delete('genre');
+    }
+    return url.pathname + url.search;
+  }
+
+  function genreFromUrl() {
+    return resolveGenre(new URLSearchParams(window.location.search).get('genre'));
+  }
+
+  renderOptions();
+  var initial = genreFromUrl();
+  window.history.replaceState(null, '', urlFor(initial));
+  showGenre(initial);
+
+  select.addEventListener('change', function () {
+    var slug = select.value;
+    window.history.pushState(null, '', urlFor(slug));
+    showGenre(slug);
+  });
+
+  window.addEventListener('popstate', function () {
+    showGenre(genreFromUrl());
+  });
+})();
diff --git a/js/contact.js b/js/contact.js
new file mode 100644
index 0000000..f19ee82
--- /dev/null
+++ b/js/contact.js
@@ -0,0 +1,81 @@
+// Contact form: client-side checks only. The form is a demo and never sends anything.
+(function () {
+  'use strict';
+
+  var MAX_MESSAGE_LENGTH = 1000;
+  // The domain may not start with a dot, contain two dots in a row, or end with one.
+  var EMAIL_PATTERN = /^[^\s@]+@(?!\.)(?![^\s@]*\.\.)(?![^\s@]*\.$)[^\s@]+\.[^\s@]{2,}$/;
+
+  var form = document.getElementById('contact-form');
+  var status = document.getElementById('form-status');
+  if (!form || !status) return;
+
+  var VALIDATORS = {
+    name: checkName,
+    email: checkEmail,
+    message: checkMessage,
+  };
+
+  // Each checker returns an error message, or '' when the value is acceptable.
+  function checkName(value) {
+    return value.trim() ? '' : 'Please enter your name.';
+  }
+
+  function checkEmail(value) {
+    var email = value.trim();
+    if (!email) return 'Please enter your email address.';
+    if (!EMAIL_PATTERN.test(email)) return 'Please enter an email address in the form name@example.com.';
+    return '';
+  }
+
+  // Counts characters as code points, so an emoji is one character, not two UTF-16 code units.
+  function checkMessage(value) {
+    var length = Array.from(value).length;
+    if (!value.trim()) return 'Please enter a message.';
+    if (length > MAX_MESSAGE_LENGTH) {
+      return 'Your message is ' + length + ' characters. Please keep it to 1,000 characters or fewer.';
+    }
+    return '';
+  }
+
+  // Checks one field, sets its error text and aria-invalid, and returns the message ('' when valid).
+  function validateField(id) {
+    var message = VALIDATORS[id](document.getElementById(id).value);
+    document.getElementById(id + '-error').textContent = message;
+    document.getElementById(id).setAttribute('aria-invalid', message ? 'true' : 'false');
+    return message;
+  }
+
+  function showConfirmation() {
+    var link = document.createElement('a');
+    link.href = 'mailto:hello@marginalia.example';
+    link.textContent = 'hello@marginalia.example';
+    status.replaceChildren(
+      "This is a demo site, so your message wasn't sent anywhere. To reach us, email ",
+      link,
+      ' or call 01632 960123.',
+    );
+  }
+
+  form.addEventListener('submit', function (event) {
+    event.preventDefault();
+    var firstInvalid = null;
+    Object.keys(VALIDATORS).forEach(function (id) {
+      var message = validateField(id);
+      if (message && !firstInvalid) firstInvalid = document.getElementById(id);
+    });
+    if (firstInvalid) {
+      status.replaceChildren();
+      firstInvalid.focus();
+      return;
+    }
+    showConfirmation();
+  });
+
+  // Once a field is marked invalid, re-check it as the reader types so the error clears when fixed.
+  Object.keys(VALIDATORS).forEach(function (id) {
+    document.getElementById(id).addEventListener('input', function () {
+      if (document.getElementById(id).getAttribute('aria-invalid') === 'true') validateField(id);
+    });
+  });
+})();
