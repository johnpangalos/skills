+test('book title and blurb containing HTML are shown as literal text and run no script', async () => {
+  const hostile = '<img src=x onerror="window.__xss=1">';
+  const page = await browser.newPage();
+  await page.route('**/js/books-data.js', async (route) => {
+    const response = await route.fetch();
+    const fixture = { title: hostile, author: 'Test Author', genre: 'Mystery', price: 1, featured: false, blurb: hostile };
+    const body = `${await response.text()}\nwindow.MARGINALIA_BOOKS.push(${JSON.stringify(fixture)});`;
