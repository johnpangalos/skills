+test('URL and filter state round-trip: every genre and every hostile value reloads to the same state', async () => {
+  const first = await openBooks();
+  const values = await first.page.getByLabel('Genre').locator('option').evaluateAll((os) => os.map((o) => o.value));
+  const allState = await state(first.page);
+  for (const value of values.filter(Boolean)) {
+    await first.page.getByLabel('Genre').selectOption(value);
+    const before = await state(first.page);
+    const fresh = await openBooks(new URL(first.page.url()).search);
+    assert.deepEqual(await state(fresh.page), before, `round trip for ${value}`);
+    assert.deepEqual(fresh.problems, []);
+    await fresh.page.close();
