+import random
+import re
+from datetime import timedelta
+
+import pytest
+
+import click
+from click.types import _format_duration
+
+ONE_HOUR = timedelta(hours=1)
+ONE_MINUTE = timedelta(minutes=1)
+
+
+def _malformed_message(value):
+    return f"{value!r} is not a valid duration."
+
+
+def test_export_and_shape():
+    assert click.Duration is click.types.Duration
+    assert issubclass(click.Duration, click.ParamType)
+    assert click.Duration.name == "duration"
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        ("90s", timedelta(seconds=90)),
+        ("5m", timedelta(minutes=5)),
+        ("1h30m", timedelta(hours=1, minutes=30)),
+        ("2d4h", timedelta(days=2, hours=4)),
+        ("1m500ms", timedelta(seconds=60.5)),
+        ("5ms", timedelta(milliseconds=5)),
+        ("90", timedelta(seconds=90)),
+        ("0", timedelta(0)),
+        ("0s", timedelta(0)),
+        ("0ms", timedelta(0)),
+        ("120m", timedelta(hours=2)),
+        (
+            "1d2h3m4s5ms",
+            timedelta(days=1, hours=2, minutes=3, seconds=4, milliseconds=5),
+        ),
+        ("  5s \t", timedelta(seconds=5)),
+    ],
+)
+def test_convert_valid(value, expect):
+    assert click.Duration().convert(value, None, None) == expect
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "60m",
+        "1h",
+        "3600",
+        "3600s",
+        "1h0m0s",
+        "3600000ms",
+    ],
+)
+def test_equal_amounts_spelled_differently(value):
+    assert click.Duration().convert(value, None, None) == ONE_HOUR
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "",
+        "   ",
+        "s",
+        "ms",
+        "1x",
+        "1hr",
+        "1 h",
+        "1h 30m",
