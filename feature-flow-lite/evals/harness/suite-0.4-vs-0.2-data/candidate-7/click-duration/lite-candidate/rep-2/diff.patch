+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        (timedelta(0), "0s"),
+        (timedelta(seconds=90), "1m30s"),
+        (timedelta(seconds=60.5), "1m500ms"),
+        (timedelta(days=1), "1d"),
+        (timedelta(days=2, hours=4), "2d4h"),
+        (timedelta(minutes=5), "5m"),
+        (timedelta(milliseconds=5), "5ms"),
+        (
+            timedelta(days=1, hours=2, minutes=3, seconds=4, milliseconds=5),
+            "1d2h3m4s5ms",
+        ),
+        (timedelta(microseconds=500), str(timedelta(microseconds=500))),
+    ],
+)
+def test_format_duration(value, expect):
+    assert _format_duration(value) == expect
+
+
+def test_property_round_trip_whole_milliseconds():
+    rng = random.Random(1234)
+    failures = []
+
+    for _ in range(2000):
+        td = timedelta(milliseconds=rng.randrange(0, 10 ** rng.randint(1, 12)))
+
+        if click.Duration().convert(_format_duration(td), None, None) != td:
+            failures.append(td)
+
+    assert not failures, f"first failing input: {failures[:1]!r}"
+
+
+def test_property_assembled_string_equals_sum_of_parts():
+    rng = random.Random(5678)
+    units = [
+        ("d", timedelta(days=1)),
+        ("h", ONE_HOUR),
+        ("m", ONE_MINUTE),
+        ("s", timedelta(seconds=1)),
+        ("ms", timedelta(milliseconds=1)),
+    ]
+    failures = []
+
+    for _ in range(2000):
+        text = ""
+        expect = timedelta(0)
+
+        for suffix, size in units:
+            if rng.random() < 0.5:
+                count = rng.randrange(0, 10**6)
+                text += f"{count}{suffix}"
+                expect += count * size
+
+        if not text:
+            text = "7s"
+            expect = timedelta(seconds=7)
+
+        padded = f" {text} "
+
+        if click.Duration().convert(padded, None, None) != expect:
+            failures.append(text)
+
+    assert not failures, f"first failing input: {failures[:1]!r}"
+
+
+def test_property_hostile_strings_only_raise_bad_parameter():
+    # Independent oracle for the grammar: a bare integer, or ordered unit parts.
+    oracle = (
+        r"[0-9]+|(?=[0-9])(?:[0-9]+d)?(?:[0-9]+h)?(?:[0-9]+m)?"
+        r"(?:[0-9]+s)?(?:[0-9]+ms)?"
+    )
+    rng = random.Random(9012)
+    alphabet = "0123456789dhmsx .-+e_٣３"
+    failures = []
+
+    for _ in range(3000):
+        text = "".join(rng.choice(alphabet) for _ in range(rng.randint(0, 12)))
+        accepted = re.fullmatch(oracle, text.strip()) is not None
+
+        try:
+            click.Duration().convert(text, None, None)
+        except click.BadParameter as exc:
+            if accepted or exc.message != _malformed_message(text):
+                failures.append(text)
+        except Exception as exc:  # any other exception is a failure
+            failures.append((text, repr(exc)))
+        else:
+            if not accepted:
+                failures.append(text)
+
+    assert not failures, f"first failing input: {failures[:1]!r}"
+
+
+def test_repr():
+    assert repr(click.Duration()) == "<Duration>"
+    assert repr(click.Duration(min=ONE_MINUTE, max=ONE_HOUR)) == "<Duration 1m<=x<=1h>"
+    assert repr(click.Duration(min=ONE_MINUTE)) == "<Duration x>=1m>"
+
