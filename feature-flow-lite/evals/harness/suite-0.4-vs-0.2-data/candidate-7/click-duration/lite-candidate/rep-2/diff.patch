+class DurationInfoDict(ParamTypeInfoDict):
+    min: timedelta | None
+    max: timedelta | None
+
+
+# Unit parts in order, each at most once. The lookahead stops an empty string
+# matching. With ``fullmatch``, ``5ms`` is matched as milliseconds because the
+# ``m`` alternative backtracks when the rest of the string does not fit.
+_DURATION_PARTS_RE = re.compile(
+    r"(?=[0-9])"
+    r"(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?(?:([0-9]+)ms)?"
+)
+# Units from largest to smallest, with their size in milliseconds.
+_DURATION_UNITS = (
+    ("d", 86_400_000),
+    ("h", 3_600_000),
+    ("m", 60_000),
+    ("s", 1_000),
+    ("ms", 1),
+)
+
+
+def _parse_duration(value: str) -> timedelta:
+    """Parse a bare number of seconds or a string of unit parts.
+
+    Raises ``ValueError`` if the string is malformed, and ``OverflowError``
+    if the duration is too large to represent.
+    """
+    if re.fullmatch("[0-9]+", value):
+        return timedelta(seconds=int(value))
+
+    match = _DURATION_PARTS_RE.fullmatch(value)
+
+    if match is None:
+        raise ValueError(value)
+
+    days, hours, minutes, seconds, milliseconds = (
+        int(part or 0) for part in match.groups()
+    )
+    return timedelta(
+        days=days,
+        hours=hours,
+        minutes=minutes,
+        seconds=seconds,
+        milliseconds=milliseconds,
+    )
+
+
+def _is_duration_syntax(value: timedelta) -> bool:
+    """Whether :func:`_format_duration` can write ``value`` in the duration
+    syntax: it must be non-negative and a whole number of milliseconds.
+    """
+    return value >= timedelta(0) and not value % timedelta(milliseconds=1)
+
+
+def _format_duration(value: timedelta) -> str:
+    """Render a duration in the syntax :class:`Duration` parses, largest unit
+    first. Durations :func:`_is_duration_syntax` rejects are rendered with
+    ``str()``.
+    """
+    if not _is_duration_syntax(value):
+        return str(value)
+
+    remaining = value // timedelta(milliseconds=1)
+    parts: list[str] = []
+
+    for suffix, size in _DURATION_UNITS:
+        count, remaining = divmod(remaining, size)
+
+        if count:
+            parts.append(f"{count}{suffix}")
+
+    return "".join(parts) or "0s"
+
+
+class Duration(ParamType[timedelta]):
+    """Convert a duration string to a :class:`datetime.timedelta`.
+
+    The value is either a bare integer, which is a number of seconds, or one
+    or more parts of a number followed by a unit, in the order ``d``, ``h``,
+    ``m``, ``s``, ``ms``. Each unit may appear at most once and must be
+    lowercase, for example ``90s``, ``5m``, ``1h30m`` or ``1m500ms``.
+    Negative durations are not accepted.
+
+    :param min: The shortest accepted duration. Inclusive. If not given, any
+        duration is accepted in that direction.
+    :param max: The longest accepted duration. Inclusive. If not given, any
+        duration is accepted in that direction.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    min: timedelta | None
+    max: timedelta | None
+
+    def __init__(
+        self, min: timedelta | None = None, max: timedelta | None = None
+    ) -> None:
+        self.min = min
+        self.max = max
+
+    def to_info_dict(self) -> DurationInfoDict:
+        return {"min": self.min, "max": self.max, **super().to_info_dict()}
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            duration = value
+        else:
+            try:
+                duration = _parse_duration(str(value).strip())
+            except (ValueError, OverflowError):
+                self.fail(
+                    _("{value!r} is not a valid duration.").format(value=value),
+                    param,
+                    ctx,
+                )
+
+        if duration < timedelta(0):
+            self.fail(
+                _("{value} is not a valid duration.").format(value=duration),
+                param,
+                ctx,
+            )
+
+        if (self.min is not None and duration < self.min) or (
+            self.max is not None and duration > self.max
+        ):
+            self.fail(
+                _("{value} is not in the range {range}.").format(
+                    value=_format_duration(duration), range=self._describe_range()
+                ),
+                param,
+                ctx,
+            )
+
+        return duration
+
+    def _describe_range(self) -> str:
+        """Describe the range for use in help text. Empty if unbounded."""
+        if self.min is None:
+            return "" if self.max is None else f"x<={_format_duration(self.max)}"
+
+        if self.max is None:
+            return f"x>={_format_duration(self.min)}"
+
+        return f"{_format_duration(self.min)}<=x<={_format_duration(self.max)}"
+
+    def __repr__(self) -> str:
+        range_str = self._describe_range()
+        return f"<Duration {range_str}>" if range_str else "<Duration>"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
