+
+
+def test_sub_millisecond_bound_renders_without_crashing():
+    bound = timedelta(microseconds=500)
+    type = click.Duration(min=bound, max=ONE_HOUR)
+
+    with pytest.raises(click.BadParameter) as exc_info:
