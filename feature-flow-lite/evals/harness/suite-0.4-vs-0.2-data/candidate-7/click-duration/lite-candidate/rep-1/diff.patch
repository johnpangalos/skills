+
+def test_cli_valid_value():
+    @click.command()
+    @click.option("--opt", type=click.Duration())
+    def cmd(opt):
+        click.echo(str(opt.total_seconds()))
+
+    result = click.testing.CliRunner().invoke(cmd, ["--opt", "1m500ms"])
+    assert result.exit_code == 0
