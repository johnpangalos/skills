+def test_negative_bound_repr():
+    type = click.Duration(timedelta(seconds=-5), timedelta(hours=1))
+    assert repr(type) == "<Duration -5s<=x<=1h>"
+
+
+def test_round_trip_property():
+    rng = random.Random(8675309)
+    keywords = {
+        "d": "days",
+        "h": "hours",
+        "m": "minutes",
+        "s": "seconds",
+        "ms": "milliseconds",
+    }
+
+    for _ in range(1000):
+        parts = {}
+
+        for unit in keywords:
+            if rng.random() < 0.5:
+                parts[unit] = rng.choice([0, rng.randint(0, 99), rng.randint(0, 10**6)])
+
+        if not parts:
+            parts["s"] = 0
+
+        text = "".join(f"{count}{unit}" for unit, count in parts.items())
+        expect = timedelta(**{keywords[unit]: count for unit, count in parts.items()})
+        assert click.Duration().convert(text, None, None) == expect, (
+            f"first failing input: {text!r}"
+        )
+        assert (
+            click.Duration().convert(click.types._format_duration(expect), None, None)
+            == expect
+        ), f"first failing input: {text!r}"
