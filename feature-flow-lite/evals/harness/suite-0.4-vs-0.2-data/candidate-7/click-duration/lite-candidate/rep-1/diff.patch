+
+def test_non_string_int_is_seconds():
+    assert click.Duration().convert(5, None, None) == timedelta(seconds=5)
+
+
+def test_non_string_float_fails_cleanly():
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(5.5, None, None)
+
+    assert exc_info.value.message == MALFORMED.format(value=5.5)
+
+
+def test_convert_unprintable_int():
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(10**5000, None, None)
+
+    assert exc_info.value.message == MALFORMED.replace(
+        "{value!r}", "<int too large to display>"
+    )
+
