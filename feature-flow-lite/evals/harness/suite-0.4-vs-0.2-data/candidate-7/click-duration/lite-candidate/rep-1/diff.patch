+import random
+from datetime import timedelta
+
+import pytest
+
+import click
+import click.testing
+import click.types
+
+MALFORMED = (
+    "{value!r} is not a valid duration. Use one or more <number><unit> parts with"
+    " units d, h, m, s, ms, such as '1h30m', or a bare number of seconds."
+)
+NEGATIVE = "{value!r} is negative. A duration must not be negative."
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        ("90s", timedelta(seconds=90)),
+        ("5m", timedelta(minutes=5)),
+        ("1h30m", timedelta(hours=1, minutes=30)),
+        ("2d4h", timedelta(days=2, hours=4)),
+        ("1m500ms", timedelta(seconds=60.5)),
+        ("500ms", timedelta(milliseconds=500)),
+        ("0", timedelta(0)),
+        ("0s", timedelta(0)),
+        ("007s", timedelta(seconds=7)),
+        (
+            "1d2h3m4s5ms",
+            timedelta(days=1, hours=2, minutes=3, seconds=4, milliseconds=5),
+        ),
+        ("45", timedelta(seconds=45)),
+        ("  1h  ", timedelta(hours=1)),
+        ("60s", timedelta(minutes=1)),
+        ("1m", timedelta(seconds=60)),
+        (
+            "999999999d23h59m59s999ms",
+            timedelta(
+                days=999999999, hours=23, minutes=59, seconds=59, milliseconds=999
+            ),
+        ),
+    ],
+)
+def test_convert(value, expect):
+    assert click.Duration().convert(value, None, None) == expect
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "30m1h",
+        "1h1h",
+        "1h 30m",
+        "5M",
+        "5S",
+        "1.5h",
+        "h",
+        "ms",
+        "5x",
+        "5mss",
+        "",
+        "+5s",
+        "٥s",  # arabic-indic digit five
+        "５s",  # fullwidth digit five
+        "5 s",
+        "1s1m",
+        "1ms1s",
+        "1d1d",
+    ],
+)
+def test_convert_malformed(value):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert exc_info.value.message == MALFORMED.format(value=value)
+
+
+@pytest.mark.parametrize("value", ["99999999999d", "1000000000d", "9" * 30 + "ms"])
+def test_convert_overflow(value):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert exc_info.value.message == MALFORMED.format(value=value)
+
+
+def test_convert_too_many_digits():
+    value = "5" * 5000
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert exc_info.value.message == MALFORMED.format(value=value)
+
+
+@pytest.mark.parametrize("value", ["-5s", "-5", "-1h30m", "-0s", "-0"])
+def test_convert_negative(value):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert exc_info.value.message == NEGATIVE.format(value=value)
+
+
+def test_convert_timedelta_passthrough():
+    value = timedelta(minutes=3)
+    assert click.Duration().convert(value, None, None) is value
+
+
+def test_convert_negative_timedelta_default():
+    value = timedelta(seconds=-5)
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert exc_info.value.message == "-5s is negative. A duration must not be negative."
+
+
+@pytest.mark.parametrize(
+    ("type", "value", "expect"),
+    [
+        (click.Duration(timedelta(seconds=30), timedelta(hours=1)), "30s", 30),
+        (click.Duration(timedelta(seconds=30), timedelta(hours=1)), "1h", 3600),
+        (click.Duration(timedelta(seconds=30)), "31s", 31),
+        (click.Duration(max=timedelta(hours=1)), "1h", 3600),
+        (click.Duration(max=timedelta(hours=1)), "0", 0),
+        (click.Duration(max=timedelta(hours=1)), timedelta(minutes=1), 60),
+        (click.Duration(timedelta(seconds=30)), timedelta(seconds=30), 30),
+    ],
+)
+def test_range(type, value, expect):
+    assert type.convert(value, None, None) == timedelta(seconds=expect)
+
+
+@pytest.mark.parametrize(
+    ("type", "value", "expect"),
+    [
+        (
+            click.Duration(timedelta(seconds=1), timedelta(hours=1)),
+            "2h",
+            "2h is not in the range 1s<=x<=1h.",
+        ),
+        (
+            click.Duration(timedelta(seconds=30)),
+            "10s",
+            "10s is not in the range x>=30s.",
+        ),
+        (
+            click.Duration(max=timedelta(hours=1)),
+            "2h",
+            "2h is not in the range x<=1h.",
+        ),
+        (
+            click.Duration(max=timedelta(0)),
+            "1s",
+            "1s is not in the range x<=0s.",
+        ),
+        (
+            click.Duration(max=timedelta(hours=1)),
+            timedelta(hours=2),
+            "2h is not in the range x<=1h.",
+        ),
+        (
+            click.Duration(min=timedelta(microseconds=1500)),
+            "1ms",
+            "1ms is not in the range x>=1ms500us.",
+        ),
+        (
+            click.Duration(max=timedelta(0)),
+            timedelta(microseconds=1),
+            "1us is not in the range x<=0s.",
+        ),
+    ],
+)
+def test_range_fail(type, value, expect):
+    with pytest.raises(click.BadParameter) as exc_info:
+        type.convert(value, None, None)
+
+    assert exc_info.value.message == expect
+
+
+def test_class_attributes():
+    assert click.Duration is click.types.Duration
+    assert isinstance(click.Duration(), click.ParamType)
+    assert click.Duration.name == "duration"
+
+
+def test_repr():
+    bounded = click.Duration(timedelta(seconds=30), timedelta(hours=1))
+    assert repr(bounded) == "<Duration 30s<=x<=1h>"
+    assert repr(click.Duration(timedelta(seconds=30))) == "<Duration x>=30s>"
+    assert repr(click.Duration(max=timedelta(hours=1))) == "<Duration x<=1h>"
+    assert repr(click.Duration()) == "DURATION"
+
+
+def test_to_info_dict():
+    type = click.Duration(timedelta(seconds=30), timedelta(hours=1))
+    assert type.to_info_dict() == {
+        "param_type": "Duration",
+        "name": "duration",
+        "min": timedelta(seconds=30),
+        "max": timedelta(hours=1),
+    }
+
+
+def test_help_metavar_and_range():
+    @click.command()
+    @click.option(
+        "--timeout",
+        type=click.Duration(timedelta(seconds=30), timedelta(hours=1)),
+        required=True,
+    )
+    def cmd(timeout):
+        pass
+
+    result = click.testing.CliRunner().invoke(cmd, ["--help"])
+    assert "--timeout DURATION" in result.output
+    assert "[30s<=x<=1h; required]" in result.output
+
+
+def test_help_no_bounds_no_range():
+    option = click.Option(["--timeout"], type=click.Duration())
+    context = click.Context(click.Command("test"))
+    assert option.get_help_extra(context) == {}
+    assert "x" not in option.get_help_record(context)[1]
+
+
+def test_help_one_bound_range():
+    option = click.Option(
+        ["--timeout"], type=click.Duration(max=timedelta(hours=1)), required=True
+    )
+    context = click.Context(click.Command("test"))
+    assert option.get_help_extra(context) == {
+        "range": "x<=1h",
+        "required": "required",
+    }
+
+
+def test_cli_invalid_value_exit_code():
+    @click.command()
+    @click.option("--opt", type=click.Duration())
+    def cmd(opt):
+        click.echo(repr(opt))
+
+    result = click.testing.CliRunner().invoke(cmd, ["--opt", "1h1h"])
+    assert result.exit_code == 2
+    assert result.stdout == ""
+    assert (
+        "Error: Invalid value for '--opt': " + MALFORMED.format(value="1h1h") + "\n"
+    ) in result.stderr
+    assert "Traceback" not in result.stderr
+
+
+def test_cli_out_of_range_exit_code():
+    @click.command()
+    @click.option("--opt", type=click.Duration(max=timedelta(hours=1)))
+    def cmd(opt):
+        click.echo(repr(opt))
+
+    result = click.testing.CliRunner().invoke(cmd, ["--opt", "2h"])
+    assert result.exit_code == 2
+    assert "Error: Invalid value for '--opt': 2h is not in the range x<=1h." in (
+        result.stderr
+    )
