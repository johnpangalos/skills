+class DurationInfoDict(ParamTypeInfoDict):
+    min: timedelta | None
+    max: timedelta | None
+
+
+_DURATION_SECONDS_RE = re.compile(r"[0-9]+")
+_DURATION_PARTS_RE = re.compile(
+    r"(?=[0-9])(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m(?!s))?"
+    r"(?:([0-9]+)s)?(?:([0-9]+)ms)?"
+)
+_DURATION_UNITS = (
+    ("d", 86400000000),
+    ("h", 3600000000),
+    ("m", 60000000),
+    ("s", 1000000),
+    ("ms", 1000),
+    ("us", 1),
+)
+
+
+def _repr_value(value: t.Any) -> str:
+    """Return ``repr(value)``, or a placeholder if it is too large to print."""
+    try:
+        return repr(value)
+    except ValueError:
+        return f"<{type(value).__name__} too large to display>"
+
+
+def _format_duration(value: timedelta) -> str:
+    """Format a timedelta in the notation used by :class:`Duration`.
+
+    Sub-millisecond remainders are shown as ``us``, which :class:`Duration`
+    does not parse. The result is for display only.
+    """
+    if value < timedelta(0):
+        return f"-{_format_duration(-value)}"
+
+    total_us = (value.days * 86400 + value.seconds) * 1000000 + value.microseconds
+    parts = []
+
+    for unit, size in _DURATION_UNITS:
+        count, total_us = divmod(total_us, size)
+
+        if count:
+            parts.append(f"{count}{unit}")
+
+    return "".join(parts) or "0s"
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts a duration string into a
+    :class:`datetime.timedelta`.
+
+    The value is either a bare integer number of seconds, or one or more
+    ``<number><unit>`` parts with units ``d``, ``h``, ``m``, ``s`` and ``ms``.
+    Each unit may appear at most once, in that order, largest first, with no
+    separators, so ``1h30m`` and ``1m500ms`` are accepted. Negative values are
+    rejected.
+
+    If ``min`` or ``max`` are given, they are inclusive bounds.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "duration"
+
+    min: timedelta | None
+    max: timedelta | None
+
+    def __init__(
+        self, min: timedelta | None = None, max: timedelta | None = None
+    ) -> None:
+        self.min = min
+        self.max = max
+
+    def to_info_dict(self) -> DurationInfoDict:
+        return {"min": self.min, "max": self.max, **super().to_info_dict()}
+
+    def _parse(self, text: str) -> timedelta:
+        if _DURATION_SECONDS_RE.fullmatch(text):
+            return timedelta(seconds=int(text))
+
+        match = _DURATION_PARTS_RE.fullmatch(text)
+
+        if match is None:
+            raise ValueError(text)
+
+        days, hours, minutes, seconds, milliseconds = (
+            int(part or 0) for part in match.groups()
+        )
+        return timedelta(
+            days=days,
+            hours=hours,
+            minutes=minutes,
+            seconds=seconds,
+            milliseconds=milliseconds,
+        )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            rv = value
+            negative = rv < timedelta(0)
+            shown = _format_duration(rv)
+        else:
+            try:
+                text = str(value).strip()
+                negative = text.startswith("-")
+                rv = self._parse(text[1:] if negative else text)
+            except (ValueError, OverflowError):
+                self.fail(
+                    _(
+                        "{value} is not a valid duration. Use one or more"
+                        " <number><unit> parts with units d, h, m, s, ms, such as"
+                        " '1h30m', or a bare number of seconds."
+                    ).format(value=_repr_value(value)),
+                    param,
+                    ctx,
+                )
+
+            shown = repr(value)
+
+        if negative:
+            self.fail(
+                _("{value} is negative. A duration must not be negative.").format(
+                    value=shown
+                ),
+                param,
+                ctx,
+            )
+
+        if (self.min is not None and rv < self.min) or (
+            self.max is not None and rv > self.max
+        ):
+            self.fail(
+                _("{value} is not in the range {range}.").format(
+                    value=_format_duration(rv), range=self._describe_range()
+                ),
+                param,
+                ctx,
+            )
+
+        return rv
+
+    def _describe_range(self) -> str:
+        """Describe the range for use in help text and errors."""
+        if self.min is None:
+            return "" if self.max is None else f"x<={_format_duration(self.max)}"
+
+        if self.max is None:
+            return f"x>={_format_duration(self.min)}"
+
+        return f"{_format_duration(self.min)}<=x<={_format_duration(self.max)}"
+
+    def __repr__(self) -> str:
+        if self.min is None and self.max is None:
+            return "DURATION"
+
+        return f"<Duration {self._describe_range()}>"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
