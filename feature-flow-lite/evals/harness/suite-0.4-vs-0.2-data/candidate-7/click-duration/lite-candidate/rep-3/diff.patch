+@click.command()
+@click.option("--wait", type=click.Duration(max=timedelta(hours=1)))
+def wait_cmd(wait):
+    click.echo(str(wait.total_seconds()))
+
+
+@click.command()
+@click.option("--wait", envvar="WAIT", type=click.Duration())
+def env_cmd(wait):
+    click.echo(str(wait.total_seconds()))
+
+
+@click.command()
+@click.option("--wait", default="5m", type=click.Duration())
+def default_str_cmd(wait):
+    click.echo(str(wait.total_seconds()))
+
+
+@click.command()
+@click.option("--wait", default=timedelta(minutes=5), type=click.Duration())
+def default_td_cmd(wait):
+    click.echo(str(wait.total_seconds()))
+
+
+@click.command()
+@click.option("--wait", default=30, type=click.Duration())
+def default_int_cmd(wait):
+    click.echo(str(wait.total_seconds()))
+
+
+@click.command()
