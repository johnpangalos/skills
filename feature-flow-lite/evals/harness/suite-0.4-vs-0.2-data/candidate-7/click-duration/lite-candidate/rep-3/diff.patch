+def test_property_format_parse_roundtrip():
+    # Seeded random loop: parse(format(td)) == td for whole-millisecond values.
+    rng = random.Random(8675309)
+    duration = click.Duration()
+
+    for _ in range(1000):
+        value = timedelta(milliseconds=rng.randrange(0, 10**13))
+        text = click.types._format_duration(value)
+        assert duration.convert(text, None, None) == value, f"failing input {text!r}"
+
+
+def test_property_parts_sum():
+    # Seeded random loop: random valid part combinations parse to the sum.
+    rng = random.Random(2024)
+    units = [
+        ("d", "days"),
+        ("h", "hours"),
+        ("m", "minutes"),
+        ("s", "seconds"),
+        ("ms", "milliseconds"),
+    ]
+    duration = click.Duration()
+
+    for _ in range(1000):
+        text = ""
+        kwargs = {}
+
+        for suffix, arg in units:
+            if rng.random() < 0.5:
+                number = rng.randrange(0, 1000)
+                text += f"{number}{suffix}"
+                kwargs[arg] = number
+
+        if not text:
+            continue
+
+        expect = timedelta(**kwargs)
+        assert duration.convert(text, None, None) == expect, f"failing input {text!r}"
+
