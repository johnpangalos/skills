+import random
+from datetime import timedelta
+
+import pytest
+
+import click
+from click.testing import CliRunner
+
+MESSAGE = (
+    "{value!r} is not a valid duration."
+    " Use a number with a unit d, h, m, s or ms, like '1h30m'."
+)
+
+VALID = [
+    ("90s", timedelta(seconds=90)),
+    ("5m", timedelta(minutes=5)),
+    ("1h30m", timedelta(seconds=5400)),
+    ("2d4h", timedelta(hours=52)),
+    ("1m500ms", timedelta(seconds=60.5)),
+    ("5ms", timedelta(milliseconds=5)),
+    ("1m1ms", timedelta(seconds=60.001)),
+    ("1d2h3m4s5ms", timedelta(days=1, hours=2, minutes=3, seconds=4, milliseconds=5)),
+    ("0s", timedelta(0)),
+    ("90m", timedelta(seconds=5400)),
+    ("30", timedelta(seconds=30)),
+    ("0", timedelta(0)),
+    (30, timedelta(seconds=30)),
+    (0, timedelta(0)),
+    ("1m30s", timedelta(seconds=90)),
+    ("60s", timedelta(minutes=1)),
+    ("1000ms", timedelta(seconds=1)),
+]
+
+# Every value here fails with MESSAGE: malformed, negative, too large for
+# timedelta, or not a string.
+INVALID = [
+    "",
+    " ",
+    "s",
+    "h1",
+    "1.5h",
+    "1x",
+    "1H",
+    "1 h",
+    "1h 30m",
+    " 5s",
+    "5s ",
+    "+5s",
+    "1_000s",
+    "٥s",
+    "1e3",
+    "1hh",
+    "1h1h",
+    "30m1h",
+    "1ms1s",
+    "5sms",
+    "1s1m",
+    "\n5s",
+    "5s\n",
+    "1.5",
+    "-5s",
+    "-5",
+    "-1h30m",
+    "999999999999d",
+    "99999999999999999999s",
+    "9" * 5000,
+    "9" * 5000 + "s",
+    1.5,
+    float("nan"),
+    float("inf"),
+    True,
+    False,
+    10**30,
+    None,
