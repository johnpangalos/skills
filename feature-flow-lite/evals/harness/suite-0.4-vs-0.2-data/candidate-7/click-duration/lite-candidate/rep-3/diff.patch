+def test_property_out_of_order_units_fail():
+    # Seeded random loop: any subset of units written in the wrong order fails.
+    rng = random.Random(99)
+    order = ["d", "h", "m", "s", "ms"]
+    duration = click.Duration()
+
+    for _ in range(1000):
+        chosen = [unit for unit in order if rng.random() < 0.5]
+
+        if len(chosen) < 2:
+            continue
+
+        rng.shuffle(chosen)
+
+        if chosen == sorted(chosen, key=order.index):
+            continue
+
+        text = "".join(f"1{unit}" for unit in chosen)
+
+        with pytest.raises(click.BadParameter):
+            duration.convert(text, None, None)
