+class DurationInfoDict(ParamTypeInfoDict):
+    min: timedelta | None
+    max: timedelta | None
+
+
+_DURATION_DIGITS_RE = re.compile(r"[0-9]+")
+_DURATION_PARTS_RE = re.compile(
+    r"(?=[0-9])"
+    r"(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m(?!s))?(?:([0-9]+)s)?(?:([0-9]+)ms)?"
+)
+_DURATION_UNITS = (
+    ("d", 86_400_000),
+    ("h", 3_600_000),
+    ("m", 60_000),
+    ("s", 1_000),
+    ("ms", 1),
+)
+
+
+def _parse_duration(value: t.Any) -> timedelta:
+    """Parse a duration string such as ``1h30m``, or an integer number of
+    seconds. Raises ``ValueError`` if the value is not in the duration syntax.
+    """
+    if isinstance(value, int) and not isinstance(value, bool):
+        return timedelta(seconds=value)
+
+    if _DURATION_DIGITS_RE.fullmatch(value):
+        return timedelta(seconds=int(value))
+
+    match = _DURATION_PARTS_RE.fullmatch(value)
+
+    if match is None:
+        raise ValueError(value)
+
+    days, hours, minutes, seconds, milliseconds = (
+        int(part or 0) for part in match.groups()
+    )
+    return timedelta(
+        days=days,
+        hours=hours,
+        minutes=minutes,
+        seconds=seconds,
+        milliseconds=milliseconds,
+    )
+
+
+def _format_duration(value: timedelta) -> str:
+    """Format a non-negative timedelta in the duration syntax, largest unit
+    first, omitting zero parts. Parts smaller than a millisecond are dropped.
+    """
+    remaining = value // timedelta(milliseconds=1)
+    parts = []
+
+    for unit, size in _DURATION_UNITS:
+        count, remaining = divmod(remaining, size)
+
+        if count:
+            parts.append(f"{count}{unit}")
+
+    return "".join(parts) or "0s"
+
+
+class Duration(ParamType[timedelta]):
+    """Convert a duration string such as ``1h30m`` to a
+    :class:`datetime.timedelta`.
+
+    A duration is one or more parts, each an ASCII number followed by a unit:
+    ``d``, ``h``, ``m``, ``s`` or ``ms``. Units are lower case, must appear in
+    that order and at most once each, with no separators. For example,
+    ``90s``, ``1h30m`` and ``1m500ms`` are valid. A bare number is a number
+    of seconds, so ``30`` is 30 seconds, and so is an integer value such as
+    ``default=30``.
+
+    If ``min`` or ``max`` are not passed, any value is accepted in that
+    direction. Both bounds are inclusive. A :class:`datetime.timedelta` value
+    is accepted as-is, and negative values are rejected.
+
+    :param min: The smallest accepted duration, inclusive.
+    :param max: The largest accepted duration, inclusive.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "duration"
+
+    min: timedelta | None
+    max: timedelta | None
+
+    def __init__(
+        self, min: timedelta | None = None, max: timedelta | None = None
+    ) -> None:
+        self.min = min
+        self.max = max
+
+    def to_info_dict(self) -> DurationInfoDict:
+        return {"min": self.min, "max": self.max, **super().to_info_dict()}
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            rv = value
+        else:
+            try:
+                rv = _parse_duration(value)
+            except (OverflowError, TypeError, ValueError):
+                self.fail(
+                    _(
+                        "{value!r} is not a valid duration."
+                        " Use a number with a unit d, h, m, s or ms, like '1h30m'."
+                    ).format(value=value),
+                    param,
+                    ctx,
+                )
+
+        if rv < timedelta(0):
+            self.fail(
+                _("{value} is a negative duration.").format(
+                    value="-" + _format_duration(-rv)
+                ),
+                param,
+                ctx,
+            )
+
+        if (self.min is not None and rv < self.min) or (
+            self.max is not None and rv > self.max
+        ):
+            self.fail(
+                _("{value} is not in the range {range}.").format(
+                    value=_format_duration(rv), range=self._describe_range()
+                ),
+                param,
+                ctx,
+            )
+
+        return rv
+
+    def _describe_range(self) -> str:
+        """Describe the range for use in help text. Empty if unbounded."""
+        if self.min is not None and self.max is not None:
+            return f"{_format_duration(self.min)}<=x<={_format_duration(self.max)}"
+
+        if self.min is not None:
+            return f"x>={_format_duration(self.min)}"
+
+        if self.max is not None:
+            return f"x<={_format_duration(self.max)}"
+
+        return ""
+
+    def __repr__(self) -> str:
+        range_str = self._describe_range()
+        return f"<Duration {range_str}>" if range_str else "DURATION"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
