+"""Thread-safe stock tracking: units on hand and open reservations."""
+
+import threading
+from collections import defaultdict
+from dataclasses import dataclass, field
+
+from shop.catalog import lookup
+
+
+class OutOfStock(ValueError):
+    pass
+
+
+class ReservationError(ValueError):
+    pass
+
+
+@dataclass(frozen=True)
+class Reservation:
+    sku: str
+    qty: int
+    # Identity of the hold inside an Inventory; the Inventory never trusts sku/qty from the caller.
+    ticket: object = field(default_factory=object, init=False, compare=False, repr=False)
+
+
+class Inventory:
+    def __init__(self, stock):
+        self._lock = threading.Lock()
+        self._on_hand = {}
+        self._held = defaultdict(int)  # sku -> units held by open reservations
+        self._holds = {}  # ticket -> (sku, qty) for each open reservation
+        for sku, count in stock.items():
+            lookup(sku)
+            if type(count) is not int or count < 0:
+                raise ValueError(f"on hand for {sku} must be a non-negative int")
+            self._on_hand[sku] = count
+
+    def on_hand(self, sku):
+        """Units physically in stock, including units held by open reservations."""
+        lookup(sku)
+        with self._lock:
+            return self._on_hand.get(sku, 0)
+
+    def available(self, sku):
+        """Units on hand minus units held by open reservations."""
+        lookup(sku)
+        with self._lock:
+            return self._on_hand.get(sku, 0) - self._held[sku]
+
+    def reserve(self, sku, qty):
+        """Hold qty units of sku and return the Reservation."""
+        lookup(sku)
+        if type(qty) is not int or qty < 1:
+            raise ValueError("qty must be a positive int")
+        with self._lock:
+            free = self._on_hand.get(sku, 0) - self._held[sku]
+            if qty > free:
+                raise OutOfStock(f"only {free} of {sku} available, need {qty}")
+            reservation = Reservation(sku, qty)
+            self._holds[reservation.ticket] = (sku, qty)
+            self._held[sku] += qty
+            return reservation
+
+    def commit(self, reservation):
+        """Take a held reservation's units off hand for good."""
+        with self._lock:
+            sku, qty = self._settle(reservation)
+            self._on_hand[sku] -= qty
+
+    def release(self, reservation):
+        """Free a held reservation's units without taking them off hand."""
+        with self._lock:
+            self._settle(reservation)
+
+    def _settle(self, reservation):
+        """Close an open hold, drop its units from the held count, return its (sku, qty). Caller holds the lock."""
+        if not isinstance(reservation, Reservation) or reservation.ticket not in self._holds:
+            raise ReservationError("reservation is not open")
+        sku, qty = self._holds.pop(reservation.ticket)
+        self._held[sku] -= qty
+        return sku, qty
