+    def test_str_subclass_sku_eq_cannot_deadlock(self):
+        inv = Inventory({"MUG": 5})
+        inv.reserve("MUG", 1)
+
+        class Chatty(str):
+            def __eq__(self, other):
+                inv.available("MUG")
+                return str.__eq__(self, other)
+
+            __hash__ = str.__hash__
+
+        outcome = []
+
+        def reserve_chatty():
+            outcome.append(inv.reserve(Chatty("MUG"), 2))
+
+        worker = threading.Thread(target=reserve_chatty, daemon=True)
+        worker.start()
+        worker.join(timeout=2)
+        self.assertFalse(worker.is_alive(), "reserve deadlocked in a caller's __eq__")
+        self.assertEqual(outcome[0].sku, "MUG")
+        self.assertEqual(inv.available("MUG"), 2)
+
+    def test_non_str_sku_is_unknown_product(self):
+        inv = Inventory({"MUG": 1})
+        for sku in [b"MUG", 1, ("MUG",)]:
+            with self.subTest(sku=sku):
+                with self.assertRaises(UnknownProduct):
+                    inv.available(sku)
