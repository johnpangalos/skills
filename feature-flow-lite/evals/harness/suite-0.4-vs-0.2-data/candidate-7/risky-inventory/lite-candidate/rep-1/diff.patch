+"""Stock levels and reservations."""
+
+import threading
+from dataclasses import dataclass
+
+from shop.catalog import UnknownProduct, lookup
+
+
+class OutOfStock(ValueError):
+    pass
+
+
+class ReservationError(ValueError):
+    pass
+
+
+@dataclass(frozen=True, eq=False)
+class Reservation:
+    sku: str
+    qty: int
+
+
+def _known_sku(sku):
+    """Return sku as a plain str; raise UnknownProduct unless it is a catalog SKU.
+
+    str.__str__ is the only code that runs on a caller's str subclass, so no
+    caller-defined method can run while the inventory lock is held.
+    """
+    if not isinstance(sku, str):
+        raise UnknownProduct(sku)
+    sku = str.__str__(sku)
+    lookup(sku)
+    return sku
+
+
+class Inventory:
+    def __init__(self, on_hand):
+        """Copy a SKU -> units dict; unknown SKUs and bad counts are rejected."""
+        self._lock = threading.Lock()
+        self._on_hand = {}
+        for sku, units in on_hand.items():
+            sku = _known_sku(sku)
+            if type(units) is not int or units < 0:
+                raise ValueError(f"units must be a non-negative int, got {units!r}")
+            self._on_hand[sku] = units
+        self._open = {}
+
+    def on_hand(self, sku):
+        """Units on hand, including units held by open reservations."""
+        sku = _known_sku(sku)
+        with self._lock:
+            return self._on_hand.get(sku, 0)
+
+    def available(self, sku):
+        """Units on hand not held by an open reservation."""
+        sku = _known_sku(sku)
+        with self._lock:
+            return self._available(sku)
+
+    def reserve(self, sku, qty):
+        """Hold qty units of sku and return the Reservation."""
+        sku = _known_sku(sku)
+        if type(qty) is not int or qty < 1:
+            raise ValueError(f"qty must be a positive int, got {qty!r}")
+        with self._lock:
+            available = self._available(sku)
+            if qty > available:
+                raise OutOfStock(f"{sku}: wanted {qty}, {available} available")
+            reservation = Reservation(sku, qty)
+            self._open[id(reservation)] = reservation
+            return reservation
+
+    def commit(self, reservation):
+        """Take the held units off hand for good."""
+        with self._lock:
+            held = self._open_hold(reservation)
+            taken = self._on_hand[held.sku] - held.qty
+            del self._open[id(held)]
+            self._on_hand[held.sku] = taken
+
+    def release(self, reservation):
+        """End the hold so the units are available again."""
+        with self._lock:
+            held = self._open_hold(reservation)
+            del self._open[id(held)]
+
+    def _available(self, sku):
+        held = sum(r.qty for r in self._open.values() if r.sku == sku)
+        return self._on_hand.get(sku, 0) - held
+
+    def _open_hold(self, reservation):
+        # Match by identity only: never call the object's own __hash__ or __eq__.
+        held = self._open.get(id(reservation))
+        if held is None or held is not reservation:
+            raise ReservationError("not an open reservation of this inventory")
+        return held
