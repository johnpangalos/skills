+    def test_random_str_subclass_skus_keep_invariants(self):
+        """Seeded property test: 1000 sequences with str-subclass SKUs whose hashes move."""
+
+        class Drifty(str):
+            drift = 0
+
+            def __hash__(self):
+                return hash((str.__str__(self), Drifty.drift))
+
+        rng = random.Random(20261118)
