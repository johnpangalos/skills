+class _BareParameter(click.Parameter):
+    """Just enough of a parameter to be built; it declares nothing."""
+
+    def _parse_decls(self, decls, expose_value):
+        return "x", [], []
+
+    def add_to_parser(self, parser, ctx):
+        pass
+
+
+def test_parameter_help_spec_and_error_hint_use_spec():
+    ctx = click.Context(click.Command("cli"))
+
+    assert _BareParameter(["x"]).get_help_spec(ctx) == "x"
+
+    class Custom(_BareParameter):
+        @property
+        def spec(self) -> str:
+            return "CUSTOM"
+
+    param = Custom([])
+
+    assert param.get_help_spec(ctx) == "CUSTOM"
+    assert param.get_error_hint(None) == "'CUSTOM'"
