+def _class_statement_stacklevel() -> int:
+    """Depth of the class statement that is creating a subclass. Between it and
+    ``__init_subclass__`` sit Click frames, ``abc`` frames, and the ``__new__``
+    of any user metaclass.
+
+    .. versionadded:: 8.6.0
+    """
+    frame: FrameType | None = sys._getframe(1)
+    level = 1
+
+    while frame is not None:
+        module = frame.f_globals.get("__name__", "")
+        code = frame.f_code
+        first = frame.f_locals.get(code.co_varnames[0]) if code.co_argcount else None
+        is_metaclass_hook = (
+            code.co_name == "__new__"
+            and isinstance(first, type)
+            and issubclass(first, type)
+        )
+        skipped = module in ("click", "abc") or module.startswith("click.")
+
+        if not skipped and not is_metaclass_hook:
+            return level
+
+        frame = frame.f_back
+        level += 1
+
+    return level
+
