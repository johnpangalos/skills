+def test_option_help_spec_keeps_metavar_and_hidden_output():
+    ctx = click.Context(click.Command("cli"))
+    opt = click.Option(["-t", "--times"], type=int, hidden=True)
+
+    assert opt.get_help_spec(ctx) == "-t, --times INTEGER"
+    assert opt.get_help_record(ctx) is None
