+def test_spec_is_longest_prefix_declaration(param_decls, kwargs, expected):
+    """The spec is the primary declaration with the longest prefix, the first
+    declared winning a tie. With no primary declaration it is the name.
+    """
+    assert click.Option(param_decls, **kwargs).spec == expected
+
