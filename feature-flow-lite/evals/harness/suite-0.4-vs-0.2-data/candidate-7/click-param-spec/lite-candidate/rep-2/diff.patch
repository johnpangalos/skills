+def _reference_argument_metavar(arg):
+    """The argument help text as 8.5.1 builds it for a plain string argument."""
+    if arg.metavar is not None:
+        return arg.metavar
+
+    text = arg.name.upper()
+
+    if not arg.required:
+        text = f"[{text}]"
+
+    if arg.nargs != 1:
+        text += "..."
+
+    return text
+
