+def _reference_help_spec(opt, ctx):
+    """``Option.get_help_spec`` as shipped in 8.5.1, kept verbatim as the oracle."""
+    from click.formatting import join_options
+
+    any_prefix_is_slash = False
+
+    def _write_opts(opts):
+        nonlocal any_prefix_is_slash
+
+        rv, any_slashes = join_options(opts)
+
+        if any_slashes:
+            any_prefix_is_slash = True
+
+        if not opt.is_flag and not opt.count:
+            rv += f" {opt.make_metavar(ctx=ctx)}"
+
+        return rv
+
+    rv = [_write_opts(opt.opts)]
+
+    if opt.secondary_opts:
+        rv.append(_write_opts(opt.secondary_opts))
+
+    return ("; " if any_prefix_is_slash else " / ").join(rv)
+
+
+def _longest_prefix_spelling(opt):
+    spellings = opt.opts or opt.secondary_opts
+    return sorted(spellings, key=lambda s: -len(click.parser._split_opt(s)[0]))[0]
+
+
+def _random_option_decls(rng):
+    """Declarations over every prefix shape, with pairs, ties and secondary-only
+    entries. Each set has at least one primary spelling so a name can be derived.
+    """
+
+    def flag():
+        prefix = rng.choice(["-", "--", "+", "/", "++"])
+        body = "o" + "".join(rng.choice("abc-09") for _ in range(rng.randint(0, 4)))
+        return prefix + body
+
+    decls = [flag()]
+
+    for _ in range(rng.randint(0, 2)):
+        kind = rng.choice(["single", "pair", "secondary"])
+
+        if kind == "single":
+            decl = flag()
+        elif kind == "pair":
+            first, second = flag(), flag()
+            if first == second:
+                continue
+            sep = ";" if first.startswith("/") else "/"
+            decl = f"{first}{sep}{second}"
+        else:
+            decl = f" /{flag()}"
+
+        if decl not in decls:
+            decls.append(decl)
+
+    return decls
+
+
+def test_option_spec_and_help_match_reference_over_random_declarations():
+    rng = random.Random(8601)
+    ctx = click.Context(click.Command("cli"))
+
+    for _ in range(1000):
+        decls = _random_option_decls(rng)
+        has_pair = any("/" in d[1:] or ";" in d for d in decls)
+        is_flag = has_pair or rng.random() < 0.3
+        opt = Option(decls, is_flag=is_flag, hidden=rng.random() < 0.2)
+
+        assert opt.spec == _longest_prefix_spelling(opt), decls
+        assert opt.get_help_spec(ctx) == _reference_help_spec(opt, ctx), decls
+
+        record = opt.get_help_record(ctx)
+
+        if opt.hidden:
+            assert record is None, decls
+        else:
+            assert record[0] == _reference_help_spec(opt, ctx), decls
+
