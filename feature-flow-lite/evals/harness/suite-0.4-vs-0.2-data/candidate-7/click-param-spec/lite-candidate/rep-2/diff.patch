+        arg = click.Argument(
+            [name],
+            required=rng.random() < 0.5,
+            nargs=rng.choice([1, 2, -1]),
+            metavar=metavar,
+        )
+        expected = _reference_argument_metavar(arg)
+
+        assert arg.spec == (metavar if metavar is not None else arg.name.upper()), name
