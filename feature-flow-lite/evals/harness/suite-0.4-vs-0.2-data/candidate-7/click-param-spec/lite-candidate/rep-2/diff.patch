+def _class_creation_stacklevel() -> int:
+    """Stack level of the frame that created the class whose ``__init_subclass__``
+    is running. Skips ``__init_subclass__`` and ``__new__`` frames (metaclasses
+    and ``super().__init_subclass__()`` chains) and ``types.new_class``. Call it
+    from ``__init_subclass__``.
+
+    .. versionadded:: 8.6.0
+    """
+    # Level 1 is the __init_subclass__ frame that called this function.
+    frame: FrameType = sys._getframe(1)
+    level = 1
+
+    while frame.f_back is not None:
+        caller = frame.f_back
+        code = caller.f_code
+        skipped = code.co_name in ("__init_subclass__", "__new__") or (
+            code.co_name == "new_class" and caller.f_globals.get("__name__") == "types"
+        )
+
+        if not skipped:
+            return level + 1
+
+        frame = caller
+        level += 1
+
+    return level
+
