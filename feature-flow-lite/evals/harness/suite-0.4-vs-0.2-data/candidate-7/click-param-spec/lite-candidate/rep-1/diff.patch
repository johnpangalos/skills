+    assert result.exit_code == 2
+    assert result.output.splitlines()[-1] == "Error: Missing option '--no-name'."
+
+
+def test_option_survives_deepcopy_and_pickle():
+    opt = click.Option(["-t", "--times"], type=int)
+
+    for clone in (copy.deepcopy(opt), pickle.loads(pickle.dumps(opt))):
+        assert clone.spec == "--times"
+        assert clone.opts == ["-t", "--times"]
+
+
+def test_overridden_spec_used_in_hint_for_secondary_only_option():
+    class Named(click.Option):
+        @property
+        def spec(self) -> str:
+            return "--custom"
+
+    assert Named(["name", " /--no-name"]).get_error_hint(None) == "'--custom'"
+
+
+def test_overridden_spec_used_in_deprecated_required_error():
+    class Named(click.Option):
+        @property
+        def spec(self) -> str:
+            return "--custom"
+
+    with pytest.raises(
+        ValueError, match="The option '--custom' is deprecated and still required"
+    ):
+        Named(["--a"], required=True, deprecated=True)
+
