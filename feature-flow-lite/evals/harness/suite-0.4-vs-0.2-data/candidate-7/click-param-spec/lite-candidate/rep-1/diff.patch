+def test_spec_is_empty_when_subclass_parses_no_name():
+    class NoNameOpt(click.Option):
+        def _parse_decls(self, decls, expose_value):
+            return None, [], []
+
+    assert NoNameOpt(["--zz"]).spec == ""
