+def _discount_row(cart):
+    """Discount line, shown as a minus amount unless it is zero."""
+    amount = cart.discount()
+    sign = "-" if amount > 0 else ""
+    return _line(f"Discount ({cart.code})", sign + format_money(amount))
+
