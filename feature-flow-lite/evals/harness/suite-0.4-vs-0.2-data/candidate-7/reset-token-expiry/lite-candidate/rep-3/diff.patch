+    issue_reset_token,
+    redeem_reset_token,
+)
+
+
+class _SlowRecord(dict):
+    # Sleeps on the "used" read, so that without _LOCK every thread sees
+    # used=False before any thread writes used=True (the GIL alone hides this).
+    def __getitem__(self, key):
+        value = super().__getitem__(key)
+        if key == "used":
+            time.sleep(0.01)
+        return value
+
+
+class _SlowTokenStore(dict):
+    def __setitem__(self, key, value):
+        super().__setitem__(key, _SlowRecord(value))
 
 
