+def _as_timestamp(now):
+    """Return now as a float.
+
+    Raises TypeError unless now is an int or float (bool excluded), and
+    ValueError if it is NaN, infinite or too large for a float.
+    """
+    if isinstance(now, bool) or not isinstance(now, (int, float)):
+        raise TypeError("now must be an int or float timestamp")
+    try:
+        value = float(now)
+    except OverflowError:
+        raise ValueError("now must be a finite timestamp") from None
+    if not math.isfinite(value):
+        raise ValueError("now must be a finite timestamp")
+    return value
+
