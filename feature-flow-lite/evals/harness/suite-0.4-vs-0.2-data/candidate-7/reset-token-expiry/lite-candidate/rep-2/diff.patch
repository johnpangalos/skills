     return token
 
 
-def redeem_reset_token(token):
-    """Return the username a token was issued for."""
-    username = _TOKENS.get(token)
-    if username is None:
-        raise InvalidToken("unknown token")
-    return username
+def redeem_reset_token(token, now=None):
+    """Return the username a token was issued for.
+
+    now is a Unix timestamp in seconds; None means time.time(). A token
+    expires 30 minutes (1800 seconds) after issue (TokenExpired) and can be
+    redeemed only once (TokenUsed). A non-numeric now raises TypeError; a
+    non-finite or out-of-range one raises ValueError. Neither consumes the token.
+    """
+    if now is None:
+        now = time.time()
+    now = _as_timestamp(now)
+    with _LOCK:
+        record = _TOKENS.get(token)
+        if record is None:
+            raise InvalidToken("unknown token")
+        username, issued_at, used = record
+        if used:
+            raise TokenUsed("token already used")
+        if now - issued_at > TTL_SECONDS:
+            raise TokenExpired("token expired")
+        _TOKENS[token] = (username, issued_at, True)
+        return username
