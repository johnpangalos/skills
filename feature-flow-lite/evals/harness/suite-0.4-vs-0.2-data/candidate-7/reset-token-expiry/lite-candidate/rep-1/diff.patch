+class SlowRecord(dict):
+    # Reading "used" is the check in redeem_reset_token; sleeping there widens
+    # the window before the write, so without the lock several threads pass it.
+    def __getitem__(self, key):
+        value = super().__getitem__(key)
+        if key == "used":
+            time.sleep(0.0015)
+        return value
+
+
+class SlowDict(dict):
+    def __setitem__(self, key, record):
+        super().__setitem__(key, SlowRecord(record))
+
+
+class ConcurrentRedeemTest(unittest.TestCase):
+    THREADS = 8
+    ROUNDS = 25
+
+    def test_exactly_one_winner_per_token_every_round(self):
+        with mock.patch("shop.auth._TOKENS", SlowDict()):
+            for round_no in range(self.ROUNDS):
+                token = issue_reset_token("ada", now=1000)
+                barrier = threading.Barrier(self.THREADS)
+                outcomes = []
+
+                def attempt():
+                    barrier.wait()
+                    try:
+                        outcomes.append(redeem_reset_token(token, now=1000))
+                    except TokenUsed:
+                        outcomes.append("used")
+
+                threads = [threading.Thread(target=attempt) for _ in range(self.THREADS)]
+                for thread in threads:
+                    thread.start()
+                for thread in threads:
+                    thread.join()
+
+                wins = [o for o in outcomes if o == "ada"]
+                losses = [o for o in outcomes if o == "used"]
+                self.assertEqual(len(wins), 1, f"round {round_no}")
+                self.assertEqual(len(losses), self.THREADS - 1, f"round {round_no}")
