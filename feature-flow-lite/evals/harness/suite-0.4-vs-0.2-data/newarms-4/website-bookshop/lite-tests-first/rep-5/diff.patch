+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Visit us | Marginalia Books</title>
+  <meta name="description" content="Opening hours, address, phone, email, directions and step-free access for Marginalia Books, plus a contact form.">
+  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='3' fill='%238a2d1c'/%3E%3C/svg%3E">
+  <link rel="stylesheet" href="css/styles.css">
+  <script type="module" src="js/main.js"></script>
+  <script type="module" src="js/visit.js"></script>
+</head>
+<body>
+  <a class="skip-link" href="#main">Skip to main content</a>
+  <header class="site-header">
+    <div class="site-header-inner">
+      <a class="brand" href="index.html">Marginalia Books</a>
+      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
+      <nav id="site-nav" class="site-nav" aria-label="Main">
+        <ul>
+          <li><a href="index.html">Home</a></li>
+          <li><a href="books.html">Books</a></li>
+          <li><a href="events.html">Events</a></li>
+          <li><a href="visit.html" class="is-current" aria-current="page">Visit</a></li>
+        </ul>
+      </nav>
+    </div>
+  </header>
+
+  <main id="main" tabindex="-1">
+    <h1>Visit the shop</h1>
+    <p class="lead">We are a few minutes' walk from the market square, with a reading room on the ground floor and a kettle that is always on.</p>
+
+    <section class="section" aria-labelledby="hours-heading">
+      <h2 id="hours-heading">Opening hours</h2>
+      <div class="table-wrap">
+        <table class="hours-table">
+          <caption>Our regular opening hours</caption>
+          <thead>
+            <tr>
+              <th scope="col">Day</th>
+              <th scope="col">Hours</th>
+            </tr>
+          </thead>
+          <tbody>
+            <tr><th scope="row">Monday</th><td>10:00am to 6:00pm</td></tr>
+            <tr><th scope="row">Tuesday</th><td>10:00am to 6:00pm</td></tr>
+            <tr><th scope="row">Wednesday</th><td>10:00am to 8:00pm</td></tr>
+            <tr><th scope="row">Thursday</th><td>10:00am to 8:00pm</td></tr>
+            <tr><th scope="row">Friday</th><td>10:00am to 6:00pm</td></tr>
+            <tr><th scope="row">Saturday</th><td>9:30am to 5:30pm</td></tr>
+            <tr><th scope="row">Sunday</th><td>11:00am to 4:00pm</td></tr>
+          </tbody>
+        </table>
+      </div>
+    </section>
+
+    <section class="section" aria-labelledby="find-heading">
+      <h2 id="find-heading">Find us</h2>
+      <address class="address">
+        Marginalia Books<br>
+        14 Quill Lane<br>
+        Hartsbridge<br>
+        HB4 2LN
+      </address>
+      <ul class="contact-list">
+        <li>Phone: <a href="tel:+442079460123">020 7946 0123</a></li>
+        <li>Email: <a href="mailto:hello@marginalia-books.example">hello@marginalia-books.example</a></li>
+      </ul>
+    </section>
+
