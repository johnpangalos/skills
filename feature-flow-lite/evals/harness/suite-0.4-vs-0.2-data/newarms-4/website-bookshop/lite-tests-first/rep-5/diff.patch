+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Books | Marginalia Books</title>
+  <meta name="description" content="Browse the Marginalia Books catalogue by genre: mystery, literary fiction, science fiction, young readers, poetry and history.">
+  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='3' fill='%238a2d1c'/%3E%3C/svg%3E">
