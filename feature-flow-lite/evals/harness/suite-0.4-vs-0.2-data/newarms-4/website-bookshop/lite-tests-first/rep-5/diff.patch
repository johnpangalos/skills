+/* Marginalia Books: one stylesheet shared by every page. */
+
+:root {
+  --paper: #fbf6ee;
+  --card: #fffdf9;
+  --ink: #2b2118;
+  --ink-soft: #5b4b3e;
+  --link: #8a2d1c;
+  --link-hover: #6e2214;
+  --forest: #23352b;
+  --gold: #f2c15c;
+  --ochre: #b7791f;
+  --error: #9b1c1c;
+  --focus: #2b2118;
+  --rule: #e4d8c6;
+  --field-border: #8c7b6b;
+  --serif: "Iowan Old Style", "Palatino Linotype", Palatino, "Book Antiqua", Georgia, serif;
+  --sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
+}
+
+*, *::before, *::after {
+  box-sizing: border-box;
+}
+
+body {
+  margin: 0;
+  display: flex;
+  flex-direction: column;
+  min-height: 100vh;
+  background: var(--paper);
+  color: var(--ink);
+  font-family: var(--serif);
+  font-size: 1.125rem;
+  line-height: 1.6;
+  overflow-wrap: anywhere;
+}
+
+h1, h2, h3 {
+  margin: 0 0 0.5em;
+  color: var(--ink);
+  line-height: 1.2;
+}
+
+h1 {
+  font-size: clamp(2rem, 6vw, 3.25rem);
+  letter-spacing: -0.01em;
+}
+
+h2 {
+  font-size: clamp(1.5rem, 4vw, 2rem);
+}
+
+h3 {
+  font-size: 1.25rem;
+}
+
+p {
+  max-width: 68ch;
+  margin: 0 0 1em;
+}
+
+a {
+  color: var(--link);
+  text-decoration-thickness: 1px;
+  text-underline-offset: 0.2em;
+}
+
+a:hover {
+  text-decoration-thickness: 2px;
+}
+
+:focus-visible {
+  outline: 3px solid var(--focus);
+  outline-offset: 3px;
+}
+
+/* Skip link: parked off-screen until it receives focus. */
+.skip-link {
+  position: absolute;
+  top: -10rem;
+  left: 1rem;
+  z-index: 10;
+  padding: 0.75rem 1rem;
+  border-radius: 4px;
+  background: var(--ink);
+  color: var(--paper);
+  font-family: var(--sans);
+  font-weight: 700;
+  text-decoration: none;
+}
+
+.skip-link:focus {
+  top: 1rem;
+}
+
+/* Page width: the header, main content and footer share one measure. */
+main,
+.site-header-inner,
+.site-footer-inner {
+  width: min(100% - 2rem, 68rem);
+  margin-inline: auto;
+}
+
+/* Header and navigation */
+.site-header {
+  background: var(--forest);
+  color: var(--paper);
+}
+
+.site-header-inner {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0.5rem 1rem;
+  padding-block: 0.5rem;
+}
+
+.site-header :focus-visible,
+.site-footer :focus-visible {
+  outline-color: var(--gold);
+}
+
+.brand {
+  display: inline-flex;
+  align-items: center;
+  min-height: 44px;
+  color: var(--paper);
+  font-weight: 700;
+  font-size: 1.35rem;
+  text-decoration: none;
+}
+
+.nav-toggle {
+  display: none;
+  align-items: center;
+  min-width: 44px;
+  min-height: 44px;
+  padding: 0.5rem 1rem;
+  border: 2px solid var(--paper);
+  border-radius: 999px;
+  background: transparent;
+  color: var(--paper);
+  font: inherit;
+  font-family: var(--sans);
+  cursor: pointer;
+}
+
+.site-nav ul {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.25rem;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.site-nav a {
+  display: flex;
+  align-items: center;
+  min-height: 44px;
+  padding: 0.5rem 0.85rem;
+  border-radius: 4px;
+  color: var(--paper);
+  font-family: var(--sans);
+  text-decoration: none;
+}
+
+.site-nav a:hover {
+  background: rgb(255 255 255 / 0.08);
+}
+
+/* The current page is underlined and bold so it reads without colour. */
+.site-nav a.is-current {
+  font-weight: 700;
+  text-decoration: underline;
+  text-decoration-color: var(--gold);
+  text-decoration-thickness: 2px;
+  text-underline-offset: 0.35em;
+}
+
+@media (max-width: 700px) {
+  .nav-toggle {
+    display: inline-flex;
+  }
+
+  .site-nav {
+    display: none;
+    flex-basis: 100%;
+  }
+
+  .site-nav.is-open {
+    display: block;
+  }
+
+  .site-nav ul {
+    flex-direction: column;
+    gap: 0;
+    padding-block: 0.5rem;
+  }
+}
+
+/* Layout */
+main {
+  flex: 1;
+  padding-block: 2.5rem 4rem;
+}
+
+.lead {
+  color: var(--ink-soft);
+  font-size: 1.25rem;
+}
+
+.eyebrow {
+  color: var(--ink-soft);
+  font-family: var(--sans);
+  font-size: 0.85rem;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+}
+
+.section {
+  padding-block: 2rem;
+  border-top: 1px solid var(--rule);
+}
+
+/* Buttons and links styled as buttons */
+.button {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-height: 44px;
+  padding: 0.6rem 1.25rem;
+  border: 2px solid var(--link);
+  border-radius: 999px;
+  background: var(--link);
+  color: var(--paper);
+  font: inherit;
+  font-family: var(--sans);
+  font-weight: 700;
+  text-decoration: none;
+  cursor: pointer;
+  transition: background-color 0.2s ease, color 0.2s ease;
+}
+
+.button:hover {
+  background: var(--link-hover);
+  border-color: var(--link-hover);
+}
+
+.button-quiet {
+  background: transparent;
+  color: var(--link);
+}
+
+.button-quiet:hover {
+  background: var(--card);
+  color: var(--link-hover);
+}
+
+/* Home */
+.hero {
+  display: grid;
+  gap: 2rem;
+  align-items: center;
+  padding-block: 1rem 2rem;
+}
+
+.hero-text {
+  min-width: 0;
+}
+
+.hero-actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.75rem;
+}
+
+.hero-art {
+  width: min(100%, 15rem);
+  height: auto;
+  justify-self: center;
+}
+
+@media (min-width: 760px) {
+  .hero {
+    grid-template-columns: 1.3fr 1fr;
+  }
+}
+
+.cards {
+  display: grid;
+  gap: 1.25rem;
+  grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
+}
+
+.card {
+  min-width: 0;
+  padding: 1.25rem;
+  border: 1px solid var(--rule);
+  border-radius: 6px;
+  background: var(--card);
+}
+
+.plain {
+  margin: 0 0 1em;
+  padding: 0;
+  list-style: none;
+}
+
+.plain li {
+  padding-block: 0.35rem;
+}
+
+/* Books */
+.genre-filter {
+  min-width: 0;
+  margin: 0 0 1.5rem;
+  padding: 0;
+  border: 0;
+}
+
+.genre-filter legend {
+  margin-bottom: 0.5rem;
+  padding: 0;
+  font-family: var(--sans);
+  font-size: 0.95rem;
+  font-weight: 700;
+}
+
+.genre-buttons {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.5rem;
+}
+
+.genre-button {
+  min-height: 44px;
+  padding: 0.5rem 1rem;
+  border: 2px solid var(--link);
+  border-radius: 999px;
+  background: var(--card);
+  color: var(--ink);
+  font: inherit;
+  font-family: var(--sans);
+  cursor: pointer;
+  transition: background-color 0.2s ease, color 0.2s ease;
+}
+
+.genre-button:hover {
+  background: #f3e7d6;
+}
+
+.genre-button[aria-pressed="true"] {
+  background: var(--link);
+  color: var(--paper);
+}
+
+.result-count {
+  margin-bottom: 1rem;
+  color: var(--ink-soft);
+  font-family: var(--sans);
+  font-size: 0.95rem;
+}
+
+.book-list {
+  display: grid;
+  gap: 1.25rem;
+  grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.book {
+  display: flex;
+  flex-direction: column;
+  height: 100%;
+  min-width: 0;
+  padding: 1.25rem;
+  border: 1px solid var(--rule);
+  border-radius: 6px;
+  background: var(--card);
+}
+
+.book h2 {
+  font-size: 1.3rem;
+}
+
+.book-author {
+  margin-bottom: 0.5rem;
+  color: var(--ink-soft);
+  font-style: italic;
+}
+
+.book-genre {
+  margin-bottom: 0.5rem;
+  color: var(--link);
+  font-family: var(--sans);
+  font-size: 0.8rem;
+  font-weight: 700;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+}
+
+.book-description {
+  font-size: 1rem;
+}
+
+.book-price {
+  margin: auto 0 0;
+  font-family: var(--sans);
+  font-weight: 700;
+}
+
+/* Events */
+.event-list {
+  display: grid;
+  gap: 1.25rem;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.event {
+  min-width: 0;
+  padding: 1.25rem 1.5rem;
+  border-left: 6px solid var(--ochre);
+  border-radius: 6px;
+  background: var(--card);
+}
+
+.event-when {
+  color: var(--ink-soft);
+  font-family: var(--sans);
+  font-weight: 700;
+}
+
+.event-booking {
+  margin: 0;
+  font-family: var(--sans);
+  font-size: 0.9rem;
+  font-weight: 700;
+}
+
+/* Visit */
+.table-wrap {
+  max-width: 100%;
+  overflow-x: auto;
+}
+
+.hours-table {
+  width: 100%;
+  max-width: 30rem;
+  border-collapse: collapse;
+  background: var(--card);
+  font-family: var(--sans);
+}
+
+.hours-table caption {
+  padding-bottom: 0.5rem;
+  text-align: left;
+  font-family: var(--serif);
+  font-size: 1.1rem;
+  font-weight: 700;
+}
+
+.hours-table th,
+.hours-table td {
+  padding: 0.6rem 0.75rem;
+  border-bottom: 1px solid var(--rule);
+  text-align: left;
+}
+
+.hours-table thead th {
+  color: var(--ink-soft);
+  font-size: 0.9rem;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+}
+
+.address {
+  margin-bottom: 1rem;
+  font-style: normal;
+}
+
+.contact-list {
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.contact-list li {
+  padding-block: 0.25rem;
+}
+
+.contact-form {
+  max-width: 36rem;
+  padding: 1.5rem;
+  border: 1px solid var(--rule);
+  border-radius: 6px;
+  background: var(--card);
+}
+
+.field {
+  margin-bottom: 1.25rem;
+}
+
+.field label {
+  display: block;
+  margin-bottom: 0.35rem;
+  font-family: var(--sans);
+  font-weight: 700;
+}
+
+.required-mark {
+  color: var(--ink-soft);
+  font-size: 0.9em;
+  font-weight: 400;
+}
+
+.hint {
+  margin-bottom: 0.35rem;
+  color: var(--ink-soft);
+  font-family: var(--sans);
+  font-size: 0.9rem;
+}
+
+input,
+select,
+textarea {
+  width: 100%;
+  min-height: 44px;
+  padding: 0.55rem 0.75rem;
+  border: 2px solid var(--field-border);
+  border-radius: 4px;
+  background: #ffffff;
+  color: var(--ink);
+  font: inherit;
+}
+
+textarea {
+  min-height: 8rem;
+  resize: vertical;
+}
+
+[aria-invalid="true"] {
+  border-color: var(--error);
+}
+
+.field-error {
+  margin: 0.35rem 0 0;
+  color: var(--error);
+  font-family: var(--sans);
+  font-weight: 700;
+}
+
+.form-summary {
+  margin: 0 0 1rem;
+  color: var(--error);
+  font-family: var(--sans);
+  font-weight: 700;
+}
+
+.form-summary:empty {
+  margin: 0;
+}
+
+.contact-form .button {
+  margin-top: 0.5rem;
+}
+
+.form-status {
+  margin-top: 1.25rem;
+  font-family: var(--sans);
+}
+
+.form-status:not(:empty) {
+  padding: 1rem;
+  border-left: 6px solid var(--forest);
+  background: #eef3ee;
+}
+
+/* Footer */
+.site-footer {
+  background: var(--forest);
+  color: var(--paper);
+}
+
+.site-footer-inner {
+  padding-block: 2rem;
+}
+
+.site-footer p {
+  margin-bottom: 0.5rem;
+}
+
+.site-footer a {
+  color: var(--gold);
+}
+
+/* Users who ask for less motion get no transitions or animation. */
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    transition: none !important;
+    animation: none !important;
+    scroll-behavior: auto !important;
+  }
+}
