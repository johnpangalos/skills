+/*
+ * Marginalia Books. Warm paper, ink and terracotta.
+ *
+ * Contrast (WCAG 2.x, checked against the rendered pages in tests/accessibility.test.js):
+ *   --ink #2b2118 on --paper #fbf5ea          about 14:1
+ *   --muted #5b4a3c on --paper #fbf5ea        about 7.7:1
+ *   --accent #8a3416 on --paper #fbf5ea       about 7.4:1
+ *   --paper #fbf5ea on --accent #8a3416       about 7.4:1 (buttons)
+ *   --error #9b1c1c on --card #fffdf8         about 7.7:1
+ *   cover text --paper on each cover tone      7:1 or better
+ */
+
+:root {
+  --paper: #fbf5ea;
+  --card: #fffdf8;
+  --band: #efe2cc;
+  --header: #f3e8d6;
+  --ink: #2b2118;
+  --muted: #5b4a3c;
+  --accent: #8a3416;
+  --accent-hover: #6e2a11;
+  --error: #9b1c1c;
+  --line: #d9c7ac;
+  --field-border: #8c7a69;
+  --focus: #1d5c7a;
+  --footer: #2b2118;
+  --footer-text: #f6ead8;
+  --footer-link: #f3c9a0;
+  --serif: Georgia, "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Palatino, serif;
+  --sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
+}
+
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+
+[hidden] {
+  display: none !important;
+}
+
+html {
+  -webkit-text-size-adjust: 100%;
+}
+
+body {
+  margin: 0;
+  background: var(--paper);
+  color: var(--ink);
+  font-family: var(--sans);
+  font-size: 1rem;
+  line-height: 1.6;
+}
+
+h1,
+h2,
+h3 {
+  font-family: var(--serif);
+  line-height: 1.2;
+  color: var(--ink);
+}
+
+h1 {
+  font-size: clamp(2rem, 5vw, 2.75rem);
+  margin: 0 0 1rem;
+}
+
+h2 {
+  font-size: 1.6rem;
+  margin: 0 0 0.75rem;
+}
+
+h3 {
+  font-size: 1.25rem;
+  margin: 0 0 0.25rem;
+}
+
+p {
+  margin: 0 0 1rem;
+}
+
+a {
+  color: var(--accent);
+}
+
+.wrap {
+  max-width: 70rem;
+  margin: 0 auto;
+  padding: 0 1rem;
+}
+
+section {
+  margin: 0 0 3rem;
+}
+
+/* Skip link: off-screen until focused. */
+.skip-link {
+  position: absolute;
+  left: 1rem;
+  top: -4rem;
+  z-index: 10;
+  padding: 0.5rem 1rem;
+  background: var(--ink);
+  color: var(--paper);
+  font-weight: 700;
+  text-decoration: none;
+}
+
+.skip-link:focus {
+  top: 1rem;
+}
+
+main:focus {
+  outline: none;
+}
+
+:focus-visible {
+  outline: 3px solid var(--focus);
+  outline-offset: 3px;
+}
+
+/* Header and nav. Links wrap onto a second line when space runs out. */
+.site-header {
+  background: var(--header);
+  border-bottom: 1px solid var(--line);
+  padding: 1rem 0;
+}
+
+.site-header .wrap {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0.5rem 1.5rem;
+}
+
+.brand {
+  font-family: var(--serif);
+  font-size: 1.5rem;
+  font-weight: 700;
+  color: var(--ink);
+  text-decoration: none;
+  min-height: 2.5rem;
+  display: inline-flex;
+  align-items: center;
+}
+
+.nav-list {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.25rem 1rem;
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.nav-list a {
+  display: inline-flex;
+  align-items: center;
+  min-height: 2.5rem;
+  padding: 0.25rem;
+  color: var(--ink);
+  text-decoration: none;
+  border-bottom: 2px solid transparent;
+}
+
+.nav-list a:hover {
+  border-bottom-color: var(--accent);
+}
+
+.nav-list a[aria-current="page"] {
+  font-weight: 700;
+  border-bottom-color: var(--accent);
+}
+
+/* Hero and home sections. */
+.hero {
+  background: var(--band);
+  border-bottom: 1px solid var(--line);
+  padding: 3rem 0 2.5rem;
+}
+
+.hero .lede {
+  max-width: 40rem;
+  font-size: 1.125rem;
+  color: var(--muted);
+}
+
+.eyebrow {
+  margin: 0 0 0.5rem;
+  font-size: 0.875rem;
+  font-weight: 700;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: var(--muted);
+}
+
+.button {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-height: 2.75rem;
+  margin: 0 0.5rem 0.5rem 0;
+  padding: 0.5rem 1.25rem;
+  border: 0;
+  border-radius: 999px;
+  background: var(--accent);
+  color: var(--paper);
+  font: inherit;
+  font-weight: 700;
+  text-decoration: none;
+  cursor: pointer;
+  transition: background-color 0.2s ease;
+}
+
+.button:hover {
+  background: var(--accent-hover);
+}
+
+.button-quiet {
+  background: transparent;
+  color: var(--accent);
+  box-shadow: inset 0 0 0 2px var(--accent);
+}
+
+.button-quiet:hover {
+  background: var(--card);
+}
+
+.pick-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
+  gap: 1.25rem;
+}
+
+.pick {
+  margin: 0;
+  padding: 1.25rem;
+  background: var(--card);
+  border: 1px solid var(--line);
+  border-radius: 0.5rem;
+}
+
+.pick .author {
+  color: var(--muted);
+}
+
+.pick a {
+  font-weight: 700;
+}
+
+.event-teaser,
+.visit-teaser {
+  padding: 1.5rem;
+  background: var(--card);
+  border: 1px solid var(--line);
+  border-radius: 0.5rem;
+}
+
+/* Books page. */
+.page-intro {
+  max-width: 40rem;
+  margin: 2.5rem 0 1.5rem;
+}
+
+.page-intro p {
+  color: var(--muted);
+}
+
+.genre-filter {
+  margin: 0 0 1rem;
+  padding: 0;
+  border: 0;
+  min-width: 0;
+}
+
+.genre-filter legend {
+  padding: 0;
+  margin: 0 0 0.5rem;
+  font-weight: 700;
+}
+
+.chip-group {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.5rem;
+}
+
+.chip {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.5rem;
+  min-height: 2.75rem;
+  padding: 0.25rem 0.9rem;
+  border: 1px solid var(--field-border);
+  border-radius: 999px;
+  background: var(--card);
+  cursor: pointer;
+}
+
+.chip input {
+  width: 1.5rem;
+  height: 1.5rem;
+  margin: 0;
+  accent-color: var(--accent);
+}
+
+.chip:has(input:checked) {
+  background: var(--accent);
+  border-color: var(--accent);
+  color: var(--paper);
+}
+
+.result-count {
+  margin: 0 0 1.5rem;
+  font-weight: 700;
+}
+
+.no-results {
+  padding: 1.5rem;
+  background: var(--card);
+  border: 1px dashed var(--field-border);
+  border-radius: 0.5rem;
+}
+
+.book-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
+  gap: 1.75rem;
+  list-style: none;
+  margin: 0 0 3rem;
+  padding: 0;
+}
+
+.book-card {
+  display: flex;
+  flex-direction: column;
+  gap: 0.75rem;
+  height: 100%;
+}
+
+.cover {
+  aspect-ratio: 2 / 3;
+  display: flex;
+  align-items: flex-end;
+  padding: 1rem;
+  border-radius: 0.25rem 0.75rem 0.75rem 0.25rem;
+  box-shadow: inset 0.5rem 0 0 rgba(0, 0, 0, 0.18);
+  color: var(--paper);
+  font-family: var(--serif);
+  font-size: 1.2rem;
+  font-weight: 700;
+  line-height: 1.2;
+  overflow-wrap: anywhere;
+}
+
+.cover--ink { background: #2e3b44; }
+.cover--navy { background: #1d2e4a; }
+.cover--plum { background: #4a2545; }
+.cover--moss { background: #2f4a2a; }
+.cover--rust { background: #7a3018; }
+
+.book-body .meta {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: space-between;
+  gap: 0.25rem 1rem;
+  margin: 0 0 0.25rem;
+  font-size: 0.875rem;
+  color: var(--muted);
+}
+
+.book-body .price {
+  font-weight: 700;
+  color: var(--ink);
+}
+
+.book-title {
+  font-size: 1.2rem;
+  margin: 0 0 0.25rem;
+}
+
+.book-body .author {
+  margin: 0 0 0.5rem;
+  color: var(--muted);
+}
+
+.book-body .blurb {
+  margin: 0;
+}
+
+/* Events page. */
+.event-list {
+  display: grid;
+  gap: 1.25rem;
+  list-style: none;
+  margin: 0 0 3rem;
+  padding: 0;
+}
+
+.event {
+  margin: 0;
+  padding: 1.25rem 1.5rem;
+  background: var(--card);
+  border-left: 0.3rem solid var(--accent);
+  border-radius: 0.5rem;
+}
+
+.event-meta {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.5rem 1rem;
+  align-items: center;
+  margin-bottom: 0.5rem;
+  color: var(--muted);
+}
+
+.access {
+  display: inline-block;
+  padding: 0.1rem 0.6rem;
+  border-radius: 999px;
+  font-size: 0.875rem;
+  font-weight: 700;
+}
+
+.access-free {
+  background: #e6efe0;
+  color: #2f4a2a;
+}
+
+.access-ticketed {
+  background: #f3e3d4;
+  color: #7a3018;
+}
+
+/* Visit page. */
+.hours {
+  width: 100%;
+  max-width: 32rem;
+  border-collapse: collapse;
+  margin: 0 0 2rem;
+}
+
+.hours th,
+.hours td {
+  padding: 0.6rem 0.5rem;
+  border-bottom: 1px solid var(--line);
+  text-align: left;
+}
+
+address {
+  font-style: normal;
+  margin: 0 0 1.5rem;
+}
+
+.contact-form {
+  max-width: 40rem;
+  padding: 1.5rem;
+  background: var(--card);
+  border: 1px solid var(--line);
+  border-radius: 0.5rem;
+}
+
+.field {
+  display: grid;
+  gap: 0.35rem;
+  margin: 0 0 1.25rem;
+}
+
+.field label {
+  font-weight: 700;
+}
+
+.field input,
+.field textarea {
+  width: 100%;
+  max-width: 100%;
+  padding: 0.6rem 0.75rem;
+  border: 1px solid var(--field-border);
+  border-radius: 0.4rem;
+  background: var(--paper);
+  color: var(--ink);
+  font: inherit;
+  overflow-wrap: anywhere;
+}
+
+.field textarea {
+  min-height: 9rem;
+  resize: vertical;
+}
+
+.field [aria-invalid="true"] {
+  border: 2px solid var(--error);
+}
+
+.field-error {
+  margin: 0;
+  font-weight: 700;
+  color: var(--error);
+}
+
+.required-mark {
+  color: var(--error);
+}
+
+.form-note {
+  color: var(--muted);
+  font-size: 0.9rem;
+}
+
+.form-status {
+  margin: 1.25rem 0 0;
+}
+
+.form-status:not(:empty) {
+  padding: 0.75rem 1rem;
+  border-left: 0.3rem solid var(--accent);
+  background: var(--card);
+}
+
+/* Footer. */
+.site-footer {
+  margin-top: 3rem;
+  padding: 2rem 0;
+  background: var(--footer);
+  color: var(--footer-text);
+}
+
+.site-footer a {
+  color: var(--footer-link);
+  overflow-wrap: anywhere;
+}
+
+.site-footer p {
+  margin: 0 0 0.5rem;
+}
+
+/* Motion. Users who ask for less get no transitions or animations. */
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    transition: none !important;
+    animation: none !important;
+    scroll-behavior: auto !important;
+  }
+}
+
+/* Wider screens. */
+@media (min-width: 48rem) {
+  .hero {
+    padding: 4rem 0 3rem;
+  }
+}
