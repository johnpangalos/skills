+test('events page never labels anything "today" or "tomorrow"', async () => {
+  const { page } = await openPage(browser, server.origin, 'events.html');
+  const text = await page.evaluate(() => document.body.innerText);
+  assert.doesNotMatch(text, /\b(today|tomorrow)\b/i);
+});
