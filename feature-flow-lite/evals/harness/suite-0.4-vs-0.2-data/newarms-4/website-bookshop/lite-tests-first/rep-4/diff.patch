+});
+
+test('events page lists at least 4 events with title, time element, description and free/ticketed status', async () => {
+  const { page } = await openPage(browser, server.origin, 'events.html');
+  const events = await page.$$eval('article.event', (items) => items.map((item) => ({
+    title: item.querySelector('h2')?.textContent.trim() ?? '',
+    datetime: item.querySelector('time')?.getAttribute('datetime') ?? '',
+    when: item.querySelector('time')?.textContent.trim() ?? '',
+    description: item.querySelector('.event-description')?.textContent.trim() ?? '',
+    access: item.querySelector('.access')?.textContent.trim() ?? '',
+  })));
+  assert.ok(events.length >= 4, `expected at least 4 events, found ${events.length}`);
+  for (const event of events) {
+    assert.ok(event.title && event.description, `incomplete event: ${JSON.stringify(event)}`);
+    assert.match(event.datetime, /^2027-\d{2}-\d{2}T\d{2}:\d{2}$/, `datetime for ${event.title}`);
+    assert.match(event.access, /^(Free entry|Ticketed)\b/, `free/ticketed status for ${event.title}`);
+    const [date] = event.datetime.split('T');
