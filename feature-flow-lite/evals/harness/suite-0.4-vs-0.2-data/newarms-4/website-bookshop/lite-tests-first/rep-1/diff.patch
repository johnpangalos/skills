+test('c10 reduced motion removes transitions', async (ctx) => {
+  const normal = await withPage(ctx, 'index.html', {}, (s) =>
+    s.page.$eval('.site-nav a', (a) => getComputedStyle(a).transitionDuration),
+  );
+  assert.notEqual(normal, '0s', 'transition exists without the preference');
+  await withPage(ctx, 'index.html', { reducedMotion: 'reduce' }, async (s) => {
+    const durations = await s.page.$$eval('.site-nav a, .button', (els) =>
+      els.map((el) => getComputedStyle(el).transitionDuration),
+    );
+    assert.ok(durations.length > 0);
+    assert.ok(
+      durations.every((d) => d === '0s'),
+      `durations: ${durations}`,
+    );
+  });
+});
