+test('c10 no positive tabindex and every form control has an accessible name', async (ctx) => {
+  for (const path of PAGES) {
+    await withPage(ctx, path, {}, async (s) => {
+      const result = await s.page.evaluate(() => ({
+        positive: [...document.querySelectorAll('[tabindex]')]
+          .filter((el) => Number(el.getAttribute('tabindex')) > 0)
+          .map((el) => el.tagName),
+        unnamed: [
+          ...document.querySelectorAll(
+            'input:not([type="hidden"]), select, textarea',
+          ),
+        ]
+          .filter(
+            (el) =>
+              el.labels.length === 0 &&
+              !el.hasAttribute('aria-label') &&
+              !el.hasAttribute('aria-labelledby'),
+          )
+          .map((el) => el.id || el.name || el.tagName),
+      }));
+      assert.deepEqual(result.positive, [], `${path} positive tabindex`);
+      assert.deepEqual(result.unnamed, [], `${path} unnamed controls`);
+    });
+  }
+});
