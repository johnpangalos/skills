+test('c10 every keyboard stop shows a visible focus indicator', async (ctx) => {
+  for (const path of PAGES) {
+    await withPage(ctx, path, {}, async (s) => {
+      let checked = 0;
+      for (let i = 0; i < 60; i += 1) {
+        await s.page.keyboard.press('Tab');
+        const info = await s.page.evaluate(() => {
+          const el = document.activeElement;
+          if (!el || el === document.body) return null;
+          const style = getComputedStyle(el);
+          return {
+            name: el.tagName + (el.id ? `#${el.id}` : ''),
+            focusVisible: el.matches(':focus-visible'),
+            outlineStyle: style.outlineStyle,
+            outlineWidth: parseFloat(style.outlineWidth),
+          };
+        });
+        if (!info) break;
+        checked += 1;
+        assert.ok(
+          info.focusVisible &&
+            info.outlineStyle !== 'none' &&
+            info.outlineWidth >= 2,
+          `${path}: no visible focus on ${info.name}`,
+        );
+      }
+      assert.ok(checked >= 3, `${path}: only ${checked} keyboard stops`);
+    });
+  }
+});
+
+test('c10 text, link, nav and button colour pairs meet 4.5:1', async (ctx) => {
+  const checks = [
+    [
+      'index.html',
+      [
+        'main p',
+        'main p a',
+        'a.button',
+        '.site-nav a',
+        '.site-footer p',
+        '.brand',
+      ],
+    ],
+    [
+      'books.html',
+      [
+        '#genre-filter legend',
+        '#genre-filter label',
+        '.book-card p',
+        '.results-status',
+      ],
+    ],
+    ['visit.html', ['#contact-form button', 'label', '.hint', '.notice']],
+  ];
+  const report = [];
+  for (const [path, selectors] of checks) {
+    await withPage(ctx, path, {}, async (s) => {
+      const pairs = await s.page.evaluate(
+        (list) =>
+          list.map((selector) => {
+            const el = document.querySelector(selector);
+            if (!el) return { selector, missing: true };
+            let node = el;
+            let background = 'rgb(255, 255, 255)';
+            while (node) {
+              const bg = getComputedStyle(node).backgroundColor;
+              if (bg !== 'rgba(0, 0, 0, 0)' && bg !== 'transparent') {
+                background = bg;
+                break;
+              }
+              node = node.parentElement;
+            }
+            return {
+              selector,
+              color: getComputedStyle(el).color,
+              background,
+            };
+          }),
+        selectors,
+      );
+      for (const pair of pairs) {
+        assert.ok(!pair.missing, `${path}: ${pair.selector} not found`);
+        const ratio = contrastRatio(pair.color, pair.background);
+        assert.ok(
+          ratio >= 4.5,
+          `${path} ${pair.selector}: ${ratio.toFixed(2)}`,
+        );
+        report.push(`${pair.selector} ${ratio.toFixed(1)}`);
+      }
+    });
+  }
+  return report.join('; ');
+});
