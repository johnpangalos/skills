+test('c10 every image and SVG has alt text or is hidden from assistive tech', async (ctx) => {
+  for (const path of PAGES) {
+    await withPage(ctx, path, {}, async (s) => {
+      const media = await s.page.$$eval('img, svg', (els) =>
+        els.map(
+          (el) =>
+            el.getAttribute('aria-hidden') === 'true' ||
+            el.hasAttribute('alt') ||
+            el.hasAttribute('aria-label') ||
+            el.querySelector('title') !== null,
+        ),
+      );
+      assert.ok(media.length > 0, `${path}: no images or svgs found`);
+      assert.ok(media.every(Boolean), `${path}: unlabelled image or svg`);
+    });
+  }
+});
