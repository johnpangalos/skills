+  },
+  {
+    title: 'Fog on the Tidewater Stair',
+    author: 'Marisol Denning',
+    genre: 'Mystery',
+    price: 12.5,
+    description:
+      'A ferry inspector follows a missing lamplighter through a harbour town in mist.',
+  },
+  {
+    title: 'Nine Keys for Mrs Harrow',
+    author: 'Tobias Wren',
+    genre: 'Mystery',
+    price: 13,
+    description:
+      'Nine keys, one dinner party and a house where every door has a secret.',
+  },
+  {
+    title: 'Small Hours, Open Window',
+    author: 'Ines Calloway',
+    genre: 'Poetry',
+    price: 11,
