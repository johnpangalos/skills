+test('c13 prettier check passes for html, css, js and mjs', () => {
+  try {
+    execSync('npx --no-install prettier --check "**/*.{html,css,js,mjs}"', {
+      cwd: ROOT,
+      stdio: 'pipe',
+    });
+  } catch (error) {
+    const out = String(error.stderr || error.stdout || error.message);
+    throw new Error(out.split('\n').slice(0, 3).join(' | '));
+  }
+});
+
+// Runner
+const filter = process.argv[2];
+const server = await startServer();
+const browser = await chromium.launch({
+  executablePath: '/usr/bin/google-chrome',
+});
+const ctx = { browser, base: `http://127.0.0.1:${server.address().port}` };
+let ran = 0;
+let failures = 0;
+try {
+  for (const { name, fn } of tests) {
+    if (filter && !name.includes(filter)) continue;
+    ran += 1;
+    try {
+      const detail = await fn(ctx);
+      console.log(`PASS ${name}${detail ? ` (${detail})` : ''}`);
+    } catch (error) {
+      failures += 1;
+      console.log(`FAIL ${name}: ${String(error.message).split('\n')[0]}`);
+    }
+  }
+} finally {
+  await browser.close();
+  server.close();
+}
+if (ran === 0) {
+  console.log(`No tests match "${filter}"`);
+  process.exit(1);
+}
+console.log(`${ran - failures}/${ran} passed`);
+process.exit(failures ? 1 : 0);
