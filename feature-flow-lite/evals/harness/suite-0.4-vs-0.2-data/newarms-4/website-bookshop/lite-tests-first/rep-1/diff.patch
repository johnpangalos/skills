+:root {
+  --paper: #fbf6ec;
+  --card: #fffdf7;
+  --ink: #2b2118;
+  --muted: #5b4a3c;
+  --oxblood: #6e2f1a;
+  --oxblood-hover: #8a3d23;
+  --gold: #c9a24b;
+  --rule: #e3d5b8;
+  --panel: #f1e6d0;
+  --focus: #1f5f8b;
+  --focus-on-dark: #f2c94c;
+  --serif:
+    ui-serif, Georgia, Cambria, 'Iowan Old Style', 'Times New Roman', serif;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+body {
+  margin: 0;
+  background: var(--paper);
+  color: var(--ink);
+  font-family: var(--serif);
+  font-size: 1.0625rem;
+  line-height: 1.6;
+}
+
+h1,
+h2 {
+  color: var(--oxblood);
+  line-height: 1.2;
+}
+
+h1 {
+  margin: 0 0 1rem;
+  font-size: clamp(2rem, 6vw, 3rem);
+}
+
+h2 {
+  margin: 2rem 0 0.5rem;
+  font-size: 1.5rem;
+}
+
+a {
+  color: #7a3a1f;
+}
+
+:focus-visible {
+  outline: 3px solid var(--focus);
+  outline-offset: 2px;
+}
+
+main {
+  max-width: 64rem;
+  margin: 0 auto;
+  padding: 1.5rem 1rem 2rem;
+}
+
+main:focus {
+  outline: none;
+}
+
+.skip-link {
+  position: absolute;
+  top: -4rem;
+  left: 0.5rem;
+  z-index: 10;
+  padding: 0.6rem 1rem;
+  background: var(--ink);
+  color: var(--card);
+}
+
+.skip-link:focus {
+  top: 0.5rem;
+}
+
+/* Header and navigation */
+
+.site-header {
+  background: var(--ink);
+  color: var(--paper);
+}
+
+.site-header :focus-visible {
+  outline-color: var(--focus-on-dark);
+}
+
+.site-header-inner {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  max-width: 64rem;
+  margin: 0 auto;
+  padding: 0.5rem 1rem;
+}
+
+.brand {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.5rem;
+  min-height: 44px;
+  color: var(--paper);
+  font-size: 1.25rem;
+  font-weight: bold;
+  text-decoration: none;
+}
+
+.brand-mark {
+  width: 1.25rem;
+  height: 1.25rem;
+  fill: var(--gold);
+}
+
+.nav-toggle {
+  min-width: 44px;
+  min-height: 44px;
+  padding: 0 1rem;
+  border: 1px solid var(--paper);
+  border-radius: 4px;
+  background: transparent;
+  color: var(--paper);
+  font: inherit;
+  cursor: pointer;
+}
+
+.site-nav {
+  flex-basis: 100%;
+}
+
+.site-nav ul {
+  display: flex;
+  flex-direction: column;
+  margin: 0;
+  padding: 0 0 0.5rem;
+  list-style: none;
+}
+
+.site-nav a {
+  display: flex;
+  align-items: center;
+  min-height: 44px;
+  padding: 0 1rem;
+  color: var(--paper);
+  text-decoration: none;
+  transition: background-color 0.2s ease;
+}
+
+.site-nav a:hover {
+  background: #3d3026;
+}
+
+.site-nav a[aria-current='page'] {
+  text-decoration: underline;
+  text-decoration-thickness: 2px;
+  text-underline-offset: 6px;
+}
+
+@media (min-width: 40rem) {
+  .nav-toggle {
+    display: none;
+  }
+
+  .site-nav {
+    flex-basis: auto;
+  }
+
+  .site-nav[hidden] {
+    display: block;
+  }
+
+  .site-nav ul {
+    flex-direction: row;
+    padding: 0;
+  }
+}
+
+/* Shared text and buttons */
+
+.lead {
+  font-size: 1.25rem;
+}
+
+.button {
+  display: inline-flex;
+  align-items: center;
+  min-height: 44px;
+  padding: 0.6rem 1.1rem;
+  border: 0;
+  border-radius: 4px;
+  background: var(--oxblood);
+  color: var(--card);
+  font: inherit;
+  text-decoration: none;
+  cursor: pointer;
+  transition: background-color 0.2s ease;
+}
+
+.button:hover {
+  background: var(--oxblood-hover);
+}
+
+.notice {
+  padding: 0.75rem 1rem;
+  border-left: 4px solid var(--gold);
+  border-radius: 3px;
+  background: var(--panel);
+}
+
+.highlights {
+  display: grid;
+  gap: 1rem;
+  margin-top: 2rem;
+}
+
+.highlights section {
+  padding: 1rem 1.25rem;
+  border-radius: 6px;
+  background: var(--panel);
+}
+
+.highlights h2 {
+  margin-top: 0;
+}
+
+@media (min-width: 60rem) {
+  .highlights {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+  }
+}
+
+/* Catalogue */
+
+.genre-filter {
+  margin: 1.5rem 0 1rem;
+  padding: 0.75rem 1rem 1rem;
+  border: 1px solid var(--gold);
+  border-radius: 6px;
+  background: var(--card);
+}
+
+.genre-filter legend {
+  padding: 0 0.25rem;
+  color: var(--oxblood);
+  font-weight: bold;
+}
+
+.filter-options {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.25rem 0.5rem;
+}
+
+.filter-option {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.5rem;
+  min-width: 44px;
+  min-height: 44px;
+  padding: 0 0.75rem;
+  border-radius: 4px;
+  cursor: pointer;
+}
+
+.filter-option input {
+  width: 1.25rem;
+  height: 1.25rem;
+  margin: 0;
+  accent-color: var(--oxblood);
+}
+
+.results-status {
+  margin: 0.5rem 0 1rem;
+  color: var(--muted);
+  font-style: italic;
+}
+
+.book-grid {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  gap: 1rem;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.book-card {
+  margin: 0;
+  padding: 1rem 1.25rem;
+  overflow-wrap: break-word;
+  border: 1px solid var(--rule);
+  border-radius: 6px;
+  background: var(--card);
+}
+
+.book-card h2 {
+  margin: 0 0 0.25rem;
+  font-size: 1.2rem;
+}
+
+.book-author {
+  margin: 0;
+  font-style: italic;
+}
+
+.book-genre,
+.book-price {
+  margin: 0.25rem 0 0;
+  color: var(--muted);
+  font-size: 0.95rem;
+}
+
+.book-description {
+  margin: 0.5rem 0 0;
+}
+
+@media (min-width: 40rem) {
+  .book-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+}
+
+@media (min-width: 60rem) {
+  .book-grid {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+  }
+}
+
+/* Events */
+
+.event {
+  margin: 0 0 1rem;
+  padding: 1rem 1.25rem;
+  border: 1px solid var(--rule);
+  border-radius: 6px;
+  background: var(--card);
+}
+
+.event h2 {
+  margin: 0 0 0.25rem;
+  font-size: 1.25rem;
+}
+
+.event-when {
+  margin: 0;
+  font-weight: bold;
+}
+
+.booking {
+  display: inline-block;
+  margin: 0.25rem 0 0.5rem;
+  padding: 0.1rem 0.5rem;
+  border-radius: 3px;
+  background: var(--panel);
+}
+
+/* Visit */
+
+.hours {
+  width: 100%;
+  max-width: 32rem;
+  border-collapse: collapse;
+  background: var(--card);
+}
+
+.hours caption {
+  padding-bottom: 0.5rem;
+  color: var(--oxblood);
+  font-weight: bold;
+  text-align: left;
+}
+
+.hours th,
+.hours td {
+  padding: 0.5rem 0.75rem;
+  border-bottom: 1px solid var(--rule);
+  text-align: left;
+}
+
+address {
+  font-style: normal;
+}
+
+.field {
+  max-width: 36rem;
+  margin-bottom: 1rem;
+}
+
+.field label {
+  display: block;
+  font-weight: bold;
+}
+
+.field label span {
+  font-weight: normal;
+  color: var(--muted);
+}
+
+input,
+select,
+textarea {
+  width: 100%;
+  min-height: 44px;
+  margin-top: 0.25rem;
+  padding: 0.5rem 0.6rem;
+  border: 1px solid #8c7a66;
+  border-radius: 4px;
+  background: var(--card);
+  color: var(--ink);
+  font: inherit;
+}
+
+textarea {
+  min-height: 8rem;
+}
+
+[aria-invalid='true'] {
+  border: 2px solid #9b1c1c;
+}
+
+.error {
+  margin: 0.25rem 0 0;
+  color: #8a1c1c;
+  font-weight: bold;
+}
+
+.error:empty {
+  margin: 0;
+}
+
+.hint {
+  margin: 0.25rem 0 0;
+  color: var(--muted);
+  font-size: 0.9rem;
+}
+
+.form-status {
+  max-width: 36rem;
+  margin-top: 1rem;
+  padding: 0.75rem 1rem;
+  border-left: 4px solid #4d6b3f;
+  border-radius: 3px;
+  background: #e8efe2;
+}
+
+.form-status:empty {
+  margin: 0;
+  padding: 0;
+  border: 0;
+}
+
+/* Footer */
+
+.site-footer {
+  margin-top: 2rem;
+  padding: 1.5rem 1rem;
+  border-top: 3px double var(--gold);
+  background: #efe5cf;
+  color: var(--muted);
+  font-size: 0.95rem;
+  text-align: center;
+}
+
+.site-footer p {
+  margin: 0.25rem 0;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    transition-duration: 0s !important;
+    animation-duration: 0s !important;
+    scroll-behavior: auto !important;
+  }
+}
