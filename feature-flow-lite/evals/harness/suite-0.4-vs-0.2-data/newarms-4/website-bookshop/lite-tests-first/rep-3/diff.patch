+  for (const pathname of PAGES) {
+    const { context, page } = await openPage(1280, pathname);
+    try {
+      const pairs = await page.evaluate(() => {
+        const selector =
+          'header a, main p, main li, main td, main th, main dd, main dt, main label, main a, main button, main legend, footer p, footer a';
