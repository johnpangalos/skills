@@ -0,0 +1,462 @@
+/* Marginalia Books: shared styles for every page. System font stacks only, no web fonts. */
+
+:root {
+  --paper: #fbf8f3;
+  --linen: #efe7d8;
+  --ink: #1d1d1b;
+  --muted: #4a4a45;
+  --blue: #1f4e79;
+  --ember: #b5470b;
+  --error: #a4262c;
+  --ok-bg: #e4eee2;
+  --night: #20303c;
+  --mist: #f4efe6;
+  --font: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
+  --serif: Georgia, 'Iowan Old Style', 'Palatino Linotype', Palatino, 'Times New Roman', serif;
+}
+
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+
+html {
+  -webkit-text-size-adjust: 100%;
+}
+
+body {
+  margin: 0;
+  background: var(--paper);
+  color: var(--ink);
+  font-family: var(--font);
+  font-size: 1rem;
+  line-height: 1.6;
+  overflow-wrap: break-word;
+}
+
+h1,
+h2,
+h3 {
+  font-family: var(--serif);
+  line-height: 1.2;
+  color: var(--ink);
+}
+
+h1 {
+  font-size: 2.1rem;
+  margin: 0 0 1rem;
+}
+
+h2 {
+  font-size: 1.5rem;
+  margin: 2rem 0 0.75rem;
+}
+
+h3 {
+  font-size: 1.2rem;
+  margin: 0 0 0.5rem;
+}
+
+p {
+  margin: 0 0 1rem;
+}
+
+a {
+  color: var(--blue);
+  text-underline-offset: 0.2em;
+}
+
+:focus {
+  outline: 3px solid var(--ember);
+  outline-offset: 2px;
+}
+
+.wrap {
+  max-width: 60rem;
+  margin: 0 auto;
+  padding: 0 1rem;
+}
+
+main {
+  display: block;
+  padding: 1.5rem 0 3rem;
+}
+
+main:focus {
+  outline-offset: -3px;
+}
+
+/* Skip link: off-screen until it takes focus. */
+.skip-link {
+  position: absolute;
+  left: -10000px;
+  top: 0;
+  z-index: 10;
+  padding: 0.75rem 1rem;
+  background: var(--paper);
+  color: var(--blue);
+  font-weight: bold;
+}
+
+.skip-link:focus {
+  left: 1rem;
+  top: 1rem;
+}
+
+/* Header and navigation */
+
+.site-header {
+  border-bottom: 1px solid #d9d0c0;
+  background: var(--paper);
+}
+
+.header-inner {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0.25rem 1rem;
+  padding-top: 0.75rem;
+  padding-bottom: 0.75rem;
+}
+
+.brand {
+  display: inline-flex;
+  align-items: center;
+  min-height: 44px;
+  font-family: var(--serif);
+  font-size: 1.25rem;
+  font-weight: bold;
+  color: var(--ink);
+  text-decoration: none;
+}
+
+.nav-list {
+  display: flex;
+  flex-wrap: wrap;
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.nav-list a {
+  display: inline-flex;
+  align-items: center;
+  min-height: 44px;
+  min-width: 44px;
+  padding: 0 0.75rem;
+  transition:
+    background-color 0.2s ease,
+    color 0.2s ease;
+}
+
+.nav-list a:hover {
+  background: var(--linen);
+}
+
+.nav-list a[aria-current='page'] {
+  font-weight: bold;
+  text-decoration: underline;
+  text-decoration-thickness: 2px;
+}
+
+/* Hero and generic sections */
+
+.hero {
+  background: var(--linen);
+  padding: 2rem 0;
+}
+
+.hero-inner {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 2rem;
+}
+
+.hero-inner > div {
+  flex: 1 1 22rem;
+}
+
+.hero-art {
+  flex: 0 1 12rem;
+  width: 100%;
+  max-width: 12rem;
+  height: auto;
+}
+
+.lead {
+  font-size: 1.125rem;
+}
+
+.button {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-height: 44px;
+  min-width: 44px;
+  padding: 0.5rem 1.25rem;
+  border: 0;
+  border-radius: 4px;
+  background: var(--blue);
+  color: #ffffff;
+  font: inherit;
+  font-weight: bold;
+  text-decoration: none;
+  cursor: pointer;
+  transition: background-color 0.2s ease;
+}
+
+.button:hover {
+  background: #173b5c;
+}
+
+.page-intro p {
+  max-width: 44rem;
+  color: var(--muted);
+}
+
+/* Books */
+
+.genre-filter {
+  margin: 0 0 1rem;
+  padding: 0;
+  border: 0;
+}
+
+.genre-filter legend {
+  padding: 0;
+  margin-bottom: 0.5rem;
+  font-weight: bold;
+}
+
+.genre-filter label {
+  display: inline-flex;
+  align-items: center;
+  min-height: 44px;
+  min-width: 44px;
+  margin: 0 0.5rem 0.5rem 0;
+  padding: 0.25rem 1rem;
+  border: 1px solid var(--blue);
+  border-radius: 999px;
+  background: #ffffff;
+  color: var(--blue);
+  cursor: pointer;
+  transition:
+    background-color 0.2s ease,
+    color 0.2s ease;
+}
+
+.genre-filter label:has(input:checked) {
+  background: var(--blue);
+  color: #ffffff;
+}
+
+.genre-filter input {
+  margin: 0 0.5rem 0 0;
+  width: 1.25rem;
+  height: 1.25rem;
+  accent-color: var(--blue);
+}
+
+.results-count {
+  margin: 0.5rem 0 1.25rem;
+  font-weight: bold;
+}
+
+.book-list {
+  display: grid;
+  gap: 1rem;
+  grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.book-card {
+  display: flex;
+  flex-direction: column;
+  padding: 1rem 1.1rem;
+  border: 1px solid #d9d0c0;
+  border-radius: 6px;
+  background: #ffffff;
+}
+
+.book-card h2 {
+  margin: 0 0 0.25rem;
+  font-size: 1.25rem;
+}
+
+.book-card p {
+  margin: 0 0 0.5rem;
+}
+
+.book-author {
+  color: var(--muted);
+}
+
+.book-genre {
+  font-weight: bold;
+  color: var(--ink);
+}
+
+.book-price {
+  font-weight: bold;
+}
+
+.book-blurb {
+  margin-bottom: 0;
+}
+
+/* Events */
+
+.event-list {
+  list-style: none;
+  margin: 0 0 1rem;
+  padding: 0;
+}
+
+.event-list li {
+  padding: 1rem 0;
+  border-top: 1px solid #d9d0c0;
+}
+
+.event-when {
+  font-weight: bold;
+  color: var(--muted);
+}
+
+.event-attendance {
+  font-style: italic;
+  margin-bottom: 0;
+}
+
+/* Visit */
+
+.hours-table {
+  width: 100%;
+  max-width: 32rem;
+  border-collapse: collapse;
+  margin-bottom: 1rem;
+}
+
+.hours-table th,
+.hours-table td {
+  padding: 0.5rem 0.75rem 0.5rem 0;
+  border-bottom: 1px solid #d9d0c0;
+  text-align: left;
+  vertical-align: top;
+}
+
+address {
+  font-style: normal;
+  margin-bottom: 1rem;
+}
+
+.contact-form {
+  max-width: 36rem;
+}
+
+.field {
+  margin-bottom: 1.25rem;
+}
+
+.field label {
+  display: block;
+  font-weight: bold;
+  margin-bottom: 0.25rem;
+}
+
+.field input,
+.field select,
+.field textarea {
+  display: block;
+  width: 100%;
+  min-height: 44px;
+  padding: 0.5rem 0.6rem;
+  border: 1px solid #7a7468;
+  border-radius: 4px;
+  background: #ffffff;
+  color: var(--ink);
+  font: inherit;
+}
+
+.field textarea {
+  min-height: 9rem;
+  resize: vertical;
+}
+
+.field [aria-invalid='true'] {
+  border: 2px solid var(--error);
+}
+
+.field-error {
+  margin: 0.35rem 0 0;
+  color: var(--error);
+  font-weight: bold;
+}
+
+.field-error[hidden] {
+  display: none;
+}
+
+.char-count {
+  margin: 0.35rem 0 0;
+  color: var(--muted);
+  text-align: right;
+}
+
+.required-mark {
+  font-weight: normal;
+  color: var(--muted);
+}
+
+.form-status {
+  margin-top: 1.25rem;
+}
+
+.form-status p {
+  padding: 1rem;
+  border-left: 4px solid var(--blue);
+  background: var(--ok-bg);
+}
+
+/* Footer */
+
+.site-footer {
+  background: var(--night);
+  color: var(--mist);
+  padding: 1.5rem 0;
+}
+
+.site-footer p {
+  margin: 0 0 0.5rem;
+}
+
+.site-footer p:last-child {
+  margin-bottom: 0;
+}
+
+/* Small screens */
+
+@media (max-width: 40rem) {
+  h1 {
+    font-size: 1.75rem;
+  }
+
+  .hero {
+    padding: 1.5rem 0;
+  }
+}
+
+/* Respect the reader's motion preference: no transitions or animations at all. */
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    transition: none !important;
+    animation: none !important;
+    scroll-behavior: auto !important;
+  }
+}
