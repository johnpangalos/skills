+// Catalogue for books.html. Every title, author and blurb here is fictional.
+// The page reads this one array and renders it, so add a book by adding an object.
+const BOOKS = [
+  {
+    title: 'The Clockmaker’s Alibi',
+    author: 'Tobias Wren',
+    genre: 'Mystery',
+    price: 9.99,
+    blurb:
+      'A watchmaker is found at his bench with every clock in the shop stopped at the same minute. Wren builds the case slowly, and the final reveal is one we all argued about over the till.',
+  },
+  {
+    title: 'A Lantern for Mrs Adair',
+    author: 'Delphine Ostrander',
+    genre: 'Mystery',
+    price: 8.5,
+    blurb:
+      'A retired headmistress keeps a list of the village’s unsolved small thefts. When her list gets one name too many, she starts asking questions of her own, with gentle and very funny results.',
+  },
+  {
+    title: 'Nine Keys to Harrowgate',
+    author: 'Marguerite Lowe',
+    genre: 'Mystery',
+    price: 11.0,
+    blurb:
+      'A locksmith is hired to open a house that has been sealed for forty years. Every lock she picks reveals another family secret, and the last one is hidden in plain sight.',
+  },
+  {
+    title: 'Salt and Standing Water',
+    author: 'Anwen Pryce',
+    genre: 'Poetry',
+    price: 10.0,
+    blurb:
+      'Poems set along a tidal estuary, where the coastline changes faster than the maps. Pryce writes about tides, inheritance and the long patience of boats.',
+  },
+  {
+    title: 'Field Notes for the Late Hour',
+    author: 'Joss Halloran',
+    genre: 'Poetry',
+    price: 9.5,
+    blurb:
+      'Short lyric poems written on night shifts and early train journeys. The book is small enough for a coat pocket and gets better every time you reread it.',
+  },
