+/* Marginalia Books: warm paper, ink and oxblood. System fonts only. */
+
+:root {
+  --paper: #f8f2e4;
+  --paper-deep: #efe4cc;
+  --card: #fffbf2;
+  --ink: #2d2319;
+  --ink-soft: #5b4a3b;
+  --link: #8a3b1e;
+  --accent: #b5562b;
+  --night: #2d2319;
+  --night-ink: #f8f2e4;
+  --gold: #e0b35a;
+  --footer: #20170f;
+  --footer-ink: #e8dcc4;
+  --serif:
+    "Iowan Old Style", "Palatino Linotype", Palatino, Georgia,
+    "Times New Roman", serif;
+  --sans:
+    system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial,
+    sans-serif;
+  --measure: 46rem;
+}
+
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+
+[hidden] {
+  display: none !important;
+}
+
+html {
+  background: var(--paper);
+  -webkit-text-size-adjust: 100%;
+}
+
+body {
+  margin: 0;
+  background: var(--paper);
+  color: var(--ink);
+  font-family: var(--sans);
+  font-size: 1.0625rem;
+  line-height: 1.6;
+  min-width: 0;
+  overflow-wrap: break-word;
+}
+
+img,
+svg {
+  max-width: 100%;
+  display: block;
+}
+
+h1,
+h2,
+h3 {
+  font-family: var(--serif);
+  line-height: 1.2;
+  color: var(--ink);
+  margin: 0 0 0.6em;
+}
+
+h1 {
+  font-size: clamp(2rem, 6vw, 3.25rem);
+  font-weight: 700;
+}
+
+h2 {
+  font-size: clamp(1.5rem, 4vw, 2.1rem);
+  font-weight: 700;
+}
+
+h3 {
+  font-size: 1.3rem;
+  font-weight: 700;
+}
+
+p {
+  margin: 0 0 1em;
+  max-width: var(--measure);
+}
+
+a {
+  color: var(--link);
+  text-decoration-thickness: 1px;
+  text-underline-offset: 0.2em;
+}
+
+a:hover {
+  text-decoration-thickness: 2px;
+}
+
+:focus-visible {
+  outline: 3px solid var(--accent);
+  outline-offset: 3px;
+}
+
+.skip-link {
+  position: absolute;
+  left: 1rem;
+  top: 0;
+  z-index: 10;
+  padding: 0.6rem 1rem;
+  background: var(--ink);
+  color: var(--paper);
+  font-weight: 700;
+  transform: translateY(-200%);
+}
+
+.skip-link:focus {
+  transform: none;
+  outline-color: var(--gold);
+}
+
+/* Header and nav */
+
+.site-header {
+  background: var(--night);
+  color: var(--night-ink);
+  border-bottom: 4px solid var(--accent);
+}
+
+.site-header__inner {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0.75rem 1rem;
+  max-width: 72rem;
+  margin: 0 auto;
+  padding: 0.9rem 1.25rem;
+}
+
+.brand {
+  font-family: var(--serif);
+  font-size: 1.4rem;
+  font-weight: 700;
+  color: var(--night-ink);
+  text-decoration: none;
+  letter-spacing: 0.01em;
+}
+
+.site-header :focus-visible {
+  outline-color: var(--gold);
+}
+
+.nav-toggle {
+  display: none;
+  align-items: center;
+  min-height: 2.75rem;
+  padding: 0.4rem 1rem;
+  border: 1px solid var(--night-ink);
+  border-radius: 999px;
+  background: transparent;
+  color: var(--night-ink);
+  font: inherit;
+  font-weight: 700;
+  cursor: pointer;
+}
+
+.site-nav a {
+  color: var(--night-ink);
+  text-decoration: none;
+  display: inline-block;
+  padding: 0.3rem 0;
+  border-bottom: 2px solid transparent;
+}
+
+.site-nav a:hover {
+  border-bottom-color: var(--gold);
+}
+
+.site-nav a[aria-current="page"] {
+  border-bottom-color: var(--gold);
+  font-weight: 700;
+}
+
+.site-nav ul {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.4rem 1.5rem;
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+@media (max-width: 767px) {
+  .nav-toggle {
+    display: inline-flex;
+  }
+
+  .site-nav {
+    display: none;
+    flex-basis: 100%;
+  }
+
+  .site-nav.is-open {
+    display: block;
+  }
+
+  .site-nav ul {
+    flex-direction: column;
+    gap: 0;
+  }
+
+  .site-nav a {
+    display: block;
+    padding: 0.75rem 0;
+    border-bottom: 1px solid rgba(248, 242, 228, 0.2);
+  }
+}
+
+/* Main content */
+
+main {
+  max-width: 72rem;
+  margin: 0 auto;
+  padding: 0 1.25rem 3rem;
+}
+
+main:focus {
+  outline: none;
+}
+
+.hero {
+  padding: 3rem 0 2.5rem;
+  border-bottom: 1px solid var(--paper-deep);
+}
+
+.hero__kicker,
+.eyebrow {
+  font-size: 0.85rem;
+  font-weight: 700;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+  color: var(--ink-soft);
+  margin: 0 0 0.75rem;
+}
+
+.hero__lede {
+  font-family: var(--serif);
+  font-size: 1.25rem;
+  max-width: 40rem;
+}
+
+.section {
+  padding: 2.5rem 0;
+  border-bottom: 1px solid var(--paper-deep);
+}
+
+.section--band {
+  background: var(--paper-deep);
+  margin: 0 -1.25rem;
+  padding-left: 1.25rem;
+  padding-right: 1.25rem;
+}
+
+.page-intro {
+  padding: 2.25rem 0 1.5rem;
+}
+
+.page-intro p:not(.eyebrow) {
+  font-size: 1.1rem;
+  max-width: 40rem;
+}
+
+.button {
+  display: inline-block;
+  padding: 0.7rem 1.4rem;
+  border: 0;
+  border-radius: 3px;
+  background: var(--accent);
+  color: #fffbf2;
+  font: inherit;
+  font-weight: 700;
+  text-decoration: none;
+  cursor: pointer;
+  transition: background-color 0.2s ease;
+}
+
+.button:hover {
+  background: var(--link);
+}
+
+.picks {
+  display: grid;
+  gap: 1.5rem;
+  grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
+}
+
+.pick {
+  background: var(--card);
+  border-top: 4px solid var(--gold);
+  padding: 1.25rem;
+}
+
+.pick p:last-child {
+  margin-bottom: 0;
+}
+
+/* Books */
+
+.filter {
+  padding: 0.5rem 0 1.5rem;
+}
+
+.filter__label {
+  font-weight: 700;
+  margin-bottom: 0.5rem;
+}
+
+.genre-filter {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.5rem;
+  margin-bottom: 0.9rem;
+}
+
+.genre-filter button {
+  min-height: 2.75rem;
+  padding: 0.4rem 0.9rem;
+  border: 1px solid var(--ink-soft);
+  border-radius: 999px;
+  background: var(--card);
+  color: var(--ink);
+  font: inherit;
+  cursor: pointer;
+}
+
+.genre-filter button[aria-pressed="true"] {
+  background: var(--ink);
+  border-color: var(--ink);
+  color: var(--paper);
+}
+
+#result-count {
+  font-weight: 700;
+  color: var(--ink-soft);
+  margin: 0;
+}
+
+.book-list {
+  display: grid;
+  gap: 1.75rem 1.5rem;
+  grid-template-columns: repeat(auto-fill, minmax(min(15rem, 100%), 1fr));
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.book-card {
+  display: flex;
+  flex-direction: column;
+  background: var(--card);
+  border: 1px solid var(--paper-deep);
+}
+
+.cover {
+  display: flex;
+  align-items: flex-end;
+  aspect-ratio: 3 / 4;
+  padding: 1.1rem 1.1rem 1.25rem 1.6rem;
+  background: var(--cover);
+  color: var(--cover-ink);
+  box-shadow:
+    inset 0.6rem 0 0 rgba(0, 0, 0, 0.2),
+    inset -0.15rem 0 0 rgba(255, 255, 255, 0.12);
+}
+
+.cover span {
+  font-family: var(--serif);
+  font-size: 1.35rem;
+  font-weight: 700;
+  line-height: 1.15;
+}
+
+.book-card__body {
+  display: flex;
+  flex-direction: column;
+  flex: 1;
+  padding: 1rem 1.1rem 1.1rem;
+}
+
+.book-card__body h2 {
+  font-size: 1.2rem;
+  margin-bottom: 0.3rem;
+}
+
+.book-card__genre {
+  font-size: 0.8rem;
+  font-weight: 700;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: var(--ink-soft);
+  margin: 0 0 0.35rem;
+}
+
+.book-card__author {
+  font-style: italic;
+  margin-bottom: 0.6rem;
+}
+
+.book-card__blurb {
+  font-size: 0.95rem;
+  flex: 1;
+}
+
+.book-card__price {
+  font-weight: 700;
+  margin: 0.4rem 0 0;
+}
+
+/* Events */
+
+.event-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.event {
+  display: grid;
+  gap: 0.35rem;
+  padding: 1.5rem 0;
+  border-top: 1px solid var(--paper-deep);
+}
+
+.event__when {
+  margin: 0;
+  font-weight: 700;
+  color: var(--link);
+}
+
+.event__badge {
+  display: inline-block;
+  margin-left: 0.6rem;
+  padding: 0.1rem 0.5rem;
+  border: 1px solid var(--ink-soft);
+  border-radius: 3px;
+  font-size: 0.8rem;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+  color: var(--ink-soft);
+}
+
+.event h2 {
+  font-size: 1.4rem;
+  margin: 0;
+}
+
+.event__location {
+  margin: 0;
+  font-style: italic;
+  color: var(--ink-soft);
+}
+
+/* Visit */
+
+.hours {
+  width: 100%;
+  max-width: 30rem;
+  border-collapse: collapse;
+  margin-bottom: 1.25rem;
+  background: var(--card);
+}
+
+.hours caption {
+  text-align: left;
+  font-weight: 700;
+  padding-bottom: 0.5rem;
+}
+
+.hours th,
+.hours td {
+  padding: 0.55rem 0.75rem;
+  border-bottom: 1px solid var(--paper-deep);
+  text-align: left;
+  overflow-wrap: anywhere;
+}
+
+address {
+  font-style: normal;
+  font-family: var(--serif);
+  font-size: 1.15rem;
+  margin-bottom: 1rem;
+}
+
+.contact-form {
+  display: grid;
+  gap: 1.25rem;
+  max-width: 36rem;
+}
+
+.field {
+  display: flex;
+  flex-direction: column;
+  gap: 0.35rem;
+}
+
+.field label {
+  font-weight: 700;
+}
+
+.field__note {
+  font-weight: 400;
+  color: var(--ink-soft);
+}
+
+.field input,
+.field select,
+.field textarea {
+  width: 100%;
+  min-height: 2.75rem;
+  padding: 0.55rem 0.7rem;
+  border: 1px solid var(--ink-soft);
+  border-radius: 3px;
+  background: var(--card);
+  color: var(--ink);
+  font: inherit;
+}
+
+.field textarea {
+  resize: vertical;
+}
+
+.field__hint {
+  margin: 0;
+  font-size: 0.92rem;
+  color: var(--ink-soft);
+}
+
+.field__error {
+  margin: 0;
+  font-weight: 700;
+  color: #8a1c1c;
+}
+
+.field [aria-invalid="true"] {
+  border-color: #8a1c1c;
+  border-width: 2px;
+}
+
+.form-status {
+  margin-top: 1.5rem;
+  max-width: 36rem;
+  padding: 0.9rem 1.1rem;
+  background: var(--card);
+  border-left: 4px solid var(--gold);
+  font-family: var(--serif);
+}
+
+/* Keep the live region rendered while empty so the first message is announced. */
+.form-status:empty {
+  margin-top: 0;
+  padding: 0;
+  border-left-width: 0;
+}
+
+/* Footer */
+
+.site-footer {
+  background: var(--footer);
+  color: var(--footer-ink);
+}
+
+.site-footer__inner {
+  max-width: 72rem;
+  margin: 0 auto;
+  padding: 2rem 1.25rem;
+}
+
+.site-footer__inner p {
+  margin-bottom: 0.4rem;
+}
+
+.site-footer__name {
+  font-family: var(--serif);
+  font-size: 1.2rem;
+  font-weight: 700;
+}
+
+.site-footer__fine {
+  font-size: 0.9rem;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    transition-duration: 0.01ms !important;
+    transition-delay: 0s !important;
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+    scroll-behavior: auto !important;
+  }
+}
