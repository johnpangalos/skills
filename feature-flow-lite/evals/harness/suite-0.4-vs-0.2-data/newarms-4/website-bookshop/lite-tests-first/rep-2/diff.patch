+  var MIN_MESSAGE_LENGTH = 20;
+  var EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+  var FIELDS = ["name", "email", "topic", "message"];
+
+  var rules = {
+    name: function (value) {
+      return value ? "" : "Please enter your name.";
