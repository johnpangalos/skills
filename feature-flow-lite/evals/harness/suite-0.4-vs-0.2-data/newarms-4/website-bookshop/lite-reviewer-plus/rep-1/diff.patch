index 0000000..56a3ffd
--- /dev/null
+++ b/tests/run.mjs
@@ -0,0 +1,487 @@
+// Headless browser tests for the Marginalia Books site.
+// Usage: node tests/run.mjs [name-filter]
+import http from 'node:http';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const PAGES = ['index.html', 'books.html', 'events.html', 'visit.html'];
+const WIDTHS = [320, 360, 768, 1280];
+const TYPES = {
+  '.html': 'text/html; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.js': 'text/javascript; charset=utf-8'
+};
+
+let chromium;
+try {
+  ({ chromium } = await import('playwright'));
+} catch {
+  ({ chromium } = await import(process.env.PLAYWRIGHT_MODULE ?? '/opt/node-tools/node_modules/playwright/index.mjs'));
+}
+
+function startServer() {
+  const server = http.createServer((req, res) => {
+    const urlPath = new URL(req.url, 'http://localhost').pathname;
+    const file = path.resolve(ROOT, urlPath === '/' ? 'index.html' : urlPath.slice(1));
+    if (!file.startsWith(ROOT + path.sep) || !fs.existsSync(file) || fs.statSync(file).isDirectory()) {
+      res.writeHead(404, { 'Content-Type': 'text/plain' });
+      res.end('Not found');
+      return;
+    }
+    res.writeHead(200, { 'Content-Type': TYPES[path.extname(file)] ?? 'application/octet-stream' });
+    fs.createReadStream(file).pipe(res);
+  });
+  return new Promise((resolve) => server.listen(0, '127.0.0.1', () => resolve(server)));
+}
+
+function eq(actual, expected, label) {
+  const a = JSON.stringify(actual);
+  const b = JSON.stringify(expected);
+  if (a !== b) throw new Error(`${label}: expected ${b}, got ${a}`);
+}
+
+function ok(condition, label) {
+  if (!condition) throw new Error(label);
+}
+
+// Opens a fresh browser context on a page and records requests, console errors and dialogs.
+async function session(browser, base, target, { width = 1280, height = 900, clock, timezoneId = 'Europe/London', reducedMotion = 'no-preference' } = {}) {
+  const context = await browser.newContext({
+    viewport: { width, height },
+    timezoneId,
+    reducedMotion
+  });
+  const page = await context.newPage();
+  const s = { context, page, errors: [], requests: [], dialogs: [] };
+  page.on('console', (msg) => { if (msg.type() === 'error') s.errors.push(msg.text()); });
+  page.on('pageerror', (error) => s.errors.push(error.message));
+  page.on('request', (req) => s.requests.push({ url: req.url(), method: req.method() }));
+  page.on('dialog', (dialog) => { s.dialogs.push(dialog.message()); dialog.dismiss(); });
+  if (clock) await page.clock.setFixedTime(new Date(clock));
+  await page.goto(base + target);
+  return s;
+}
+
+async function cardTitles(page, selector) {
+  return page.$$eval(`${selector} h2, ${selector} h3`, (els) => els.map((el) => el.textContent));
+}
+
+async function waitForCards(page, count) {
