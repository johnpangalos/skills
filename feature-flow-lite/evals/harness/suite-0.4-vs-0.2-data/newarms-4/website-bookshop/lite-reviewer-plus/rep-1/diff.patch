+    item.append(cover, title, meta);
+    return item;
+  }
+
+  function eventItem(entry) {
+    const item = document.createElement('li');
+    item.className = 'event';
+
+    const title = document.createElement('h3');
+    title.textContent = entry.title;
+
+    const when = document.createElement('p');
+    when.className = 'event-when';
+    const time = document.createElement('time');
+    time.dateTime = `${entry.date}T${entry.time}`;
+    time.textContent = formatWhen(entry.date, entry.time);
+    when.append(time);
+
+    item.append(title, when);
+    return item;
+  }
+
+  const today = todayIso();
+  const featured = BOOKS.filter((book) => book.featured).slice(0, 3);
+  const upcoming = EVENTS
+    .filter((entry) => entry.date >= today)
+    .sort((a, b) => (a.date + a.time).localeCompare(b.date + b.time))
+    .slice(0, 3);
+
+  featuredList.replaceChildren(...featured.map(featuredItem));
+  upcomingList.replaceChildren(...upcoming.map(eventItem));
+  noUpcoming.hidden = upcoming.length > 0;
+})();
