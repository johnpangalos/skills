+:root {
+  --paper: #faf7f0;
+  --card: #ffffff;
+  --ink: #1f1d1a;
+  --muted: #55504a;
+  --link: #1d4f7a;
+  --strong: #163b5c;
+  --line: #d8d2c4;
+  --field-border: #8a8377;
+  --focus: #9a3412;
+  --error: #a61b1b;
+  --band: #efe7d6;
+}
+
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+
+html {
+  -webkit-text-size-adjust: 100%;
+}
+
+body {
+  margin: 0;
+  font-family: Georgia, "Iowan Old Style", "Times New Roman", serif;
+  font-size: 1.0625rem;
+  line-height: 1.6;
+  color: var(--ink);
+  background: var(--paper);
+  overflow-wrap: anywhere;
+}
+
+h1,
+h2,
+h3 {
+  line-height: 1.25;
+}
+
+h1 {
+  font-size: clamp(1.9rem, 6vw, 2.6rem);
+  margin: 0 0 1rem;
+}
+
+h2 {
+  font-size: 1.5rem;
+  margin: 2.25rem 0 0.75rem;
+}
+
+h3 {
+  font-size: 1.15rem;
+  margin: 0 0 0.25rem;
+}
+
+a {
+  color: var(--link);
+  text-decoration: underline;
+  text-decoration-thickness: 1px;
+  text-underline-offset: 0.2em;
+}
+
+a:hover {
+  text-decoration-thickness: 3px;
+}
+
+:focus-visible {
+  outline: 3px solid var(--focus);
+  outline-offset: 3px;
+}
+
+.container {
+  width: min(100% - 2rem, 60rem);
+  margin-inline: auto;
+}
+
+.skip-link {
+  position: absolute;
+  left: 1rem;
+  top: -4rem;
+  z-index: 10;
+  padding: 0.5rem 1rem;
+  background: var(--card);
+  color: var(--ink);
+  border: 2px solid var(--focus);
+  border-radius: 4px;
+}
+
+.skip-link:focus {
+  top: 0.5rem;
+}
+
+/* Header and navigation */
+
+.site-header {
+  background: var(--card);
+  border-bottom: 1px solid var(--line);
+}
+
+.header-inner {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0.5rem 1rem;
+  padding-block: 0.75rem;
+}
+
+.brand {
+  font-size: 1.25rem;
+  font-weight: 700;
+  color: var(--ink);
+  text-decoration: none;
+}
+
+.nav-list {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.25rem 1.25rem;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.nav-list a[aria-current="page"] {
+  color: var(--ink);
+  font-weight: 700;
+  text-decoration-thickness: 3px;
+}
+
+.nav-toggle {
+  display: none;
+  font: inherit;
+  padding: 0.4rem 0.9rem;
+  color: var(--ink);
+  background: var(--card);
+  border: 2px solid var(--strong);
+  border-radius: 4px;
+  cursor: pointer;
+}
+
+@media (max-width: 699px) {
+  .js .nav-toggle {
+    display: inline-block;
+  }
+
+  .js .site-nav {
+    display: none;
+    flex-basis: 100%;
+  }
+
+  .js .nav-open .site-nav {
+    display: block;
+  }
+
+  .js .nav-open .nav-list {
+    flex-direction: column;
+  }
+}
+
+/* Page structure */
+
+main.container {
+  padding-block: 1.5rem 3rem;
+}
+
+.lead {
+  font-size: 1.15rem;
+  color: var(--muted);
+}
+
+.hero {
+  padding: 2.5rem 1.25rem;
+  background: var(--band);
+  border-radius: 8px;
+}
+
+.hero h1 {
+  margin-bottom: 0.75rem;
+}
+
+.button {
+  display: inline-block;
+  margin: 0.25rem 0.5rem 0.25rem 0;
+  padding: 0.6rem 1.1rem;
+  font-weight: 700;
+  color: #ffffff;
+  background: var(--strong);
+  border-radius: 4px;
+  text-decoration: none;
+  transition: background-color 0.2s ease;
+}
+
+.button:hover {
+  background: #0f2c45;
+  text-decoration: underline;
+}
+
+.card {
+  padding: 1rem 1.1rem;
+  background: var(--card);
+  border: 1px solid var(--line);
+  border-radius: 6px;
+}
+
+.card-list {
+  display: grid;
+  gap: 1rem;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+  grid-template-columns: minmax(0, 1fr);
+}
+
+@media (min-width: 40rem) {
+  .card-list {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+}
+
+@media (min-width: 60rem) {
+  .card-list {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+  }
+}
+
+.card h2,
+.card h3 {
+  margin: 0 0 0.25rem;
+  font-size: 1.2rem;
+}
+
+.card p {
+  margin: 0.35rem 0 0;
+}
+
+.muted {
+  color: var(--muted);
+}
+
+/* Books page */
+
+.genre-filter {
+  min-width: 0;
+  margin: 0 0 1rem;
+  padding: 0.75rem 1rem 1rem;
+  background: var(--card);
+  border: 1px solid var(--line);
+  border-radius: 6px;
+}
+
+.genre-filter legend {
+  padding: 0 0.25rem;
+  font-weight: 700;
+}
+
+.filter-buttons {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.5rem;
+}
+
+.filter-buttons button {
+  font: inherit;
+  padding: 0.4rem 0.85rem;
+  color: var(--ink);
+  background: var(--card);
+  border: 2px solid var(--strong);
+  border-radius: 999px;
+  cursor: pointer;
+}
+
+.filter-buttons button[aria-pressed="true"] {
+  color: #ffffff;
+  background: var(--strong);
+  font-weight: 700;
+}
+
+.filter-buttons button[aria-pressed="true"]::before {
+  content: "\2713\00a0";
+}
+
+.result-count {
+  margin: 0 0 1rem;
+  font-weight: 700;
+  color: var(--muted);
+}
+
+/* Events page */
+
+.event-date {
+  margin: 0;
+  font-weight: 700;
+  color: var(--strong);
+}
+
+.event-title {
+  margin: 0.25rem 0 0;
+  font-size: 1.2rem;
+}
+
+/* Visit page */
+
+.hours {
+  width: 100%;
+  max-width: 30rem;
+  border-collapse: collapse;
+  background: var(--card);
+  border: 1px solid var(--line);
+}
+
+.hours caption {
+  padding-bottom: 0.5rem;
+  font-weight: 700;
+  text-align: left;
+}
+
+.hours th,
+.hours td {
+  padding: 0.5rem 0.75rem;
+  text-align: left;
+  border-bottom: 1px solid var(--line);
+}
+
+.contact-list {
+  padding-left: 1.25rem;
+}
+
+.contact-form {
+  display: grid;
+  gap: 1rem;
+  max-width: 34rem;
+}
+
+.contact-form label {
+  display: block;
+  margin-bottom: 0.25rem;
+  font-weight: 700;
+}
+
+.contact-form input,
+.contact-form textarea {
+  width: 100%;
+  padding: 0.5rem 0.6rem;
+  font: inherit;
+  color: var(--ink);
+  background: #ffffff;
+  border: 2px solid var(--field-border);
+  border-radius: 4px;
+}
+
+.contact-form textarea {
+  min-height: 8rem;
+  resize: vertical;
+}
+
+.contact-form [aria-invalid="true"] {
+  border-color: var(--error);
+}
+
+.contact-form button {
+  justify-self: start;
+  font: inherit;
+  cursor: pointer;
+}
+
+.field-error {
+  margin: 0.25rem 0 0;
+  font-weight: 700;
+  color: var(--error);
+}
+
+.form-status {
+  margin: 1rem 0 0;
+  max-width: 34rem;
+}
+
+.form-status:not(:empty) {
+  padding: 0.75rem 1rem;
+  background: var(--card);
+  border-left: 4px solid var(--strong);
+}
+
+/* Footer */
+
+.site-footer {
+  margin-top: 2rem;
+  padding-block: 1.5rem;
+  font-size: 0.95rem;
+  color: var(--muted);
+  border-top: 1px solid var(--line);
+}
+
+.site-footer p {
+  margin: 0 0 0.5rem;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    transition-duration: 0.01ms !important;
+    animation-duration: 0.01ms !important;
+    scroll-behavior: auto !important;
+  }
+}
