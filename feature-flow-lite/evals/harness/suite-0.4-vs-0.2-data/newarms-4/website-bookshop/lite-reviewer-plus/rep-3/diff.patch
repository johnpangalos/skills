+function fieldState(page, field) {
+  return page.evaluate((name) => {
+    const input = document.getElementById(`contact-${name}`);
+    const error = document.getElementById(`${name}-error`);
+    return {
+      invalid: input.getAttribute("aria-invalid"),
+      describedBy: input.getAttribute("aria-describedby"),
+      message: error.textContent,
+    };
+  }, field);
+}
+
+function statusText(page) {
+  return page.textContent("#form-status");
+}
+
+describe("contact form validation", () => {
+  it("submitting all fields empty marks each field invalid, links errors and focuses name", async () => {
+    const { page, close } = await openVisit();
+    try {
+      await submit(page);
+      assert.deepEqual(await fieldState(page, "name"), {
+        invalid: "true",
+        describedBy: "name-error",
+        message: NAME_ERROR,
+      });
+      assert.deepEqual(await fieldState(page, "email"), {
+        invalid: "true",
+        describedBy: "email-error",
+        message: EMAIL_EMPTY,
+      });
+      assert.deepEqual(await fieldState(page, "message"), {
+        invalid: "true",
+        describedBy: "message-error",
+        message: MESSAGE_EMPTY,
+      });
+      assert.equal(
+        await page.evaluate(() => document.activeElement.id),
+        "contact-name",
+      );
+      assert.equal(await statusText(page), "");
+    } finally {
+      await close();
+    }
+  });
+
+  it("treats whitespace-only name and message as empty", async () => {
+    const { page, close } = await openVisit();
+    try {
+      await fill(page, {
+        name: "   ",
+        email: "ada@example.com",
+        message: "  \n  ",
+      });
+      await submit(page);
+      assert.equal((await fieldState(page, "name")).message, NAME_ERROR);
+      assert.equal((await fieldState(page, "message")).message, MESSAGE_EMPTY);
+      assert.deepEqual(await fieldState(page, "email"), {
+        invalid: "false",
+        describedBy: null,
+        message: "",
+      });
+      assert.equal(
+        await page.evaluate(() => document.activeElement.id),
+        "contact-name",
+      );
+    } finally {
+      await close();
+    }
+  });
+
+  for (const email of ["foo@", "foo bar@x.com"]) {
+    it(`rejects the email "${email}" with the exact message`, async () => {
+      const { page, close } = await openVisit();
+      try {
+        await fill(page, { name: "Ada", email, message: "Hello" });
+        await submit(page);
+        assert.deepEqual(await fieldState(page, "email"), {
+          invalid: "true",
+          describedBy: "email-error",
+          message: EMAIL_INVALID,
+        });
+        assert.equal(
+          await page.evaluate(() => document.activeElement.id),
+          "contact-email",
+        );
+        assert.equal(await statusText(page), "");
+      } finally {
+        await close();
+      }
+    });
+  }
+
+  it("rejects a message over 1000 characters and keeps the layout intact", async () => {
+    const { page, close } = await openVisit();
+    try {
+      await fill(page, { name: "Ada", email: "ada@example.com" });
+      // Set the value directly so the maxlength attribute cannot truncate it.
+      await page.evaluate(() => {
+        document.getElementById("contact-message").value = "x".repeat(5000);
+      });
+      await submit(page);
+      assert.deepEqual(await fieldState(page, "message"), {
+        invalid: "true",
+        describedBy: "message-error",
+        message: MESSAGE_LONG,
+      });
+      assert.equal(
+        await page.evaluate(() => document.activeElement.id),
+        "contact-message",
+      );
+      const overflow = await page.evaluate(
+        () => document.documentElement.scrollWidth > window.innerWidth,
+      );
+      assert.equal(overflow, false);
+    } finally {
+      await close();
+    }
+  });
+
+  it("clears an error as soon as the field is corrected", async () => {
+    const { page, close } = await openVisit();
+    try {
+      await submit(page);
+      await page.fill("#contact-name", "Ada Lovelace");
+      assert.deepEqual(await fieldState(page, "name"), {
+        invalid: "false",
+        describedBy: null,
+        message: "",
+      });
+      await page.fill("#contact-email", "foo@");
+      assert.equal((await fieldState(page, "email")).message, EMAIL_INVALID);
+      await page.fill("#contact-email", "foo@example.com");
+      assert.deepEqual(await fieldState(page, "email"), {
+        invalid: "false",
+        describedBy: null,
+        message: "",
+      });
+    } finally {
+      await close();
+    }
+  });
+
+  it("pressing submit twice with invalid input shows the same errors once and focuses name again", async () => {
+    const { page, close } = await openVisit();
+    try {
+      await submit(page);
+      await submit(page);
+      assert.equal((await fieldState(page, "name")).message, NAME_ERROR);
+      assert.equal((await fieldState(page, "message")).message, MESSAGE_EMPTY);
+      assert.equal(
+        await page.evaluate(() => document.activeElement.id),
+        "contact-name",
+      );
+      assert.equal(await statusText(page), "");
+    } finally {
+      await close();
+    }
+  });
+});
+
+describe("contact form submission", () => {
+  it("a valid message shows the demo notice and sends no request", async () => {
+    const { page, requests, close } = await openVisit();
+    try {
+      const requestsBefore = requests.length;
+      await fill(page, {
+        name: "Ada",
+        email: "ada@example.com",
+        message: "Do you stock atlases?",
+      });
+      await submit(page);
+      assert.equal(await statusText(page), DEMO_NOTICE);
+      assert.equal(await page.getAttribute("#form-status", "role"), "status");
+      assert.equal(
+        await page.evaluate(() =>
+          document
+            .getElementById("form-status")
+            .textContent.includes("NOT sent"),
+        ),
+        true,
+      );
+      const newRequests = requests
+        .slice(requestsBefore)
+        .filter(({ url }) => url.startsWith(server.origin));
+      assert.deepEqual(
+        newRequests.filter(({ method }) => method !== "GET"),
+        [],
+      );
+      assert.deepEqual(externalRequests(requests, server.origin), []);
+    } finally {
+      await close();
+    }
+  });
+
+  it("submitting a valid message twice keeps the same single demo notice", async () => {
+    const { page, close } = await openVisit();
+    try {
+      await fill(page, {
+        name: "Ada",
+        email: "ada@example.com",
+        message: "Hello",
+      });
+      await submit(page);
+      await submit(page);
+      assert.equal(await statusText(page), DEMO_NOTICE);
+    } finally {
+      await close();
+    }
+  });
+});
