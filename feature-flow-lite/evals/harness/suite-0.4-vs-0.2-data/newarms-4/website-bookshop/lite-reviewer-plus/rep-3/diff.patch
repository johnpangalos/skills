+    title: "The Glass Orchard Murders",
+    author: "Rosalind Hale",
+    genre: "Mystery",
+    price: 14.99,
+    description:
+      "A botanist is found dead among the roses in a greenhouse that was locked from the inside. The village has three suspects and one very patient gardener.",
+  },
+  {
+    title: "Nine Keys to Harrow Street",
+    author: "Tomas Eberly",
+    genre: "Mystery",
+    price: 12.5,
+    description:
+      "A locksmith’s apprentice inherits a ring of nine keys, each one opening a door somewhere in the city. Someone else has been trying the same locks.",
+  },
+  {
+    title: "The Quiet Tenant",
+    author: "Imogen Strand",
+    genre: "Mystery",
