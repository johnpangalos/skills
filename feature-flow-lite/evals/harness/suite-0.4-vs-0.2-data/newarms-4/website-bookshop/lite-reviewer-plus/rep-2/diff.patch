+
+// Browser-side contrast inspection: text colour against its real backdrop, and border colour if drawn.
+function inspectContrast(selectors) {
+  const parse = (value) => {
+    const parts = value.match(/[\d.]+/g).map(Number);
+    return { r: parts[0], g: parts[1], b: parts[2], a: parts.length > 3 ? parts[3] : 1 };
+  };
+  const luminance = ({ r, g, b }) => {
+    const channel = (v) => {
+      const s = v / 255;
+      return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
+    };
+    return 0.2126 * channel(r) + 0.7152 * channel(g) + 0.0722 * channel(b);
+  };
+  const ratio = (a, b) => {
+    const hi = Math.max(luminance(a), luminance(b));
+    const lo = Math.min(luminance(a), luminance(b));
+    return (hi + 0.05) / (lo + 0.05);
+  };
+  const backdrop = (el) => {
+    for (let node = el; node; node = node.parentElement) {
+      const colour = parse(getComputedStyle(node).backgroundColor);
+      if (colour.a > 0) {
+        return colour;
+      }
+    }
+    return { r: 255, g: 255, b: 255, a: 1 };
+  };
+  return selectors.map((selector) => {
+    const el = document.querySelector(selector);
+    if (!el) {
+      return { selector, found: false };
+    }
+    const cs = getComputedStyle(el);
+    const drawsBorder = parseFloat(cs.borderTopWidth) > 0 && cs.borderTopStyle !== 'none';
+    return {
+      selector,
+      found: true,
+      text: ratio(parse(cs.color), backdrop(el)),
+      // A border is a boundary against the surface around the control, not against its own fill.
+      border: drawsBorder ? ratio(parse(cs.borderTopColor), backdrop(el.parentElement ?? el)) : null
+    };
+  });
+}
+
+const CONTRAST_SELECTORS = {
+  home: ['main .lead', '.section-link', '.link-grid a', '#featured-books .book__author', '#featured-books .book__meta', '#featured-books .book__blurb', '#next-event .event__when'],
+  books: ['.filter legend', '.filter__option:not(:has(input:checked))', '.filter__option:has(input:checked)', '.book-count', '.book__author', '.book__meta', '.book__blurb'],
+  events: ['.event h2', '.event__when', '.event__booking', '.event p:last-child'],
+  visit: ['main .lead', '.hours th', '.hours td', 'address', 'main a', '.field label', '.field__hint', '.field input', '.field textarea', '.button']
+};
+
+// Lists every element a keyboard user can reach, in DOM order, skipping hidden elements and unchecked radios.
+function countTabbable() {
+  return [...document.querySelectorAll('a[href], button:not([disabled]), input:not([type="hidden"]), textarea, select, [tabindex]:not([tabindex="-1"])')]
+    .filter((el) => el.getClientRects().length > 0 && !(el.type === 'radio' && !el.checked)).length;
+}
+
+function describeFocus() {
+  const el = document.activeElement;
+  const cs = getComputedStyle(el);
+  return {
+    label: `${el.tagName.toLowerCase()}${el.id ? '#' + el.id : ''}${el.className && typeof el.className === 'string' ? '.' + el.className.split(' ')[0] : ''}`,
+    outlineStyle: cs.outlineStyle,
+    outlineWidth: cs.outlineWidth
+  };
+}
