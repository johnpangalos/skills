+const selected = tests.filter((t) => !only || t.group === only);
+const server = await serve();
+const base = `http://127.0.0.1:${server.address().port}`;
+const chromium = await loadChromium();
+const browser = await chromium.launch();
+let passed = 0;
+let failed = 0;
+
+try {
+  for (const t of selected) {
+    const sessions = [];
+    const ctx = {
+      open: async (options) => {
+        const session = await openSession(browser, base, options);
+        sessions.push(session);
+        return session;
+      },
+      openNoScript: async (options) => {
+        const session = await openNoScriptSession(browser, base, options);
+        sessions.push(session);
