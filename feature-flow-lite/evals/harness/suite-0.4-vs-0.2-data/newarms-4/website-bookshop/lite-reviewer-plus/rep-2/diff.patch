+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Books by genre | Marginalia Books</title>
+  <link rel="icon" href="data:,">
+  <link rel="stylesheet" href="css/styles.css">
+</head>
+<body>
+  <a class="skip-link" href="#main">Skip to main content</a>
+
+  <header class="site-header">
+    <div class="site-header__inner">
+      <a class="site-name" href="index.html">Marginalia Books</a>
+      <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
+      <nav id="site-nav" class="site-nav" aria-label="Main">
+        <ul class="site-nav__list">
+          <li><a href="index.html">Home</a></li>
+          <li><a href="books.html" aria-current="page">Books</a></li>
+          <li><a href="events.html">Events</a></li>
+          <li><a href="visit.html">Visit</a></li>
+        </ul>
+      </nav>
+    </div>
+  </header>
+
+  <main id="main" tabindex="-1">
+    <div class="wrap">
+      <h1>Our books</h1>
+      <p class="lead">Every title on our shelves, with a short note on each. Choose a genre to narrow the list.</p>
+
+      <h2>Browse the shelves</h2>
+      <fieldset class="filter">
+        <legend>Filter by genre</legend>
+        <div class="filter__options" id="genre-options"></div>
+      </fieldset>
+
+      <p class="book-count" id="book-count" role="status" aria-live="polite"></p>
+      <ul class="book-list" id="book-list"></ul>
+      <noscript><p>The catalogue needs JavaScript to filter by genre.</p></noscript>
+    </div>
+  </main>
+
+  <footer class="site-footer">
+    <div class="wrap">
+      <p>Marginalia Books, 14 Calder Lane, Bristol BS1 4QA</p>
+      <p>An independent bookshop. Poetry, fiction, essays, mysteries and a very good children's table.</p>
+      <p>&copy; 2026 Marginalia Books</p>
+    </div>
+  </footer>
+
+  <script src="js/data.js"></script>
+  <script src="js/main.js"></script>
+  <script src="js/books.js"></script>
+</body>
+</html>
