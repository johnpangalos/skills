@@ -0,0 +1,532 @@
+/* Marginalia Books: shared styles. System font stacks only, no external requests. */
+
+:root {
+  --bg: #fdfaf4;
+  --ink: #2b2623;
+  --muted: #5c5249;
+  --accent: #7a2e1f;
+  --error: #9b1c1c;
+  --rule: #d9cfc2;
+  --footer-bg: #2b2623;
+  --footer-ink: #fdfaf4;
+  --body-font: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
+  --heading-font: Georgia, "Iowan Old Style", "Times New Roman", serif;
+}
+
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+
+html {
+  background: var(--bg);
+  color: var(--ink);
+  font-family: var(--body-font);
+  font-size: 100%;
+  line-height: 1.6;
+  -webkit-text-size-adjust: 100%;
+}
+
+body {
+  margin: 0;
+  background: var(--bg);
+  font-size: 1.0625rem;
+  overflow-wrap: anywhere;
+}
+
+h1,
+h2,
+h3 {
+  font-family: var(--heading-font);
+  line-height: 1.25;
+  margin: 0 0 0.5em;
+}
+
+h1 {
+  font-size: 2rem;
+  margin-top: 0.5em;
+}
+
+h2 {
+  font-size: 1.5rem;
+  margin-top: 1.5em;
+}
+
+h3 {
+  font-size: 1.2rem;
+}
+
+p {
+  margin: 0 0 1em;
+}
+
+a {
+  color: var(--accent);
+  text-underline-offset: 3px;
+}
+
+:focus-visible {
+  outline: 3px solid var(--accent);
+  outline-offset: 3px;
+}
+
+/* Hidden elements stay hidden even where a class sets display, such as .event-list. */
+[hidden] {
+  display: none !important;
+}
+
+/* Without JavaScript the form cannot run, so the noscript note with the email address is shown instead. */
+html:not(.js) #contact-form {
+  display: none;
+}
+
+/* Without JavaScript the menu toggle does nothing, so the nav links stay visible at every width. */
+html:not(.js) .nav-toggle {
+  display: none;
+}
+
+.wrap {
+  width: 100%;
+  max-width: 64rem;
+  margin: 0 auto;
+  padding: 0 1rem;
+}
+
+/* Skip link: hidden until focused, then pinned to the top left. */
+.skip-link {
+  position: fixed;
+  top: -4rem;
+  left: 0.5rem;
+  z-index: 100;
+  padding: 0.75rem 1rem;
+  background: var(--accent);
+  color: var(--bg);
+  font-weight: 700;
+  text-decoration: none;
+}
+
+.skip-link:focus {
+  top: 0.5rem;
+}
+
+/* Header and navigation */
+.site-header {
+  border-bottom: 1px solid var(--rule);
+}
+
+.site-header__inner {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0.5rem 1rem;
+  max-width: 64rem;
+  margin: 0 auto;
+  padding: 0.5rem 1rem;
+}
+
+.site-name {
+  font-family: var(--heading-font);
+  font-size: 1.35rem;
+  font-weight: 700;
+  color: var(--ink);
+  text-decoration: none;
+  min-height: 44px;
+  display: inline-flex;
+  align-items: center;
+}
+
+.nav-toggle {
+  display: inline-flex;
+  align-items: center;
+  min-height: 44px;
+  min-width: 44px;
+  padding: 0.5rem 1rem;
+  border: 2px solid var(--ink);
+  border-radius: 4px;
+  background: transparent;
+  color: var(--ink);
+  font: inherit;
+  font-weight: 700;
+  cursor: pointer;
+}
+
+.site-nav {
+  width: 100%;
+}
+
+.site-nav__list {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.25rem 1rem;
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.site-nav__list a {
+  display: inline-flex;
+  align-items: center;
+  min-height: 44px;
+  padding: 0 0.5rem;
+  color: var(--ink);
+  text-decoration: none;
+  border-bottom: 2px solid transparent;
+}
+
+.site-nav__list a:hover {
+  text-decoration: underline;
+}
+
+.site-nav__list a[aria-current="page"] {
+  font-weight: 700;
+  color: var(--accent);
+  border-bottom-color: var(--accent);
+}
+
+/* Below 768px the menu is collapsed behind the toggle, when JavaScript is running. */
+@media (max-width: 767px) {
+  .js .site-nav {
+    display: none;
+  }
+
+  .js .site-nav.is-open {
+    display: block;
+  }
+
+  .js .site-nav__list {
+    flex-direction: column;
+    gap: 0;
+    padding: 0.5rem 0;
+  }
+}
+
+@media (min-width: 768px) {
+  .nav-toggle {
+    display: none;
+  }
+
+  .site-nav {
+    width: auto;
+  }
+}
+
+main {
+  padding: 0 0 2rem;
+}
+
+main:focus {
+  outline: none;
+}
+
+.lead {
+  font-size: 1.2rem;
+}
+
+.section-link {
+  font-weight: 700;
+}
+
+/* Footer */
+.site-footer {
+  background: var(--footer-bg);
+  color: var(--footer-ink);
+  padding: 2rem 0;
+}
+
+.site-footer p {
+  margin: 0 0 0.5em;
+}
+
+/* Buttons */
+.button {
+  display: inline-flex;
+  align-items: center;
+  min-height: 44px;
+  padding: 0.5rem 1.25rem;
+  border: 0;
+  border-radius: 4px;
+  background: var(--accent);
+  color: var(--bg);
+  font: inherit;
+  font-weight: 700;
+  text-decoration: none;
+  cursor: pointer;
+}
+
+/* Home page */
+.event-teaser {
+  border-left: 4px solid var(--accent);
+  padding: 0.25rem 0 0.25rem 1rem;
+}
+
+.link-grid {
+  display: grid;
+  gap: 0.75rem;
+  grid-template-columns: 1fr;
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.link-grid a {
+  display: block;
+  min-height: 44px;
+  padding: 0.75rem 1rem;
+  border: 1px solid var(--muted);
+  border-radius: 6px;
+  background: #fff;
+  text-decoration: none;
+  font-weight: 700;
+}
+
+/* Books: catalogue, filter and covers */
+.filter {
+  border: 1px solid var(--rule);
+  border-radius: 6px;
+  padding: 0.75rem 1rem 1rem;
+  margin: 1.5rem 0;
+  min-width: 0;
+}
+
+.filter legend {
+  font-weight: 700;
+  padding: 0 0.25rem;
+}
+
+.filter__options {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.5rem;
+}
+
+.filter__option {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.5rem;
+  min-height: 44px;
+  padding: 0.5rem 0.9rem;
+  border: 1px solid var(--muted);
+  border-radius: 999px;
+  cursor: pointer;
+}
+
+.filter__option:has(input:checked) {
+  background: var(--ink);
+  border-color: var(--ink);
+  color: var(--bg);
+  font-weight: 700;
+}
+
+.filter__option input {
+  width: 20px;
+  height: 20px;
+  margin: 0;
+  accent-color: var(--accent);
+}
+
+.book-count {
+  font-weight: 700;
+  margin-bottom: 1rem;
+}
+
+.book-list,
+.event-list {
+  display: grid;
+  gap: 1.25rem;
+  grid-template-columns: 1fr;
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.book {
+  display: flex;
+  gap: 1rem;
+  align-items: flex-start;
+  padding: 1rem;
+  border: 1px solid var(--rule);
+  border-radius: 6px;
+  background: #fff;
+}
+
+.book__cover {
+  position: relative;
+  flex: 0 0 72px;
+  height: 108px;
+  border-radius: 3px 6px 6px 3px;
+  box-shadow: inset 6px 0 0 rgba(0, 0, 0, 0.18);
+}
+
+.book__cover::after {
+  content: "";
+  position: absolute;
+  left: 14px;
+  right: 10px;
+  top: 22px;
+  height: 6px;
+  background: rgba(253, 250, 244, 0.85);
+}
+
+.book__body {
+  min-width: 0;
+}
+
+.book__body h3 {
+  margin-bottom: 0.2em;
+}
+
+.book__author,
+.book__meta {
+  margin: 0;
+  color: var(--muted);
+  font-size: 0.95rem;
+}
+
+.book__blurb {
+  margin: 0.5rem 0 0;
+  font-size: 0.97rem;
+}
+
+.cover--fiction { background: linear-gradient(160deg, #3d5a6c, #22363f); }
+.cover--poetry { background: linear-gradient(160deg, #5b6e4a, #33402a); }
+.cover--essays { background: linear-gradient(160deg, #8a5a2b, #4f3216); }
+.cover--mystery { background: linear-gradient(160deg, #4a3f6b, #2a2340); }
+.cover--childrens { background: linear-gradient(160deg, #a0523b, #62301f); }
+
+/* Events */
+.event {
+  padding: 1rem 1.25rem;
+  border-left: 4px solid var(--accent);
+  background: #fff;
+}
+
+.event h2 {
+  margin: 0 0 0.25rem;
+  font-size: 1.25rem;
+}
+
+.event__when,
+.event__booking {
+  margin: 0;
+  color: var(--muted);
+  font-weight: 700;
+}
+
+.event p:last-child {
+  margin: 0.5rem 0 0;
+}
+
+/* Visit */
+.hours {
+  width: 100%;
+  max-width: 28rem;
+  border-collapse: collapse;
+}
+
+.hours th,
+.hours td {
+  text-align: left;
+  padding: 0.5rem 0.25rem;
+  border-bottom: 1px solid var(--rule);
+}
+
+.form {
+  max-width: 36rem;
+}
+
+.field {
+  margin-bottom: 1.25rem;
+}
+
+.field label {
+  display: block;
+  font-weight: 700;
+  margin-bottom: 0.25rem;
+}
+
+.field__hint {
+  display: block;
+  color: var(--muted);
+  font-size: 0.95rem;
+  margin-bottom: 0.25rem;
+}
+
+.field input,
+.field textarea {
+  display: block;
+  width: 100%;
+  min-height: 44px;
+  padding: 0.5rem 0.75rem;
+  border: 1px solid var(--muted);
+  border-radius: 4px;
+  background: #fff;
+  color: var(--ink);
+  font: inherit;
+}
+
+.field textarea {
+  min-height: 10rem;
+  resize: vertical;
+}
+
+.field input[aria-invalid="true"],
+.field textarea[aria-invalid="true"] {
+  border: 2px solid var(--error);
+}
+
+.field-error {
+  margin: 0.25rem 0 0;
+  color: var(--error);
+  font-weight: 700;
+}
+
+.field-error:empty {
+  display: none;
+}
+
+.form-status {
+  margin-top: 1.25rem;
+  padding: 1rem;
+  border-left: 4px solid var(--accent);
+  background: #fff;
+}
+
+/* Kept in the page when empty so screen readers announce the text when it arrives. */
+.form-status:empty {
+  padding: 0;
+  border: 0;
+}
+
+.form-status:focus {
+  outline: 3px solid var(--accent);
+  outline-offset: 3px;
+}
+
+.empty-message {
+  padding: 1rem;
+  border: 1px dashed var(--muted);
+  border-radius: 6px;
+}
+
+/* Wider screens */
+@media (min-width: 640px) {
+  .book-list {
+    grid-template-columns: repeat(2, 1fr);
+  }
+
+  .link-grid {
+    grid-template-columns: repeat(2, 1fr);
+  }
+}
+
+@media (min-width: 1024px) {
+  .book-list {
+    grid-template-columns: repeat(3, 1fr);
+  }
+
+  .link-grid {
+    grid-template-columns: repeat(4, 1fr);
+  }
+}
