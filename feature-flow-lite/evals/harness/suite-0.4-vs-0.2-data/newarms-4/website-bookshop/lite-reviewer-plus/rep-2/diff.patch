+    } catch (err) {
+      failed++;
+      console.log(`FAIL [${t.group}] ${t.name}`);
+      console.log(`     ${err.message.split('\n')[0]}`);
+    } finally {
+      await Promise.all(sessions.map((s) => s.context.close()));
+    }
+  }
+} finally {
+  await browser.close();
+  server.close();
+}
+
+console.log(`\n${passed} passed, ${failed} failed, ${selected.length} total${only ? ` (group: ${only})` : ''}`);
+process.exit(failed > 0 ? 1 : 0);
