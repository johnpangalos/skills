+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Marginalia Books | Independent Bookshop in Wrenfield</title>
+  <meta name="description" content="Marginalia Books is an independent bookshop on Chandler Lane in Wrenfield. We stock fiction, poetry, nature writing, history and children's books, and host readings all winter.">
+  <link rel="icon" href="data:,">
+  <link rel="stylesheet" href="css/styles.css">
+  <script defer src="js/data.js"></script>
+  <script defer src="js/site.js"></script>
+  <script defer src="js/home.js"></script>
+</head>
+<body>
+  <a class="skip-link" href="#main">Skip to main content</a>
+  <header class="site-header">
+    <div class="header-inner">
+      <a class="brand" href="index.html">Marginalia Books</a>
+      <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
+    </div>
+    <nav id="site-nav" class="site-nav" aria-label="Main">
+      <ul>
+        <li><a href="index.html" aria-current="page">Home</a></li>
+        <li><a href="books.html">Books</a></li>
+        <li><a href="events.html">Events</a></li>
+        <li><a href="visit.html">Visit</a></li>
+      </ul>
+    </nav>
+  </header>
+
+  <main id="main" tabindex="-1">
+    <div class="wrap">
+      <section class="intro">
+        <h1>Marginalia Books</h1>
+        <p class="lead">An independent bookshop on Chandler Lane in Wrenfield, named after the notes people make in the margins of the books they love.</p>
+        <div class="cta-row">
+          <a class="button" href="books.html">Browse the books</a>
+          <a class="button button-secondary" href="events.html">See upcoming events</a>
+          <a class="button button-secondary" href="visit.html">Plan your visit</a>
+        </div>
+      </section>
