+++ b/tests/run.mjs
@@ -0,0 +1,695 @@
+// Headless browser tests for the Marginalia Books site.
+// Run: NODE_PATH=$(npm root -g) node tests/run.mjs [--grep <name>]
+// Starts its own static server on a free port, loads every page in Chromium and checks the acceptance criteria.
+
+import assert from 'node:assert/strict';
+import http from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { createRequire } from 'node:module';
+import path from 'node:path';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+
+const require = createRequire(import.meta.url);
+const { chromium } = require('playwright');
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const PAGES = ['index.html', 'books.html', 'events.html', 'visit.html'];
+const NAV_HREFS = ['index.html', 'books.html', 'events.html', 'visit.html'];
+const TYPES = {
+  '.html': 'text/html; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.js': 'text/javascript; charset=utf-8',
+  '.svg': 'image/svg+xml',
+  '.png': 'image/png',
+  '.jpg': 'image/jpeg'
+};
+
+function startServer() {
+  const server = http.createServer(async (req, res) => {
+    try {
+      const urlPath = decodeURIComponent(new URL(req.url, 'http://localhost').pathname);
+      const relative = urlPath === '/' ? 'index.html' : urlPath.replace(/^\/+/, '');
+      const file = path.resolve(ROOT, relative);
+      if (!file.startsWith(ROOT + path.sep)) {
+        res.writeHead(403).end('Forbidden');
+        return;
+      }
+      const body = await readFile(file);
+      res.writeHead(200, { 'Content-Type': TYPES[path.extname(file)] || 'application/octet-stream' });
+      res.end(body);
+    } catch {
+      res.writeHead(404).end('Not found');
+    }
+  });
+  return new Promise((resolve) => server.listen(0, '127.0.0.1', () => resolve(server)));
+}
