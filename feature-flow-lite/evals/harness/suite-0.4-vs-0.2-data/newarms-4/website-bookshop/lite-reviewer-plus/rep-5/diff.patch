+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Browse Books by Genre | Marginalia Books</title>
+  <meta name="description" content="Browse the Marginalia Books catalogue: mysteries, science fiction, literary fiction, poetry, nature writing, history and young readers. Filter by genre.">
+  <link rel="icon" href="data:,">
+  <link rel="stylesheet" href="css/styles.css">
+  <script defer src="js/data.js"></script>
+  <script defer src="js/site.js"></script>
+  <script defer src="js/books.js"></script>
+</head>
+<body>
+  <a class="skip-link" href="#main">Skip to main content</a>
+  <header class="site-header">
+    <div class="header-inner">
+      <a class="brand" href="index.html">Marginalia Books</a>
+      <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
+    </div>
+    <nav id="site-nav" class="site-nav" aria-label="Main">
+      <ul>
+        <li><a href="index.html">Home</a></li>
+        <li><a href="books.html" aria-current="page">Books</a></li>
+        <li><a href="events.html">Events</a></li>
+        <li><a href="visit.html">Visit</a></li>
+      </ul>
+    </nav>
+  </header>
+
+  <main id="main" tabindex="-1">
+    <div class="wrap">
+      <h1>Books</h1>
+      <p>Every title here is on our shelves or can be ordered in within three working days. Choose a genre to narrow the list; your choice is kept in the page address, so you can bookmark it or send it to a friend.</p>
+
+      <fieldset class="filter">
+        <legend>Filter by genre</legend>
+        <div class="filter-options" id="genre-options"></div>
+      </fieldset>
+
+      <div class="result-status" role="status">
+        <p class="result-count" id="result-count"></p>
+        <p class="filter-note" id="filter-note" hidden></p>
+      </div>
+
+      <p class="empty-note" id="empty-state" hidden>No books match this genre yet. <a href="books.html">Show every book</a>.</p>
+
+      <h2>Catalogue</h2>
+      <ul class="card-grid" id="book-list"></ul>
+    </div>
+  </main>
+
+  <footer class="site-footer">
+    <div class="wrap">
+      <p class="footer-name">Marginalia Books</p>
+      <address>21 Chandler Lane, Wrenfield, WR4 2LP</address>
+      <p>Open seven days. Mon 10:00 to 18:00, Tue to Fri 09:30 to 18:30, Sat 09:00 to 18:00, Sun 11:00 to 16:00.</p>
+      <p>&copy; <span id="year">2026</span> Marginalia Books. Independent since 2011.</p>
+    </div>
+  </footer>
+</body>
+</html>
