+// Opens a page in a fresh browser context and records console errors, requests and dialogs.
+// Pass an absolute file: URL as pathName to test the file:// protocol.
+async function open(ctx, pathName, { width = 1280, height = 800, clock } = {}) {
+  const context = await ctx.browser.newContext({ viewport: { width, height } });
+  ctx.contexts.push(context);
+  const page = await context.newPage();
+  const seen = { errors: [], requests: [], dialogs: [] };
+  page.on('console', (message) => {
+    if (message.type() === 'error') {
+      seen.errors.push(message.text());
+    }
+  });
+  page.on('pageerror', (error) => seen.errors.push(error.message));
+  page.on('request', (request) => seen.requests.push(request.url()));
+  page.on('dialog', (dialog) => {
+    seen.dialogs.push(dialog.message());
+    dialog.dismiss();
+  });
+  if (clock) {
+    await page.clock.setFixedTime(clock);
+  }
+  const url = pathName.startsWith('file:') ? pathName : ctx.base + pathName;
+  await page.goto(url);
+  return { page, seen };
+}
+
+function assertLocalOnly(seen, base) {
+  const external = seen.requests.filter((url) => {
+    return !url.startsWith(base) && !url.startsWith('data:') && !url.startsWith('blob:') && !url.startsWith('file:');
+  });
+  assert.deepEqual(external, [], 'requests left the local origin');
+}
+
+function localDateIso() {
+  const now = new Date();
+  const pad = (n) => String(n).padStart(2, '0');
+  return `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
+}
