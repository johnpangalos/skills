+// WCAG relative luminance and contrast ratio for [r, g, b] colours.
+function luminance(rgb) {
+  const [r, g, b] = rgb.map((channel) => {
+    const c = channel / 255;
+    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
+  });
+  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
+}
+
+function contrast(a, b) {
+  const [light, dark] = [luminance(a), luminance(b)].sort((x, y) => y - x);
+  return (light + 0.05) / (dark + 0.05);
+}
+
+// Runs in the page: describes the focused element, its outline and the backgrounds it sits on.
+function focusState() {
+  const opaque = (node) => {
+    for (let current = node; current; current = current.parentElement) {
+      const parts = getComputedStyle(current).backgroundColor.match(/[\d.]+/g).map(Number);
+      if (parts.length === 3 || parts[3] > 0) {
+        return parts.slice(0, 3);
+      }
+    }
+    return [255, 255, 255];
+  };
+  const element = document.activeElement;
+  const style = getComputedStyle(element);
+  const named = element.labels?.[0] ?? element;
+  const box = element.closest('label') ?? element;
+  return {
+    tag: element.tagName,
+    text: named.textContent.trim().slice(0, 40),
+    value: element.type === 'radio' ? element.value : '',
+    outlineStyle: style.outlineStyle,
+    outlineWidth: parseFloat(style.outlineWidth),
+    outlineColor: style.outlineColor,
+    own: opaque(element),
+    surface: opaque(box.parentElement)
+  };
+}
+
+// The ring sits in the outline-offset gap, so it must contrast with the surface around the element.
+function assertFocusRing(state, where) {
+  assert.equal(state.outlineStyle, 'solid', `${where}: no focus outline`);
+  assert.ok(state.outlineWidth >= 2, `${where}: focus outline too thin`);
+  const ring = [...state.outlineColor.match(/[\d.]+/g).slice(0, 3).map(Number)];
+  const ratio = contrast(ring, state.surface);
+  assert.ok(ratio >= 3, `${where}: ring is ${ratio.toFixed(2)}:1 against the background behind it`);
+}
+
+// Presses Tab until focus leaves the page. With openMenu, the menu button is activated when reached.
+async function tabStops(page, { openMenu = false } = {}) {
+  const stops = [];
+  for (let step = 0; step < 80; step += 1) {
+    await page.keyboard.press('Tab');
+    const state = await page.evaluate(focusState);
+    if (state.tag === 'BODY') {
+      break;
+    }
+    stops.push(state);
+    if (openMenu && state.text === 'Menu') {
+      await page.keyboard.press('Enter');
+    }
+  }
+  return stops;
+}
+
