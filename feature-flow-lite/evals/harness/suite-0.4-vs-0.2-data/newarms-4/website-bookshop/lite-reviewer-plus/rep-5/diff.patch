+test('events-include-event-on-local-midnight-of-its-day', async (ctx) => {
+  const total = await (await open(ctx, '/events.html')).page.evaluate(() => SITE_DATA.events.length);
+  // Local midnight of 21 Nov 2026 in each zone. A date-only string parsed as UTC would count that day as past.
+  const zones = [
+    { timezoneId: 'America/Los_Angeles', midnight: new Date('2026-11-21T00:00:00-08:00') },
+    { timezoneId: 'Pacific/Auckland', midnight: new Date('2026-11-21T00:00:00+13:00') }
+  ];
+  for (const { timezoneId, midnight } of zones) {
+    const context = await ctx.browser.newContext({ timezoneId, viewport: { width: 1280, height: 800 } });
+    ctx.contexts.push(context);
+    const page = await context.newPage();
+    await page.clock.setFixedTime(midnight);
+    await page.goto(ctx.base + '/events.html');
+    const first = await page.$eval('#event-list time', (node) => node.getAttribute('datetime'));
+    assert.equal(first, '2026-11-21T19:00', `${timezoneId}: an event on the local current day is not treated as past`);
+    assert.equal(await page.locator('#event-list li').count(), total, `${timezoneId}: no event dropped`);
+  }
+});
