@@ -0,0 +1,528 @@
+/* Marginalia Books: paper and ink palette, system font stacks only, mobile-first. */
+:root {
+  --paper: #f6f0e4;        /* page background */
+  --paper-deep: #ece2cf;   /* panels and footer */
+  --card: #fffaf0;         /* cards and inputs */
+  --ink: #2b2118;          /* body text, 13:1 on paper */
+  --ink-soft: #5c4d3f;     /* secondary text, 7:1 on paper */
+  --oxblood: #7a2e2e;      /* links, prices, buttons, 8:1 on paper */
+  --error: #8a1c1c;        /* validation messages, 7:1 on paper */
+  --rule: #cbbb9c;         /* decorative borders only */
+  --focus: #4f7aa6;        /* focus ring: 3.5:1 on ink (dark chips), 3.5:1 on paper-deep, 4:1 on paper */
+  --focus-dark: #f2c46d;   /* focus ring on the ink header */
+  --serif: Georgia, "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Palatino, "Times New Roman", serif;
+  --sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
+}
+
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+
+[hidden] {
+  display: none !important;
+}
+
+html {
+  -webkit-text-size-adjust: 100%;
+}
+
+body {
+  margin: 0;
+  background: var(--paper);
+  color: var(--ink);
+  font-family: var(--sans);
+  font-size: 1.0625rem;
+  line-height: 1.6;
+  overflow-wrap: anywhere;
+}
+
+h1,
+h2,
+h3 {
+  font-family: var(--serif);
+  line-height: 1.25;
+  color: var(--ink);
+}
+
+h1 {
+  font-size: 2rem;
+  margin: 0 0 0.75rem;
+}
+
+h2 {
+  font-size: 1.5rem;
+  margin: 2.25rem 0 0.75rem;
+  padding-top: 1.25rem;
+  border-top: 1px solid var(--rule);
+}
+
+h3 {
+  font-size: 1.15rem;
+  margin: 0.25rem 0 0.35rem;
+}
+
+p {
+  margin: 0 0 1rem;
+}
+
+a {
+  color: var(--oxblood);
+  text-underline-offset: 0.2em;
+}
+
+:focus-visible {
+  outline: 3px solid var(--focus);
+  outline-offset: 3px;
+}
+
+.wrap {
+  max-width: 1100px;
+  margin: 0 auto;
+  padding: 0 1rem;
+}
+
+.skip-link {
+  position: absolute;
+  left: 1rem;
+  top: -4rem;
+  z-index: 10;
+  padding: 0.5rem 1rem;
+  background: var(--card);
+  color: var(--ink);
+  font-weight: bold;
+}
+
+.skip-link:focus {
+  top: 0.5rem;
+}
+
+/* The skip link lands focus on #main; the page itself needs no ring. */
+main#main:focus {
+  outline: none;
+}
+
+/* Header and navigation */
+.site-header {
+  background: var(--ink);
+  color: var(--paper);
+}
+
+.header-inner {
+  max-width: 1100px;
+  margin: 0 auto;
+  padding: 0.75rem 1rem;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 1rem;
+}
+
+.brand {
+  font-family: var(--serif);
+  font-size: 1.35rem;
+  font-weight: bold;
+  color: var(--paper);
+}
+
+.site-header :focus-visible {
+  outline-color: var(--focus-dark);
+}
+
+.menu-toggle {
+  font: inherit;
+  padding: 0.4rem 0.9rem;
+  background: transparent;
+  color: var(--paper);
+  border: 1px solid var(--paper);
+  border-radius: 2px;
+  cursor: pointer;
+}
+
+.site-nav ul {
+  list-style: none;
+  padding: 0 1rem 1rem;
+  display: grid;
+  gap: 0.25rem;
+  max-width: 1100px;
+  margin: 0 auto;
+}
+
+.site-nav a {
+  display: block;
+  padding: 0.5rem 0.25rem;
+  color: var(--paper);
+}
+
+.site-nav a[aria-current="page"] {
+  font-weight: bold;
+  text-decoration: underline;
+  text-decoration-thickness: 2px;
+  text-underline-offset: 0.3em;
+}
+
+@media (max-width: 719px) {
+  .js .site-nav:not(.is-open) {
+    display: none;
+  }
+}
+
+/* Hero and content */
+.intro {
+  padding: 2.25rem 0 0.5rem;
+}
+
+.lead {
+  font-size: 1.2rem;
+}
+
+.cta-row {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.6rem;
+  margin: 1.25rem 0 0.5rem;
+}
+
+.button {
+  display: inline-block;
+  padding: 0.6rem 1.1rem;
+  background: var(--oxblood);
+  color: #fff;
+  border: 2px solid var(--oxblood);
+  border-radius: 2px;
+  font: inherit;
+  font-weight: bold;
+  text-decoration: none;
+  cursor: pointer;
+}
+
+.button-secondary {
+  background: transparent;
+  color: var(--oxblood);
+}
+
+.empty-note {
+  padding: 0.75rem 1rem;
+  background: var(--paper-deep);
+  border-left: 4px solid var(--ink-soft);
+}
+
+/* Book catalogue */
+.card-grid {
+  list-style: none;
+  margin: 0 0 1rem;
+  padding: 0;
+  display: grid;
+  gap: 1.25rem;
+  grid-template-columns: minmax(0, 1fr);
+}
+
+.book-card {
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 0.35rem;
+  padding: 1rem;
+  background: var(--card);
+  border: 1px solid var(--rule);
+}
+
+.cover {
+  height: 6.5rem;
+  margin-bottom: 0.5rem;
+  border-radius: 2px 6px 6px 2px;
+  box-shadow: inset 8px 0 0 rgba(0, 0, 0, 0.18);
+  background: #4a5568;
+}
+
+.cover[data-genre="mystery"] { background: #3d4a5c; }
+.cover[data-genre="science-fiction"] { background: #2f5d62; }
+.cover[data-genre="literary-fiction"] { background: #6b4c3b; }
+.cover[data-genre="poetry"] { background: #7a4a5e; }
+.cover[data-genre="nature-writing"] { background: #4b6b3a; }
+.cover[data-genre="history"] { background: #7b6a3a; }
+.cover[data-genre="young-readers"] { background: #8a5a2b; }
+
+.genre-tag {
+  margin: 0;
+  font-size: 0.8rem;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: var(--ink-soft);
+}
+
+.badge {
+  align-self: flex-start;
+  margin: 0;
+  padding: 0.1rem 0.5rem;
+  font-size: 0.75rem;
+  background: var(--ink);
+  color: var(--paper);
+}
+
+.book-author {
+  margin: 0;
+  font-style: italic;
+  color: var(--ink-soft);
+}
+
+.book-blurb {
+  margin: 0;
+  font-size: 0.97rem;
+}
+
+.book-price {
+  margin: auto 0 0;
+  padding-top: 0.5rem;
+  font-weight: bold;
+  color: var(--oxblood);
+}
+
+.filter {
+  margin: 0 0 1rem;
+  padding: 0.75rem 1rem 1rem;
+  background: var(--paper-deep);
+  border: 1px solid var(--rule);
+}
+
+.filter legend {
+  padding: 0 0.3rem;
+  font-weight: bold;
+}
+
+.filter-options {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.5rem;
+}
+
+.filter-options label {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.4rem;
+  padding: 0.35rem 0.75rem;
+  background: var(--card);
+  border: 1px solid var(--ink-soft);
+  border-radius: 999px;
+  cursor: pointer;
+}
+
+.filter-options label:has(input:checked) {
+  background: var(--ink);
+  border-color: var(--ink);
+  color: var(--paper);
+  font-weight: bold;
+}
+
+.filter-options input {
+  width: 1rem;
+  height: 1rem;
+  margin: 0;
+  accent-color: var(--oxblood);
+}
+
+.result-status {
+  margin: 0 0 1rem;
+}
+
+.result-status p {
+  margin: 0;
+}
+
+.result-count {
+  font-weight: bold;
+  color: var(--ink-soft);
+}
+
+.result-status p + p {
+  margin-top: 0.4rem;
+}
+
+.filter-note {
+  color: var(--ink);
+}
+
+/* Events */
+.event-list {
+  list-style: none;
+  margin: 0 0 1rem;
+  padding: 0;
+  display: grid;
+  gap: 1rem;
+}
+
+.event-card {
+  padding: 0.9rem 1rem;
+  background: var(--card);
+  border-left: 4px solid var(--oxblood);
+}
+
+.event-card h3 {
+  margin-top: 0.15rem;
+}
+
+.event-when {
+  display: block;
+  font-weight: bold;
+  color: var(--oxblood);
+}
+
+.event-text {
+  margin: 0 0 0.35rem;
+}
+
+.booking {
+  margin: 0;
+  font-size: 0.9rem;
+  color: var(--ink-soft);
+}
+
+/* Visit */
+.hours-table {
+  width: 100%;
+  max-width: 28rem;
+  margin: 0 0 1.5rem;
+  border-collapse: collapse;
+}
+
+.hours-table caption {
+  padding-bottom: 0.5rem;
+  text-align: left;
+  font-family: var(--serif);
+  font-size: 1.15rem;
+  font-weight: bold;
+}
+
+.hours-table th,
+.hours-table td {
+  padding: 0.45rem 0.5rem;
+  text-align: left;
+  border-bottom: 1px solid var(--rule);
+  vertical-align: top;
+}
+
+.hours-table td {
+  white-space: nowrap;
+}
+
+.visit-grid {
+  display: grid;
+  gap: 1.5rem;
+}
+
+.contact-form {
+  max-width: 36rem;
+}
+
+.form-field {
+  display: grid;
+  gap: 0.3rem;
+  margin-bottom: 1rem;
+}
+
+.form-field label {
+  font-weight: bold;
+}
+
+.field-note {
+  font-weight: normal;
+  color: var(--ink-soft);
+}
+
+.form-field input,
+.form-field textarea {
+  width: 100%;
+  padding: 0.55rem 0.6rem;
+  font: inherit;
+  font-size: 1rem;
+  color: var(--ink);
+  background: #fffdf7;
+  border: 1px solid var(--ink-soft);
+  border-radius: 2px;
+}
+
+.form-field textarea {
+  min-height: 9rem;
+  resize: vertical;
+}
+
+.form-field input[aria-invalid="true"],
+.form-field textarea[aria-invalid="true"] {
+  border: 2px solid var(--error);
+}
+
+.field-error {
+  margin: 0;
+  font-weight: bold;
+  color: var(--error);
+}
+
+.form-status {
+  padding: 0.75rem 1rem;
+  background: var(--paper-deep);
+  border-left: 4px solid var(--ink);
+}
+
+/* Footer */
+.site-footer {
+  margin-top: 3rem;
+  padding: 1.5rem 0 2rem;
+  background: var(--paper-deep);
+  border-top: 1px solid var(--rule);
+  font-size: 0.95rem;
+}
+
+.site-footer p {
+  margin: 0 0 0.5rem;
+}
+
+.footer-name {
+  font-family: var(--serif);
+  font-weight: bold;
+}
+
+/* Wider screens */
+@media (min-width: 600px) {
+  h1 {
+    font-size: 2.5rem;
+  }
+
+  .card-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+}
+
+@media (min-width: 720px) {
+  .menu-toggle {
+    display: none;
+  }
+
+  .site-nav ul {
+    display: flex;
+    justify-content: flex-end;
+    gap: 1.5rem;
+    padding: 0 1rem 0.75rem;
+  }
+
+  .visit-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    align-items: start;
+  }
+}
+
+@media (min-width: 960px) {
+  .card-grid {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation: none !important;
+    transition: none !important;
+    scroll-behavior: auto !important;
+  }
+}
