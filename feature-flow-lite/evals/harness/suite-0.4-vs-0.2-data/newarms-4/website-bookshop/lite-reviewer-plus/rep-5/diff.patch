+async function main() {
+  const flag = process.argv.indexOf('--grep');
+  const grep = flag === -1 ? null : process.argv[flag + 1];
+  const selected = tests.filter((item) => !grep || item.name.includes(grep));
+  if (selected.length === 0) {
+    console.log(`No tests match "${grep}"`);
+    process.exitCode = 1;
+    return;
+  }
+
+  const server = await startServer();
+  const base = `http://127.0.0.1:${server.address().port}`;
+  const browser = await chromium.launch({ headless: true });
+  const ctx = { base, browser, contexts: [] };
+  let failures = 0;
+  try {
+    for (const item of selected) {
+      try {
+        await item.fn(ctx);
+        console.log(`PASS ${item.name}`);
+      } catch (error) {
+        failures += 1;
+        console.log(`FAIL ${item.name}`);
+        console.log(`     ${String(error.message).split('\n')[0]}`);
+      }
+    }
+  } finally {
+    for (const context of ctx.contexts) {
+      await context.close().catch(() => {});
+    }
+    await browser.close();
+    server.close();
+  }
+  console.log(`\n${selected.length - failures} passed, ${failures} failed`);
+  process.exitCode = failures > 0 ? 1 : 0;
+}
+
+main();
