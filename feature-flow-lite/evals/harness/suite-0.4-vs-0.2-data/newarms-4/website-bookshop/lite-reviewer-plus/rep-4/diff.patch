index 0000000..3ac00f8
--- /dev/null
+++ b/tests/site.test.js
@@ -0,0 +1,588 @@
+'use strict';
+
+// Headless-browser tests for the Marginalia Books site.
+// Run with: node --test tests/
+
+const { test, before, after, describe } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const http = require('node:http');
+const path = require('node:path');
+
+function loadPlaywright() {
+  try {
+    return require('/opt/node22/lib/node_modules/playwright');
+  } catch (error) {
+    return require('playwright');
+  }
+}
+
+const { chromium } = loadPlaywright();
+
+const ROOT = path.resolve(__dirname, '..');
+const PAGES = ['index.html', 'books.html', 'events.html', 'visit.html'];
+const CONTENT_TYPES = {
+  '.html': 'text/html; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.js': 'text/javascript; charset=utf-8',
+  '.svg': 'image/svg+xml'
+};
+const TODAY = '2026-11-17';
+const BOOK_TOTAL = 14;
+const DEMO_PATTERN = /This is a demo site, so your message wasn't sent\./;
+
+let server;
+let origin;
+let browser;
+
+function startServer() {
+  return new Promise((resolve) => {
+    const srv = http.createServer((req, res) => {
+      const urlPath = new URL(req.url, 'http://localhost').pathname;
+      const relative = urlPath === '/' ? 'index.html' : urlPath.slice(1);
+      const file = path.resolve(ROOT, relative);
+      const inRoot = file.startsWith(ROOT + path.sep);
+      if (!inRoot || !fs.existsSync(file) || fs.statSync(file).isDirectory()) {
+        res.writeHead(404, { 'Content-Type': 'text/plain; charset=utf-8' });
+        res.end('Not found');
+        return;
+      }
+      res.writeHead(200, { 'Content-Type': CONTENT_TYPES[path.extname(file)] || 'application/octet-stream' });
+      fs.createReadStream(file).pipe(res);
+    });
+    srv.listen(0, '127.0.0.1', () => resolve(srv));
+  });
+}
+
+async function openPage(urlPath, { width = 1280 } = {}) {
+  const context = await browser.newContext({ viewport: { width, height: 900 } });
+  const page = await context.newPage();
+  const log = {
+    consoleErrors: [],
+    pageErrors: [],
+    badResponses: [],
+    failedRequests: [],
+    offOrigin: [],
+    requests: []
+  };
+  page.on('console', (message) => {
+    if (message.type() === 'error') log.consoleErrors.push(message.text());
+  });
+  page.on('pageerror', (error) => log.pageErrors.push(error.message));
+  page.on('request', (request) => {
+    log.requests.push(request.url());
+    if (!request.url().startsWith(origin + '/')) log.offOrigin.push(request.url());
+  });
+  page.on('response', (response) => {
+    if (response.status() >= 400) log.badResponses.push(`${response.status()} ${response.url()}`);
+  });
+  page.on('requestfailed', (request) => log.failedRequests.push(request.url()));
+  await page.goto(origin + '/' + urlPath);
+  await page.waitForLoadState('load');
+  return { context, page, log };
+}
+
+async function withPage(urlPath, options, fn) {
+  const { context, page, log } = await openPage(urlPath, options);
+  try {
+    return await fn(page, log);
+  } finally {
+    await context.close();
+  }
+}
+
+function assertClean(log) {
+  assert.deepEqual(log.consoleErrors, [], 'console errors');
+  assert.deepEqual(log.pageErrors, [], 'uncaught page errors');
+  assert.deepEqual(log.badResponses, [], 'failed (4xx/5xx) responses');
+  assert.deepEqual(log.failedRequests, [], 'failed requests');
+  assert.deepEqual(log.offOrigin, [], 'requests outside the origin');
+}
+
+// Requests made by the page itself, ignoring the browser's favicon fetch.
+function pageRequests(log) {
+  return log.requests.filter((url) => !url.endsWith('/favicon.svg'));
+}
+
+async function visibleBooks(page) {
+  return page.$$eval('#book-list li', (items) =>
+    items.map((item) => ({ genre: item.dataset.genre, title: item.querySelector('h3').textContent }))
+  );
+}
+
+async function checkedGenres(page) {
+  return page.$$eval('input[name="genre"]:checked', (inputs) => inputs.map((input) => input.value));
+}
+
+async function fillValidForm(page) {
+  await page.fill('#name', 'Ada Reader');
+  await page.fill('#email', 'reader@example.com');
+  await page.selectOption('#topic', 'visit');
+  await page.fill('#message', 'Do you have a large-print copy of the mill ledgers?');
+}
+
+async function submitForm(page) {
+  await page.click('#contact-form button[type="submit"]');
+}
+
+before(async () => {
+  server = await startServer();
+  origin = `http://127.0.0.1:${server.address().port}`;
+  const launchOptions = { headless: true };
+  if (fs.existsSync('/usr/bin/google-chrome')) {
+    launchOptions.executablePath = '/usr/bin/google-chrome';
+  }
+  browser = await chromium.launch(launchOptions);
+});
+
+after(async () => {
+  if (browser) await browser.close();
+  if (server) server.close();
+});
+
+describe('page basics', () => {
+  test('all four pages load with no console errors, failed requests or off-origin requests', async () => {
+    for (const name of PAGES) {
+      await withPage(name, {}, async (page, log) => {
+        const status = await page.evaluate(() => document.readyState);
+        assert.equal(status, 'complete', `${name} readyState`);
+        assertClean(log);
+      });
+    }
+  });
+
+  test('each page has lang, a viewport meta, a unique title and exactly one h1', async () => {
+    const titles = new Set();
+    for (const name of PAGES) {
+      await withPage(name, {}, async (page) => {
+        const info = await page.evaluate(() => ({
+          lang: document.documentElement.lang,
+          viewport: Boolean(document.querySelector('meta[name="viewport"]')),
+          title: document.title,
+          h1Count: document.querySelectorAll('h1').length
+        }));
+        assert.equal(info.lang, 'en', `${name} lang`);
+        assert.ok(info.viewport, `${name} viewport meta`);
+        assert.ok(info.title.length > 0, `${name} title`);
+        assert.equal(info.h1Count, 1, `${name} h1 count`);
+        titles.add(info.title);
+      });
+    }
+    assert.equal(titles.size, PAGES.length, 'titles are unique');
+  });
+
+  test('no page contains lorem ipsum', async () => {
+    for (const name of PAGES) {
+      await withPage(name, {}, async (page) => {
+        const text = await page.evaluate(() => document.body.textContent);
+        assert.doesNotMatch(text, /lorem ipsum/i, name);
+      });
+    }
+  });
+
+  test('shared nav links all four pages and only the current page has aria-current', async () => {
+    for (const name of PAGES) {
+      await withPage(name, {}, async (page) => {
+        const links = await page.$$eval('nav[aria-label="Main"] a', (anchors) =>
+          anchors.map((anchor) => ({ href: anchor.getAttribute('href'), current: anchor.getAttribute('aria-current') }))
+        );
+        assert.deepEqual(links.map((link) => link.href), PAGES, `${name} nav links`);
+        const current = links.filter((link) => link.current === 'page').map((link) => link.href);
+        assert.deepEqual(current, [name], `${name} aria-current`);
+      });
+    }
+  });
+
+  test('every page has a footer with the address and hours summary', async () => {
+    for (const name of PAGES) {
+      await withPage(name, {}, async (page) => {
+        const footer = await page.textContent('footer');
+        assert.match(footer, /12 Quill Street, Fernbrook/, name);
+        assert.match(footer, /Closed Mondays/, name);
+      });
+    }
+  });
+
+  test('skip link is the first focusable element, is visible on focus and moves focus to main', async () => {
+    for (const name of PAGES) {
+      await withPage(name, {}, async (page) => {
+        await page.keyboard.press('Tab');
+        const href = await page.evaluate(() => document.activeElement.getAttribute('href'));
+        assert.equal(href, '#main', `${name} first tab stop`);
+        const box = await page.locator('.skip-link').boundingBox();
+        assert.ok(box && box.y >= 0 && box.width > 0 && box.height > 0, `${name} skip link box ${JSON.stringify(box)}`);
+        await page.keyboard.press('Enter');
+        const activeId = await page.evaluate(() => document.activeElement.id);
+        assert.equal(activeId, 'main', `${name} focus after skip`);
+      });
+    }
+  });
+
+  test('headings start at h1 and never skip a level', async () => {
+    for (const name of PAGES) {
+      await withPage(name, {}, async (page) => {
+        const levels = await page.$$eval('h1, h2, h3, h4, h5, h6', (headings) =>
+          headings.map((heading) => Number(heading.tagName[1]))
+        );
+        assert.equal(levels[0], 1, `${name} first heading`);
+        let previous = 0;
+        for (const level of levels) {
+          assert.ok(level <= previous + 1, `${name}: h${level} follows h${previous}`);
+          previous = level;
+        }
+      });
+    }
+  });
+
+  test('every focusable control shows a visible focus indicator', async () => {
+    for (const name of PAGES) {
+      await withPage(name, {}, async (page) => {
+        const stops = await page.evaluate(() => document.querySelectorAll('a[href], button, input, select, textarea').length);
+        for (let i = 0; i < stops; i++) {
+          await page.keyboard.press('Tab');
+          const focus = await page.evaluate(() => {
+            const element = document.activeElement;
+            if (element === document.body) return null;
+            return {
+              id: element.id || element.tagName,
+              focusVisible: element.matches(':focus-visible'),
+              outlineStyle: getComputedStyle(element).outlineStyle
+            };
+          });
+          if (focus === null) break;
+          assert.ok(focus.focusVisible && focus.outlineStyle !== 'none', `${name}: ${focus.id} has no focus ring`);
+        }
+      });
+    }
+  });
+});
+
+describe('responsive layout', () => {
+  test('no page scrolls sideways at 360px, and none at 1280px either', async () => {
+    for (const name of PAGES) {
+      for (const width of [360, 1280]) {
+        await withPage(name, { width }, async (page) => {
