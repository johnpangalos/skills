+:root {
+  --paper: #f7f1e5;
+  --paper-deep: #efe5d1;
+  --ink: #2b2118;
+  --ink-soft: #5a4a3c;
+  --accent: #7a2e2e;
+  --accent-ink: #ffffff;
+  --line: #d6c7ab;
+  --line-strong: #6f5c47;
+  --field: #fffdf8;
+  --error: #9b1c1c;
+  --focus: #1f4e79;
+  --serif: Georgia, "Iowan Old Style", "Palatino Linotype", Palatino, "Times New Roman", serif;
+  --sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
+  color-scheme: light dark;
+}
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    --paper: #1c1712;
+    --paper-deep: #26201a;
+    --ink: #f2e9d8;
+    --ink-soft: #cdbfa6;
+    --accent: #e8b48f;
+    --accent-ink: #1c1712;
+    --line: #4a3f32;
+    --line-strong: #9a8a74;
+    --field: #2a2319;
+    --error: #ffb4a8;
+    --focus: #9cc9ff;
+  }
+}
+
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+
+[hidden] {
+  display: none !important;
+}
+
+body {
+  margin: 0;
+  background: var(--paper);
+  color: var(--ink);
+  font: 1rem/1.6 var(--sans);
+  overflow-wrap: break-word;
+}
+
+h1,
+h2,
+h3 {
+  font-family: var(--serif);
+  line-height: 1.2;
+  color: var(--ink);
+}
+
+h1 {
+  font-size: clamp(1.9rem, 5vw, 2.6rem);
+  margin: 0 0 1rem;
+}
+
+h2 {
+  font-size: clamp(1.4rem, 4vw, 1.8rem);
+  margin: 2.25rem 0 0.75rem;
+}
+
+h3 {
+  font-size: 1.15rem;
+  margin: 0.5rem 0 0.25rem;
+}
+
+p {
+  margin: 0 0 1rem;
+}
+
+a {
+  color: var(--accent);
+  text-underline-offset: 0.2em;
+}
+
+a:hover {
+  text-decoration-thickness: 2px;
+}
+
+:focus-visible {
+  outline: 3px solid var(--focus);
+  outline-offset: 2px;
+}
+
+main:focus {
+  outline: none;
+}
+
+.skip-link {
+  position: absolute;
+  left: 0.5rem;
+  top: 0.5rem;
+  z-index: 10;
+  padding: 0.6rem 1rem;
+  background: var(--ink);
+  color: var(--paper);
+  font-weight: 700;
+  border-radius: 4px;
+  transform: translateY(-200%);
+}
+
+.skip-link:focus {
+  transform: none;
+}
+
+/* Header and navigation */
+
+.site-header {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0.5rem 1.5rem;
+  padding: 1rem clamp(1rem, 4vw, 2rem);
+  border-bottom: 1px solid var(--line);
+  background: var(--paper-deep);
+}
+
+.brand {
+  margin: 0;
+  font-family: var(--serif);
+  font-size: 1.35rem;
+  font-weight: 700;
+}
+
+.brand a {
+  color: var(--ink);
+  text-decoration: none;
+}
+
+.nav-list {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.25rem 1.1rem;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.nav-list a {
+  display: inline-block;
+  padding: 0.35rem 0;
+  color: var(--ink-soft);
+  text-decoration: none;
+  border-bottom: 2px solid transparent;
+}
+
+.nav-list a:hover {
+  border-bottom-color: var(--line-strong);
+}
+
+.nav-list a[aria-current="page"] {
+  color: var(--ink);
+  font-weight: 700;
+  border-bottom-color: var(--accent);
+}
+
+/* Layout */
+
+main {
+  max-width: 56rem;
+  margin: 0 auto;
+  padding: 2rem clamp(1rem, 4vw, 2rem) 3rem;
+}
+
+.lead {
+  max-width: 40rem;
+  font-size: 1.15rem;
+  color: var(--ink-soft);
+}
+
+.button {
+  display: inline-block;
+  padding: 0.7rem 1.2rem;
+  border: 2px solid var(--accent);
+  border-radius: 4px;
+  background: var(--accent);
+  color: var(--accent-ink);
+  font: 700 1rem/1.2 var(--sans);
+  text-decoration: none;
+  cursor: pointer;
+}
+
+.button-secondary {
+  background: transparent;
+  color: var(--accent);
+}
+
+.button-row {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.75rem;
+  margin: 1.5rem 0 0;
+}
+
+.hint {
+  color: var(--ink-soft);
+  font-size: 0.92rem;
+}
+
+.site-footer {
+  padding: 1.5rem clamp(1rem, 4vw, 2rem);
+  border-top: 1px solid var(--line);
+  background: var(--paper-deep);
+  color: var(--ink-soft);
+  font-size: 0.95rem;
+}
+
+.site-footer address {
+  font-style: normal;
+  margin-bottom: 0.5rem;
+}
+
+.site-footer a {
+  color: var(--ink);
+}
+
+/* Books: covers, catalogue grid and genre filter */
+
+.cover {
+  width: 100%;
+  max-width: 9rem;
+  aspect-ratio: 2 / 3;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  margin-bottom: 0.75rem;
+  padding: 0.75rem;
+  background: var(--cover, #5b2333);
+  color: #ffffff;
+  font-family: var(--serif);
+  font-size: 0.95rem;
+  font-weight: 700;
+  line-height: 1.25;
+  text-align: center;
+  border-radius: 2px 6px 6px 2px;
+  box-shadow: inset 6px 0 0 rgba(0, 0, 0, 0.25), 0 6px 14px rgba(0, 0, 0, 0.2);
+}
+
+.book-list {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
+  gap: 1.5rem;
+  margin: 1.25rem 0 0;
+  padding: 0;
+  list-style: none;
+}
+
+.book,
+.event-list .event {
+  margin: 0;
+}
+
+.book {
+  display: flex;
+  flex-direction: column;
+  padding: 1rem;
+  border: 1px solid var(--line);
+  border-radius: 6px;
+  background: var(--field);
+}
+
+.book p {
+  margin: 0 0 0.5rem;
+}
+
+.book-author {
+  color: var(--ink-soft);
+  font-style: italic;
+}
+
+.book-meta {
+  font-size: 0.9rem;
+  color: var(--ink-soft);
+}
+
+.genre-filter {
+  min-width: 0;
+  margin: 1rem 0 0;
+  padding: 0.75rem 1rem 1rem;
+  border: 1px solid var(--line-strong);
+  border-radius: 6px;
+}
+
+.genre-filter legend {
+  padding: 0 0.3rem;
+  font-family: var(--serif);
+  font-weight: 700;
+}
+
+.genre-option {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.4rem;
+  margin: 0.25rem 0.4rem 0.25rem 0;
+  padding: 0.25rem 0.75rem;
+  border: 1px solid var(--line-strong);
+  border-radius: 999px;
+}
+
+.genre-option:has(input:checked) {
+  background: var(--accent);
+  border-color: var(--accent);
+}
+
+.genre-option:has(input:checked) label {
+  color: var(--accent-ink);
+}
+
+.genre-option input {
+  width: 1.1rem;
+  height: 1.1rem;
+  margin: 0;
+  accent-color: var(--accent);
+}
+
+.genre-option label {
+  display: inline-flex;
+  align-items: center;
+  min-height: 2.25rem;
+  cursor: pointer;
+}
+
+.result-count {
+  margin: 1rem 0 0;
+  font-weight: 700;
+}
+
+/* Events */
+
+.event-list {
+  display: grid;
+  gap: 1.25rem;
+  margin: 1.25rem 0 0;
+  padding: 0;
+  list-style: none;
+}
+
+.event {
+  padding: 0.25rem 0 0.25rem 1rem;
+  border-left: 4px solid var(--accent);
+}
+
+.event h2,
+.event h3 {
+  margin-top: 0.25rem;
+}
+
+.event time {
+  font-weight: 700;
+}
+
+.event-booking {
+  font-size: 0.95rem;
+  color: var(--ink-soft);
+}
+
+/* Visit: hours, address, contact form */
+
+.table-wrap {
+  overflow-x: auto;
+}
+
+table {
+  width: 100%;
+  max-width: 30rem;
+  border-collapse: collapse;
+}
+
+caption {
+  caption-side: top;
+  padding-bottom: 0.5rem;
+  text-align: left;
+  font-family: var(--serif);
+  font-size: 1.1rem;
+  font-weight: 700;
+}
+
+th,
+td {
+  padding: 0.6rem 0.75rem;
+  border-bottom: 1px solid var(--line);
+  text-align: left;
+}
+
+address {
+  font-style: normal;
+}
+
+.open-status {
+  font-weight: 700;
+}
+
+.contact-form {
+  display: grid;
+  gap: 1.1rem;
+  max-width: 36rem;
+  margin-top: 1rem;
+}
+
+.field {
+  display: grid;
+  gap: 0.35rem;
+}
+
+.field label {
+  font-weight: 700;
+}
+
+.field input,
+.field select,
+.field textarea {
+  width: 100%;
+  padding: 0.6rem 0.7rem;
+  border: 1px solid var(--line-strong);
+  border-radius: 4px;
+  background: var(--field);
+  color: var(--ink);
+  font: inherit;
+}
+
+.field [aria-invalid="true"] {
+  border: 2px solid var(--error);
+}
+
+.field-error {
+  margin: 0;
+  color: var(--error);
+  font-weight: 700;
+}
+
+.contact-form .button {
+  justify-self: start;
+}
+
+.form-status {
+  margin: 0;
+}
+
+.form-status:not(:empty) {
+  padding: 0.9rem 1rem;
+  border-left: 4px solid var(--accent);
+  border-radius: 4px;
+  background: var(--paper-deep);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    transition: none !important;
+    animation: none !important;
+    scroll-behavior: auto !important;
+  }
+}
