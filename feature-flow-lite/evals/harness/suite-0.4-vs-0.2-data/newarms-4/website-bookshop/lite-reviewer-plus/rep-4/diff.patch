+    <a href="tel:+15550142290">(555) 014-2290</a> · <a href="mailto:hello@marginalia.example">hello@marginalia.example</a>
+  </address>
+  <p>Open Tuesday to Friday 10:00 to 19:00, Saturday 9:00 to 18:00, Sunday 11:00 to 16:00. Closed Mondays.</p>
+</footer>
