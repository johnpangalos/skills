+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Events: Marginalia Books</title>
+  <meta name="description" content="Readings, workshops and story hours at Marginalia Books, with dates, times and whether booking is needed.">
