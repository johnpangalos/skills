+        assert.equal((await visibleBooks(page)).length, hostile.expectCount, `${hostile.query}: list size`);
+        assert.equal(state.announced, `Showing ${hostile.expectCount} of ${BOOK_TOTAL} books`, hostile.query);
+        assertClean(log);
+      });
+    }
