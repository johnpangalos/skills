+      { query: 'genre', expectGenre: '', expectCount: BOOK_TOTAL },
+      { query: 'genre=NotAGenre', expectGenre: '', expectCount: BOOK_TOTAL },
+      { query: 'genre=%3Cscript%3Ealert(1)%3C%2Fscript%3E', expectGenre: '', expectCount: BOOK_TOTAL },
+      { query: 'genre=MYSTERY', expectGenre: 'mystery', expectCount: 3 },
+      { query: 'genre=%20Poetry%20', expectGenre: 'poetry', expectCount: 2 },
+      { query: 'genre=poetry&genre=mystery', expectGenre: 'poetry', expectCount: 2 }
