+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Marginalia Books: an independent bookshop in Fernbrook</title>
+  <meta name="description" content="Marginalia Books is an independent bookshop on Quill Street in Fernbrook, with staff picks, events and visiting details.">
+  <link rel="icon" href="favicon.svg" type="image/svg+xml">
+  <link rel="stylesheet" href="css/styles.css">
+  <script src="js/main.js" defer></script>
+</head>
+<body>
+<a class="skip-link" href="#main">Skip to main content</a>
+<header class="site-header">
+  <p class="brand"><a href="index.html">Marginalia Books</a></p>
+  <nav aria-label="Main">
+    <ul class="nav-list">
+      <li><a href="index.html" aria-current="page">Home</a></li>
+      <li><a href="books.html">Books</a></li>
+      <li><a href="events.html">Events</a></li>
+      <li><a href="visit.html">Visit</a></li>
+    </ul>
+  </nav>
+</header>
+
+<main id="main" tabindex="-1">
+  <h1>Marginalia Books</h1>
+  <p class="lead">An independent bookshop on Quill Street in Fernbrook. We keep a short, carefully chosen shelf, a reading table by the front window, and a standing invitation to argue about the last chapter.</p>
+  <div class="button-row">
+    <a class="button" href="books.html">Browse the catalogue</a>
+    <a class="button button-secondary" href="events.html">See upcoming events</a>
+  </div>
+
+  <h2>Staff picks</h2>
+  <p>Three books the team keeps pressing into customers' hands this season.</p>
+  <ul class="book-list">
+    <li class="book">
+      <div class="cover" aria-hidden="true" style="--cover: #5b2333">The Clockmaker's Alibi</div>
+      <h3>The Clockmaker's Alibi</h3>
+      <p class="book-author">by Imogen Thorne</p>
+      <p class="book-meta">Mystery · $16.00</p>
+      <p class="book-desc">A watchmaker is found dead in a locked shop, and the only clue is a clock that has stopped four minutes early.</p>
+    </li>
+    <li class="book">
+      <div class="cover" aria-hidden="true" style="--cover: #23394d">Tidepool Almanac</div>
+      <h3>Tidepool Almanac</h3>
+      <p class="book-author">by June Halvorsen</p>
+      <p class="book-meta">Nature &amp; science · $22.00</p>
+      <p class="book-desc">A year of kneeling over rock pools, one month at a time, with notes on every creature that came to visit.</p>
+    </li>
+    <li class="book">
+      <div class="cover" aria-hidden="true" style="--cover: #7a2e2e">Mira and the Lantern Moth</div>
