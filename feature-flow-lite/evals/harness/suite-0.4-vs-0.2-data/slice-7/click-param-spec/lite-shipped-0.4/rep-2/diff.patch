+def _class_statement_stacklevel() -> int:
+    """Depth of the stack frame that executes the class statement, skipping
+    Click, ``abc``, and ``__init_subclass__`` or ``__new__`` hooks that run
+    during class creation.
+    """
+    frame: FrameType | None = sys._getframe(1)
+    level = 1
+
+    while frame is not None:
+        module = frame.f_globals.get("__name__", "")
+        in_click = module == "click" or module.startswith("click.")
+        in_hook = module == "abc" or frame.f_code.co_name in {
+            "__init_subclass__",
+            "__new__",
+        }
+
+        if not (in_click or in_hook):
+            return level
+
+        frame = frame.f_back
+        level += 1
+
+    return level
+
