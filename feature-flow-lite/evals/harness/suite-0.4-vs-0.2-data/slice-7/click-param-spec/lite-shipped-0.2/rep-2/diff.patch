+def _class_statement_stacklevel() -> int:
+    """Depth of the class statement that defines a subclass. Skips Click
+    frames, then the metaclass ``__new__`` and cooperative
+    ``__init_subclass__`` frames between that statement and the hook.
+
+    .. versionadded:: 8.6.0
+    """
+    frame: FrameType | None = sys._getframe(1)
+    level = 1
+
+    while frame is not None:
+        module = frame.f_globals.get("__name__", "")
+        is_click = module == "click" or module.startswith("click.")
+        name = frame.f_code.co_name
+
+        if not is_click and name not in {"__new__", "__init_subclass__"}:
+            return level
+
+        frame = frame.f_back
+        level += 1
+
+    return level
+
