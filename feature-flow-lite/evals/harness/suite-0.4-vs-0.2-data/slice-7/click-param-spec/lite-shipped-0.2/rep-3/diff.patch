         click.Argument(["a"], required=True, deprecated=True)
 
 
+def test_deprecated_required_names_spec():
+    with pytest.raises(ValueError) as exc_info:
+        click.Argument(["my-file"], required=True, deprecated=True)
+
+    assert str(exc_info.value) == (
+        "The argument 'MY_FILE' is deprecated and still required."
+        " A deprecated argument cannot be required."
+    )
+
+
+@pytest.mark.parametrize(
+    ("param_decls", "kwargs", "expected"),
+    [
+        (["filename"], {}, "FILENAME"),
+        (["filename"], {"metavar": "FILE"}, "FILE"),
+        (["my-file"], {}, "MY_FILE"),
+        (["my-file"], {"metavar": "FILE"}, "FILE"),
+    ],
+)
+def test_argument_spec(param_decls, kwargs, expected):
+    arg = click.Argument(param_decls, **kwargs)
+
+    assert arg.spec == expected
+    assert arg.get_error_hint(None) == f"'{expected}'"
+
+
+@pytest.mark.parametrize(
+    ("kwargs", "expected"),
+    [
+        ({}, "FILENAME"),
+        ({"metavar": "FILE"}, "FILE"),
+        ({"nargs": -1}, "[FILENAME]..."),
+        ({"nargs": -1, "required": True}, "FILENAME..."),
+    ],
+)
+def test_argument_get_help_spec(kwargs, expected):
+    ctx = click.Context(click.Command("cli"))
+    arg = click.Argument(["filename"], **kwargs)
+
+    assert arg.get_help_spec(ctx) == expected
+    assert arg.get_help_record(ctx) == (expected, "")
+
+
+def test_deprecated_argument_spec_has_no_bang():
+    ctx = click.Context(click.Command("cli"))
+    arg = click.Argument(["filename"], required=False, deprecated=True, default="x")
+
+    assert arg.spec == "FILENAME"
+    assert arg.get_help_spec(ctx) == "[FILENAME!]"
+    assert arg.get_error_hint(None) == "'FILENAME'"
+
+
