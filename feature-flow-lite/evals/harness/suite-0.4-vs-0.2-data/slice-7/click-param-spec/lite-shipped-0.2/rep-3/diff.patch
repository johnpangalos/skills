+def _class_statement_stacklevel() -> int:
+    """Depth of the frame running the class statement that is being created.
+
+    Skips ``__init_subclass__`` methods, including those of user mixins, and
+    the ``abc`` and Click frames between the statement and the warning.
+
+    .. versionadded:: 8.6.0
+    """
+    frame: FrameType | None = sys._getframe(1)
+    level = 1
+
+    while frame is not None:
+        module = frame.f_globals.get("__name__", "")
+
+        if not (
+            frame.f_code.co_name == "__init_subclass__"
+            or module == "abc"
+            or module == "click"
+            or module.startswith("click.")
+        ):
+            return level
+
+        frame = frame.f_back
+        level += 1
+
+    return level
+
+
