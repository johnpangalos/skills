+@pytest.mark.parametrize(
+    ("param", "expected"),
+    [
+        (click.Option(["-t", "--times"]), "--times"),
+        (click.Argument(["my-file"]), "MY_FILE"),
+    ],
+)
+def test_parameter_human_readable_name_deprecated(param, expected):
+    with pytest.warns(DeprecationWarning, match="Use 'spec' instead") as record:
+        assert param.human_readable_name == expected
+
+    assert record[0].filename == __file__
+
+
+def test_subclass_overriding_human_readable_name_warns():
+    with pytest.warns(DeprecationWarning, match="'MyOption' overrides") as record:
+        lineno = inspect.currentframe().f_lineno + 2
+
+        class MyOption(click.Option):
+            @property
+            def human_readable_name(self) -> str:
+                return super().human_readable_name
+
+    assert record[0].filename == __file__
+    assert record[0].lineno == lineno
+
+    with pytest.warns(DeprecationWarning, match="Use 'spec' instead"):
+        assert MyOption(["-t", "--times"]).human_readable_name == "--times"
+
+
+def test_mixin_subclass_overriding_human_readable_name_warns_at_class_statement():
+    class Mixin(click.Option):
+        def __init_subclass__(cls, **kwargs: object) -> None:
+            super().__init_subclass__(**kwargs)
+
+    with pytest.warns(DeprecationWarning, match="'UserOpt' overrides") as record:
+        lineno = inspect.currentframe().f_lineno + 2
+
+        class UserOpt(Mixin):
+            @property
+            def human_readable_name(self) -> str:
+                return "x"
+
+    assert record[0].filename == __file__
+    assert record[0].lineno == lineno
+
+
+def test_subclass_inheriting_human_readable_name_does_not_warn():
+    with pytest.warns(DeprecationWarning, match="'Base' overrides"):
+
+        class Base(click.Option):
+            @property
+            def human_readable_name(self) -> str:
+                return super().human_readable_name
+
+    with warnings.catch_warnings(record=True) as caught:
+        warnings.simplefilter("always")
+
+        class Child(Base):
+            pass
+
+    assert caught == []
+
+
+def test_subclass_overriding_spec_does_not_warn_and_is_used(runner):
+    with warnings.catch_warnings(record=True) as caught:
+        warnings.simplefilter("always")
+
+        class Flag(click.Option):
+            @property
+            def spec(self) -> str:
+                return "--custom"
+
+    assert caught == []
+
+    def cli(my_option):
+        click.echo(my_option)
+
+    cmd = click.Command(
+        "cli",
+        params=[Flag(["--my-option"], deprecated=True)],
+        callback=cli,
+    )
+    result = runner.invoke(cmd, ["--my-option", "hello"])
+    assert "The option '--custom' is deprecated." in result.output
