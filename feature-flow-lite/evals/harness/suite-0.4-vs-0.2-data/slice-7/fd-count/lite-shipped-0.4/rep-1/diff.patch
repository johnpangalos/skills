+/// Run *fd* with the given arguments and return its stdout.
+fn count_output(te: &TestEnv, args: &[&str]) -> String {
+    let output = te.assert_success_and_get_output(".", args);
+    String::from_utf8(output.stdout).expect("utf-8 output")
+}
+
+/// Print the number of matching entries (--count)
+#[test]
+fn test_count() {
+    let dirs = &["one", "two"];
+    let files = &[
+        "one/a.foo",
+        "one/b.foo",
+        "one/.hidden.foo",
+        "two/c.foo",
+        "two/d.bar",
+    ];
+    let te = TestEnv::new(dirs, files);
+
+    assert_eq!(count_output(&te, &["--count", "foo"]), "3\n");
+    assert_eq!(count_output(&te, &["--count", "-H", "foo"]), "4\n");
+    assert_eq!(count_output(&te, &["--count", "--glob", "*.bar"]), "1\n");
+    assert_eq!(count_output(&te, &["--count", "--extension", "foo"]), "3\n");
+    assert_eq!(
+        count_output(&te, &["--count", "--exclude", "a.foo", "foo"]),
+        "2\n"
+    );
+    assert_eq!(
+        count_output(&te, &["--count", "--type", "directory"]),
+        "2\n"
+    );
+    assert_eq!(count_output(&te, &["--count", "--type", "empty"]), "4\n");
+    assert_eq!(
+        count_output(&te, &["--count", "--max-depth=1", "foo"]),
+        "0\n"
+    );
+    assert_eq!(
+        count_output(&te, &["--count", "--color=always", "foo"]),
+        "3\n"
+    );
+}
+
+/// Count with several search paths and overlapping paths
+#[test]
+fn test_count_multiple_paths() {
+    let dirs = &["one", "two"];
+    let files = &["one/a.foo", "one/b.foo", "two/c.foo"];
+    let te = TestEnv::new(dirs, files);
+
+    assert_eq!(count_output(&te, &["--count", "foo", "one", "two"]), "3\n");
+
+    // The same path given twice is counted the way plain output prints it
+    let plain = te.assert_success_and_get_output(".", &["foo", "one", "one"]);
+    let lines = plain.stdout.iter().filter(|&&b| b == b'\n').count();
+    assert_eq!(
+        count_output(&te, &["--count", "foo", "one", "one"]),
+        format!("{lines}\n")
+    );
+}
+
+/// Count caps with --max-results and -1, and 0 meaning unlimited
+#[test]
+fn test_count_max_results() {
+    let dirs = &["one", "two"];
+    let files = &["one/a.foo", "one/b.foo", "two/c.foo"];
+    let te = TestEnv::new(dirs, files);
+
+    assert_eq!(
+        count_output(&te, &["--count", "--max-results=2", "foo"]),
+        "2\n"
+    );
+    assert_eq!(
+        count_output(&te, &["--count", "--max-results=10", "foo"]),
+        "3\n"
+    );
+    assert_eq!(
+        count_output(&te, &["--count", "--max-results=0", "foo"]),
+        "3\n"
+    );
+    assert_eq!(count_output(&te, &["--count", "-1", "foo"]), "1\n");
+    assert_eq!(count_output(&te, &["--count", "-1", "nomatch"]), "0\n");
+}
+
+/// No matches print 0 and exit with code 0
+#[test]
+fn test_count_no_matches() {
+    let te = TestEnv::new(&["one"], &["one/a.foo"]);
+
+    let output = te.assert_success_and_get_output(".", &["--count", "nomatch"]);
+    assert_eq!(output.stdout, b"0\n");
+}
+
+/// Conflicting options are usage errors (exit code 2), in either order
+#[test]
+fn test_count_conflicts() {
+    let te = TestEnv::new(&[], &["a.foo"]);
+
+    let usage_errors: &[(&[&str], &str)] = &[
+        (
+            &["--count", "-x", "echo"],
+            "error: the argument '--count' cannot be used with '--exec <cmd>...'",
+        ),
+        (
+            &["--count", "-X", "echo"],
+            "error: the argument '--count' cannot be used with '--exec-batch <cmd>...'",
+        ),
+        (
+            &["--count", "-l"],
+            "error: the argument '--count' cannot be used with '--list-details'",
+        ),
+        (
+            &["--count", "--format", "{}"],
+            "error: the argument '--count' cannot be used with '--format <fmt>'",
+        ),
+        (
+            &["--count", "-0"],
+            "error: the argument '--count' cannot be used with '--print0'",
+        ),
+        (
+            &["--count", "-q"],
+            "error: the argument '--count' cannot be used with '--quiet'",
+        ),
+        (
+            &["--count", "--has-results"],
+            "error: the argument '--count' cannot be used with '--quiet'",
+        ),
+        (
+            &["-l", "--count"],
+            "error: the argument '--list-details' cannot be used with '--count'",
+        ),
+        (
+            &["--format", "{}", "--count"],
+            "error: the argument '--format <fmt>' cannot be used with '--count'",
+        ),
+        (
+            &["-0", "--count"],
+            "error: the argument '--print0' cannot be used with '--count'",
+        ),
+        (
+            &["-q", "--count"],
+            "error: the argument '--quiet' cannot be used with '--count'",
+        ),
+        (
+            &["-x", "echo", ";", "--count"],
+            "error: the argument '--exec <cmd>...' cannot be used with '--count'",
+        ),
+        (
+            &["-X", "echo", ";", "--count"],
+            "error: the argument '--exec-batch <cmd>...' cannot be used with '--count'",
+        ),
+    ];
+    for (args, message) in usage_errors {
+        let status = te.assert_error(args, message);
+        assert_eq!(status.code(), Some(2), "{args:?}");
+    }
+}
