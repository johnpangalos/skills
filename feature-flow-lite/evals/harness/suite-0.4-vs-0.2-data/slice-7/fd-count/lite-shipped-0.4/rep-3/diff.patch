+#[test]
+fn test_count() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+
+    // Only the number of results is printed
+    te.assert_output(&["--count", "--type=f", "foo"], "5");
+    te.assert_output(&["--count", "--type=f", "--extension=foo"], "4");
+
+    // Search options apply as usual
+    te.assert_output(&["--count", "--type=f", "--hidden", "foo"], "6");
+    te.assert_output(&["--count", "--type=f", "--no-ignore", "foo"], "7");
+    te.assert_output(&["--count", "--type=f", "--exclude=one", "foo"], "1");
+    te.assert_output(&["--count", "--type=f", "--max-depth=2", "foo"], "2");
+
+    // One total for several search paths, overlapping paths included
+    te.assert_output(
+        &["--count", "--type=f", "foo", "one/two", "one/two/three"],
+        "4",
+    );
+
+    // --max-results and -1 cap the count, --max-results=0 means no cap
+    te.assert_output(&["--count", "--type=f", "--max-results=2", "foo"], "2");
+    te.assert_output(&["--count", "--type=f", "-1", "foo"], "1");
+    te.assert_output(&["--count", "--type=f", "--max-results=0", "foo"], "5");
+
+    // No matches print zero
+    te.assert_output(&["--count", "no-such-entry"], "0");
+    te.assert_output(&["--count", "-1", "no-such-entry"], "0");
+
+    // A slow search still prints only the count
+    te.assert_output(&["--count", "--type=f", "--max-buffer-time=0", "foo"], "5");
+}
+
+#[test]
+fn test_count_more_than_buffer_length() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+    for i in 0..1100 {
+        std::fs::write(te.test_root().join(format!("bulk{i}.txt")), "").unwrap();
+    }
+
+    te.assert_output(&["--count", "--type=f", "bulk"], "1100");
+}
+
+#[cfg(unix)]
+#[test]
+fn test_count_name_with_newline() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+    std::fs::write(te.test_root().join("new\nline.foo"), "").unwrap();
+
+    // The entry counts once, whatever its name contains
+    te.assert_output(&["--count", "--type=f", "foo"], "6");
+}
+
+#[test]
+fn test_count_conflicts() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+
+    let assert_conflict = |option: &str, message: &str| {
+        let status = te.assert_error(&["--count", option, "foo"], message);
+        assert_eq!(status.code(), Some(2));
+    };
+    assert_conflict(
+        "--quiet",
+        "error: the argument '--count' cannot be used with '--quiet'",
+    );
+    assert_conflict(
+        "--has-results",
+        "error: the argument '--count' cannot be used with '--quiet'",
+    );
+    assert_conflict(
+        "--print0",
+        "error: the argument '--count' cannot be used with '--print0'",
+    );
+    assert_conflict(
+        "--format={}",
+        "error: the argument '--count' cannot be used with '--format <fmt>'",
+    );
+    assert_conflict(
+        "--list-details",
+        "error: the argument '--count' cannot be used with '--list-details'",
+    );
+    assert_conflict(
+        "--exec=cat",
+        "error: the argument '--count' cannot be used with '--exec <cmd>...'",
+    );
+    assert_conflict(
+        "--exec-batch=cat",
+        "error: the argument '--count' cannot be used with '--exec-batch <cmd>...'",
+    );
+
+    // The order of the options does not matter
+    let status = te.assert_error(
+        &["--quiet", "--count", "foo"],
+        "error: the argument '--quiet' cannot be used with '--count'",
+    );
+    assert_eq!(status.code(), Some(2));
+}
