+    /// Output the number of results, unless we were interrupted.
+    fn print_count(&mut self) -> Result<(), ExitCode> {
+        if self.interrupt_flag.load(Ordering::Relaxed) {
+            return Err(ExitCode::KilledBySigint);
+        }
+
+        if let Err(e) = writeln!(self.stdout, "{}", self.num_results) {
+            if e.kind() != ::std::io::ErrorKind::BrokenPipe {
+                print_error!("Could not write to output: {}", e);
+            }
+            return Err(ExitCode::GeneralError);
+        }
+
+        self.flush()
+    }
+
     /// Stop looping.
     fn stop(&mut self) -> Result<(), ExitCode> {
+        if self.config.count {
+            self.print_count()?;
+            return Err(ExitCode::Success);
+        }
+
