+/// Assert that `--count` prints the number of entries that the same arguments list.
+fn assert_count_matches_listing(te: &TestEnv, args: &[&str]) {
+    let listing = te.assert_success_and_get_output(".", args);
+    let expected = format!(
+        "{}\n",
+        String::from_utf8_lossy(&listing.stdout).lines().count()
+    );
+
+    let mut count_args = vec!["--count"];
+    count_args.extend_from_slice(args);
+    te.assert_output_raw(&count_args, expected.as_bytes());
+}
+
+/// Print the number of matching entries instead of the entries (--count)
+#[test]
+fn test_count() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+
+    te.assert_output_raw(&["--count", "c.foo"], b"2\n");
+    te.assert_output_raw(&["--count", "--count", "c.foo"], b"2\n");
+
+    // Filters apply as usual
+    assert_count_matches_listing(&te, &["--type", "f", "foo"]);
+    assert_count_matches_listing(&te, &["--type", "d"]);
+    assert_count_matches_listing(&te, &["--extension", "foo"]);
+    assert_count_matches_listing(&te, &["--hidden", "foo"]);
+    assert_count_matches_listing(&te, &["--no-ignore", "foo"]);
+    assert_count_matches_listing(&te, &["--exclude", "one", "foo"]);
+    assert_count_matches_listing(&te, &["--max-depth", "2", "foo"]);
+    assert_count_matches_listing(&te, &["--full-path", "two/c"]);
+    assert_count_matches_listing(&te, &["--glob", "*.foo"]);
+
+    // Several search paths give one total, including duplicates
+    assert_count_matches_listing(&te, &["c.foo", "one", "one/two"]);
+    assert_count_matches_listing(&te, &["c.foo", "one/two", "one"]);
+
+    // A missing search path is reported, the valid ones are still counted
+    te.assert_output_raw(&["--count", "c.foo", "missing", "one"], b"2\n");
+    let status = te.assert_error(
+        &["--count", "c.foo", "missing", "one"],
+        "[fd error]: Search path \"missing\" is not a directory.",
+    );
+    assert_eq!(status.code(), Some(0));
+
+    // No valid search path is an error without a count
+    let status = te.assert_error(
+        &["--count", "c.foo", "missing"],
+        "[fd error]: Search path \"missing\" is not a directory.",
+    );
+    assert_eq!(status.code(), Some(1));
+
+    // Zero matches print 0 and exit successfully
+    te.assert_output_raw(&["--count", "no-such-entry"], b"0\n");
+}
+
+/// --count is capped by --max-results and -1
+#[test]
+fn test_count_max_results() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+
+    te.assert_output_raw(&["--count", "--max-results=1", "c.foo"], b"1\n");
+    te.assert_output_raw(&["--count", "-1", "c.foo"], b"1\n");
+    te.assert_output_raw(&["--count", "--max-results=3", "c.foo"], b"2\n");
+
+    // Zero means no limit, as without --count
+    te.assert_output_raw(&["--count", "--max-results=0", "c.foo"], b"2\n");
+}
+
+/// --count conflicts with the options that print entries, in either order
+#[test]
+fn test_count_conflicts() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+
+    let conflicts = [
+        ("--exec=cat", "--exec <cmd>..."),
+        ("--exec-batch=cat", "--exec-batch <cmd>..."),
+        ("--list-details", "--list-details"),
+        ("--format={}", "--format <fmt>"),
+        ("--print0", "--print0"),
+        ("--quiet", "--quiet"),
+    ];
+
+    for (option, name) in conflicts {
+        let status = te.assert_error(
+            &["--count", option],
+            &format!("error: the argument '--count' cannot be used with '{name}'"),
+        );
+        assert_eq!(status.code(), Some(2));
+
+        let status = te.assert_error(
+            &[option, "--count"],
+            &format!("error: the argument '{name}' cannot be used with '--count'"),
+        );
+        assert_eq!(status.code(), Some(2));
+    }
+}
+
