+/// Print the number of results (--count)
+#[test]
+fn test_count() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+
+    // The count must equal the number of lines printed without --count
+    let assert_count = |args: &[&str]| {
+        let lines = String::from_utf8_lossy(&te.assert_success_and_get_output(".", args).stdout)
+            .lines()
+            .count();
+        let mut count_args = vec!["--count"];
+        count_args.extend_from_slice(args);
+        let output = te.assert_success_and_get_output(".", &count_args);
+        assert_eq!(
+            String::from_utf8_lossy(&output.stdout),
+            format!("{lines}\n")
+        );
+    };
+
+    // Basic count
+    te.assert_output(&["--count", "c.foo"], "2");
+    assert_count(&["c.foo"]);
+
+    // Zero matches
+    let output = te.assert_success_and_get_output(".", &["--count", "no_such_entry"]);
+    assert_eq!(output.stdout, b"0\n");
+
+    // Filters
+    assert_count(&["--glob", "*.foo"]);
+    assert_count(&["--extension=foo"]);
+    assert_count(&["--type=f", "c"]);
+    assert_count(&["--hidden", "c"]);
+    assert_count(&["--no-ignore", "c"]);
+    assert_count(&["--max-depth=1", "e"]);
+    assert_count(&["--exclude=one", "e"]);
+
+    // Multiple search paths give a single total
+    assert_count(&["c.foo", "one", "one/two"]);
+
+    // Duplicate search paths are counted like the plain output
+    assert_count(&["c.foo", ".", "."]);
+
+    // --max-results caps the count, and 0 means unlimited
+    te.assert_output(&["--count", "--max-results=1", "c.foo"], "1");
+    te.assert_output(&["--count", "-1", "c.foo"], "1");
+    te.assert_output(&["--count", "--max-results=0", "c.foo"], "2");
+    assert_count(&["--max-results=0", "c.foo"]);
+
+    // Repeated flag
+    te.assert_output(&["--count", "--count", "c.foo"], "2");
+
+    // Conflicting options fail with a usage error, in either order
+    for conflicting in [
+        "--exec=cat",
+        "--exec-batch=cat",
+        "--list-details",
+        "-l",
+        "--format={}",
+        "--print0",
+        "-0",
+        "--quiet",
+        "-q",
+        "--has-results",
+    ] {
+        for args in [
+            ["--count", conflicting, "c.foo"],
+            [conflicting, "--count", "c.foo"],
+        ] {
+            let output = std::process::Command::new(env!("CARGO_BIN_EXE_fd"))
+                .args(args)
+                .current_dir(te.test_root())
+                .output()
+                .unwrap();
+            assert_eq!(output.status.code(), Some(2), "args: {args:?}");
+            assert!(output.stdout.is_empty(), "args: {args:?}");
+            assert!(
+                String::from_utf8_lossy(&output.stderr).contains("cannot be used with"),
+                "args: {args:?}"
+            );
+        }
+    }
+}
