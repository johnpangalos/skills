+/// Print the number of matching entries instead of the entries (--count)
+#[test]
+fn test_count() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+
+    te.assert_output(&["--count", "c.foo"], "2");
+    te.assert_output(&["--count", "--color=always", "c.foo"], "2");
+    te.assert_output(&["--count", "zzz"], "0");
+
+    // Exactly one integer and a newline, nothing else
+    te.assert_output_raw(&["--count", "c.foo"], b"2\n");
+    te.assert_output_raw(&["--count", "zzz"], b"0\n");
+}
+
+/// Search filters apply to --count
+#[test]
+fn test_count_filters() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+
+    te.assert_output(&["--count", "-e", "foo", "-t", "f"], "4");
+    te.assert_output(&["--count", "hidden"], "0");
+    te.assert_output(&["--count", "-H", "hidden"], "1");
+    te.assert_output(&["--count", "-I", "gitignored"], "1");
+}
+
+/// Results from several search paths are summed into one count
+#[test]
+fn test_count_multiple_paths() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+
+    te.assert_output(&["--count", "d.foo", "one/two/three", "one"], "2");
+}
+
+/// --max-results and -1 cap the --count value
+#[test]
+fn test_count_max_results() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+
+    te.assert_output(&["--count", "--max-results=0", "c.foo"], "2");
+    te.assert_output(&["--count", "--max-results=1", "c.foo"], "1");
+    te.assert_output(
+        &["--count", "--max-results=18446744073709551615", "c.foo"],
+        "2",
+    );
+    te.assert_output(&["--count", "-1", "c.foo"], "1");
+    te.assert_output(&["--count", "-1", "zzz"], "0");
+}
+
+/// --count is a usage error with options that change the output format
+#[test]
+fn test_count_conflicts() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+
+    let cases: &[(&[&str], &str)] = &[
+        (
+            &["--count", "-x", "echo", ";"],
+            "error: the argument '--count' cannot be used with '--exec <cmd>...'",
+        ),
+        (
+            &["-x", "echo", ";", "--count"],
+            "error: the argument '--exec <cmd>...' cannot be used with '--count'",
+        ),
+        (
+            &["--count", "-X", "echo"],
+            "error: the argument '--count' cannot be used with '--exec-batch <cmd>...'",
+        ),
+        (
+            &["-l", "--count"],
+            "error: the argument '--list-details' cannot be used with '--count'",
+        ),
+        (
+            &["--count", "--format", "x"],
+            "error: the argument '--count' cannot be used with '--format <fmt>'",
+        ),
+        (
+            &["--count", "-0"],
+            "error: the argument '--count' cannot be used with '--print0'",
+        ),
+        (
+            &["--count", "-q"],
+            "error: the argument '--count' cannot be used with '--quiet'",
+        ),
+        (
+            &["-q", "--count"],
+            "error: the argument '--quiet' cannot be used with '--count'",
+        ),
+        (
+            &["--count", "--has-results"],
+            "error: the argument '--count' cannot be used with '--quiet'",
+        ),
+    ];
+    for (args, expected) in cases {
+        let status = te.assert_error(args, expected);
+        assert_eq!(status.code(), Some(2), "args: {args:?}");
+    }
+}
