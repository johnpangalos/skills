+/// Print the number of search results (--count)
+#[test]
+fn test_count() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+
+    te.assert_output(&["--count", "c.foo"], "2");
+    te.assert_output(&["--count", "-t", "d", "three"], "1");
+    te.assert_output(&["--count", "--exclude", "c.foo", "c.foo"], "1");
+    te.assert_output(&["--count", "--color", "always", "c.foo"], "2");
+    te.assert_output(
+        &[
+            "--count",
+            "--hyperlink",
+            "--absolute-path",
+            "--show-errors",
+            "c.foo",
+        ],
+        "2",
+    );
+
+    // Several search paths give one total, and a path given twice is counted twice
+    te.assert_output(&["--count", "c.foo", "one/two", "one/two/three"], "2");
+    te.assert_output(&["--count", "c.foo", "one/two", "one/two"], "4");
+}
+
+/// Print zero when nothing matches (--count)
+#[test]
+fn test_count_zero_matches() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+
+    te.assert_output(&["--count", "zzz"], "0");
+}
+
+/// Cap the number of counted results (--count, --max-results, -1)
+#[test]
+fn test_count_max_results() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+
+    te.assert_output(&["--count", "--max-results=1", "c.foo"], "1");
+    te.assert_output(&["--count", "-1", "c.foo"], "1");
+    te.assert_output(&["-1", "--count", "zzz"], "0");
+    te.assert_output(&["--count", "--max-results=0", "c.foo"], "2");
+}
+
+/// Reject flags that conflict with --count, in either argument order
+#[test]
+fn test_count_conflicts() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+
+    let cases: &[(&[&str], &str, &str)] = &[
+        (
+            &["-x", "echo", ";"],
+            "error: the argument '--count' cannot be used with '--exec <cmd>...'",
+            "error: the argument '--exec <cmd>...' cannot be used with '--count'",
+        ),
+        (
+            &["-X", "echo", ";"],
+            "error: the argument '--count' cannot be used with '--exec-batch <cmd>...'",
+            "error: the argument '--exec-batch <cmd>...' cannot be used with '--count'",
+        ),
+        (
+            &["-l"],
+            "error: the argument '--count' cannot be used with '--list-details'",
+            "error: the argument '--list-details' cannot be used with '--count'",
+        ),
+        (
+            &["--format", "{}"],
+            "error: the argument '--count' cannot be used with '--format <fmt>'",
+            "error: the argument '--format <fmt>' cannot be used with '--count'",
+        ),
+        (
+            &["-0"],
+            "error: the argument '--count' cannot be used with '--print0'",
+            "error: the argument '--print0' cannot be used with '--count'",
+        ),
+        (
+            &["-q"],
+            "error: the argument '--count' cannot be used with '--quiet'",
+            "error: the argument '--quiet' cannot be used with '--count'",
+        ),
+    ];
+
+    for (flags, count_first, flag_first) in cases {
+        let count_first_args = [&["--count"][..], flags].concat();
+        let flag_first_args = [flags, &["--count"][..]].concat();
+
+        assert_eq!(
+            te.assert_error(&count_first_args, count_first).code(),
+            Some(2)
+        );
+        assert_eq!(
+            te.assert_error(&flag_first_args, flag_first).code(),
+            Some(2)
+        );
+    }
+}
