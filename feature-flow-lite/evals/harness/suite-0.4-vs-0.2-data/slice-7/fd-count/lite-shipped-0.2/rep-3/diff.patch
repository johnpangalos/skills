+    /// Output the number of search results.
+    fn print_count(&mut self) -> Result<(), ExitCode> {
+        // An interrupted search has only seen part of the tree, so a count would be misleading.
+        if self.interrupt_flag.load(Ordering::Relaxed) {
+            return Err(ExitCode::KilledBySigint);
+        }
+
+        if let Err(e) =
+            writeln!(self.stdout, "{}", self.num_results).and_then(|()| self.stdout.flush())
+        {
+            // A closed pipe means nobody is reading anymore, so there is nobody to report to.
+            if e.kind() != io::ErrorKind::BrokenPipe {
+                print_error!("Could not write to output: {}", e);
+            }
+            return Err(ExitCode::GeneralError);
+        }
+        Err(ExitCode::Success)
+    }
+
