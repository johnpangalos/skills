+def _class_statement_stacklevel() -> int:
+    """Depth of the class statement that triggered ``__init_subclass__``,
+    skipping the hook chain and metaclass ``__new__`` frames (including
+    ``ABCMeta.__new__``) that run between the two.
+
+    .. versionadded:: 8.6.0
+    """
+    frame: FrameType | None = sys._getframe(2)
+    level = 2
+
+    while frame is not None and (
+        frame.f_code.co_name in {"__init_subclass__", "__new__"}
+        or frame.f_globals.get("__name__") == "abc"
+    ):
+        frame = frame.f_back
+        level += 1
+
+    return level
+
