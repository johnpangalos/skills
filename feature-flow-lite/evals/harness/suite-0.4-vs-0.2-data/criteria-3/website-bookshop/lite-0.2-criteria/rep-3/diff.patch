+'use strict';
+
+const { test, before, after } = require('node:test');
+const assert = require('node:assert/strict');
+const { PAGES, chromium, startServer, stopServer, watchErrors } = require('./helpers');
+
+const NAV_HREFS = ['index.html', 'books.html', 'events.html', 'visit.html'];
+let server;
+let base;
+let browser;
+
+before(async function () {
+  ({ server, base } = await startServer());
+  browser = await chromium.launch();
+});
+
+after(async function () {
+  await browser.close();
+  await stopServer(server);
+});
+
+test('every page loads with no console errors and only same-origin requests', async function () {
+  for (const name of PAGES) {
+    const context = await browser.newContext();
+    const page = await context.newPage();
+    const errors = watchErrors(page);
+    const origins = new Set();
+    page.on('request', function (request) {
+      origins.add(new URL(request.url()).origin);
+    });
+    await page.goto(base + '/' + name);
+    await page.waitForLoadState('networkidle');
+    assert.deepEqual(errors, [], name + ' logged errors');
+    assert.deepEqual([...origins], [base], name + ' made off-site requests');
+    await context.close();
+  }
+});
+
+test('shared nav links all four pages, resolves, and aria-current marks only the current page', async function () {
+  const context = await browser.newContext();
+  const page = await context.newPage();
+  for (const name of PAGES) {
+    await page.goto(base + '/' + name);
+    const links = await page.$$eval('nav[aria-label="Main"] a', function (anchors) {
+      return anchors.map(function (a) {
+        return { href: a.getAttribute('href'), current: a.getAttribute('aria-current') };
+      });
+    });
+    assert.deepEqual(links.map(function (l) { return l.href; }), NAV_HREFS, name + ' nav links');
+    const current = links.filter(function (l) { return l.current !== null; });
+    assert.deepEqual(current, [{ href: name, current: 'page' }], name + ' aria-current');
+    for (const link of links) {
+      const response = await page.request.get(base + '/' + link.href);
+      assert.equal(response.status(), 200, link.href + ' should resolve');
+    }
+  }
+  await context.close();
+});
+
+test('every page has a unique title, exactly one h1, lang, viewport meta, and shared header and footer', async function () {
+  const context = await browser.newContext();
+  const page = await context.newPage();
+  const titles = [];
+  let navHtml = null;
+  for (const name of PAGES) {
+    await page.goto(base + '/' + name);
+    titles.push(await page.title());
+    assert.equal(await page.locator('h1').count(), 1, name + ' h1 count');
+    assert.equal(await page.getAttribute('html', 'lang'), 'en');
+    assert.equal(await page.getAttribute('meta[name="viewport"]', 'content'), 'width=device-width, initial-scale=1');
+    assert.equal(await page.getAttribute('header .brand', 'href'), 'index.html');
+    assert.match(await page.textContent('footer'), /14 Lantern Row/);
+    assert.match(await page.textContent('footer'), /Closed Mondays/);
+    assert.equal(await page.locator('header').count(), 1);
+    assert.equal(await page.locator('main').count(), 1);
+    assert.equal(await page.locator('footer').count(), 1);
+    const nav = await page.innerHTML('nav[aria-label="Main"]');
+    if (navHtml === null) {
+      navHtml = nav;
+    }
+    const withoutCurrent = function (html) {
+      return html.replace(/ aria-current="page"/g, '').replace(/ +>/g, '>');
+    };
+    assert.equal(withoutCurrent(nav), withoutCurrent(navHtml), name + ' nav differs');
+  }
+  assert.equal(new Set(titles).size, PAGES.length, 'titles must be unique: ' + titles.join(' | '));
+  await context.close();
+});
+
+test('no page scrolls horizontally at 360, 768 and 1280 pixels wide', async function () {
+  const context = await browser.newContext();
+  for (const width of [360, 768, 1280]) {
