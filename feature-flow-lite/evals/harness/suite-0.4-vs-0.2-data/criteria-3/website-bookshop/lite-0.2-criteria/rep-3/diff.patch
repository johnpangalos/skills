index 0000000..fa5c59d
--- /dev/null
+++ b/tests/books.test.js
@@ -0,0 +1,290 @@
+'use strict';
+
+const { test, before, after } = require('node:test');
+const assert = require('node:assert/strict');
+const path = require('node:path');
+const { ROOT, chromium, startServer, stopServer, watchErrors } = require('./helpers');
+
+let server;
+let base;
+let browser;
+
+before(async function () {
+  ({ server, base } = await startServer());
+  browser = await chromium.launch();
+});
+
+after(async function () {
+  await browser.close();
+  await stopServer(server);
+});
+
+// Reads what the visitor sees: the checked genre, the cards, the count text and the URL.
+async function readState(page) {
+  return page.evaluate(function () {
+    const checked = document.querySelector('input[name="genre"]:checked');
+    const cards = Array.from(document.querySelectorAll('#book-list > li'));
+    return {
+      checked: checked ? checked.value : null,
+      cards: cards.length,
+      genres: cards.map(function (card) {
+        return card.querySelector('.book-genre').textContent.replace('Genre: ', '');
+      }),
+      count: document.getElementById('result-count').textContent,
+      path: location.pathname + location.search
+    };
+  });
+}
+
+async function newBooksPage(context) {
+  const page = await context.newPage();
+  const errors = watchErrors(page);
+  page.on('dialog', function (dialog) {
+    dialog.dismiss();
+    errors.push('unexpected dialog: ' + dialog.message());
+  });
+  await page.goto(base + '/books.html');
+  return { page, errors };
+}
+
+test('catalogue data: at least 12 titles across 5+ genres with 2+ titles each, no duplicate titles', async function () {
+  const context = await browser.newContext();
+  const { page } = await newBooksPage(context);
+  const data = await page.evaluate(function () {
+    return BOOKS.map(function (book) {
+      return { title: book.title, author: book.author, genre: book.genre, blurb: book.blurb, price: book.price };
+    });
+  });
+  assert.ok(data.length >= 12, 'expected at least 12 books, got ' + data.length);
+  const byGenre = {};
+  data.forEach(function (book) {
+    byGenre[book.genre] = (byGenre[book.genre] || 0) + 1;
+    assert.ok(book.title && book.author && book.blurb, 'book missing text fields');
+    assert.equal(typeof book.price, 'number');
+  });
+  assert.ok(Object.keys(byGenre).length >= 5, 'expected at least 5 genres');
+  Object.keys(byGenre).forEach(function (genre) {
+    assert.ok(byGenre[genre] >= 2, genre + ' has fewer than 2 titles');
+  });
+  const titles = new Set(data.map(function (book) { return book.title; }));
+  assert.equal(titles.size, data.length, 'duplicate titles in data');
+  await context.close();
+});
+
+test('filter shows only the chosen genre, with an exact count and matching cards', async function () {
+  const context = await browser.newContext();
+  const { page, errors } = await newBooksPage(context);
+  const initial = await readState(page);
+  assert.equal(initial.cards, 15);
+  assert.equal(initial.count, 'Showing 15 of 15 books');
+  assert.equal(initial.checked, 'all');
+
+  await page.click('label[for="genre-mystery"]');
+  const mystery = await readState(page);
+  assert.equal(mystery.cards, 3);
+  assert.equal(mystery.count, 'Showing 3 of 15 books in Mystery');
+  assert.deepEqual([...new Set(mystery.genres)], ['Mystery']);
+  assert.equal(mystery.checked, 'Mystery');
+
+  await page.click('label[for="genre-all"]');
+  const all = await readState(page);
+  assert.equal(all.cards, 15);
+  assert.equal(all.count, 'Showing 15 of 15 books');
+  assert.deepEqual(errors, []);
+  await context.close();
+});
+
+test('the count is a polite live region and the filter is a labelled radio group', async function () {
+  const context = await browser.newContext();
+  const { page } = await newBooksPage(context);
+  assert.equal(await page.getAttribute('#result-count', 'aria-live'), 'polite');
+  assert.equal(await page.textContent('fieldset legend'), 'Filter by genre');
+  const labels = await page.$$eval('input[name="genre"]', function (inputs) {
+    return inputs.map(function (input) {
+      return document.querySelector('label[for="' + input.id + '"]').textContent;
+    });
+  });
+  assert.equal(labels[0], 'All genres');
+  assert.deepEqual(labels.slice(1).sort(), ['Literary Fiction', 'Mystery', 'Nature Writing', 'Poetry', 'Science Fiction']);
+  await context.close();
+});
+
