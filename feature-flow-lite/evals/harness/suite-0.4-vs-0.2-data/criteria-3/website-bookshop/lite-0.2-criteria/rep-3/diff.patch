+  <script src="js/data.js" defer></script>
+  <script src="js/site.js" defer></script>
+  <script src="js/visit.js" defer></script>
+</head>
+<body>
+  <a class="skip-link" href="#main">Skip to main content</a>
+
+  <header class="site-header">
+    <div class="wrap">
+      <a class="brand" href="index.html">Marginalia Books</a>
+      <nav aria-label="Main">
+        <ul class="nav-list">
+          <li><a href="index.html">Home</a></li>
+          <li><a href="books.html">Books</a></li>
+          <li><a href="events.html">Events</a></li>
+          <li><a href="visit.html" aria-current="page">Visit</a></li>
+        </ul>
+      </nav>
+    </div>
+  </header>
+
+  <main id="main" tabindex="-1">
+    <div class="wrap">
+      <h1>Visit the shop</h1>
+      <p class="lead">We are a small shop with a big back room. Here is where to find us, when we are open, and how to get in touch.</p>
+
+      <section aria-labelledby="hours-title">
+        <h2 id="hours-title">Opening hours</h2>
+        <table class="hours-table">
+          <caption>Opening hours, all year round</caption>
+          <thead>
+            <tr>
+              <th scope="col">Day</th>
+              <th scope="col">Hours</th>
+            </tr>
+          </thead>
+          <tbody>
+            <tr><th scope="row">Monday</th><td>Closed</td></tr>
+            <tr><th scope="row">Tuesday</th><td>9:30am to 6:00pm</td></tr>
+            <tr><th scope="row">Wednesday</th><td>9:30am to 6:00pm</td></tr>
+            <tr><th scope="row">Thursday</th><td>9:30am to 6:00pm</td></tr>
+            <tr><th scope="row">Friday</th><td>9:30am to 6:00pm</td></tr>
+            <tr><th scope="row">Saturday</th><td>9:00am to 6:00pm</td></tr>
+            <tr><th scope="row">Sunday</th><td>11:00am to 4:00pm</td></tr>
+          </tbody>
+        </table>
+      </section>
+
+      <section aria-labelledby="find-title" class="details">
+        <h2 id="find-title">Find us</h2>
+        <address>
+          Marginalia Books<br>
+          14 Lantern Row<br>
+          Little Ashcombe<br>
+          Dunmere<br>
+          DM4 2QT
+        </address>
+        <p>Lantern Row runs off the high street, behind the old post office, with our green door on the left. The nearest bus stop is Market Cross, a three-minute walk. Two blue badge bays sit on the Row itself, and the Quayside car park is five minutes on foot.</p>
+        <p>Phone <a class="standalone-link" href="tel:+441632960123">01632 960 123</a><br>
+        Email <a class="standalone-link" href="mailto:hello@marginalia.example">hello@marginalia.example</a></p>
+      </section>
+
+      <section aria-labelledby="access-title" class="details">
+        <h2 id="access-title">Access</h2>
+        <ul>
+          <li>Step-free entrance with a ramp at the door; the shop is on one level.</li>
+          <li>Aisles are 1.2 metres wide, with a clear turning space at the till.</li>
+          <li>An accessible toilet is at the back, past the children’s corner.</li>
+          <li>A large-print section and a reading chair by the stove are free to use.</li>
+          <li>Assistance dogs are welcome. Ask us for a water bowl.</li>
+        </ul>
+      </section>
+
+      <section aria-labelledby="contact-title">
+        <h2 id="contact-title">Write to us</h2>
+        <p>Fields marked “(required)” must be filled in. This form is a demo: it does not send anything. To reach the shop, use the email address above.</p>
+
+        <form class="contact-form" id="contact-form" novalidate>
+          <div class="field">
+            <label for="contact-name">Name <span class="required-note">(required)</span></label>
+            <input id="contact-name" name="name" type="text" autocomplete="name" required>
+          </div>
+
+          <div class="field">
+            <label for="contact-email">Email <span class="required-note">(required)</span></label>
+            <input id="contact-email" name="email" type="email" autocomplete="email" required>
+          </div>
+
+          <div class="field">
+            <label for="contact-subject">Subject <span class="required-note">(optional)</span></label>
+            <select id="contact-subject" name="subject">
+              <option value="general">General question</option>
+              <option value="events">Event booking</option>
+              <option value="order">Special order</option>
+              <option value="other">Something else</option>
+            </select>
+          </div>
+
+          <div class="field">
+            <label for="contact-message">Message <span class="required-note">(required)</span></label>
+            <textarea id="contact-message" name="message" rows="6" required></textarea>
+          </div>
+
+          <button class="button" type="submit">Send message</button>
+        </form>
+
+        <div class="form-status" id="form-status" role="status" tabindex="-1"></div>
+      </section>
+    </div>
+  </main>
+
+  <footer class="site-footer">
+    <div class="wrap">
+      <p>Marginalia Books, 14 Lantern Row, Little Ashcombe, DM4 2QT</p>
+      <p>Open Tuesday to Friday 9:30am to 6pm, Saturday 9am to 6pm, Sunday 11am to 4pm. Closed Mondays.</p>
+    </div>
+  </footer>
+</body>
+</html>
