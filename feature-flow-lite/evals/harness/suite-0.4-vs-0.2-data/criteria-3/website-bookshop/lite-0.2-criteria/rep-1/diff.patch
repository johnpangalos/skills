+
+  async function fill(page, values) {
+    for (const [name, value] of Object.entries(values)) {
+      await page.fill(`#${name}`, value);
+    }
+  }
+
+  async function errorText(page, name) {
+    return page.locator(`#${name}-error`).textContent();
+  }
+
+  it('has a visible label for each field and marks required fields in text', async () => {
