+      const label = page.locator(`label[for="${name}"]`);
+      assert.equal(await label.count(), 1, `label for ${name}`);
+      assert.match(await label.textContent(), /\(required\)/, `required text for ${name}`);
+      assert.equal(await page.locator(`#${name}`).getAttribute('required'), '');
+    }
