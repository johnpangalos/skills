+    start: "2026-12-12T19:30",
+    kind: "Poetry",
+    description: "Read something of your own or something you love. Three minutes per reader, sign-up sheet at the door. Bring a poem and a friend."
+  },
+  {
+    title: "Gift Wrapping Afternoon",
+    start: "2026-12-19T13:00",
+    kind: "Workshop",
+    description: "Our staff wrap your purchases in brown paper and string, free of charge, while you browse. Donations to the local library trust are appreciated."
+  }
+];
+
+// Shared event helpers, used by the home and events pages.
+
+// The start of an event as a Date in the reader's local time zone.
+function eventStart(event) {
+  var parts = event.start.split('T');
+  var date = parts[0].split('-').map(Number);
+  var time = parts[1].split(':').map(Number);
+  return new Date(date[0], date[1] - 1, date[2], time[0], time[1]);
+}
+
+function formatEventDate(date) {
+  return date.toLocaleString('en-GB', {
+    weekday: 'long',
+    day: 'numeric',
+    month: 'long',
+    year: 'numeric',
+    hour: 'numeric',
+    minute: '2-digit'
+  });
+}
+
+// Events starting on or after today's local date, soonest first. An event on today's date is still upcoming.
+function upcomingEvents() {
+  var today = new Date();
+  today = new Date(today.getFullYear(), today.getMonth(), today.getDate());
+  return EVENTS.filter(function (event) {
+    return eventStart(event) >= today;
+  }).sort(function (a, b) {
+    return eventStart(a) - eventStart(b);
+  });
+}
