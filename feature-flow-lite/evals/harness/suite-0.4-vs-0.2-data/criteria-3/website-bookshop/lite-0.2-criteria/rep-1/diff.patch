@@ -0,0 +1,490 @@
+/* Marginalia Books: paper and ink palette, system font stacks only. */
+
+:root {
+  --paper: #f7f1e6;
+  --paper-deep: #efe5d2;
+  --card: #fffaf0;
+  --ink: #2b2118;
+  --muted: #5e5043;
+  --accent: #7a2e2e;
+  --gold: #f2d28b;
+  --rule: #cbbfa8;
+  --serif: Georgia, "Iowan Old Style", "Palatino Linotype", Palatino, "Times New Roman", serif;
+  --sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+body {
+  margin: 0;
+  min-height: 100vh;
+  display: flex;
+  flex-direction: column;
+  background: var(--paper);
+  color: var(--ink);
+  font-family: var(--sans);
+  font-size: 1.0625rem;
+  line-height: 1.6;
+  overflow-wrap: break-word;
+}
+
+main {
+  flex: 1;
+}
+
+main:focus {
+  outline: none;
+}
+
+h1,
+h2,
+h3 {
+  font-family: var(--serif);
+  line-height: 1.2;
+  color: var(--ink);
+  overflow-wrap: anywhere;
+}
+
+h1 {
+  font-size: clamp(2rem, 6vw, 3.25rem);
+  margin: 0 0 0.5rem;
+}
+
+h2 {
+  font-size: clamp(1.4rem, 4vw, 1.9rem);
+  margin: 0 0 0.75rem;
+}
+
+p {
+  margin: 0 0 1rem;
+}
+
+a {
+  color: var(--accent);
+  text-underline-offset: 0.2em;
+}
+
+a:hover {
+  text-decoration-thickness: 2px;
+}
+
+:focus-visible {
+  outline: 3px solid var(--accent);
+  outline-offset: 3px;
+}
+
+.wrap {
+  max-width: 64rem;
+  margin: 0 auto;
+  padding: 0 1rem;
+}
+
+.section {
+  padding-top: 2.25rem;
+  padding-bottom: 2.25rem;
+}
+
+.lede {
+  font-size: 1.15rem;
+  max-width: 40rem;
+}
+
+/* Skip link */
+
+.skip-link {
+  position: absolute;
+  left: 1rem;
+  top: -4rem;
+  z-index: 10;
+  padding: 0.75rem 1rem;
+  background: var(--ink);
+  color: var(--paper);
+  font-weight: 600;
+}
+
+.skip-link:focus {
+  top: 1rem;
+}
+
+/* Header and nav */
+
+.site-header {
+  background: var(--ink);
+  color: var(--paper);
+}
+
+.header-inner {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0.25rem 1.5rem;
+  padding-top: 0.5rem;
+  padding-bottom: 0.5rem;
+}
+
+.brand {
+  display: inline-flex;
+  align-items: center;
+  min-height: 44px;
+  font-family: var(--serif);
+  font-size: 1.35rem;
+  color: var(--paper);
+  text-decoration: none;
+}
+
+.nav-list {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.25rem;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.nav-list a {
+  display: inline-flex;
+  align-items: center;
+  min-height: 44px;
+  padding: 0.5rem 0.85rem;
+  color: var(--paper);
+  text-decoration: none;
+  border-bottom: 2px solid transparent;
+}
+
+.nav-list a:hover {
+  text-decoration: underline;
+}
+
+.nav-list a[aria-current="page"] {
+  border-bottom-color: var(--gold);
+  color: var(--gold);
+}
+
+.site-header :focus-visible,
+.site-footer :focus-visible,
+.skip-link:focus-visible {
+  outline-color: var(--gold);
+}
+
+/* Footer */
+
+.site-footer {
+  background: var(--ink);
+  color: var(--paper);
+  padding: 2rem 0;
+  font-size: 0.95rem;
+}
+
+.site-footer a {
+  color: var(--gold);
+}
+
+.site-footer p {
+  margin: 0 0 0.35rem;
+}
+
+/* Home hero */
+
+.hero {
+  background: var(--paper-deep);
+  border-bottom: 1px solid var(--rule);
+  padding: 2.5rem 0;
+}
+
+.hero-inner {
+  display: grid;
+  grid-template-columns: 1fr;
+  gap: 2rem;
+  align-items: center;
+}
+
+.hero .ornament {
+  display: none;
+}
+
+.eyebrow {
+  margin: 0 0 0.25rem;
+  color: var(--muted);
+  font-variant: small-caps;
+  letter-spacing: 0.08em;
+}
+
+.tagline {
+  margin: 0 0 1rem;
+  font-family: var(--serif);
+  font-size: 1.25rem;
+  font-style: italic;
+  color: var(--accent);
+}
+
+@media (min-width: 40rem) {
+  .hero-inner {
+    grid-template-columns: 1fr 11rem;
+  }
+
+  .hero .ornament {
+    display: block;
+    width: 100%;
+    height: auto;
+  }
+}
+
+/* Buttons and link buttons */
+
+.button {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-height: 44px;
+  margin: 0.25rem 0.5rem 0.25rem 0;
+  padding: 0.5rem 1.1rem;
+  border: 1px solid var(--accent);
+  border-radius: 2px;
+  background: var(--accent);
+  color: #ffffff;
+  font: inherit;
+  font-weight: 600;
+  text-decoration: none;
+  cursor: pointer;
+}
+
+.button:hover {
+  text-decoration: underline;
+}
+
+.button-quiet {
+  background: transparent;
+  color: var(--ink);
+  border-color: var(--ink);
+}
+
+/* Cards: featured picks and catalogue */
+
+.card-grid {
+  display: grid;
+  grid-template-columns: 1fr;
+  gap: 1rem;
+  margin: 0 0 1.5rem;
+  padding: 0;
+  list-style: none;
+}
+
+.book {
+  padding: 1rem 1.1rem;
+  background: var(--card);
+  border: 1px solid var(--rule);
+}
+
+.book h2 {
+  font-size: 1.2rem;
+}
+
+.book-author {
+  margin: 0 0 0.5rem;
+  color: var(--muted);
+  font-style: italic;
+}
+
+.book-blurb {
+  margin: 0.5rem 0 0;
+  font-size: 0.97rem;
+}
+
+.book-meta {
+  margin: 0.75rem 0 0;
+  font-size: 0.9rem;
+  color: var(--muted);
+}
+
+@media (min-width: 30rem) {
+  .card-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+}
+
+@media (min-width: 48rem) {
+  .card-grid {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+  }
+}
+
+/* Catalogue filter */
+
+.filter {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 0.5rem 1rem;
+  margin: 1.5rem 0 0.5rem;
+}
+
+.filter label {
+  font-weight: 600;
+}
+
+select {
+  min-width: 14rem;
+  max-width: 100%;
+  min-height: 44px;
+  padding: 0.4rem 0.6rem;
+  border: 1px solid var(--muted);
+  border-radius: 2px;
+  background: var(--card);
+  color: var(--ink);
+  font: inherit;
+}
+
+.count {
+  margin: 0.5rem 0 1rem;
+  color: var(--muted);
+}
+
+/* Events */
+
+.event-list {
+  display: grid;
+  gap: 1rem;
+  margin: 0 0 1.5rem;
+  padding: 0;
+  list-style: none;
+}
+
+.event {
+  padding: 0.25rem 0 0.25rem 1rem;
+  border-left: 4px solid var(--accent);
+}
+
+.event h2 {
+  font-size: 1.25rem;
+  margin-bottom: 0.25rem;
+}
+
+.event-kind {
+  margin: 0;
+  color: var(--muted);
+  font-size: 0.85rem;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+}
+
+.event time {
+  font-weight: 600;
+}
+
+.empty {
+  padding: 0.75rem 1rem;
+  background: var(--card);
+  border-left: 4px solid var(--accent);
+}
+
+/* Visit */
+
+address {
+  font-style: normal;
+  line-height: 1.7;
+}
+
+.hours {
+  width: 100%;
+  max-width: 28rem;
+  margin: 0.5rem 0 1.5rem;
+  border-collapse: collapse;
+}
+
+.hours th,
+.hours td {
+  padding: 0.5rem 0.75rem 0.5rem 0;
+  text-align: left;
+  vertical-align: top;
+  border-bottom: 1px solid var(--rule);
+}
+
+.columns {
+  display: grid;
+  gap: 1.5rem;
+  grid-template-columns: minmax(0, 1fr);
+}
+
+@media (min-width: 48rem) {
+  .columns {
+    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
+  }
+}
+
+/* Contact form */
+
+.form {
+  display: grid;
+  gap: 1rem;
+  max-width: 36rem;
+}
+
+.field {
+  display: grid;
+  gap: 0.25rem;
+  min-width: 0;
+}
+
+.field label {
+  font-weight: 600;
+}
+
+.field input,
+.field textarea {
+  width: 100%;
+  min-height: 44px;
+  padding: 0.5rem 0.65rem;
+  border: 1px solid var(--muted);
+  border-radius: 2px;
+  background: var(--card);
+  color: var(--ink);
+  font: inherit;
+  overflow-wrap: break-word;
+}
+
+.field textarea {
+  min-height: 9rem;
+  resize: vertical;
+}
+
+.field input[aria-invalid="true"],
+.field textarea[aria-invalid="true"] {
+  border: 2px solid var(--accent);
+}
+
+.field-error {
+  margin: 0;
+  color: var(--accent);
+  font-weight: 600;
+}
+
+/* Kept in the page while empty so screen readers announce the message when it is filled in. */
+.form-status:empty {
+  padding: 0;
+  border-left-width: 0;
+  background: none;
+}
+
+.form-status {
+  margin: 0;
+  padding: 0.75rem 1rem;
+  background: var(--card);
+  border-left: 4px solid var(--accent);
+}
+
+.form-status:focus {
+  outline: none;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    transition-duration: 0.01ms !important;
+    animation-duration: 0.01ms !important;
+    scroll-behavior: auto !important;
+  }
+}
