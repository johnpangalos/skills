+const EVENTS = [
+  {
+    title: "Winter Reading with Ana Morrow",
+    start: "2026-11-21T18:30",
+    kind: "Reading",
+    description: "Ana Morrow reads from her new collection of coastal stories, followed by questions and a book signing. Tickets are free; please reserve a seat at the till."
+  },
+  {
+    title: "Book Club: The Tidewater Letters",
+    start: "2026-12-03T19:00",
+    kind: "Book club",
+    description: "Our monthly evening group discusses this season's choice over mulled cider. New members are always welcome, and you do not need to have finished the book."
+  },
+  {
+    title: "Kids' Story Time: Winter Animals",
+    start: "2026-12-05T10:30",
+    kind: "Story time",
+    description: "Stories, songs and a craft table for children aged 3 to 7. Parents and carers stay with their little ones. About 40 minutes."
+  },
