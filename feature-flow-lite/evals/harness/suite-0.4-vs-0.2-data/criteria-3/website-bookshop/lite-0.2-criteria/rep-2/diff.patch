+  var MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July',
+    'August', 'September', 'October', 'November', 'December'];
+  var WEEKDAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
+
+  function setupNav() {
+    var toggle = document.querySelector('.nav-toggle');
+    var nav = document.getElementById('site-nav');
+    if (!toggle || !nav) return;
+
+    function isOpen() {
+      return nav.classList.contains('is-open');
+    }
+
+    function setOpen(open) {
+      nav.classList.toggle('is-open', open);
+      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
+    }
+
+    toggle.addEventListener('click', function () {
+      setOpen(!isOpen());
+    });
+
+    document.addEventListener('keydown', function (event) {
+      if (event.key === 'Escape' && isOpen()) {
+        setOpen(false);
+        toggle.focus();
+      }
+    });
+
+    // Past the breakpoint the CSS always shows the nav, so drop the stale open state too.
+    window.matchMedia('(min-width: 700px)').addEventListener('change', function (event) {
+      if (event.matches) setOpen(false);
+    });
+  }
+
+  function setYear() {
+    var year = document.getElementById('year');
+    if (year) year.textContent = String(new Date().getFullYear());
+  }
+
+  function pad(n) {
+    return n < 10 ? '0' + n : String(n);
+  }
+
+  // The local calendar day as YYYY-MM-DD, built from local getters (never a UTC parse).
+  function localDateKey(date) {
+    return date.getFullYear() + '-' + pad(date.getMonth() + 1) + '-' + pad(date.getDate());
+  }
+
+  // Splits events into upcoming (today or later) and past, each sorted by date ascending.
+  // Dates are YYYY-MM-DD strings, so plain string comparison is date order.
+  function splitEvents(events, todayKey) {
+    var sorted = events.slice().sort(function (a, b) {
+      return a.date < b.date ? -1 : a.date > b.date ? 1 : 0;
+    });
+    return {
+      upcoming: sorted.filter(function (event) { return event.date >= todayKey; }),
+      past: sorted.filter(function (event) { return event.date < todayKey; })
+    };
+  }
+
+  // Human-readable event time, e.g. "Thursday 3 December 2026, 18:30–20:00".
+  function formatEventWhen(event) {
+    var parts = event.date.split('-').map(Number);
+    var weekday = WEEKDAYS[new Date(Date.UTC(parts[0], parts[1] - 1, parts[2])).getUTCDay()];
+    return weekday + ' ' + parts[2] + ' ' + MONTHS[parts[1] - 1] + ' ' + parts[0] +
+      ', ' + event.start + '–' + event.end;
+  }
+
+  // Creates an element and sets its text with textContent, so data is never parsed as HTML.
+  function createEl(tag, className, text) {
+    var el = document.createElement(tag);
+    if (className) el.className = className;
+    if (text !== undefined) el.textContent = text;
+    return el;
+  }
+
+  // Calendar-style badge: the day number over the month abbreviation. It is decorative,
+  // because the full date sits in the adjacent <time> element.
+  function dateBadge(dateKey) {
+    var parts = dateKey.split('-').map(Number);
+    var badge = createEl('div', 'date-badge');
+    badge.setAttribute('aria-hidden', 'true');
+    badge.appendChild(createEl('span', 'date-badge__day', String(parts[2])));
+    badge.appendChild(createEl('span', 'date-badge__month', MONTHS[parts[1] - 1].slice(0, 3)));
+    return badge;
+  }
+
+  window.Marginalia = {
+    WEEKDAYS: WEEKDAYS,
+    localDateKey: localDateKey,
+    splitEvents: splitEvents,
+    formatEventWhen: formatEventWhen,
+    createEl: createEl,
+    dateBadge: dateBadge
+  };
+
+  setupNav();
+  setYear();
+})();
diff --git a/js/visit.js b/js/visit.js
new file mode 100644
index 0000000..a958a44
--- /dev/null
+++ b/js/visit.js
@@ -0,0 +1,90 @@
+// Visit page: the opening hours table and the demo contact form with its validation.
+(function () {
+  'use strict';
+
+  var createEl = window.Marginalia.createEl;
+  var shop = window.MarginaliaData.shop;
+  var MAX_NAME = 100;
+  var MAX_MESSAGE = 1000;
+  var EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+  var FIELDS = ['name', 'email', 'message'];
+
+  var hoursBody = document.getElementById('hours-body');
+  window.MarginaliaData.hours.forEach(function (row) {
+    var tr = createEl('tr');
+    var th = createEl('th', null, row.day);
+    th.setAttribute('scope', 'row');
+    tr.appendChild(th);
+    tr.appendChild(createEl('td', null, row.open + '–' + row.close));
+    hoursBody.appendChild(tr);
+  });
+
+  // Each rule takes the trimmed value and returns an error message, or '' when valid.
+  var rules = {
+    name: function (value) {
+      if (!value) return 'Please enter your name.';
+      if (value.length > MAX_NAME) return 'Names can be up to ' + MAX_NAME + ' characters.';
+      return '';
+    },
+    email: function (value) {
+      if (!value) return 'Please enter your email address.';
+      if (!EMAIL_PATTERN.test(value)) return 'Please enter an email address in the form name@example.com.';
+      return '';
+    },
+    message: function (value) {
+      if (!value) return 'Please enter a message.';
+      if (value.length > MAX_MESSAGE) {
+        return 'Messages can be up to ' + MAX_MESSAGE + ' characters. Yours is ' + value.length + '.';
+      }
+      return '';
+    }
+  };
+
+  // Shows or clears one field's error text and aria-invalid. Returns true when the field is valid.
+  function checkField(name) {
+    var field = document.getElementById(name);
+    var error = document.getElementById(name + '-error');
+    var message = rules[name](field.value.trim());
+    error.textContent = message;
+    error.hidden = message === '';
+    if (message) {
+      field.setAttribute('aria-invalid', 'true');
+    } else {
+      field.removeAttribute('aria-invalid');
+    }
+    return message === '';
+  }
+
+  var form = document.getElementById('contact-form');
+  var formStatus = document.getElementById('form-status');
+
+  form.addEventListener('submit', function (event) {
+    event.preventDefault();
+
+    // filter() runs every check, so all errors are shown before focus moves to the first one.
+    var firstInvalid = FIELDS.filter(function (name) { return !checkField(name); })[0];
+    if (firstInvalid) {
+      formStatus.textContent = '';
+      document.getElementById(firstInvalid).focus();
+      return;
+    }
+
+    var fullName = document.getElementById('name').value.trim();
+    formStatus.textContent = 'Thank you, ' + fullName + '. This is a demo form, so your message was NOT sent. ' +
+      'To reach the shop, email ' + shop.email + ' or call ' + shop.phone + '.';
+    form.reset();
+  });
+
+  // Once a field is flagged, re-check it as the visitor types so the error clears when fixed.
+  FIELDS.forEach(function (name) {
+    var field = document.getElementById(name);
+    field.addEventListener('input', function () {
+      if (field.getAttribute('aria-invalid') === 'true') checkField(name);
+    });
+  });
+
+  // Editing any field after a demo submit clears the confirmation, so it never describes old input.
+  form.addEventListener('input', function () {
+    formStatus.textContent = '';
+  });
+})();
