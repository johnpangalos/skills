+/* Marginalia Books: paper, ink and deep green, with oxblood for links.
+   Text pairs are at least 4.5:1 (body) and 3:1 (large text and UI borders). */
+
+:root {
+  --paper: #f7f1e3;
+  --paper-deep: #efe5cf;
+  --card: #fffdf7;
+  --ink: #1f1b16;
+  --ink-soft: #4f4539;
+  --green: #1f4a3a;
+  --green-deep: #163a2d;
+  --green-tint: #e4ebdc;
+  --gold: #e0b44c;
+  --gold-tint: #f3e1a6;
+  --oxblood: #7a2330;
+  --error: #8a1c1c;
+  --rule: #cdbf9f;
+  --field-border: #6e6356;
+  --serif: "Iowan Old Style", "Palatino Linotype", Palatino, "Book Antiqua", Georgia, serif;
+}
+
+*, *::before, *::after {
+  box-sizing: border-box;
+}
+
+body {
+  margin: 0;
+  background: var(--paper);
+  color: var(--ink);
+  font-family: var(--serif);
+  font-size: 1.125rem;
+  line-height: 1.6;
+  -webkit-text-size-adjust: 100%;
+}
+
+img {
+  max-width: 100%;
+  height: auto;
+}
+
+h1,
+h2,
+h3 {
+  font-family: var(--serif);
+  line-height: 1.2;
+  color: var(--ink);
+}
+
+h1 {
+  font-size: 2.25rem;
+  margin: 0 0 1rem;
+}
+
+h2 {
+  font-size: 1.6rem;
+  margin: 0 0 0.75rem;
+}
+
+h3 {
+  font-size: 1.25rem;
+  margin: 0 0 0.25rem;
+}
+
+p {
+  margin: 0 0 1rem;
+}
+
+address {
+  font-style: normal;
+  margin: 0 0 1rem;
+}
+
+a {
+  color: var(--oxblood);
+  text-decoration-thickness: 1px;
+  text-underline-offset: 0.2em;
+}
+
+a:hover {
+  text-decoration-thickness: 2px;
+}
+
+:focus-visible {
+  outline: 3px solid var(--green);
+  outline-offset: 3px;
+}
+
+.container {
+  width: 100%;
+  max-width: 1080px;
+  margin: 0 auto;
+  padding: 0 1rem;
+}
+
+main.container {
+  padding-top: 1.5rem;
+  padding-bottom: 3rem;
+}
+
+main section {
+  margin-bottom: 2.5rem;
+}
+
+.skip-link {
+  position: absolute;
+  left: 1rem;
+  top: -4rem;
+  z-index: 10;
+  padding: 0.5rem 1rem;
+  background: var(--paper);
+  color: var(--ink);
+  border: 2px solid var(--green);
+  border-radius: 4px;
+}
+
+.skip-link:focus {
+  top: 1rem;
+}
+
+/* Header and navigation */
+
+.site-header {
+  background: var(--green);
+  color: var(--paper);
+}
+
+.site-header :focus-visible,
+.hero :focus-visible {
+  outline-color: var(--gold);
+}
+
+.site-header .container {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  min-height: 3.5rem;
+  padding-top: 0.5rem;
+  padding-bottom: 0.5rem;
+}
+
+.site-name {
+  font-size: 1.35rem;
+  font-weight: bold;
+  color: var(--paper);
+  text-decoration: none;
+}
+
+.nav-toggle {
+  min-width: 44px;
+  min-height: 44px;
+  padding: 0.5rem 1rem;
+  font: inherit;
+  font-size: 1rem;
+  color: var(--paper);
+  background: transparent;
+  border: 1px solid var(--paper);
+  border-radius: 4px;
+  cursor: pointer;
+}
+
+.site-nav {
+  display: none;
+  width: 100%;
+}
+
+.site-nav.is-open {
+  display: block;
+}
+
+.site-nav ul {
+  list-style: none;
+  margin: 0;
+  padding: 0.25rem 0 0.5rem;
+}
+
+.site-nav a {
+  display: flex;
+  align-items: center;
+  min-height: 44px;
+  padding: 0 0.25rem;
+  color: var(--paper);
+  text-decoration: none;
+}
+
+.site-nav a:hover {
+  text-decoration: underline;
+}
+
+.site-nav a[aria-current="page"] {
+  font-weight: bold;
+  text-decoration: underline;
+  text-decoration-thickness: 2px;
+  text-underline-offset: 0.3em;
+}
+
+@media (min-width: 700px) {
+  .nav-toggle {
+    display: none;
+  }
+
+  .site-nav,
+  .site-nav.is-open {
+    display: block;
+    width: auto;
+  }
+
+  .site-nav ul {
+    display: flex;
+    gap: 1.5rem;
+    padding: 0;
+  }
+}
+
+/* Buttons and links styled as buttons */
+
+.button {
+  display: inline-flex;
+  align-items: center;
+  min-height: 44px;
+  padding: 0.6rem 1.25rem;
+  font: inherit;
+  font-size: 1rem;
+  color: var(--paper);
+  background: var(--green);
+  border: 2px solid var(--green);
+  border-radius: 4px;
+  text-decoration: none;
+  cursor: pointer;
+  transition: background-color 0.2s ease, color 0.2s ease;
+}
+
+.button:hover {
+  background: var(--green-deep);
+  text-decoration: underline;
+}
+
+.button--light {
+  color: var(--green);
+  background: var(--paper);
+  border-color: var(--paper);
+}
+
+.button--light:hover {
+  background: var(--gold-tint);
+  border-color: var(--gold-tint);
+}
+
+.button--outline {
+  color: var(--paper);
+  background: transparent;
+  border-color: var(--paper);
+}
+
+.button--outline:hover {
+  background: var(--green-deep);
+}
+
+button.button {
+  border: 0;
+}
+
+/* Home: hero band, cards and visit panel */
+
+.hero {
+  margin: 0 0 2.5rem;
+  padding: 2rem 1.25rem 1.75rem;
+  background: var(--green);
+  color: var(--paper);
+  border-bottom: 5px solid var(--gold);
+  border-radius: 8px;
+}
+
+.hero h1 {
+  color: var(--paper);
+  font-size: 2.4rem;
+}
+
+.hero__tagline {
+  margin: 0 0 1.25rem;
+  font-size: 1.25rem;
+}
+
+.hero__actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.75rem;
+  margin: 0;
+}
+
+.intro .lede {
+  font-size: 1.3rem;
+  line-height: 1.5;
+}
+
+.panel {
+  padding: 1.25rem;
+  background: var(--green-tint);
+  border: 1px solid #c4d3b8;
+  border-radius: 8px;
+}
+
+/* Cards: shared by staff picks, coming-up events, the events page and the catalogue */
+
+.card-grid,
+.card-list,
+.event-list,
+.book-grid {
+  display: grid;
+  grid-template-columns: 1fr;
+  gap: 1.5rem;
+  list-style: none;
+  margin: 0 0 1rem;
+  padding: 0;
+}
+
+.card,
+.book {
+  padding: 1rem;
+  background: var(--card);
+  border: 1px solid var(--rule);
+  border-radius: 6px;
+  box-shadow: 0 2px 6px rgba(31, 27, 22, 0.08);
+}
+
+.card {
+  height: 100%;
+  margin: 0;
+}
+
+.card.pick {
+  display: grid;
+  grid-template-columns: 6rem 1fr;
+  gap: 1rem;
+  align-items: start;
+}
+
+.card.dated {
+  display: flex;
+  gap: 1rem;
+  align-items: flex-start;
+}
+
+.card__body {
+  min-width: 0;
+}
+
+.card__body h3 {
+  font-size: 1.15rem;
+}
+
+.card__body p:last-child {
+  margin-bottom: 0;
+}
+
+.pick__author,
+.dated__when {
+  margin: 0 0 0.35rem;
+  font-size: 1rem;
+  color: var(--ink-soft);
+}
+
+.pick__note {
+  margin: 0;
+  font-size: 1rem;
+}
+
+.date-badge {
+  display: flex;
+  flex: 0 0 auto;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  width: 4.5rem;
+  padding: 0.5rem 0;
+  color: var(--paper);
+  background: var(--green);
+  border-radius: 6px;
+  line-height: 1;
+  text-align: center;
+}
+
+.date-badge__day {
+  font-size: 1.9rem;
+  font-weight: bold;
+}
+
+.date-badge__month {
+  margin-top: 0.25rem;
+  font-size: 0.85rem;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+}
+
+@media (min-width: 600px) {
+  .card-grid,
+  .card-list,
+  .event-list {
+    grid-template-columns: repeat(2, 1fr);
+  }
+}
+
+@media (min-width: 960px) {
+  .card-grid,
+  .card-list {
+    grid-template-columns: repeat(3, 1fr);
+  }
+}
+
+@media (prefers-reduced-motion: no-preference) {
+  .card,
+  .book {
+    transition: box-shadow 0.2s ease, transform 0.2s ease;
+  }
+
+  .card:hover,
+  .book:hover {
+    box-shadow: 0 6px 16px rgba(31, 27, 22, 0.14);
+    transform: translateY(-2px);
+  }
+}
+
+/* Books */
+
+.filter {
+  display: flex;
+  flex-direction: column;
+  gap: 0.5rem;
+  margin: 1.5rem 0 1rem;
+}
+
+.filter label {
+  font-weight: bold;
+}
+
+select,
+input,
+textarea {
+  width: 100%;
+  max-width: 100%;
+  min-height: 44px;
+  padding: 0.6rem 0.75rem;
+  font: inherit;
+  font-size: 1rem;
+  color: var(--ink);
+  background: var(--card);
+  border: 1px solid var(--field-border);
+  border-radius: 4px;
+}
+
+@media (min-width: 600px) {
+  .filter {
+    flex-direction: row;
+    align-items: center;
+  }
+
+  .filter select {
+    width: auto;
+    min-width: 16rem;
+  }
+}
+
+.result-count {
+  margin-bottom: 1.25rem;
+  font-size: 1rem;
+  color: var(--ink-soft);
+}
+
+.book-grid {
+  gap: 2rem 1.5rem;
+}
+
+@media (min-width: 600px) {
+  .book-grid {
+    grid-template-columns: repeat(2, 1fr);
+  }
+}
+
+@media (min-width: 900px) {
+  .book-grid {
+    grid-template-columns: repeat(3, 1fr);
+  }
+}
+
+.book-item {
+  min-width: 0;
+}
+
+.book {
+  display: grid;
+  grid-template-columns: 7rem 1fr;
+  gap: 1rem;
+  align-items: start;
+  height: 100%;
+}
+
+.book__title {
+  font-size: 1.2rem;
+  margin-bottom: 0.25rem;
+}
+
+.book__author,
+.book__genre {
+  margin: 0;
+  font-size: 1rem;
+  color: var(--ink-soft);
+}
+
+.book__genre {
+  font-style: italic;
+}
+
+.book__description {
+  margin: 0.5rem 0;
+  font-size: 1rem;
+}
+
+.book__price {
+  margin: 0;
+  font-weight: bold;
+}
+
+/* Book covers, drawn in CSS. Decorative: the text is repeated in the card. */
+
+.cover {
+  aspect-ratio: 2 / 3;
+  display: flex;
+  flex-direction: column;
+  justify-content: flex-end;
+  padding: 0.6rem;
+  overflow: hidden;
+  border-radius: 2px 5px 5px 2px;
+  background: var(--ink);
+  color: var(--paper);
+  box-shadow: inset 6px 0 0 rgba(0, 0, 0, 0.25), 0 3px 8px rgba(31, 27, 22, 0.25);
+  font-size: 0.8rem;
+  line-height: 1.2;
+}
+
+.cover__title {
+  font-size: 0.95rem;
+  font-weight: bold;
+  margin-bottom: 0.25rem;
+  overflow-wrap: anywhere;
+}
+
+.cover__author {
+  font-size: 0.75rem;
+}
+
+.cover--fiction {
+  background: #7a2330;
+}
+
+.cover--poetry {
+  background: #1f4a3a;
+}
+
+.cover--essays {
+  background: #2c3e5c;
+}
+
+.cover--history {
+  background: #7d4e24;
+}
+
+.cover--nature-place {
+  background: #4a6330;
+}
+
+/* Events */
+
+.event__title {
+  font-size: 1.25rem;
+}
+
+.event__booking {
+  display: inline-block;
+  max-width: 100%;
+  margin: 0 0 0.5rem;
+  padding: 0.2rem 0.75rem;
+  font-size: 0.9rem;
+  font-weight: bold;
+  color: var(--ink);
+  background: var(--gold-tint);
+  border: 1px solid #b8912c;
+  border-radius: 1rem;
+}
+
+.event__description {
+  margin: 0;
+}
+
+/* Visit */
+
+.visit-grid {
+  display: grid;
+  gap: 0 2.5rem;
+}
+
+@media (min-width: 900px) {
+  .visit-grid {
+    grid-template-columns: 1fr 1fr;
+    align-items: start;
+  }
+}
+
+.hours {
+  width: 100%;
+  max-width: 24rem;
+  border-collapse: collapse;
+  margin-bottom: 1rem;
+}
+
+.hours th,
+.hours td {
+  padding: 0.5rem 0.75rem 0.5rem 0;
+  text-align: left;
+  border-bottom: 1px solid var(--rule);
+}
+
+.access-list {
+  margin: 0 0 1rem;
+  padding-left: 1.25rem;
+}
+
+.access-list li {
+  margin-bottom: 0.5rem;
+}
+
+.notice {
+  padding: 0.75rem 1rem;
+  background: var(--paper-deep);
+  border-left: 4px solid var(--green);
+}
+
+.contact-form {
+  max-width: 36rem;
+}
+
+.field {
+  margin-bottom: 1.25rem;
+}
+
+.field label {
+  display: block;
+  margin-bottom: 0.35rem;
+  font-weight: bold;
+}
+
+.field-note {
+  font-weight: normal;
+  color: var(--ink-soft);
+}
+
+.hint {
+  margin: 0 0 0.35rem;
+  font-size: 0.95rem;
+  color: var(--ink-soft);
+}
+
+.field-error {
+  margin: 0.35rem 0 0;
+  font-size: 1rem;
+  font-weight: bold;
+  color: var(--error);
+}
+
+[aria-invalid="true"] {
+  border: 2px solid var(--error);
+}
+
+.form-status {
+  max-width: 36rem;
+  margin-top: 1rem;
+}
+
+.form-status:not(:empty) {
+  padding: 0.75rem 1rem;
+  background: var(--paper-deep);
+  border-left: 4px solid var(--green);
+}
+
+/* Footer */
+
+.site-footer {
+  background: var(--paper-deep);
+  border-top: 1px solid var(--rule);
+}
+
+.site-footer .container {
+  padding-top: 2rem;
+  padding-bottom: 2rem;
+}
+
+.site-footer nav ul {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.5rem 1.25rem;
+  margin: 0 0 1rem;
+  padding: 0;
+  list-style: none;
+}
+
+.site-footer p {
+  color: var(--ink-soft);
+}
+
+/* Motion */
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    transition: none !important;
+    animation: none !important;
+    scroll-behavior: auto !important;
+  }
+}
