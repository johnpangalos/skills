+
+describe('ariaHideOutside with shadow DOM', function () {
+  let cleanups = [];
+
+  beforeAll(() => {
+    enableShadowDOM();
+  });
+
+  afterEach(() => {
+    for (let cleanup of cleanups) {
+      cleanup();
+    }
+    cleanups = [];
+  });
+
+  function appendElement(parent, tag = 'div') {
+    let element = document.createElement(tag);
+    parent.appendChild(element);
+    cleanups.push(() => element.remove());
+    return element;
+  }
+
+  function appendShadowHost(parent) {
+    let host = appendElement(parent);
+    return {host, shadowRoot: host.attachShadow({mode: 'open'})};
+  }
+
+  function appendTopLevelShadowHost() {
+    let {shadowHost, shadowRoot, cleanup} = createShadowRoot();
+    cleanups.push(cleanup);
+    return {host: shadowHost, shadowRoot};
+  }
+
+  it('hides siblings of a target that is a direct child of a shadow root', function () {
+    let {host, shadowRoot} = appendTopLevelShadowHost();
+    let sibling = appendElement(shadowRoot, 'button');
+    let target = appendElement(shadowRoot, 'input');
+    let unrelated = appendTopLevelShadowHost();
+    let unrelatedInner = appendElement(unrelated.shadowRoot, 'button');
+    let outside = appendElement(document.body, 'button');
+
+    let revert = ariaHideOutside([target]);
+
+    expect(sibling).toHaveAttribute('aria-hidden', 'true');
+    expect(outside).toHaveAttribute('aria-hidden', 'true');
+    expect(unrelated.host).toHaveAttribute('aria-hidden', 'true');
+    expect(unrelatedInner).not.toHaveAttribute('aria-hidden');
+    expect(target).not.toHaveAttribute('aria-hidden');
+    expect(host).not.toHaveAttribute('aria-hidden');
+
+    revert();
+    expect(sibling).not.toHaveAttribute('aria-hidden');
+    expect(outside).not.toHaveAttribute('aria-hidden');
+    expect(unrelated.host).not.toHaveAttribute('aria-hidden');
+  });
+
+  it('hides siblings at each level of nested shadow roots', function () {
+    let {host, shadowRoot: rootA} = appendTopLevelShadowHost();
+    let siblingA = appendElement(rootA, 'button');
+    let {host: hostB, shadowRoot: rootB} = appendShadowHost(rootA);
+    let target = appendElement(rootB, 'input');
+    let siblingB = appendElement(rootB, 'button');
+    let outside = appendElement(document.body, 'button');
+
+    let revert = ariaHideOutside([target]);
+
+    expect(siblingA).toHaveAttribute('aria-hidden', 'true');
+    expect(siblingB).toHaveAttribute('aria-hidden', 'true');
+    expect(outside).toHaveAttribute('aria-hidden', 'true');
+    expect(host).not.toHaveAttribute('aria-hidden');
+    expect(hostB).not.toHaveAttribute('aria-hidden');
+    expect(target).not.toHaveAttribute('aria-hidden');
+
+    revert();
+    expect(siblingA).not.toHaveAttribute('aria-hidden');
+    expect(siblingB).not.toHaveAttribute('aria-hidden');
+    expect(outside).not.toHaveAttribute('aria-hidden');
+  });
+
+  it('hides content added later to a target shadow root, but not content added inside a target', async function () {
+    let {shadowRoot} = appendTopLevelShadowHost();
+    let target = appendElement(shadowRoot);
+    let revert = ariaHideOutside([target]);
+
+    let added = appendElement(shadowRoot, 'button');
+    let addedInTarget = appendElement(target, 'button');
+
+    await waitFor(() => expect(added).toHaveAttribute('aria-hidden', 'true'));
+    expect(addedInTarget).not.toHaveAttribute('aria-hidden');
+    revert();
+  });
+
+  it('hides content added later to an enclosing shadow root of a target', async function () {
+    let {shadowRoot: rootA} = appendTopLevelShadowHost();
+    let {shadowRoot: rootB} = appendShadowHost(rootA);
+    let target = appendElement(rootB);
+    let revert = ariaHideOutside([target]);
+
+    let added = appendElement(rootA, 'button');
+    let addedInRootB = appendElement(rootB, 'button');
+
+    await waitFor(() => expect(added).toHaveAttribute('aria-hidden', 'true'));
+    await waitFor(() => expect(addedInRootB).toHaveAttribute('aria-hidden', 'true'));
+    revert();
+  });
+
+  it('hides a shadow host added later as a whole without marking its shadow content', async function () {
+    let {shadowRoot} = appendTopLevelShadowHost();
+    let target = appendElement(shadowRoot);
+    let revert = ariaHideOutside([target]);
+
+    let {host: newHost, shadowRoot: newShadowRoot} = appendShadowHost(shadowRoot);
+    let newInner = appendElement(newShadowRoot, 'button');
+
+    await waitFor(() => expect(newHost).toHaveAttribute('aria-hidden', 'true'));
+    expect(newInner).not.toHaveAttribute('aria-hidden');
+    revert();
+  });
+
+  it('keeps live announcers and top layer elements visible in shadow roots', async function () {
+    let {shadowRoot} = appendTopLevelShadowHost();
+    let target = appendElement(shadowRoot);
+    let existingAnnouncer = appendElement(shadowRoot);
+    existingAnnouncer.dataset.liveAnnouncer = 'true';
+    let revert = ariaHideOutside([target]);
+
+    let addedAnnouncer = appendElement(shadowRoot);
+    addedAnnouncer.dataset.liveAnnouncer = 'true';
+    let addedTopLayer = appendElement(shadowRoot);
+    addedTopLayer.dataset.reactAriaTopLayer = 'true';
+    let plain = appendElement(shadowRoot);
+
+    await waitFor(() => expect(plain).toHaveAttribute('aria-hidden', 'true'));
+    expect(existingAnnouncer).not.toHaveAttribute('aria-hidden');
+    expect(addedAnnouncer).not.toHaveAttribute('aria-hidden');
+    expect(addedTopLayer).not.toHaveAttribute('aria-hidden');
+    revert();
+  });
+
+  it('keeps targets in different shadow roots visible and hides the rest of both', async function () {
+    let a = appendTopLevelShadowHost();
+    let b = appendTopLevelShadowHost();
+    let input = appendElement(a.shadowRoot, 'input');
+    let popover = appendElement(b.shadowRoot);
+    let siblingA = appendElement(a.shadowRoot);
+    let siblingB = appendElement(b.shadowRoot);
+    let outside = appendElement(document.body, 'button');
+
+    let revert = ariaHideOutside([input, popover]);
+
+    expect(a.host).not.toHaveAttribute('aria-hidden');
+    expect(b.host).not.toHaveAttribute('aria-hidden');
+    expect(input).not.toHaveAttribute('aria-hidden');
+    expect(popover).not.toHaveAttribute('aria-hidden');
+    expect(siblingA).toHaveAttribute('aria-hidden', 'true');
+    expect(siblingB).toHaveAttribute('aria-hidden', 'true');
+    expect(outside).toHaveAttribute('aria-hidden', 'true');
+
+    let addedA = appendElement(a.shadowRoot);
+    let addedB = appendElement(b.shadowRoot);
+    await waitFor(() => expect(addedB).toHaveAttribute('aria-hidden', 'true'));
+    expect(addedA).toHaveAttribute('aria-hidden', 'true');
+    revert();
+  });
+
+  it('restores shadow root content and stops observing it after revert', async function () {
+    let {shadowRoot} = appendTopLevelShadowHost();
+    let target = appendElement(shadowRoot);
+    let sibling = appendElement(shadowRoot);
+    let revert = ariaHideOutside([target]);
+    expect(sibling).toHaveAttribute('aria-hidden', 'true');
+
+    revert();
+    expect(sibling).not.toHaveAttribute('aria-hidden');
+
+    let added = appendElement(shadowRoot);
+    await new Promise((resolve) => setTimeout(resolve, 0));
+    expect(added).not.toHaveAttribute('aria-hidden');
+  });
+
+  it('re-hides content added to shadow roots after a nested call reverts', async function () {
+    let {host, shadowRoot: rootA} = appendTopLevelShadowHost();
+    let x1 = appendElement(rootA, 'button');
+    let outerTarget = appendElement(rootA);
+    let {shadowRoot: rootB} = appendShadowHost(outerTarget);
+    let innerTarget = appendElement(rootB);
+    let y1 = appendElement(rootB, 'button');
+    let outside = appendElement(document.body, 'button');
+
+    let outerRevert = ariaHideOutside([outerTarget]);
+    let innerRevert = ariaHideOutside([innerTarget]);
+
+    expect(host).not.toHaveAttribute('aria-hidden');
+    expect(outside).toHaveAttribute('aria-hidden', 'true');
+    expect(x1).toHaveAttribute('aria-hidden', 'true');
+    expect(y1).toHaveAttribute('aria-hidden', 'true');
+
+    innerRevert();
+    expect(y1).not.toHaveAttribute('aria-hidden');
+    expect(x1).toHaveAttribute('aria-hidden', 'true');
+
+    let added = appendElement(rootA, 'button');
+    await waitFor(() => expect(added).toHaveAttribute('aria-hidden', 'true'));
+    outerRevert();
+    expect(x1).not.toHaveAttribute('aria-hidden');
+    expect(added).not.toHaveAttribute('aria-hidden');
+    expect(outside).not.toHaveAttribute('aria-hidden');
+  });
+
+  it('does not hide shadow-internal wrappers of a slotted target', function () {
+    let {host, shadowRoot} = appendShadowHost(document.body);
+    shadowRoot.innerHTML = '<div id="wrapper"><slot></slot></div>';
+    let wrapper = shadowRoot.getElementById('wrapper');
+    let target = appendElement(host, 'input');
+
+    let revert = ariaHideOutside([target]);
+
+    expect(target).not.toHaveAttribute('aria-hidden');
+    expect(host).not.toHaveAttribute('aria-hidden');
+    expect(wrapper).not.toHaveAttribute('aria-hidden');
+    revert();
+  });
+
+  it('does not hide anything above or outside a root inside a shadow root, now or later', async function () {
+    let {host, shadowRoot} = appendTopLevelShadowHost();
+    let outsideRoot = appendElement(shadowRoot, 'button');
+    let container = appendElement(shadowRoot);
+    let target = appendElement(container, 'input');
+    let insideSibling = appendElement(container, 'button');
+    let bodySibling = appendElement(document.body, 'button');
+
+    let revert = ariaHideOutside([target], {root: container});
+
+    expect(insideSibling).toHaveAttribute('aria-hidden', 'true');
+    expect(outsideRoot).not.toHaveAttribute('aria-hidden');
+    expect(bodySibling).not.toHaveAttribute('aria-hidden');
+    expect(host).not.toHaveAttribute('aria-hidden');
+    expect(container).not.toHaveAttribute('aria-hidden');
+
+    let addedOutsideRoot = appendElement(shadowRoot, 'button');
+    let addedInRoot = appendElement(container, 'button');
+    await waitFor(() => expect(addedInRoot).toHaveAttribute('aria-hidden', 'true'));
+    expect(addedOutsideRoot).not.toHaveAttribute('aria-hidden');
+    expect(outsideRoot).not.toHaveAttribute('aria-hidden');
+    revert();
+  });
+
+  it('does not observe a shadow root whose host is outside a light DOM root', async function () {
+    let {host, shadowRoot} = appendTopLevelShadowHost();
+    let target = appendElement(shadowRoot);
+    let sibling = appendElement(shadowRoot);
+    let container = appendElement(document.body);
+
+    let revert = ariaHideOutside([target], {root: container});
+
+    expect(sibling).not.toHaveAttribute('aria-hidden');
+    expect(host).not.toHaveAttribute('aria-hidden');
+
+    let addedInShadowRoot = appendElement(shadowRoot, 'button');
+    await new Promise((resolve) => setTimeout(resolve, 0));
+    expect(addedInShadowRoot).not.toHaveAttribute('aria-hidden');
+    expect(sibling).not.toHaveAttribute('aria-hidden');
+    expect(host).not.toHaveAttribute('aria-hidden');
+    revert();
+  });
+});
