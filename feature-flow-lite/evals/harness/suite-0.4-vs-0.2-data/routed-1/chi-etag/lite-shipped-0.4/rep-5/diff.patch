+func TestETagHeadReplay(t *testing.T) {
+	ts := httptest.NewServer(ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Cache-Control", "max-age=60")
+		w.Write([]byte("hello"))
+	})))
+	defer ts.Close()
+
+	getResp, getBody := etagRequest(t, ts, http.MethodGet, nil)
+	if getBody != "hello" {
+		t.Fatalf("GET body: got %q, want %q", getBody, "hello")
+	}
+	getETag := getResp.Header.Get("ETag")
+	if getETag != etagDigest("hello") {
+		t.Fatalf("GET ETag: got %q, want %q", getETag, etagDigest("hello"))
+	}
+
+	headResp, headBody := etagRequest(t, ts, http.MethodHead, nil)
+	if headBody != "" {
+		t.Fatalf("HEAD body: got %q, want empty", headBody)
+	}
+	if headResp.Header.Get("ETag") != getETag {
+		t.Fatalf("HEAD ETag: got %q, want %q", headResp.Header.Get("ETag"), getETag)
+	}
+	if headResp.ContentLength != int64(len("hello")) {
+		t.Fatalf("HEAD Content-Length: got %d, want %d", headResp.ContentLength, len("hello"))
+	}
+
+	notModified, notModifiedBody := etagRequest(t, ts, http.MethodHead, http.Header{"If-None-Match": {getETag}})
+	if notModified.StatusCode != http.StatusNotModified || notModifiedBody != "" {
+		t.Fatalf("HEAD conditional: got %d %q, want 304 empty", notModified.StatusCode, notModifiedBody)
+	}
+	if notModified.Header.Get("Content-Length") != "" {
+		t.Fatalf("304 Content-Length: got %q, want none", notModified.Header.Get("Content-Length"))
+	}
+}
