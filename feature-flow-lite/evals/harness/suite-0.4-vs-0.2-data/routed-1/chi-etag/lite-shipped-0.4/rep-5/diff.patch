+	resp, _ := etagRequest(t, ts, http.MethodGet, nil)
+	if got := resp.Trailer.Get("X-Sum"); got != "abc" {
+		t.Fatalf("X-Sum trailer: got %q, want %q", got, "abc")
+	}
+	if got := resp.Trailer.Get("X-Late"); got != "late" {
+		t.Fatalf("X-Late trailer: got %q, want %q", got, "late")
+	}
+}
