+// pusherRecorder records server pushes, as HTTP/2 writers do.
+type pusherRecorder struct {
+	*httptest.ResponseRecorder
+	pushed []string
+	method string
+}
+
+func (rw *pusherRecorder) Push(target string, opts *http.PushOptions) error {
+	rw.pushed = append(rw.pushed, target)
+	rw.method = opts.Method
+	return nil
+}
+
+func TestETagForwardsPush(t *testing.T) {
+	rec := &pusherRecorder{ResponseRecorder: httptest.NewRecorder()}
+	var pushErr error
+	serveETag(rec, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		pushErr = w.(http.Pusher).Push("/style.css", &http.PushOptions{Method: http.MethodGet})
+		w.Write([]byte("body"))
+	}), http.MethodGet, nil)
+
+	if pushErr != nil {
+		t.Fatalf("Push: got %v, want nil", pushErr)
+	}
+	if !reflect.DeepEqual(rec.pushed, []string{"/style.css"}) || rec.method != http.MethodGet {
+		t.Fatalf("pushed: got %v method %q, want [/style.css] GET", rec.pushed, rec.method)
+	}
+}
+
+func TestETagPushWithoutPusherFails(t *testing.T) {
+	var pushErr error
+	rec := httptest.NewRecorder()
+	serveETag(rec, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		pushErr = w.(http.Pusher).Push("/style.css", nil)
+		w.Write([]byte("body"))
+	}), http.MethodGet, nil)
+
+	const want = "chi/middleware: http.Pusher is unavailable on the writer"
+	if pushErr == nil || pushErr.Error() != want {
+		t.Fatalf("Push error: got %v, want %q", pushErr, want)
+	}
+}
