+func TestETagPassesThroughOtherMethods(t *testing.T) {
+	for _, method := range []string{http.MethodPost, http.MethodPut, http.MethodDelete, http.MethodOptions, http.MethodPatch} {
+		rec := httptest.NewRecorder()
+		var got http.ResponseWriter
+		serveETag(rec, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			got = w
+			w.Write([]byte("ok"))
+		}), method, http.Header{"If-None-Match": {"*"}})
+
+		if got != http.ResponseWriter(rec) {
+			t.Fatalf("%s: next handler did not receive the original ResponseWriter", method)
+		}
+		if rec.Code != http.StatusOK || rec.Body.String() != "ok" {
+			t.Fatalf("%s: got %d %q, want 200 \"ok\"", method, rec.Code, rec.Body.String())
+		}
+		if _, ok := rec.Header()["Etag"]; ok {
+			t.Fatalf("%s: ETag was added", method)
+		}
+	}
+}
