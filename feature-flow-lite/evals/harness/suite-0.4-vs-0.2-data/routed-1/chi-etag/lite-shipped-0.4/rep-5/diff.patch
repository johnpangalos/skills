+func TestETagPassesThroughNon200Unchanged(t *testing.T) {
+	for _, status := range []int{201, 204, 206, 301, 304, 404, 500} {
+		h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Content-Type", "text/plain")
+			w.Header().Set("Cache-Control", "no-store")
+			w.WriteHeader(status)
+			w.Write([]byte("body"))
+		})
+
+		want := httptest.NewRecorder()
+		h.ServeHTTP(want, httptest.NewRequest(http.MethodGet, "/", http.NoBody))
+
+		got := httptest.NewRecorder()
+		serveETag(got, h, http.MethodGet, http.Header{"If-None-Match": {"*"}})
+
+		if got.Code != want.Code || got.Body.String() != want.Body.String() {
+			t.Fatalf("status %d: got %d %q, want %d %q", status, got.Code, got.Body.String(), want.Code, want.Body.String())
+		}
+		if !reflect.DeepEqual(got.Header(), want.Header()) {
+			t.Fatalf("status %d: headers got %v, want %v", status, got.Header(), want.Header())
+		}
+	}
+}
