diff --git a/middleware/etag.go b/middleware/etag.go
new file mode 100644
index 0000000..3002d91
--- /dev/null
+++ b/middleware/etag.go
@@ -0,0 +1,233 @@
+package middleware
+
+import (
+	"bufio"
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"maps"
+	"net"
+	"net/http"
+	"strings"
+)
+
+// ETag is a middleware that adds a strong ETag to GET and HEAD responses and
+// answers conditional requests with 304 Not Modified.
+//
+// The response is buffered until the handler returns, so the whole body is
+// held in memory. When the handler responds 200 without setting an ETag
+// header, the ETag is the quoted hex SHA-256 digest of the body. If the
+// request's If-None-Match header matches the response's ETag under the weak
+// comparison of RFC 9110 section 13.1.2, the response is replaced by a
+// 304 Not Modified without a body. Responses with any other status are sent
+// unchanged, and methods other than GET and HEAD are not buffered at all.
+func ETag(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet && r.Method != http.MethodHead {
+			next.ServeHTTP(w, r)
+			return
+		}
+
+		bw := &etagWriter{dst: w, header: w.Header().Clone()}
+		next.ServeHTTP(bw, r)
+		bw.replay(r)
+	})
+}
+
+// etagWriter buffers a response so that ETag can inspect it before it is sent.
+type etagWriter struct {
+	dst         http.ResponseWriter
+	header      http.Header
+	snapshot    http.Header
+	status      int
+	wroteHeader bool
+	hijacked    bool
+	body        bytes.Buffer
+}
+
+// Header returns the buffered header map. Changes made after the first
+// WriteHeader or Write are not sent.
+func (bw *etagWriter) Header() http.Header {
+	return bw.header
+}
+
+// WriteHeader records the status code and snapshots the headers. Informational
+// (1xx) responses other than 101 are forwarded to the underlying writer
+// immediately. Any WriteHeader after the final status is ignored.
+func (bw *etagWriter) WriteHeader(code int) {
+	if bw.wroteHeader {
+		return
+	}
+	if code >= 100 && code < 200 && code != http.StatusSwitchingProtocols {
+		clear(bw.dst.Header())
+		maps.Copy(bw.dst.Header(), bw.header)
+		bw.dst.WriteHeader(code)
+		return
+	}
+	bw.wroteHeader = true
+	bw.status = code
+	bw.snapshot = bw.header.Clone()
+}
+
+// Write buffers p. Like net/http, it implies a 200 status if none was set.
+func (bw *etagWriter) Write(p []byte) (int, error) {
+	if !bw.wroteHeader {
+		bw.WriteHeader(http.StatusOK)
+	}
+	return bw.body.Write(p)
+}
+
+// Flush does nothing, so that nothing is sent before the ETag is known.
+func (bw *etagWriter) Flush() {}
+
+// Unwrap returns the underlying writer, so that http.ResponseController can
+// reach its deadline and full-duplex support.
+func (bw *etagWriter) Unwrap() http.ResponseWriter {
+	return bw.dst
+}
+
+// Hijack hands the connection to the underlying writer. The buffered response
+// is then never sent, because the caller owns the connection.
+func (bw *etagWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	hj, ok := bw.dst.(http.Hijacker)
+	if !ok {
+		return nil, nil, errors.New("chi/middleware: http.Hijacker is unavailable on the writer")
+	}
+	conn, rw, err := hj.Hijack()
+	if err == nil {
+		bw.hijacked = true
+	}
+	return conn, rw, err
+}
+
+// Push forwards a server push to the underlying writer. A pushed resource is
+// not part of the buffered response, so it is sent immediately.
+func (bw *etagWriter) Push(target string, opts *http.PushOptions) error {
+	if ps, ok := bw.dst.(http.Pusher); ok {
+		return ps.Push(target, opts)
+	}
+	return errors.New("chi/middleware: http.Pusher is unavailable on the writer")
+}
+
+// replay sends the buffered response to the underlying writer, unless the
+// connection was hijacked.
+func (bw *etagWriter) replay(r *http.Request) {
+	if bw.hijacked {
+		return
+	}
+	if !bw.wroteHeader {
+		bw.WriteHeader(http.StatusOK)
+	}
+	if bw.status == http.StatusOK {
+		// A HEAD response with an empty body has nothing to hash, so it only
+		// keeps an ETag the handler set.
+		if r.Method == http.MethodGet || bw.body.Len() > 0 {
+			bw.setETag()
+		}
+		if etagMatch(r.Header.Values("If-None-Match"), bw.snapshot.Get("ETag")) {
+			bw.notModified()
+		}
+	}
+
+	h := bw.dst.Header()
+	clear(h)
+	maps.Copy(h, bw.snapshot)
+	bw.dst.WriteHeader(bw.status)
+	if bw.body.Len() > 0 {
+		bw.dst.Write(bw.body.Bytes())
+	}
+	bw.copyTrailers(h)
+}
+
+// copyTrailers sets the trailers the handler declared in the Trailer header and
+// the ones named with http.TrailerPrefix. Their values are read from the live
+// header map, as net/http does when it finishes the response.
+func (bw *etagWriter) copyTrailers(h http.Header) {
+	for _, line := range bw.snapshot.Values("Trailer") {
+		for _, key := range strings.Split(line, ",") {
+			key = http.CanonicalHeaderKey(strings.TrimSpace(key))
+			if vals, ok := bw.header[key]; ok {
+				h[key] = vals
+			}
+		}
+	}
+	for key, vals := range bw.header {
+		if strings.HasPrefix(key, http.TrailerPrefix) {
+			h[key] = vals
+		}
+	}
+}
+
+// setETag adds a strong ETag computed from the body, unless the handler set an
+// ETag header of its own, even an empty one.
+func (bw *etagWriter) setETag() {
+	if _, ok := bw.snapshot[http.CanonicalHeaderKey("ETag")]; ok {
+		return
+	}
+	sum := sha256.Sum256(bw.body.Bytes())
+	bw.snapshot.Set("ETag", `"`+hex.EncodeToString(sum[:])+`"`)
+}
+
+// notModified turns the buffered response into a 304 without a body. Validator
+// and caching headers are kept; Content-Length and Content-Type are dropped
+// because they describe the body that is no longer sent.
+func (bw *etagWriter) notModified() {
+	bw.snapshot.Del("Content-Length")
+	bw.snapshot.Del("Content-Type")
+	bw.status = http.StatusNotModified
+	bw.body.Reset()
+}
+
+// etagMatch reports whether any member of the If-None-Match header lines
+// matches etag under weak comparison. A "*" member matches any representation.
+func etagMatch(ifNoneMatch []string, etag string) bool {
+	current, currentOK := parseEntityTag(etag)
+	for _, line := range ifNoneMatch {
+		for _, member := range splitETagList(line) {
+			if member == "*" {
+				return true
+			}
+			if tag, ok := parseEntityTag(member); ok && currentOK && tag == current {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// splitETagList splits a header line on commas that are outside quotes. It
+// trims optional whitespace from each member and drops empty members.
+func splitETagList(line string) []string {
+	var members []string
+	inQuotes := false
+	start := 0
+	for i := 0; i <= len(line); i++ {
+		if i == len(line) || (line[i] == ',' && !inQuotes) {
+			if member := strings.Trim(line[start:i], " \t"); member != "" {
+				members = append(members, member)
+			}
+			start = i + 1
+		} else if line[i] == '"' {
+			inQuotes = !inQuotes
+		}
+	}
+	return members
+}
+
+// parseEntityTag returns the opaque-tag of an entity-tag, without its weakness
+// prefix or quotes. It reports false if s is not a well-formed entity-tag.
+func parseEntityTag(s string) (string, bool) {
+	s = strings.TrimPrefix(s, "W/")
+	if len(s) < 2 || s[0] != '"' || s[len(s)-1] != '"' {
+		return "", false
+	}
+	opaque := s[1 : len(s)-1]
+	for i := 0; i < len(opaque); i++ {
+		c := opaque[i]
+		if c != 0x21 && (c < 0x23 || c > 0x7e) && c < 0x80 {
+			return "", false
+		}
+	}
+	return opaque, true
+}
diff --git a/middleware/etag_test.go b/middleware/etag_test.go
new file mode 100644
index 0000000..1b47b71
--- /dev/null
+++ b/middleware/etag_test.go
@@ -0,0 +1,615 @@
+package middleware
+
+import (
+	"bufio"
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"io"
+	"maps"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+)
+
+func etagDigest(body string) string {
+	sum := sha256.Sum256([]byte(body))
+	return `"` + hex.EncodeToString(sum[:]) + `"`
+}
+
+// serveETag runs a request with the given method and headers through ETag(h).
+func serveETag(w http.ResponseWriter, h http.Handler, method string, header http.Header) {
+	req := httptest.NewRequest(method, "/", http.NoBody)
+	maps.Copy(req.Header, header)
+	ETag(h).ServeHTTP(w, req)
+}
+
+func etagRequest(t *testing.T, ts *httptest.Server, method string, header http.Header) (*http.Response, string) {
+	t.Helper()
+	req, err := http.NewRequest(method, ts.URL, http.NoBody)
+	if err != nil {
+		t.Fatal(err)
+	}
+	maps.Copy(req.Header, header)
+
+	resp, err := http.DefaultClient.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+
+	respBody, err := io.ReadAll(resp.Body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return resp, string(respBody)
+}
+
+// informationalRecorder records 1xx status codes separately from the final response.
+type informationalRecorder struct {
+	*httptest.ResponseRecorder
+	informational []int
+	linkAtInfo    string
+}
+
+func (rw *informationalRecorder) WriteHeader(code int) {
+	if code >= 100 && code < 200 && code != http.StatusSwitchingProtocols {
+		rw.informational = append(rw.informational, code)
+		rw.linkAtInfo = rw.Header().Get("Link")
+		return
+	}
+	rw.ResponseRecorder.WriteHeader(code)
+}
+
+func TestETagComputesStrongDigest(t *testing.T) {
+	hello := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("hello"))
+	})
+	rec := httptest.NewRecorder()
+	serveETag(rec, hello, http.MethodGet, nil)
+
+	if rec.Code != http.StatusOK {
+		t.Fatalf("status: got %d, want %d", rec.Code, http.StatusOK)
+	}
+	if got, want := rec.Header().Get("ETag"), etagDigest("hello"); got != want {
+		t.Fatalf("ETag: got %q, want %q", got, want)
+	}
+
+	again := httptest.NewRecorder()
+	serveETag(again, hello, http.MethodGet, nil)
+	if again.Header().Get("ETag") != rec.Header().Get("ETag") {
+		t.Fatal("same body produced different ETags")
+	}
+
+	other := httptest.NewRecorder()
+	serveETag(other, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("world"))
+	}), http.MethodGet, nil)
+	if other.Header().Get("ETag") == rec.Header().Get("ETag") {
+		t.Fatal("different body produced the same ETag")
+	}
+}
+
+func TestETagEmptyBodyIs200(t *testing.T) {
+	rec := httptest.NewRecorder()
+	serveETag(rec, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}), http.MethodGet, nil)
+
+	if rec.Code != http.StatusOK {
+		t.Fatalf("status: got %d, want %d", rec.Code, http.StatusOK)
+	}
+	if got, want := rec.Header().Get("ETag"), etagDigest(""); got != want {
+		t.Fatalf("ETag: got %q, want %q", got, want)
+	}
+	if rec.Body.Len() != 0 {
+		t.Fatalf("body: got %q, want empty", rec.Body.String())
+	}
+}
+
+func TestETagKeepsHandlerSetETag(t *testing.T) {
+	for _, etag := range []string{`W/"x"`, `"x"`} {
+		rec := httptest.NewRecorder()
+		serveETag(rec, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("ETag", etag)
+			w.Write([]byte("body"))
+		}), http.MethodGet, nil)
+
+		if got := rec.Header().Get("ETag"); got != etag {
+			t.Fatalf("ETag: got %q, want %q", got, etag)
+		}
+	}
+}
+
+func TestETagKeepsHandlerSetEmptyETag(t *testing.T) {
+	rec := httptest.NewRecorder()
+	serveETag(rec, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("ETag", "")
+		w.Write([]byte("body"))
+	}), http.MethodGet, nil)
+
+	vals, ok := rec.Header()["Etag"]
+	if !ok || !reflect.DeepEqual(vals, []string{""}) {
+		t.Fatalf("ETag header: got %q (present=%v), want one empty value", vals, ok)
+	}
+}
+
+// deadlineRecorder accepts write deadlines, as the server's own writer does.
+type deadlineRecorder struct {
+	*httptest.ResponseRecorder
+	deadline time.Time
+}
+
+func (rw *deadlineRecorder) SetWriteDeadline(deadline time.Time) error {
+	rw.deadline = deadline
+	return nil
+}
+
+func TestETagBuffersUntilHandlerReturns(t *testing.T) {
+	rec := &deadlineRecorder{ResponseRecorder: httptest.NewRecorder()}
+	var bodyDuringHandler int
+	var flushErr, deadlineErr error
+	deadline := time.Now().Add(time.Minute)
+	serveETag(rec, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("partial"))
+		w.(http.Flusher).Flush()
+		flushErr = http.NewResponseController(w).Flush()
+		deadlineErr = http.NewResponseController(w).SetWriteDeadline(deadline)
+		bodyDuringHandler = rec.Body.Len()
+	}), http.MethodGet, nil)
+
+	if bodyDuringHandler != 0 || rec.Flushed {
+		t.Fatalf("data reached the client before the handler returned: body=%d flushed=%v", bodyDuringHandler, rec.Flushed)
+	}
+	if flushErr != nil {
+		t.Fatalf("ResponseController.Flush: got %v, want nil", flushErr)
+	}
+	if deadlineErr != nil {
+		t.Fatalf("ResponseController.SetWriteDeadline: got %v, want nil", deadlineErr)
+	}
+	if !rec.deadline.Equal(deadline) {
+		t.Fatalf("write deadline: got %v, want %v", rec.deadline, deadline)
+	}
+	if rec.Body.String() != "partial" {
+		t.Fatalf("body: got %q, want %q", rec.Body.String(), "partial")
+	}
+}
+
+func TestETagSnapshotsHeaders(t *testing.T) {
+	rec := httptest.NewRecorder()
+	serveETag(rec, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("X-Before", "1")
+		w.WriteHeader(http.StatusCreated)
+		w.Header().Set("X-After", "1")
+		w.WriteHeader(http.StatusInternalServerError)
+		w.Write([]byte("made"))
+	}), http.MethodGet, nil)
+
+	if rec.Code != http.StatusCreated {
+		t.Fatalf("status: got %d, want %d (first WriteHeader wins)", rec.Code, http.StatusCreated)
+	}
+	if rec.Header().Get("X-Before") != "1" || rec.Header().Get("X-After") != "" {
+		t.Fatalf("headers: got X-Before=%q X-After=%q", rec.Header().Get("X-Before"), rec.Header().Get("X-After"))
+	}
+
+	late := httptest.NewRecorder()
+	serveETag(late, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("a"))
+		w.Header().Set("X-Late", "1")
+	}), http.MethodGet, nil)
+
+	if late.Header().Get("X-Late") != "" {
+		t.Fatal("header changed after the first Write was sent")
+	}
+}
+
+func TestETagKeepsOuterHeaders(t *testing.T) {
+	outer := func(next http.Handler) http.Handler {
+		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("X-Outer", "1")
+			next.ServeHTTP(w, r)
+		})
+	}
+	rec := httptest.NewRecorder()
+	outer(ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("x"))
+	}))).ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/", http.NoBody))
+
+	if rec.Header().Get("X-Outer") != "1" {
+		t.Fatal("header set by an outer middleware was lost")
+	}
+	if rec.Header().Get("ETag") != etagDigest("x") {
+		t.Fatalf("ETag: got %q, want %q", rec.Header().Get("ETag"), etagDigest("x"))
+	}
+}
+
+func TestETagIfNoneMatch(t *testing.T) {
+	computed := etagDigest("body")
+	tests := []struct {
+		name string
+		etag string // ETag set by the handler; the digest is used when empty
+		inm  []string
+		want int
+	}{
+		{"computed tag matches", "", []string{computed}, http.StatusNotModified},
+		{"weak request matches strong", `"a"`, []string{`W/"a"`}, http.StatusNotModified},
+		{"strong request matches weak", `W/"a"`, []string{`"a"`}, http.StatusNotModified},
+		{"weak on both sides", `W/"a"`, []string{`W/"a"`}, http.StatusNotModified},
+		{"list with whitespace", `"b"`, []string{`"a" , W/"b"`}, http.StatusNotModified},
+		{"leading whitespace", `"b"`, []string{`  "b"`}, http.StatusNotModified},
+		{"empty members", `"a"`, []string{`,,"a"`}, http.StatusNotModified},
+		{"multiple header lines", `"a"`, []string{`"x"`, `"a"`}, http.StatusNotModified},
+		{"star matches handler tag", `"a"`, []string{"*"}, http.StatusNotModified},
+		{"star matches computed tag", "", []string{"*"}, http.StatusNotModified},
+		{"prefix is not a match", `"a"`, []string{`"ab"`}, http.StatusOK},
+		{"different tag", `"a"`, []string{`"b"`}, http.StatusOK},
+		{"no member matches", `"c"`, []string{`"a" , W/"b"`}, http.StatusOK},
+		{"unquoted member", `"a"`, []string{`a`}, http.StatusOK},
+		{"bare weak prefix", `"a"`, []string{`W/`}, http.StatusOK},
+		{"unterminated quote", `"a"`, []string{`"unterminated`}, http.StatusOK},
+		{"unterminated before a valid tag", `"a"`, []string{`"unterminated, "a"`}, http.StatusOK},
+		{"empty quoted tag", `"a"`, []string{`""`}, http.StatusOK},
+		{"no If-None-Match", "", nil, http.StatusOK},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if tc.etag != "" {
+					w.Header().Set("ETag", tc.etag)
+				}
+				w.Write([]byte("body"))
+			})
+			rec := httptest.NewRecorder()
+			serveETag(rec, h, http.MethodGet, http.Header{"If-None-Match": tc.inm})
+
+			if rec.Code != tc.want {
+				t.Fatalf("status: got %d, want %d", rec.Code, tc.want)
+			}
+			if tc.want == http.StatusNotModified && rec.Body.Len() != 0 {
+				t.Fatalf("304 body: got %q, want empty", rec.Body.String())
+			}
+		})
+	}
+}
+
+func TestETagEmptyHandlerETagOnlyMatchesStar(t *testing.T) {
+	tests := []struct {
+		inm  string
+		want int
+	}{
+		{`""`, http.StatusOK},
+		{`*`, http.StatusNotModified},
+	}
+	for _, tc := range tests {
+		rec := httptest.NewRecorder()
+		serveETag(rec, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header()["ETag"] = []string{""}
+			w.Write([]byte("body"))
+		}), http.MethodGet, http.Header{"If-None-Match": {tc.inm}})
+
+		if rec.Code != tc.want {
+			t.Fatalf("If-None-Match %q: status got %d, want %d", tc.inm, rec.Code, tc.want)
+		}
+	}
+}
+
+func TestETagNotModifiedKeepsValidatorHeaders(t *testing.T) {
+	rec := httptest.NewRecorder()
+	serveETag(rec, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Cache-Control", "max-age=60")
+		w.Header().Set("Content-Location", "/v2")
+		w.Header().Set("Expires", "Wed, 21 Oct 2037 07:28:00 GMT")
+		w.Header().Set("Vary", "Accept-Encoding")
+		w.Header().Set("Content-Type", "text/plain")
+		w.Header().Set("Content-Length", "4")
+		w.Write([]byte("body"))
+	}), http.MethodGet, http.Header{"If-None-Match": {etagDigest("body")}})
+
+	if rec.Code != http.StatusNotModified {
+		t.Fatalf("status: got %d, want %d", rec.Code, http.StatusNotModified)
+	}
+	for _, name := range []string{"Cache-Control", "Content-Location", "Expires", "Vary", "ETag"} {
+		if rec.Header().Get(name) == "" {
+			t.Errorf("304 is missing %s", name)
+		}
+	}
+	for _, name := range []string{"Content-Length", "Content-Type"} {
+		if vals, ok := rec.Header()[name]; ok {
+			t.Errorf("304 still has %s: %q", name, vals)
+		}
+	}
+	if rec.Body.Len() != 0 {
+		t.Fatalf("304 body: got %q, want empty", rec.Body.String())
+	}
+}
