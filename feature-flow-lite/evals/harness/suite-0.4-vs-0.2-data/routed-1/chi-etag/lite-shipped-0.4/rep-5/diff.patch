+		t.Fatalf("Link on 103: got %q", rec.linkAtInfo)
+	}
+	if rec.Code != http.StatusOK {
+		t.Fatalf("final status: got %d, want 200", rec.Code)
+	}
+	if got, want := rec.Header().Get("ETag"), etagDigest("body"); got != want {
+		t.Fatalf("ETag: got %q, want %q", got, want)
+	}
+}
