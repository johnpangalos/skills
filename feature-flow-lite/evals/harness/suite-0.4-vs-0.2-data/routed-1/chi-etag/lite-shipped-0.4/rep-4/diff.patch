+func TestETagHEADKeepsBodyHeaders(t *testing.T) {
+	for _, code := range []int{http.StatusOK, http.StatusNotFound} {
+		h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(code)
+			w.Write([]byte("nope"))
+		})
+
+		want, _ := doETag(t, h, http.MethodHead)
+		got, body := doETag(t, ETag(h), http.MethodHead)
+		if got.StatusCode != code || body != "" {
+			t.Fatalf("%d: got status %d, body %q", code, got.StatusCode, body)
+		}
+		if got.ContentLength != 4 || got.ContentLength != want.ContentLength {
+			t.Fatalf("%d: HEAD Content-Length %d, without ETag %d", code, got.ContentLength, want.ContentLength)
+		}
+		if got.Header.Get("Content-Type") != want.Header.Get("Content-Type") || got.Header.Get("Content-Type") == "" {
+			t.Fatalf("%d: HEAD Content-Type %q, without ETag %q", code, got.Header.Get("Content-Type"), want.Header.Get("Content-Type"))
+		}
+		if code == http.StatusOK && got.Header.Get("ETag") != etagOf("nope") {
+			t.Fatalf("HEAD ETag %q, want %q", got.Header.Get("ETag"), etagOf("nope"))
+		}
+	}
+}
