+func TestETagInformationalForwarded(t *testing.T) {
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Link", "</style.css>; rel=preload")
+		w.WriteHeader(http.StatusEarlyHints)
+		w.WriteHeader(http.StatusCreated)
+		w.Write([]byte("made"))
+	}))
+	srv := httptest.NewServer(h)
+	defer srv.Close()
+
+	var codes []int
+	var link string
+	trace := &httptrace.ClientTrace{
+		Got1xxResponse: func(code int, header textproto.MIMEHeader) error {
+			codes = append(codes, code)
+			link = header.Get("Link")
+			return nil
+		},
+	}
+	req, err := http.NewRequest(http.MethodGet, srv.URL, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	req = req.WithContext(httptrace.WithClientTrace(req.Context(), trace))
+	resp, err := srv.Client().Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode != http.StatusCreated || len(codes) != 1 || codes[0] != http.StatusEarlyHints {
+		t.Fatalf("got status %d, informational %v", resp.StatusCode, codes)
+	}
+	if link != "</style.css>; rel=preload" {
+		t.Fatalf("103 Link header %q", link)
+	}
+}
