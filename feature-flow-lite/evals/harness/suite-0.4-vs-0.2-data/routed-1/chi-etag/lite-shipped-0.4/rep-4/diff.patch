+func TestETagResponseControllerReachesServer(t *testing.T) {
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		rc := http.NewResponseController(w)
+		for _, err := range []error{
+			rc.SetWriteDeadline(time.Now().Add(time.Minute)),
+			rc.SetReadDeadline(time.Now().Add(time.Minute)),
+			rc.EnableFullDuplex(),
+		} {
+			if err != nil {
+				w.WriteHeader(http.StatusInternalServerError)
+				w.Write([]byte(err.Error()))
+				return
+			}
+		}
+		w.Write([]byte("ok"))
+	}))
+
+	resp, body := doETag(t, h, http.MethodGet)
+	if resp.StatusCode != http.StatusOK || body != "ok" {
+		t.Fatalf("got status %d, body %q", resp.StatusCode, body)
+	}
+}
