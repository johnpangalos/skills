+func TestETagHijack(t *testing.T) {
+	handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.(http.Hijacker).Hijack()
+		w.Write([]byte("after"))
+	})
+
+	w := &etagTestWriter{ResponseRecorder: httptest.NewRecorder()}
+	ETag(handler).ServeHTTP(w, httptest.NewRequest(http.MethodGet, "/", nil))
+	if !w.hijacked || w.headers != 0 || w.Body.Len() != 0 {
+		t.Fatalf("after hijack: hijacked %v, WriteHeader calls %d, body %q", w.hijacked, w.headers, w.Body.String())
+	}
+
+	w = &etagTestWriter{ResponseRecorder: httptest.NewRecorder(), hijackErr: errors.New("refused")}
+	ETag(handler).ServeHTTP(w, httptest.NewRequest(http.MethodGet, "/", nil))
+	if w.headers != 1 || w.Body.String() != "after" {
+		t.Fatalf("after failed hijack: WriteHeader calls %d, body %q", w.headers, w.Body.String())
+	}
+
+	var err error
+	ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, _, err = w.(http.Hijacker).Hijack()
+	})).ServeHTTP(httptest.NewRecorder(), httptest.NewRequest(http.MethodGet, "/", nil))
+	if err != http.ErrNotSupported {
+		t.Fatalf("got error %v, want http.ErrNotSupported", err)
+	}
+}
