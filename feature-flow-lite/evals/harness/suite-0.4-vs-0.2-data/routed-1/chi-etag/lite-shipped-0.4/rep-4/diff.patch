+func TestETagTrailersReachClient(t *testing.T) {
+	for _, code := range []int{http.StatusOK, http.StatusNotFound} {
+		h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Trailer", "X-Sum")
+			w.WriteHeader(code)
+			w.Write([]byte("abc"))
+			w.Header().Set("X-Sum", "42")
+			w.Header().Set(http.TrailerPrefix+"X-Late", "7")
+		}))
+
+		resp, body := doETag(t, h, http.MethodGet)
+		if resp.StatusCode != code || body != "abc" {
+			t.Fatalf("%d: got status %d, body %q", code, resp.StatusCode, body)
+		}
+		if resp.Trailer.Get("X-Sum") != "42" || resp.Trailer.Get("X-Late") != "7" {
+			t.Fatalf("%d: got trailers %v", code, resp.Trailer)
+		}
+	}
+}
