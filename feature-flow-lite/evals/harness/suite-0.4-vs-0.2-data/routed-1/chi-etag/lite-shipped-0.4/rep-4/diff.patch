+func TestETagConcurrentRequests(t *testing.T) {
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte(r.URL.Path))
+	}))
+
+	var wg sync.WaitGroup
+	for i := range 50 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			path := fmt.Sprintf("/%d", i)
+			rec := httptest.NewRecorder()
+			h.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, path, nil))
+			if rec.Body.String() != path || rec.Header().Get("ETag") != etagOf(path) {
+				t.Errorf("%s: got body %q, ETag %q", path, rec.Body.String(), rec.Header().Get("ETag"))
+			}
+		}()
+	}
+	wg.Wait()
+}
