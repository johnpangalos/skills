+func TestETagFlushBeforeWriteStreams(t *testing.T) {
+	rec := serveETag(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("ETag", `"x"`)
+		w.(http.Flusher).Flush()
+		w.Write([]byte("body"))
+	}, http.MethodGet, `"x"`)
+
+	if !rec.Flushed {
+		t.Error("underlying writer was not flushed")
+	}
+	if rec.Code != http.StatusOK {
+		t.Errorf("status = %d, want 200 (no 304 after Flush)", rec.Code)
+	}
+	if got := rec.Header().Get("ETag"); got != `"x"` {
+		t.Errorf("ETag = %q, want the handler value only", got)
+	}
+	if got := rec.Body.String(); got != "body" {
+		t.Errorf("body = %q, want body", got)
+	}
+}
