+func TestETagHijackWithoutWriteLogsNothing(t *testing.T) {
+	var logs syncBuffer
+	done := make(chan struct{})
+	ts := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			conn, _, err := w.(http.Hijacker).Hijack()
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			defer conn.Close()
+			io.WriteString(conn, "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok")
+		})).ServeHTTP(w, r)
+		close(done) // ETag's finish has returned by now
+	}))
+	ts.Config.ErrorLog = log.New(&logs, "", 0)
+	ts.Start()
+	defer ts.Close()
+
+	conn := etagRawGet(t, ts.Listener.Addr().String())
+	defer conn.Close()
+	resp, err := http.ReadResponse(bufio.NewReader(conn), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	body, err := io.ReadAll(resp.Body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(body) != "ok" {
+		t.Errorf("body = %q, want ok", body)
+	}
+
+	<-done
+	if got := logs.String(); got != "" {
+		t.Errorf("server logged %q, want nothing", got)
+	}
+}
