+func TestETagFlushStreamsToClient(t *testing.T) {
+	release := make(chan struct{})
+	stalled := make(chan struct{}, 1)
+	ts := httptest.NewServer(ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("data: 1\n\n"))
+		w.(http.Flusher).Flush()
+		select {
+		case <-release:
+		case <-time.After(5 * time.Second):
+			stalled <- struct{}{}
+		}
+		w.Write([]byte("data: 2\n\n"))
+	})))
+	defer ts.Close()
+
+	resp, err := http.Get(ts.URL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+	line, err := bufio.NewReader(resp.Body).ReadString('\n')
+	close(release)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if line != "data: 1\n" {
+		t.Errorf("first line = %q, want %q", line, "data: 1\n")
+	}
+	if _, err := io.ReadAll(resp.Body); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-stalled:
+		t.Error("first chunk reached the client only after the handler returned")
+	default:
+	}
+}
