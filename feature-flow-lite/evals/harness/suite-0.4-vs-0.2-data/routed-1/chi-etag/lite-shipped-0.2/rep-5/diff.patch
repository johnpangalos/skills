+func TestETagInformationalResponseIsForwarded(t *testing.T) {
+	ts := httptest.NewServer(ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Link", "</style.css>; rel=preload")
+		w.WriteHeader(http.StatusEarlyHints)
+		w.Write([]byte("hello"))
+	})))
+	defer ts.Close()
+
+	var early []string
+	trace := &httptrace.ClientTrace{
+		Got1xxResponse: func(code int, header textproto.MIMEHeader) error {
+			early = append(early, fmt.Sprintf("%d %s", code, header.Get("Link")))
+			return nil
+		},
+	}
+	req, err := http.NewRequestWithContext(httptrace.WithClientTrace(context.Background(), trace), http.MethodGet, ts.URL, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp, err := http.DefaultClient.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(resp.Body)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if len(early) != 1 || early[0] != "103 </style.css>; rel=preload" {
+		t.Errorf("informational responses = %q, want one 103 with Link", early)
+	}
+	if resp.StatusCode != http.StatusOK {
+		t.Errorf("status = %d, want 200", resp.StatusCode)
+	}
+	if got := resp.Header.Get("ETag"); got != etagOf("hello") {
+		t.Errorf("ETag = %q, want %q", got, etagOf("hello"))
+	}
+	if string(body) != "hello" {
+		t.Errorf("body = %q, want hello", body)
+	}
+}
