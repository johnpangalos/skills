+func TestETagWriteAfterHijackReturnsErrHijacked(t *testing.T) {
+	writeErr := make(chan error, 1)
+	ts := httptest.NewUnstartedServer(ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		conn, _, err := w.(http.Hijacker).Hijack()
+		if err != nil {
+			t.Error(err)
+			writeErr <- nil
+			return
+		}
+		defer conn.Close()
+		_, err = w.Write([]byte("late"))
+		writeErr <- err
+	})))
+	ts.Start()
+	defer ts.Close()
+
+	conn := etagRawGet(t, ts.Listener.Addr().String())
+	defer conn.Close()
+	if _, err := io.ReadAll(conn); err != nil {
+		t.Fatal(err)
+	}
+
+	if err := <-writeErr; !errors.Is(err, http.ErrHijacked) {
+		t.Errorf("Write after Hijack error = %v, want http.ErrHijacked", err)
+	}
+}
