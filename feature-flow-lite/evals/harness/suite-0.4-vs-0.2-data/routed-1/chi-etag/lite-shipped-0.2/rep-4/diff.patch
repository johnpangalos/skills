+func TestETagFlushStreams(t *testing.T) {
+	rec := httptest.NewRecorder()
+	r := httptest.NewRequest(http.MethodGet, "/", nil)
+	r.Header.Set("If-None-Match", "*")
+
+	ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("a"))
+		w.(http.Flusher).Flush()
+		if !rec.Flushed {
+			t.Errorf("Flush did not reach the underlying writer")
+		}
+		if rec.Body.String() != "a" {
+			t.Errorf("body after Flush = %q, want %q", rec.Body.String(), "a")
+		}
+		w.WriteHeader(http.StatusTeapot) // too late, the status is already sent
+		w.Write([]byte("b"))
+		if rec.Body.String() != "ab" {
+			t.Errorf("body after later write = %q, want %q", rec.Body.String(), "ab")
+		}
+	})).ServeHTTP(rec, r)
+
+	if rec.Code != http.StatusOK {
+		t.Errorf("status = %d, want 200 (no 304 after Flush)", rec.Code)
+	}
+	if _, ok := rec.Header()["Etag"]; ok {
+		t.Errorf("flushed response got ETag %q", rec.Header().Get("ETag"))
+	}
+}
