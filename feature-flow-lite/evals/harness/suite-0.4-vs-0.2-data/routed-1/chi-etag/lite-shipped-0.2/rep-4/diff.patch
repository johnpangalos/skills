+func TestETagSwitchingProtocolsIsFinal(t *testing.T) {
+	rec := &etagCodeRecorder{ResponseRecorder: httptest.NewRecorder()}
+	r := httptest.NewRequest(http.MethodGet, "/", nil)
+
+	ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusSwitchingProtocols)
+		w.WriteHeader(http.StatusOK)
+	})).ServeHTTP(rec, r)
+
+	if rec.Code != http.StatusSwitchingProtocols {
+		t.Errorf("status = %d, want 101", rec.Code)
+	}
+	if len(rec.codes) != 1 || rec.codes[0] != http.StatusSwitchingProtocols {
+		t.Errorf("codes = %v, want [101] sent once at the end", rec.codes)
+	}
+	if _, ok := rec.Header()["Etag"]; ok {
+		t.Errorf("101 got ETag %q", rec.Header().Get("ETag"))
+	}
+}
