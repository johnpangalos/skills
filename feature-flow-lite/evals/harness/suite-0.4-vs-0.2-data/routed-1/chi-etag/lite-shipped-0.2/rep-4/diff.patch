+func TestETagHijackSkipsFinish(t *testing.T) {
+	var logs bytes.Buffer
+	served := make(chan struct{})
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		conn, rw, err := w.(http.Hijacker).Hijack()
+		if err != nil {
+			t.Errorf("Hijack error = %v", err)
+			return
+		}
+		rw.WriteString("HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nhi")
+		rw.Flush()
+		conn.Close()
+	}))
+	srv := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		h.ServeHTTP(w, r)
+		close(served)
+	}))
+	srv.Config.ErrorLog = log.New(&logs, "", 0)
+	srv.Start()
+	defer srv.Close()
+
+	resp, err := http.Get(srv.URL)
+	if err != nil {
+		t.Fatalf("GET error = %v", err)
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(resp.Body)
+	if err != nil {
+		t.Fatalf("reading body error = %v", err)
+	}
+	if resp.StatusCode != http.StatusOK || string(body) != "hi" {
+		t.Errorf("client got %d %q, want 200 \"hi\"", resp.StatusCode, body)
+	}
+
+	<-served // the server goroutine has finished, so logs is safe to read
+	if strings.Contains(logs.String(), "hijacked") {
+		t.Errorf("server logged %q", logs.String())
+	}
+}
