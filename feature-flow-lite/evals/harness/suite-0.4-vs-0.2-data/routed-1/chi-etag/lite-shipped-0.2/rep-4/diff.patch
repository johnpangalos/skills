+func TestETagInformationalForwardedImmediately(t *testing.T) {
+	rec := &etagCodeRecorder{ResponseRecorder: httptest.NewRecorder()}
+	r := httptest.NewRequest(http.MethodGet, "/", nil)
+
+	ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Add("Link", "</style.css>; rel=preload")
+		w.WriteHeader(http.StatusEarlyHints)
+		if len(rec.codes) != 1 {
+			t.Errorf("103 not forwarded immediately, codes = %v", rec.codes)
+		}
+		w.WriteHeader(http.StatusOK)
+		w.Write([]byte("ok"))
+	})).ServeHTTP(rec, r)
+
+	if len(rec.codes) != 2 || rec.codes[0] != http.StatusEarlyHints || rec.codes[1] != http.StatusOK {
+		t.Errorf("codes = %v, want [103 200]", rec.codes)
+	}
+	if rec.Header().Get("ETag") == "" {
+		t.Errorf("final 200 after 103 has no ETag")
+	}
+}
