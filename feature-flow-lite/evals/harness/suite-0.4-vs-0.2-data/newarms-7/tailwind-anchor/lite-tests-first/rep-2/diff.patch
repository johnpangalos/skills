+test('anchor', async () => {
+  expect(await run(['anchor-tooltip'])).toMatchInlineSnapshot(`
+    "
+    .anchor-tooltip {
+      anchor-name: --tooltip;
+    }
+    "
+  `)
+  expect(await run(['anchor-foo-bar'])).toMatchInlineSnapshot(`
+    "
+    .anchor-foo-bar {
+      anchor-name: --foo-bar;
+    }
+    "
+  `)
+  expect(await run(['anchor-none'])).toMatchInlineSnapshot(`
+    "
+    .anchor-none {
+      anchor-name: none;
+    }
+    "
+  `)
+  expect(await run(['anchor-[--a]'])).toMatchInlineSnapshot(`
+    "
+    .anchor-\\[--a\\] {
+      anchor-name: --a;
+    }
+    "
+  `)
+  expect(await run(['anchor-[--a,--b]'])).toMatchInlineSnapshot(`
+    "
+    .anchor-\\[--a\\,--b\\] {
+      anchor-name: --a,--b;
+    }
+    "
+  `)
+  expect(
+    await run([
+      'anchor',
+      '-anchor-tooltip',
+      '-anchor-none',
+      '-anchor-[--a]',
+      'anchor-tooltip/50',
+      'anchor-none/50',
+      'anchor-[--a]/50',
+      'anchor-foo.bar',
+      'anchor-1.5',
+    ]),
+  ).toEqual('')
+})
+
+test('anchored', async () => {
+  expect(await run(['anchored-menu'])).toMatchInlineSnapshot(`
+    "
+    .anchored-menu {
+      position-anchor: --menu;
+    }
+    "
+  `)
+  expect(await run(['anchored-auto'])).toMatchInlineSnapshot(`
+    "
+    .anchored-auto {
+      position-anchor: auto;
+    }
+    "
+  `)
+  expect(await run(['anchored-[--menu]'])).toMatchInlineSnapshot(`
+    "
+    .anchored-\\[--menu\\] {
+      position-anchor: --menu;
+    }
+    "
+  `)
+  expect(
+    await run([
+      'anchored',
+      '-anchored-menu',
+      '-anchored-auto',
+      'anchored-menu/50',
+      'anchored-auto/[x]',
+      'anchored-[--menu]/50',
+      'anchored-foo.bar',
+      'anchored-1.5',
+    ]),
+  ).toEqual('')
+})
