+      anchor-name: --1;
+    }
+
+    .anchor-\\[--a\\,--b\\] {
+      anchor-name: --a,--b;
+    }
+
+    .anchor-\\[none\\] {
+      anchor-name: none;
+    }
+
+    .anchor-auto {
+      anchor-name: --auto;
+    }
+
+    .anchor-none {
+      anchor-name: none;
+    }
+
+    .anchor-tooltip {
+      anchor-name: --tooltip;
