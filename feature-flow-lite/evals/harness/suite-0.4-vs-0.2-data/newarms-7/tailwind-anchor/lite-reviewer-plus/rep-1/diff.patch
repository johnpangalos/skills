+test('anchor', async () => {
+  expect(
+    await run([
+      'anchor-tooltip',
+      'anchor-Foo',
+      'anchor-my_name',
+      'anchor-auto',
+      'anchor-none',
+      'anchor-[--a,--b]',
+      'anchor-[--a,_--b]',
+      'anchor-(--x)',
+      '!anchor-x',
+    ]),
+  ).toMatchInlineSnapshot(`
+    "
+    .\\!anchor-x {
+      anchor-name: --x !important;
+    }
+
+    .anchor-\\(--x\\) {
+      anchor-name: var(--x);
+    }
+
+    .anchor-Foo {
+      anchor-name: --Foo;
+    }
+
+    .anchor-\\[--a\\,--b\\] {
+      anchor-name: --a,--b;
+    }
+
+    .anchor-\\[--a\\,_--b\\] {
+      anchor-name: --a, --b;
+    }
+
+    .anchor-auto {
+      anchor-name: --auto;
+    }
+
+    .anchor-my_name {
+      anchor-name: --my_name;
+    }
+
+    .anchor-none {
+      anchor-name: none;
+    }
+
+    .anchor-tooltip {
+      anchor-name: --tooltip;
+    }
+    "
+  `)
+  expect(
+    await run([
+      'anchor',
+      '-anchor-x',
+      '-anchor-none',
+      '-anchor-[--a]',
+      'anchor-x/foo',
+      'anchor-none/foo',
+      'anchor-[--a]/foo',
+      'anchor-1.5',
+      'anchor-50%',
+    ]),
+  ).toEqual('')
+})
+
+test('anchored', async () => {
+  expect(
+    await run([
+      'anchored-tooltip',
+      'anchored-none',
+      'anchored-auto',
+      'anchored-[--menu]',
+      'hover:anchored-x',
+    ]),
+  ).toMatchInlineSnapshot(`
+    "
+    .anchored-\\[--menu\\] {
+      position-anchor: --menu;
+    }
+
+    .anchored-auto {
+      position-anchor: auto;
+    }
+
+    .anchored-none {
+      position-anchor: --none;
+    }
+
+    .anchored-tooltip {
+      position-anchor: --tooltip;
+    }
+
+    @media (hover: hover) {
+      .hover\\:anchored-x:hover {
+        position-anchor: --x;
+      }
+    }
+    "
+  `)
+  expect(
+    await run([
+      'anchored',
+      '-anchored-x',
+      '-anchored-auto',
+      '-anchored-[--a]',
+      'anchored-x/foo',
+      'anchored-auto/foo',
+      'anchored-[--a]/[x]',
+      'anchored-1.5',
+      'anchored-50%',
+    ]),
+  ).toEqual('')
+})
