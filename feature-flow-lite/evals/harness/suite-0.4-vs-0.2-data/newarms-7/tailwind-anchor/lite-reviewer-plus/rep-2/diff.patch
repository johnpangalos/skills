+    .anchor-\\[--a\\,--b\\] {
+      anchor-name: --a,--b;
+    }
+
+    .anchor-my-tip {
+      anchor-name: --my-tip;
+    }
+
+    .anchor-none {
+      anchor-name: none;
+    }
+
+    .anchor-tooltip {
+      anchor-name: --tooltip;
+    }
+    "
+  `)
+  expect(
+    await run([
