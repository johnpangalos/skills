@@ -0,0 +1,61 @@
+import unittest
+from decimal import Decimal
+
+from shop import discounts
+from shop.discounts import InvalidCode
+
+
+class CanonicalTest(unittest.TestCase):
+    def test_known_codes(self):
+        self.assertEqual(discounts.canonical("SAVE10"), "SAVE10")
+        self.assertEqual(discounts.canonical("FIVEOFF"), "FIVEOFF")
+
+    def test_case_insensitive(self):
+        self.assertEqual(discounts.canonical("save10"), "SAVE10")
+        self.assertEqual(discounts.canonical("Save10"), "SAVE10")
+
+    def test_whitespace_stripped(self):
+        self.assertEqual(discounts.canonical(" fiveoff "), "FIVEOFF")
+
+    def test_hostile_inputs_raise_invalid_code(self):
+        for code in ["", "SAVE", "SAVE10X", "SAVE 10", None, 10]:
+            with self.subTest(code=code):
+                with self.assertRaises(InvalidCode):
+                    discounts.canonical(code)
+
+    def test_non_ascii_lookalikes_raise_invalid_code(self):
+        # str.upper() maps these onto SAVE10 / FIVEOFF; they must still be rejected.
+        for code in ["ſave10", "fıveoff", "ﬁveoff"]:
+            with self.subTest(code=code):
+                with self.assertRaises(InvalidCode):
+                    discounts.canonical(code)
+
+    def test_invalid_code_is_value_error(self):
+        self.assertTrue(issubclass(InvalidCode, ValueError))
+        with self.assertRaises(ValueError):
+            discounts.canonical("NOPE")
+
+
+class Save10Test(unittest.TestCase):
+    def test_ten_percent(self):
+        self.assertEqual(discounts.amount("SAVE10", Decimal("43.25")), Decimal("4.33"))
+
+    def test_half_up_rounding(self):
+        self.assertEqual(discounts.amount("SAVE10", Decimal("0.05")), Decimal("0.01"))
+
+    def test_rounds_down_below_half(self):
+        self.assertEqual(discounts.amount("SAVE10", Decimal("0.04")), Decimal("0.00"))
+
+    def test_empty_cart(self):
+        self.assertEqual(discounts.amount("SAVE10", Decimal("0.00")), Decimal("0.00"))
+
+
+class FiveOffTest(unittest.TestCase):
+    def test_flat_five(self):
+        self.assertEqual(discounts.amount("FIVEOFF", Decimal("6.25")), Decimal("5.00"))
+
+    def test_capped_at_subtotal(self):
+        self.assertEqual(discounts.amount("FIVEOFF", Decimal("4.00")), Decimal("4.00"))
+
+    def test_empty_cart(self):
+        self.assertEqual(discounts.amount("FIVEOFF", Decimal("0.00")), Decimal("0.00"))
