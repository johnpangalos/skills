@@ -0,0 +1,39 @@
+"""Discount codes. Each code maps to a rule on the merchandise subtotal."""
+
+from decimal import Decimal
+
+from shop.money import to_cents
+
+
+class InvalidCode(ValueError):
+    pass
+
+
+def _save10(subtotal):
+    return subtotal * Decimal("0.10")
+
+
+def _fiveoff(subtotal):
+    return min(Decimal("5.00"), subtotal)
+
+
+RULES = {
+    "SAVE10": _save10,
+    "FIVEOFF": _fiveoff,
+}
+
+
+def canonical(code):
+    """Return the canonical name of a user-entered code, or raise InvalidCode."""
+    if isinstance(code, str):
+        stripped = code.strip()
+        # Check ASCII before upper(): non-ASCII letters such as U+017F, U+0131
+        # and U+FB01 upper-case into ASCII codes and must not match.
+        if stripped.isascii() and stripped.upper() in RULES:
+            return stripped.upper()
+    raise InvalidCode(f"unknown discount code: {code!r}")
+
+
+def amount(name, subtotal):
+    """Discount in dollars for a canonical code on a merchandise subtotal."""
+    return to_cents(RULES[name](subtotal))
