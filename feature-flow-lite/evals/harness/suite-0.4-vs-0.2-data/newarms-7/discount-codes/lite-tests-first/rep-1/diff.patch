@@ -0,0 +1,36 @@
+"""Discount codes and the amount each one takes off a subtotal."""
+
+from decimal import Decimal
+
+from shop.money import to_cents
+
+
+class InvalidCode(ValueError):
+    pass
+
+
+def _save10(subtotal):
+    return to_cents(subtotal * Decimal("0.10"))
+
+
+def _fiveoff(subtotal):
+    return Decimal("5.00")
+
+
+CODES = {"SAVE10": _save10, "FIVEOFF": _fiveoff}
+
+
+def normalize_code(code):
+    """Return the canonical uppercase name for a code, or raise InvalidCode."""
+    name = code.strip() if isinstance(code, str) else None
+    if name is not None and name.isascii():
+        name = name.upper()
+    if name not in CODES:
+        raise InvalidCode(f"unknown discount code: {code!r}")
+    return name
+
+
+def discount_for(code, subtotal):
+    """Return the discount for a code on a subtotal, within 0 and the subtotal."""
+    amount = CODES[normalize_code(code)](subtotal)
+    return to_cents(max(min(amount, subtotal), Decimal("0")))
