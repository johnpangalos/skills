index 0000000..a9e72b3
--- /dev/null
+++ b/tests/test_discounts.py
@@ -0,0 +1,56 @@
+import unittest
+from decimal import Decimal
+
+from shop import discounts
+from shop.discounts import CODES, InvalidCode, discount_for, normalize_code
+
+
+class DiscountTest(unittest.TestCase):
+    def test_module_has_docstring(self):
+        self.assertTrue(discounts.__doc__)
+
+    def test_table_has_both_codes(self):
+        self.assertEqual(set(CODES), {"SAVE10", "FIVEOFF"})
+
+    def test_save10_is_ten_percent_rounded_half_up(self):
+        self.assertEqual(discount_for("SAVE10", Decimal("43.25")), Decimal("4.33"))
+
+    def test_fiveoff_is_flat_five_dollars(self):
+        self.assertEqual(discount_for("FIVEOFF", Decimal("50.00")), Decimal("5.00"))
+
+    def test_fiveoff_capped_at_subtotal(self):
+        self.assertEqual(discount_for("FIVEOFF", Decimal("4.00")), Decimal("4.00"))
+        self.assertEqual(discount_for("FIVEOFF", Decimal("0.00")), Decimal("0.00"))
+
+    def test_discount_never_exceeds_or_goes_below_zero(self):
+        self.assertEqual(discount_for("SAVE10", Decimal("0.00")), Decimal("0.00"))
+        self.assertEqual(discount_for("FIVEOFF", Decimal("-1.00")), Decimal("0.00"))
+
+    def test_normalize_ignores_case_and_surrounding_whitespace(self):
+        for raw in ("save10", "Save10", "SAVE10"):
+            with self.subTest(raw=raw):
+                self.assertEqual(normalize_code(raw), "SAVE10")
+        self.assertEqual(normalize_code(" fiveoff "), "FIVEOFF")
+
+    def test_normalize_rejects_unknown_codes(self):
+        for raw in ("", "SAVE", "SAVE100", "SAVE 10"):
+            with self.subTest(raw=raw):
+                with self.assertRaises(InvalidCode) as ctx:
+                    normalize_code(raw)
+                self.assertEqual(str(ctx.exception), f"unknown discount code: {raw!r}")
+
+    def test_normalize_rejects_non_strings(self):
+        for raw in (None, 10):
+            with self.subTest(raw=raw):
+                with self.assertRaises(InvalidCode):
+                    normalize_code(raw)
+
+    def test_normalize_rejects_non_ascii_look_alikes(self):
+        for raw in ("ſave10", "fıveoff", "ＳＡＶＥ１０"):
+            with self.subTest(raw=raw):
+                with self.assertRaises(InvalidCode) as ctx:
+                    normalize_code(raw)
+                self.assertEqual(str(ctx.exception), f"unknown discount code: {raw!r}")
+
+    def test_invalid_code_is_value_error(self):
+        self.assertTrue(issubclass(InvalidCode, ValueError))
