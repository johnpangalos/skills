+    def test_discount_row_sits_between_subtotal_and_shipping(self):
+        cart = Cart()
+        cart.add("BEAN-ETH", 2)
+        cart.add("FILTER")
+        cart.apply_code("SAVE10")
+        lines = render(cart).splitlines()
+        index = next(i for i, line in enumerate(lines) if line.startswith("Subtotal"))
+        self.assertEqual(lines[index + 1], "Discount (SAVE10)" + "-$4.33".rjust(23))
+        self.assertEqual(len(lines[index + 1]), 40)
+        self.assertTrue(lines[index + 2].startswith("Shipping"))
+
+    def test_discount_row_uses_canonical_code(self):
+        cart = Cart()
+        cart.add("BEAN-ETH", 2)
+        cart.apply_code("save10")
+        self.assertTrue(_discount_line(cart).startswith("Discount (SAVE10)"))
+
+    def test_no_discount_row_without_code(self):
+        cart = Cart()
+        cart.add("BEAN-ETH", 2)
+        self.assertNotIn("Discount", render(cart))
+
+    def test_rows_add_up_to_total(self):
+        cart = Cart()
+        cart.add("BEAN-ETH", 2)
+        cart.add("FILTER")
+        cart.apply_code("SAVE10")
+        subtotal, discount, shipping, tax, total = [
+            _amount(line) for line in render(cart).splitlines()[-5:]
+        ]
+        self.assertEqual(subtotal + discount + shipping + tax, total)
+        self.assertEqual(total, Decimal("50.08"))
+
+    def test_large_discount_keeps_thousands_separator(self):
+        cart = Cart()
+        cart.add("MUG", 500)
+        cart.apply_code("SAVE10")
+        self.assertEqual(
+            _discount_line(cart), "Discount (SAVE10)" + "-$1,100.00".rjust(23)
+        )
+
+    def test_zero_discount_on_empty_cart_is_not_negative_zero_dollars(self):
+        cart = Cart()
+        cart.apply_code("FIVEOFF")
+        self.assertEqual(_discount_line(cart), "Discount (FIVEOFF)" + "-$0.00".rjust(22))
+        self.assertNotIn("$-", render(cart))
+
+
+def _discount_line(cart):
+    return next(line for line in render(cart).splitlines() if line.startswith("Discount"))
+
+
+def _amount(line):
+    value = Decimal(line.split("$", 1)[1].replace(",", ""))
+    return -value if "-$" in line else value
