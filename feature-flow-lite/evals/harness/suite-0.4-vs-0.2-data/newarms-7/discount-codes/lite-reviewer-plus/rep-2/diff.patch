diff --git a/tests/test_discounts.py b/tests/test_discounts.py
new file mode 100644
index 0000000..154b782
--- /dev/null
+++ b/tests/test_discounts.py
@@ -0,0 +1,30 @@
+import unittest
+from decimal import Decimal
+
+from shop.discounts import InvalidCode, discount_for, normalize_code
+
+
+class DiscountsTest(unittest.TestCase):
+    def test_normalize_is_case_and_space_insensitive(self):
+        for raw in ["SAVE10", "save10", "Save10", "  save10\t"]:
+            with self.subTest(raw=raw):
+                self.assertEqual(normalize_code(raw), "SAVE10")
+
+    def test_hostile_codes_are_rejected(self):
+        for raw in ["", "   ", None, 123, "SAVE 10", "SAVE10X", "ſave10"]:
+            with self.subTest(raw=raw):
+                with self.assertRaises(InvalidCode) as ctx:
+                    normalize_code(raw)
+                self.assertEqual(str(ctx.exception), f"unknown discount code: {raw!r}")
+
+    def test_save10_rounds_half_up(self):
+        self.assertEqual(str(discount_for("SAVE10", Decimal("43.25"))), "4.33")
+        self.assertEqual(str(discount_for("SAVE10", Decimal("0.05"))), "0.01")
+
+    def test_save10_on_empty_cart(self):
+        self.assertEqual(str(discount_for("SAVE10", Decimal("0.00"))), "0.00")
+
+    def test_fiveoff_is_capped_at_subtotal(self):
+        self.assertEqual(str(discount_for("FIVEOFF", Decimal("3.00"))), "3.00")
+        self.assertEqual(str(discount_for("FIVEOFF", Decimal("0.00"))), "0.00")
+        self.assertEqual(str(discount_for("FIVEOFF", Decimal("80.00"))), "5.00")
