--- /dev/null
+++ b/shop/discounts.py
@@ -0,0 +1,29 @@
+"""Discount codes: percent-off and fixed-amount cart discounts."""
+
+from decimal import Decimal
+
+from shop.money import to_cents
+
+
+class InvalidCode(ValueError):
+    pass
+
+
+PERCENT_OFF = {"SAVE10": Decimal("0.10")}  # fraction of the subtotal
+AMOUNT_OFF = {"FIVEOFF": Decimal("5.00")}  # dollars, capped at the subtotal
+
+
+def normalize_code(code):
+    """Return the canonical uppercase form of a known code, or raise InvalidCode."""
+    if isinstance(code, str):
+        key = code.strip()
+        if key.isascii() and (key.upper() in PERCENT_OFF or key.upper() in AMOUNT_OFF):
+            return key.upper()
+    raise InvalidCode(f"unknown discount code: {code!r}")
+
+
+def discount_for(code, subtotal):
+    """Return the dollar discount a canonical code gives on subtotal, never more than it."""
+    if code in PERCENT_OFF:
+        return to_cents(subtotal * PERCENT_OFF[code])
+    return min(AMOUNT_OFF[code], subtotal)
