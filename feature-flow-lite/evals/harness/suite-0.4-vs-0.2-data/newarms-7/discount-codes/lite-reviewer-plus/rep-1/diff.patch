index 0000000..ff7d6b7
--- /dev/null
+++ b/shop/discounts.py
@@ -0,0 +1,34 @@
+"""Discount codes applied to the merchandise subtotal."""
+
+from decimal import Decimal
+
+from shop.money import to_cents
+
+
+class InvalidCode(ValueError):
+    pass
+
+
+# code -> (kind, amount): "percent" is a fraction of the subtotal, "amount" is dollars
+CODES = {
+    "SAVE10": ("percent", Decimal("0.10")),
+    "FIVEOFF": ("amount", Decimal("5.00")),
+}
+
+
+def normalize_code(code):
+    """Return the canonical uppercase form of a known code."""
+    if isinstance(code, str) and code.isascii() and code.upper() in CODES:
+        return code.upper()
+    raise InvalidCode("unknown discount code")
+
+
+def discount_for(code, subtotal):
+    """Return the discount in dollars for a code on a merchandise subtotal."""
+    kind, amount = CODES[normalize_code(code)]
+    subtotal = to_cents(subtotal)
+    if kind == "percent":
+        off = to_cents(subtotal * amount)
+    else:
+        off = amount
+    return max(Decimal("0.00"), min(off, subtotal))
