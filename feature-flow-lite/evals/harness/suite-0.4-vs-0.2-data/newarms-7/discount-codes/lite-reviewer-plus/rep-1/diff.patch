diff --git a/tests/test_discounts.py b/tests/test_discounts.py
new file mode 100644
index 0000000..15890ad
--- /dev/null
+++ b/tests/test_discounts.py
@@ -0,0 +1,62 @@
+import unittest
+from decimal import Decimal
+
+from shop.discounts import InvalidCode, discount_for, normalize_code
+
+
+class DiscountForTest(unittest.TestCase):
+    def test_save10_rounds_half_up(self):
+        self.assertEqual(discount_for("SAVE10", Decimal("43.33")), Decimal("4.33"))
+        self.assertEqual(discount_for("SAVE10", Decimal("43.35")), Decimal("4.34"))
+
+    def test_save10_on_empty_cart(self):
+        self.assertEqual(discount_for("SAVE10", Decimal("0.00")), Decimal("0.00"))
+
+    def test_fiveoff_is_flat(self):
+        self.assertEqual(discount_for("FIVEOFF", Decimal("100.00")), Decimal("5.00"))
+
+    def test_fiveoff_capped_at_subtotal(self):
+        self.assertEqual(discount_for("FIVEOFF", Decimal("3.00")), Decimal("3.00"))
+
+    def test_fiveoff_exactly_subtotal(self):
+        self.assertEqual(discount_for("FIVEOFF", Decimal("5.00")), Decimal("5.00"))
+
+    def test_fiveoff_on_empty_cart(self):
+        self.assertEqual(discount_for("FIVEOFF", Decimal("0.00")), Decimal("0.00"))
+
+    def test_code_is_case_insensitive(self):
+        self.assertEqual(discount_for("save10", Decimal("43.33")), Decimal("4.33"))
+
+    def test_unknown_code(self):
+        with self.assertRaises(InvalidCode) as cm:
+            discount_for("BOGUS", Decimal("10.00"))
+        self.assertEqual(str(cm.exception), "unknown discount code")
+
+
+class NormalizeCodeTest(unittest.TestCase):
+    def test_canonical_uppercase(self):
+        self.assertEqual(normalize_code("save10"), "SAVE10")
+        self.assertEqual(normalize_code("Save10"), "SAVE10")
+        self.assertEqual(normalize_code("FiveOff"), "FIVEOFF")
+
+    def test_invalid_codes(self):
+        for code in ["", " SAVE10 ", " save10", "SAVE 10", "SAVE10X", "ſave10"]:
+            with self.subTest(code=code):
+                self.assertInvalid(code)
+
+    def test_non_string_codes(self):
+        for code in [None, 10, b"SAVE10"]:
+            with self.subTest(code=code):
+                self.assertInvalid(code)
+
+    def assertInvalid(self, code):
+        with self.assertRaises(InvalidCode) as cm:
+            normalize_code(code)
+        self.assertEqual(str(cm.exception), "unknown discount code")
+
+
+class InvalidCodeTest(unittest.TestCase):
+    def test_is_value_error(self):
+        self.assertTrue(issubclass(InvalidCode, ValueError))
+        with self.assertRaises(ValueError):
+            normalize_code("BOGUS")
