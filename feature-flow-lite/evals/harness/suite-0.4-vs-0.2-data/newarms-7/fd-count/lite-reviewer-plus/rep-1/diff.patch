+/// Print the number of matching entries (--count)
+#[test]
+fn test_count() {
+    let dirs = &["test1", "test2"];
+    let files = &["test1/a.foo", "test1/a_foo", "test2/b.foo", "test2/c.bar"];
+    let te = TestEnv::new(dirs, files);
+
+    // Exactly one line with the number
+    let output = te.assert_success_and_get_output(".", &["--count", "foo"]);
+    assert_eq!(output.stdout, b"3\n");
+
+    te.assert_output(&["--count", "-e", "foo"], "2");
+    te.assert_output(&["--count", "-t", "f", "foo"], "3");
+    te.assert_output(&["--count", "-t", "d"], "2");
+    te.assert_output(&["--count", "-g", "*.foo"], "2");
+    te.assert_output(&["--count", "--exclude", "a.foo", "foo"], "2");
+    te.assert_output(&["--count", "--max-depth", "1", "-t", "d"], "2");
+    te.assert_output(&["--count", "foo", "--and", "a_"], "1");
+
+    // Colors and hyperlinks do not leak into the number
+    let output = te.assert_success_and_get_output(".", &["--count", "--color=always", "foo"]);
+    assert_eq!(output.stdout, b"3\n");
+    let output = te.assert_success_and_get_output(".", &["--count", "--hyperlink=always", "foo"]);
+    assert_eq!(output.stdout, b"3\n");
+}
+
+/// Hidden and ignored entries are counted according to the same rules as listing
+#[test]
+fn test_count_hidden_and_ignored() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+
+    te.assert_output(&["--count", "foo"], "6");
+    te.assert_output(&["--count", "-H", "foo"], "7");
+    te.assert_output(&["--count", "-I", "foo"], "8");
+    te.assert_output(&["--count", "-H", "-I", "foo"], "9");
+}
+
+/// Multiple search paths produce one total
+#[test]
+fn test_count_multiple_paths() {
+    let dirs = &["test1", "test2"];
+    let files = &["test1/a.foo", "test1/a_foo", "test2/b.foo", "test2/c.bar"];
+    let te = TestEnv::new(dirs, files);
+
+    te.assert_output(&["--count", "foo", "test1", "test2"], "3");
+    te.assert_output(&["--count", "foo", "test1"], "2");
+}
+
+/// No matches prints zero and succeeds
+#[test]
+fn test_count_zero_matches() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+
+    let output = te.assert_success_and_get_output(".", &["--count", "no-such-entry"]);
+    assert_eq!(output.stdout, b"0\n");
+}
+
+/// --max-results and -1 cap the count
+#[test]
+fn test_count_max_results() {
+    let dirs = &["test1", "test2"];
+    let files = &["test1/a.foo", "test1/a_foo", "test2/b.foo", "test2/c.bar"];
+    let te = TestEnv::new(dirs, files);
+
+    te.assert_output(&["--count", "--max-results=2", "foo"], "2");
+    te.assert_output(&["--count", "--max-results=5", "foo"], "3");
+    te.assert_output(&["--count", "--max-results=0", "foo"], "3");
+    te.assert_output(&["--count", "-1", "foo"], "1");
+}
+
+/// --count cannot be combined with output-changing options, in either order
+#[test]
+fn test_count_conflicts() {
+    let te = TestEnv::new(&[], &["a.foo"]);
+
+    let count_first: &[(&[&str], &str)] = &[
+        (
+            &["-x", "echo"],
+            "error: the argument '--count' cannot be used with:",
+        ),
+        (
+            &["-X", "echo"],
+            "error: the argument '--count' cannot be used with:",
+        ),
+        (
+            &["-l"],
+            "error: the argument '--count' cannot be used with:",
+        ),
+        (
+            &["--format", "{}"],
+            "error: the argument '--count' cannot be used with '--format <fmt>'",
+        ),
+        (
+            &["-0"],
+            "error: the argument '--count' cannot be used with '--print0'",
+        ),
+        (
+            &["-q"],
+            "error: the argument '--count' cannot be used with '--quiet'",
+        ),
+        (
+            &["--has-results"],
+            "error: the argument '--count' cannot be used with '--quiet'",
+        ),
+    ];
+    for (conflict, message) in count_first {
+        let mut args = vec!["--count", "foo"];
+        args.extend_from_slice(conflict);
+        assert_eq!(te.assert_error(&args, message).code(), Some(2));
+    }
+
+    let count_last: &[(&[&str], &str)] = &[
+        (
+            &["--format", "{}"],
+            "error: the argument '--format <fmt>' cannot be used with '--count'",
+        ),
+        (
+            &["-0"],
+            "error: the argument '--print0' cannot be used with '--count'",
+        ),
+        (
+            &["-q"],
+            "error: the argument '--quiet' cannot be used with '--count'",
+        ),
+        (
+            &["--has-results"],
+            "error: the argument '--quiet' cannot be used with '--count'",
+        ),
+        (
+            &["-l"],
+            "error: the argument '--list-details' cannot be used with '--count'",
+        ),
+    ];
+    for (conflict, message) in count_last {
+        let mut args = vec!["foo"];
+        args.extend_from_slice(conflict);
+        args.push("--count");
+        assert_eq!(te.assert_error(&args, message).code(), Some(2));
+    }
+}
