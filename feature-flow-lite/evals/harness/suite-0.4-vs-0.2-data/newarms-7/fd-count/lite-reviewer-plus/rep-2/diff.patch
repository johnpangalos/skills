+/// Print the number of matching entries (--count)
+#[test]
+fn test_count() {
+    let dirs = &["dir", "empty"];
+    let files = &["a.foo", "b.foo", "dir/c.foo", "dir/d.bar", ".hidden.foo"];
+    let te = TestEnv::new(dirs, files);
+
+    let count = |args: &[&str]| {
+        String::from_utf8_lossy(&te.assert_success_and_get_output(".", args).stdout).into_owned()
+    };
+
+    assert_eq!(count(&["--count", "foo"]), "3\n");
+    assert_eq!(count(&["--count", "--hidden", "foo"]), "4\n");
+    assert_eq!(count(&["--count", "--no-hidden", "foo"]), "3\n");
+    // TestEnv also creates a `symlink` entry, which counts as a match for "."
+    assert_eq!(count(&["--count", "."]), "7\n");
+    assert_eq!(count(&["--count", "--type", "d", "."]), "2\n");
+    assert_eq!(count(&["--count", "--extension", "bar"]), "1\n");
+    assert_eq!(count(&["--count", "--max-depth", "1", "."]), "5\n");
+    assert_eq!(count(&["--count", "--exclude", "dir", "."]), "4\n");
+    assert_eq!(count(&["--count", "--glob", "*.foo"]), "3\n");
+    assert_eq!(count(&["--count", "--absolute-path", "foo"]), "3\n");
+    assert_eq!(count(&["--count", "--strip-cwd-prefix", "foo"]), "3\n");
+    assert_eq!(
+        count(&["--count", "--color=always", "--hyperlink=always", "foo"]),
+        "3\n"
+    );
+    assert_eq!(count(&["--count", "zzz"]), "0\n");
+}
+
+/// Count across several search paths, including duplicated paths
+#[test]
+fn test_count_multiple_paths() {
+    let dirs = &["dir", "empty"];
+    let files = &["dir/c.foo", "dir/d.bar"];
+    let te = TestEnv::new(dirs, files);
+
+    let count = |args: &[&str]| {
+        String::from_utf8_lossy(&te.assert_success_and_get_output(".", args).stdout).into_owned()
+    };
+
+    assert_eq!(count(&["--count", ".", "dir", "empty"]), "2\n");
+
+    let plain = te.assert_success_and_get_normalized_output(".", &[".", "dir", "dir"]);
+    assert_eq!(
+        count(&["--count", ".", "dir", "dir"]),
+        format!("{}\n", plain.lines().count())
+    );
+}
+
+/// Count is capped by --max-results and -1
+#[test]
+fn test_count_max_results() {
+    let dirs = &[];
+    let files = &["a.foo", "b.foo", "c.foo"];
+    let te = TestEnv::new(dirs, files);
+
+    let count = |args: &[&str]| {
+        String::from_utf8_lossy(&te.assert_success_and_get_output(".", args).stdout).into_owned()
+    };
+
+    assert_eq!(count(&["--count", "--max-results=2", "foo"]), "2\n");
+    assert_eq!(count(&["--count", "--max-results=10", "foo"]), "3\n");
+    assert_eq!(count(&["--count", "--max-results=0", "foo"]), "3\n");
+    assert_eq!(count(&["--count", "-1", "foo"]), "1\n");
+    assert_eq!(count(&["--count", "-1", "zzz"]), "0\n");
+}
+
+/// --count is a usage error when combined with output or exec options (either order)
+#[test]
+fn test_count_conflicts() {
+    let dirs = &[];
+    let files = &["a.foo"];
+    let te = TestEnv::new(dirs, files);
+
+    // Each option, and how clap names it in the conflict message
+    let options: &[(&[&str], &str)] = &[
+        (&["--exec=cat"], "'--exec <cmd>...'"),
+        (&["--exec-batch=cat"], "'--exec-batch <cmd>...'"),
+        (&["--list-details"], "'--list-details'"),
+        (&["--format={}"], "'--format <fmt>'"),
+        (&["--print0"], "'--print0'"),
+        (&["--quiet"], "'--quiet'"),
+    ];
+    for (option, name) in options {
+        let mut count_first = vec!["--count"];
+        count_first.extend_from_slice(option);
+        let expected = format!("error: the argument '--count' cannot be used with {name}");
+        let status = te.assert_error(&count_first, &expected);
+        assert_eq!(status.code(), Some(2), "fd {}", count_first.join(" "));
+
+        let mut count_last = option.to_vec();
+        count_last.push("--count");
+        let expected = format!("error: the argument {name} cannot be used with '--count'");
+        let status = te.assert_error(&count_last, &expected);
+        assert_eq!(status.code(), Some(2), "fd {}", count_last.join(" "));
+    }
+}
