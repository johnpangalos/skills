diff --git a/tests/tests.rs b/tests/tests.rs
index c24545f..99c773b 100644
--- a/tests/tests.rs
+++ b/tests/tests.rs
@@ -2806,6 +2806,239 @@ fn test_max_results() {
     te.assert_failure(&["thing", "--max-results=1", "-1", "--exec=cat"]);
 }
 
+/// Number of lines that plain *fd* prints for the given arguments
+fn plain_line_count(te: &TestEnv, args: &[&str]) -> usize {
+    let output = te.assert_success_and_get_output(".", args);
+    String::from_utf8_lossy(&output.stdout).lines().count()
+}
+
+/// Assert that *fd --count* with the given arguments prints exactly the expected number
+fn assert_count(te: &TestEnv, args: &[&str], expected: usize) {
+    let mut count_args = vec!["--count"];
+    count_args.extend_from_slice(args);
+    let output = te.assert_success_and_get_output(".", &count_args);
+    assert_eq!(
+        output.stdout,
+        format!("{expected}\n").as_bytes(),
+        "args: {count_args:?}"
+    );
+}
+
+/// Assert that *fd* rejects the arguments with a usage error and prints nothing to stdout
+fn assert_usage_error(te: &TestEnv, args: &[&str]) {
+    let output = std::process::Command::new(te.test_exe())
+        .current_dir(te.test_root())
+        .args(args)
+        .output()
+        .expect("fd output");
+    assert_eq!(output.status.code(), Some(2), "args: {args:?}");
+    assert!(output.stdout.is_empty(), "args: {args:?}");
+    assert!(
+        String::from_utf8_lossy(&output.stderr).starts_with("error: the argument"),
+        "args: {args:?}"
+    );
+}
+
+/// --count prints the number of matching entries
+#[test]
+fn test_count() {
+    let dirs = &["dir"];
+    let files = &["a.foo", "b.foo", "dir/c.foo", "d.bar"];
+    let te = TestEnv::new(dirs, files);
+
+    assert_count(&te, &["foo"], 3);
+    // Also counts the broken `symlink` that the test environment creates
+    assert_count(&te, &[], 6);
+}
+
+/// --count is exact beyond the receiver's buffer limit
+#[test]
+fn test_count_beyond_buffer_limit() {
+    let te = TestEnv::new(&[], &[]);
+    for i in 0..1500 {
+        fs::File::create(te.test_root().join(format!("file{i}.txt"))).unwrap();
+    }
+
+    assert_count(&te, &["txt"], 1500);
+    assert_count(&te, &["--max-results=1", "txt"], 1);
+}
+
+/// Filenames containing newlines count as one entry each
+#[cfg(unix)]
+#[test]
+fn test_count_filenames_with_newlines() {
+    let te = TestEnv::new(&[], &["plain.txt"]);
+    fs::File::create(te.test_root().join("new\nline.txt")).unwrap();
+
+    assert_count(&te, &["txt"], 2);
+}
+
+/// --count applies the same filters as plain output
+#[test]
+fn test_count_applies_filters() {
+    let dirs = &["dir", ".hidden_dir"];
+    let files = &[
+        "a.foo",
+        "b.bar",
+        ".hidden.foo",
+        "dir/c.foo",
+        "dir/d.baz",
+        ".hidden_dir/e.foo",
+    ];
+    let te = TestEnv::new(dirs, files);
+
+    let filter_sets: &[&[&str]] = &[
+        &["foo"],
+        &["-t", "f"],
+        &["-t", "d"],
+        &["-H", "foo"],
+        &["-I", "foo"],
+        &["--exclude", "*.foo"],
+        &["-d", "1"],
+        &["--min-depth", "2"],
+        &["--size=-1b"],
+        &["-e", "foo"],
+        &["--and", "c", "--and", "foo"],
+        &["-g", "*.foo"],
+        &["-F", "foo"],
+    ];
+    for args in filter_sets {
+        let expected = plain_line_count(&te, args);
+        assert_count(&te, args, expected);
+    }
+}
+
+/// --count -t d counts only directories
+#[test]
+fn test_count_type_directory() {
+    let te = TestEnv::new(&["dir1", "dir2"], &["a.foo", "dir1/b.foo"]);
+
+    assert_count(&te, &["-t", "d"], 2);
+}
+
+/// --count -H includes hidden entries
+#[test]
+fn test_count_hidden() {
+    let te = TestEnv::new(&[], &["a.foo", ".hidden.foo"]);
+
+    assert_count(&te, &["foo"], 1);
+    assert_count(&te, &["-H", "foo"], 2);
+}
+
+/// Several search paths give one total
+#[test]
+fn test_count_multiple_paths() {
+    let dirs = &["one", "two"];
+    let files = &["one/a.foo", "one/b.foo", "two/c.foo", "two/d.bar"];
+    let te = TestEnv::new(dirs, files);
+
+    assert_count(&te, &["foo", "one", "two"], 3);
+}
+
+/// A search path given twice is counted the way plain output prints it
+#[test]
+fn test_count_overlapping_paths() {
+    let te = TestEnv::new(&["one"], &["one/a.foo", "one/b.foo"]);
+    let expected = plain_line_count(&te, &["foo", "one", "one"]);
+
+    assert!(expected > 0);
+    assert_count(&te, &["foo", "one", "one"], expected);
+}
+
+/// --max-results and -1 cap the count, and 0 means no limit
+#[test]
+fn test_count_max_results() {
+    let te = TestEnv::new(&[], &["a.foo", "b.foo", "c.foo"]);
+
+    assert_count(&te, &["--max-results=1", "foo"], 1);
+    assert_count(&te, &["-1", "foo"], 1);
+    assert_count(&te, &["--max-results=5", "foo"], 3);
+    assert_count(&te, &["--max-results=0", "foo"], 3);
+    assert_count(&te, &["-1", "nomatch"], 0);
+}
+
+/// A search without matches prints 0 and succeeds
+#[test]
+fn test_count_no_matches() {
+    let te = TestEnv::new(&[], &["a.foo"]);
+
+    assert_count(&te, &["nomatch"], 0);
+}
+
+/// --count conflicts with the options that change what is printed, in either order
+#[test]
+fn test_count_conflicts() {
+    let te = TestEnv::new(&[], &["a.foo"]);
+    let options: &[&[&str]] = &[
+        &["--exec=cat"],
+        &["-xcat"],
+        &["--exec-batch=cat"],
+        &["-Xcat"],
+        &["--list-details"],
+        &["-l"],
+        &["--format={}"],
+        &["--print0"],
+        &["-0"],
+        &["--quiet"],
+        &["-q"],
+        &["--has-results"],
+    ];
+    for option in options {
+        let mut count_first = vec!["--count"];
+        count_first.extend_from_slice(option);
+        let mut count_last = option.to_vec();
+        count_last.push("--count");
+        for args in [count_first, count_last] {
+            assert_usage_error(&te, &args);
+        }
+    }
+}
+
+/// A failed write of the count is reported and exits with a general error
+#[cfg(target_os = "linux")]
+#[test]
+fn test_count_write_error() {
+    let te = TestEnv::new(&[], &["a.foo"]);
+    let full = fs::OpenOptions::new()
+        .write(true)
+        .open("/dev/full")
+        .unwrap();
+    let output = std::process::Command::new(te.test_exe())
+        .current_dir(te.test_root())
+        .args(["--no-global-ignore-file", "--count", "foo"])
+        .stdout(full)
+        .stderr(std::process::Stdio::piped())
+        .spawn()
+        .unwrap()
+        .wait_with_output()
+        .unwrap();
+    assert_eq!(output.status.code(), Some(1));
+    assert!(
+        String::from_utf8_lossy(&output.stderr)
+            .starts_with("[fd error]: Could not write to output: "),
+        "stderr: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+}
+
+/// A closed pipe ends the count silently with a general error, like plain output
+#[cfg(unix)]
+#[test]
+fn test_count_broken_pipe() {
+    let te = TestEnv::new(&[], &["a.foo"]);
+    let mut child = std::process::Command::new(te.test_exe())
+        .current_dir(te.test_root())
+        .args(["--no-global-ignore-file", "--count", "foo"])
+        .stdout(std::process::Stdio::piped())
+        .stderr(std::process::Stdio::piped())
+        .spawn()
+        .unwrap();
+    drop(child.stdout.take());
+    let output = child.wait_with_output().unwrap();
+    assert_eq!(output.status.code(), Some(1));
+    assert!(output.stderr.is_empty());
+}
+
