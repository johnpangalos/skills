+/// Assert that --count prints exactly the expected number and nothing else
+fn assert_count(te: &TestEnv, args: &[&str], expected: usize) {
+    let mut count_args = vec!["--count"];
+    count_args.extend_from_slice(args);
+    let output = te.assert_success_and_get_output(".", &count_args);
+
+    assert_eq!(output.stdout, format!("{expected}\n").as_bytes());
+}
+
+/// Assert that --count prints the number of entries that the NUL-terminated listing prints
+fn assert_count_matches_listing(te: &TestEnv, args: &[&str]) {
+    let mut listing_args = args.to_vec();
+    listing_args.push("-0");
+    let listed = te.assert_success_and_get_output(".", &listing_args);
+    let expected = listed.stdout.iter().filter(|&&byte| byte == b'\0').count();
+
+    assert_count(te, args, expected);
+}
+
+/// Number of matching entries (--count)
+#[test]
+fn test_count_prints_number_of_matches() {
+    let te = TestEnv::new(&[], &["a.foo", "b.foo", "c.bar"]);
+
+    assert_count(&te, &["foo"], 2);
+    assert_count(&te, &["bar"], 1);
+}
+
+/// Number of matching entries (--count) stays plain with colour or hyperlinks requested
+#[test]
+fn test_count_has_no_colour_or_hyperlink_codes() {
+    let te = TestEnv::new(&[], &["a.foo", "b.foo", "c.bar"]);
+
+    assert_count(&te, &["--color=always", "foo"], 2);
+    assert_count(&te, &["--hyperlink=always", "foo"], 2);
+}
+
+/// Number of matching entries (--count) is exact above the buffering limit
+#[test]
+fn test_count_exceeds_buffer_limit() {
+    let te = TestEnv::new(&[], &[]);
+    for i in 0..2500 {
+        fs::write(te.test_root().join(format!("file_{i}.foo")), "").unwrap();
+    }
+
+    assert_count(&te, &["foo"], 2500);
+}
+
+/// Entries with newlines or tabs in their names are each counted once (--count)
+#[cfg(unix)]
+#[test]
+fn test_count_special_filenames() {
+    let te = TestEnv::new(&[], &["a.foo"]);
+    fs::write(te.test_root().join("line\nbreak.foo"), "").unwrap();
+    fs::write(te.test_root().join("tab\there.foo"), "").unwrap();
+
+    assert_count(&te, &["foo"], 3);
+}
+
+/// Filters apply to the count exactly as they apply to the listing (--count)
+#[test]
+fn test_count_matches_listed_entries() {
+    let te = TestEnv::new(
+        &["one/two"],
+        &[
+            "a.foo",
+            "one/b.foo",
+            "one/two/c.foo",
+            "one/two/C.Foo2",
+            ".hidden.foo",
+            "ignored.foo",
+            "one/two/.hidden.bar",
+        ],
+    );
+    fs::write(te.test_root().join(".ignore"), "ignored.foo\n").unwrap();
+
+    let filter_sets: &[&[&str]] = &[
+        &["foo"],
+        &["-H", "foo"],
+        &["-I", "foo"],
+        &["-H", "-I", "foo"],
+        &["-t", "f", "foo"],
+        &["-t", "d"],
+        &["-t", "empty"],
+        &["-e", "foo"],
+        &["-g", "*.foo"],
+        &["-F", "a.foo"],
+        &["-d", "1", "foo"],
+        &["--min-depth", "2", "foo"],
+        &["-E", "one", "foo"],
+        &["--size=-1k", "foo"],
+        &["--changed-within=1d", "foo"],
+        &["--follow", "foo"],
+        &["--full-path", "two/c"],
+        &["--and", "foo", "--and", "c"],
+    ];
+    for args in filter_sets {
+        assert_count_matches_listing(&te, args);
+    }
+}
+
+/// Number of matches over several search paths (--count)
+#[test]
+fn test_count_multiple_paths() {
+    let te = TestEnv::new(&["one", "two"], &["one/a.foo", "two/b.foo", "two/c.bar"]);
+
+    assert_count(&te, &["foo", "one", "two"], 2);
+    // Nothing in one path, a match in the other
+    assert_count(&te, &["bar", "one", "two"], 1);
+    // Overlapping paths are counted the way they are listed
+    assert_count_matches_listing(&te, &["foo", "one", "one"]);
+    // A nonexistent path is reported and the valid ones are counted
+    assert_count_matches_listing(&te, &["foo", "one", "missing"]);
+}
+
+/// --max-results and -1 cap the number of matches (--count)
+#[test]
+fn test_count_respects_max_results() {
+    let te = TestEnv::new(&[], &["a.foo", "b.foo", "c.foo"]);
+
+    assert_count(&te, &["--max-results=2", "foo"], 2);
+    assert_count(&te, &["--max-results=3", "foo"], 3);
+    assert_count(&te, &["--max-results=10", "foo"], 3);
+    assert_count(&te, &["--max-results=0", "foo"], 3);
+    assert_count(&te, &["-1", "foo"], 1);
+    let output = te.assert_success_and_get_output(".", &["-1", "--count", "foo"]);
+    assert_eq!(output.stdout, b"1\n");
+}
+
+/// No matches prints 0 and exits with success (--count)
+#[test]
+fn test_count_no_matches() {
+    let te = TestEnv::new(&[], &[]);
+    assert_count(&te, &["zzz"], 0);
+    assert_count(&te, &["-1", "zzz"], 0);
+
+    let te = TestEnv::new(&[], &["a.foo"]);
+    assert_count(&te, &["-e", "zzz"], 0);
+    assert_count(&te, &["-1", "zzz"], 0);
+}
+
+/// Output and exec options conflict with --count as usage errors, in either order
+#[test]
+fn test_count_conflicts_are_usage_errors() {
+    let te = TestEnv::new(&[], &["a.foo"]);
+    let conflicts: &[&[&str]] = &[
+        &["-q"],
+        &["--quiet"],
+        &["--has-results"],
+        &["-0"],
+        &["--print0"],
+        &["--format", "{}"],
+        &["-x", "echo", ";"],
+        &["--exec", "echo", ";"],
+        &["-X", "echo", ";"],
+        &["--exec-batch", "echo", ";"],
+        &["-l"],
+        &["--list-details"],
+    ];
+    for conflict in conflicts {
+        let mut before = vec!["--count"];
+        before.extend_from_slice(conflict);
+        let mut after = conflict.to_vec();
+        after.push("--count");
+
+        for args in [before, after] {
+            let output = std::process::Command::new(te.test_exe())
+                .current_dir(te.test_root())
+                .args(&args)
+                .output()
+                .unwrap();
+
+            assert_eq!(output.status.code(), Some(2), "args: {args:?}");
+            assert!(output.stdout.is_empty(), "args: {args:?}");
+            let stderr = String::from_utf8_lossy(&output.stderr);
+            assert!(stderr.contains("cannot be used with"), "args: {args:?}");
+        }
+    }
+}
+
+/// A failed write of the count is reported and exits with the general error code (--count)
+#[cfg(target_os = "linux")]
+#[test]
+fn test_count_write_error_is_reported() {
+    let te = TestEnv::new(&[], &["a.foo"]);
+    let full = fs::OpenOptions::new()
+        .write(true)
+        .open("/dev/full")
+        .unwrap();
+
+    let output = std::process::Command::new(te.test_exe())
+        .current_dir(te.test_root())
+        .args(["--count", "foo"])
+        .stdout(full)
+        .stderr(std::process::Stdio::piped())
+        .output()
+        .unwrap();
+
+    assert_eq!(output.status.code(), Some(1));
+    assert!(String::from_utf8_lossy(&output.stderr).contains("Could not write to output"));
+}
+
+/// A closed pipe does not panic or fail the count (--count)
+#[cfg(unix)]
+#[test]
+fn test_count_broken_pipe_is_silent() {
+    let te = TestEnv::new(&[], &["a.foo"]);
+    let mut child = std::process::Command::new(te.test_exe())
+        .current_dir(te.test_root())
+        .args(["--count", "foo"])
+        .stdout(std::process::Stdio::piped())
+        .stderr(std::process::Stdio::piped())
+        .spawn()
+        .unwrap();
+    drop(child.stdout.take());
+
+    let output = child.wait_with_output().unwrap();
+
+    assert_eq!(output.status.code(), Some(0));
+    assert!(output.stderr.is_empty());
+}
