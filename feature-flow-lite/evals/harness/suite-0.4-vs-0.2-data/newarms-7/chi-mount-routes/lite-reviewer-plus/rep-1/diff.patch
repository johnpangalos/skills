+func TestWalkRouteCollidingWithMountPattern(t *testing.T) {
+	handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {})
+	allMethods := func(route string) []string {
+		var out []string
+		for m := range methodMap {
+			out = append(out, m+" "+route)
+		}
+		return out
+	}
+
+	tests := []struct {
+		name     string
+		setup    func() Router
+		expected []string
+	}{
+		{
+			name: "Get on the pattern of a Route",
+			setup: func() Router {
+				r := NewRouter()
+				r.Route("/foo", func(r Router) {
+					r.Route("/bar", func(r Router) { r.Get("/{id}", handler) })
+					r.Get("/bar", handler)
+				})
+				return r
+			},
+			expected: []string{"GET /foo/bar", "GET /foo/bar/{id}"},
+		},
+		{
+			name: "Get before a Route on the same pattern is overwritten by the mount",
+			setup: func() Router {
+				r := NewRouter()
+				r.Route("/foo", func(r Router) {
+					r.Get("/bar", handler)
+					r.Route("/bar", func(r Router) { r.Get("/{id}", handler) })
+				})
+				return r
+			},
+			expected: []string{"GET /foo/bar/{id}"},
+		},
+		{
+			name: "Get on the trailing slash of a Route",
+			setup: func() Router {
+				r := NewRouter()
+				r.Route("/foo", func(r Router) {
+					r.Route("/bar", func(r Router) { r.Get("/{id}", handler) })
+					r.Get("/bar/", handler)
+				})
+				return r
+			},
+			expected: []string{"GET /foo/bar/", "GET /foo/bar/{id}"},
+		},
+		{
+			name: "Handle after a Route reports the handler for every method",
+			setup: func() Router {
+				r := NewRouter()
+				r.Route("/foo", func(r Router) {
+					r.Route("/bar", func(r Router) { r.Get("/{id}", handler) })
+					r.Handle("/bar", handler)
+				})
+				return r
+			},
+			expected: append(allMethods("/foo/bar"), "GET /foo/bar/{id}"),
+		},
+		{
+			name: "Get after a Mount of a plain http.Handler",
+			setup: func() Router {
+				r := NewRouter()
+				r.Route("/foo", func(r Router) {
+					r.Mount("/bar", handler)
+					r.Get("/bar", handler)
+				})
+				return r
+			},
+			expected: append(allMethods("/foo/bar/*"), "GET /foo/bar"),
+		},
+		{
+			name: "Get colliding with a Route at the root",
+			setup: func() Router {
+				r := NewRouter()
+				r.Route("/x", func(r Router) { r.Get("/y", handler) })
+				r.Get("/x", handler)
+				return r
+			},
+			expected: []string{"GET /x", "GET /x/y"},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			r := tt.setup()
+			var got []string
+			err := Walk(r, func(method, route string, _ http.Handler, _ ...func(http.Handler) http.Handler) error {
+				got = append(got, method+" "+route)
+				return nil
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			want := slices.Clone(tt.expected)
+			slices.Sort(got)
+			slices.Sort(want)
+			if !slices.Equal(got, want) {
+				t.Fatalf("expected %v, got %v", want, got)
+			}
+		})
+	}
+}
