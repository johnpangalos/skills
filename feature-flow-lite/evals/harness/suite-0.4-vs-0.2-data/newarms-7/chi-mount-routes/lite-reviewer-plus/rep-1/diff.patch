+func TestRoutesSkipsMountStubOnCollision(t *testing.T) {
+	handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {})
+	r := NewRouter()
+	r.Route("/foo", func(r Router) {
+		r.Route("/bar", func(r Router) { r.Get("/{id}", handler) })
+		r.Get("/bar", handler)
+	})
+
+	subRoutes := r.Routes()[0].SubRoutes.Routes()
+	if len(subRoutes) != 2 {
+		t.Fatalf("expected 2 routes on /foo, got %d", len(subRoutes))
+	}
+	for _, rt := range subRoutes {
+		switch rt.Pattern {
+		case "/bar":
+			if rt.SubRoutes != nil || len(rt.Handlers) != 1 || rt.Handlers[http.MethodGet] == nil {
+				t.Fatalf("expected only GET handler on /bar, got %v", rt.Handlers)
+			}
+		case "/bar/*":
+			if rt.SubRoutes == nil {
+				t.Fatalf("expected subroutes on /bar/*")
+			}
+		default:
+			t.Fatalf("unexpected route pattern %q", rt.Pattern)
+		}
+	}
+}
