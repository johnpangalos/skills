+func TestWalkRouteCollision(t *testing.T) {
+	h := func(w http.ResponseWriter, r *http.Request) {}
+
+	// onAll lists route on every method known to chi, including ones registered by other tests
+	onAll := func(route string) []string {
+		var out []string
+		for m := range methodMap {
+			out = append(out, m+" "+route)
+		}
+		return out
+	}
+
+	tests := []struct {
+		name  string
+		setup func(r *Mux)
+		want  []string
+	}{
+		{
+			name: "Get after Route",
+			setup: func(r *Mux) {
+				r.Route("/foo", func(r Router) {
+					r.Route("/bar", func(r Router) { r.Get("/{id}", h) })
+					r.Get("/bar", h)
+				})
+			},
+			want: []string{"GET /foo/bar", "GET /foo/bar/{id}"},
+		},
+		{
+			name: "Get with trailing slash after Route",
+			setup: func(r *Mux) {
+				r.Route("/bar", func(r Router) { r.Get("/x", h) })
+				r.Get("/bar/", h)
+			},
+			want: []string{"GET /bar/", "GET /bar/x"},
+		},
+		{
+			name: "Get after Mount of Mux",
+			setup: func(r *Mux) {
+				sub := NewRouter()
+				sub.Get("/x", h)
+				r.Mount("/bar", sub)
+				r.Get("/bar", h)
+			},
+			want: []string{"GET /bar", "GET /bar/x"},
+		},
+		{
+			name: "Get after Mount of plain handler",
+			setup: func(r *Mux) {
+				r.Mount("/bar", http.HandlerFunc(h))
+				r.Get("/bar", h)
+			},
+			want: append(onAll("/bar/*"), "GET /bar"),
+		},
+		{
+			name: "Mount of plain handler alone",
+			setup: func(r *Mux) {
+				r.Mount("/bar", http.HandlerFunc(h))
+			},
+			want: onAll("/bar/*"),
+		},
+		{
+			name: "Mount of Mux alone",
+			setup: func(r *Mux) {
+				sub := NewRouter()
+				sub.Get("/x", h)
+				r.Mount("/bar", sub)
+			},
+			want: []string{"GET /bar/x"},
+		},
+		{
+			name: "Handle all methods after Route",
+			setup: func(r *Mux) {
+				r.Route("/bar", func(r Router) { r.Get("/x", h) })
+				r.Handle("/bar", http.HandlerFunc(h))
+			},
+			want: append(onAll("/bar"), "GET /bar/x"),
+		},
+		{
+			name: "Get wildcard after Route",
+			setup: func(r *Mux) {
+				r.Route("/bar", func(r Router) { r.Get("/x", h) })
+				r.Get("/bar/*", h)
+			},
+			want: []string{"GET /bar/*", "GET /bar/x"},
+		},
+		{
+			name: "Handle wildcard after Route",
+			setup: func(r *Mux) {
+				r.Route("/bar", func(r Router) { r.Get("/x", h) })
+				r.Handle("/bar/*", http.HandlerFunc(h))
+			},
+			want: append(onAll("/bar/*"), "GET /bar/x"),
+		},
+		{
+			name: "collisions at both nesting levels",
+			setup: func(r *Mux) {
+				r.Route("/foo", func(r Router) {
+					r.Route("/bar", func(r Router) {
+						r.Route("/baz", func(r Router) { r.Get("/q", h) })
+						r.Get("/baz", h)
+					})
+					r.Get("/bar", h)
+				})
+			},
+			want: []string{"GET /foo/bar", "GET /foo/bar/baz", "GET /foo/bar/baz/q"},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			r := NewRouter()
+			tt.setup(r)
+
+			var got []string
+			err := Walk(r, func(method string, route string, _ http.Handler, _ ...func(http.Handler) http.Handler) error {
+				got = append(got, method+" "+route)
+				return nil
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+
+			slices.Sort(got)
+			slices.Sort(tt.want)
+			if !slices.Equal(got, tt.want) {
+				t.Fatalf("expected routes %v, got %v", tt.want, got)
+			}
+		})
+	}
+
+	t.Run("Routes of subrouter keep the Get on the colliding pattern", func(t *testing.T) {
+		r := NewRouter()
+		foo := r.Route("/foo", func(r Router) {
+			r.Route("/bar", func(r Router) { r.Get("/{id}", h) })
+			r.Get("/bar", h)
+		})
+
+		for _, rt := range foo.Routes() {
+			if rt.Pattern == "/bar" {
+				if rt.SubRoutes != nil || rt.Handlers[http.MethodGet] == nil {
+					t.Fatalf("expected GET /bar route without subroutes, got %+v", rt)
+				}
+				return
+			}
+		}
+		t.Fatalf("expected a route with pattern /bar, got %v", foo.Routes())
+	})
+
+	t.Run("middlewares on colliding Get", func(t *testing.T) {
+		mw := func(next http.Handler) http.Handler { return next }
+		r := NewRouter()
+		r.Route("/bar", func(r Router) { r.Get("/x", h) })
+		r.With(mw).Get("/bar", h)
+
+		mwCount := -1
+		err := Walk(r, func(method string, route string, _ http.Handler, mws ...func(http.Handler) http.Handler) error {
+			if method == http.MethodGet && route == "/bar" {
+				mwCount = len(mws)
+			}
+			return nil
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if mwCount != 1 {
+			t.Fatalf("expected 1 middleware on GET /bar, got %d", mwCount)
+		}
+	})
+}
