+func TestWalkRouteOnMountStub(t *testing.T) {
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {})
+	everyMethod := func(route string) []string {
+		var out []string
+		for m := range methodMap {
+			out = append(out, m+" "+route)
+		}
+		return out
+	}
+
+	tests := []struct {
+		name  string
+		setup func() Router
+		want  []string
+	}{
+		{
+			name: "Get on stub after Route reports the user route",
+			setup: func() Router {
+				r := NewRouter()
+				r.Route("/foo", func(r Router) {
+					r.Route("/bar", func(r Router) { r.Get("/{id}", h) })
+					r.Get("/bar", h)
+				})
+				return r
+			},
+			want: []string{"GET /foo/bar", "GET /foo/bar/{id}"},
+		},
+		{
+			name: "Get registered before Route is overwritten by the mount",
+			setup: func() Router {
+				r := NewRouter()
+				r.Route("/foo", func(r Router) {
+					r.Get("/bar", h)
+					r.Route("/bar", func(r Router) { r.Get("/{id}", h) })
+				})
+				return r
+			},
+			want: []string{"GET /foo/bar/{id}"},
+		},
+		{
+			name: "Mount with Get on stub",
+			setup: func() Router {
+				sub := NewRouter()
+				sub.Get("/{id}", h)
+				r := NewRouter()
+				r.Route("/foo", func(r Router) {
+					r.Mount("/bar", sub)
+					r.Get("/bar", h)
+				})
+				return r
+			},
+			want: []string{"GET /foo/bar", "GET /foo/bar/{id}"},
+		},
+		{
+			name: "Mount with Get on trailing slash stub",
+			setup: func() Router {
+				sub := NewRouter()
+				sub.Get("/{id}", h)
+				r := NewRouter()
+				r.Route("/foo", func(r Router) {
+					r.Mount("/bar", sub)
+					r.Get("/bar/", h)
+				})
+				return r
+			},
+			want: []string{"GET /foo/bar/", "GET /foo/bar/{id}"},
+		},
+		{
+			name: "Get and Post on stub",
+			setup: func() Router {
+				r := NewRouter()
+				r.Route("/foo", func(r Router) {
+					r.Route("/bar", func(r Router) { r.Get("/{id}", h) })
+					r.Get("/bar", h)
+					r.Post("/bar", h)
+				})
+				return r
+			},
+			want: []string{"GET /foo/bar", "POST /foo/bar", "GET /foo/bar/{id}"},
+		},
+		{
+			name: "Handle on stub after Route reports every method",
+			setup: func() Router {
+				r := NewRouter()
+				r.Route("/foo", func(r Router) {
+					r.Route("/bar", func(r Router) { r.Get("/{id}", h) })
+					r.Handle("/bar", h)
+				})
+				return r
+			},
+			want: append(everyMethod("/foo/bar"), "GET /foo/bar/{id}"),
+		},
+		{
+			name: "Route alone reports no stub entries",
+			setup: func() Router {
+				r := NewRouter()
+				r.Route("/foo", func(r Router) {
+					r.Route("/bar", func(r Router) { r.Get("/{id}", h) })
+				})
+				return r
+			},
+			want: []string{"GET /foo/bar/{id}"},
+		},
+		{
+			name: "Mount of plain handler reports wildcard with every method",
+			setup: func() Router {
+				r := NewRouter()
+				r.Mount("/bar", h)
+				return r
+			},
+			want: everyMethod("/bar/*"),
+		},
+		{
+			name: "Get on stub of plain handler mount",
+			setup: func() Router {
+				r := NewRouter()
+				r.Mount("/bar", h)
+				r.Get("/bar", h)
+				return r
+			},
+			want: append(everyMethod("/bar/*"), "GET /bar"),
+		},
+		{
+			name: "Root mount with Get on parent root is unchanged",
+			setup: func() Router {
+				sub := NewRouter()
+				sub.Get("/x", h)
+				r := NewRouter()
+				r.Mount("/", sub)
+				r.Get("/", h)
+				return r
+			},
+			want: []string{"GET /", "GET /x"},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var got []string
+			err := Walk(tt.setup(), func(method, route string, handler http.Handler, middlewares ...func(http.Handler) http.Handler) error {
+				got = append(got, method+" "+route)
+				return nil
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			slices.Sort(got)
+			slices.Sort(tt.want)
+			if !slices.Equal(got, tt.want) {
+				t.Fatalf("expected routes %v, got %v", tt.want, got)
+			}
+		})
+	}
+}
