+func TestWalkRouteOnMountStubMiddlewares(t *testing.T) {
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {})
+	mw := func(next http.Handler) http.Handler { return next }
+
+	r := NewRouter()
+	r.Route("/foo", func(r Router) {
+		r.Route("/bar", func(r Router) { r.Get("/{id}", h) })
+		r.With(mw).Get("/bar", h)
+	})
+
+	var found bool
+	var middlewareCount int
+	err := Walk(r, func(method, route string, handler http.Handler, middlewares ...func(http.Handler) http.Handler) error {
+		if method == http.MethodGet && route == "/foo/bar" {
+			found = true
+			middlewareCount = len(middlewares)
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !found {
+		t.Fatal("expected GET /foo/bar to be reported")
+	}
+	if middlewareCount != 1 {
+		t.Fatalf("expected 1 middleware, got %d", middlewareCount)
+	}
+}
+
+func TestRoutesOnMountStubCollision(t *testing.T) {
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {})
+	r := NewRouter()
+	r.Route("/foo", func(r Router) {
+		r.Route("/bar", func(r Router) { r.Get("/{id}", h) })
+		r.Get("/bar", h)
+	})
+
+	top := r.Routes()
+	if len(top) != 1 || top[0].SubRoutes == nil {
+		t.Fatalf("expected a single subrouter route, got %+v", top)
+	}
+
+	var found bool
+	for _, rt := range top[0].SubRoutes.Routes() {
+		if rt.Pattern != "/bar" {
+			continue
+		}
+		found = true
+		if rt.SubRoutes != nil {
+			t.Fatalf("expected nil SubRoutes for /bar, got %+v", rt.SubRoutes)
+		}
+		if len(rt.Handlers) != 1 || rt.Handlers["GET"] == nil {
+			t.Fatalf("expected Handlers to hold only GET, got %d entries", len(rt.Handlers))
+		}
+	}
+	if !found {
+		t.Fatal("expected a /bar route in the /foo subrouter Routes()")
+	}
+}
