+func TestWalkStubCollision(t *testing.T) {
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {})
+	mw := func(next http.Handler) http.Handler { return next }
+	plain := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {})
+
+	var handleWant, plainWant []string
+	for m := range methodMap {
+		handleWant = append(handleWant, m+" /bar mw=0")
+		plainWant = append(plainWant, m+" /bar/* mw=0")
+	}
+
+	tests := []struct {
+		name  string
+		setup func() Router
+		want  []string
+	}{
+		{
+			name: "nested collision",
+			setup: func() Router {
+				r := NewRouter()
+				r.Route("/foo", func(r Router) {
+					r.Route("/bar", func(r Router) { r.Get("/{id}", h) })
+					r.Get("/bar", h)
+				})
+				return r
+			},
+			want: []string{"GET /foo/bar mw=0", "GET /foo/bar/{id} mw=0"},
+		},
+		{
+			name: "top-level collision",
+			setup: func() Router {
+				r := NewRouter()
+				r.Route("/bar", func(r Router) { r.Get("/{id}", h) })
+				r.Get("/bar", h)
+				return r
+			},
+			want: []string{"GET /bar mw=0", "GET /bar/{id} mw=0"},
+		},
+		{
+			name: "Mount of subrouter then Get",
+			setup: func() Router {
+				sub := NewRouter()
+				sub.Get("/{id}", h)
+				r := NewRouter()
+				r.Mount("/bar", sub)
+				r.Get("/bar", h)
+				return r
+			},
+			want: []string{"GET /bar mw=0", "GET /bar/{id} mw=0"},
+		},
+		{
+			name: "Get and Post over Route",
+			setup: func() Router {
+				r := NewRouter()
+				r.Route("/bar", func(r Router) {})
+				r.Get("/bar", h)
+				r.Post("/bar", h)
+				return r
+			},
+			want: []string{"GET /bar mw=0", "POST /bar mw=0"},
+		},
+		{
+			name: "Handle over Route",
+			setup: func() Router {
+				r := NewRouter()
+				r.Route("/bar", func(r Router) {})
+				r.Handle("/bar", h)
+				return r
+			},
+			want: handleWant,
+		},
+		{
+			name: "Get with trailing slash after Route",
+			setup: func() Router {
+				r := NewRouter()
+				r.Route("/bar", func(r Router) { r.Get("/{id}", h) })
+				r.Get("/bar/", h)
+				return r
+			},
+			want: []string{"GET /bar/ mw=0", "GET /bar/{id} mw=0"},
+		},
+		{
+			name: "With middleware on colliding Get",
+			setup: func() Router {
+				r := NewRouter()
+				r.Route("/bar", func(r Router) { r.Get("/{id}", h) })
+				r.With(mw).Get("/bar", h)
+				return r
+			},
+			want: []string{"GET /bar mw=1", "GET /bar/{id} mw=0"},
+		},
+		{
+			name: "Route alone unchanged",
+			setup: func() Router {
+				r := NewRouter()
+				r.Route("/bar", func(r Router) { r.Get("/{id}", h) })
+				return r
+			},
+			want: []string{"GET /bar/{id} mw=0"},
+		},
+		{
+			name: "plain handler Mount alone",
+			setup: func() Router {
+				r := NewRouter()
+				r.Mount("/bar", plain)
+				return r
+			},
+			want: plainWant,
+		},
+		{
+			name: "plain handler Mount then Get",
+			setup: func() Router {
+				r := NewRouter()
+				r.Mount("/bar", plain)
+				r.Get("/bar", h)
+				return r
+			},
+			want: append(slices.Clone(plainWant), "GET /bar mw=0"),
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var got []string
+			err := Walk(tt.setup(), func(method, route string, handler http.Handler, middlewares ...func(http.Handler) http.Handler) error {
+				got = append(got, fmt.Sprintf("%s %s mw=%d", method, route, len(middlewares)))
+				return nil
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			slices.Sort(got)
+			slices.Sort(tt.want)
+			if !slices.Equal(got, tt.want) {
+				t.Fatalf("expected %v, got %v", tt.want, got)
+			}
+		})
+	}
+}
+
+func TestStubCollisionReportedRoute(t *testing.T) {
+	r := NewRouter()
+	var foo Router
+	r.Route("/foo", func(fr Router) {
+		foo = fr
+		fr.Route("/bar", func(br Router) { br.Get("/{id}", func(w http.ResponseWriter, r *http.Request) {}) })
+		fr.Get("/bar", func(w http.ResponseWriter, r *http.Request) { w.Write([]byte("user")) })
+	})
+
+	var found []Route
+	for _, rt := range foo.Routes() {
+		if rt.Pattern == "/bar" {
+			found = append(found, rt)
+		}
+	}
+	if len(found) != 1 {
+		t.Fatalf("expected one Route with pattern /bar, got %d", len(found))
+	}
+	if found[0].SubRoutes != nil {
+		t.Fatalf("expected nil SubRoutes, got %v", found[0].SubRoutes)
+	}
+	if len(found[0].Handlers) != 1 || found[0].Handlers["GET"] == nil {
+		t.Fatalf("expected handlers exactly {GET}, got %v", found[0].Handlers)
+	}
+
+	var got http.Handler
+	err := Walk(r, func(method, route string, handler http.Handler, middlewares ...func(http.Handler) http.Handler) error {
+		if method == "GET" && route == "/foo/bar" {
+			got = handler
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got == nil {
+		t.Fatal("GET /foo/bar was not reported")
+	}
+	rec := httptest.NewRecorder()
+	got.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/foo/bar", nil))
+	if rec.Body.String() != "user" {
+		t.Fatalf("expected user handler, got body %q", rec.Body.String())
+	}
+}
