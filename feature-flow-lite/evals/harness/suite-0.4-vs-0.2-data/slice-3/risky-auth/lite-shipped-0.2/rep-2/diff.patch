+
+    def test_unknown_token_is_plain_invalid_token(self):
+        with self.assertRaises(InvalidToken) as ctx:
+            redeem_reset_token("not-a-token", now=0)
+        self.assertIs(type(ctx.exception), InvalidToken)
+        self.assertEqual(str(ctx.exception), "unknown token")
+
+    def test_empty_and_none_tokens_are_invalid(self):
+        for bad in ("", None):
+            with self.subTest(token=bad):
+                with self.assertRaises(InvalidToken) as ctx:
+                    redeem_reset_token(bad, now=0)
+                self.assertIs(type(ctx.exception), InvalidToken)
+
+    def test_exactly_ttl_is_valid(self):
+        token = issue_reset_token("ada", now=1000)
+        self.assertEqual(redeem_reset_token(token, now=2800), "ada")
+
+    def test_one_second_past_ttl_is_expired(self):
+        token = issue_reset_token("ada", now=1000)
+        with self.assertRaises(TokenExpired):
+            redeem_reset_token(token, now=2801)
+
+    def test_fractional_past_ttl_is_expired(self):
+        for late in (2800.001, 2800.5):
+            with self.subTest(now=late):
+                token = issue_reset_token("ada", now=1000)
+                with self.assertRaises(TokenExpired):
+                    redeem_reset_token(token, now=late)
+
+    def test_issued_at_zero_is_a_real_timestamp(self):
+        ok = issue_reset_token("ada", now=0)
+        self.assertEqual(redeem_reset_token(ok, now=1800), "ada")
