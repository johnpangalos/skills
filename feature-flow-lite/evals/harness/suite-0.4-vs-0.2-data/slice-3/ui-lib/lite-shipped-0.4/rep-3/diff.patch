+
+// Opens from the trigger; the input inside takes focus with autoFocus.
+function AutoFocusHost() {
+  const [open, setOpen] = useState(false);
+  return (
+    <>
+      <button onClick={() => setOpen(true)}>Trigger</button>
+      <Dialog open={open} onOpenChange={setOpen} title="Search">
+        <button>first</button>
+        <input autoFocus aria-label="Query" />
+      </Dialog>
+    </>
+  );
+}
+
+// Outer dialog holds the button that opens the inner one.
+function NestedHost({ onOuterChange, onInnerChange }: { onOuterChange: (open: boolean) => void; onInnerChange: (open: boolean) => void }) {
+  const [outer, setOuter] = useState(false);
+  const [inner, setInner] = useState(false);
+  return (
+    <>
+      <button onClick={() => setOuter(true)}>Open outer</button>
+      <Dialog
+        open={outer}
+        onOpenChange={(next) => {
+          onOuterChange(next);
+          setOuter(next);
+        }}
+        title="Outer"
+      >
+        <button onClick={() => setInner(true)}>Open inner</button>
+      </Dialog>
+      <Dialog
+        open={inner}
+        onOpenChange={(next) => {
+          onInnerChange(next);
+          setInner(next);
+        }}
+        title="Inner"
+      >
+        <button>Inner action</button>
+      </Dialog>
+    </>
+  );
+}
+
+// The inner dialog's first focus target is an autoFocus input, which takes focus during the commit.
+function NestedAutoFocusHost({ onOuterChange, onInnerChange }: { onOuterChange: (open: boolean) => void; onInnerChange: (open: boolean) => void }) {
+  const [outer, setOuter] = useState(false);
+  const [inner, setInner] = useState(false);
+  return (
+    <>
+      <button onClick={() => setOuter(true)}>Open outer</button>
+      <Dialog
+        open={outer}
+        onOpenChange={(next) => {
+          onOuterChange(next);
+          setOuter(next);
+        }}
+        title="Outer"
+      >
+        <button onClick={() => setInner(true)}>Open inner</button>
+        <Dialog
+          open={inner}
+          onOpenChange={(next) => {
+            onInnerChange(next);
+            setInner(next);
+          }}
+          title="Inner"
+        >
+          <button>first</button>
+          <input autoFocus aria-label="Query" />
+        </Dialog>
+      </Dialog>
+    </>
+  );
+}
+
