+// One click opens the outer and inner dialogs in the same commit. The inner one is nested in the outer one.
+function SameCommitHost({ onOuterChange, onInnerChange }: { onOuterChange: (open: boolean) => void; onInnerChange: (open: boolean) => void }) {
+  const [outer, setOuter] = useState(false);
+  const [inner, setInner] = useState(false);
+  return (
+    <>
+      <button
+        onClick={() => {
+          setOuter(true);
+          setInner(true);
