+    expect(screen.getByRole("tab", { name: "two" })).toHaveFocus();
+    expect(screen.getByRole("tab", { name: "two" })).toHaveAttribute("aria-selected", "true");
+  });
+
+  it("does nothing with all tabs disabled", async () => {
+    const user = userEvent.setup();
+    renderTabs({ disabled: NAMES });
+    await user.keyboard("{ArrowRight}{Home}{End}");
+    NAMES.forEach((name) => expect(screen.getByRole("tab", { name })).toBeDisabled());
+    expect(screen.getByRole("tab", { name: "one" })).toHaveAttribute("aria-selected", "false");
+  });
+
+  it("ignores other keys", async () => {
+    const user = userEvent.setup();
+    const onValueChange = vi.fn();
+    renderTabs({ onValueChange });
+    await user.tab();
+    await user.keyboard("a{Enter} ");
+    expect(onValueChange).not.toHaveBeenCalled();
+    expect(screen.getByRole("tab", { name: "one" })).toHaveAttribute("aria-selected", "true");
+  });
+
+  it("creates unique ids for values with spaces and slashes", () => {
+    renderTabs({ values: ["a b", "x/y", "1"] });
+    const tabs = screen.getAllByRole("tab");
+    const ids = tabs.map((tab) => tab.id);
+    expect(new Set(ids).size).toBe(3);
+    tabs.forEach((tab) => {
+      const panel = document.getElementById(tab.getAttribute("aria-controls") ?? "");
+      expect(panel).toHaveAttribute("aria-labelledby", tab.id);
+    });
+  });
+
+  it("does not move outer focus into nested tabs", async () => {
+    const user = userEvent.setup();
+    render(
+      <Tabs defaultValue="outer1">
+        <TabList aria-label="Outer">
+          <Tab value="outer1">Outer 1</Tab>
+          <Tab value="outer2">Outer 2</Tab>
+        </TabList>
+        <TabPanel value="outer1">
+          <Tabs>
+            <TabList aria-label="Inner">
+              <Tab value="inner1">Inner 1</Tab>
+              <Tab value="inner2">Inner 2</Tab>
+            </TabList>
+            <TabPanel value="inner1">Inner panel</TabPanel>
+          </Tabs>
+        </TabPanel>
+        <TabPanel value="outer2">Outer panel 2</TabPanel>
+      </Tabs>,
+    );
+    await user.click(screen.getByRole("tab", { name: "Outer 1" }));
+    await user.keyboard("{ArrowRight}");
+    expect(screen.getByRole("tab", { name: "Outer 2" })).toHaveFocus();
+    await user.keyboard("{ArrowLeft}");
+    expect(screen.getByRole("tab", { name: "Outer 1" })).toHaveFocus();
+    expect(screen.getByRole("tab", { name: "Inner 1" })).toHaveAttribute("aria-selected", "true");
+  });
+
+  it("follows DOM order when tabs are added and removed", async () => {
+    const user = userEvent.setup();
+    const { rerender } = renderTabs({ values: ["a", "c"] });
+    rerender(
+      <Tabs defaultValue="a">
+        <TabList aria-label="Sections">
+          <Tab value="a">a</Tab>
+          <Tab value="b">b</Tab>
+          <Tab value="c">c</Tab>
+        </TabList>
+      </Tabs>,
+    );
+    await user.click(screen.getByRole("tab", { name: "a" }));
+    await user.keyboard("{ArrowRight}");
+    expect(screen.getByRole("tab", { name: "b" })).toHaveFocus();
+    rerender(
+      <Tabs defaultValue="a">
+        <TabList aria-label="Sections">
+          <Tab value="a">a</Tab>
+          <Tab value="c">c</Tab>
+        </TabList>
+      </Tabs>,
+    );
+    await user.click(screen.getByRole("tab", { name: "a" }));
+    await user.keyboard("{ArrowRight}");
+    expect(screen.getByRole("tab", { name: "c" })).toHaveFocus();
+  });
+});
