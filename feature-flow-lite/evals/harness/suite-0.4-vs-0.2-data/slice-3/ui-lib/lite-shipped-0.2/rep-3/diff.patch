+    firstApple.focus();
+    await user.keyboard("{ArrowRight}");
+    expect(first.querySelector('[aria-selected="true"]')).toHaveTextContent("Cherry");
+    expect(second.querySelector('[aria-selected="true"]')).toHaveTextContent("Apple");
+  });
