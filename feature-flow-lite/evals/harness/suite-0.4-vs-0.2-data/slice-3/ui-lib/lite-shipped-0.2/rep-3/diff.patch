+  it("gives two Tabs instances distinct ids and independent keyboard handling", async () => {
+    const user = userEvent.setup();
+    render(
+      <>
+        <Fruits />
+        <Fruits />
+      </>,
+    );
+    const [first, second] = screen.getAllByRole("tablist");
+    const firstApple = first.querySelector<HTMLElement>('[role="tab"]')!;
+    const secondApple = second.querySelector<HTMLElement>('[role="tab"]')!;
+    expect(firstApple.id).not.toBe(secondApple.id);
