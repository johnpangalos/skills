+import { fireEvent, render, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { describe, expect, it, vi } from "vitest";
+import { Tab, TabList, TabPanel, Tabs, type TabsProps } from "./Tabs";
+
+function Fruits(props: TabsProps) {
+  return (
+    <Tabs {...props}>
+      <TabList aria-label="Fruits">
+        <Tab value="apple">Apple</Tab>
+        <Tab value="banana" disabled>
+          Banana
+        </Tab>
+        <Tab value="cherry">Cherry</Tab>
+      </TabList>
+      <TabPanel value="apple">Apple panel</TabPanel>
+      <TabPanel value="banana">Banana panel</TabPanel>
+      <TabPanel value="cherry">Cherry panel</TabPanel>
+    </Tabs>
+  );
+}
+
+describe("Tabs", () => {
+  it("renders tablist, tabs and panels with linked ids and roles", () => {
+    render(<Fruits />);
+    const list = screen.getByRole("tablist", { name: "Fruits" });
+    expect(list).toHaveAttribute("aria-orientation", "horizontal");
+    const apple = screen.getByRole("tab", { name: "Apple" });
+    expect(apple.tagName).toBe("BUTTON");
+    expect(apple).toHaveAttribute("type", "button");
