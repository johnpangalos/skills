+
+    assert_count_output(&te, &["--count", "foo"], "2\n");
+    assert_count_output(&te, &["--count", "--type", "f", "foo"], "1\n");
+    assert_count_output(&te, &["--count", "--type", "d", "foo"], "1\n");
+}
+
