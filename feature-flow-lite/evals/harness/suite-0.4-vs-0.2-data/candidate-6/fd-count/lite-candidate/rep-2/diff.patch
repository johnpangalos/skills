+/// Ctrl-C during a --count search exits 130 and prints no partial count
+#[cfg(all(unix, not(target_os = "redox")))]
+#[test]
+fn test_count_sigint_prints_no_partial_count() {
+    let te = TestEnv::new(&[], &[]);
+    for i in 0..2000 {
+        fs::File::create(te.test_root().join(format!("file_{i}.foo"))).unwrap();
+    }
+    let mut command = fd_command(&te);
+    command
+        .args(["--count", "--color=always", "foo"])
+        .env("LS_COLORS", "di=01;34:ex=01;32")
+        .stdout(std::process::Stdio::piped())
+        .stderr(std::process::Stdio::piped());
+    // The test runner may run with SIGINT ignored, and the child would inherit
+    // that. Restore the default disposition so the child is interrupted like a
+    // terminal-run fd.
+    // SAFETY: the closure only calls signal(), which is async-signal-safe.
+    unsafe {
+        std::os::unix::process::CommandExt::pre_exec(&mut command, || {
+            if libc::signal(libc::SIGINT, libc::SIG_DFL) == libc::SIG_ERR {
+                return Err(std::io::Error::last_os_error());
+            }
+            Ok(())
+        });
+    }
+    let child = command.spawn().expect("fd spawn");
+
+    // SAFETY: the pid belongs to our child, which has not been waited on yet.
+    let sent = unsafe { libc::kill(child.id() as libc::pid_t, libc::SIGINT) };
+    assert_eq!(sent, 0, "{}", std::io::Error::last_os_error());
+
+    let output = child.wait_with_output().expect("fd output");
+
+    assert!(output.stdout.is_empty(), "{:?}", output.stdout);
+    assert!(
+        output.status.code() == Some(130)
+            || std::os::unix::process::ExitStatusExt::signal(&output.status) == Some(2),
+        "{:?}",
+        output.status
+    );
+}
