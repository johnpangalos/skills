+/// Output options and -x/-X/-l conflict with --count, in either argument order
+#[test]
+fn test_count_conflicts_with_output_options() {
+    let te = TestEnv::new(&[], &["a.foo"]);
+    let conflicting: &[&[&str]] = &[
+        &["--exec=cat"],
+        &["--exec-batch=cat"],
+        &["-l"],
+        &["--format={}"],
+        &["-0"],
+        &["--print0"],
+        &["-q"],
+        &["--quiet"],
+        &["--has-results"],
+    ];
+    for flag in conflicting {
+        let mut before = vec!["--count"];
+        before.extend_from_slice(flag);
+        let mut after = flag.to_vec();
+        after.push("--count");
+
+        for args in [before, after] {
+            assert_usage_error_for_count(&te, &args);
+        }
+    }
+
+    // -x and -X take a command that runs to the end of the arguments, so --count must come first.
+    assert_usage_error_for_count(&te, &["--count", "-x", "cat"]);
+    assert_usage_error_for_count(&te, &["--count", "-X", "cat"]);
