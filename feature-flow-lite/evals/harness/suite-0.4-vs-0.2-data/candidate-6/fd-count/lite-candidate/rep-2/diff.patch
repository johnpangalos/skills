+/// Run *fd* in the test root, with the global ignore file disabled.
+fn fd_command(te: &TestEnv) -> std::process::Command {
+    let mut cmd = std::process::Command::new(env!("CARGO_BIN_EXE_fd"));
+    cmd.current_dir(te.test_root())
+        .arg("--no-global-ignore-file")
+        .env("LS_COLORS", "");
+    cmd
+}
+
+/// Run *fd* with the given arguments in the test root and return its output.
+fn run_fd(te: &TestEnv, args: &[&str]) -> std::process::Output {
+    fd_command(te).args(args).output().expect("fd output")
+}
+
+/// Assert that *fd* with the given arguments succeeds and prints exactly `expected`.
+fn assert_count_output(te: &TestEnv, args: &[&str], expected: &str) {
+    let output = run_fd(te, args);
+    assert!(
+        output.status.success(),
+        "fd {:?} failed: {}",
+        args,
+        String::from_utf8_lossy(&output.stderr)
+    );
+    assert_eq!(
+        String::from_utf8_lossy(&output.stdout),
+        expected,
+        "fd {:?}",
+        args
+    );
+}
+
+/// The number of entries plain *fd* prints for the given arguments, counted by NUL separators.
+fn plain_entry_count(te: &TestEnv, args: &[&str]) -> usize {
+    let mut args = args.to_vec();
+    args.push("--print0");
+    let output = run_fd(te, &args);
+    assert!(output.status.success());
+    output
+        .stdout
+        .split(|&byte| byte == 0)
+        .filter(|entry| !entry.is_empty())
+        .count()
+}
+
+/// Print the number of matching entries (--count)
+#[test]
+fn test_count_prints_number_of_matches() {
+    let te = TestEnv::new(&[], &["a.foo", "b.foo", "c.bar"]);
+
+    assert_count_output(&te, &["--count", "foo"], "2\n");
+    assert_count_output(&te, &["--count", "zzz"], "0\n");
+}
+
+/// Directories and files both count when no --type is given
