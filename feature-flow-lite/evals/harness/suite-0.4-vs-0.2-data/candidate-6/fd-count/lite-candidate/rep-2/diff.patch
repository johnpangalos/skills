+/// Assert that *fd* with the given arguments is a usage error (exit 2) that names --count.
+fn assert_usage_error_for_count(te: &TestEnv, args: &[&str]) {
+    let output = run_fd(te, args);
+    let stderr = String::from_utf8_lossy(&output.stderr);
+    assert_eq!(output.status.code(), Some(2), "fd {:?}", args);
+    assert!(output.stdout.is_empty(), "fd {:?}", args);
+    assert!(
+        stderr.contains("cannot be used with"),
+        "fd {:?}: {}",
+        args,
+        stderr
+    );
+    assert!(stderr.contains("--count"), "fd {:?}: {}", args, stderr);
