+/// Run *fd* in the test root and return its raw output, so that stdout and stderr can be checked exactly.
+fn fd_raw_output(te: &TestEnv, args: &[&str]) -> std::process::Output {
+    std::process::Command::new(te.test_exe())
+        .current_dir(te.test_root())
+        .arg("--no-global-ignore-file")
+        .env("LS_COLORS", "")
+        .args(args)
+        .output()
+        .expect("fd output")
+}
+
+/// Number of lines that plain *fd* prints for the given arguments.
+fn plain_line_count(te: &TestEnv, args: &[&str]) -> usize {
+    let output = fd_raw_output(te, args);
+    assert_eq!(output.status.code(), Some(0));
+    String::from_utf8_lossy(&output.stdout).lines().count()
+}
+
+/// Print the number of results instead of the results (--count)
+#[test]
+fn test_count_prints_number_of_results() {
+    let dirs = &["foo_dir", "one"];
+    let files = &["one/a.foo", "one/b.foo", "foo.txt", "c.bar"];
+    let te = TestEnv::new(dirs, files);
+
+    // Directories and files both count
+    let output = fd_raw_output(&te, &["--count", "foo"]);
+    assert_eq!(output.status.code(), Some(0));
+    assert_eq!(output.stdout, b"4\n");
+}
+
+/// An entry whose name contains a newline counts once (--count)
+#[test]
+fn test_count_newline_in_name_counts_once() {
+    let te = TestEnv::new(&[], &["new\nline.foo", "other.foo"]);
+
+    assert_eq!(fd_raw_output(&te, &["--count", "foo"]).stdout, b"2\n");
+}
+
+/// Color output does not add escape codes to the count (--count)
+#[test]
+fn test_count_color_always_prints_plain_number() {
+    let te = TestEnv::new(&["foo_dir"], &["a.foo", "b.foo"]);
+
+    assert_eq!(
+        fd_raw_output(&te, &["--count", "--color", "always", "foo"]).stdout,
+        b"3\n"
+    );
+}
+
+/// Search options give the same count as the plain output lines (--count)
+#[test]
+fn test_count_matches_plain_output_with_filters() {
+    let dirs = &["one", "one/two", ".hidden_dir"];
+    let files = &[
+        "one/a.foo",
+        "one/e.bar",
+        "one/two/b.foo",
+        "one/two/c.txt",
+        ".hidden_dir/d.foo",
+        ".hidden.foo",
+        "f.foo",
+    ];
+    let te = TestEnv::new(dirs, files);
+
+    let arg_sets: &[&[&str]] = &[
+        &["foo"],
+        &["--glob", "*.foo"],
+        &["--type", "f", "foo"],
+        &["--type", "d", "one"],
+        &["--extension", "foo"],
+        &["--hidden", "foo"],
+        &["--no-ignore", "foo"],
+        &["--exclude", "two", "foo"],
+        &["--max-depth", "2", "foo"],
+        &["--and", "b", "foo"],
+    ];
+    for args in arg_sets {
+        let mut count_args = vec!["--count"];
+        count_args.extend_from_slice(args);
+        let expected = format!("{}\n", plain_line_count(&te, args));
+
+        assert_eq!(
+            fd_raw_output(&te, &count_args).stdout,
+            expected.as_bytes(),
+            "args: {args:?}"
+        );
+    }
+}
+
+/// Several search paths give one total (--count)
+#[test]
+fn test_count_multiple_paths_print_one_total() {
+    let te = TestEnv::new(&["one", "one/two"], &["one/a.foo", "one/two/b.foo"]);
+
+    // Overlapping paths: the count must equal the plain output lines for the same arguments
+    let expected = format!("{}\n", plain_line_count(&te, &["foo", "one", "one/two"]));
+    let output = fd_raw_output(&te, &["--count", "foo", "one", "one/two"]);
+    assert_eq!(output.status.code(), Some(0));
+    assert_eq!(output.stdout, expected.as_bytes());
+}
+
+/// --max-results and -1 cap the count (--count)
+#[test]
+fn test_count_max_results_caps_count() {
+    let te = TestEnv::new(&[], &["a.foo", "b.foo", "c.foo"]);
+
+    assert_eq!(
+        fd_raw_output(&te, &["--count", "--max-results=2", "foo"]).stdout,
+        b"2\n"
+    );
+    assert_eq!(fd_raw_output(&te, &["--count", "-1", "foo"]).stdout, b"1\n");
+    // A limit above the number of matches gives the actual count
+    assert_eq!(
+        fd_raw_output(&te, &["--count", "--max-results=10", "foo"]).stdout,
+        b"3\n"
+    );
+    // A limit of 0 means unlimited, as without --count
+    assert_eq!(
+        fd_raw_output(&te, &["--count", "--max-results=0", "foo"]).stdout,
+        b"3\n"
+    );
+    assert_eq!(fd_raw_output(&te, &["--count", "foo"]).stdout, b"3\n");
+    assert_eq!(
+        fd_raw_output(&te, &["--count", "-1", "nomatch"]).stdout,
+        b"0\n"
+    );
+}
+
+/// No matches print 0 and exit 0 (--count)
+#[test]
+fn test_count_no_matches_prints_zero() {
+    let te = TestEnv::new(&[], &["a.foo"]);
+
+    let output = fd_raw_output(&te, &["--count", "nomatch"]);
+    assert_eq!(output.status.code(), Some(0));
+    assert_eq!(output.stdout, b"0\n");
+}
+
+/// A missing search path fails the same way as plain fd (--count)
+#[test]
+fn test_count_missing_search_path_fails_like_plain_fd() {
+    let te = TestEnv::new(&[], &["a.foo"]);
+
+    let plain = fd_raw_output(&te, &["foo", "missing"]);
+    let counted = fd_raw_output(&te, &["--count", "foo", "missing"]);
+    assert_eq!(plain.status.code(), Some(1));
+    assert_eq!(counted.status.code(), Some(1));
+    assert_eq!(counted.stderr, plain.stderr);
+    assert!(counted.stdout.is_empty());
+}
+
+/// Output-changing options are usage errors with --count, in both orders (--count)
+#[test]
+fn test_count_conflicts_with_output_options() {
+    let te = TestEnv::new(&[], &["a.foo"]);
+
+    let conflicting: &[&[&str]] = &[
+        &["-x", "echo", "{}", ";"],
+        &["--exec", "echo", "{}", ";"],
+        &["-X", "echo", ";"],
+        &["--exec-batch", "echo", ";"],
+        &["-l"],
+        &["--list-details"],
+        &["-0"],
+        &["--print0"],
+        &["--format", "{/}"],
+        &["-q"],
+        &["--quiet"],
+        &["--has-results"],
+    ];
+    for flag in conflicting {
+        let mut count_first = vec!["--count"];
+        count_first.extend_from_slice(flag);
+        count_first.push("foo");
+        let mut count_last = flag.to_vec();
+        count_last.extend(["--count", "foo"]);
+
+        for args in [count_first, count_last] {
+            let output = fd_raw_output(&te, &args);
+            let stderr = String::from_utf8_lossy(&output.stderr);
+            assert_eq!(output.status.code(), Some(2), "args: {args:?}");
+            assert!(output.stdout.is_empty(), "args: {args:?}");
+            assert!(
+                stderr.starts_with("error: the argument '")
+                    && stderr.contains("cannot be used with")
+                    && stderr.contains("--count"),
+                "args: {args:?}, stderr: {stderr}"
+            );
+        }
+    }
+}
+
+/// Count mode never prints entries, even when streaming starts at once (--count)
+#[test]
+fn test_count_never_prints_entries_when_streaming() {
+    let te = TestEnv::new(&[], &["a.foo", "b.foo"]);
+
+    assert_eq!(
+        fd_raw_output(&te, &["--count", "--max-buffer-time", "0", "foo"]).stdout,
+        b"2\n"
+    );
+}
+
+/// A full stdout reports the write error and exits 1 (--count)
+#[cfg(target_os = "linux")]
+#[test]
+fn test_count_full_stdout_reports_write_error() {
+    let te = TestEnv::new(&[], &["a.foo"]);
+    let full = std::fs::OpenOptions::new()
+        .write(true)
+        .open("/dev/full")
+        .unwrap();
+
+    let output = std::process::Command::new(te.test_exe())
+        .current_dir(te.test_root())
+        .arg("--no-global-ignore-file")
+        .args(["--count", "foo"])
+        .stdout(full)
+        .stderr(std::process::Stdio::piped())
+        .spawn()
+        .unwrap()
+        .wait_with_output()
+        .unwrap();
+
+    assert_eq!(output.status.code(), Some(1));
+    assert_eq!(
+        String::from_utf8_lossy(&output.stderr),
+        "[fd error]: Could not write to output: No space left on device (os error 28)\n"
+    );
+}
+
+/// A closed pipe is ignored, as for plain output (--count)
+#[cfg(unix)]
+#[test]
+fn test_count_broken_pipe_is_ignored() {
+    let te = TestEnv::new(&[], &["a.foo"]);
+    let (reader, writer) = std::io::pipe().unwrap();
+    drop(reader);
+
+    let output = std::process::Command::new(te.test_exe())
+        .current_dir(te.test_root())
+        .arg("--no-global-ignore-file")
+        .args(["--count", "foo"])
+        .stdout(writer)
+        .stderr(std::process::Stdio::piped())
+        .spawn()
+        .unwrap()
+        .wait_with_output()
+        .unwrap();
+
+    assert_eq!(output.status.code(), Some(0));
+    assert!(output.stderr.is_empty());
+}
+
+/// The long help describes --count
+#[test]
+fn test_count_in_long_help() {
+    let te = TestEnv::new(&[], &[]);
+
+    let output = te.assert_success_and_get_output(".", &["--help"]);
+    let help = String::from_utf8_lossy(&output.stdout);
+    assert!(
+        help.contains("Print the number of matching entries instead of the entries themselves.")
+    );
+}
