+/// Number of lines that fd prints, given its stdout.
+fn listed_lines(stdout: &[u8]) -> usize {
+    stdout
+        .split(|&byte| byte == b'\n')
+        .filter(|line| !line.is_empty())
+        .count()
+}
+
+/// Assert that `--count` with the given arguments prints exactly the number of lines that the
+/// same search prints without `--count`.
+fn assert_count_matches_listing(te: &TestEnv, args: &[&str]) {
+    let listing = te.assert_success_and_get_output(".", args);
+    let expected = format!("{}\n", listed_lines(&listing.stdout));
+
+    let mut count_args = vec!["--count"];
+    count_args.extend_from_slice(args);
+    let counted = te.assert_success_and_get_output(".", &count_args);
+
+    assert_eq!(expected.as_bytes(), &counted.stdout[..], "args: {args:?}");
+}
+
+/// A command that runs *fd* in the root of the test environment.
+fn fd_in_root(te: &TestEnv) -> std::process::Command {
+    let mut command = std::process::Command::new(te.test_exe());
+    command.current_dir(te.test_root());
+    command
+}
+
+/// Run *fd* in the root of the test environment and return the raw output.
+fn run_fd_in_root(te: &TestEnv, args: &[&str]) -> std::process::Output {
+    fd_in_root(te).args(args).output().expect("fd output")
+}
