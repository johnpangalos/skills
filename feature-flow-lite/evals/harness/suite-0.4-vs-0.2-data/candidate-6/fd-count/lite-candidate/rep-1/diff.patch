+/// Count the results received from the walker, without buffering or printing them.
+fn count_entries(
+    rx: Receiver<Batch>,
+    max_results: Option<usize>,
+    show_filesystem_errors: bool,
+    quit_flag: &AtomicBool,
+    interrupt_flag: &AtomicBool,
+) -> Result<usize, ExitCode> {
+    let mut num_results = 0;
+    for result in rx.into_iter().flatten() {
+        match result {
+            WorkerResult::Entry(_) => {
+                if interrupt_flag.load(Ordering::Relaxed) {
+                    return Err(ExitCode::KilledBySigint);
+                }
+
+                num_results += 1;
+                if let Some(max_results) = max_results
+                    && num_results >= max_results
+                {
+                    quit_flag.store(true, Ordering::Relaxed);
+                    break;
+                }
+            }
+            WorkerResult::Error(err) => {
+                if show_filesystem_errors {
+                    print_error!("{}", err);
+                }
+            }
+        }
+    }
+
+    // A partial count would be wrong, so an interrupted search prints nothing.
+    if interrupt_flag.load(Ordering::Relaxed) {
+        return Err(ExitCode::KilledBySigint);
+    }
+    Ok(num_results)
+}
+
+/// Write the number of results to standard output.
+fn print_count(count: usize) -> ExitCode {
+    let mut stdout = io::stdout().lock();
+    match writeln!(stdout, "{count}").and_then(|()| stdout.flush()) {
+        Ok(()) => ExitCode::Success,
+        // A closed pipe is not reported, matching `print` for normal output.
+        Err(e) if e.kind() == io::ErrorKind::BrokenPipe => ExitCode::GeneralError,
+        Err(e) => {
+            print_error!("Could not write to output: {}", e);
+            ExitCode::GeneralError
+        }
+    }
+}
