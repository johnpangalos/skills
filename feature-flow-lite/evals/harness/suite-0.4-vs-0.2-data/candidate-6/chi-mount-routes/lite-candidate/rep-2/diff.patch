+func TestWalkMountStubCollisions(t *testing.T) {
+	mw := func(next http.Handler) http.Handler { return next }
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {})
+
+	// mountAll lists the "METHOD route" pairs a plain Mount's catch-all reports for route.
+	mountAll := func(route string) []string {
+		var out []string
+		for m := range methodMap {
+			out = append(out, m+" "+route)
+		}
+		return out
+	}
+
+	tests := []struct {
+		name     string
+		setup    func() Router
+		expected []string // "METHOD route" pairs Walk must report, in any order
+		mwRoutes []string // "METHOD route" pairs that must carry exactly one middleware
+	}{
+		{
+			name: "issue router: nested Route with Get on the same pattern",
+			setup: func() Router {
+				r := NewMux()
+				r.Route("/foo", func(r Router) {
+					r.Route("/bar", func(r Router) {
+						r.Get("/{id}", h)
+					})
+					r.Get("/bar", h)
+				})
+				return r
+			},
+			expected: []string{"GET /foo/bar", "GET /foo/bar/{id}"},
+		},
+		{
+			name: "Get, Post, Delete, Method and MethodFunc after Mount",
+			setup: func() Router {
+				r := NewMux()
+				r.Mount("/m", h)
+				r.Get("/m", h)
+				r.Post("/m", h)
+				r.Delete("/m", h)
+				r.Method("PATCH", "/m", h)
+				r.MethodFunc("PUT", "/m", h)
+				return r
+			},
+			expected: append([]string{"GET /m", "POST /m", "DELETE /m", "PATCH /m", "PUT /m"}, mountAll("/m/*")...),
+		},
+		{
+			name: "Handle after Mount reports every method on the pattern",
+			setup: func() Router {
+				r := NewMux()
+				r.Mount("/m", h)
+				r.Handle("/m", h)
+				return r
+			},
+			expected: append(mountAll("/m"), mountAll("/m/*")...),
+		},
+		{
+			name: "Post on the trailing slash stub of a Mount",
+			setup: func() Router {
+				r := NewMux()
+				r.Mount("/m", h)
+				r.Post("/m/", h)
+				return r
+			},
+			expected: append([]string{"POST /m/"}, mountAll("/m/*")...),
+		},
+		{
+			name: "Put after Mount of a plain handler",
+			setup: func() Router {
+				r := NewMux()
+				r.Mount("/p", h)
+				r.Put("/p", h)
+				return r
+			},
+			expected: append([]string{"PUT /p"}, mountAll("/p/*")...),
+		},
+		{
+			name: "With middleware Get after Mount keeps its middleware",
+			setup: func() Router {
+				r := NewMux()
+				r.Mount("/m", h)
+				r.With(mw).Get("/m", h)
+				return r
+			},
+			expected: append([]string{"GET /m"}, mountAll("/m/*")...),
+			mwRoutes: []string{"GET /m"},
+		},
+		{
+			name: "Get registered before Mount is overwritten and not reported",
+			setup: func() Router {
+				r := NewMux()
+				r.Get("/m", h)
+				r.Mount("/m", h)
+				return r
+			},
+			expected: mountAll("/m/*"),
+		},
+		{
+			name: "Mount at root with a Get beside it",
+			setup: func() Router {
+				r := NewMux()
+				r.Mount("/", h)
+				r.Get("/x", h)
+				return r
+			},
+			expected: append([]string{"GET /x"}, mountAll("/*")...),
+		},
+		{
+			name: "Mount of a Mux without a collision",
+			setup: func() Router {
+				r := NewMux()
+				sub := NewMux()
+				sub.Get("/x", h)
+				r.Mount("/m", sub)
+				return r
+			},
+			expected: []string{"GET /m/x"},
+		},
+		{
+			name: "Empty Route",
+			setup: func() Router {
+				r := NewMux()
+				r.Route("/e", func(r Router) {})
+				return r
+			},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			r := tt.setup()
+			var got []string
+			err := Walk(r, func(method, route string, handler http.Handler, middlewares ...func(http.Handler) http.Handler) error {
+				key := method + " " + route
+				got = append(got, key)
+				want := 0
+				if slices.Contains(tt.mwRoutes, key) {
+					want = 1
+				}
+				if len(middlewares) != want {
+					t.Errorf("%s: expected %d middlewares, got %d", key, want, len(middlewares))
+				}
+				return nil
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			want := slices.Sorted(slices.Values(tt.expected))
+			slices.Sort(got)
+			if !slices.Equal(got, want) {
+				t.Fatalf("walk mismatch\n got: %q\nwant: %q", got, want)
+			}
+		})
+	}
+}
+
+func TestRoutesMountStubCollision(t *testing.T) {
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {})
+
+	// allKeys is the Handlers key set of a route registered with Handle: "*" plus every method.
+	allKeys := []string{"*"}
+	for m := range methodMap {
+		allKeys = append(allKeys, m)
+	}
+
+	tests := []struct {
+		name     string
+		setup    func(r Router)
+		handlers []string // sorted Handlers keys expected on the /m route
+	}{
+		{
+			name:     "Get after Mount",
+			setup:    func(r Router) { r.Get("/m", h) },
+			handlers: []string{"GET"},
+		},
+		{
+			name:     "Handle after Mount",
+			setup:    func(r Router) { r.Handle("/m", h) },
+			handlers: allKeys,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			r := NewMux()
+			r.Mount("/m", h)
+			tt.setup(r)
+
+			var found []Route
+			for _, rt := range r.Routes() {
+				if rt.Pattern == "/m" {
+					found = append(found, rt)
+				}
+			}
+			if len(found) != 1 {
+				t.Fatalf("expected one route for /m, got %d", len(found))
+			}
+			if found[0].SubRoutes != nil {
+				t.Fatalf("expected no subroutes on /m")
+			}
+			got := slices.Sorted(maps.Keys(found[0].Handlers))
+			want := slices.Sorted(slices.Values(tt.handlers))
+			if !slices.Equal(got, want) {
+				t.Fatalf("handler keys mismatch\n got: %q\nwant: %q", got, want)
+			}
+		})
+	}
+}
