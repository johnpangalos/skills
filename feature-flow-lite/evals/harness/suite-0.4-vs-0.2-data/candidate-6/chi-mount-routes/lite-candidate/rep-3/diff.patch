+// walkAllMethods returns the "METHOD route" pairs for every method in methodMap,
+// which may include custom methods registered by other tests in the package.
+func walkAllMethods(route string) []string {
+	var out []string
+	for m := range methodMap {
+		out = append(out, m+" "+route)
+	}
+	return out
+}
+
+// expectWalk fails unless Walk reports exactly the "METHOD route" pairs in want, each once.
+// A route that has middlewares is reported as "METHOD route (mw)".
+func expectWalk(t *testing.T, r Routes, want ...string) {
+	t.Helper()
+	missing := make(map[string]bool)
+	for _, w := range want {
+		missing[w] = true
+	}
+	err := Walk(r, func(method string, route string, handler http.Handler, middlewares ...func(http.Handler) http.Handler) error {
+		key := method + " " + route
+		if len(middlewares) > 0 {
+			key += " (mw)"
+		}
+		if !missing[key] {
+			t.Fatalf("unexpected or duplicate route %q", key)
+		}
+		delete(missing, key)
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(missing) != 0 {
+		t.Fatalf("missing routes: %v", missing)
+	}
+}
+
+func TestWalkRouteOnCollidingPattern(t *testing.T) {
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {})
+	mw := func(next http.Handler) http.Handler { return next }
+
+	tests := []struct {
+		name  string
+		setup func(r *Mux)
+		want  []string
+	}{
+		{
+			name: "Get on the pattern of a nested Route",
+			setup: func(r *Mux) {
+				r.Route("/foo", func(r Router) {
+					r.Route("/bar", func(r Router) { r.Get("/{id}", h) })
+					r.Get("/bar", h)
+				})
+			},
+			want: []string{"GET /foo/bar", "GET /foo/bar/{id}"},
+		},
+		{
+			name: "Get and Post on the pattern of a Route",
+			setup: func(r *Mux) {
+				r.Route("/bar", func(r Router) { r.Get("/x", h) })
+				r.Get("/bar", h)
+				r.Post("/bar", h)
+			},
+			want: []string{"GET /bar", "POST /bar", "GET /bar/x"},
+		},
+		{
+			name: "Handle on the pattern of a Route",
+			setup: func(r *Mux) {
+				r.Route("/bar", func(r Router) { r.Get("/x", h) })
+				r.Handle("/bar", h)
+			},
+			want: append(walkAllMethods("/bar"), "GET /bar/x"),
+		},
+		{
+			name: "Get on the trailing-slash pattern of a Route",
+			setup: func(r *Mux) {
+				r.Route("/bar", func(r Router) { r.Get("/x", h) })
+				r.Get("/bar/", h)
+			},
+			want: []string{"GET /bar/", "GET /bar/x"},
+		},
+		{
+			name: "Get on the pattern of a plain Mount",
+			setup: func(r *Mux) {
+				r.Mount("/bar", h)
+				r.Get("/bar", h)
+			},
+			want: append(walkAllMethods("/bar/*"), "GET /bar"),
+		},
+		{
+			name: "Get with middleware on the pattern of a Route",
+			setup: func(r *Mux) {
+				r.Route("/bar", func(r Router) { r.Get("/x", h) })
+				r.With(mw).Get("/bar", h)
+			},
+			want: []string{"GET /bar (mw)", "GET /bar/x"},
+		},
+		{
+			name: "Get registered before a Route on the same pattern is clobbered",
+			setup: func(r *Mux) {
+				r.Get("/bar", h)
+				r.Route("/bar", func(r Router) { r.Get("/{id}", h) })
+			},
+			want: []string{"GET /bar/{id}"},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			r := NewMux()
+			tt.setup(r)
+			expectWalk(t, r, tt.want...)
+		})
+	}
+}
+
+func TestWalkUnchangedWithoutCollision(t *testing.T) {
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {})
+
+	tests := []struct {
+		name  string
+		setup func(r *Mux)
+		want  []string
+	}{
+		{
+			name: "plain Mount",
+			setup: func(r *Mux) {
+				r.Mount("/bar", h)
+				r.Get("/x", h)
+			},
+			want: append(walkAllMethods("/bar/*"), "GET /x"),
+		},
+		{
+			name: "nested Route",
+			setup: func(r *Mux) {
+				r.Route("/foo", func(r Router) {
+					r.Route("/bar", func(r Router) { r.Get("/{id}", h) })
+					r.Get("/z", h)
+				})
+			},
+			want: []string{"GET /foo/bar/{id}", "GET /foo/z"},
+		},
+		{
+			name: "Mount root of a sub-router with root Get",
+			setup: func(r *Mux) {
+				sub := NewRouter()
+				sub.Get("/s", h)
+				r.Mount("/", sub)
+				r.Get("/", h)
+			},
+			want: []string{"GET /", "GET /s"},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			r := NewMux()
+			tt.setup(r)
+			expectWalk(t, r, tt.want...)
+		})
+	}
+}
+
+func TestRoutesCollidingPatternEntry(t *testing.T) {
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {})
+	r := NewMux()
+	r.Route("/foo", func(r Router) {
+		r.Route("/bar", func(r Router) { r.Get("/{id}", h) })
+		r.Get("/bar", h)
+	})
+
+	top := r.Routes()
+	if len(top) != 1 || top[0].Pattern != "/foo/*" {
+		t.Fatalf("expected only the /foo/* route at the top level, got %v", top)
+	}
+	for _, rt := range top[0].SubRoutes.Routes() {
+		if rt.Pattern != "/bar" {
+			continue
+		}
+		if rt.SubRoutes != nil || len(rt.Handlers) != 1 || rt.Handlers["GET"] == nil {
+			t.Fatalf("expected /bar with only a GET handler and no SubRoutes, got %+v", rt)
+		}
+		return
+	}
+	t.Fatal("no /bar subroute found")
+}
