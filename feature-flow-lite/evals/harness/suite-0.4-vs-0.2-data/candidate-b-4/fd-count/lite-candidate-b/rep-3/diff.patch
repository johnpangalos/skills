+/// Run *fd* with the given arguments and return its standard output as a string.
+fn stdout_of(te: &TestEnv, args: &[&str]) -> String {
+    String::from_utf8_lossy(&te.assert_success_and_get_output(".", args).stdout).into_owned()
+}
+
+/// --count prints the number of lines plain output would print, with the same filters and paths
+#[test]
+fn test_count_matches_plain_output() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+
+    let cases: &[&[&str]] = &[
+        &["foo"],
+        &["-H", "foo"],
+        &["-I", "foo"],
+        &["-HI", "foo"],
+        &["--glob", "*.foo"],
+        &["-d", "1", "foo"],
+        &["--min-depth", "2", "foo"],
+        &["-t", "f", "-e", "foo"],
+        &["-E", "one", "foo"],
+        &["--full-path", "two/c"],
+        &["b", "--and", "foo"],
+        &["foo", "one", "one/two"],
+        &["foo", "one", "one"],
+    ];
+    for args in cases {
+        let plain = stdout_of(&te, args);
+        let count = stdout_of(&te, &[&["--count"][..], args].concat());
+        assert_eq!(count, format!("{}\n", plain.lines().count()), "{args:?}");
+    }
+}
+
+/// Count is per entry, not per line of output (names may contain newlines)
+#[cfg(unix)]
+#[test]
+fn test_count_newline_in_name() {
+    let te = TestEnv::new(&[], &["a\nb.foo", "c.foo"]);
+
+    assert_eq!(stdout_of(&te, &["--count", "foo"]), "2\n");
+}
+
+/// No matches prints a zero, including when every entry is excluded
+#[test]
+fn test_count_no_matches() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+
+    assert_eq!(stdout_of(&te, &["--count", "nomatch"]), "0\n");
+    assert_eq!(stdout_of(&te, &["--count", "--exclude", "*"]), "0\n");
+}
+
+/// --max-results and -1 cap the count
+#[test]
+fn test_count_max_results() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+
+    assert_eq!(
+        stdout_of(&te, &["--count", "--max-results=2", "foo"]),
+        "2\n"
+    );
+    assert_eq!(stdout_of(&te, &["--count", "-1", "foo"]), "1\n");
+
+    let plain = stdout_of(&te, &["--max-results", "0", "foo"]);
+    assert_eq!(
+        stdout_of(&te, &["--count", "--max-results", "0", "foo"]),
+        format!("{}\n", plain.lines().count())
+    );
+}
+
+/// A nonexistent search path fails with the same exit code and error as plain output
+#[test]
+fn test_count_missing_search_path() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+    let expected = "[fd error]: Search path \"nosuchdir\" is not a directory.
+        [fd error]: No valid search paths given.";
+
+    let plain = te.assert_error(&["foo", "nosuchdir"], expected);
+    let count = te.assert_error(&["--count", "foo", "nosuchdir"], expected);
+    assert_eq!(count.code(), plain.code());
+    assert_eq!(count.code(), Some(1));
+}
+
+/// --count conflicts with output-changing options, in both argument orders
+#[test]
+fn test_count_conflicts() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+
+    let conflicting: &[(&[&str], &str)] = &[
+        (&["-x", "echo", ";"], "--exec <cmd>..."),
+        (&["-X", "echo", ";"], "--exec-batch <cmd>..."),
+        (&["-l"], "--list-details"),
+        (&["--format", "{}"], "--format <fmt>"),
+        (&["-0"], "--print0"),
+        (&["-q"], "--quiet"),
+        (&["--has-results"], "--quiet"),
+    ];
+    for (flag, name) in conflicting {
+        let flag_first = [*flag, &["--count"][..]].concat();
+        let count_first = [&["--count"][..], flag].concat();
+        let expected_flag_first =
+            format!("error: the argument '{name}' cannot be used with '--count'");
+        let expected_count_first =
+            format!("error: the argument '--count' cannot be used with '{name}'");
+        for (args, expected) in [
+            (flag_first, expected_flag_first),
+            (count_first, expected_count_first),
+        ] {
+            let status = te.assert_error(&args, &expected);
+            assert_eq!(status.code(), Some(2), "{args:?}");
+        }
+    }
+}
+
+/// A write error on stdout fails with a message, for a full device and for a closed pipe
+#[cfg(target_os = "linux")]
+#[test]
+fn test_count_write_errors() {
+    use std::process::{Command, Stdio};
+
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+    let (reader, writer) = std::io::pipe().expect("pipe");
+    drop(reader);
+    let cases = [
+        (
+            Stdio::from(std::fs::File::create("/dev/full").unwrap()),
+            "No space left on device",
+        ),
+        (Stdio::from(writer), "Broken pipe"),
+    ];
+    for (stdout, reason) in cases {
+        let output = Command::new(te.test_exe())
+            .current_dir(te.test_root())
+            .arg("--count")
+            .stdout(stdout)
+            .stderr(Stdio::piped())
+            .output()
+            .expect("fd output");
+        assert_eq!(output.status.code(), Some(1));
+        let stderr = String::from_utf8_lossy(&output.stderr);
+        assert!(
+            stderr.starts_with(&format!("[fd error]: Could not write to output: {reason}")),
+            "{stderr}"
+        );
+    }
+}
+
+/// The flag is listed in --help, the man page and the zsh completion
+#[test]
+fn test_count_is_documented() {
+    let te = TestEnv::new(&[], &[]);
+
+    assert!(stdout_of(&te, &["--help"]).contains("--count"));
+    assert!(include_str!("../doc/fd.1").contains("\\-\\-count"));
+    assert!(include_str!("../contrib/completion/_fd").contains("--count"));
+}
