+/// --max-results and -1 cap the count, in any order relative to --count
+#[test]
+fn test_count_max_results_caps_count() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+    let full = plain_result_count(&te, &["foo"]);
+
+    let cases: &[(&[&str], usize)] = &[
+        (&["--count", "--max-results=2", "foo"], 2),
+        (&["--max-results=2", "foo", "--count"], 2),
+        (&["-1", "--count", "foo"], 1),
+        (&["foo", "--count", "-1"], 1),
+        // --max-results=0 means unlimited, as it does without --count
+        (&["--count", "--max-results=0", "foo"], full),
+        (&["--count", "-1", "zzz"], 0),
+    ];
+    for (args, expected) in cases {
+        let stdout = te.assert_success_and_get_output(".", args).stdout;
+        assert_eq!(stdout, format!("{expected}\n").as_bytes(), "args: {args:?}");
+    }
+}
+
+/// --count is a usage error (exit 2, nothing on stdout) with output modes, in either order
+#[test]
+fn test_count_conflicts_with_output_modes() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+    let conflicting: &[&[&str]] = &[
+        &["-x", "cat", ";"],
+        &["-X", "cat", ";"],
+        &["-l"],
+        &["--format", "{}"],
+        &["-0"],
+        &["-q"],
+    ];
+    for &flag in conflicting {
+        let mut before = vec!["--count"];
+        before.extend_from_slice(flag);
+        before.push("foo");
+        let mut after = flag.to_vec();
+        after.extend(["--count", "foo"]);
+
+        for args in [before, after] {
+            let output = fd_command(&te, &args).output().unwrap();
+            assert_eq!(output.status.code(), Some(2), "args: {args:?}");
+            assert!(output.stdout.is_empty(), "args: {args:?}");
+            assert!(
+                String::from_utf8_lossy(&output.stderr).contains("cannot be used with"),
+                "args: {args:?}"
+            );
+        }
+    }
+}
