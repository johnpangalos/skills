+/// SIGINT while counting exits by SIGINT and prints no count.
+/// --color always installs the Ctrl-C handler, so the interrupt flag is observed.
+#[cfg(unix)]
+#[test]
+fn test_count_interrupted_prints_no_count() {
+    use nix::sys::signal::{Signal, kill};
+    use nix::unistd::Pid;
+    use std::os::unix::process::ExitStatusExt;
+
+    let te = TestEnv::new(&[], &[]);
+    for i in 0..30000 {
+        fs::write(te.test_root().join(format!("file{i}.foo")), "").unwrap();
+    }
+
+    let child = fd_command(&te, &["--count", "--color", "always", "foo"])
+        .stdout(std::process::Stdio::piped())
+        .spawn()
+        .unwrap();
+    // Let fd install its Ctrl-C handler and start walking before the signal arrives
+    std::thread::sleep(std::time::Duration::from_millis(40));
+    kill(Pid::from_raw(child.id() as i32), Signal::SIGINT).unwrap();
+    let output = child.wait_with_output().unwrap();
+
+    assert_eq!(output.status.signal(), Some(Signal::SIGINT as i32));
+    assert!(output.stdout.is_empty());
+}
