+/// A failed write of the count exits non-zero with an error
+#[cfg(target_os = "linux")]
+#[test]
+fn test_count_write_error_fails() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+    let output = fd_command(&te, &["--count", "foo"])
+        .stdout(std::fs::File::create("/dev/full").unwrap())
+        .stderr(std::process::Stdio::piped())
+        .spawn()
+        .unwrap()
+        .wait_with_output()
+        .unwrap();
+    assert_eq!(output.status.code(), Some(1));
+    assert!(
+        String::from_utf8_lossy(&output.stderr)
+            .starts_with("[fd error]: Could not write to output: No space left on device")
+    );
+}
+
+/// A closed stdout (such as `| head -0`) exits non-zero with an error (--count)
+#[cfg(unix)]
+#[test]
+fn test_count_closed_pipe_fails() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+    let mut child = fd_command(&te, &["--count", "foo"])
+        .stdout(std::process::Stdio::piped())
+        .stderr(std::process::Stdio::piped())
+        .spawn()
+        .unwrap();
+    // Close the read end before fd writes the count
+    drop(child.stdout.take());
+    let output = child.wait_with_output().unwrap();
+    assert_eq!(output.status.code(), Some(1));
+    assert!(
+        String::from_utf8_lossy(&output.stderr)
+            .starts_with("[fd error]: Could not write to output: Broken pipe")
+    );
+}
