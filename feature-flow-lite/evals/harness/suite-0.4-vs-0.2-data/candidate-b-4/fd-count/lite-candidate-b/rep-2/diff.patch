+/// --count is in the long help, the man page, the zsh completion and the changelog
+#[test]
+fn test_count_documented() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+    let help = te.assert_success_and_get_output(".", &["--help"]).stdout;
+    assert!(String::from_utf8_lossy(&help).contains("--count"));
+    assert!(include_str!("../doc/fd.1").contains("\\-\\-count"));
+    assert!(include_str!("../contrib/completion/_fd").contains("--count["));
+
+    let changelog = include_str!("../CHANGELOG.md");
+    let features = changelog.find("## Features").unwrap();
+    let entry = changelog.find("--count").unwrap();
+    let bugfixes = changelog.find("## Bugfixes").unwrap();
+    assert!(features < entry && entry < bugfixes);
+}
