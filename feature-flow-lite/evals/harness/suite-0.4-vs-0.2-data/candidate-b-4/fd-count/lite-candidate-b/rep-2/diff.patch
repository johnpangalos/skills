+/// Number of entries that plain fd prints for the given arguments
+fn plain_result_count(te: &TestEnv, args: &[&str]) -> usize {
+    let output = te.assert_success_and_get_output(".", args);
+    String::from_utf8_lossy(&output.stdout).lines().count()
+}
+
+/// Stdout of fd run with --count and the given arguments
+fn count_stdout(te: &TestEnv, args: &[&str]) -> Vec<u8> {
+    let mut count_args = vec!["--count"];
+    count_args.extend_from_slice(args);
+    te.assert_success_and_get_output(".", &count_args).stdout
+}
+
+/// Assert that --count prints the number of entries that plain fd prints for the arguments
+fn assert_count_matches_plain(te: &TestEnv, args: &[&str]) {
+    let expected = format!("{}\n", plain_result_count(te, args));
+    assert_eq!(
+        count_stdout(te, args),
+        expected.as_bytes(),
+        "args: {args:?}"
+    );
+}
+
+/// Command that runs fd directly, so stdout and stderr can be inspected separately
+fn fd_command(te: &TestEnv, args: &[&str]) -> std::process::Command {
+    let mut cmd = std::process::Command::new(te.test_exe());
+    cmd.current_dir(te.test_root())
+        .env("LS_COLORS", "")
+        .arg("--no-global-ignore-file")
+        .args(args);
+    cmd
+}
+
+/// --count prints the same number of entries that plain fd prints, for each filter option
+#[test]
+fn test_count_matches_plain_output() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+    assert!(plain_result_count(&te, &["foo"]) > 0);
+
+    let arg_sets: &[&[&str]] = &[
+        &["foo"],
+        &["-e", "foo"],
+        &["-t", "f", "foo"],
+        &["-H", "foo"],
+        &["-I", "foo"],
+        &["--exclude", "one", "foo"],
+        &["-d", "2", "foo"],
+        &["--glob", "*.foo"],
+        &["foo", "--and", "c"],
+        &["--size=-1k", "foo"],
+    ];
+    for args in arg_sets {
+        assert_count_matches_plain(&te, args);
+    }
+}
+
+/// A search with no matches prints 0 and succeeds
+#[test]
+fn test_count_no_matches_prints_zero() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+    assert_eq!(count_stdout(&te, &["zzz"]), b"0\n");
+}
+
+/// A file name containing a newline counts as one entry
+#[cfg(unix)]
+#[test]
+fn test_count_filename_with_newline() {
+    let te = TestEnv::new(&[], &["a\nb.foo"]);
+    assert_eq!(count_stdout(&te, &["foo"]), b"1\n");
+}
+
+/// Duplicate search paths are counted the same way plain fd prints them
+#[test]
+fn test_count_duplicate_search_paths() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+    assert_count_matches_plain(&te, &["foo", "one", "one"]);
+}
+
+/// Several search paths print one total on a single line
+#[test]
+fn test_count_several_search_paths_print_one_total() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+    assert_count_matches_plain(&te, &["foo", "one", "a.foo"]);
+}
+
+/// A nonexistent search path is reported as before; valid paths are still counted
+#[test]
+fn test_count_nonexistent_search_path() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+
+    let output = fd_command(&te, &["--count", "foo", "nonexistent"])
+        .output()
+        .unwrap();
+    assert_eq!(output.status.code(), Some(1));
+    assert!(output.stdout.is_empty());
+    assert!(
+        String::from_utf8_lossy(&output.stderr)
+            .starts_with("[fd error]: Search path \"nonexistent\" is not a directory.")
+    );
+
+    assert_count_matches_plain(&te, &["foo", "one"]);
+    assert_eq!(
+        count_stdout(&te, &["foo", "one", "nonexistent"]),
+        count_stdout(&te, &["foo", "one"])
+    );
+}
