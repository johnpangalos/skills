+    /// Output the number of results (--count).
+    fn print_count(&mut self) -> ExitCode {
+        if self.interrupt_flag.load(Ordering::Relaxed) {
+            return ExitCode::KilledBySigint;
+        }
+
+        let result =
+            writeln!(self.stdout, "{}", self.num_results).and_then(|()| self.stdout.flush());
+        match result {
+            Ok(()) => ExitCode::Success,
+            // Probably a broken pipe. Exit gracefully, as flush() does.
+            Err(e) if e.kind() == ::std::io::ErrorKind::BrokenPipe => ExitCode::GeneralError,
+            Err(e) => {
+                print_error!("Could not write to output: {}", e);
+                ExitCode::GeneralError
+            }
+        }
+    }
