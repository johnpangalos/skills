+/// Print the number of matching entries (--count)
+#[test]
+fn test_count() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+
+    te.assert_output_raw(&["--count", "c.foo"], b"2\n");
+    te.assert_output_raw(&["--count", "no_such_entry"], b"0\n");
+}
+
+/// --count applies --max-results and -1 as caps on the count
+#[test]
+fn test_count_max_results() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+
+    // Unlimited
+    te.assert_output_raw(&["--count", "--max-results=0", "c.foo"], b"2\n");
+    // Capped below and above the number of matches
+    te.assert_output_raw(&["--count", "--max-results=1", "c.foo"], b"1\n");
+    te.assert_output_raw(&["--count", "--max-results=5", "c.foo"], b"2\n");
+    te.assert_output_raw(&["--count", "-1", "c.foo"], b"1\n");
+    // No matches, with a cap
+    te.assert_output_raw(&["--count", "-1", "no_such_entry"], b"0\n");
+}
+
+/// --count prints the number of lines plain fd prints for the same arguments
+#[test]
+fn test_count_matches_plain_output() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+    let cases: &[&[&str]] = &[
+        &["."],
+        &["-e", "foo"],
+        &["-t", "d"],
+        &["-H", "-I", "foo"],
+        &["--exclude", "*.foo"],
+        &["-d", "2", "."],
+        &["--min-depth", "3", "."],
+        &["-g", "*.foo"],
+        &["-p", "one/two"],
+        &["--size", "+0b"],
+        &["c", "--and", "foo"],
+        // Several, overlapping search paths
+        &[".", "one", "one/two"],
+    ];
+    for &args in cases {
+        let plain = te.assert_success_and_get_output(".", args);
+        let lines = String::from_utf8_lossy(&plain.stdout).lines().count();
+        let mut count_args = vec!["--count"];
+        count_args.extend_from_slice(args);
+        te.assert_output_raw(&count_args, format!("{lines}\n").as_bytes());
+    }
+}
+
+/// --count conflicts with options that print entries or run commands, in either order
+#[test]
+fn test_count_conflicts() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+
+    let cases = [
+        ("--exec=cat", "--exec <cmd>..."),
+        ("--exec-batch=cat", "--exec-batch <cmd>..."),
+        ("--list-details", "--list-details"),
+        ("--format={}", "--format <fmt>"),
+        ("--print0", "--print0"),
+        ("--quiet", "--quiet"),
+    ];
+    for (option, name) in cases {
+        let status = te.assert_error(
+            &["--count", option],
+            &format!("error: the argument '--count' cannot be used with '{name}'"),
+        );
+        assert_eq!(status.code(), Some(2));
+
+        let status = te.assert_error(
+            &[option, "--count"],
+            &format!("error: the argument '{name}' cannot be used with '--count'"),
+        );
+        assert_eq!(status.code(), Some(2));
+    }
+
+    // Space-separated exec forms take every argument up to ';' as the command's
+    // arguments, so --count must come after the terminator to be a flag.
+    let status = te.assert_error(
+        &["-x", "echo", ";", "--count"],
+        "error: the argument '--exec <cmd>...' cannot be used with '--count'",
+    );
+    assert_eq!(status.code(), Some(2));
+
+    let status = te.assert_error(
+        &["--exec", "echo", ";", "--count"],
+        "error: the argument '--exec <cmd>...' cannot be used with '--count'",
+    );
+    assert_eq!(status.code(), Some(2));
+
+    let status = te.assert_error(
+        &["-X", "echo", ";", "--count"],
+        "error: the argument '--exec-batch <cmd>...' cannot be used with '--count'",
+    );
+    assert_eq!(status.code(), Some(2));
+
+    let status = te.assert_error(
+        &["--count", "-x", "echo"],
+        "error: the argument '--count' cannot be used with '--exec <cmd>...'",
+    );
+    assert_eq!(status.code(), Some(2));
+
+    let status = te.assert_error(
+        &["--count", "-X", "echo"],
+        "error: the argument '--count' cannot be used with '--exec-batch <cmd>...'",
+    );
+    assert_eq!(status.code(), Some(2));
+}
