+/// A full stdout fails with an error message and exit code 1
+#[cfg(target_os = "linux")]
+#[test]
+fn test_count_full_stdout() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+    let full = fs::OpenOptions::new()
+        .write(true)
+        .open("/dev/full")
+        .unwrap();
+
+    let output = std::process::Command::new(te.test_exe())
+        .current_dir(te.test_root())
+        .args(["--count", "c.foo"])
+        .stdout(full)
+        .output()
+        .unwrap();
+    assert_eq!(output.status.code(), Some(1));
+    assert!(String::from_utf8_lossy(&output.stderr).contains("Could not write to output"));
+}
+
+/// A closed stdout exits with code 1 and no panic, as plain output does
+#[cfg(unix)]
+#[test]
+fn test_count_closed_stdout() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+
+    let mut child = std::process::Command::new(te.test_exe())
+        .current_dir(te.test_root())
+        .args(["--count", "c.foo"])
+        .stdout(std::process::Stdio::piped())
+        .stderr(std::process::Stdio::piped())
+        .spawn()
+        .unwrap();
+    drop(child.stdout.take());
+    let output = child.wait_with_output().unwrap();
+
+    assert_eq!(output.status.code(), Some(1));
+    assert!(!String::from_utf8_lossy(&output.stderr).contains("panicked"));
+}
+
+/// More matches than the output buffer holds still give one exact count
+#[test]
+fn test_count_many_matches() {
+    let te = TestEnv::new(&[], &[]);
+    for i in 0..1100 {
+        fs::write(te.test_root().join(format!("file{i}.txt")), "").unwrap();
+    }
+
+    te.assert_output_raw(&["--count", "file"], b"1100\n");
+    te.assert_output_raw(&["--count", "--max-buffer-time=0", "file"], b"1100\n");
+}
+
+/// Ctrl-C during a count exits with 130 and prints no partial count
+#[cfg(unix)]
+#[test]
+fn test_count_interrupt() {
+    let te = TestEnv::new(&[], &[]);
+    for i in 0..3000 {
+        fs::write(te.test_root().join(format!("file{i}.txt")), "").unwrap();
+    }
+
+    let child = std::process::Command::new(te.test_exe())
+        .current_dir(te.test_root())
+        .args(["--count", "--color=always", "file"])
+        .stdout(std::process::Stdio::piped())
+        .spawn()
+        .unwrap();
+    std::process::Command::new("kill")
+        .args(["-INT", &child.id().to_string()])
+        .status()
+        .unwrap();
+    let output = child.wait_with_output().unwrap();
+
+    // The signal may arrive before the handler is installed, or after the search has finished
+    if output.status.success() {
+        assert_eq!(output.stdout, b"3000\n");
+    } else {
+        assert!(output.stdout.is_empty());
+        assert!(matches!(output.status.code(), Some(130) | None));
+    }
+}
