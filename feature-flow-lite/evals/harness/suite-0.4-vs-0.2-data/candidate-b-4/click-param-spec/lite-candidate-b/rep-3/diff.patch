+def _class_statement_stacklevel() -> int:
+    """Depth of the frame running the class statement, skipping the
+    ``__init_subclass__`` and ``__new__`` frames of mixins and metaclasses
+    and the ``abc`` frames of ``ABCMeta``.
+
+    .. versionadded:: 8.6.0
+    """
+    frame: FrameType | None = sys._getframe(1)
+    level = 1
+
+    while frame is not None:
+        module = frame.f_globals.get("__name__", "")
+
+        if module != "abc" and frame.f_code.co_name not in (
+            "__init_subclass__",
+            "__new__",
+        ):
+            return level
+
+        frame = frame.f_back
+        level += 1
+
+    return level
+
