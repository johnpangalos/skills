+def _generated_option_decls(rng):
+    """Return (decls, primaries, secondaries). Each of primaries and secondaries is
+    a list of (spelling, prefix length) pairs in declaration order.
+    """
+    primaries = []
+    secondaries = []
+    seen = set()
+
+    def spelling(prefix):
+        while True:
+            text = prefix + "".join(
+                rng.choice(_CONSONANTS) for _ in range(rng.randint(1, 4))
+            )
+            if text not in seen:
+                seen.add(text)
+                return text, len(prefix)
+
+    decls = []
+
+    for _ in range(rng.randint(1, 4)):
+        prefix = rng.choice(["-", "--", "+", "/"])
+        primary = spelling(prefix)
+        primaries.append(primary)
+
+        if rng.random() < 0.5:
+            secondary = spelling(rng.choice(["-", "--", "+", "/"]))
+            secondaries.append(secondary)
+            split_char = ";" if prefix == "/" else "/"
+            decls.append(f"{primary[0]}{split_char}{secondary[0]}")
+        else:
+            decls.append(primary[0])
+
+    return decls, primaries, secondaries
+
