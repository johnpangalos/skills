+        (["-t", "--times", "count"], "--times"),
+        (["--color/--no-color"], "--color"),
+        (["-v"], "-v"),
+        (["/debug;/no-debug"], "/debug"),
+    ],
+)
+def test_spec(param_decls, expected):
+    """The spec is the option's spelling with the longest prefix, first declared on
+    a tie. An explicit name does not change it.
+    """
+    assert click.Option(param_decls).spec == expected
+
+
+def test_spec_without_opts_falls_back_to_name():
+    opt = click.Option(["--times"])
+    opt.opts = []
+
+    assert opt.spec == "times"
+
+
+def _random_option_decls(rng):
+    decls = []
+
+    for i in range(rng.randint(1, 4)):
+        name = f"{rng.choice('abxy')}{i}"
+        kind = rng.randrange(4)
+
+        if kind == 0:
+            decls.append(f"-{name}")
+        elif kind == 1:
+            decls.append(f"--{name}")
+        elif kind == 2:
+            decls.append(f"--{name}/--no-{name}")
+        else:
+            decls.append(f"/{name};/no-{name}")
+
+    if rng.random() < 0.5:
+        decls.insert(rng.randrange(len(decls) + 1), "explicit_name")
+
+    return decls
+
+
+def test_spec_over_generated_declarations():
+    """Over 1500 seeded random declaration sets, the spec is the first option with
+    the longest prefix and reading it never raises.
+    """
+    rng = random.Random(3866)
+
+    for _ in range(1500):
+        decls = _random_option_decls(rng)
+        opt = click.Option(decls)
+        expected = None
+
+        for candidate in opt.opts:
+            if expected is None or _prefix_len(candidate) > _prefix_len(expected):
+                expected = candidate
+
+        assert opt.spec == expected, f"first failing input: {decls!r}"
+
+
+def _prefix_len(opt):
+    return len(opt) - len(opt.lstrip("-/"))
+
+
+class _CustomParameter(click.Parameter):
+    def _parse_decls(self, decls, expose_value):
+        return decls[0], [], []
+
+    def add_to_parser(self, parser, ctx):
+        pass
+
+
+def test_parameter_spec_is_name():
+    param = _CustomParameter(["foo"])
+    ctx = click.Context(click.Command("cli"))
+
+    assert param.spec == "foo"
+    assert param.get_help_spec(ctx) == "foo"
+
+
+def test_parameter_error_hint_without_opts_uses_spec():
+    class Named(_CustomParameter):
+        @property
+        def spec(self):
+            return "NAMED"
+
+    assert Named(["foo"]).get_error_hint(None) == "'NAMED'"
