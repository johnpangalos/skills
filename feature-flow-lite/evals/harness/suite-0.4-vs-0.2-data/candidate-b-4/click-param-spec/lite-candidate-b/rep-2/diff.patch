+def _class_statement_stacklevel(cls: type) -> int:
+    """Depth of the first stack frame outside Click and class creation, which
+    is the class statement, or the call to ``type()`` or ``types.new_class()``.
+    ``cls`` is the class being created.
+
+    .. versionadded:: 8.6.0
+    """
+    frame: FrameType | None = sys._getframe(1)
+    level = 1
+
+    while frame is not None:
+        module = frame.f_globals.get("__name__", "")
+        is_click = module == "click" or module.startswith("click.")
+        is_hook = _is_metaclass_hook(frame, cls)
+
+        if not (is_click or module in ("abc", "types") or is_hook):
+            return level
+
+        frame = frame.f_back
+        level += 1
+
+    return level
+
+
+def _is_metaclass_hook(frame: FrameType, cls: type) -> bool:
+    """Whether the frame runs a ``__new__`` or ``__init__`` of a metaclass of
+    ``cls``, which runs while ``cls`` is being created. Never raises.
+
+    .. versionadded:: 8.6.0
+    """
+    try:
+        for klass in inspect.getmro(type(cls)):
+            for name in ("__new__", "__init__"):
+                hook = vars(klass).get(name)
+                hook = getattr(hook, "__func__", hook)
+
+                if isinstance(hook, FunctionType) and hook.__code__ is frame.f_code:
+                    return True
+    except Exception:
+        return False
+
+    return False
+
