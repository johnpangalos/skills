+/// Print the number of matching entries (--count)
+#[test]
+fn test_count() {
+    let te = TestEnv::new(&["dir"], &["a.foo", "b.foo", "dir/c.txt"]);
+
+    // The test environment also contains the `symlink` entry
+    te.assert_output(&["--count"], "5\n");
+    te.assert_output(&["--count", "--color=always"], "5\n");
+    te.assert_output(&["--count", "--extension", "foo"], "2\n");
+    te.assert_output(&["--count", "--type", "d"], "1\n");
+    te.assert_output(&["--count", "--max-depth=1"], "4\n");
+}
+
+/// Count with several search paths prints one total
+#[test]
+fn test_count_multiple_paths() {
+    let te = TestEnv::new(&["dir", "dir2"], &["dir/c.txt", "dir2/c.txt"]);
+
+    te.assert_output(&["--count", "c.txt", "dir", "dir2"], "2\n");
+    te.assert_output(
+        &[
+            "--count",
+            "c.txt",
+            "--search-path",
+            "dir",
+            "--search-path",
+            "dir2",
+        ],
+        "2\n",
+    );
+    te.assert_output(&["--count", "c.txt", "dir", "dir"], "2\n");
+}
+
+/// Count is capped by --max-results and -1
+#[test]
+fn test_count_max_results() {
+    let te = TestEnv::new(&[], &["a.foo", "b.foo"]);
+
+    te.assert_output(&["--count", "--max-results=1", "foo"], "1\n");
+    te.assert_output(&["--count", "-1", "foo"], "1\n");
+    te.assert_output(&["--count", "--max-results=5", "foo"], "2\n");
+    te.assert_output(&["--count", "--max-results=0", "foo"], "2\n");
+}
+
+/// No matches prints 0 and exits with success
+#[test]
+fn test_count_no_matches() {
+    let te = TestEnv::new(&["empty"], &["a.foo"]);
+
+    te.assert_output(&["--count", "zzz"], "0\n");
+    te.assert_output(&["--count", "-1", "zzz"], "0\n");
+    te.assert_output_subdirectory("empty", &["--count"], "0\n");
+}
+
+/// Options that cannot be combined with --count, in both argument orders
+#[test]
+fn test_count_conflicts() {
+    let te = TestEnv::new(&[], &["a.foo"]);
+
+    // (conflicting arguments, name clap reports for them)
+    let conflicts: &[(&[&str], &str)] = &[
+        (&["--exec", "echo", ";"], "--exec <cmd>..."),
+        (&["-x", "echo", ";"], "--exec <cmd>..."),
+        (&["--exec-batch", "echo", ";"], "--exec-batch <cmd>..."),
+        (&["-X", "echo", ";"], "--exec-batch <cmd>..."),
+        (&["--list-details"], "--list-details"),
+        (&["-l"], "--list-details"),
+        (&["--format", "{}"], "--format <fmt>"),
+        (&["--print0"], "--print0"),
+        (&["-0"], "--print0"),
+        (&["--quiet"], "--quiet"),
+        (&["-q"], "--quiet"),
+        (&["--has-results"], "--quiet"),
+    ];
+
+    for (args, name) in conflicts {
+        let count_first: Vec<&str> = std::iter::once("--count")
+            .chain(args.iter().copied())
+            .collect();
+        let status = te.assert_error(
+            &count_first,
+            &format!("error: the argument '--count' cannot be used with '{name}'"),
+        );
+        assert_eq!(status.code(), Some(2));
+
+        let count_last: Vec<&str> = args
+            .iter()
+            .copied()
+            .chain(std::iter::once("--count"))
+            .collect();
+        let status = te.assert_error(
+            &count_last,
+            &format!("error: the argument '{name}' cannot be used with '--count'"),
+        );
+        assert_eq!(status.code(), Some(2));
+    }
+}
