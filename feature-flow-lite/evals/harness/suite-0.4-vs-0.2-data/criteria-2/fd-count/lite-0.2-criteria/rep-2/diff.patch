+/// Print the number of search results (--count)
+#[test]
+fn test_count() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+
+    // Same number of entries as the normal output
+    te.assert_output(&["--count", "foo"], "6");
+    te.assert_output(&["--count", "nomatch"], "0");
+
+    // Filters apply as usual
+    te.assert_output(&["--count", "--type", "d", "foo"], "1");
+    te.assert_output(&["--count", "--extension", "foo"], "4");
+
+    // Overlapping search paths count the same as the normal output
+    te.assert_output(&["--count", "foo", "one/two", "one/two/three"], "6");
+
+    // Limited by --max-results and -1, zero means unlimited
+    te.assert_output(&["--count", "--max-results=2", "foo"], "2");
+    te.assert_output(&["--count", "--max-results=100", "foo"], "6");
+    te.assert_output(&["--count", "--max-results=0", "foo"], "6");
+    te.assert_output(&["--count", "-1", "foo"], "1");
+    te.assert_output(&["--count", "-1", "nomatch"], "0");
+}
+
+/// Print the number of search results (--count) for more results than the output buffer holds
+#[test]
+fn test_count_many_results() {
+    let te = TestEnv::new(&[], &[]);
+    for i in 0..1500 {
+        fs::File::create(te.test_root().join(format!("file{i}.txt"))).unwrap();
+    }
+
+    te.assert_output(&["--count", "file"], "1500");
+
+    // Streaming mode must not print any paths
+    te.assert_output(&["--count", "--max-buffer-time", "0", "file"], "1500");
+}
+
+/// Usage error for --count combined with an incompatible option (in both orders)
+#[test]
+fn test_count_conflicts() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+
+    // Conflicting option, first line of the error if --count comes first, and if it comes second
+    let conflicting: &[(&[&str], &str, &str)] = &[
+        (
+            &["-x", "echo", "{}", ";"],
+            "error: the argument '--count' cannot be used with:",
+            "error: the argument '--exec <cmd>...' cannot be used with '--count'",
+        ),
+        (
+            &["-X", "echo", ";"],
+            "error: the argument '--count' cannot be used with:",
+            "error: the argument '--exec-batch <cmd>...' cannot be used with '--count'",
+        ),
+        (
+            &["-l"],
+            "error: the argument '--count' cannot be used with:",
+            "error: the argument '--list-details' cannot be used with '--count'",
+        ),
+        (
+            &["--format", "{}"],
+            "error: the argument '--count' cannot be used with '--format <fmt>'",
+            "error: the argument '--format <fmt>' cannot be used with '--count'",
+        ),
+        (
+            &["--print0"],
+            "error: the argument '--count' cannot be used with '--print0'",
+            "error: the argument '--print0' cannot be used with '--count'",
+        ),
+        (
+            &["-q"],
+            "error: the argument '--count' cannot be used with '--quiet'",
+            "error: the argument '--quiet' cannot be used with '--count'",
+        ),
+        (
+            &["--has-results"],
+            "error: the argument '--count' cannot be used with '--quiet'",
+            "error: the argument '--quiet' cannot be used with '--count'",
+        ),
+    ];
+
+    for &(option, count_first_error, option_first_error) in conflicting {
+        let count_first: Vec<&str> = [&["--count"][..], option, &["foo"][..]].concat();
+        let option_first: Vec<&str> = [option, &["--count", "foo"][..]].concat();
+
+        for (args, expected) in [
+            (count_first, count_first_error),
+            (option_first, option_first_error),
+        ] {
+            let status = te.assert_error(&args, expected);
+            assert_eq!(status.code(), Some(2), "args: {args:?}");
+        }
+    }
+}
