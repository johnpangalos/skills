+/// Run *fd* and return its raw stdout, so the exact trailing newline is checked
+fn count_output(te: &TestEnv, args: &[&str]) -> String {
+    let output = te.assert_success_and_get_output(".", args);
+    String::from_utf8_lossy(&output.stdout).into_owned()
+}
+
+/// Number of matching entries (--count)
+#[test]
+fn test_count() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+
+    assert_eq!(count_output(&te, &["--count", "c.foo"]), "2\n");
+    assert_eq!(
+        count_output(&te, &["--count", "--color=always", "c.foo"]),
+        "2\n"
+    );
+    assert_eq!(
+        count_output(&te, &["--count", "--hyperlink=always", "c.foo"]),
+        "2\n"
+    );
+
+    // Max results caps the count
+    assert_eq!(
+        count_output(&te, &["--count", "--max-results=1", "c.foo"]),
+        "1\n"
+    );
+    assert_eq!(count_output(&te, &["--count", "-1", "c.foo"]), "1\n");
+    assert_eq!(
+        count_output(&te, &["--count", "--max-results=5", "c.foo"]),
+        "2\n"
+    );
+    assert_eq!(
+        count_output(&te, &["--count", "--max-results=0", "c.foo"]),
+        "2\n"
+    );
+}
+
+/// Filters apply to the count, and several paths give a single total (--count)
+#[test]
+fn test_count_filters_and_paths() {
+    let dirs = &["dir_a", "dir_b"];
+    let files = &[
+        "a.foo",
+        "b.foo",
+        "dir_a/c.foo",
+        "dir_b/d.bar",
+        ".hidden.foo",
+    ];
+    let te = TestEnv::new(dirs, files);
+
+    assert_eq!(count_output(&te, &["--count", "-e", "foo"]), "3\n");
+    assert_eq!(count_output(&te, &["--count", "-H", "-e", "foo"]), "4\n");
+    assert_eq!(
+        count_output(&te, &["--count", "-t", "f", "-e", "bar"]),
+        "1\n"
+    );
+    assert_eq!(count_output(&te, &["--count", "-t", "empty"]), "4\n");
+    assert_eq!(
+        count_output(&te, &["--count", "-d", "1", "-e", "foo"]),
+        "2\n"
+    );
+    assert_eq!(count_output(&te, &["--count", "--exclude", "*"]), "0\n");
+    assert_eq!(
+        count_output(&te, &["--count", "foo", "--and", "bar"]),
+        "0\n"
+    );
+
+    // One total across paths, overlapping paths are counted as plain fd prints them
+    assert_eq!(
+        count_output(&te, &["--count", "-e", "foo", ".", "dir_a", "dir_b"]),
+        "1\n"
+    );
+    assert_eq!(
+        count_output(&te, &["--count", "-e", "foo", ".", "dir_a", "dir_a"]),
+        "2\n"
+    );
+}
+
+/// Entries are counted once, even when their names contain newlines (--count)
+#[test]
+fn test_count_newline_in_name() {
+    let te = TestEnv::new(&[], &["new\nline.foo", "other.foo"]);
+
+    assert_eq!(count_output(&te, &["--count", "-e", "foo"]), "2\n");
+}
+
+/// Zero matches print 0 and succeed (--count)
+#[test]
+fn test_count_no_matches() {
+    let te = TestEnv::new(&["empty"], &[".hidden.foo"]);
+
+    assert_eq!(count_output(&te, &["--count", "nomatch-xyz"]), "0\n");
+    assert_eq!(count_output(&te, &["--count", "-e", "foo"]), "0\n");
+    assert_eq!(
+        count_output(&te, &["--count", "--max-results=1", "nomatch-xyz"]),
+        "0\n"
+    );
+    assert_eq!(count_output(&te, &["--count", "-1", "nomatch-xyz"]), "0\n");
+
+    let output = te.assert_success_and_get_output("empty", &["--count"]);
+    assert_eq!(String::from_utf8_lossy(&output.stdout), "0\n");
+}
+
+/// --count conflicts with output and search modes, in either argument order (exit code 2)
+#[test]
+fn test_count_conflicts() {
+    let te = TestEnv::new(&[], &["a.foo"]);
+
+    // (option, name clap reports for it)
+    let conflicts = [
+        ("-0", "'--print0'"),
+        ("-l", "'--list-details'"),
+        ("--format={}", "'--format <fmt>'"),
+        ("--exec=cat", "'--exec <cmd>...'"),
+        ("--exec-batch=cat", "'--exec-batch <cmd>...'"),
+        ("-q", "'--quiet'"),
+        ("--has-results", "'--quiet'"),
+    ];
+    for (option, name) in conflicts {
+        let expected = format!("error: the argument '--count' cannot be used with {name}");
+        let status = te.assert_error(&["--count", option], &expected);
+        assert_eq!(status.code(), Some(2));
+
+        let expected = format!("error: the argument {name} cannot be used with '--count'");
+        let status = te.assert_error(&[option, "--count"], &expected);
+        assert_eq!(status.code(), Some(2));
+    }
+}
+
