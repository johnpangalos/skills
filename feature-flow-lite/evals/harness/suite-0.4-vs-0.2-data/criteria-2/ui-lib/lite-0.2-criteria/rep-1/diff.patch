+    expect(dialog).toHaveAttribute("aria-modal", "true");
+    expect(dialog).toHaveAttribute("aria-describedby", screen.getByText("Are you sure?").id);
+    expect(dialog.parentElement!.parentElement).toBe(document.body);
+  });
+
+  it("omits aria-describedby when no description is given", () => {
+    render(<Dialog open onOpenChange={vi.fn()} title="Plain" />);
+    expect(screen.getByRole("dialog", { name: "Plain" })).not.toHaveAttribute("aria-describedby");
+  });
+
+  it("focuses the first tabbable element on open, skipping disabled and tabindex -1", () => {
+    render(
+      <Dialog open onOpenChange={vi.fn()} title="Focus">
+        <button disabled>off</button>
+        <button tabIndex={-1}>negative</button>
+        <button>first</button>
+        <button>second</button>
+      </Dialog>,
