+    expect(screen.getByRole("button", { name: "inside" })).toHaveFocus();
+
+    rerender(<Dialog open={false} onOpenChange={vi.fn()} title="Mounted" />);
+    expect(outside).toHaveFocus();
+    outside.remove();
+  });
+
+  it("does not throw on close when the trigger was removed while open", () => {
+    const trigger = document.createElement("button");
+    document.body.append(trigger);
+    trigger.focus();
+
+    const { rerender } = render(
+      <Dialog open onOpenChange={vi.fn()} title="Removed">
+        <button>inside</button>
+      </Dialog>,
+    );
+    trigger.remove();
+    expect(() => rerender(<Dialog open={false} onOpenChange={vi.fn()} title="Removed" />)).not.toThrow();
+    expect(screen.queryByRole("dialog")).toBeNull();
+  });
+
+  it("uses the current tabbable elements after children change while open", async () => {
+    const user = userEvent.setup();
+    const { rerender } = render(
+      <Dialog open onOpenChange={vi.fn()} title="Changing">
+        <button>a</button>
+      </Dialog>,
+    );
+    rerender(
+      <Dialog open onOpenChange={vi.fn()} title="Changing">
+        <button>a</button>
+        <button>b</button>
+      </Dialog>,
+    );
+    await user.keyboard("{Shift>}{Tab}{/Shift}");
+    expect(screen.getByRole("button", { name: "b" })).toHaveFocus();
+  });
+
+  it("lets Escape close an open Combobox listbox without closing the dialog", async () => {
+    const user = userEvent.setup();
+    const onOpenChange = vi.fn();
+    render(
+      <Dialog open onOpenChange={onOpenChange} title="Pick">
+        <Combobox
+          label="Fruit"
+          options={[{ value: "apple", label: "Apple" }]}
+          value={null}
+          onChange={vi.fn()}
+        />
+      </Dialog>,
+    );
+    const input = screen.getByRole("combobox", { name: "Fruit" });
+    await user.click(input);
+    expect(input).toHaveAttribute("aria-expanded", "true");
+
+    await user.keyboard("{Escape}");
+    expect(input).toHaveAttribute("aria-expanded", "false");
+    expect(onOpenChange).not.toHaveBeenCalled();
+
+    await user.keyboard("{Escape}");
+    expect(onOpenChange).toHaveBeenCalledWith(false);
+  });
+});
diff --git a/src/Dialog/Dialog.tsx b/src/Dialog/Dialog.tsx
