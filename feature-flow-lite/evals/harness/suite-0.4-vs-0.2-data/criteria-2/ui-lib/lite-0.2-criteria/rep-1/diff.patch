+
+  it("traps Tab and Shift+Tab inside the dialog", async () => {
+    const user = userEvent.setup();
+    render(
+      <Dialog open onOpenChange={vi.fn()} title="Trap">
+        <button>a</button>
+        <button>b</button>
+      </Dialog>,
+    );
+    expect(screen.getByRole("button", { name: "a" })).toHaveFocus();
+
+    await user.keyboard("{Shift>}{Tab}{/Shift}");
+    expect(screen.getByRole("button", { name: "b" })).toHaveFocus();
+
+    await user.keyboard("{Tab}");
+    expect(screen.getByRole("button", { name: "a" })).toHaveFocus();
+  });
+
+  it("keeps focus on the dialog when there is nothing to tab to", async () => {
+    const user = userEvent.setup();
+    render(
+      <Dialog open onOpenChange={vi.fn()} title="Nothing">
+        <p>text</p>
+      </Dialog>,
+    );
+    await user.tab();
+    expect(screen.getByRole("dialog")).toHaveFocus();
+    await user.tab({ shift: true });
+    expect(screen.getByRole("dialog")).toHaveFocus();
+  });
+
+  it("calls onOpenChange(false) on Escape without changing open itself", async () => {
+    const user = userEvent.setup();
+    const onOpenChange = vi.fn();
+    render(
+      <Dialog open onOpenChange={onOpenChange} title="Esc">
+        <button>inside</button>
+      </Dialog>,
