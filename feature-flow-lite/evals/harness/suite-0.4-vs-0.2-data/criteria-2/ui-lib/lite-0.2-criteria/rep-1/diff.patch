+    expect(screen.getByRole("button", { name: "first" })).toHaveFocus();
+  });
+
+  it("focuses the dialog itself when it has no tabbable elements", () => {
+    render(
+      <Dialog open onOpenChange={vi.fn()} title="Empty">
+        <p>just text</p>
+      </Dialog>,
+    );
+    expect(screen.getByRole("dialog")).toHaveFocus();
