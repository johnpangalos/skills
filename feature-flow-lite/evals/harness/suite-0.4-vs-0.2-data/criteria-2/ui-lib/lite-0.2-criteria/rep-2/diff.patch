+import { render, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { useState, type ReactNode } from "react";
+import { Dialog, type DialogProps } from "./Dialog";
+
+function Harness({ children, ...props }: Partial<DialogProps> & { children?: ReactNode }) {
+  const [open, setOpen] = useState(false);
+  return (
+    <>
+      <button onClick={() => setOpen(true)}>Open</button>
+      <Dialog open={open} onOpenChange={setOpen} title="Edit" {...props}>
+        {children ?? <input aria-label="Name" />}
+      </Dialog>
+    </>
+  );
+}
+
+function NestedDialogs() {
+  const [outer, setOuter] = useState(false);
+  const [inner, setInner] = useState(false);
+  return (
+    <>
+      <button onClick={() => setOuter(true)}>Open outer</button>
+      <Dialog open={outer} onOpenChange={setOuter} title="Outer">
+        <button onClick={() => setInner(true)}>Open inner</button>
+        <Dialog open={inner} onOpenChange={setInner} title="Inner">
+          <input aria-label="Inner input" />
+          <button>Inner button</button>
+        </Dialog>
+      </Dialog>
+    </>
+  );
+}
+
+describe("Dialog", () => {
+  it("renders nothing when closed", () => {
+    render(<Dialog open={false} onOpenChange={() => {}} title="Hidden" />);
+    expect(screen.queryByRole("dialog")).toBeNull();
+  });
+
+  it("renders a modal dialog into document.body labelled by its title and described by its description", () => {
+    const { container } = render(
+      <Dialog open onOpenChange={() => {}} title="Save" description="Are you sure?">
+        <button>OK</button>
+      </Dialog>,
+    );
+    const dialog = screen.getByRole("dialog", { name: "Save" });
+    expect(dialog).toHaveAttribute("aria-modal", "true");
+    expect(dialog).toHaveAccessibleDescription("Are you sure?");
+    expect(screen.getByRole("heading", { name: "Save" })).toBeInTheDocument();
+    expect(container).toBeEmptyDOMElement();
+    expect(dialog.closest("body")).toBe(document.body);
+  });
+
+  it("has no aria-describedby when no description is given", () => {
+    render(<Dialog open onOpenChange={() => {}} title="Save" />);
+    expect(screen.getByRole("dialog")).not.toHaveAttribute("aria-describedby");
+  });
+
+  it("does not render the title prop as an HTML title attribute", () => {
+    render(<Dialog open onOpenChange={() => {}} title="Save" />);
+    expect(screen.getByRole("dialog")).not.toHaveAttribute("title");
+    expect(document.querySelector("[title]")).toBeNull();
+  });
+
+  it("moves focus to the first focusable element on open", () => {
+    render(
+      <Dialog open onOpenChange={() => {}} title="Form">
+        <button disabled>Disabled</button>
+        <input aria-label="Name" />
+        <button>Save</button>
+      </Dialog>,
+    );
+    expect(screen.getByRole("textbox", { name: "Name" })).toHaveFocus();
+  });
+
+  it("focuses the dialog itself when it has no focusable children", () => {
+    render(
+      <Dialog open onOpenChange={() => {}} title="Notice">
+        <button disabled>Disabled</button>
+        <button tabIndex={-1}>Skipped</button>
+      </Dialog>,
+    );
+    expect(screen.getByRole("dialog")).toHaveFocus();
+  });
+
+  it("keeps focus on the dialog when Tab is pressed and it has no focusable children", async () => {
+    const user = userEvent.setup();
+    render(
+      <Dialog open onOpenChange={() => {}} title="Notice">
+        <button disabled>Disabled</button>
+      </Dialog>,
+    );
+    await user.tab();
+    expect(screen.getByRole("dialog")).toHaveFocus();
+    await user.tab({ shift: true });
+    expect(screen.getByRole("dialog")).toHaveFocus();
+  });
+
+  it("wraps Tab from the last focusable element to the first", async () => {
+    const user = userEvent.setup();
+    render(
+      <Dialog open onOpenChange={() => {}} title="Form">
+        <button>First</button>
+        <button>Last</button>
