+        <Dialog open onOpenChange={() => {}} title="Outer">
+          <button>Outer action</button>
+        </Dialog>
+        <Dialog open onOpenChange={() => {}} title="Inner">
+          <button>Inner action</button>
+        </Dialog>
+      </>,
+    );
+    expect(screen.getByRole("button", { name: "Inner action" })).toHaveFocus();
