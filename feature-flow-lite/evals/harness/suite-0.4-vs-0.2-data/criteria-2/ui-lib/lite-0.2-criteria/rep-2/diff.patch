+
+  it("does not crash on close when nothing was focused before opening", () => {
+    (document.activeElement as HTMLElement | null)?.blur();
+    const { unmount } = render(<Dialog open onOpenChange={() => {}} title="Form" />);
+    expect(() => unmount()).not.toThrow();
+  });
+
+  it("stays open when a controlled parent ignores onOpenChange(false)", async () => {
+    const user = userEvent.setup();
+    const onOpenChange = vi.fn();
+    render(<Dialog open onOpenChange={onOpenChange} title="Form" />);
