+import { render, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { useState } from "react";
+import { Tab, TabList, TabPanel, Tabs, type TabsProps } from "../src";
+
+const user = userEvent.setup();
+
+function Example({ disabled = [], ...props }: TabsProps & { disabled?: string[] }) {
+  return (
+    <Tabs {...props}>
+      <TabList aria-label="Sections">
+        <Tab value="one" disabled={disabled.includes("one")}>
+          One
+        </Tab>
+        <Tab value="two" disabled={disabled.includes("two")}>
+          Two
+        </Tab>
+        <Tab value="three" disabled={disabled.includes("three")}>
+          Three
+        </Tab>
+      </TabList>
+      <TabPanel value="one">Panel one</TabPanel>
+      <TabPanel value="two">Panel two</TabPanel>
+      <TabPanel value="three">Panel three</TabPanel>
+    </Tabs>
+  );
+}
+
+function tab(name: string) {
+  return screen.getByRole("tab", { name });
+}
+
+describe("Tabs", () => {
+  it("renders tablist, tabs and panels with matching ARIA relationships", () => {
+    render(<Example />);
+    expect(screen.getByRole("tablist", { name: "Sections" })).toBeInTheDocument();
+    const tabs = screen.getAllByRole("tab");
+    expect(tabs).toHaveLength(3);
+    for (const t of tabs) {
+      expect(t).toHaveAttribute("type", "button");
+      expect(t.id).not.toBe("");
+      const panel = document.getElementById(t.getAttribute("aria-controls") ?? "");
+      expect(panel).toHaveAttribute("role", "tabpanel");
+      expect(panel).toHaveAttribute("aria-labelledby", t.id);
+      expect(panel).toHaveAttribute("tabindex", "0");
