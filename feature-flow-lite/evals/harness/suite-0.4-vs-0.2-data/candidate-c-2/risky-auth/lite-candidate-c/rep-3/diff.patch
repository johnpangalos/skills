+class _SlowReadRecord(dict):
+    """Token record whose 'used' read is slow, so an unlocked check-then-write overlaps."""
+
+    def __getitem__(self, key):
+        value = super().__getitem__(key)
+        if key == "used":
+            time.sleep(0.001)
+        return value
 
 
