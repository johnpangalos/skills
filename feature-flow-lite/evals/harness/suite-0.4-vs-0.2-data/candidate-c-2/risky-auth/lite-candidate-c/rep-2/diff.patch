+class ResetTokenConcurrencyTest(unittest.TestCase):
+    THREADS = 8
+    ROUNDS = 100
+
+    def test_concurrent_redeem_has_one_winner(self):
+        for _ in range(self.ROUNDS):
+            token = issue_reset_token("ada", now=ISSUED)
+            barrier = threading.Barrier(self.THREADS)
+            outcomes = []
+
+            def worker():
+                barrier.wait()
+                try:
+                    redeem_reset_token(token, now=ISSUED)
+                    outcomes.append("ok")
+                except Exception as exc:
+                    outcomes.append(type(exc).__name__)
+
+            threads = [threading.Thread(target=worker) for _ in range(self.THREADS)]
+            for thread in threads:
+                thread.start()
+            for thread in threads:
+                thread.join()
+            self.assertEqual(
+                collections.Counter(outcomes),
+                {"ok": 1, "TokenUsed": self.THREADS - 1},
+            )
