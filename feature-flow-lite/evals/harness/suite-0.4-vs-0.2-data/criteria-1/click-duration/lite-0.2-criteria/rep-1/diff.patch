+from datetime import timedelta
+
+import pytest
+
+import click
+from click.testing import CliRunner
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        ("90s", timedelta(seconds=90)),
+        ("5m", timedelta(minutes=5)),
+        ("1h30m", timedelta(minutes=90)),
+        ("2d4h", timedelta(hours=52)),
+        ("1m500ms", timedelta(milliseconds=60500)),
+        ("5ms", timedelta(milliseconds=5)),
+        ("500ms", timedelta(milliseconds=500)),
+        ("1d", timedelta(days=1)),
+        ("90", timedelta(seconds=90)),
+        ("0", timedelta(0)),
+        ("0s", timedelta(0)),
+        ("05m", timedelta(minutes=5)),
+    ],
+)
+def test_valid(value, expect):
+    assert click.Duration().convert(value, None, None) == expect
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "",
+        "   ",
+        "1h 30m",
+        " 5s",
+        "30m1h",
+        "1h1h",
+        "1m1m",
+        "1.5h",
+        "1e3",
+        "5x",
+        "h",
+        "5H",
+        "1h30",
+        "+5s",
+        "-",
+        "--5s",
+        "-0",
+        "-0s",
+        "٥s",
+        "５s",
+        "1_000s",
+    ],
+)
+def test_invalid(value):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert exc_info.value.message == f"{value!r} is not a valid duration."
+
+
+@pytest.mark.parametrize(
+    ("value", "message"),
+    [
+        ("-5s", "-5s must not be negative."),
+        ("-90", "-1m30s must not be negative."),
+        ("-1h30m", "-1h30m must not be negative."),
+    ],
+)
+def test_negative_string(value, message):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert exc_info.value.message == message
+
+
+def test_negative_timedelta():
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(timedelta(seconds=-5), None, None)
+
+    assert exc_info.value.message == "-5s must not be negative."
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "999999999999d",
+        "99999999999999999999s",
+        "999999999d24h",
+        "-999999999d24h",
+        pytest.param("9" * 5000, id="5000-digits"),
+        pytest.param("-" + "9" * 5000, id="negative-5000-digits"),
+    ],
+)
+def test_overflow(value):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert exc_info.value.message == f"{value!r} is not a valid duration."
+
+
+@pytest.mark.parametrize(
+    ("type", "value", "expect"),
+    [
+        (
+            click.Duration(timedelta(seconds=1), timedelta(hours=1)),
+            "1s",
+            timedelta(seconds=1),
+        ),
+        (
+            click.Duration(timedelta(seconds=1), timedelta(hours=1)),
+            "1h",
+            timedelta(hours=1),
+        ),
+        (
+            click.Duration(timedelta(seconds=5), timedelta(seconds=5)),
+            "5s",
+            timedelta(seconds=5),
+        ),
+        (click.Duration(min=timedelta(seconds=1)), "500ms", None),
+        (click.Duration(min=timedelta(seconds=1)), "1s", timedelta(seconds=1)),
+        (click.Duration(max=timedelta(hours=1)), "1h", timedelta(hours=1)),
+        (click.Duration(max=timedelta(hours=1)), "1h1ms", None),
+        (click.Duration(timedelta(seconds=1), timedelta(hours=1)), "2h", None),
+        (click.Duration(timedelta(seconds=5), timedelta(seconds=5)), "6s", None),
+    ],
+)
+def test_bounds(type, value, expect):
+    if expect is not None:
+        assert type.convert(value, None, None) == expect
