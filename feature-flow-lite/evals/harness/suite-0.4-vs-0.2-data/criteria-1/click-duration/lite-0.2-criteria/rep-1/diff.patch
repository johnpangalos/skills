+_DURATION_UNITS = (
+    ("d", 86_400_000),
+    ("h", 3_600_000),
+    ("m", 60_000),
+    ("s", 1_000),
+    ("ms", 1),
+)
+_DURATION_RE = re.compile(
+    r"(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?(?:([0-9]+)ms)?"
+)
+
+
+def _parse_duration(value: str) -> timedelta | None:
+    """Parse a string in :class:`Duration` syntax, or return ``None`` if it is
+    not valid. Raises ``OverflowError`` or ``ValueError`` if the number is too
+    large.
+    """
+    sign = 1
+
+    # A single leading minus sign makes the duration negative.
+    if value.startswith("-"):
+        sign = -1
+        value = value[1:]
+
+    # A bare number of ASCII digits is a count of seconds.
+    if value.isascii() and value.isdigit():
+        value += "s"
+
+    match = _DURATION_RE.fullmatch(value)
+
+    if match is None or not any(match.groups()):
+        return None
+
+    milliseconds = sum(
+        int(part) * size
+        for part, (_unit, size) in zip(match.groups(), _DURATION_UNITS, strict=True)
+        if part is not None
+    )
+
+    # A sign is only allowed so a negative value gets a clear error; "-0s" is
+    # still a sign on a value that cannot be negative, so it is malformed.
+    if sign == -1 and milliseconds == 0:
+        return None
+
+    return timedelta(milliseconds=sign * milliseconds)
+
+
+def _format_duration(value: timedelta) -> str:
+    """Render a timedelta in :class:`Duration` syntax, such as ``1h30m``. A
+    value that is not a whole number of milliseconds is rendered with ``str()``.
+    """
+    if value.microseconds % 1000:
+        return str(value)
+
+    remaining = value // timedelta(milliseconds=1)
+
+    if remaining == 0:
+        return "0s"
+
+    parts = []
+
+    for unit, size in _DURATION_UNITS:
+        count, remaining = divmod(remaining, size)
+
+        if count:
+            parts.append(f"{count}{unit}")
+
+    return "".join(parts)
+
+
+class DurationInfoDict(ParamTypeInfoDict):
+    min: timedelta | None
+    max: timedelta | None
+
+
+class Duration(ParamType[timedelta]):
+    """Convert a duration string such as ``90s``, ``1h30m`` or ``1m500ms`` to a
+    :class:`datetime.timedelta`.
+
+    A value is either a bare number of seconds, such as ``90``, or one or more
+    ``<number><unit>`` parts, where the unit is ``d``, ``h``, ``m``, ``s`` or
+    ``ms``. The parts must go from the largest unit to the smallest, and each
+    unit may appear at most once. Spaces, a leading ``+``, fractions and
+    negative values are rejected. A ``timedelta``, or an ``int`` number of
+    seconds, is also accepted, such as for a default value.
+
+    If ``min`` or ``max`` is given, values outside that inclusive bound fail.
+    If it is not given, that side is unbounded.
+
+    :param min: The smallest accepted duration, inclusive.
+    :param max: The largest accepted duration, inclusive.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "duration"
+
+    min: timedelta | None
+    max: timedelta | None
+
+    def __init__(
+        self, min: timedelta | None = None, max: timedelta | None = None
+    ) -> None:
+        self.min = min
+        self.max = max
+
+    def to_info_dict(self) -> DurationInfoDict:
+        return {"min": self.min, "max": self.max, **super().to_info_dict()}
+
+    def _describe_range(self) -> str:
+        """Describe the range for use in help text. An unbounded range is an
+        empty string.
+        """
+        min = self.min
+        max = self.max
+
+        if min is None:
+            return "" if max is None else f"x<={_format_duration(max)}"
+
+        if max is None:
+            return f"x>={_format_duration(min)}"
+
+        return f"{_format_duration(min)}<=x<={_format_duration(max)}"
+
+    def _to_timedelta(self, value: t.Any) -> timedelta | None:
+        if isinstance(value, timedelta):
+            return value
+
+        if isinstance(value, bool) or not isinstance(value, (str, int)):
+            return None
+
+        try:
+            return _parse_duration(str(value))
+        except (OverflowError, ValueError):
+            return None
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        rv = self._to_timedelta(value)
+
+        if rv is None:
+            if isinstance(value, str):
+                message = _("{value!r} is not a valid duration.").format(value=value)
+            else:
+                message = _("{type} object is not a valid duration.").format(
+                    type=type(value).__name__
+                )
+
+            self.fail(message, param, ctx)
+
+        if rv < timedelta(0):
+            self.fail(
+                _("{value} must not be negative.").format(
+                    value="-" + _format_duration(-rv)
+                ),
+                param,
+                ctx,
+            )
+
+        min = self.min
+        max = self.max
+
+        if (min is not None and rv < min) or (max is not None and rv > max):
+            self.fail(
+                _("{value} is not in the range {range}.").format(
+                    value=_format_duration(rv), range=self._describe_range()
+                ),
+                param,
+                ctx,
+            )
+
+        return rv
+
+    def __repr__(self) -> str:
+        range_str = self._describe_range()
+        return f"<Duration {range_str}>" if range_str else "DURATION"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
