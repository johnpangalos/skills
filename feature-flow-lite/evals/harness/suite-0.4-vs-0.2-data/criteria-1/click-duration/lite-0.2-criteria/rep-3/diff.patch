+class DurationInfoDict(ParamTypeInfoDict):
+    min: timedelta | None
+    max: timedelta | None
+
+
+# Each unit is optional, but the parts that are present must appear in this
+# order, so "1s1m" does not match. The lookahead keeps "m" from matching the
+# start of "ms", and requires a digit so the empty string does not match. A
+# bare integer is a number of seconds.
+_DURATION_RE = re.compile(
+    r"(?=[0-9])(?:(?P<days>[0-9]+)d)?(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m(?!s))?(?:(?P<seconds>[0-9]+)s)?"
+    r"(?:(?P<milliseconds>[0-9]+)ms)?|(?P<bare>[0-9]+)"
+)
+
+
+def _format_duration(value: timedelta) -> str:
+    """Render a timedelta in the syntax that :class:`Duration` accepts, such as
+    ``1h30m``. Falls back to ``str(value)`` when that syntax cannot express it.
+    """
+    microseconds = (value.days * 86400 + value.seconds) * 1_000_000
+    microseconds += value.microseconds
+
+    if microseconds < 0 or microseconds % 1000:
+        return str(value)
+
+    remaining = microseconds // 1000
+    parts = []
+
+    for unit, size in (
+        ("d", 86_400_000),
+        ("h", 3_600_000),
+        ("m", 60_000),
+        ("s", 1_000),
+        ("ms", 1),
+    ):
+        count, remaining = divmod(remaining, size)
+
+        if count:
+            parts.append(f"{count}{unit}")
+
+    return "".join(parts) or "0s"
+
+
+class Duration(ParamType[timedelta]):
+    """Convert a duration string such as ``1h30m`` to a
+    :class:`datetime.timedelta`.
+
+    A value is one or more integer parts, each followed by a unit: ``d``,
+    ``h``, ``m``, ``s``, or ``ms``. The units must appear in that order, each
+    at most once, with no separators. A bare integer is a number of seconds.
+    Negative values are rejected.
+
+    If ``min`` or ``max`` are passed, values outside the inclusive range are
+    rejected, like :class:`IntRange`.
+
+    :param min: The smallest accepted duration, inclusive.
+    :param max: The largest accepted duration, inclusive.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "duration"
+
+    min: timedelta | None
+    max: timedelta | None
+
+    def __init__(
+        self, min: timedelta | None = None, max: timedelta | None = None
+    ) -> None:
+        self.min = min
+        self.max = max
+
+    def to_info_dict(self) -> DurationInfoDict:
+        return {"min": self.min, "max": self.max, **super().to_info_dict()}
+
+    def _parse(self, text: str) -> timedelta | None:
+        """Return the duration written as ``text``, or ``None`` if it is
+        malformed or too large to represent.
+        """
+        match = _DURATION_RE.fullmatch(text)
+
+        if match is None:
+            return None
+
+        try:
+            # Leading zeros are stripped first so that a long run of zeros does
+            # not hit Python's int digit limit.
+            if match["bare"] is not None:
+                return timedelta(seconds=int(match["bare"].lstrip("0") or "0"))
+
+            parts = {
+                name: int(digits.lstrip("0") or "0")
+                for name, digits in match.groupdict().items()
+                if digits
+            }
+            return timedelta(**parts)
+        except (OverflowError, ValueError):
+            return None
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        rv = value if isinstance(value, timedelta) else self._parse(str(value))
+
+        if rv is None or rv < timedelta(0):
+            self.fail(
+                _("{value!r} is not a valid duration.").format(value=value),
+                param,
+                ctx,
+            )
+
+        if (self.min is not None and rv < self.min) or (
+            self.max is not None and rv > self.max
+        ):
+            self.fail(
+                _("{value} is not in the range {range}.").format(
+                    value=_format_duration(rv), range=self._describe_range()
+                ),
+                param,
+                ctx,
+            )
+
+        return rv
+
+    def _describe_range(self) -> str:
+        """Describe the range for use in help text, or return an empty
+        string when neither bound is set.
+        """
+        if self.min is not None and self.max is not None:
+            return f"{_format_duration(self.min)}<=x<={_format_duration(self.max)}"
+
+        if self.min is not None:
+            return f"x>={_format_duration(self.min)}"
+
+        if self.max is not None:
+            return f"x<={_format_duration(self.max)}"
+
+        return ""
+
+    def __repr__(self) -> str:
+        range_str = self._describe_range()
+        return f"<Duration {range_str}>" if range_str else "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
