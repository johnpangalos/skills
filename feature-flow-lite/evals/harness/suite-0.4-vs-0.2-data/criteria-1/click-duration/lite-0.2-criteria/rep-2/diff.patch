+class DurationInfoDict(ParamTypeInfoDict):
+    min: timedelta | None
+    max: timedelta | None
+
+
+_DURATION_SECONDS_RE = re.compile(r"-?[0-9]+")
+# The "m" part must not be followed by "s", so "1ms" is never read as one minute.
+_DURATION_PARTS_RE = re.compile(
+    r"-?(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m(?!s))?(?:([0-9]+)s)?(?:([0-9]+)ms)?"
+)
+
+
+def _parse_duration(text: str) -> timedelta:
+    """Parse a whole number of seconds, or parts such as ``1h30m``.
+
+    :raises ValueError: If the text is not in that form, or a number in it is
+        too large to convert.
+    """
+    if _DURATION_SECONDS_RE.fullmatch(text):
+        return timedelta(seconds=int(text))
+
+    match = _DURATION_PARTS_RE.fullmatch(text)
+
+    if match is None or not any(match.groups()):
+        raise ValueError(text)
+
+    days, hours, minutes, seconds, milliseconds = (
+        int(group) if group else 0 for group in match.groups()
+    )
+    duration = timedelta(
+        days=days,
+        hours=hours,
+        minutes=minutes,
+        seconds=seconds,
+        milliseconds=milliseconds,
+    )
+    return -duration if text.startswith("-") else duration
+
+
+def _format_duration(duration: timedelta) -> str:
+    """Render a ``timedelta`` in the syntax that :class:`Duration` accepts.
+
+    A sub-millisecond remainder is rendered as a decimal fraction of
+    milliseconds, such as ``1.5ms``, so the message is exact.
+    """
+    sign = "-" if duration < timedelta(0) else ""
+    microseconds = abs(duration) // timedelta(microseconds=1)
+    days, rest = divmod(microseconds, 86_400_000_000)
+    hours, rest = divmod(rest, 3_600_000_000)
+    minutes, rest = divmod(rest, 60_000_000)
+    seconds, rest = divmod(rest, 1_000_000)
+    milliseconds, sub_millisecond = divmod(rest, 1000)
+    parts = [
+        f"{amount}{unit}"
+        for amount, unit in zip(
+            (days, hours, minutes, seconds), ("d", "h", "m", "s"), strict=True
+        )
+        if amount
+    ]
+    if sub_millisecond:
+        fraction = f"{milliseconds}.{sub_millisecond:03d}".rstrip("0")
+        parts.append(f"{fraction}ms")
+    elif milliseconds:
+        parts.append(f"{milliseconds}ms")
+    return sign + ("".join(parts) or "0s")
+
+
+class Duration(ParamType[timedelta]):
+    """Convert a duration string such as ``1h30m`` to a
+    :class:`datetime.timedelta`. See :ref:`durations`.
+
+    A value is either a whole number of seconds, such as ``90``, or one or
+    more parts, each a whole number followed by a unit. The units are ``d``,
+    ``h``, ``m``, ``s``, and ``ms``. They must appear in that order, each at
+    most once, with no separators. A part may be larger than the next unit,
+    so ``90s`` and ``1500ms`` are valid. Surrounding whitespace is ignored.
+    Negative durations are rejected.
+
+    A ``timedelta`` is accepted as is, and an ``int`` is read as a number of
+    seconds.
+
+    If ``min`` or ``max`` are not passed, any value is accepted in that
+    direction. Both boundaries are included in the range.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    min: timedelta | None
+    max: timedelta | None
+
+    def __init__(
+        self, min: timedelta | None = None, max: timedelta | None = None
+    ) -> None:
+        self.min = min
+        self.max = max
+
+    def to_info_dict(self) -> DurationInfoDict:
+        return {"min": self.min, "max": self.max, **super().to_info_dict()}
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        try:
+            if isinstance(value, timedelta):
+                rv = value
+            elif isinstance(value, int) and not isinstance(value, bool):
+                rv = timedelta(seconds=value)
+            elif isinstance(value, str):
+                rv = _parse_duration(value.strip())
+            else:
+                raise TypeError(type(value))
+        except (TypeError, ValueError, OverflowError):
+            self.fail(
+                _(
+                    "{value!r} is not a valid duration. Use a whole number of"
+                    " seconds or parts with units d, h, m, s, ms, such as 1h30m."
+                ).format(value=value),
+                param,
+                ctx,
+            )
+
+        if rv < timedelta(0):
+            self.fail(
+                _("Durations can't be negative: {value}.").format(
+                    value=_format_duration(rv)
+                ),
+                param,
+                ctx,
+            )
+
+        if (self.min is not None and rv < self.min) or (
+            self.max is not None and rv > self.max
+        ):
+            self.fail(
+                _("{value} is not in the range {range}.").format(
+                    value=_format_duration(rv), range=self._describe_range()
+                ),
+                param,
+                ctx,
+            )
+
+        return rv
+
+    def _describe_range(self) -> str:
+        """Describe the range for use in help text. Returns an empty string
+        if neither bound is set.
+        """
+        if self.min is None:
+            return "" if self.max is None else f"x<={_format_duration(self.max)}"
+
+        if self.max is None:
+            return f"x>={_format_duration(self.min)}"
+
+        return f"{_format_duration(self.min)}<=x<={_format_duration(self.max)}"
+
+    def __repr__(self) -> str:
+        description = self._describe_range()
+        return f"<Duration {description}>" if description else "<Duration>"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
