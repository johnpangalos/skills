+func TestETagPanicWritesNothing(t *testing.T) {
+	rec := httptest.NewRecorder()
+	defer func() {
+		if p := recover(); p != "boom" {
+			t.Fatalf("expecting panic 'boom' but got %v", p)
+		}
+		assertEqual(t, rec.Body.String(), "")
+		assertEqual(t, rec.Header().Get("ETag"), "")
+	}()
+	ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("partial"))
+		panic("boom")
+	})).ServeHTTP(rec, httptest.NewRequest("GET", "/", nil))
+}
