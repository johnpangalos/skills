+func TestETagHijackAfterWriteHeaderReplaysStatus(t *testing.T) {
+	ts := httptest.NewServer(ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusCreated)
+		conn, rw, err := http.NewResponseController(w).Hijack()
+		assertNoError(t, err)
+		defer conn.Close()
+		rw.WriteString("RAW")
+		rw.Flush()
+	})))
+	defer ts.Close()
+
+	conn, err := net.Dial("tcp", ts.Listener.Addr().String())
+	assertNoError(t, err)
+	defer conn.Close()
+	_, err = conn.Write([]byte("GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n"))
+	assertNoError(t, err)
+	raw, err := io.ReadAll(conn)
+	assertNoError(t, err)
+	if !strings.HasPrefix(string(raw), "HTTP/1.1 201") {
+		t.Errorf("response %q does not start with the 201 status line", raw)
+	}
+	if !strings.Contains(string(raw), "RAW") {
+		t.Errorf("response %q does not contain the raw bytes", raw)
+	}
+}
