+func TestETagInformationalResponses(t *testing.T) {
+	tests := []struct {
+		name   string
+		status int
+		body   string
+	}{
+		{"computed 200", http.StatusOK, "ok"},
+		{"final 404", http.StatusNotFound, "nf"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			ts := httptest.NewServer(ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Link", "</style.css>; rel=preload")
+				w.WriteHeader(http.StatusEarlyHints)
+				w.WriteHeader(tc.status)
+				w.Write([]byte(tc.body))
+			})))
+			defer ts.Close()
+
+			var informational int
+			var link string
+			trace := &httptrace.ClientTrace{
+				Got1xxResponse: func(code int, h textproto.MIMEHeader) error {
+					informational, link = code, h.Get("Link")
+					return nil
+				},
+			}
+			req, err := http.NewRequest("GET", ts.URL, nil)
+			assertNoError(t, err)
+			req = req.WithContext(httptrace.WithClientTrace(context.Background(), trace))
+			resp, err := http.DefaultClient.Do(req)
+			assertNoError(t, err)
+			defer resp.Body.Close()
+
+			assertEqual(t, informational, http.StatusEarlyHints)
+			assertEqual(t, link, "</style.css>; rel=preload")
+			assertEqual(t, resp.StatusCode, tc.status)
+			if tc.status == http.StatusOK {
+				assertEqual(t, resp.Header.Get("ETag"), etagOf([]byte(tc.body)))
+			} else {
+				assertEqual(t, resp.Header.Get("ETag"), "")
+			}
+		})
+	}
+}
