+func TestETagPanicWritesNothing(t *testing.T) {
+	rec := httptest.NewRecorder()
+	func() {
+		defer func() {
+			if p := recover(); p == nil {
+				t.Fatal("expected the handler panic to propagate")
+			}
+		}()
+		ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Write([]byte("partial"))
+			panic("boom")
+		})).ServeHTTP(rec, etagRequest(http.MethodGet))
+	}()
+
+	assertEqual(t, rec.Body.Len(), 0)
+	assertEqual(t, rec.Result().Header.Get("ETag"), "")
+
+	// An outer Recoverer must still be able to send its 500.
+	rec.WriteHeader(http.StatusInternalServerError)
+	assertEqual(t, rec.Code, http.StatusInternalServerError)
+}
