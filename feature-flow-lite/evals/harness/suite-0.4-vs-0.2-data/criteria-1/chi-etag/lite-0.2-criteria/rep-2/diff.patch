+func TestETagFlushStreamsBeforeHandlerReturns(t *testing.T) {
+	release := make(chan struct{})
+	ts := httptest.NewServer(ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		fmt.Fprint(w, "data: 1\n\n")
+		http.NewResponseController(w).Flush()
+		<-release
+		fmt.Fprint(w, "data: 2\n\n")
+	})))
+	defer ts.Close()
+
+	res, err := http.Get(ts.URL)
+	assertNoError(t, err)
+	defer res.Body.Close()
+
+	br := bufio.NewReader(res.Body)
+	lines := make(chan string, 1)
+	go func() {
+		line, _ := br.ReadString('\n')
+		lines <- line
+	}()
+	select {
+	case line := <-lines:
+		assertEqual(t, line, "data: 1\n")
+	case <-time.After(5 * time.Second):
+		close(release)
+		t.Fatal("first event was not streamed before the handler returned")
+	}
+
+	close(release)
+	rest, err := io.ReadAll(br)
+	assertNoError(t, err)
+	assertEqual(t, string(rest), "\ndata: 2\n\n")
+}
