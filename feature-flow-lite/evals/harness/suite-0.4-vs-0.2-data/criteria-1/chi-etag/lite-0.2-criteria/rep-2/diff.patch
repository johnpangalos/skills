+func TestETagHijack(t *testing.T) {
+	t.Run("unavailable on the writer", func(t *testing.T) {
+		var err error
+		ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			_, _, err = w.(http.Hijacker).Hijack()
+		})).ServeHTTP(httptest.NewRecorder(), etagRequest(http.MethodGet))
+
+		assertEqual(t, fmt.Sprint(err), "chi/middleware: http.Hijacker is unavailable on the writer")
+	})
+
+	t.Run("hands over the connection on a 200 GET", func(t *testing.T) {
+		ts := httptest.NewServer(ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			conn, _, err := w.(http.Hijacker).Hijack()
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			conn.Close()
+		})))
+		defer ts.Close()
+
+		res, err := http.Get(ts.URL)
+		if err == nil {
+			res.Body.Close()
+			t.Fatal("expected no HTTP response after hijack")
+		}
+	})
+}
