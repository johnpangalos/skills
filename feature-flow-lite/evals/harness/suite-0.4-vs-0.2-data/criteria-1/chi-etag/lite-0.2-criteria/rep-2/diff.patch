+func TestETagPushAndUnwrap(t *testing.T) {
+	rec := httptest.NewRecorder()
+	var pushErr error
+	var unwrapped bool
+	ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		pushErr = w.(http.Pusher).Push("/x", nil)
+		unwrapped = w.(interface{ Unwrap() http.ResponseWriter }).Unwrap() == rec
+	})).ServeHTTP(rec, etagRequest(http.MethodGet))
+
+	assertEqual(t, unwrapped, true)
+	assertEqual(t, fmt.Sprint(pushErr), "chi/middleware: http.Pusher is unavailable on the writer")
+}
