+func TestETagRecovererWrites500(t *testing.T) {
+	r := chi.NewRouter()
+	r.Use(Recoverer)
+	r.Use(ETag)
+	r.Get("/", func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("partial"))
+		panic("boom")
+	})
+
+	rec := httptest.NewRecorder()
+	r.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/", http.NoBody))
+
+	assertEqual(t, rec.Code, http.StatusInternalServerError)
+	if strings.Contains(rec.Body.String(), "partial") {
+		t.Fatal("buffered body leaked after a panic")
+	}
+}
