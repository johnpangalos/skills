+func TestETagFlush(t *testing.T) {
+	t.Run("buffered flush does not reach the client", func(t *testing.T) {
+		rec := etagServe(http.MethodGet, func(w http.ResponseWriter, r *http.Request) {
+			w.Write([]byte("a"))
+			http.NewResponseController(w).Flush()
+			w.Write([]byte("b"))
+		})
+
+		assertEqual(t, rec.Flushed, false)
+		assertEqual(t, rec.Header().Get("ETag"), etagTag("ab"))
+		assertEqual(t, rec.Body.String(), "ab")
+	})
+
+	t.Run("flush passes through after a non-200 status", func(t *testing.T) {
+		rec := etagServe(http.MethodGet, func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(http.StatusNotFound)
+			w.Write([]byte("x"))
+			http.NewResponseController(w).Flush()
+		})
+
+		assertEqual(t, rec.Flushed, true)
+		assertEqual(t, rec.Code, http.StatusNotFound)
+	})
+}
