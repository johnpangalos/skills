+func TestETagHijackedConnectionIsNotWrittenTo(t *testing.T) {
+	const raw = "HTTP/1.1 101 Switching Protocols\r\n\r\n"
+	var logBuf bytes.Buffer
+	finished := make(chan struct{})
+
+	handler := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		conn, _, err := w.(http.Hijacker).Hijack()
+		assertNoError(t, err)
+		_, err = conn.Write([]byte(raw))
+		assertNoError(t, err)
+		conn.Close()
+	}))
+	ts := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		handler.ServeHTTP(w, r)
+		close(finished)
+	}))
+	ts.Config.ErrorLog = log.New(&logBuf, "", 0)
+	ts.Start()
+	defer ts.Close()
+
+	conn, err := net.Dial("tcp", ts.Listener.Addr().String())
+	assertNoError(t, err)
+	defer conn.Close()
+	_, err = conn.Write([]byte("GET / HTTP/1.1\r\nHost: example.com\r\n\r\n"))
+	assertNoError(t, err)
+	got, err := io.ReadAll(conn)
+	assertNoError(t, err)
+
+	// finish runs after the handler returns, so wait for it before reading the log.
+	<-finished
+	assertEqual(t, string(got), raw)
+	if strings.Contains(logBuf.String(), "hijacked connection") {
+		t.Fatalf("unexpected log after hijack: %q", logBuf.String())
+	}
+}
