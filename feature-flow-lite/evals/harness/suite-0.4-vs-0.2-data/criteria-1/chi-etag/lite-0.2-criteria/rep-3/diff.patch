+func TestETagWriterCapabilities(t *testing.T) {
+	t.Run("Hijack and Push report unsupported writers", func(t *testing.T) {
+		var hijackErr, pushErr error
+		rec := httptest.NewRecorder()
+		req := httptest.NewRequest(http.MethodGet, "/", http.NoBody)
+		ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			_, _, hijackErr = w.(http.Hijacker).Hijack()
+			pushErr = w.(http.Pusher).Push("/style.css", nil)
+		})).ServeHTTP(rec, req)
+
+		assertEqual(t, hijackErr.Error(), "chi/middleware: http.Hijacker is unavailable on the writer")
+		assertEqual(t, pushErr.Error(), "chi/middleware: http.Pusher is unavailable on the writer")
+	})
+
+	t.Run("Unwrap returns the underlying writer", func(t *testing.T) {
+		rec := httptest.NewRecorder()
+		req := httptest.NewRequest(http.MethodGet, "/", http.NoBody)
+		var unwrapped http.ResponseWriter
+		ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			unwrapped = w.(interface{ Unwrap() http.ResponseWriter }).Unwrap()
+		})).ServeHTTP(rec, req)
+
+		if unwrapped != http.ResponseWriter(rec) {
+			t.Fatal("Unwrap did not return the underlying writer")
+		}
+	})
+}
