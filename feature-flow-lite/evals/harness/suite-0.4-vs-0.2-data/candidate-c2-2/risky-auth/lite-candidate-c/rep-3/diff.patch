+class _SlowCheckRecord(dict):
+    """Pauses while a reader sees the token unused, so an unlocked check-then-write interleaves."""
+
+    def __getitem__(self, key):
+        value = dict.__getitem__(self, key)
+        if key == "used" and value is False:
+            time.sleep(0.005)
+        return value
 
 
