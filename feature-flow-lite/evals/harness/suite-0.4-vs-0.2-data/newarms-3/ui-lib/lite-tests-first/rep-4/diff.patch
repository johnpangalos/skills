+      <Dialog open={false} title="Confirm" onOpenChange={() => {}}>
+        <p>hidden body</p>
+      </Dialog>,
+    );
+    expect(screen.queryByRole("dialog")).toBeNull();
+    expect(screen.queryByText("hidden body")).toBeNull();
+  });
