+
+type SampleProps = Partial<TabsProps> & { values?: string[]; disabled?: string[] };
+
+function SampleTabs({ values = ["one", "two", "three"], disabled = [], ...props }: SampleProps) {
+  return (
+    <Tabs {...props}>
+      <TabList aria-label="Sections">
+        {values.map((value) => (
+          <Tab key={value} value={value} disabled={disabled.includes(value)}>
+            {value}
+          </Tab>
+        ))}
+      </TabList>
+      {values.map((value) => (
+        <TabPanel key={value} value={value}>
+          panel {value}
+        </TabPanel>
+      ))}
+    </Tabs>
+  );
+}
+
+const tab = (name: string) => screen.getByRole("tab", { name });
+
+function panelOf(tabEl: HTMLElement): HTMLElement {
+  const panel = document.getElementById(tabEl.getAttribute("aria-controls") ?? "");
+  if (!panel) throw new Error(`no panel for ${tabEl.textContent}`);
+  return panel;
+}
