+      <button>Ok</button>
+    </Dialog>,
+  );
+  return { onOpenChange };
+}
+
+// The backdrop is the portal root element; the role=dialog element is its child.
+const backdropOf = (dialog: HTMLElement) => dialog.parentElement as HTMLElement;
+
+function DialogHarness({ open }: { open: boolean }) {
+  return (
+    <>
+      <button>Trigger</button>
