+function getBackdrop(): HTMLElement {
+  const backdrop = document.querySelector<HTMLElement>("[data-backdrop]");
+  if (!backdrop) throw new Error("backdrop not rendered");
+  return backdrop;
+}
+
+function Stateful({ children, initialOpen = false }: { children?: ReactNode; initialOpen?: boolean }) {
+  const [open, setOpen] = useState(initialOpen);
+  return (
+    <>
+      <button onClick={() => setOpen(true)}>Open</button>
+      <Dialog open={open} onOpenChange={setOpen} title="Confirm" description="Are you sure?">
+        {children ?? <button>Yes</button>}
+      </Dialog>
+    </>
+  );
+}
+
+function Host({ open }: { open: boolean }) {
+  return (
+    <>
+      <button>Trigger</button>
+      {open && (
+        <Dialog open onOpenChange={() => {}} title="Confirm">
+          <button>Yes</button>
+        </Dialog>
+      )}
+    </>
+  );
+}
+
+describe("Dialog", () => {
