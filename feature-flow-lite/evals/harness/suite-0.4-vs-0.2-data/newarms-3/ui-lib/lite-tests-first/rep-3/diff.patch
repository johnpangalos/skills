+import { Combobox, Dialog } from "../src/index";
+
+function Host({
+  description,
+  children,
+  onOpenChange,
+}: {
+  description?: ReactNode;
+  children?: ReactNode;
+  onOpenChange?: (open: boolean) => void;
+}) {
+  const [open, setOpen] = useState(false);
+  return (
+    <>
+      <button type="button" onClick={() => setOpen(true)}>Open</button>
+      <Dialog
+        open={open}
+        onOpenChange={(next) => {
+          onOpenChange?.(next);
+          setOpen(next);
+        }}
+        title="Confirm"
+        description={description}
+      >
+        {children ?? (
+          <>
+            <button type="button">Cancel</button>
+            <button type="button">OK</button>
+          </>
+        )}
+      </Dialog>
+    </>
+  );
+}
+
+function Plain({ open }: { open: boolean }) {
+  return (
+    <>
+      <button type="button">Trigger</button>
+      <Dialog open={open} onOpenChange={() => {}} title="Confirm">
+        <button type="button">Cancel</button>
+      </Dialog>
+    </>
+  );
+}
+
+function Conditional({ show }: { show: boolean }) {
+  return (
+    <>
+      <button type="button">Trigger</button>
+      {show && (
+        <Dialog open onOpenChange={() => {}} title="Confirm">
+          <button type="button">Cancel</button>
+        </Dialog>
+      )}
+    </>
+  );
+}
+
+function FruitField() {
+  const [value, setValue] = useState<string | null>(null);
+  return (
+    <Combobox
+      label="Fruit"
+      options={[{ value: "apple", label: "Apple" }]}
+      value={value}
+      onChange={setValue}
+    />
+  );
+}
+
+function Nested({ onOuterChange = () => {} }: { onOuterChange?: (open: boolean) => void }) {
+  const [outerOpen, setOuterOpen] = useState(false);
+  const [innerOpen, setInnerOpen] = useState(false);
+  return (
+    <>
+      <button type="button" onClick={() => setOuterOpen(true)}>Open outer</button>
+      <Dialog
+        open={outerOpen}
+        onOpenChange={(next) => {
+          onOuterChange(next);
+          setOuterOpen(next);
+        }}
+        title="Outer"
+      >
+        <button type="button" onClick={() => setInnerOpen(true)}>Open inner</button>
+        <Dialog open={innerOpen} onOpenChange={setInnerOpen} title="Inner">
+          <button type="button">Inner cancel</button>
+          <button type="button">Inner OK</button>
+        </Dialog>
+      </Dialog>
+    </>
+  );
