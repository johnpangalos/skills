+
+  it("hostile: a press starting inside the dialog and ending on the backdrop does not close it", async () => {
+    const user = userEvent.setup();
+    const onOpenChange = vi.fn();
+    render(<Host onOpenChange={onOpenChange} />);
+    const dialog = await openDialog(user);
+    const heading = screen.getByRole("heading", { level: 2, name: "Confirm" });
+    await user.pointer([
+      { keys: "[MouseLeft>]", target: heading },
