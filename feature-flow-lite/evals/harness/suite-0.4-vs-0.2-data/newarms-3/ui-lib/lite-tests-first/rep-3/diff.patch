+    expect(document.activeElement).toBe(document.body);
+    rerender(<Plain open />);
+    expect(screen.getByRole("button", { name: "Cancel" })).toHaveFocus();
+    rerender(<Plain open={false} />);
+    expect(screen.queryByRole("dialog")).toBeNull();
+    expect(document.activeElement).toBe(document.body);
+    await user.keyboard("{Escape}");
+  });
+
+  it("hostile: no description means no aria-describedby attribute at all", async () => {
+    const user = userEvent.setup();
+    render(<Host />);
+    const dialog = await openDialog(user);
+    expect(dialog).not.toHaveAttribute("aria-describedby");
+  });
+
+  it("hostile: description='' renders no description paragraph and no aria-describedby", async () => {
+    const user = userEvent.setup();
+    render(<Host description="" />);
+    const dialog = await openDialog(user);
+    expect(dialog).not.toHaveAttribute("aria-describedby");
+    expect(dialog.querySelector("p")).toBeNull();
+  });
+
+  it("D5: nested dialogs - Escape closes only the inner dialog and the outer stays open", async () => {
+    const user = userEvent.setup();
+    const onOuterChange = vi.fn();
+    render(<Nested onOuterChange={onOuterChange} />);
+    await user.click(screen.getByRole("button", { name: "Open outer" }));
+    await user.click(screen.getByRole("button", { name: "Open inner" }));
+    expect(screen.getByRole("button", { name: "Inner cancel" })).toHaveFocus();
+    await user.keyboard("{Escape}");
+    expect(screen.queryByRole("dialog", { name: "Inner" })).toBeNull();
+    expect(onOuterChange).not.toHaveBeenCalled();
+    expect(screen.getByRole("dialog", { name: "Outer" })).toBeInTheDocument();
+    await user.keyboard("{Escape}");
+    expect(onOuterChange).toHaveBeenCalledWith(false);
+    expect(screen.queryByRole("dialog")).toBeNull();
+  });
+
+  it("D4: nested dialogs - Tab and Shift+Tab inside the inner dialog keep focus inside it", async () => {
+    const user = userEvent.setup();
