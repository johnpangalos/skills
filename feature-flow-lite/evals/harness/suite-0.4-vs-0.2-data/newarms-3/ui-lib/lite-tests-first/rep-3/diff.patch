@@ -0,0 +1,114 @@
+import {
+  useEffect,
+  useId,
+  useRef,
+  type ComponentPropsWithoutRef,
+  type KeyboardEvent,
+  type ReactNode,
+} from "react";
+import { createPortal } from "react-dom";
+
+export type DialogProps = Omit<ComponentPropsWithoutRef<"div">, "title" | "onKeyDown"> & {
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+  title: ReactNode;
+  description?: ReactNode;
+};
+
+const TABBABLE =
+  "a[href]:not([disabled]), button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([disabled]), [contenteditable]:not([disabled])";
+
+function tabbableIn(container: HTMLElement): HTMLElement[] {
+  return Array.from(container.querySelectorAll<HTMLElement>(TABBABLE)).filter(
+    (element) => element.tabIndex >= 0 && element.closest("[hidden]") === null,
+  );
+}
+
+function keepFocusInside(event: KeyboardEvent<HTMLDivElement>, dialog: HTMLDivElement) {
+  const items = tabbableIn(dialog);
+  if (items.length === 0) {
+    event.preventDefault();
+    dialog.focus();
+    return;
+  }
+  const first = items[0];
+  const last = items[items.length - 1];
+  const active = document.activeElement;
+  if (event.shiftKey && (active === first || active === dialog)) {
+    event.preventDefault();
+    last.focus();
+  } else if (!event.shiftKey && active === last) {
+    event.preventDefault();
+    first.focus();
+  }
+}
+
+export function Dialog({ open, ...props }: DialogProps) {
+  if (!open) return null;
+  return createPortal(<DialogBody {...props} />, document.body);
+}
+
+function DialogBody({ onOpenChange, title, description, children, ...props }: Omit<DialogProps, "open">) {
+  const titleId = useId();
+  const descriptionId = useId();
+  const dialogRef = useRef<HTMLDivElement>(null);
+  const pressedOnBackdrop = useRef(false);
+  const hasDescription = description !== undefined && description !== null && description !== "";
+
+  // Mounted only while open: focus moves in on mount and returns on unmount.
+  useEffect(() => {
+    const previous = document.activeElement as HTMLElement | null;
+    const dialog = dialogRef.current;
+    if (dialog === null) return;
+    (tabbableIn(dialog)[0] ?? dialog).focus();
+    return () => {
+      if (previous !== null && previous.isConnected) previous.focus();
+    };
+  }, []);
+
+  function handleKeyDown(event: KeyboardEvent<HTMLDivElement>) {
+    if (event.key === "Escape" && !event.defaultPrevented) {
+      // Stop here: React events bubble through portals, so an enclosing Dialog must not also close.
+      event.preventDefault();
+      event.stopPropagation();
+      onOpenChange(false);
+      return;
+    }
+    const dialog = dialogRef.current;
+    if (event.key !== "Tab" || event.defaultPrevented || dialog === null) return;
+    // Ignore Tab from a nested dialog, which is portaled outside this one's DOM.
+    if (!dialog.contains(event.target as Node)) return;
+    keepFocusInside(event, dialog);
+  }
+
+  return (
+    <>
+      <div
+        data-backdrop=""
+        aria-hidden="true"
+        onMouseDown={(event) => {
+          pressedOnBackdrop.current = event.target === event.currentTarget;
+        }}
+        onClick={(event) => {
+          if (pressedOnBackdrop.current && event.target === event.currentTarget) {
+            onOpenChange(false);
+          }
+        }}
+      />
+      <div
+        {...props}
+        ref={dialogRef}
+        role="dialog"
+        aria-modal="true"
+        aria-labelledby={titleId}
+        aria-describedby={hasDescription ? descriptionId : undefined}
+        tabIndex={-1}
+        onKeyDown={handleKeyDown}
+      >
+        <h2 id={titleId}>{title}</h2>
+        {hasDescription && <p id={descriptionId}>{description}</p>}
+        {children}
+      </div>
+    </>
+  );
+}
diff --git a/src/Tabs.tsx b/src/Tabs.tsx
new file mode 100644
index 0000000..000e6e9
--- /dev/null
+++ b/src/Tabs.tsx
@@ -0,0 +1,188 @@
+import {
+  createContext,
+  useCallback,
+  useContext,
+  useId,
+  useLayoutEffect,
+  useMemo,
+  useRef,
+  useState,
+  type ComponentPropsWithoutRef,
+  type KeyboardEvent,
+  type ReactNode,
+} from "react";
+
+export type TabsProps = {
+  defaultValue?: string;
+  value?: string;
+  onValueChange?: (value: string) => void;
+  children?: ReactNode;
+};
+
+type TabsContextValue = {
+  baseId: string;
+  selected: string | null;
+  tabStop: string | null;
+  select: (value: string) => void;
+  syncTabs: (enabledValues: string[]) => void;
+};
+
+const TabsContext = createContext<TabsContextValue | null>(null);
+
+function useTabsContext(): TabsContextValue {
+  const context = useContext(TabsContext);
+  if (context === null) {
+    throw new Error("Tab, TabList and TabPanel must be rendered inside Tabs");
+  }
+  return context;
+}
+
+const tabId = (baseId: string, value: string) => `${baseId}-tab-${encodeURIComponent(value)}`;
+const panelId = (baseId: string, value: string) => `${baseId}-panel-${encodeURIComponent(value)}`;
+
+export function Tabs({ defaultValue, value, onValueChange, children }: TabsProps) {
+  const baseId = useId();
+  const [internalValue, setInternalValue] = useState<string | null>(defaultValue ?? null);
+  const [tabStop, setTabStop] = useState<string | null>(null);
+  const initialized = useRef(false);
+  const isControlled = value !== undefined;
+  const selected = (isControlled ? value : internalValue) ?? null;
+
+  const select = useCallback(
+    (next: string) => {
+      if (next === selected) return;
+      if (!isControlled) setInternalValue(next);
+      onValueChange?.(next);
+    },
+    [isControlled, onValueChange, selected],
+  );
+
+  const syncTabs = useCallback(
+    (enabledValues: string[]) => {
+      const selectable = selected !== null && enabledValues.includes(selected);
+      setTabStop(selectable ? selected : (enabledValues[0] ?? null));
+      // Once tabs exist: an uncontrolled Tabs must start on an enabled tab.
+      if (!initialized.current && enabledValues.length > 0) {
+        initialized.current = true;
+        if (!isControlled && !selectable) setInternalValue(enabledValues[0]);
+      }
+    },
+    [isControlled, selected],
+  );
+
+  const context = useMemo(
+    () => ({ baseId, selected, tabStop, select, syncTabs }),
+    [baseId, selected, tabStop, select, syncTabs],
+  );
+
+  return <TabsContext.Provider value={context}>{children}</TabsContext.Provider>;
+}
+
+export type TabListProps = Omit<
+  ComponentPropsWithoutRef<"div">,
+  "role" | "aria-orientation" | "aria-label" | "onKeyDown"
+> & {
+  "aria-label": string;
+};
+
+function enabledTabs(list: HTMLElement | null): HTMLButtonElement[] {
+  if (list === null) return [];
+  return Array.from(list.querySelectorAll<HTMLButtonElement>('[role="tab"]:not(:disabled)'));
+}
+
+function nextTabIndex(key: string, index: number, count: number): number | null {
+  switch (key) {
+    case "ArrowRight":
+      return (index + 1) % count;
+    case "ArrowLeft":
+      return (index - 1 + count) % count;
+    case "Home":
+      return 0;
+    case "End":
+      return count - 1;
+    default:
+      return null;
+  }
+}
+
+export function TabList({ children, ...props }: TabListProps) {
+  const { select, syncTabs } = useTabsContext();
+  const listRef = useRef<HTMLDivElement>(null);
+
+  // Runs after every render so the tab stop follows tabs that were added or removed.
+  useLayoutEffect(() => {
+    syncTabs(enabledTabs(listRef.current).map((tab) => tab.dataset.value ?? ""));
+  });
+
+  function handleKeyDown(event: KeyboardEvent<HTMLDivElement>) {
+    const tabs = enabledTabs(listRef.current);
+    const index = tabs.indexOf(event.target as HTMLButtonElement);
+    if (index === -1) return;
+    const next = nextTabIndex(event.key, index, tabs.length);
+    if (next === null) return;
+    event.preventDefault();
+    const target = tabs[next];
+    target.focus();
+    select(target.dataset.value ?? "");
+  }
+
+  return (
+    <div
+      {...props}
+      ref={listRef}
+      role="tablist"
+      aria-orientation="horizontal"
+      onKeyDown={handleKeyDown}
+    >
+      {children}
+    </div>
+  );
+}
+
+export type TabProps = Omit<ComponentPropsWithoutRef<"button">, "role" | "type" | "value"> & {
+  value: string;
+};
+
+export function Tab({ value, disabled = false, onClick, children, ...props }: TabProps) {
+  const { baseId, selected, tabStop, select } = useTabsContext();
+  return (
+    <button
+      {...props}
+      type="button"
+      role="tab"
+      id={tabId(baseId, value)}
+      data-value={value}
+      aria-selected={selected === value}
+      aria-controls={panelId(baseId, value)}
+      aria-disabled={disabled ? true : undefined}
+      disabled={disabled}
+      tabIndex={value === tabStop ? 0 : -1}
+      onClick={(event) => {
+        onClick?.(event);
+        if (!disabled) select(value);
+      }}
+    >
+      {children}
+    </button>
+  );
+}
+
+export type TabPanelProps = Omit<ComponentPropsWithoutRef<"div">, "role" | "aria-labelledby"> & {
+  value: string;
+};
+
+export function TabPanel({ value, children, ...props }: TabPanelProps) {
+  const { baseId, selected } = useTabsContext();
+  return (
+    <div
+      {...props}
+      role="tabpanel"
+      id={panelId(baseId, value)}
+      aria-labelledby={tabId(baseId, value)}
+      tabIndex={0}
+      hidden={selected !== value}
+    >
+      {children}
+    </div>
+  );
+}
