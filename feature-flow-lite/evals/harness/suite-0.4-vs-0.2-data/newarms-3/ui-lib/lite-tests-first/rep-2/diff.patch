+function Harness({ onOpenChange }: { onOpenChange: (open: boolean) => void }) {
+  const [open, setOpen] = useState(false);
+  return (
+    <>
+      <button onClick={() => setOpen(true)}>Open</button>
+      <Dialog
+        open={open}
+        onOpenChange={(next) => {
+          onOpenChange(next);
+          setOpen(next);
+        }}
+        title="Confirm"
+        description="Are you sure?"
+      >
+        <button>Ok</button>
+      </Dialog>
+    </>
+  );
+}
