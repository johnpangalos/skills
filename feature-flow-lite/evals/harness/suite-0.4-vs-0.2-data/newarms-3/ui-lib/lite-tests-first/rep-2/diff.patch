+    expect(tab("four")).toHaveFocus();
+  });
+
+  it("Home and End go to the first and last enabled tab", async () => {
+    const user = userEvent.setup();
+    render(<Example defaultValue="two" />);
+    tab("two").focus();
+    await user.keyboard("{End}");
+    expect(tab("four")).toHaveFocus();
+    await user.keyboard("{Home}");
+    expect(tab("one")).toHaveFocus();
+  });
+
+  it("prevents the default action for handled keys", () => {
+    render(<Example defaultValue="one" />);
+    const notPrevented = fireEvent.keyDown(tab("one"), { key: "ArrowRight" });
+    expect(notPrevented).toBe(false);
+  });
+
+  it("ignores other keys", () => {
+    const onValueChange = vi.fn();
+    render(<Example defaultValue="one" onValueChange={onValueChange} />);
