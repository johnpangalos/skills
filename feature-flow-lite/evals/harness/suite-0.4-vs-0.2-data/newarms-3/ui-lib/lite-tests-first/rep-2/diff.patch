+import { fireEvent, render, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { describe, expect, it, vi } from "vitest";
+import { Tab, TabList, TabPanel, Tabs, type TabsProps } from "../src/Tabs";
+
+type ExampleProps = Partial<TabsProps> & { values?: string[]; disabled?: string[] };
+
+function Example({ values = ["one", "two", "three", "four"], disabled = [], ...props }: ExampleProps) {
+  return (
+    <Tabs {...props}>
+      <TabList aria-label="Sections">
+        {values.map((value) => (
+          <Tab key={value} value={value} disabled={disabled.includes(value)}>
+            {value}
+          </Tab>
+        ))}
+      </TabList>
+      {values.map((value) => (
+        <TabPanel key={value} value={value}>
+          Panel {value}
+        </TabPanel>
+      ))}
+    </Tabs>
+  );
+}
+
+const tab = (name: string) => screen.getByRole("tab", { name });
+
+describe("Tabs ARIA structure (T1)", () => {
+  it("renders role=tablist with the given aria-label and no aria-orientation", () => {
+    render(<Example />);
+    const list = screen.getByRole("tablist", { name: "Sections" });
+    expect(list).not.toHaveAttribute("aria-orientation");
+  });
+
+  it("renders each Tab as a button type=button role=tab wired to its panel", () => {
+    render(<Example defaultValue="two" />);
+    const two = tab("two");
+    expect(two.tagName).toBe("BUTTON");
+    expect(two).toHaveAttribute("type", "button");
+    expect(two).toHaveAttribute("aria-selected", "true");
+    const panel = document.getElementById(two.getAttribute("aria-controls") ?? "");
+    expect(panel).toHaveAttribute("role", "tabpanel");
+    expect(panel).toHaveAttribute("aria-labelledby", two.id);
+  });
+
+  it("renders TabPanel with tabIndex=0, hidden only when not selected, and kept in the DOM", () => {
+    render(<Example defaultValue="one" />);
+    const one = document.getElementById(tab("one").getAttribute("aria-controls") ?? "");
+    const two = document.getElementById(tab("two").getAttribute("aria-controls") ?? "");
+    expect(one).not.toHaveAttribute("hidden");
+    expect(one).toHaveAttribute("tabindex", "0");
+    expect(two).not.toBeNull();
+    expect(two).toHaveAttribute("hidden");
+  });
+});
+
+describe("Tabs selection (T2)", () => {
+  it("selects defaultValue initially", () => {
+    render(<Example defaultValue="three" />);
+    expect(tab("three")).toHaveAttribute("aria-selected", "true");
+    expect(tab("one")).toHaveAttribute("aria-selected", "false");
+  });
+
+  it("selects the first non-disabled tab when defaultValue is omitted", () => {
+    render(<Example disabled={["one"]} />);
+    expect(tab("two")).toHaveAttribute("aria-selected", "true");
+    expect(tab("one")).toHaveAttribute("aria-selected", "false");
+  });
+
+  it("controlled value wins: a click reports onValueChange but keeps selection", async () => {
+    const user = userEvent.setup();
+    const onValueChange = vi.fn();
+    render(<Example value="two" onValueChange={onValueChange} />);
+    await user.click(tab("three"));
+    expect(onValueChange).toHaveBeenCalledExactlyOnceWith("three");
+    expect(tab("two")).toHaveAttribute("aria-selected", "true");
+    expect(tab("three")).toHaveAttribute("aria-selected", "false");
+  });
+
+  it("uncontrolled click calls onValueChange and switches the selection", async () => {
+    const user = userEvent.setup();
+    const onValueChange = vi.fn();
+    render(<Example defaultValue="one" onValueChange={onValueChange} />);
+    await user.click(tab("three"));
+    expect(onValueChange).toHaveBeenCalledExactlyOnceWith("three");
+    expect(tab("three")).toHaveAttribute("aria-selected", "true");
+    expect(screen.getByText("Panel three")).toBeVisible();
+  });
+
+  it("does not call onValueChange when re-selecting the selected tab", async () => {
+    const user = userEvent.setup();
+    const onValueChange = vi.fn();
+    render(<Example defaultValue="one" onValueChange={onValueChange} />);
+    await user.click(tab("one"));
+    expect(onValueChange).not.toHaveBeenCalled();
+  });
