+    render(<Example defaultValue="three" disabled={["one", "two", "four"]} onValueChange={onValueChange} />);
+    tab("three").focus();
+    await user.keyboard("{ArrowRight}");
+    await user.keyboard("{ArrowLeft}");
+    expect(tab("three")).toHaveFocus();
+    expect(onValueChange).not.toHaveBeenCalled();
+  });
+
+  it("with first and last tabs disabled, Home and End land on the nearest enabled tab", async () => {
+    const user = userEvent.setup();
+    render(<Example defaultValue="three" disabled={["one", "four"]} />);
