@@ -1,3 +1,143 @@
 # @acme/ui
 
-Accessible React components.
+Accessible React components that follow the WAI-ARIA Authoring Practices patterns for Tabs, Dialog and Combobox. There is no CSS: style the elements yourself. Ids come from `useId()`, so several instances can share a page.
+
+Run the tests and type check with `pnpm test` and `pnpm typecheck`.
+
+## Usage
+
+```tsx
+import { Combobox, Dialog, TabList, Tab, TabPanel, Tabs } from "@acme/ui";
+import { useState } from "react";
+
+function Example() {
+  const [fruit, setFruit] = useState<string | null>(null);
+  const [open, setOpen] = useState(false);
+  return (
+    <>
+      <Tabs defaultValue="plans">
+        <TabList aria-label="Settings">
+          <Tab value="plans">Plans</Tab>
+          <Tab value="billing" disabled>Billing</Tab>
+        </TabList>
+        <TabPanel value="plans">Choose a plan.</TabPanel>
+        <TabPanel value="billing">Not available.</TabPanel>
+      </Tabs>
+      <Combobox
+        label="Fruit"
+        options={[{ value: "apple", label: "Apple" }, { value: "pear", label: "Pear", disabled: true }]}
+        value={fruit}
+        onChange={setFruit}
+        placeholder="Pick a fruit"
+      />
+      <button onClick={() => setOpen(true)}>Delete</button>
+      <Dialog open={open} onOpenChange={setOpen} title="Delete file" description="This cannot be undone.">
+        <button onClick={() => setOpen(false)}>Confirm</button>
+      </Dialog>
+    </>
+  );
+}
+```
+
+## Tabs
+
+`Tabs` has no DOM of its own. Put one `TabList`, one `Tab` per tab and one `TabPanel` per tab value inside it. Refs are not forwarded to the rendered elements.
+
+### Tabs
+
+| Prop | Type | Required / default | Description |
+| --- | --- | --- | --- |
+| `defaultValue` | `string` | optional; first enabled tab | Initially selected tab value when uncontrolled. |
+| `value` | `string` | optional | Selected tab value when controlled. Wins over `defaultValue`. |
+| `onValueChange` | `(value: string) => void` | optional | Called with the new value on a user selection. Not called when the selected tab is chosen again. |
+| `children` | `ReactNode` | optional | `TabList` and `TabPanel` elements. |
+
+### TabList
+
+| Prop | Type | Required / default | Description |
+| --- | --- | --- | --- |
+| `aria-label` | `string` | required | Accessible name of the `tablist`. |
+| `...rest` | `ComponentPropsWithoutRef<"div">` | optional | Passed to the `div role="tablist"`. |
+
+### Tab
+
+| Prop | Type | Required / default | Description |
+| --- | --- | --- | --- |
+| `value` | `string` | required | Value this tab selects. |
+| `disabled` | `boolean` | optional; `false` | Disabled tabs cannot be clicked or reached with the arrow keys. |
+| `...rest` | `ComponentPropsWithoutRef<"button">` | optional | Passed to the `button role="tab"`. |
+
+### TabPanel
+
+| Prop | Type | Required / default | Description |
+| --- | --- | --- | --- |
+| `value` | `string` | required | Tab value this panel belongs to. Panels for other values stay in the DOM with `hidden`. |
+| `...rest` | `ComponentPropsWithoutRef<"div">` | optional | Passed to the `div role="tabpanel"`. |
+
+### Tabs keyboard
+
+| Key | Action |
+| --- | --- |
+| Tab | Moves focus into the tablist (to the selected tab) and out of it. |
+| ArrowRight | Focuses and selects the next enabled tab; wraps from last to first. |
+| ArrowLeft | Focuses and selects the previous enabled tab; wraps from first to last. |
+| Home | Focuses and selects the first enabled tab. |
+| End | Focuses and selects the last enabled tab. |
+
+## Dialog
+
+A modal `role="dialog"` rendered into `document.body` through a portal, with a backdrop. Nothing is rendered while `open` is false.
+
+On open, focus moves to the first tabbable element inside the dialog, or to the dialog itself when there is none. Tab and Shift+Tab are kept inside the dialog. On close or unmount, focus returns to the element that was focused before opening, if it is still in the document.
+
+When dialogs are nested, only the topmost one handles Escape and Tab: the most deeply nested open dialog, or among equally nested ones the most recently opened. Closing the inner dialog hands these keys back to the outer one.
+
+### Dialog props
+
+| Prop | Type | Required / default | Description |
+| --- | --- | --- | --- |
+| `open` | `boolean` | required | Whether the dialog is shown. |
+| `onOpenChange` | `(open: boolean) => void` | required | Called with `false` on Escape or a backdrop click. |
+| `title` | `ReactNode` | required | Rendered in an `h2`; names the dialog. |
+| `description` | `ReactNode` | optional | Rendered in a `p` unless it is `null`, `undefined` or `false` (so `0` shows); describes the dialog. Only then is `aria-describedby` set. |
+| `children` | `ReactNode` | optional | Dialog content. |
+| `...rest` | `ComponentPropsWithoutRef<"div">` minus `title` | optional | Passed to the `div role="dialog"`. |
+
+A backdrop click closes the dialog only when the mouse went down on the backdrop too, so a text selection that starts inside the dialog does not close it.
+
+### Dialog keyboard
+
+| Key | Action |
+| --- | --- |
+| Tab | Moves to the next tabbable element inside the topmost dialog; wraps from last to first. Disabled, hidden and `tabindex="-1"` elements are skipped. |
+| Shift+Tab | Moves to the previous tabbable element inside the topmost dialog; wraps from first to last. |
+| Escape | Calls `onOpenChange(false)` on the topmost dialog only. A nested Combobox with an open listbox consumes Escape first and closes only the listbox. |
+
+## Combobox
+
+A text input with `role="combobox"` and a filterable listbox, labelled by `label`. Typing filters the options by case-insensitive substring match on the label. The listbox is always in the DOM and is `hidden` while closed.
+
+Keyboard arrows wrap at both ends and skip disabled options. The active option is exposed through `aria-activedescendant` and carries `data-active="true"`. Focus never leaves the input. Option ids are index-based, so option values can contain any characters.
+
+The active option is tracked by its value: it is kept when a new `options` array still contains it, dropped when the option is removed or filtered away, and reset when typing changes the filter. Option values should be unique.
+
+### Combobox props
+
+| Prop | Type | Required / default | Description |
+| --- | --- | --- | --- |
+| `label` | `string` | required | Visible label; names the input and the listbox. |
+| `options` | `ComboboxOption<T>[]` | required | Options, each `{ value: T; label: string; disabled?: boolean }`. `T` extends `string` and defaults to `string`. |
+| `value` | `T \| null` | required | Selected option value, or `null` for none. The input text follows this prop, and typing never changes it. An unknown value shows empty text. |
+| `onChange` | `(value: T \| null) => void` | required | Called with the option value when an enabled option is chosen with Enter or a click. Called with `null` when the user has emptied the input and then blurs, or presses Enter with no active option, and `value` is not `null`. Clearing and then pressing Escape does not call it. |
+| `placeholder` | `string` | optional | Placeholder of the input. |
+
+### Combobox keyboard
+
+| Key | Action |
+| --- | --- |
+| ArrowDown | Opens the listbox if closed, activating the selected option or the first enabled option. When open, activates the next enabled option. |
+| ArrowUp | Same as ArrowDown, moving to the previous enabled option. |
+| Enter | While open with an active option, selects it and closes the listbox. While open with no active option and empty text, clears the selection (`onChange(null)`) and closes the listbox. While open, never submits a surrounding form. |
+| Escape | While the listbox is open, closes it and reverts the text to the selected label, without calling `onChange`. |
+| Typing | Opens the listbox and filters the options. |
+| Blur | Closes the listbox and reverts the text to the selected label. With empty text and a selected value, calls `onChange(null)` first to clear the selection. |
diff --git a/src/Combobox.tsx b/src/Combobox.tsx
new file mode 100644
index 0000000..4ee7c40
--- /dev/null
+++ b/src/Combobox.tsx
@@ -0,0 +1,167 @@
+import { useId, useState, type KeyboardEvent } from "react";
+
+export type ComboboxOption<T extends string = string> = {
+  value: T;
+  label: string;
+  disabled?: boolean;
+};
+
+export type ComboboxProps<T extends string = string> = {
+  label: string;
+  options: ComboboxOption<T>[];
+  value: T | null;
+  onChange: (value: T | null) => void;
+  placeholder?: string;
+};
+
+// Next enabled index after `from` in direction `step`, wrapping at the ends. Null if none is enabled.
+function stepToEnabled<T extends string>(
+  options: ComboboxOption<T>[],
+  from: number,
+  step: 1 | -1,
+): number | null {
+  const count = options.length;
+  for (let i = 1; i <= count; i++) {
+    const index = (((from + step * i) % count) + count) % count;
+    if (!options[index].disabled) return index;
+  }
+  return null;
+}
+
+// The selected option if it is enabled, otherwise the first enabled option.
+function startIndex<T extends string>(options: ComboboxOption<T>[], value: T | null): number | null {
+  const selected = options.findIndex((option) => option.value === value);
+  if (selected !== -1 && !options[selected].disabled) return selected;
+  return stepToEnabled(options, -1, 1);
+}
+
+export function Combobox<T extends string = string>({
+  label,
+  options,
+  value,
+  onChange,
+  placeholder,
+}: ComboboxProps<T>) {
+  const baseId = useId();
+  const labelId = `${baseId}-label`;
+  const inputId = `${baseId}-input`;
+  const listboxId = `${baseId}-listbox`;
+  const [open, setOpen] = useState(false);
+  // The text the user typed; null when not typing, in which case the input shows the selected label.
+  const [query, setQuery] = useState<string | null>(null);
+  // The active option's value; it drops out when that option is filtered away or removed.
+  const [active, setActive] = useState<T | null>(null);
+
+  const selectedLabel = options.find((option) => option.value === value)?.label ?? "";
+  const needle = (query ?? "").toLowerCase();
+  const visible = options.filter((option) => option.label.toLowerCase().includes(needle));
+  const found = active === null ? -1 : visible.findIndex((option) => option.value === active);
+  const activeIndex = found !== -1 && !visible[found].disabled ? found : null;
+  // Empty text means the user cleared the input; blur or Enter then clears the selection.
+  const canClear = query === "" && value !== null;
+
+  const optionId = (index: number) => `${baseId}-option-${index}`;
+
+  function activate(index: number | null) {
+    setActive(index === null ? null : visible[index].value);
+  }
+
+  function closeListbox() {
+    setOpen(false);
+    setQuery(null);
+    setActive(null);
+  }
+
+  function choose(option: ComboboxOption<T>) {
+    onChange(option.value);
+    closeListbox();
+  }
+
+  function handleBlur() {
+    if (canClear) onChange(null);
+    closeListbox();
+  }
+
+  function handleKeyDown(event: KeyboardEvent<HTMLInputElement>) {
+    switch (event.key) {
+      case "ArrowDown":
+      case "ArrowUp": {
+        event.preventDefault();
+        const step = event.key === "ArrowDown" ? 1 : -1;
+        if (!open) {
+          setOpen(true);
+          activate(startIndex(visible, value));
+        } else {
+          activate(stepToEnabled(visible, activeIndex ?? (step === 1 ? -1 : visible.length), step));
+        }
+        return;
+      }
+      case "Enter":
+        if (!open) return;
+        // Enter belongs to the listbox while it is open, so it never submits a surrounding form.
+        event.preventDefault();
+        if (activeIndex !== null) {
+          choose(visible[activeIndex]);
+        } else if (canClear) {
+          onChange(null);
+          closeListbox();
+        }
+        return;
+      case "Escape":
+        if (!open) return;
+        // Escape closes only the listbox; the event stops here so an enclosing dialog stays open.
+        event.stopPropagation();
+        closeListbox();
+        return;
+      default:
+        return;
+    }
+  }
+
+  return (
+    <>
+      <label id={labelId} htmlFor={inputId}>
+        {label}
+      </label>
+      <input
+        id={inputId}
+        type="text"
+        role="combobox"
+        autoComplete="off"
+        placeholder={placeholder}
+        value={query ?? selectedLabel}
+        aria-expanded={open}
+        aria-controls={listboxId}
+        aria-autocomplete="list"
+        aria-activedescendant={activeIndex !== null ? optionId(activeIndex) : undefined}
+        onChange={(event) => {
+          setQuery(event.target.value);
+          setOpen(true);
+          setActive(null);
+        }}
+        onKeyDown={handleKeyDown}
+        onBlur={handleBlur}
+      />
+      <ul id={listboxId} role="listbox" aria-labelledby={labelId} hidden={!open}>
+        {open && visible.length === 0 ? <li role="presentation">No results</li> : null}
+        {open &&
+          visible.map((option, index) => (
+            <li
+              key={index}
+              id={optionId(index)}
+              role="option"
+              aria-selected={option.value === value}
+              aria-disabled={option.disabled || undefined}
+              data-active={index === activeIndex ? "true" : undefined}
+              onMouseDown={(event) => event.preventDefault()}
+              onClick={() => {
+                if (!option.disabled) choose(option);
+              }}
+            >
+              {option.label}
+            </li>
+          ))}
+      </ul>
+    </>
+  );
+}
diff --git a/src/Dialog.tsx b/src/Dialog.tsx
new file mode 100644
index 0000000..5a1a406
--- /dev/null
+++ b/src/Dialog.tsx
@@ -0,0 +1,125 @@
+import { createContext, useContext, useEffect, useId, useRef, type ComponentPropsWithoutRef, type ReactNode } from "react";
+import { createPortal } from "react-dom";
+
+export type DialogProps = Omit<ComponentPropsWithoutRef<"div">, "title"> & {
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+  title: ReactNode;
+  description?: ReactNode;
+  children?: ReactNode;
+};
+
+// Open dialogs in the order they opened. The topmost one, which alone handles Escape and Tab, is
+// the most deeply nested; among equally nested ones, the last opened. Depth comes from context
+// because nested dialogs that open in the same commit run their effects child first.
+type Layer = { depth: number };
+const openDialogs: Layer[] = [];
+const DialogDepth = createContext(0);
+
+function isTopmost(layer: Layer): boolean {
+  let top = openDialogs[0];
+  for (const open of openDialogs) if (open.depth >= top.depth) top = open;
+  return top === layer;
+}
+
+function getTabbables(container: HTMLElement): HTMLElement[] {
+  return Array.from(
+    container.querySelectorAll<HTMLElement>("button, input, select, textarea, a[href], [tabindex]"),
+  ).filter((el) => el.tabIndex >= 0 && !el.matches(":disabled") && !el.closest("[hidden]"));
+}
+
+function keepTabInside(event: globalThis.KeyboardEvent, dialog: HTMLElement) {
+  const tabbables = getTabbables(dialog);
+  if (tabbables.length === 0) {
+    event.preventDefault();
+    dialog.focus();
+    return;
+  }
+  // -1 means focus is on the dialog itself or outside it.
+  const index = tabbables.indexOf(document.activeElement as HTMLElement);
+  if (event.shiftKey && index <= 0) {
+    event.preventDefault();
+    tabbables[tabbables.length - 1].focus();
+  } else if (!event.shiftKey && (index === -1 || index === tabbables.length - 1)) {
+    event.preventDefault();
+    tabbables[0].focus();
+  }
+}
+
+function DialogSurface({
+  onOpenChange,
+  title,
+  description,
+  children,
+  ...rest
+}: Omit<DialogProps, "open">) {
+  const baseId = useId();
+  const titleId = `${baseId}-title`;
+  const descriptionId = `${baseId}-description`;
+  const dialogRef = useRef<HTMLDivElement>(null);
+  const pressedBackdrop = useRef(false);
+  const depth = useContext(DialogDepth) + 1;
+  const layer = useRef<Layer>({ depth }).current;
+  const hasDescription = description != null && description !== false;
+
+  // Focus moves in on open and goes back to the previously focused element on close or unmount.
+  useEffect(() => {
+    const previous = document.activeElement;
+    const dialog = dialogRef.current as HTMLDivElement;
+    (getTabbables(dialog)[0] ?? dialog).focus();
+    return () => {
+      if (previous instanceof HTMLElement && previous.isConnected) previous.focus();
+    };
+  }, []);
+
+  useEffect(() => {
+    openDialogs.push(layer);
+    return () => {
+      openDialogs.splice(openDialogs.indexOf(layer), 1);
+    };
+  }, [layer]);
+
+  useEffect(() => {
+    function handleKeyDown(event: globalThis.KeyboardEvent) {
+      if (!isTopmost(layer)) return;
+      if (event.key === "Escape") {
+        onOpenChange(false);
+      } else if (event.key === "Tab") {
+        keepTabInside(event, dialogRef.current as HTMLDivElement);
+      }
+    }
+    document.addEventListener("keydown", handleKeyDown);
+    return () => document.removeEventListener("keydown", handleKeyDown);
+  }, [onOpenChange, layer]);
+
+  return (
+    <div
+      data-backdrop
+      onMouseDown={(event) => {
+        pressedBackdrop.current = event.target === event.currentTarget;
+      }}
+      onClick={(event) => {
+        if (event.target === event.currentTarget && pressedBackdrop.current) onOpenChange(false);
+      }}
+    >
+      <div
+        {...rest}
+        ref={dialogRef}
+        role="dialog"
+        aria-modal="true"
+        aria-labelledby={titleId}
+        aria-describedby={hasDescription ? descriptionId : undefined}
+        tabIndex={-1}
+      >
+        <h2 id={titleId}>{title}</h2>
+        {hasDescription ? <p id={descriptionId}>{description}</p> : null}
+        <DialogDepth.Provider value={depth}>{children}</DialogDepth.Provider>
+      </div>
+    </div>
+  );
+}
+
+export function Dialog({ open, ...props }: DialogProps) {
+  if (!open) return null;
+  return createPortal(<DialogSurface {...props} />, document.body);
+}
diff --git a/src/Tabs.tsx b/src/Tabs.tsx
new file mode 100644
index 0000000..c6d6698
--- /dev/null
+++ b/src/Tabs.tsx
@@ -0,0 +1,165 @@
+import {
+  createContext,
+  useContext,
+  useId,
+  useLayoutEffect,
+  useRef,
+  useState,
+  type ComponentPropsWithoutRef,
+  type KeyboardEvent,
+  type ReactNode,
+} from "react";
+
+export type TabsProps = {
+  defaultValue?: string;
+  value?: string;
+  onValueChange?: (value: string) => void;
+  children?: ReactNode;
+};
+
+export type TabListProps = ComponentPropsWithoutRef<"div"> & { "aria-label": string };
+
+export type TabProps = ComponentPropsWithoutRef<"button"> & { value: string };
+
+export type TabPanelProps = ComponentPropsWithoutRef<"div"> & { value: string };
+
+type TabsContextValue = {
+  baseId: string;
+  selected: string | null;
+  tabStop: string | null;
+  select: (value: string) => void;
+  syncEnabledValues: (values: string[]) => void;
+};
+
+const TabsContext = createContext<TabsContextValue | null>(null);
+
+function useTabsContext(): TabsContextValue {
+  const context = useContext(TabsContext);
+  if (!context) {
+    throw new Error("Tab, TabList and TabPanel must be rendered inside <Tabs>");
+  }
+  return context;
+}
+
+function tabId(baseId: string, value: string): string {
+  return `${baseId}-tab-${encodeURIComponent(value)}`;
+}
+
+function panelId(baseId: string, value: string): string {
+  return `${baseId}-panel-${encodeURIComponent(value)}`;
+}
+
+function getEnabledTabs(list: HTMLElement): HTMLElement[] {
+  return Array.from(list.querySelectorAll<HTMLElement>('[role="tab"]:not(:disabled)'));
+}
+
+export function Tabs({ defaultValue, value, onValueChange, children }: TabsProps) {
+  const baseId = useId();
+  const [internalValue, setInternalValue] = useState<string | undefined>(defaultValue);
+  const [enabledValues, setEnabledValues] = useState<string[]>([]);
+  const isControlled = value !== undefined;
+  // Before any user choice, the first enabled tab is selected.
+  const selected = (isControlled ? value : internalValue) ?? enabledValues[0] ?? null;
+  // The selected tab is the tab stop when it is enabled; otherwise the first enabled tab is.
+  const tabStop =
+    selected !== null && enabledValues.includes(selected) ? selected : (enabledValues[0] ?? null);
+
+  function select(next: string) {
+    if (next === selected) return;
+    if (!isControlled) setInternalValue(next);
+    onValueChange?.(next);
+  }
+
+  function syncEnabledValues(next: string[]) {
+    setEnabledValues((prev) => (JSON.stringify(prev) === JSON.stringify(next) ? prev : next));
+  }
+
+  return (
+    <TabsContext.Provider value={{ baseId, selected, tabStop, select, syncEnabledValues }}>
+      {children}
+    </TabsContext.Provider>
+  );
+}
+
+export function TabList({ "aria-label": label, children, onKeyDown, ...rest }: TabListProps) {
+  const { select, syncEnabledValues } = useTabsContext();
+  const listRef = useRef<HTMLDivElement>(null);
+
+  // Runs after every render so the enabled tabs (and DOM order) are always current.
+  useLayoutEffect(() => {
+    const tabs = getEnabledTabs(listRef.current as HTMLElement);
+    syncEnabledValues(tabs.map((tab) => tab.dataset.value ?? ""));
+  });
+
+  function handleKeyDown(event: KeyboardEvent<HTMLDivElement>) {
+    onKeyDown?.(event);
+    const tabs = getEnabledTabs(event.currentTarget);
+    if (tabs.length === 0) return;
+    const current = tabs.indexOf(event.target as HTMLElement);
+    const last = tabs.length - 1;
+    let next: number;
+    switch (event.key) {
+      case "ArrowRight":
+        next = current === last ? 0 : current + 1;
+        break;
+      case "ArrowLeft":
+        next = current <= 0 ? last : current - 1;
+        break;
+      case "Home":
+        next = 0;
+        break;
+      case "End":
+        next = last;
+        break;
+      default:
+        return;
+    }
+    event.preventDefault();
+    tabs[next].focus();
+    select(tabs[next].dataset.value ?? "");
+  }
+
+  return (
+    <div {...rest} ref={listRef} role="tablist" aria-label={label} onKeyDown={handleKeyDown}>
+      {children}
+    </div>
+  );
+}
+
+export function Tab({ value, onClick, children, ...rest }: TabProps) {
+  const { baseId, selected, tabStop, select } = useTabsContext();
+  return (
+    <button
+      type="button"
+      {...rest}
+      role="tab"
+      id={tabId(baseId, value)}
+      data-value={value}
+      aria-selected={value === selected}
+      aria-controls={panelId(baseId, value)}
+      tabIndex={value === tabStop ? 0 : -1}
+      onClick={(event) => {
+        onClick?.(event);
+        select(value);
+      }}
+    >
+      {children}
+    </button>
+  );
+}
+
+export function TabPanel({ value, children, ...rest }: TabPanelProps) {
+  const { baseId, selected } = useTabsContext();
+  return (
+    <div
+      {...rest}
+      role="tabpanel"
+      id={panelId(baseId, value)}
+      aria-labelledby={tabId(baseId, value)}
+      tabIndex={0}
+      hidden={value !== selected}
+    >
+      {children}
+    </div>
+  );
+}
