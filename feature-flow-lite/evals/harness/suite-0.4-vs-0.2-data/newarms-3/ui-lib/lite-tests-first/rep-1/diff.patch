+      await user.click(tab("Two"));
+      expect(onValueChange).toHaveBeenCalledTimes(1);
+      expect(onValueChange).toHaveBeenCalledWith("two");
+    });
+
+    it("tabbing into a tablist whose value matches no tab calls nothing and focuses the first enabled tab", async () => {
+      const user = userEvent.setup();
+      const onValueChange = vi.fn();
+      render(<Example value="nope" onValueChange={onValueChange} />);
+      await user.tab();
+      expect(tab("One")).toHaveFocus();
+      expect(onValueChange).not.toHaveBeenCalled();
+    });
+
+    it("arrow and End keys report the target value when the parent ignores updates", async () => {
+      const user = userEvent.setup();
+      const onValueChange = vi.fn();
+      render(<Example value="one" onValueChange={onValueChange} />);
+      tab("One").focus();
+      await user.keyboard("{ArrowRight}");
+      expect(tab("Two")).toHaveFocus();
+      expect(onValueChange).toHaveBeenLastCalledWith("two");
+      await user.keyboard("{End}");
+      expect(tab("Three")).toHaveFocus();
+      expect(onValueChange).toHaveBeenLastCalledWith("three");
+      expect(tab("One")).toHaveAttribute("aria-selected", "true");
+    });
+
+    it("Home and End select the first and last tab in uncontrolled mode", async () => {
+      const user = userEvent.setup();
+      const onValueChange = vi.fn();
+      render(<Example defaultValue="two" onValueChange={onValueChange} />);
+      tab("Two").focus();
+      await user.keyboard("{End}");
+      expect(onValueChange).toHaveBeenLastCalledWith("three");
+      expect(tab("Three")).toHaveAttribute("aria-selected", "true");
+      await user.keyboard("{Home}");
+      expect(onValueChange).toHaveBeenLastCalledWith("one");
+      expect(tab("One")).toHaveAttribute("aria-selected", "true");
+    });
+  });
+
+  describe("hostile input (T6)", () => {
+    it("does nothing and does not throw when every tab is disabled", async () => {
+      const user = userEvent.setup();
+      const onValueChange = vi.fn();
+      render(<Example disabled={["one", "two", "three"]} onValueChange={onValueChange} />);
+      tab("One").focus();
+      await user.keyboard("{ArrowRight}{ArrowLeft}{Home}{End}");
+      expect(tab("One")).toHaveFocus();
+      expect(onValueChange).not.toHaveBeenCalled();
+    });
+
+    it("keeps focus on a single tab when ArrowRight is pressed", async () => {
+      const user = userEvent.setup();
+      const onValueChange = vi.fn();
+      render(
+        <Tabs defaultValue="only" onValueChange={onValueChange}>
+          <TabList aria-label="Single">
+            <Tab value="only">Only</Tab>
+          </TabList>
+          <TabPanel value="only">P</TabPanel>
+        </Tabs>,
+      );
+      tab("Only").focus();
+      await user.keyboard("{ArrowRight}");
+      expect(tab("Only")).toHaveFocus();
+      expect(onValueChange).not.toHaveBeenCalled();
+    });
+
+    it("navigates in DOM order after tabs are reordered", async () => {
+      const user = userEvent.setup();
+      const { rerender } = render(<Reorderable values={["a", "b", "c"]} />);
+      rerender(<Reorderable values={["c", "b", "a"]} />);
+      tab("c").focus();
+      await user.keyboard("{ArrowRight}");
+      expect(tab("b")).toHaveFocus();
+    });
+
+    it("navigates in DOM order after a tab is removed", async () => {
+      const user = userEvent.setup();
+      const { rerender } = render(<Reorderable values={["a", "b", "c"]} />);
+      rerender(<Reorderable values={["a", "c"]} />);
+      tab("a").focus();
+      await user.keyboard("{ArrowRight}");
+      expect(tab("c")).toHaveFocus();
+    });
+
+    it("does not call onValueChange when re-selecting the selected tab", async () => {
+      const user = userEvent.setup();
+      const onValueChange = vi.fn();
+      render(<Example onValueChange={onValueChange} />);
+      await user.click(tab("One"));
+      expect(onValueChange).not.toHaveBeenCalled();
+    });
+  });
+});
