@@ -1 +1,6 @@
-export {};
+export { Tabs, TabList, Tab, TabPanel } from "./Tabs";
+export type { TabsProps, TabListProps, TabProps, TabPanelProps } from "./Tabs";
+export { Dialog } from "./Dialog";
