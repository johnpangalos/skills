+import { render, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { useEffect, useState } from "react";
+import { Tab, TabList, TabPanel, Tabs, type TabsProps } from "./Tabs";
+
+type ExampleProps = Partial<TabsProps> & { disabled?: string[] };
+
+function Example({ disabled = [], ...props }: ExampleProps) {
+  return (
+    <Tabs {...props}>
+      <TabList aria-label="Sections">
+        <Tab value="a" disabled={disabled.includes("a")}>A</Tab>
+        <Tab value="b" disabled={disabled.includes("b")}>B</Tab>
+        <Tab value="c" disabled={disabled.includes("c")}>C</Tab>
+      </TabList>
+      <TabPanel value="a">Panel A</TabPanel>
+      <TabPanel value="b">Panel B</TabPanel>
+      <TabPanel value="c">Panel C</TabPanel>
+    </Tabs>
+  );
+}
+
+function ControlledExample({ onValueChange }: { onValueChange: (value: string) => void }) {
+  const [value, setValue] = useState("a");
+  return (
+    <Example
+      value={value}
+      onValueChange={(next) => {
+        setValue(next);
+        onValueChange(next);
+      }}
+    />
+  );
+}
+
+function Inserted({ withMiddle }: { withMiddle: boolean }) {
+  return (
+    <Tabs defaultValue="a">
+      <TabList aria-label="Sections">
+        <Tab value="a">A</Tab>
+        {withMiddle && <Tab value="m">M</Tab>}
+        <Tab value="b">B</Tab>
+      </TabList>
+    </Tabs>
+  );
+}
+
+const tab = (name: string) => screen.getByRole("tab", { name });
+
+describe("Tabs", () => {
+  it("selects the defaultValue tab in uncontrolled mode and reports changes", async () => {
+    const user = userEvent.setup();
+    const onValueChange = vi.fn();
+    render(<Example defaultValue="b" onValueChange={onValueChange} />);
+    expect(tab("B")).toHaveAttribute("aria-selected", "true");
+    expect(screen.getByRole("tabpanel")).toHaveTextContent("Panel B");
+
+    await user.click(tab("C"));
+    expect(onValueChange).toHaveBeenCalledWith("c");
+    expect(tab("C")).toHaveAttribute("aria-selected", "true");
+
+    await user.click(tab("C"));
+    expect(onValueChange).toHaveBeenCalledTimes(1);
+  });
+
+  it("selects the first enabled tab when no value is given", () => {
+    render(<Example disabled={["a"]} />);
+    expect(tab("A")).toHaveAttribute("aria-selected", "false");
+    expect(tab("B")).toHaveAttribute("aria-selected", "true");
+  });
+
+  it("follows a controlled value and keeps it when the parent ignores the change", async () => {
+    const user = userEvent.setup();
+    const onValueChange = vi.fn();
+    const { rerender } = render(<Example value="a" onValueChange={onValueChange} />);
+    await user.click(tab("B"));
+    expect(onValueChange).toHaveBeenCalledWith("b");
+    expect(tab("A")).toHaveAttribute("aria-selected", "true");
+
+    rerender(<Example value="c" onValueChange={onValueChange} />);
+    expect(tab("C")).toHaveAttribute("aria-selected", "true");
+  });
+
+  it("updates selection when the controlled parent accepts the change", async () => {
+    const user = userEvent.setup();
+    const onValueChange = vi.fn();
+    render(<ControlledExample onValueChange={onValueChange} />);
+    await user.click(tab("B"));
+    expect(onValueChange).toHaveBeenCalledWith("b");
+    expect(tab("B")).toHaveAttribute("aria-selected", "true");
+  });
+
+  it("wires ARIA roles, ids and hidden panels", () => {
