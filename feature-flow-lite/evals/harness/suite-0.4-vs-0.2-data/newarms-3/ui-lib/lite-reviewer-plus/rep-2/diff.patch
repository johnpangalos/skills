+import { useState, type ReactNode } from "react";
+import { fireEvent, render, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { Dialog } from "../src/index";
+
+function Harness({
+  onOpenChange = () => {},
+  description,
+  children,
+}: {
+  onOpenChange?: (open: boolean) => void;
+  description?: string;
+  children?: ReactNode;
+}) {
+  const [open, setOpen] = useState(false);
+  return (
+    <>
+      <button onClick={() => setOpen(true)}>Open</button>
+      <Dialog
+        open={open}
+        onOpenChange={(next) => {
+          onOpenChange(next);
+          setOpen(next);
+        }}
+        title="Confirm"
+        description={description}
+      >
+        {children ?? (
+          <>
+            <button>Cancel</button>
+            <button>OK</button>
+          </>
+        )}
+      </Dialog>
+    </>
+  );
+}
+
+describe("Dialog", () => {
+  it("renders nothing when closed", () => {
+    render(<Dialog open={false} onOpenChange={() => {}} title="Confirm" />);
+    expect(screen.queryByRole("dialog")).not.toBeInTheDocument();
+  });
+
+  it("renders into document.body with the expected aria wiring", () => {
+    render(<Dialog open onOpenChange={() => {}} title="Confirm" description="Are you sure?" />);
+    const dialog = screen.getByRole("dialog");
+    expect(dialog.parentElement?.parentElement).toBe(document.body);
+    expect(dialog).toHaveAttribute("aria-modal", "true");
+    expect(screen.getByRole("heading", { level: 2, name: "Confirm" })).toHaveAttribute(
+      "id",
+      dialog.getAttribute("aria-labelledby"),
+    );
+    expect(screen.getByText("Are you sure?")).toHaveAttribute("id", dialog.getAttribute("aria-describedby"));
+  });
+
+  it("omits aria-describedby when no description is given", () => {
+    render(<Dialog open onOpenChange={() => {}} title="Confirm" />);
+    expect(screen.getByRole("dialog")).not.toHaveAttribute("aria-describedby");
+  });
+
+  it("moves focus to the first tabbable element on open", async () => {
+    const user = userEvent.setup();
+    render(<Harness />);
+    await user.click(screen.getByRole("button", { name: "Open" }));
+    expect(screen.getByRole("button", { name: "Cancel" })).toHaveFocus();
+  });
+
+  it("focuses the dialog itself when it has no tabbable elements", async () => {
+    const user = userEvent.setup();
+    render(<Harness>{<p>Just text</p>}</Harness>);
+    await user.click(screen.getByRole("button", { name: "Open" }));
+    expect(screen.getByRole("dialog")).toHaveFocus();
+    expect(screen.getByRole("dialog")).toHaveAttribute("tabindex", "-1");
+  });
+
+  it("skips disabled, hidden and tabindex=-1 elements when finding focus targets", async () => {
+    const user = userEvent.setup();
+    render(
+      <Harness>
+        <button disabled>Disabled</button>
+        <button hidden>Hidden</button>
+        <div tabIndex={-1}>Not tabbable</div>
+        <button>Real</button>
+      </Harness>,
+    );
+    await user.click(screen.getByRole("button", { name: "Open" }));
+    expect(screen.getByRole("button", { name: "Real" })).toHaveFocus();
+  });
+
+  it("wraps Tab from the last tabbable element to the first", async () => {
+    const user = userEvent.setup();
+    render(<Harness />);
+    await user.click(screen.getByRole("button", { name: "Open" }));
+    await user.keyboard("{Tab}");
+    expect(screen.getByRole("button", { name: "OK" })).toHaveFocus();
+    await user.keyboard("{Tab}");
+    expect(screen.getByRole("button", { name: "Cancel" })).toHaveFocus();
+  });
+
+  it("wraps Shift+Tab from the first tabbable element to the last", async () => {
