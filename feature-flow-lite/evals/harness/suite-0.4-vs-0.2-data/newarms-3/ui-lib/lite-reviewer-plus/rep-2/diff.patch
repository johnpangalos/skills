+    rerender(<Dialog open onOpenChange={() => {}} title="Confirm" />);
+    expect(() => rerender(<Dialog open={false} onOpenChange={() => {}} title="Confirm" />)).not.toThrow();
+    expect(screen.queryByRole("dialog")).not.toBeInTheDocument();
+  });
