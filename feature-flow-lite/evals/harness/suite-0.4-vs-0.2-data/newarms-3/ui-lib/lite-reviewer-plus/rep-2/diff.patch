+    render(<Dialog open onOpenChange={onOpenChange} title="Confirm">Body</Dialog>);
+    await user.keyboard("{Escape}");
+    expect(screen.getByRole("dialog")).toBeInTheDocument();
+  });
+
+  it("returns focus to the previously focused element when closed", async () => {
+    const user = userEvent.setup();
+    render(<Harness />);
+    const opener = screen.getByRole("button", { name: "Open" });
+    await user.click(opener);
+    await user.keyboard("{Escape}");
+    expect(screen.queryByRole("dialog")).not.toBeInTheDocument();
+    expect(opener).toHaveFocus();
+  });
+
+  it("returns focus when the dialog unmounts while open", () => {
+    const opener = document.createElement("button");
+    document.body.appendChild(opener);
+    opener.focus();
+    const { unmount } = render(<Dialog open onOpenChange={() => {}} title="Confirm">Body</Dialog>);
+    expect(screen.getByRole("dialog")).toHaveFocus();
