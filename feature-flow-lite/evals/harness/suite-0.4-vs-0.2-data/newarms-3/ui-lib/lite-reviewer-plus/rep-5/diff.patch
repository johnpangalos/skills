+
+  it("makes the outer dialog top-most again once the inner dialog closes", async () => {
+    const user = userEvent.setup();
+    const onOuterChange = vi.fn();
+    const onInnerChange = vi.fn();
+    const { rerender } = render(
+      <NestedOpenAtMount innerOpen onOuterChange={onOuterChange} onInnerChange={onInnerChange} />,
+    );
+    rerender(<NestedOpenAtMount innerOpen={false} onOuterChange={onOuterChange} onInnerChange={onInnerChange} />);
+    const first = screen.getByRole("button", { name: "ob" });
+    const last = screen.getByRole("button", { name: "o2" });
+
+    last.focus();
+    await user.tab();
+    expect(first).toHaveFocus();
+
+    await user.keyboard("{Escape}");
+    expect(onOuterChange).toHaveBeenCalledTimes(1);
+    expect(onOuterChange).toHaveBeenCalledWith(false);
+    expect(onInnerChange).not.toHaveBeenCalled();
+  });
+});
