+      </button>
+      <Dialog open={open} onOpenChange={setOpen} title="Confirm">
+        <input aria-label="Name" />
+      </Dialog>
+    </>
+  );
+}
+
+function Mountable({ show }: { show: boolean }) {
+  return (
+    <>
+      <button type="button">Outside</button>
