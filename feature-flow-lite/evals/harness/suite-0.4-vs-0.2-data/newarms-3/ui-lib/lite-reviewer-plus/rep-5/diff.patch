+        {children ?? (
+          <>
+            <input aria-label="Name" />
+            <button type="button">Save</button>
+          </>
+        )}
+      </Dialog>
+    </>
+  );
+}
+
+function Stateful() {
+  const [open, setOpen] = useState(false);
+  return (
+    <>
+      <button type="button" onClick={() => setOpen(true)}>
