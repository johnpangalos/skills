+import { render, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { StrictMode, useState } from "react";
+import { describe, expect, it, vi } from "vitest";
+import { Tab, TabList, TabPanel, Tabs } from "./Tabs";
+
+type ExampleProps = {
+  defaultValue?: string;
+  value?: string;
+  onValueChange?: (value: string) => void;
+  disabledBanana?: boolean;
+};
+
+function Example({ defaultValue, value, onValueChange, disabledBanana = false }: ExampleProps) {
+  return (
+    <Tabs defaultValue={defaultValue} value={value} onValueChange={onValueChange}>
+      <TabList aria-label="Fruit">
+        <Tab value="apple">Apple</Tab>
+        <Tab value="banana" disabled={disabledBanana}>
+          Banana
+        </Tab>
+        <Tab value="cherry">Cherry</Tab>
+      </TabList>
+      <TabPanel value="apple">Apple panel</TabPanel>
+      <TabPanel value="banana">Banana panel</TabPanel>
+      <TabPanel value="cherry">Cherry panel</TabPanel>
+    </Tabs>
+  );
+}
+
+const tab = (name: string) => screen.getByRole("tab", { name });
+
+describe("Tabs", () => {
+  it("selects the defaultValue and puts only the selected tab in the tab order", () => {
+    render(<Example defaultValue="banana" />);
+    expect(screen.getByRole("tablist", { name: "Fruit" })).toHaveAttribute("aria-orientation", "horizontal");
+    expect(tab("Banana")).toHaveAttribute("aria-selected", "true");
+    expect(tab("Apple")).toHaveAttribute("aria-selected", "false");
+    expect(tab("Banana")).toHaveAttribute("tabindex", "0");
