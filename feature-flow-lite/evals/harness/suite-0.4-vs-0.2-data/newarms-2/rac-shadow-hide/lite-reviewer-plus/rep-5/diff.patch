+// The shadow DOM flag cannot be turned off again, so this block runs after the tests above.
+describe('ariaHideOutside with shadow DOM', function () {
+  let cleanups = [];
+
+  beforeAll(function () {
+    enableShadowDOM();
+  });
+
+  afterEach(function () {
+    for (let cleanup of cleanups) {
+      cleanup();
+    }
+    cleanups = [];
+  });
+
+  let createContainer = function () {
+    let container = document.createElement('div');
+    document.body.appendChild(container);
+    cleanups.push(() => container.remove());
+    return container;
+  };
+
+  it('should hide siblings of a target inside a shadow root, but not its host or ancestors', function () {
+    let container = createContainer();
+    let light = document.createElement('input');
+    container.appendChild(light);
+    let {shadowHost, shadowRoot} = createShadowRoot(container);
+    shadowRoot.innerHTML = '<input id="before" type="checkbox"><div id="ancestor"><input id="inner" type="checkbox"><button id="target">Button</button></div><input id="after" type="checkbox">';
+    let target = shadowRoot.getElementById('target');
+
+    let revert = ariaHideOutside([target]);
+
+    expect(light).toHaveAttribute('aria-hidden', 'true');
+    expect(shadowHost).not.toHaveAttribute('aria-hidden');
+    expect(container).not.toHaveAttribute('aria-hidden');
+    expect(shadowRoot.getElementById('before')).toHaveAttribute('aria-hidden', 'true');
+    expect(shadowRoot.getElementById('ancestor')).not.toHaveAttribute('aria-hidden');
+    expect(shadowRoot.getElementById('inner')).toHaveAttribute('aria-hidden', 'true');
+    expect(shadowRoot.getElementById('after')).toHaveAttribute('aria-hidden', 'true');
+    expect(target).not.toHaveAttribute('aria-hidden');
+
+    revert();
+
+    expect(light).not.toHaveAttribute('aria-hidden');
+    expect(shadowRoot.getElementById('before')).not.toHaveAttribute('aria-hidden');
+    expect(shadowRoot.getElementById('inner')).not.toHaveAttribute('aria-hidden');
+    expect(shadowRoot.getElementById('after')).not.toHaveAttribute('aria-hidden');
+  });
+
