+
+  it('should hand shadow root observation back to the previous call when the nested call is restored', async function () {
+    let {shadowRoot, cleanup} = createShadowRoot();
+    let target = document.createElement('button');
+    let otherTarget = document.createElement('input');
+    shadowRoot.append(target, otherTarget);
+
+    let revert1 = ariaHideOutside([target]);
+    let revert2 = ariaHideOutside([otherTarget]);
+    expect(target).toHaveAttribute('aria-hidden', 'true');
+    expect(otherTarget).toHaveAttribute('aria-hidden', 'true');
+
+    revert2();
+    expect(target).not.toHaveAttribute('aria-hidden');
+    expect(otherTarget).toHaveAttribute('aria-hidden', 'true');
+
+    let added = document.createElement('input');
+    shadowRoot.appendChild(added);
+    // MutationObserver is async
+    await waitFor(() => expect(added).toHaveAttribute('aria-hidden', 'true'));
+    expect(target).not.toHaveAttribute('aria-hidden');
