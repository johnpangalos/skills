+
+describe('ariaHideOutside with Shadow DOM', function () {
+  beforeAll(() => {
+    enableShadowDOM();
+  });
+
+  it('should hide siblings in every enclosing shadow root and the light DOM, but not the path to the target', function () {
+    let lightSibling = document.createElement('input');
+    document.body.appendChild(lightSibling);
+    let {shadowRoot: outerRoot, shadowHost: outerHost, cleanup: cleanupOuter} = createShadowRoot();
+    let outerSibling = document.createElement('input');
+    let innerHost = document.createElement('div');
+    outerRoot.append(outerSibling, innerHost);
+    let innerRoot = innerHost.attachShadow({mode: 'open'});
+    let innerSibling = document.createElement('input');
+    let target = document.createElement('button');
+    innerRoot.append(innerSibling, target);
+
+    let revert = ariaHideOutside([target]);
+
+    expect(lightSibling).toHaveAttribute('aria-hidden', 'true');
+    expect(outerSibling).toHaveAttribute('aria-hidden', 'true');
+    expect(innerSibling).toHaveAttribute('aria-hidden', 'true');
+    expect(outerHost).not.toHaveAttribute('aria-hidden');
+    expect(innerHost).not.toHaveAttribute('aria-hidden');
+    expect(target).not.toHaveAttribute('aria-hidden');
+
+    revert();
+    cleanupOuter();
+    lightSibling.remove();
+
+    expect(lightSibling).not.toHaveAttribute('aria-hidden');
+    expect(outerSibling).not.toHaveAttribute('aria-hidden');
+    expect(innerSibling).not.toHaveAttribute('aria-hidden');
+  });
+
+  it('should hide siblings of a target that is a direct child of the shadow root, and an unrelated nested host without touching its contents', function () {
