+    // MutationObserver is async
+    await waitFor(() => expect(addedToFirst).toHaveAttribute('aria-hidden', 'true'));
+    expect(addedToSecond).toHaveAttribute('aria-hidden', 'true');
+
+    revert();
+    first.cleanup();
+    second.cleanup();
+  });
+
+  it('should restore everything it hid and stop observing shadow roots', async function () {
+    let {shadowRoot, cleanup} = createShadowRoot();
+    let target = document.createElement('button');
+    let sibling = document.createElement('input');
+    let preHidden = document.createElement('input');
+    preHidden.setAttribute('aria-hidden', 'true');
+    shadowRoot.append(target, sibling, preHidden);
+
+    let revert = ariaHideOutside([target]);
+    expect(sibling).toHaveAttribute('aria-hidden', 'true');
+
+    revert();
+
+    expect(sibling).not.toHaveAttribute('aria-hidden');
+    expect(preHidden).toHaveAttribute('aria-hidden', 'true');
+
+    let added = document.createElement('input');
+    shadowRoot.appendChild(added);
+    // Wait for any mutation observer tick
+    await Promise.resolve();
+    expect(added).not.toHaveAttribute('aria-hidden');
