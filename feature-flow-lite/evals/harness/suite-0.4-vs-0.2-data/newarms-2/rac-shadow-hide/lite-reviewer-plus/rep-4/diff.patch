+    let sibling = document.createElement('input');
+    let target = document.createElement('button');
+    let unrelatedHost = document.createElement('div');
+    shadowRoot.append(sibling, target, unrelatedHost);
+    let unrelatedRoot = unrelatedHost.attachShadow({mode: 'open'});
+    let unrelatedInner = document.createElement('input');
+    unrelatedRoot.append(unrelatedInner);
+
+    let revert = ariaHideOutside([target]);
+
+    expect(sibling).toHaveAttribute('aria-hidden', 'true');
+    expect(unrelatedHost).toHaveAttribute('aria-hidden', 'true');
+    expect(unrelatedInner).not.toHaveAttribute('aria-hidden');
+    expect(target).not.toHaveAttribute('aria-hidden');
+
+    revert();
+    cleanup();
+
+    expect(sibling).not.toHaveAttribute('aria-hidden');
+    expect(unrelatedHost).not.toHaveAttribute('aria-hidden');
+    expect(unrelatedInner).not.toHaveAttribute('aria-hidden');
+  });
+
+  it('should hide content added to a shadow root or to a visible wrapper inside it, but not content added to the target', async function () {
+    let {shadowRoot, cleanup} = createShadowRoot();
+    let wrapper = document.createElement('div');
+    let target = document.createElement('button');
+    wrapper.appendChild(target);
+    shadowRoot.appendChild(wrapper);
+
+    let revert = ariaHideOutside([target]);
+
+    let addedToShadowRoot = document.createElement('input');
+    let addedToWrapper = document.createElement('input');
+    let addedToTarget = document.createElement('input');
+    let addedToHidden = document.createElement('div');
+    let addedToHiddenChild = document.createElement('input');
+    shadowRoot.appendChild(addedToShadowRoot);
+    shadowRoot.appendChild(addedToHidden);
+    wrapper.appendChild(addedToWrapper);
+    target.appendChild(addedToTarget);
+    addedToHidden.appendChild(addedToHiddenChild);
+
+    // MutationObserver is async
+    await waitFor(() => expect(addedToShadowRoot).toHaveAttribute('aria-hidden', 'true'));
+    expect(addedToWrapper).toHaveAttribute('aria-hidden', 'true');
+    expect(addedToHidden).toHaveAttribute('aria-hidden', 'true');
+    expect(addedToTarget).not.toHaveAttribute('aria-hidden');
+    expect(target).not.toHaveAttribute('aria-hidden');
+    expect(wrapper).not.toHaveAttribute('aria-hidden');
+
+    revert();
+    cleanup();
+
+    expect(addedToShadowRoot).not.toHaveAttribute('aria-hidden');
+    expect(addedToWrapper).not.toHaveAttribute('aria-hidden');
+    expect(addedToHidden).not.toHaveAttribute('aria-hidden');
+    expect(addedToHiddenChild).not.toHaveAttribute('aria-hidden');
+  });
+
+  it('should hide content added to an outer shadow root while the target is in an inner one', async function () {
+    let {shadowRoot: outerRoot, cleanup} = createShadowRoot();
+    let innerHost = document.createElement('div');
+    outerRoot.appendChild(innerHost);
+    let innerRoot = innerHost.attachShadow({mode: 'open'});
+    let target = document.createElement('button');
+    innerRoot.appendChild(target);
+
+    let revert = ariaHideOutside([target]);
+
+    let added = document.createElement('input');
+    outerRoot.appendChild(added);
+    let addedToInner = document.createElement('input');
+    innerRoot.appendChild(addedToInner);
+
+    // MutationObserver is async
+    await waitFor(() => expect(added).toHaveAttribute('aria-hidden', 'true'));
+    expect(addedToInner).toHaveAttribute('aria-hidden', 'true');
