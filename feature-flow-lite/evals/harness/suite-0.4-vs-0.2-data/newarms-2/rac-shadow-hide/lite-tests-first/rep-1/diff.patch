+      revert();
+    });
+
+    it('hides a light DOM sibling of the target that is slotted into the same slot', function () {
+      let host = addToBody(document.createElement('div'));
+      host.attachShadow({mode: 'open'}).innerHTML = '<slot></slot>';
+      let button = document.createElement('button');
+      let sibling = document.createElement('input');
+      host.append(button, sibling);
+
+      let revert = ariaHideOutside([button]);
+
+      expect(sibling).toHaveAttribute('aria-hidden', 'true');
+      expect(button).not.toHaveAttribute('aria-hidden');
+      expect(host).not.toHaveAttribute('aria-hidden');
+
+      revert();
+    });
+
+    it('hides a light DOM sibling of the target that is slotted into a different slot', function () {
+      let host = addToBody(document.createElement('div'));
+      host.attachShadow({mode: 'open'}).innerHTML = '<slot name="first"></slot><slot id="second"></slot>';
+      let button = document.createElement('button');
