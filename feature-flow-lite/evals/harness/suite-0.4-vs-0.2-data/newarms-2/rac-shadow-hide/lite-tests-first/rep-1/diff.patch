+
+  describe('with shouldUseInert in shadow roots', function () {
+    let ariaHideOutsideWithInert;
+    beforeAll(function () {
+      // jsdom does not implement inert, so define it before the module checks for support.
+      Object.defineProperty(HTMLElement.prototype, 'inert', {configurable: true, writable: true, value: false});
+      jest.isolateModules(function () {
+        require('@react-stately/flags').enableShadowDOM();
+        ariaHideOutsideWithInert = require('../src').ariaHideOutside;
+      });
+    });
+
+    afterAll(function () {
+      delete HTMLElement.prototype.inert;
+    });
+
+    it('sets inert instead of aria-hidden on shadow root content', async function () {
+      let shadow = createShadow();
+      shadow.shadowRoot.innerHTML = '<button>Button</button><input type="checkbox" />';
+      let button = shadow.shadowRoot.querySelector('button');
+      let checkbox = shadow.shadowRoot.querySelector('input');
+
+      let revert = ariaHideOutsideWithInert([button], {shouldUseInert: true});
+
+      expect(checkbox.inert).toBe(true);
+      expect(checkbox).not.toHaveAttribute('aria-hidden');
+      expect(button.inert).toBe(false);
+
+      let radio = document.createElement('input');
+      radio.type = 'radio';
+      shadow.shadowRoot.appendChild(radio);
+      await waitFor(() => expect(radio.inert).toBe(true));
+
+      revert();
+      expect(checkbox.inert).toBe(false);
+      expect(radio.inert).toBe(false);
+    });
+  });
