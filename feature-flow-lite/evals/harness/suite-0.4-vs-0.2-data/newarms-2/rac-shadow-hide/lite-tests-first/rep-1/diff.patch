+      revert();
+    });
+
+    it('hides the sibling of a target reached through a slot in an outer shadow root, but not the hosts or wrapper on the path', function () {
+      let outer = addToBody(document.createElement('div'));
+      let outerShadow = outer.attachShadow({mode: 'open'});
+      outerShadow.innerHTML = '<div id="wrapper"><slot></slot></div><i id="sib"></i>';
+      let wrapper = outerShadow.querySelector('#wrapper');
+      let sib = outerShadow.querySelector('#sib');
+      let inner = document.createElement('div');
+      outer.appendChild(inner);
+      inner.attachShadow({mode: 'open'}).innerHTML = '<slot></slot>';
+      let button = document.createElement('button');
+      inner.appendChild(button);
+
+      let revert = ariaHideOutside([button]);
+
+      expect(sib).toHaveAttribute('aria-hidden', 'true');
+      expect(wrapper).not.toHaveAttribute('aria-hidden');
+      expect(outer).not.toHaveAttribute('aria-hidden');
+      expect(inner).not.toHaveAttribute('aria-hidden');
+      expect(button).not.toHaveAttribute('aria-hidden');
