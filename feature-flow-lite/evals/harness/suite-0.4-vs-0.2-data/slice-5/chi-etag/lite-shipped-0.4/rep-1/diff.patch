+func TestETagSecondWriteHeaderIgnored(t *testing.T) {
+	rec := etagRequest(http.MethodGet, nil, func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusCreated)
+		w.WriteHeader(http.StatusInternalServerError)
+		w.Write([]byte("body"))
+	})
+	if rec.Code != http.StatusCreated || rec.Body.String() != "body" {
+		t.Fatalf("got %d %q, want 201 \"body\"", rec.Code, rec.Body.String())
+	}
+}
+
+func TestETagHeadersAfterWriteHeaderIgnored(t *testing.T) {
+	rec := etagRequest(http.MethodGet, nil, func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("X-A", "1")
+		w.WriteHeader(http.StatusOK)
+		w.Header().Set("X-A", "2")
+		w.Header().Set("X-B", "3")
+		w.Write([]byte("body"))
+	})
+	if got := rec.Header().Get("X-A"); got != "1" {
+		t.Fatalf("X-A = %q, want the value at WriteHeader", got)
+	}
+	if _, ok := rec.Header()["X-B"]; ok {
+		t.Fatal("X-B set after WriteHeader was sent")
+	}
+	if got := rec.Header().Get("ETag"); got != strongETag([]byte("body")) {
+		t.Fatalf("ETag = %q, want ETag of the body", got)
+	}
+}
