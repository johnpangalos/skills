+func TestETagServeContentHead(t *testing.T) {
+	serve := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		http.ServeContent(w, r, "resource.txt", time.Time{}, strings.NewReader("hello"))
+	})
+
+	head := etagRequest(http.MethodHead, nil, serve)
+	if got := head.Header().Get("ETag"); got != "" {
+		t.Fatalf("HEAD ETag = %q, want none", got)
+	}
+	if head.Body.Len() != 0 {
+		t.Fatalf("HEAD body = %q, want empty", head.Body.String())
+	}
+
+	get := etagRequest(http.MethodGet, nil, serve)
+	if got := get.Header().Get("ETag"); got != strongETag([]byte("hello")) {
+		t.Fatalf("GET ETag = %q, want ETag of the body", got)
+	}
+}
