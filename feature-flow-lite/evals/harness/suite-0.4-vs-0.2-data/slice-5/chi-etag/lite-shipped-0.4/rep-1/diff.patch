+func TestETagTrailersReachClient(t *testing.T) {
+	for _, code := range []int{http.StatusOK, http.StatusNotFound} {
+		ts := httptest.NewServer(ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Trailer", "X-T")
+			w.WriteHeader(code)
+			w.Write([]byte("hello"))
+			w.Header().Set("X-T", "a")
+			w.Header().Set(http.TrailerPrefix+"X-Late", "b")
+		})))
+
+		resp, body := testRequest(t, ts, http.MethodGet, "/", nil)
+		ts.Close()
+		if resp.StatusCode != code || body != "hello" {
+			t.Fatalf("got %d %q, want %d \"hello\"", resp.StatusCode, body, code)
+		}
+		if got := resp.Trailer.Get("X-T"); got != "a" {
+			t.Fatalf("%d: trailer X-T = %q, want \"a\"", code, got)
+		}
+		if got := resp.Trailer.Get("X-Late"); got != "b" {
+			t.Fatalf("%d: trailer X-Late = %q, want \"b\"", code, got)
+		}
+	}
+}
