+// deadlineRecorder is a ResponseRecorder that records deadlines and full duplex.
+type deadlineRecorder struct {
+	*httptest.ResponseRecorder
+	writeDeadline time.Time
+	readDeadline  time.Time
+	fullDuplex    bool
+}
+
+func (d *deadlineRecorder) SetWriteDeadline(t time.Time) error {
+	d.writeDeadline = t
+	return nil
+}
+
+func (d *deadlineRecorder) SetReadDeadline(t time.Time) error {
+	d.readDeadline = t
+	return nil
+}
+
+func (d *deadlineRecorder) EnableFullDuplex() error {
+	d.fullDuplex = true
+	return nil
+}
+
+func TestETagForwardsDeadlinesAndFullDuplex(t *testing.T) {
+	dr := &deadlineRecorder{ResponseRecorder: httptest.NewRecorder()}
+	want := time.Date(2030, 1, 2, 3, 4, 5, 0, time.UTC)
+	ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		rc := http.NewResponseController(w)
+		if err := rc.SetWriteDeadline(want); err != nil {
+			t.Error(err)
+		}
+		if err := rc.SetReadDeadline(want); err != nil {
+			t.Error(err)
+		}
+		if err := rc.EnableFullDuplex(); err != nil {
+			t.Error(err)
+		}
+		w.Write([]byte("hello"))
+	})).ServeHTTP(dr, httptest.NewRequest(http.MethodGet, "/resource", nil))
+	if !dr.writeDeadline.Equal(want) || !dr.readDeadline.Equal(want) || !dr.fullDuplex {
+		t.Fatalf("deadlines %v %v full duplex %v, want forwarded", dr.writeDeadline, dr.readDeadline, dr.fullDuplex)
+	}
+}
+
+func TestETagDeadlinesNotSupported(t *testing.T) {
+	var errs []error
+	etagRequest(http.MethodGet, nil, func(w http.ResponseWriter, r *http.Request) {
+		rc := http.NewResponseController(w)
+		errs = append(errs, rc.SetWriteDeadline(time.Now()), rc.SetReadDeadline(time.Now()), rc.EnableFullDuplex())
+	})
+	for i, err := range errs {
+		if !errors.Is(err, http.ErrNotSupported) {
+			t.Fatalf("call %d error = %v, want feature not supported", i, err)
+		}
+	}
+}
