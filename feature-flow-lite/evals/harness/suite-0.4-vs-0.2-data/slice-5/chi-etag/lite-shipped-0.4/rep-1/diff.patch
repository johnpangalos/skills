+func TestETagEarlyHintsSendHeaders(t *testing.T) {
+	ts := httptest.NewServer(ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Link", "</style.css>; rel=preload")
+		w.WriteHeader(http.StatusEarlyHints)
+		w.Write([]byte("hello"))
+	})))
+	defer ts.Close()
+
+	var code int
+	var hints textproto.MIMEHeader
+	trace := &httptrace.ClientTrace{
+		Got1xxResponse: func(c int, h textproto.MIMEHeader) error {
+			code, hints = c, h
+			return nil
+		},
+	}
+	req, err := http.NewRequestWithContext(httptrace.WithClientTrace(context.Background(), trace), http.MethodGet, ts.URL, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp, err := http.DefaultClient.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp.Body.Close()
+
+	if code != http.StatusEarlyHints || hints.Get("Link") != "</style.css>; rel=preload" {
+		t.Fatalf("got 1xx %d with Link %q, want 103 with the handler's Link", code, hints.Get("Link"))
+	}
+	if resp.StatusCode != http.StatusOK {
+		t.Fatalf("final status = %d, want 200", resp.StatusCode)
+	}
+}
