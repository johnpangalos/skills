diff --git a/middleware/etag.go b/middleware/etag.go
new file mode 100644
index 0000000..5ef7abd
--- /dev/null
+++ b/middleware/etag.go
@@ -0,0 +1,222 @@
+package middleware
+
+import (
+	"bufio"
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"maps"
+	"net"
+	"net/http"
+	"strconv"
+	"strings"
+)
+
+// ETag is a middleware that adds a strong ETag to GET and HEAD responses with
+// status 200 that do not set one themselves. The tag is the quoted hex SHA-256
+// of the body. If the request's If-None-Match matches the response's ETag,
+// ETag responds 304 Not Modified with no body instead.
+//
+// The response of GET and HEAD requests is buffered in memory until the
+// handler returns. Other methods, and responses with any status other than
+// 200, pass through unchanged.
+func ETag(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet && r.Method != http.MethodHead {
+			next.ServeHTTP(w, r)
+			return
+		}
+		ew := &etagResponseWriter{ResponseWriter: w}
+		next.ServeHTTP(ew, r)
+		ew.send(r)
+	})
+}
+
+// etagResponseWriter holds the status, headers and body of a response until
+// the handler returns, so that send can decide how to write it.
+type etagResponseWriter struct {
+	http.ResponseWriter
+
+	status      int
+	wroteHeader bool
+	// headers is a copy of the response headers taken when the header was
+	// written, so that changes made after that point are ignored as in net/http.
+	headers  http.Header
+	body     bytes.Buffer
+	hijacked bool
+}
+
+func (cw *etagResponseWriter) WriteHeader(code int) {
+	if cw.wroteHeader {
+		return
+	}
+	if code >= 100 && code <= 199 && code != http.StatusSwitchingProtocols {
+		// Informational responses are sent now and do not end the response.
+		cw.ResponseWriter.WriteHeader(code)
+		return
+	}
+	cw.wroteHeader = true
+	cw.status = code
+	cw.headers = cw.ResponseWriter.Header().Clone()
+}
+
+func (cw *etagResponseWriter) Write(p []byte) (int, error) {
+	if cw.hijacked {
+		return 0, http.ErrHijacked
+	}
+	cw.WriteHeader(http.StatusOK)
+	return cw.body.Write(p)
+}
+
+// Flush is a no-op: the buffered response is only sent once the handler returns.
+func (cw *etagResponseWriter) Flush() {}
+
+func (cw *etagResponseWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	hj, ok := cw.ResponseWriter.(http.Hijacker)
+	if !ok {
+		return nil, nil, errors.New("chi/middleware: http.Hijacker is unavailable on the writer")
+	}
+	conn, rw, err := hj.Hijack()
+	cw.hijacked = err == nil
+	return conn, rw, err
+}
+
+func (cw *etagResponseWriter) Push(target string, opts *http.PushOptions) error {
+	if ps, ok := cw.ResponseWriter.(http.Pusher); ok {
+		return ps.Push(target, opts)
+	}
+	return http.ErrNotSupported
+}
+
+func (cw *etagResponseWriter) Unwrap() http.ResponseWriter {
+	return cw.ResponseWriter
+}
+
+// send writes the buffered response to the underlying writer, adding the ETag
+// and answering 304 when If-None-Match matches it.
+func (cw *etagResponseWriter) send(r *http.Request) {
+	if cw.hijacked {
+		return
+	}
+	cw.WriteHeader(http.StatusOK)
+	h := cw.headers
+	if cw.status == http.StatusOK {
+		// A HEAD response has no body to hash unless the handler wrote one.
+		if h.Get("ETag") == "" && (r.Method == http.MethodGet || cw.body.Len() > 0) {
+			sum := sha256.Sum256(cw.body.Bytes())
+			h.Set("ETag", `"`+hex.EncodeToString(sum[:])+`"`)
+		}
+		if etagMatches(r.Header.Values("If-None-Match"), h.Get("ETag")) {
+			h.Del("Content-Type")
+			h.Del("Content-Length")
+			h.Del("Content-Encoding")
+			h.Del("Last-Modified")
+			cw.status = http.StatusNotModified
+			cw.body.Reset()
+		}
+	}
+	if r.Method == http.MethodHead && cw.body.Len() > 0 && bodyAllowed(cw.status) {
+		// The body is not sent for HEAD, but its type and length are still advertised.
+		if _, ok := h["Content-Type"]; !ok {
+			h.Set("Content-Type", http.DetectContentType(cw.body.Bytes()))
+		}
+		if _, ok := h["Content-Length"]; !ok {
+			h.Set("Content-Length", strconv.Itoa(cw.body.Len()))
+		}
+	}
+	// Trailers may be set after the body, so their live values are read now and
+	// set again once the body is written, keeping them out of the header block.
+	dst := cw.ResponseWriter.Header()
+	trailers := http.Header{}
+	for k, v := range dst {
+		if isTrailer(k, h) {
+			trailers[k] = v
+		}
+	}
+	clear(dst)
+	for k, v := range h {
+		if !isTrailer(k, h) {
+			dst[k] = v
+		}
+	}
+	cw.ResponseWriter.WriteHeader(cw.status)
+	if r.Method != http.MethodHead {
+		cw.ResponseWriter.Write(cw.body.Bytes())
+	}
+	maps.Copy(dst, trailers)
+}
+
+// bodyAllowed reports whether a response with the status code may have a body,
+// as in net/http: none for 1xx, 204 and 304.
+func bodyAllowed(code int) bool {
+	return (code < 100 || code > 199) && code != http.StatusNoContent && code != http.StatusNotModified
+}
+
+// isTrailer reports whether key is a trailer of a response with headers h, either
+// declared in its Trailer header or written with the http.TrailerPrefix.
+func isTrailer(key string, h http.Header) bool {
+	if strings.HasPrefix(key, http.TrailerPrefix) {
+		return true
+	}
+	for _, v := range h.Values("Trailer") {
+		for _, name := range strings.Split(v, ",") {
+			if http.CanonicalHeaderKey(strings.TrimSpace(name)) == key {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// etagMatches reports whether any entity-tag in the If-None-Match header values
+// matches etag using weak comparison, as in RFC 9110 section 13.1.2. A "*" matches
+// any current representation.
+func etagMatches(ifNoneMatch []string, etag string) bool {
+	want, ok := opaqueETag(etag)
+	for _, value := range ifNoneMatch {
+		if strings.TrimSpace(value) == "*" {
+			return etag != ""
+		}
+		for rest := value; rest != ""; {
+			var member string
+			member, rest = splitETagMember(rest)
+			if tag, valid := opaqueETag(member); ok && valid && tag == want {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// splitETagMember returns the first comma-separated member of an If-None-Match
+// value and the remainder after its comma. Commas inside quotes do not separate.
+func splitETagMember(s string) (string, string) {
+	inQuote := false
+	for i := 0; i < len(s); i++ {
+		switch s[i] {
+		case '"':
+			inQuote = !inQuote
+		case ',':
+			if !inQuote {
+				return s[:i], s[i+1:]
+			}
+		}
+	}
+	return s, ""
+}
+
+// opaqueETag returns the opaque-tag of an entity-tag, ignoring surrounding
+// whitespace and a "W/" weak prefix. It reports false if s is not a well-formed
+// entity-tag.
+func opaqueETag(s string) (string, bool) {
+	s = strings.TrimPrefix(strings.Trim(s, " \t"), "W/")
+	if len(s) < 2 || s[0] != '"' || s[len(s)-1] != '"' {
+		return "", false
+	}
+	tag := s[1 : len(s)-1]
+	if strings.Contains(tag, `"`) {
+		return "", false
+	}
+	return tag, true
+}
diff --git a/middleware/etag_test.go b/middleware/etag_test.go
new file mode 100644
index 0000000..69ccd47
--- /dev/null
+++ b/middleware/etag_test.go
@@ -0,0 +1,652 @@
+package middleware
+
+import (
+	"bufio"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/http/httptrace"
+	"net/textproto"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func sha256ETag(body string) string {
+	sum := sha256.Sum256([]byte(body))
+	return `"` + hex.EncodeToString(sum[:]) + `"`
+}
+
+func serveETagged(handler http.HandlerFunc, method string, ifNoneMatch ...string) *httptest.ResponseRecorder {
+	rec := httptest.NewRecorder()
+	req := httptest.NewRequest(method, "/", nil)
+	for _, v := range ifNoneMatch {
+		req.Header.Add("If-None-Match", v)
+	}
+	ETag(handler).ServeHTTP(rec, req)
+	return rec
+}
+
+func writeBody(body string) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte(body))
+	}
+}
+
+// etagTestWriter adds Hijack and Push to the recorder so the optional
+// interfaces can be forwarded.
+type etagTestWriter struct {
+	*httptest.ResponseRecorder
+	hijacked bool
+	pushed   string
+}
+
+func (w *etagTestWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	w.hijacked = true
+	return nil, nil, nil
+}
+
+func (w *etagTestWriter) Push(target string, _ *http.PushOptions) error {
+	w.pushed = target
+	return nil
+}
+
+func TestETagGeneratesStrongTag(t *testing.T) {
+	rec := serveETagged(writeBody("hello"), http.MethodGet)
+	if got, want := rec.Header().Get("ETag"), sha256ETag("hello"); got != want {
+		t.Fatalf("ETag = %q, want %q", got, want)
+	}
+	if rec.Code != http.StatusOK || rec.Body.String() != "hello" {
+		t.Fatalf("got %d %q, want 200 \"hello\"", rec.Code, rec.Body.String())
+	}
+}
+
+func TestETagSameBodySameTagDifferentBodyDifferentTag(t *testing.T) {
+	a := serveETagged(writeBody("one"), http.MethodGet).Header().Get("ETag")
+	b := serveETagged(writeBody("one"), http.MethodGet).Header().Get("ETag")
+	c := serveETagged(writeBody("two"), http.MethodGet).Header().Get("ETag")
+	if a != b {
+		t.Fatalf("same body gave different tags: %q and %q", a, b)
+	}
+	if a == c {
+		t.Fatalf("different bodies gave the same tag %q", a)
+	}
+}
+
+func TestETagNoWriteUsesEmptyBodyTag(t *testing.T) {
+	rec := serveETagged(func(http.ResponseWriter, *http.Request) {}, http.MethodGet)
+	if got, want := rec.Header().Get("ETag"), sha256ETag(""); got != want {
+		t.Fatalf("ETag = %q, want %q", got, want)
+	}
+	if rec.Code != http.StatusOK {
+		t.Fatalf("code = %d, want 200", rec.Code)
+	}
+}
+
+func TestETagMultipleWritesHashAllBytes(t *testing.T) {
+	rec := serveETagged(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("he"))
+		w.Write([]byte("llo"))
+	}, http.MethodGet)
+	if got, want := rec.Header().Get("ETag"), sha256ETag("hello"); got != want {
+		t.Fatalf("ETag = %q, want %q", got, want)
+	}
+	if rec.Body.String() != "hello" {
+		t.Fatalf("body = %q, want \"hello\"", rec.Body.String())
+	}
+}
+
+func TestETagFirstWriteHeaderWins(t *testing.T) {
+	rec := serveETagged(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusCreated)
+		w.WriteHeader(http.StatusInternalServerError)
+		w.Write([]byte("x"))
+	}, http.MethodGet)
+	if rec.Code != http.StatusCreated {
+		t.Fatalf("code = %d, want 201", rec.Code)
+	}
+	if got := rec.Header().Get("ETag"); got != "" {
+		t.Fatalf("ETag = %q, want none for a 201", got)
+	}
+}
+
+func TestETagHandlerSetTagIsKept(t *testing.T) {
+	for _, tag := range []string{`W/"x"`, `"custom"`} {
+		rec := serveETagged(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("ETag", tag)
+			w.Write([]byte("body"))
+		}, http.MethodGet)
+		if got := rec.Header().Get("ETag"); got != tag {
+			t.Fatalf("ETag = %q, want %q", got, tag)
+		}
+	}
+}
+
+func TestETagHeaderSetAfterWriteIsIgnored(t *testing.T) {
+	rec := serveETagged(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("hello"))
+		w.Header().Set("ETag", `"late"`)
+	}, http.MethodGet)
+	if got, want := rec.Header().Get("ETag"), sha256ETag("hello"); got != want {
+		t.Fatalf("ETag = %q, want %q", got, want)
+	}
+}
+
+func TestETagHeadSendsNoBodyButKeepsLength(t *testing.T) {
+	rec := serveETagged(writeBody("hello"), http.MethodHead)
+	if got, want := rec.Header().Get("ETag"), sha256ETag("hello"); got != want {
+		t.Fatalf("ETag = %q, want %q", got, want)
+	}
+	if rec.Body.Len() != 0 {
+		t.Fatalf("HEAD body = %q, want empty", rec.Body.String())
+	}
+	if got := rec.Header().Get("Content-Length"); got != "5" {
+		t.Fatalf("Content-Length = %q, want \"5\"", got)
+	}
+}
+
+func TestETagNotModifiedDropsRepresentationHeaders(t *testing.T) {
+	handler := func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "text/plain")
+		w.Header().Set("Content-Length", "5")
+		w.Header().Set("Content-Encoding", "identity")
+		w.Header().Set("Cache-Control", "max-age=60")
+		w.Header().Set("Vary", "Accept")
+		w.Header().Set("Expires", "Wed, 01 Jan 2031 00:00:00 GMT")
+		w.Write([]byte("hello"))
+	}
+	rec := serveETagged(handler, http.MethodGet, sha256ETag("hello"))
+	if rec.Code != http.StatusNotModified {
+		t.Fatalf("code = %d, want 304", rec.Code)
+	}
+	if rec.Body.Len() != 0 {
+		t.Fatalf("304 body = %q, want empty", rec.Body.String())
+	}
+	if got := rec.Header().Get("ETag"); got != sha256ETag("hello") {
+		t.Fatalf("ETag = %q, want it kept", got)
+	}
+	for _, h := range []string{"Content-Type", "Content-Length", "Content-Encoding"} {
+		if _, ok := rec.Header()[h]; ok {
+			t.Fatalf("%s should be removed on 304", h)
+		}
+	}
+	for h, want := range map[string]string{
+		"Cache-Control": "max-age=60",
+		"Vary":          "Accept",
+		"Expires":       "Wed, 01 Jan 2031 00:00:00 GMT",
+	} {
+		if got := rec.Header().Get(h); got != want {
+			t.Fatalf("%s = %q, want %q", h, got, want)
+		}
+	}
+}
+
+func TestETagIfNoneMatchMatching(t *testing.T) {
+	// The response ETag is the handler-set strong tag "b" unless noted.
+	handler := func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("ETag", `"b"`)
+		w.Write([]byte("body"))
+	}
+	tests := []struct {
+		name        string
+		ifNoneMatch []string
+		wantCode    int
+	}{
+		{"exact match", []string{`"b"`}, http.StatusNotModified},
+		{"weak request tag matches strong", []string{`W/"b"`}, http.StatusNotModified},
+		{"list with irregular whitespace", []string{`"a" , W/"b",  "c"`}, http.StatusNotModified},
+		{"star matches any representation", []string{"*"}, http.StatusNotModified},
+		{"match on a later header line", []string{`"x"`, `"b"`}, http.StatusNotModified},
+		{"tag with comma inside quotes", []string{`"a,b", "b"`}, http.StatusNotModified},
+		{"opaque tags are case-sensitive", []string{`"B"`}, http.StatusOK},
+		{"lowercase w/ is not a weak prefix", []string{`w/"b"`}, http.StatusOK},
+		{"unquoted member does not match", []string{`b`}, http.StatusOK},
+		{"empty items do not match", []string{`,,`}, http.StatusOK},
+		{"unterminated quote does not match", []string{`"b`}, http.StatusOK},
+		{"quote-comma without match", []string{`"a,b`}, http.StatusOK},
+		{"empty header value", []string{``}, http.StatusOK},
+		{"no If-None-Match", nil, http.StatusOK},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			rec := serveETagged(handler, http.MethodGet, tt.ifNoneMatch...)
+			if rec.Code != tt.wantCode {
+				t.Fatalf("code = %d, want %d", rec.Code, tt.wantCode)
+			}
+		})
+	}
+}
+
+func TestETagNotModifiedWithGeneratedTag(t *testing.T) {
+	first := serveETagged(writeBody("hello"), http.MethodGet)
+	rec := serveETagged(writeBody("hello"), http.MethodGet, first.Header().Get("ETag"))
+	if rec.Code != http.StatusNotModified {
+		t.Fatalf("code = %d, want 304", rec.Code)
+	}
+	if got := rec.Header().Get("ETag"); got != first.Header().Get("ETag") {
+		t.Fatalf("ETag = %q, want it kept", got)
+	}
+}
+
+func TestETagHeadNotModified(t *testing.T) {
+	rec := serveETagged(writeBody("hello"), http.MethodHead, sha256ETag("hello"))
+	if rec.Code != http.StatusNotModified || rec.Body.Len() != 0 {
+		t.Fatalf("got %d %q, want 304 with no body", rec.Code, rec.Body.String())
+	}
+}
+
+func TestETagNonGetHeadPassesThrough(t *testing.T) {
+	for _, method := range []string{http.MethodPost, http.MethodPut, http.MethodDelete} {
+		t.Run(method, func(t *testing.T) {
+			var seen http.ResponseWriter
+			rec := httptest.NewRecorder()
+			handler := func(w http.ResponseWriter, r *http.Request) {
+				seen = w
+				w.Write([]byte("hello"))
+			}
+			ETag(http.HandlerFunc(handler)).ServeHTTP(rec, httptest.NewRequest(method, "/", nil))
+			if seen != rec {
+				t.Fatalf("handler got writer %T, want the original recorder", seen)
+			}
+			if got := rec.Header().Get("ETag"); got != "" {
+				t.Fatalf("ETag = %q, want none", got)
+			}
+			if rec.Body.String() != "hello" {
+				t.Fatalf("body = %q, want \"hello\"", rec.Body.String())
+			}
+		})
+	}
+}
+
+func TestETagNonGetHeadIgnoresIfNoneMatch(t *testing.T) {
+	rec := httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodPost, "/", nil)
+	req.Header.Set("If-None-Match", "*")
+	ETag(writeBody("hello")).ServeHTTP(rec, req)
+	if rec.Code != http.StatusOK || rec.Body.String() != "hello" {
+		t.Fatalf("got %d %q, want 200 \"hello\"", rec.Code, rec.Body.String())
+	}
+}
+
+func TestETagNonOKPassesThroughUnchanged(t *testing.T) {
+	tests := []struct {
+		name string
+		code int
+		body string
+	}{
+		{"201", http.StatusCreated, "created"},
+		{"204", http.StatusNoContent, ""},
+		{"301", http.StatusMovedPermanently, ""},
+		{"404", http.StatusNotFound, "missing"},
+		{"500", http.StatusInternalServerError, "boom"},
+		{"206", http.StatusPartialContent, "part"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			handler := func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("ETag", `"abc"`)
+				w.WriteHeader(tt.code)
+				w.Write([]byte(tt.body))
+			}
+			rec := serveETagged(handler, http.MethodGet, `"abc"`)
+			if rec.Code != tt.code {
+				t.Fatalf("code = %d, want %d", rec.Code, tt.code)
+			}
+			if rec.Body.String() != tt.body {
+				t.Fatalf("body = %q, want %q", rec.Body.String(), tt.body)
+			}
+			if got := rec.Header().Get("ETag"); got != `"abc"` {
+				t.Fatalf("ETag = %q, want the handler-set value", got)
+			}
+		})
+	}
+}
+
+func TestETagNonOKWithoutTagAddsNone(t *testing.T) {
+	rec := serveETagged(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusNotFound)
+		w.Write([]byte("missing"))
+	}, http.MethodGet)
+	if got := rec.Header().Get("ETag"); got != "" {
+		t.Fatalf("ETag = %q, want none on a 404", got)
+	}
+}
+
+func TestETagFlushDoesNotSendEarly(t *testing.T) {
+	rec := httptest.NewRecorder()
+	handler := func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("partial"))
+		w.(http.Flusher).Flush()
+		if rec.Flushed || rec.Body.Len() != 0 {
+			t.Errorf("Flush sent output before the handler returned: flushed=%v body=%q", rec.Flushed, rec.Body.String())
+		}
+	}
+	ETag(http.HandlerFunc(handler)).ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/", nil))
+	if rec.Body.String() != "partial" {
+		t.Fatalf("body = %q, want \"partial\"", rec.Body.String())
+	}
+}
+
+func TestETagHijackForwarded(t *testing.T) {
