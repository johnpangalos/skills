+func TestETagTrailersMatchWithoutMiddleware(t *testing.T) {
+	handlers := map[string]http.HandlerFunc{
+		"set after write": func(w http.ResponseWriter, _ *http.Request) {
+			w.Header().Set("Trailer", "X-Sum")
+			w.Write([]byte("body"))
+			w.Header().Set("X-Sum", "abc")
+			w.Header().Set(http.TrailerPrefix+"X-Late", "zz")
+		},
+		"set before WriteHeader": func(w http.ResponseWriter, _ *http.Request) {
+			w.Header().Set("Trailer", "X-Sum")
+			w.Header().Set("X-Sum", "pre")
+			w.WriteHeader(http.StatusNotFound)
+			w.Write([]byte("body"))
+			w.Header().Set("X-Sum", "post")
+		},
+	}
+	for name, handler := range handlers {
+		t.Run(name, func(t *testing.T) {
+			// Content-Type is preset so the recorder does not sniff it differently
+			// with and without the middleware. The middleware's own ETag is dropped.
+			plain := httptest.NewRecorder()
+			plain.Header().Set("Content-Type", "text/plain; charset=utf-8")
+			handler.ServeHTTP(plain, httptest.NewRequest(http.MethodGet, "/", nil))
+			wrapped := httptest.NewRecorder()
+			wrapped.Header().Set("Content-Type", "text/plain; charset=utf-8")
+			ETag(handler).ServeHTTP(wrapped, httptest.NewRequest(http.MethodGet, "/", nil))
+
+			want, got := plain.Result(), wrapped.Result()
+			got.Header.Del("ETag")
+			if got.StatusCode != want.StatusCode {
+				t.Errorf("status = %d, want %d", got.StatusCode, want.StatusCode)
+			}
+			if !reflect.DeepEqual(got.Header, want.Header) {
+				t.Errorf("header = %v, want %v", got.Header, want.Header)
+			}
+			if !reflect.DeepEqual(got.Trailer, want.Trailer) {
+				t.Errorf("trailers = %v, want %v", got.Trailer, want.Trailer)
+			}
+		})
+	}
+}
