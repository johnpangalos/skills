+func TestETagWrapperCapabilities(t *testing.T) {
+	t.Run("unwrap", func(t *testing.T) {
+		rec := httptest.NewRecorder()
+		ew := &etagResponseWriter{ResponseWriter: rec}
+		if ew.Unwrap() != rec {
+			t.Error("Unwrap did not return the underlying writer")
+		}
+	})
+
+	t.Run("hijack unsupported", func(t *testing.T) {
+		ew := &etagResponseWriter{ResponseWriter: httptest.NewRecorder()}
+		_, _, err := ew.Hijack()
+		if err == nil || err.Error() != "chi/middleware: http.Hijacker is unavailable on the writer" {
+			t.Errorf("Hijack error = %v", err)
+		}
+	})
+
+	t.Run("hijack forwarded and later writes rejected", func(t *testing.T) {
+		under := &etagHijackRecorder{ResponseRecorder: httptest.NewRecorder()}
+		var writeErr error
+		ETag(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+			if _, _, err := w.(http.Hijacker).Hijack(); err != nil {
+				t.Errorf("Hijack: %v", err)
+			}
+			_, writeErr = w.Write([]byte("late"))
+		})).ServeHTTP(under, httptest.NewRequest(http.MethodGet, "/", nil))
+		if !under.hijacked {
+			t.Error("Hijack was not forwarded")
+		}
+		if !errors.Is(writeErr, http.ErrHijacked) {
+			t.Errorf("Write after Hijack error = %v, want http.ErrHijacked", writeErr)
+		}
+		if under.Body.Len() != 0 {
+			t.Errorf("body written after Hijack: %q", under.Body.String())
+		}
+	})
+
+	t.Run("push unsupported", func(t *testing.T) {
+		ew := &etagResponseWriter{ResponseWriter: httptest.NewRecorder()}
+		if err := ew.Push("/x", nil); !errors.Is(err, http.ErrNotSupported) {
+			t.Errorf("Push error = %v, want http.ErrNotSupported", err)
+		}
+	})
+
+	t.Run("push forwarded", func(t *testing.T) {
+		under := &etagPushRecorder{ResponseRecorder: httptest.NewRecorder()}
+		ETag(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+			w.(http.Pusher).Push("/style.css", nil)
+		})).ServeHTTP(under, httptest.NewRequest(http.MethodGet, "/", nil))
+		if under.pushed != "/style.css" {
+			t.Errorf("pushed = %q, want /style.css", under.pushed)
+		}
+	})
+}
+
+type etagHijackRecorder struct {
+	*httptest.ResponseRecorder
+	hijacked bool
+}
+
+func (h *etagHijackRecorder) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	h.hijacked = true
+	return nil, nil, nil
+}
+
+type etagPushRecorder struct {
+	*httptest.ResponseRecorder
+	pushed string
+}
+
+func (p *etagPushRecorder) Push(target string, _ *http.PushOptions) error {
+	p.pushed = target
+	return nil
+}
