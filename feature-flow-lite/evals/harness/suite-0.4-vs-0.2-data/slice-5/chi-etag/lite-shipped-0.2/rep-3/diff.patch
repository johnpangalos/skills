+func TestETagUnsupportedWriterErrors(t *testing.T) {
+	rec := httptest.NewRecorder()
+	var hijackErr, pushErr error
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, _, hijackErr = w.(http.Hijacker).Hijack()
+		pushErr = w.(http.Pusher).Push("/style.css", nil)
+		if w.(interface{ Unwrap() http.ResponseWriter }).Unwrap() != rec {
+			t.Error("Unwrap did not return the original writer")
+		}
+	}))
+	h.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/", nil))
+	if hijackErr == nil || hijackErr.Error() != "chi/middleware: http.Hijacker is unavailable on the writer" {
+		t.Errorf("Hijack error = %v", hijackErr)
+	}
+	if pushErr == nil || pushErr.Error() != "chi/middleware: http.Pusher is unavailable on the writer" {
+		t.Errorf("Push error = %v", pushErr)
+	}
+}
+
+func TestETagPanicWritesNothing(t *testing.T) {
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("partial"))
+		panic("boom")
+	}))
+	rec := httptest.NewRecorder()
+	func() {
+		defer func() {
+			if rvr := recover(); rvr != "boom" {
+				t.Errorf("recovered %v, want the handler's panic", rvr)
+			}
+		}()
+		h.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/", nil))
+	}()
+	if rec.Body.Len() != 0 || rec.Header().Get("ETag") != "" || rec.Flushed {
+		t.Errorf("body %q, ETag %q, flushed %v after panic, want nothing written", rec.Body.String(), rec.Header().Get("ETag"), rec.Flushed)
+	}
+}
