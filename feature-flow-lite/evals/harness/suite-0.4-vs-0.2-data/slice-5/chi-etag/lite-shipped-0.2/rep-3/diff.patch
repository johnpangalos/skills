+func TestETagFlushStreams(t *testing.T) {
+	ts := etagServer(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("a"))
+		w.(http.Flusher).Flush()
+		w.Write([]byte("b"))
+	}))
+	resp, body := etagGet(t, ts, http.MethodGet)
+	if resp.StatusCode != http.StatusOK || body != "ab" || resp.Header.Get("ETag") != "" {
+		t.Errorf("got %d %q ETag %q, want 200 \"ab\" and no ETag", resp.StatusCode, body, resp.Header.Get("ETag"))
+	}
+
+	// Once streaming, a matching If-None-Match does not produce a 304.
+	ts = etagServer(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("ETag", `"x"`)
+		w.Write([]byte("a"))
+		w.(http.Flusher).Flush()
+		w.Write([]byte("b"))
+	}))
+	resp, body = etagGet(t, ts, http.MethodGet, `"x"`)
+	if resp.StatusCode != http.StatusOK || body != "ab" {
+		t.Errorf("got %d %q, want 200 \"ab\"", resp.StatusCode, body)
+	}
+}
