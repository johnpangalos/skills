+func TestETagHijackAndPush(t *testing.T) {
+	probe := func(w http.ResponseWriter) (hijackErr, pushErr error) {
+		_, _, hijackErr = w.(http.Hijacker).Hijack()
+		pushErr = w.(http.Pusher).Push("/x", nil)
+		return hijackErr, pushErr
+	}
+
+	t.Run("unsupported", func(t *testing.T) {
+		var hijackErr, pushErr error
+		h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			hijackErr, pushErr = probe(w)
+		})
+		etagServe(h, http.MethodGet)
+		if hijackErr == nil || hijackErr.Error() != "chi/middleware: http.Hijacker is unavailable on the writer" {
+			t.Fatalf("Hijack error = %v, want the unavailable error", hijackErr)
+		}
+		if pushErr == nil || pushErr.Error() != "chi/middleware: http.Pusher is unavailable on the writer" {
+			t.Fatalf("Push error = %v, want the unavailable error", pushErr)
+		}
+	})
+
+	t.Run("forwarded", func(t *testing.T) {
+		var hijackErr, pushErr error
+		h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			hijackErr, pushErr = probe(w)
+		})
+		req := httptest.NewRequest(http.MethodGet, "/", nil)
+		ETag(h).ServeHTTP(etagOptionalWriter{httptest.NewRecorder()}, req)
+		if hijackErr != errEtagHijack {
+			t.Fatalf("Hijack error = %v, want the forwarded error", hijackErr)
+		}
+		if pushErr != errEtagPush {
+			t.Fatalf("Push error = %v, want the forwarded error", pushErr)
+		}
+	})
+}
