+// etagRawExchange serves h behind ETag over a real server, sends one GET by hand,
+// and returns the bytes read until the server closes the connection, along with
+// whatever the server logged.
+func etagRawExchange(t *testing.T, h http.Handler) (string, string) {
+	t.Helper()
+	var logs bytes.Buffer
+	done := make(chan struct{})
+	ts := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		ETag(h).ServeHTTP(w, r)
+		// Closed after the middleware returns, so its log lines are written before they are read.
+		close(done)
+	}))
+	ts.Config.ErrorLog = log.New(&logs, "", 0)
+	ts.Start()
+	defer ts.Close()
+
+	conn, err := net.Dial("tcp", ts.Listener.Addr().String())
+	if err != nil {
+		t.Fatalf("dial: %v", err)
+	}
+	defer conn.Close()
+	conn.SetDeadline(time.Now().Add(5 * time.Second))
+	if _, err := io.WriteString(conn, "GET / HTTP/1.1\r\nHost: x\r\n\r\n"); err != nil {
+		t.Fatalf("write request: %v", err)
+	}
+	wire, err := io.ReadAll(conn)
+	if err != nil {
+		t.Fatalf("read response: %v", err)
+	}
+	select {
+	case <-done:
+	case <-time.After(5 * time.Second):
+		t.Fatalf("handler did not return")
+	}
+	return string(wire), logs.String()
+}
+
+func TestETagHijackAfterWriteSendsHeaders(t *testing.T) {
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		io.WriteString(w, "PREFIX")
+		conn, _, err := w.(http.Hijacker).Hijack()
+		if err != nil {
+			t.Errorf("Hijack: %v", err)
+			return
+		}
+		io.WriteString(conn, "RAW")
+		conn.Close()
+	})
+	wire, logged := etagRawExchange(t, h)
+	if !strings.HasPrefix(wire, "HTTP/1.1 200 OK") || !strings.HasSuffix(wire, "\r\n\r\nRAW") {
+		// net/http flushes only the status line and headers on Hijack, dropping buffered body bytes.
+		t.Fatalf("wire = %q, want a 200 status line and headers, then RAW", wire)
+	}
+	if strings.Contains(logged, "hijacked connection") {
+		t.Fatalf("server logged %q, want no hijacked connection text", logged)
+	}
+}
