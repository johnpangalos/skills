+func TestETag_ConcurrentRequestsAreIsolated(t *testing.T) {
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte(r.URL.Path))
+	}))
+
+	var wg sync.WaitGroup
+	for i := 0; i < 50; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			path := fmt.Sprintf("/%d", i)
+			rec := httptest.NewRecorder()
+			h.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, path, http.NoBody))
+			if got, want := rec.Header().Get("ETag"), etagOf(path); got != want {
+				t.Errorf("ETag for %s: got %q, want %q", path, got, want)
+			}
+			if rec.Body.String() != path {
+				t.Errorf("body for %s: got %q", path, rec.Body.String())
+			}
+		}(i)
+	}
+	wg.Wait()
+}
