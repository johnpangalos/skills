+func TestETag_HijackAfterWriteSendsBufferedBytesFirst(t *testing.T) {
+	srv := httptest.NewServer(ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("buffered"))
+		conn, brw, err := w.(http.Hijacker).Hijack()
+		if err != nil {
+			t.Error(err)
+			return
+		}
+		defer conn.Close()
+		brw.WriteString("RAW")
+		brw.Flush()
+	})))
+	defer srv.Close()
+
+	got := rawGET(t, srv.Listener.Addr().String())
+	i, j := strings.Index(got, "buffered"), strings.Index(got, "RAW")
+	if i < 0 || j < 0 || i > j {
+		t.Errorf("response: got %q, want buffered bytes before raw bytes", got)
+	}
+}
