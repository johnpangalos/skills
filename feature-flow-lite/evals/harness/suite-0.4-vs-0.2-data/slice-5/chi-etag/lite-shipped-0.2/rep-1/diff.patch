+func TestETag_HijackWithNothingWrittenSendsNoStatus(t *testing.T) {
+	const raw = "HTTP/1.1 101 Switching Protocols\r\nConnection: Upgrade\r\nUpgrade: raw\r\n\r\n"
+	srv := httptest.NewServer(ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		conn, brw, err := w.(http.Hijacker).Hijack()
+		if err != nil {
+			t.Error(err)
+			return
+		}
+		defer conn.Close()
+		brw.WriteString(raw)
+		brw.Flush()
+	})))
+	defer srv.Close()
+
+	if got := rawGET(t, srv.Listener.Addr().String()); got != raw {
+		t.Errorf("response: got %q, want only the raw response %q", got, raw)
+	}
+}
