+func TestETag_SwitchingProtocolsIsFinalStatus(t *testing.T) {
+	srv := httptest.NewServer(ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusSwitchingProtocols)
+	})))
+	defer srv.Close()
+
+	got := rawGET(t, srv.Listener.Addr().String())
+	if !strings.HasPrefix(got, "HTTP/1.1 101 Switching Protocols\r\n") {
+		t.Errorf("response: got %q, want a 101 status line first", got)
+	}
+	if n := strings.Count(got, "HTTP/1.1 "); n != 1 {
+		t.Errorf("status lines: got %d, want 1 in %q", n, got)
+	}
+}
