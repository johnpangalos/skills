+"""Stock on hand and reservations, safe to call from many threads at once."""
+
+import threading
+from dataclasses import dataclass
+
+from shop.catalog import PRODUCTS, UnknownProduct
+
+
+class OutOfStock(ValueError):
+    pass
+
+
+class ReservationError(ValueError):
+    pass
+
+
+@dataclass(frozen=True, eq=False)  # eq=False: compared and hashed by identity
+class Reservation:
+    sku: str
+    qty: int
+
+
+def _require_catalog_sku(sku):
+    try:
+        known = sku in PRODUCTS
+    except TypeError:  # unhashable, e.g. a list
+        known = False
+    if not known:
+        raise UnknownProduct(sku)
+
+
+class Inventory:
+    def __init__(self, stock):
+        for sku, units in stock.items():
+            if isinstance(units, bool) or not isinstance(units, int) or units < 0:
+                raise ValueError(f"units for {sku!r} must be a non-negative int, got {units!r}")
+        self._on_hand = dict(stock)
+        self._open = set()
+        self._lock = threading.Lock()
+
+    def available(self, sku):
+        _require_catalog_sku(sku)
+        with self._lock:
+            return self._available(sku)
+
+    def reserve(self, sku, qty):
+        _require_catalog_sku(sku)
+        if isinstance(qty, bool) or not isinstance(qty, int) or qty < 1:
+            raise ValueError(f"qty must be a positive int, got {qty!r}")
+        with self._lock:
+            free = self._available(sku)
+            if free < qty:
+                raise OutOfStock(f"only {free} {sku} available, need {qty}")
+            reservation = Reservation(sku, qty)
+            self._open.add(reservation)
+            return reservation
+
+    def commit(self, reservation):
+        with self._lock:
+            self._close(reservation)
+            self._on_hand[reservation.sku] -= reservation.qty
+
+    def release(self, reservation):
+        with self._lock:
+            self._close(reservation)
+
+    def _available(self, sku):
+        held = sum(r.qty for r in self._open if r.sku == sku)
+        return self._on_hand.get(sku, 0) - held
+
+    def _close(self, reservation):
+        # Caller holds the lock. Removing the hold here makes settling one-shot.
+        if not isinstance(reservation, Reservation) or reservation not in self._open:
+            raise ReservationError("not an open reservation of this inventory")
+        self._open.remove(reservation)
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
