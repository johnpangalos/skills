+"""Stock on hand and the reservations held against it."""
+
+import threading
+from dataclasses import dataclass
+
+from shop.catalog import lookup
+
+
+class OutOfStock(ValueError):
+    pass
+
+
+class ReservationError(ValueError):
+    pass
+
+
+@dataclass(frozen=True, eq=False)
+class Reservation:
+    sku: str
+    qty: int
+
+
+class Inventory:
+    def __init__(self, stock):
+        self._lock = threading.Lock()
+        self._on_hand = {}
+        for sku, units in stock.items():
+            if type(units) is not int or units < 0:
+                raise ValueError("units on hand must be a non-negative int")
+            self._on_hand[sku] = units
+        self._open = set()
+
+    def available(self, sku):
+        lookup(sku)
+        with self._lock:
+            return self._free(sku)
+
+    def reserve(self, sku, qty):
+        lookup(sku)
+        if type(qty) is not int or qty < 1:
+            raise ValueError("qty must be a positive int")
+        with self._lock:
+            free = self._free(sku)
+            if free < qty:
+                raise OutOfStock(f"{sku}: {free} available, {qty} requested")
+            reservation = Reservation(sku, qty)
+            self._open.add(reservation)
+            return reservation
+
+    def commit(self, reservation):
+        with self._lock:
+            self._settle(reservation)
+            self._on_hand[reservation.sku] -= reservation.qty
+
+    def release(self, reservation):
+        with self._lock:
+            self._settle(reservation)
+
+    def _settle(self, reservation):
+        # Caller holds the lock. Removing the hold here means a reservation
+        # that was already committed or released, or belongs to another
+        # Inventory, is not in the set and is rejected.
+        if reservation not in self._open:
+            raise ReservationError("reservation is not open for this inventory")
+        self._open.remove(reservation)
+
+    def _free(self, sku):
+        # Caller holds the lock.
+        held = sum(r.qty for r in self._open if r.sku == sku)
+        return self._on_hand.get(sku, 0) - held
