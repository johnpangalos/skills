@@ -0,0 +1,235 @@
+import random
+import sys
+import threading
+import unittest
+
+from shop.catalog import UnknownProduct
+from shop.inventory import Inventory, OutOfStock, Reservation, ReservationError
+
+NOT_OPEN = "reservation is not open for this inventory"
+
+
+def run_together(targets):
+    """Start every callable at once; return each result, or the exception it raised."""
+    barrier = threading.Barrier(len(targets))
+    results = [None] * len(targets)
+
+    def run(i, target):
+        barrier.wait()
+        try:
+            results[i] = target()
+        except Exception as exc:
+            results[i] = exc
+
+    threads = [threading.Thread(target=run, args=(i, t)) for i, t in enumerate(targets)]
+    for thread in threads:
+        thread.start()
+    for thread in threads:
+        thread.join()
+    return results
+
+
+class InventoryTest(unittest.TestCase):
+    def setUp(self):
+        self.inv = Inventory({"BEAN-ETH": 5, "MUG": 2})
+
+    def test_available_is_on_hand(self):
+        self.assertEqual(self.inv.available("BEAN-ETH"), 5)
+
+    def test_catalog_sku_missing_from_stock_is_zero(self):
+        self.assertEqual(self.inv.available("FILTER"), 0)
+
+    def test_unknown_sku_in_available(self):
+        with self.assertRaises(UnknownProduct) as cm:
+            self.inv.available("NOPE")
+        self.assertEqual(cm.exception.args, ("NOPE",))
+
+    def test_constructor_copies_stock(self):
+        stock = {"MUG": 2}
+        inv = Inventory(stock)
+        stock["MUG"] = 99
+        stock["FILTER"] = 7
+        self.assertEqual(inv.available("MUG"), 2)
+        self.assertEqual(inv.available("FILTER"), 0)
+
+    def test_constructor_accepts_non_catalog_sku(self):
+        inv = Inventory({"NOPE": 1})
+        with self.assertRaises(UnknownProduct) as cm:
+            inv.available("NOPE")
+        self.assertEqual(cm.exception.args, ("NOPE",))
+
+    def test_constructor_rejects_bad_units(self):
+        for units in (-1, 1.5, True, "3", None):
+            with self.subTest(units=units):
+                with self.assertRaises(ValueError) as cm:
+                    Inventory({"MUG": units})
+                self.assertIs(type(cm.exception), ValueError)
+                self.assertEqual(str(cm.exception), "units on hand must be a non-negative int")
+
+    def test_reserve_returns_reservation_and_holds_units(self):
+        reservation = self.inv.reserve("BEAN-ETH", 2)
+        self.assertIsInstance(reservation, Reservation)
+        self.assertEqual(self.inv.available("BEAN-ETH"), 3)
+
+    def test_reserve_exact_available_succeeds(self):
+        self.inv.reserve("MUG", 2)
+        self.assertEqual(self.inv.available("MUG"), 0)
+
+    def test_reserve_more_than_available_raises_and_holds_nothing(self):
+        with self.assertRaises(OutOfStock) as cm:
+            self.inv.reserve("MUG", 3)
+        self.assertEqual(str(cm.exception), "MUG: 2 available, 3 requested")
+        self.assertEqual(self.inv.available("MUG"), 2)
+
+    def test_reserve_catalog_sku_missing_from_stock_is_out_of_stock(self):
+        with self.assertRaises(OutOfStock) as cm:
+            self.inv.reserve("FILTER", 1)
+        self.assertEqual(str(cm.exception), "FILTER: 0 available, 1 requested")
+
+    def test_reserve_unknown_sku(self):
+        with self.assertRaises(UnknownProduct) as cm:
+            self.inv.reserve("NOPE", 1)
+        self.assertEqual(cm.exception.args, ("NOPE",))
+
+    def test_reserve_rejects_non_positive_int_qty(self):
+        for qty in (True, 0, -1, 1.0, "2", None):
+            with self.subTest(qty=qty):
+                with self.assertRaises(ValueError) as cm:
+                    self.inv.reserve("MUG", qty)
+                self.assertIs(type(cm.exception), ValueError)
+                self.assertEqual(str(cm.exception), "qty must be a positive int")
+                self.assertEqual(self.inv.available("MUG"), 2)
+
+    def test_available_subtracts_every_open_hold(self):
+        self.inv.reserve("BEAN-ETH", 1)
+        self.inv.reserve("BEAN-ETH", 1)
+        self.assertEqual(self.inv.available("BEAN-ETH"), 3)
+
+    def test_commit_takes_units_off_hand(self):
+        reservation = self.inv.reserve("BEAN-ETH", 2)
+        self.inv.commit(reservation)
+        self.assertEqual(self.inv.available("BEAN-ETH"), 3)
+        with self.assertRaises(OutOfStock) as cm:
+            self.inv.reserve("BEAN-ETH", 4)
+        self.assertEqual(str(cm.exception), "BEAN-ETH: 3 available, 4 requested")
+
+    def test_release_gives_units_back(self):
+        reservation = self.inv.reserve("BEAN-ETH", 2)
+        self.inv.release(reservation)
+        self.assertEqual(self.inv.available("BEAN-ETH"), 5)
+
+    def test_double_commit_raises(self):
+        reservation = self.inv.reserve("BEAN-ETH", 2)
+        self.inv.commit(reservation)
+        with self.assertRaises(ReservationError) as cm:
+            self.inv.commit(reservation)
+        self.assertEqual(str(cm.exception), NOT_OPEN)
+        self.assertEqual(self.inv.available("BEAN-ETH"), 3)
+
+    def test_double_release_raises(self):
+        reservation = self.inv.reserve("BEAN-ETH", 2)
+        self.inv.release(reservation)
+        with self.assertRaises(ReservationError) as cm:
+            self.inv.release(reservation)
+        self.assertEqual(str(cm.exception), NOT_OPEN)
+        self.assertEqual(self.inv.available("BEAN-ETH"), 5)
+
+    def test_commit_after_release_raises(self):
+        reservation = self.inv.reserve("BEAN-ETH", 2)
+        self.inv.release(reservation)
+        with self.assertRaises(ReservationError) as cm:
+            self.inv.commit(reservation)
+        self.assertEqual(str(cm.exception), NOT_OPEN)
+        self.assertEqual(self.inv.available("BEAN-ETH"), 5)
+
+    def test_release_after_commit_raises(self):
+        reservation = self.inv.reserve("BEAN-ETH", 2)
+        self.inv.commit(reservation)
+        with self.assertRaises(ReservationError) as cm:
+            self.inv.release(reservation)
+        self.assertEqual(str(cm.exception), NOT_OPEN)
+        self.assertEqual(self.inv.available("BEAN-ETH"), 3)
+
+    def test_reservation_from_other_inventory_raises(self):
+        other = Inventory({"BEAN-ETH": 5})
+        reservation = other.reserve("BEAN-ETH", 2)
+        with self.assertRaises(ReservationError) as cm:
+            self.inv.commit(reservation)
+        self.assertEqual(str(cm.exception), NOT_OPEN)
+        with self.assertRaises(ReservationError) as cm:
+            self.inv.release(reservation)
+        self.assertEqual(str(cm.exception), NOT_OPEN)
+        self.assertEqual(self.inv.available("BEAN-ETH"), 5)
+        self.assertEqual(other.available("BEAN-ETH"), 3)
+
+    def test_concurrent_reserve_never_oversells(self):
+        inv = Inventory({"MUG": 10})
+        results = run_together([lambda: inv.reserve("MUG", 1)] * 50)
+        held = [r for r in results if isinstance(r, Reservation)]
+        refused = [r for r in results if isinstance(r, OutOfStock)]
+        self.assertEqual(len(held), 10)
+        self.assertEqual(len(refused), 40)
+        self.assertEqual(sum(r.qty for r in held), 10)
+        self.assertEqual(inv.available("MUG"), 0)
+
+    def test_concurrent_settle_exactly_one_wins(self):
+        for _ in range(20):
+            inv = Inventory({"MUG": 2})
+            reservation = inv.reserve("MUG", 1)
+
+            def commit_once():
+                inv.commit(reservation)
+                return "commit"
+
+            def release_once():
+                inv.release(reservation)
+                return "release"
+
+            results = run_together([commit_once] * 10 + [release_once] * 10)
+            winners = [r for r in results if isinstance(r, str)]
+            losers = [r for r in results if isinstance(r, Exception)]
+            self.assertEqual(len(winners), 1)
+            self.assertEqual(len(losers), 19)
+            for exc in losers:
+                self.assertIs(type(exc), ReservationError)
+                self.assertEqual(str(exc), NOT_OPEN)
+            expected = 1 if winners == ["commit"] else 2
+            self.assertEqual(inv.available("MUG"), expected)
+
+    def test_concurrent_churn_keeps_books_balanced(self):
+        previous = sys.getswitchinterval()
+        sys.setswitchinterval(1e-6)
+        self.addCleanup(sys.setswitchinterval, previous)
+        stock = {"MUG": 60, "BEAN-ETH": 60}
+        inv = Inventory(stock)
+
+        def churn(seed):
+            rng = random.Random(seed)
+            committed = {sku: 0 for sku in stock}
+            negatives = []
+            for _ in range(1000):
+                sku = rng.choice(list(stock))
+                qty = rng.randint(1, 3)
+                try:
+                    reservation = inv.reserve(sku, qty)
+                except OutOfStock:
+                    continue
+                if inv.available(sku) < 0:
+                    negatives.append(sku)
+                if rng.random() < 0.5:
+                    inv.commit(reservation)
+                    committed[sku] += qty
+                else:
+                    inv.release(reservation)
+            return committed, negatives
+
+        results = run_together([lambda seed=seed: churn(seed) for seed in range(16)])
+        self.assertEqual([r for r in results if isinstance(r, Exception)], [])
+        self.assertEqual([sku for _, negatives in results for sku in negatives], [])
+        for sku in stock:
+            spent = sum(committed[sku] for committed, _ in results)
+            self.assertEqual(inv.available(sku), stock[sku] - spent)
+
+
+if __name__ == "__main__":
+    unittest.main()
