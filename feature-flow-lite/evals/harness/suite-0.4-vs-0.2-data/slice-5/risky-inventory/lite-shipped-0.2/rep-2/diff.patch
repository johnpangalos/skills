+"""Stock on hand, with thread-safe reservations."""
+
+import threading
+
+from shop.catalog import lookup
+
+
+class OutOfStock(ValueError):
+    pass
+
+
+class ReservationError(ValueError):
+    pass
+
+
+def _is_int(value):
+    """Return True for ints, excluding bool."""
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+class Reservation:
+    """Units of one SKU held for a sale; settled once by its Inventory."""
+
+    def __init__(self, sku, qty):
+        self._sku = sku
+        self._qty = qty
+
+    @property
+    def sku(self):
+        """The reserved SKU."""
+        return self._sku
+
+    @property
+    def qty(self):
+        """Number of units held."""
+        return self._qty
+
+
+class Inventory:
+    """Units on hand and open holds per SKU, safe to share between threads."""
+
+    def __init__(self, stock):
+        """Copy a dict of SKU -> units on hand, validating every entry."""
+        self._on_hand = {}
+        for sku, count in stock.items():
+            lookup(sku)
+            if not _is_int(count) or count < 0:
+                raise ValueError(f"stock for {sku} must be a non-negative int")
+            self._on_hand[sku] = count
+        self._held = {}
+        self._open = set()
+        self._lock = threading.Lock()
+
+    def _available(self, sku):
+        """Units on hand minus open holds; caller holds the lock."""
+        return self._on_hand.get(sku, 0) - self._held.get(sku, 0)
+
+    def available(self, sku):
+        """Return units on hand minus units held by open reservations."""
+        lookup(sku)
+        with self._lock:
+            return self._available(sku)
+
+    def reserve(self, sku, qty):
+        """Hold qty units of sku and return the Reservation."""
+        lookup(sku)
+        if not _is_int(qty) or qty < 1:
+            raise ValueError("qty must be a positive int")
+        with self._lock:
+            available = self._available(sku)
+            if qty > available:
+                raise OutOfStock(f"{sku}: requested {qty}, available {available}")
+            reservation = Reservation(sku, qty)
+            self._open.add(reservation)
+            self._held[sku] = self._held.get(sku, 0) + qty
+            return reservation
+
+    def commit(self, reservation):
+        """Sell a reservation: its units leave stock for good."""
+        with self._lock:
+            self._close(reservation)
+            self._on_hand[reservation.sku] -= reservation.qty
+
+    def release(self, reservation):
+        """Give a reservation's units back to available stock."""
+        with self._lock:
+            self._close(reservation)
+
+    def _close(self, reservation):
+        """Settle an open reservation and free its hold; caller holds the lock."""
+        if not isinstance(reservation, Reservation) or reservation not in self._open:
+            raise ReservationError("not an open reservation of this inventory")
+        self._open.remove(reservation)
+        self._held[reservation.sku] -= reservation.qty
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
