+func TestWalkRouteOnMountedPattern(t *testing.T) {
+	mw := func(next http.Handler) http.Handler { return next }
+	label := func(s string) http.HandlerFunc {
+		return func(w http.ResponseWriter, r *http.Request) { w.Write([]byte(s)) }
+	}
+	sub := func() *Mux {
+		m := NewMux()
+		m.Get("/{id}", label("id"))
+		return m
+	}
+	// handleAll expects a plain Handle() on route to report every method with the same body
+	handleAll := func(route, body string) map[string]string {
+		want := map[string]string{}
+		for m := range methodMap {
+			want[m+" "+route] = body
+		}
+		return want
+	}
+	// merge returns the union of the maps, later maps winning on conflicts
+	merge := func(ms ...map[string]string) map[string]string {
+		out := map[string]string{}
+		for _, m := range ms {
+			for k, v := range m {
+				out[k] = v
+			}
+		}
+		return out
+	}
+
+	tests := []struct {
+		name  string
+		setup func() Router
+		want  map[string]string // "METHOD /route" -> body written by the handler
+		mws   map[string]int    // "METHOD /route" -> middleware count, omitted when zero
+	}{
+		{
+			name: "Route then Get on the same pattern",
+			setup: func() Router {
+				r := NewRouter()
+				r.Route("/foo", func(r Router) {
+					r.Route("/bar", func(r Router) {
+						r.Get("/{id}", label("id"))
+					})
+					r.Get("/bar", label("bar"))
+				})
+				return r
+			},
+			want: map[string]string{"GET /foo/bar": "bar", "GET /foo/bar/{id}": "id"},
+		},
+		{
+			name: "Route then Get on the same pattern two levels deep",
+			setup: func() Router {
+				r := NewRouter()
+				r.Route("/a", func(r Router) {
+					r.Route("/foo", func(r Router) {
+						r.Route("/bar", func(r Router) {
+							r.Get("/{id}", label("id"))
+						})
+						r.Get("/bar", label("bar"))
+					})
+				})
+				return r
+			},
+			want: map[string]string{"GET /a/foo/bar": "bar", "GET /a/foo/bar/{id}": "id"},
+		},
+		{
+			name: "Mount then Get on the same pattern",
+			setup: func() Router {
+				r := NewRouter()
+				r.Mount("/bar", sub())
+				r.Get("/bar", label("bar"))
+				return r
+			},
+			want: map[string]string{"GET /bar": "bar", "GET /bar/{id}": "id"},
+		},
+		{
+			name: "Mount then Post and Method QUERY on the same pattern",
+			setup: func() Router {
+				r := NewRouter()
+				r.Mount("/bar", sub())
+				r.Post("/bar", label("post"))
+				r.Method("QUERY", "/bar", label("query"))
+				return r
+			},
+			want: map[string]string{"POST /bar": "post", "QUERY /bar": "query", "GET /bar/{id}": "id"},
+		},
+		{
+			name: "Mount then Handle on the same pattern",
+			setup: func() Router {
+				r := NewRouter()
+				r.Mount("/bar", sub())
+				r.Handle("/bar", label("any"))
+				return r
+			},
+			want: merge(handleAll("/bar", "any"), map[string]string{"GET /bar/{id}": "id"}),
+		},
+		{
+			name: "Mount then Handle then Get on the same pattern",
+			setup: func() Router {
+				r := NewRouter()
+				r.Mount("/bar", sub())
+				r.Handle("/bar", label("any"))
+				r.Get("/bar", label("get"))
+				return r
+			},
+			want: merge(handleAll("/bar", "any"), map[string]string{"GET /bar": "get", "GET /bar/{id}": "id"}),
+		},
+		{
+			name: "Get before Route on the same pattern",
+			setup: func() Router {
+				r := NewRouter()
+				r.Get("/bar", label("bar"))
+				r.Route("/bar", func(r Router) {
+					r.Get("/{id}", label("id"))
+				})
+				return r
+			},
+			want: map[string]string{"GET /bar/{id}": "id"},
+		},
+		{
+			name: "Mount of a plain handler then Get on the same pattern",
+			setup: func() Router {
+				r := NewRouter()
+				r.Mount("/bar", http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}))
+				r.Get("/bar", label("bar"))
+				return r
+			},
+			want: merge(handleAll("/bar/*", ""), map[string]string{"GET /bar": "bar"}),
+		},
+		{
+			name: "Mount then Get on the trailing slash pattern",
+			setup: func() Router {
+				r := NewRouter()
+				r.Mount("/bar", sub())
+				r.Get("/bar/", label("slash"))
+				return r
+			},
+			want: map[string]string{"GET /bar/": "slash", "GET /bar/{id}": "id"},
+		},
+		{
+			name: "Mount on a trailing slash pattern then Get on the same pattern",
+			setup: func() Router {
+				r := NewRouter()
+				r.Mount("/bar/", sub())
+				r.Get("/bar/", label("slash"))
+				return r
+			},
+			want: map[string]string{"GET /bar/": "slash", "GET /bar/{id}": "id"},
+		},
+		{
+			name: "Mount on root then Get on root",
+			setup: func() Router {
+				r := NewRouter()
+				r.Mount("/", sub())
+				r.Get("/", label("root"))
+				return r
+			},
+			want: map[string]string{"GET /": "root", "GET /{id}": "id"},
+		},
+		{
+			name: "Mount then Get on the wildcard pattern",
+			setup: func() Router {
+				r := NewRouter()
+				r.Mount("/bar", sub())
+				r.Get("/bar/*", label("wild"))
+				return r
+			},
+			want: map[string]string{"GET /bar/*": "wild", "GET /bar/{id}": "id"},
+		},
+		{
+			name: "Inline With on Route and Get on the same pattern",
+			setup: func() Router {
+				r := NewRouter()
+				r.Route("/foo", func(r Router) {
+					r.With(mw).Route("/bar", func(r Router) {
+						r.Get("/{id}", label("id"))
+					})
+					r.With(mw).Get("/bar", label("bar"))
+				})
+				return r
+			},
+			want: map[string]string{"GET /foo/bar": "bar", "GET /foo/bar/{id}": "id"},
+			mws:  map[string]int{"GET /foo/bar": 1, "GET /foo/bar/{id}": 1},
+		},
+		{
+			name: "No collision: Route with Get and nested Route",
+			setup: func() Router {
+				r := NewRouter()
+				r.Route("/foo", func(r Router) {
+					r.Get("/bar", label("bar"))
+					r.Route("/baz", func(r Router) {
+						r.Get("/{id}", label("id"))
+					})
+				})
+				return r
+			},
+			want: map[string]string{"GET /foo/bar": "bar", "GET /foo/baz/{id}": "id"},
+		},
+		{
+			name: "No collision: Get and plain Mount of a Mux",
+			setup: func() Router {
+				r := NewRouter()
+				r.Get("/top", label("top"))
+				r.Mount("/bar", sub())
+				return r
+			},
+			want: map[string]string{"GET /top": "top", "GET /bar/{id}": "id"},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := map[string]string{}
+			gotMws := map[string]int{}
+			gotCount := map[string]int{}
+			err := Walk(tt.setup(), func(method, route string, handler http.Handler, middlewares ...func(http.Handler) http.Handler) error {
+				key := method + " " + route
+				gotCount[key]++
+				if n := len(middlewares); n > 0 {
+					gotMws[key] = n
+				}
+				// invoke the handler to check which one was registered; mount handlers
+				// read the route context, so the request carries one
+				req := httptest.NewRequest(method, "/", nil)
+				req = req.WithContext(context.WithValue(req.Context(), RouteCtxKey, NewRouteContext()))
+				rec := httptest.NewRecorder()
+				handler.ServeHTTP(rec, req)
+				got[key] = rec.Body.String()
+				return nil
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			for key, n := range gotCount {
+				if n > 1 {
+					t.Errorf("expected %s to be reported once, reported %d times", key, n)
+				}
+			}
+			if !maps.Equal(got, tt.want) {
+				t.Errorf("expected routes %v, got %v", tt.want, got)
+			}
+			if !maps.Equal(gotMws, tt.mws) {
+				t.Errorf("expected middleware counts %v, got %v", tt.mws, gotMws)
+			}
+		})
+	}
+}
