+func TestRoutesRouteOnMountedPattern(t *testing.T) {
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {})
+	sub := func() *Mux {
+		m := NewMux()
+		m.Get("/{id}", h)
+		return m
+	}
+	// routesOn returns the Routes reported for pattern, in the order Routes() gives them
+	routesOn := func(rts []Route, pattern string) []Route {
+		var out []Route
+		for _, rt := range rts {
+			if rt.Pattern == pattern {
+				out = append(out, rt)
+			}
+		}
+		return out
+	}
+	// methodsOf returns the sorted handler keys of a Route
+	methodsOf := func(rt Route) []string {
+		var keys []string
+		for k := range rt.Handlers {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		return keys
+	}
+	// shape describes the patterns, handler keys and subrouter presence of every Route, in order
+	shape := func(rts []Route) string {
+		s := ""
+		for _, rt := range rts {
+			s += fmt.Sprintf("%s %v %t; ", rt.Pattern, methodsOf(rt), rt.SubRoutes != nil)
+		}
+		return s
+	}
+
+	t.Run("Route then Get on the same pattern", func(t *testing.T) {
+		foo := NewMux()
+		foo.Route("/bar", func(r Router) {
+			r.Get("/{id}", h)
+		})
+		foo.Get("/bar", h)
+
+		leaf := routesOn(foo.Routes(), "/bar")
+		if len(leaf) != 1 || leaf[0].SubRoutes != nil {
+			t.Fatalf("expected one leaf Route on /bar without SubRoutes, got %d routes", len(leaf))
+		}
+		if got := fmt.Sprint(methodsOf(leaf[0])); got != "[GET]" {
+			t.Errorf("expected handler keys [GET] on /bar, got %s", got)
+		}
+
+		stubs := routesOn(foo.Routes(), "/bar/*")
+		if len(stubs) != 1 || stubs[0].SubRoutes == nil {
+			t.Errorf("expected one Route on /bar/* with SubRoutes, got %d routes", len(stubs))
+		}
+	})
+
+	t.Run("Mount then Get on the wildcard pattern", func(t *testing.T) {
+		r := NewMux()
+		r.Mount("/bar", sub())
+		r.Get("/bar/*", h)
+
+		first := ""
+		for i := 0; i < 20; i++ {
+			rts := r.Routes()
+			wild := routesOn(rts, "/bar/*")
+			if len(wild) != 2 {
+				t.Fatalf("expected two Routes on /bar/*, got %d", len(wild))
+			}
+			if wild[0].SubRoutes == nil {
+				t.Fatalf("expected the first Route on /bar/* to carry SubRoutes")
+			}
+			if _, ok := wild[0].Handlers["GET"]; ok {
+				t.Fatalf("expected the subrouter Route on /bar/* to lack GET, got %v", methodsOf(wild[0]))
+			}
+			if wild[1].SubRoutes != nil {
+				t.Fatalf("expected the second Route on /bar/* without SubRoutes")
+			}
+			if got := fmt.Sprint(methodsOf(wild[1])); got != "[GET]" {
+				t.Fatalf("expected handler keys [GET] on the second Route, got %s", got)
+			}
+			s := shape(rts)
+			if i == 0 {
+				first = s
+			}
+			if s != first {
+				t.Fatalf("Routes() order changed between calls: %q then %q", first, s)
+			}
+		}
+	})
+}
