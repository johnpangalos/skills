+func TestWalkRouteStubCollision(t *testing.T) {
+	handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {})
+	RegisterMethod("BOO")
+
+	// allMethods lists every method Handle registers on a route.
+	allMethods := func(route string) []string {
+		var out []string
+		for _, m := range reverseMethodMap {
+			out = append(out, m+" "+route)
+		}
+		return out
+	}
+
+	tests := []struct {
+		name     string
+		setup    func() Router
+		expected []string
+	}{
+		{
+			name: "method registered after Route on the stub pattern",
+			setup: func() Router {
+				r := NewMux()
+				r.Route("/foo", func(r Router) {
+					r.Route("/bar", func(r Router) {
+						r.Get("/{id}", handler)
+					})
+					r.Get("/bar", handler)
+				})
+				return r
+			},
+			expected: []string{"GET /foo/bar", "GET /foo/bar/{id}"},
+		},
+		{
+			name: "method registered before Route on the stub pattern is unroutable",
+			setup: func() Router {
+				r := NewMux()
+				r.Route("/foo", func(r Router) {
+					r.Get("/bar", handler)
+					r.Route("/bar", func(r Router) {
+						r.Get("/{id}", handler)
+					})
+				})
+				return r
+			},
+			expected: []string{"GET /foo/bar/{id}"},
+		},
+		{
+			name: "several methods after Route on the stub pattern",
+			setup: func() Router {
+				r := NewMux()
+				r.Route("/foo", func(r Router) {
+					r.Route("/bar", func(r Router) {
+						r.Get("/{id}", handler)
+					})
+					r.Get("/bar", handler)
+					r.Post("/bar", handler)
+				})
+				return r
+			},
+			expected: []string{"GET /foo/bar", "POST /foo/bar", "GET /foo/bar/{id}"},
+		},
+		{
+			name: "Handle after Route on the stub pattern",
+			setup: func() Router {
+				r := NewMux()
+				r.Route("/foo", func(r Router) {
+					r.Route("/bar", func(r Router) {
+						r.Get("/{id}", handler)
+					})
+					r.Handle("/bar", handler)
+				})
+				return r
+			},
+			expected: append(allMethods("/foo/bar"), "GET /foo/bar/{id}"),
+		},
+		{
+			name: "custom method after Route on the stub pattern",
+			setup: func() Router {
+				r := NewMux()
+				r.Route("/foo", func(r Router) {
+					r.Route("/bar", func(r Router) {
+						r.Get("/{id}", handler)
+					})
+					r.Method("BOO", "/bar", handler)
+				})
+				return r
+			},
+			expected: []string{"BOO /foo/bar", "GET /foo/bar/{id}"},
+		},
+		{
+			name: "Mount of a sub-Mux with method after Mount",
+			setup: func() Router {
+				sub := NewMux()
+				sub.Get("/{id}", handler)
+				r := NewMux()
+				r.Route("/foo", func(r Router) {
+					r.Mount("/bar", sub)
+					r.Get("/bar", handler)
+				})
+				return r
+			},
+			expected: []string{"GET /foo/bar", "GET /foo/bar/{id}"},
+		},
+		{
+			name: "Mount of a plain handler with method after Mount",
+			setup: func() Router {
+				r := NewMux()
+				r.Mount("/plain", handler)
+				r.Get("/plain", handler)
+				return r
+			},
+			expected: append(allMethods("/plain/*"), "GET /plain"),
+		},
+		{
+			name: "trailing slash method after Route",
+			setup: func() Router {
+				r := NewMux()
+				r.Route("/foo", func(r Router) {
+					r.Route("/bar", func(r Router) {
+						r.Get("/{id}", handler)
+					})
+					r.Get("/bar/", handler)
+				})
+				return r
+			},
+			expected: []string{"GET /foo/bar/", "GET /foo/bar/{id}"},
+		},
+		{
+			name: "Route without method on the stub pattern reports nothing extra",
+			setup: func() Router {
+				r := NewMux()
+				r.Route("/foo", func(r Router) {
+					r.Route("/bar", func(r Router) {
+						r.Get("/{id}", handler)
+					})
+				})
+				return r
+			},
+			expected: []string{"GET /foo/bar/{id}"},
+		},
+		{
+			name: "method on the wildcard after Route",
+			setup: func() Router {
+				r := NewMux()
+				r.Route("/foo", func(r Router) {
+					r.Route("/bar", func(r Router) {
+						r.Get("/{id}", handler)
+					})
+					r.Get("/bar/*", handler)
+				})
+				return r
+			},
+			expected: []string{"GET /foo/bar/*", "GET /foo/bar/{id}"},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			r := tt.setup()
+			got := make(map[string]int)
+			err := Walk(r, func(method, route string, _ http.Handler, _ ...func(http.Handler) http.Handler) error {
+				got[method+" "+route]++
+				return nil
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+
+			want := make(map[string]bool)
+			for _, e := range tt.expected {
+				want[e] = true
+				if got[e] != 1 {
+					t.Errorf("expected %q reported once, got %d times", e, got[e])
+				}
+			}
+			for e, n := range got {
+				if !want[e] {
+					t.Errorf("unexpected route %q reported %d times", e, n)
+				}
+			}
+		})
+	}
+}
+
+func TestRoutesStubCollisionWildcardReportedOnce(t *testing.T) {
+	handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {})
+
+	r := NewMux()
+	r.Route("/bar", func(r Router) {
+		r.Get("/{id}", handler)
+	})
+	r.Get("/bar/*", handler)
+
+	var getRoutes, subRoutes int
+	for _, route := range r.Routes() {
+		if route.Pattern != "/bar/*" {
+			continue
+		}
+		if route.SubRoutes != nil {
+			subRoutes++
+			if route.Handlers["GET"] != nil {
+				t.Errorf("expected the subrouter entry for /bar/* not to carry GET")
+			}
+		} else if route.Handlers["GET"] != nil {
+			getRoutes++
+		}
+	}
+	if getRoutes != 1 || subRoutes != 1 {
+		t.Fatalf("expected one GET route and one subrouter entry for /bar/*, got %d and %d", getRoutes, subRoutes)
+	}
+}
