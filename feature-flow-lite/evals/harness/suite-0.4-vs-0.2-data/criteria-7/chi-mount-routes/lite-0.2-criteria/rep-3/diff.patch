+// endpointRoutes groups the endpoints by pattern into one Route per pattern.
+func endpointRoutes(eps endpoints, subroutes Routes) []Route {
+	var rts []Route
+
+	// Group methodHandlers by unique patterns
+	pats := make(map[string]endpoints)
+
+	for mt, h := range eps {
+		if h.pattern == "" {
+			continue
 		}
+		p, ok := pats[h.pattern]
+		if !ok {
+			p = endpoints{}
+			pats[h.pattern] = p
+		}
+		p[mt] = h
+	}
 
-		for p, mh := range pats {
-			hs := make(map[string]http.Handler)
-			if mh[mALL] != nil && mh[mALL].handler != nil {
-				hs["*"] = mh[mALL].handler
-			}
+	for p, mh := range pats {
+		hs := make(map[string]http.Handler)
+		if mh[mALL] != nil && mh[mALL].handler != nil {
+			hs["*"] = mh[mALL].handler
+		}
 
-			for mt, h := range mh {
-				if h.handler == nil {
-					continue
-				}
-				if m, ok := reverseMethodMap[mt]; ok {
-					hs[m] = h.handler
-				}
+		for mt, h := range mh {
+			if h.handler == nil {
+				continue
+			}
+			if m, ok := reverseMethodMap[mt]; ok {
+				hs[m] = h.handler
 			}
-
-			rt := Route{subroutes, hs, p}
