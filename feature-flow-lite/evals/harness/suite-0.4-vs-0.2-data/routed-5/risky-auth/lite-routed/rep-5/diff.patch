     def test_unknown_token(self):
         with self.assertRaises(InvalidToken):
             redeem_reset_token("not-a-token")
+
+    def test_unknown_tokens_raise_plain_invalid_token(self):
+        for bad in ["", None, "never-issued"]:
+            with self.subTest(token=bad):
+                with self.assertRaises(InvalidToken) as cm:
+                    redeem_reset_token(bad, now=0)
+                self.assertIs(type(cm.exception), InvalidToken)
+                self.assertEqual(str(cm.exception), "unknown token")
+
+    def test_zero_timestamp_is_not_missing(self):
+        token = issue_reset_token("ada", now=0)
+        self.assertEqual(redeem_reset_token(token, now=0), "ada")
+
+    def test_float_timestamps(self):
+        token = issue_reset_token("ada", now=1000.5)
+        self.assertEqual(redeem_reset_token(token, now=1000.5), "ada")
+
+    def test_exactly_thirty_minutes_is_still_valid(self):
+        token = issue_reset_token("ada", now=1000)
+        self.assertEqual(redeem_reset_token(token, now=2800), "ada")
+
+    def test_just_over_thirty_minutes_expires(self):
+        token = issue_reset_token("ada", now=0)
+        with self.assertRaises(TokenExpired) as cm:
+            redeem_reset_token(token, now=1800.001)
+        self.assertEqual(str(cm.exception), "token expired")
+
+    def test_well_past_thirty_minutes_expires(self):
+        token = issue_reset_token("ada", now=0)
+        with self.assertRaises(TokenExpired):
+            redeem_reset_token(token, now=1801)
+
+    def test_redeem_at_issue_time_is_valid(self):
+        token = issue_reset_token("ada", now=500)
+        self.assertEqual(redeem_reset_token(token, now=500), "ada")
+
+    def test_second_redeem_within_window_is_token_used(self):
+        token = issue_reset_token("ada", now=0)
+        self.assertEqual(redeem_reset_token(token, now=10), "ada")
+        with self.assertRaises(TokenUsed) as cm:
+            redeem_reset_token(token, now=20)
+        self.assertEqual(str(cm.exception), "token already used")
+
+    def test_used_token_after_expiry_is_token_used(self):
+        token = issue_reset_token("ada", now=0)
+        redeem_reset_token(token, now=10)
+        with self.assertRaises(TokenUsed):
+            redeem_reset_token(token, now=5000)
+
+    def test_expired_attempt_does_not_mark_token_used(self):
+        token = issue_reset_token("ada", now=0)
+        with self.assertRaises(TokenExpired):
+            redeem_reset_token(token, now=1801)
+        with self.assertRaises(TokenExpired):
+            redeem_reset_token(token, now=1900)
+
+    def test_token_expired_and_token_used_are_invalid_tokens(self):
+        self.assertTrue(issubclass(TokenExpired, InvalidToken))
+        self.assertTrue(issubclass(TokenUsed, InvalidToken))
+
+        token = issue_reset_token("ada", now=0)
+        redeem_reset_token(token, now=1)
+        with self.assertRaises(InvalidToken):
+            redeem_reset_token(token, now=2)
+
+        expired = issue_reset_token("ada", now=0)
+        with self.assertRaises(InvalidToken):
+            redeem_reset_token(expired, now=1801)
+
+    def test_two_tokens_for_same_user_are_independent(self):
+        first = issue_reset_token("ada", now=0)
