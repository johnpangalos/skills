+    def test_default_now_round_trip(self):
+        token = issue_reset_token("ada")
+        self.assertEqual(redeem_reset_token(token), "ada")
+
+    def test_zero_now_is_used_not_defaulted(self):
+        token = issue_reset_token("ada", now=0)
+        self.assertEqual(redeem_reset_token(token, now=1800), "ada")
+        token = issue_reset_token("ada", now=0)
+        with self.assertRaises(TokenExpired):
+            redeem_reset_token(token, now=1800.5)
+
+    def test_float_now(self):
+        token = issue_reset_token("ada", now=1000.5)
+        self.assertEqual(redeem_reset_token(token, now=1001.25), "ada")
+
+    def test_exactly_ttl_after_issue_is_valid(self):
+        token = issue_reset_token("ada", now=1000)
+        self.assertEqual(redeem_reset_token(token, now=2800), "ada")
+
+    def test_just_after_ttl_is_expired(self):
+        token = issue_reset_token("ada", now=1000)
+        with self.assertRaises(TokenExpired):
+            redeem_reset_token(token, now=2800.001)
+
+    def test_redeem_shortly_after_issue_is_ok(self):
+        token = issue_reset_token("ada", now=1000)
+        self.assertEqual(redeem_reset_token(token, now=1001), "ada")
+
+    def test_expired_redeem_does_not_consume_token(self):
+        token = issue_reset_token("ada", now=1000)
+        with self.assertRaises(TokenExpired):
+            redeem_reset_token(token, now=3000)
+        with self.assertRaises(TokenExpired):
+            redeem_reset_token(token, now=3001)
+
+    def test_second_redeem_is_token_used(self):
+        token = issue_reset_token("ada", now=1000)
+        self.assertEqual(redeem_reset_token(token, now=1000), "ada")
+        with self.assertRaises(TokenUsed):
+            redeem_reset_token(token, now=1001)
+
+    def test_reuse_long_after_ttl_is_token_used_not_expired(self):
+        token = issue_reset_token("ada", now=1000)
+        self.assertEqual(redeem_reset_token(token, now=1000), "ada")
+        with self.assertRaises(TokenUsed):
+            redeem_reset_token(token, now=99999)
