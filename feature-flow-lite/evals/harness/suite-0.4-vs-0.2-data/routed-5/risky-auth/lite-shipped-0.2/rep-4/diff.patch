     def test_unknown_token(self):
         with self.assertRaises(InvalidToken):
             redeem_reset_token("not-a-token")
+
+    def assertPlainInvalid(self, token, now=T0):
+        with self.assertRaises(InvalidToken) as cm:
+            redeem_reset_token(token, now=now)
+        self.assertIs(type(cm.exception), InvalidToken)
+        self.assertEqual(str(cm.exception), "unknown token")
+
+    def test_unknown_empty_string_is_plain_invalid(self):
+        self.assertPlainInvalid("")
+
+    def test_mutated_token_is_plain_invalid(self):
+        token = issue_reset_token("ada", now=T0)
+        self.assertPlainInvalid(token + "x")
+        self.assertEqual(redeem_reset_token(token, now=T0), "ada")
+
+    def test_unknown_token_does_not_affect_others(self):
+        token = issue_reset_token("ada", now=T0)
+        self.assertPlainInvalid("not-a-token")
+        self.assertEqual(redeem_reset_token(token, now=T0), "ada")
+
+    def test_exact_ttl_still_redeems(self):
+        token = issue_reset_token("ada", now=T0)
+        self.assertEqual(redeem_reset_token(token, now=T0 + 1800), "ada")
+
+    def test_just_past_ttl_is_expired(self):
+        token = issue_reset_token("ada", now=T0)
+        with self.assertRaises(TokenExpired) as cm:
+            redeem_reset_token(token, now=T0 + 1800.001)
+        self.assertEqual(str(cm.exception), "token expired")
+
+    def test_1801_seconds_is_expired(self):
+        token = issue_reset_token("ada", now=T0)
+        with self.assertRaises(TokenExpired):
+            redeem_reset_token(token, now=T0 + 1801)
+
+    def test_now_zero_is_honored(self):
+        token = issue_reset_token("ada", now=0)
+        with self.assertRaises(TokenExpired):
+            redeem_reset_token(token, now=1801)
+
+    def test_now_zero_is_honored_on_redeem(self):
+        token = issue_reset_token("ada", now=0)
+        self.assertEqual(redeem_reset_token(token, now=0), "ada")
+
+    def test_now_zero_issue_redeems_at_ttl(self):
+        token = issue_reset_token("ada", now=0)
+        self.assertEqual(redeem_reset_token(token, now=1800), "ada")
+
+    def test_clock_skew_before_issue_redeems(self):
+        token = issue_reset_token("ada", now=T0)
+        self.assertEqual(redeem_reset_token(token, now=T0 - 500), "ada")
+
+    def test_second_redeem_within_window_is_used(self):
+        token = issue_reset_token("ada", now=T0)
