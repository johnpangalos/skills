+/* Marginalia Books shared styles. System fonts only; no external assets. */
+
+:root {
+  --paper: #fbf7f0;
+  --card: #fffdf8;
+  --tag: #efe7da;
+  --ink: #2a2521;
+  --muted: #5c534c;
+  --line: #d8cdbd;
+  --field-border: #8a7f74;
+  --teal: #1f5b58;
+  --teal-dark: #164442;
+  --teal-wash: #e8f0ef;
+  --rust: #9a3412;
+  --header: #1d3a38;
+  --on-header: #fbf7f0;
+  --focus-on-header: #f2c46d;
+  --serif: ui-serif, Georgia, "Iowan Old Style", "Palatino Linotype", "Times New Roman", serif;
+  --sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
+}
+
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+
+html {
+  -webkit-text-size-adjust: 100%;
+}
+
+body {
+  margin: 0;
+  background: var(--paper);
+  color: var(--ink);
+  font: 1rem/1.6 var(--sans);
+}
+
+h1,
+h2 {
+  font-family: var(--serif);
+  line-height: 1.2;
+  margin: 0 0 0.5em;
+}
+
+h1 {
+  font-size: clamp(2rem, 6vw, 3rem);
+}
+
+h2 {
+  font-size: 1.4rem;
+}
+
+p {
+  margin: 0 0 1em;
+}
+
+a {
+  color: var(--teal);
+  text-underline-offset: 0.2em;
+}
+
+a:hover {
+  color: var(--teal-dark);
+}
+
+:focus-visible {
+  outline: 3px solid var(--rust);
+  outline-offset: 3px;
+}
+
+[hidden] {
+  display: none !important;
+}
+
+.container {
+  width: 100%;
+  max-width: 64rem;
+  margin: 0 auto;
+  padding: 0 1rem;
+}
+
+.skip-link {
+  position: absolute;
+  left: 1rem;
+  top: -4rem;
+  z-index: 10;
+  background: var(--ink);
+  color: var(--paper);
+  padding: 0.5rem 1rem;
+}
+
+.skip-link:focus {
+  top: 1rem;
+}
+
+/* The global link hover colour is dark teal, which is unreadable on the dark header and skip link. */
+.skip-link:hover {
+  color: var(--paper);
+}
+
+/* Header and navigation */
+
+.site-header {
+  background: var(--header);
+  color: var(--on-header);
+}
+
+.site-header :focus-visible {
+  outline-color: var(--focus-on-header);
+}
+
+.header-inner {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  padding: 0.5rem 1rem;
+}
+
+.brand {
+  font-family: var(--serif);
+  font-size: 1.25rem;
+  font-weight: 700;
+  color: var(--on-header);
+  text-decoration: none;
+}
+
+.brand:hover {
+  color: var(--on-header);
+}
+
+.nav-toggle {
+  font: inherit;
+  color: var(--on-header);
+  background: transparent;
+  border: 1px solid var(--on-header);
+  border-radius: 0.25rem;
+  padding: 0.4rem 0.9rem;
+  cursor: pointer;
+}
+
+.site-nav {
+  display: none;
+  flex-basis: 100%;
+}
+
+.site-nav.is-open {
+  display: block;
+}
+
+.site-nav ul {
+  list-style: none;
+  margin: 0;
+  padding: 0.25rem 0 0.5rem;
+}
+
+.site-nav a {
+  display: block;
+  padding: 0.6rem 0;
+  color: var(--on-header);
+  text-decoration: none;
+  border-top: 1px solid rgba(251, 247, 240, 0.25);
+}
+
+.site-nav a[aria-current="page"] {
+  font-weight: 700;
+  text-decoration: underline;
+  text-underline-offset: 0.3em;
+}
+
+/* Main content */
+
+main {
+  padding: 2rem 0 3rem;
+}
+
+main:focus {
+  outline: none;
+}
+
+.eyebrow {
+  margin: 0 0 0.5rem;
+  font-size: 0.8rem;
+  font-weight: 600;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+  color: var(--muted);
+}
+
+.lede {
+  max-width: 40rem;
+  font-size: 1.15rem;
+  color: var(--muted);
+}
+
+.section {
+  margin-top: 2.5rem;
+}
+
+.button-link,
+.button {
+  display: inline-block;
+  font: inherit;
+  font-weight: 600;
+  color: #ffffff;
+  background: var(--teal);
+  border: 0;
+  border-radius: 0.3rem;
+  padding: 0.65rem 1.25rem;
+  text-decoration: none;
+  cursor: pointer;
+}
+
+.button-link:hover,
+.button:hover {
+  background: var(--teal-dark);
+  color: #ffffff;
+}
+
+.link-list {
+  padding-left: 1.2rem;
+}
+
+/* Books */
+
+.filter-group {
+  margin: 0 0 1rem;
+  padding: 0;
+  border: 0;
+}
+
+.filter-group legend {
+  padding: 0;
+  margin-bottom: 0.5rem;
+  font-weight: 600;
+  color: var(--muted);
+}
+
+.filter-options {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.5rem;
+}
+
+.filter-button {
+  font: inherit;
+  font-size: 0.95rem;
+  color: var(--teal);
+  background: var(--card);
+  border: 1px solid var(--teal);
+  border-radius: 999px;
+  padding: 0.35rem 0.9rem;
+  cursor: pointer;
+  transition: background-color 0.15s ease;
+}
+
+.filter-button:hover {
+  background: var(--teal-wash);
+}
+
+.filter-button[aria-pressed="true"] {
+  color: #ffffff;
+  background: var(--teal);
+}
+
+.filter-button[aria-pressed="true"]:hover {
+  background: var(--teal-dark);
+}
+
+.result-count {
+  margin: 0 0 1rem;
+  font-weight: 600;
+  color: var(--muted);
+}
+
+.book-list {
+  display: grid;
+  gap: 1rem;
+  grid-template-columns: 1fr;
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.book {
+  display: flex;
+  flex-direction: column;
+  background: var(--card);
+  border: 1px solid var(--line);
+  border-top: 4px solid var(--teal);
+  padding: 1.1rem 1.2rem;
+}
+
+.book h2 {
+  font-size: 1.25rem;
+}
+
+.genre-tag {
+  align-self: flex-start;
+  margin-bottom: 0.6rem;
+  padding: 0.1rem 0.5rem;
+  background: var(--tag);
+  color: var(--muted);
+  font-size: 0.75rem;
+  font-weight: 600;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+}
+
+.book-author {
+  margin: 0 0 0.5rem;
+  font-style: italic;
+  color: var(--muted);
+}
+
+.book-blurb {
+  margin: 0 0 0.75rem;
+}
+
+.book-price {
+  margin: auto 0 0;
+  font-weight: 700;
+}
+
+/* Events */
+
+.event-list {
+  display: grid;
+  gap: 1rem;
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.event {
+  background: var(--card);
+  border: 1px solid var(--line);
+  padding: 1.1rem 1.2rem;
+}
+
+.event h2 {
+  font-size: 1.25rem;
+  margin-bottom: 0.25rem;
+}
+
+.event time {
+  display: block;
+  margin-bottom: 0.25rem;
+  font-weight: 700;
+  color: var(--rust);
+}
+
+.event p {
+  margin: 0;
+}
+
+/* Visit */
+
+.visit-grid {
+  display: grid;
+  gap: 2.5rem;
+}
+
+/* Grid items default to min-width: auto, which lets long unbreakable text widen the page. */
+.visit-grid > * {
+  min-width: 0;
+}
+
+.hours {
+  display: grid;
+  grid-template-columns: auto 1fr;
+  gap: 0.3rem 1.5rem;
+  margin: 0 0 1.5rem;
+}
+
+.hours dt {
+  font-weight: 600;
+}
+
+.hours dd {
+  margin: 0;
+  min-width: 0;
+  overflow-wrap: anywhere;
+}
+
+address {
+  margin-bottom: 1.5rem;
+  font-style: normal;
+  overflow-wrap: anywhere;
+}
+
+.map {
+  display: block;
+  width: 100%;
+  max-width: 24rem;
+  height: auto;
+  border: 1px solid var(--line);
+}
+
+.contact-form {
+  background: var(--card);
+  border: 1px solid var(--line);
+  padding: 1.25rem;
+}
+
+.form-field {
+  display: flex;
+  flex-direction: column;
+  gap: 0.35rem;
+  margin-bottom: 1.1rem;
+}
+
+.form-field label {
+  font-weight: 600;
+}
+
+.form-field input,
+.form-field textarea {
+  width: 100%;
+  font: inherit;
+  color: var(--ink);
+  background: #ffffff;
+  border: 1px solid var(--field-border);
+  border-radius: 0.3rem;
+  padding: 0.6rem 0.7rem;
+}
+
+.form-field textarea {
+  min-height: 8rem;
+  resize: vertical;
+}
+
+.form-field [aria-invalid="true"] {
+  border: 2px solid var(--rust);
+}
+
+.hint {
+  margin: 0;
+  font-size: 0.9rem;
+  color: var(--muted);
+}
+
+.field-error {
+  margin: 0;
+  font-size: 0.95rem;
+  font-weight: 600;
+  color: var(--rust);
+}
+
+.form-status {
+  margin: 0 0 1rem;
+  padding: 0.8rem 1rem;
+  background: var(--teal-wash);
+  border-left: 4px solid var(--teal);
+}
+
+.form-status:empty {
+  margin: 0;
+  padding: 0;
+  background: none;
+  border: 0;
+}
+
+/* Footer */
+
+.site-footer {
+  padding: 1.5rem 0;
+  border-top: 1px solid var(--line);
+  font-size: 0.9rem;
+  color: var(--muted);
+}
+
+/* Wider screens */
+
+@media (min-width: 700px) {
+  .nav-toggle {
+    display: none;
+  }
+
+  .site-nav {
+    display: block;
+    flex-basis: auto;
+  }
+
+  .site-nav ul {
+    display: flex;
+    gap: 1.5rem;
+    padding: 0;
+  }
+
+  .site-nav a {
+    padding: 0.4rem 0;
+    border-top: 0;
+  }
+
+  .header-inner {
+    padding: 0.75rem 1.5rem;
+  }
+}
+
+@media (min-width: 40rem) {
+  .book-list {
+    grid-template-columns: 1fr 1fr;
+  }
+}
+
+@media (min-width: 60rem) {
+  .book-list {
+    grid-template-columns: 1fr 1fr 1fr;
+  }
+
+  .visit-grid {
+    grid-template-columns: 1fr 1.2fr;
+    align-items: start;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    transition-duration: 0.01ms !important;
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+    scroll-behavior: auto !important;
+  }
+}
