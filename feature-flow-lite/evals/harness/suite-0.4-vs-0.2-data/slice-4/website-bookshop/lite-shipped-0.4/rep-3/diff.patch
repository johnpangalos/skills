@@ -0,0 +1,553 @@
+// Headless Chrome checks for the Marginalia Books site.
+// Usage: node tests/run.mjs [group]   where group is one of: nav, books, events, visit, site (default: all).
+import { execFileSync } from 'node:child_process';
+import { createRequire } from 'node:module';
+import http from 'node:http';
+import path from 'node:path';
+import { readFile } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const CHROME = '/usr/bin/google-chrome';
+const PAGES = ['index.html', 'books.html', 'events.html', 'visit.html'];
+const GROUPS = ['nav', 'books', 'events', 'visit', 'site'];
+const MIME = {
+  '.html': 'text/html; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.js': 'text/javascript; charset=utf-8',
+  '.svg': 'image/svg+xml',
+  '.md': 'text/markdown; charset=utf-8'
+};
+
+async function loadChromium() {
+  try {
+    return (await import('playwright')).chromium;
+  } catch {
+    // Playwright is installed globally; ESM import does not search the global root, so fall back to require.
+    const globalRoot = execFileSync('npm', ['root', '-g'], { encoding: 'utf8' }).trim();
+    const require = createRequire(import.meta.url);
+    return require(path.join(globalRoot, 'playwright')).chromium;
+  }
+}
+
+function startServer() {
+  const server = http.createServer(async (req, res) => {
+    let pathname;
+    try {
+      pathname = decodeURIComponent(new URL(req.url, 'http://localhost').pathname);
+    } catch {
+      res.writeHead(400, { 'Content-Type': 'text/plain' });
+      res.end('Bad request');
+      return;
+    }
+    if (pathname.endsWith('/')) {
+      pathname += 'index.html';
+    }
+    const file = path.join(ROOT, pathname);
+    if (!file.startsWith(ROOT + path.sep)) {
+      res.writeHead(403, { 'Content-Type': 'text/plain' });
+      res.end('Forbidden');
+      return;
+    }
+    try {
+      const body = await readFile(file);
+      res.writeHead(200, { 'Content-Type': MIME[path.extname(file)] || 'application/octet-stream' });
+      res.end(body);
+    } catch {
+      res.writeHead(404, { 'Content-Type': 'text/plain' });
+      res.end('Not found');
+    }
+  });
+  return new Promise((resolve) => {
+    server.listen(0, '127.0.0.1', () => resolve(server));
+  });
+}
+
+function assert(condition, message) {
+  if (!condition) {
+    throw new Error(message);
+  }
+}
+
+function assertEqual(actual, expected, message) {
+  assert(actual === expected, `${message}: expected ${JSON.stringify(expected)}, got ${JSON.stringify(actual)}`);
+}
+
+// Opens a route in a fresh context at the given width. Every session is checked for console errors and off-origin requests.
+async function open(env, route, width = 1280) {
+  const context = await env.browser.newContext({ viewport: { width, height: 900 } });
+  const page = await context.newPage();
+  const session = { context, page, consoleErrors: [], offOrigin: [], requests: 0 };
+  page.on('console', (message) => {
+    if (message.type() === 'error') {
+      session.consoleErrors.push(message.text());
+    }
+  });
+  page.on('pageerror', (error) => session.consoleErrors.push(error.message));
+  page.on('request', (request) => {
+    const url = request.url();
+    session.requests += 1;
+    if (!url.startsWith(env.base) && !url.startsWith('data:') && !url.startsWith('blob:')) {
+      session.offOrigin.push(url);
+    }
+  });
+  env.sessions.push(session);
+  await page.goto(env.base + route, { waitUntil: 'load' });
+  return page;
+}
+
+const pressed = (page, name) => page.getByRole('button', { name, exact: true }).getAttribute('aria-pressed');
+const genreParam = (page) => new URL(page.url()).searchParams.get('genre');
+const countText = (page) => page.locator('#result-count').textContent();
+
+// WCAG contrast helpers for the palette in css/styles.css.
+function luminance(hex) {
+  const channels = [1, 3, 5].map((i) => {
+    const value = parseInt(hex.slice(i, i + 2), 16) / 255;
+    return value <= 0.03928 ? value / 12.92 : ((value + 0.055) / 1.055) ** 2.4;
+  });
+  return 0.2126 * channels[0] + 0.7152 * channels[1] + 0.0722 * channels[2];
+}
+
+function contrast(a, b) {
+  const [light, dark] = [luminance(a), luminance(b)].sort((x, y) => y - x);
+  return (light + 0.05) / (dark + 0.05);
+}
+
+// Converts a computed style colour such as "rgb(251, 247, 240)" to hex for the helpers above.
+function rgbToHex(rgb) {
+  return '#' + rgb.match(/\d+/g).slice(0, 3).map((n) => Number(n).toString(16).padStart(2, '0')).join('');
+}
+
+const tests = [];
+function test(group, name, fn) {
+  tests.push({ group, name, fn });
+}
+
+// Navigation
+
+const NAV_HREFS = ['index.html', 'books.html', 'events.html', 'visit.html'];
+const NAV_LABELS = ['Home', 'Books', 'Events', 'Visit'];
+
+for (const file of PAGES) {
+  test('nav', `${file}: same four links and labels, aria-current only on this page`, async (env) => {
+    const page = await open(env, `/${file}`);
+    const links = await page.$$eval('.site-nav a', (els) =>
+      els.map((el) => ({ href: el.getAttribute('href'), text: el.textContent.trim(), current: el.getAttribute('aria-current') }))
+    );
+    assertEqual(JSON.stringify(links.map((l) => l.href)), JSON.stringify(NAV_HREFS), 'nav hrefs');
+    assertEqual(JSON.stringify(links.map((l) => l.text)), JSON.stringify(NAV_LABELS), 'nav link text');
+    assertEqual(JSON.stringify(links.filter((l) => l.current === 'page').map((l) => l.href)), JSON.stringify([file]), 'aria-current');
+  });
+}
+
+test('nav', 'mobile menu at 360px: keyboard-only toggle, Escape closes and returns focus', async (env) => {
+  const page = await open(env, '/books.html', 360);
+  await page.focus('.brand');
+  await page.keyboard.press('Tab');
+  assertEqual(await page.evaluate(() => document.activeElement.className), 'nav-toggle', 'Tab reaches the menu button');
+  assertEqual(await page.getAttribute('.nav-toggle', 'aria-expanded'), 'false', 'closed initially');
+  assert(!(await page.locator('.site-nav a').first().isVisible()), 'links hidden while closed');
+  await page.keyboard.press('Enter');
+  assertEqual(await page.getAttribute('.nav-toggle', 'aria-expanded'), 'true', 'open after Enter');
+  assert(await page.locator('.site-nav a').first().isVisible(), 'links visible while open');
+  await page.keyboard.press('Tab');
+  assertEqual(await page.evaluate(() => document.activeElement.textContent), 'Home', 'Tab moves into the open menu');
+  await page.keyboard.press('Escape');
+  assertEqual(await page.getAttribute('.nav-toggle', 'aria-expanded'), 'false', 'Escape closes');
+  assertEqual(await page.evaluate(() => document.activeElement.className), 'nav-toggle', 'focus returns to the toggle');
+});
+
+test('nav', 'menu open at 360px, resize to desktop: links shown, state reset, back to mobile stays closed', async (env) => {
+  const page = await open(env, '/visit.html', 360);
+  await page.click('.nav-toggle');
+  assertEqual(await page.getAttribute('.nav-toggle', 'aria-expanded'), 'true', 'open at 360px');
+  await page.setViewportSize({ width: 1024, height: 800 });
+  // The menu state resets from a matchMedia change event, which fires asynchronously after the resize.
+  await page.waitForFunction(() => document.querySelector('.nav-toggle').getAttribute('aria-expanded') === 'false');
+  assert(!(await page.locator('.nav-toggle').isVisible()), 'toggle hidden at desktop width');
+  assert(await page.locator('.site-nav a').first().isVisible(), 'links visible at desktop width');
+  await page.setViewportSize({ width: 360, height: 800 });
+  assert(!(await page.locator('.site-nav a').first().isVisible()), 'menu stays closed after returning to 360px');
+});
+
+// Books
+
+test('books', 'catalog: at least 8 books across 4+ genres, each with title, author, genre, blurb and price', async (env) => {
+  const page = await open(env, '/books.html');
+  const books = await page.$$eval('[data-genre]', (els) =>
+    els.map((el) => ({
+      genre: el.getAttribute('data-genre'),
+      tag: el.querySelector('.genre-tag')?.textContent.trim(),
+      title: el.querySelector('h2')?.textContent.trim(),
+      author: el.querySelector('.book-author')?.textContent.trim(),
+      blurb: el.querySelector('.book-blurb')?.textContent.trim(),
+      price: el.querySelector('.book-price')?.textContent.trim(),
+      cursor: getComputedStyle(el.querySelector('.genre-tag')).cursor,
+      tagName: el.querySelector('.genre-tag').tagName
+    }))
+  );
+  assert(books.length >= 8, `at least 8 books, got ${books.length}`);
+  assert(new Set(books.map((b) => b.genre)).size >= 4, 'at least 4 genres');
+  for (const book of books) {
+    assert(book.title && book.author && book.blurb && book.price, `missing field in ${JSON.stringify(book)}`);
+    assertEqual(book.tag, book.genre, `genre tag for ${book.title}`);
+    assertEqual(book.tagName, 'SPAN', `genre tag is not a control for ${book.title}`);
+    assert(book.cursor !== 'pointer', `genre tag does not look clickable for ${book.title}`);
+  }
+});
+
+test('books', 'filter buttons: aria-pressed, All option, count announced in a live region', async (env) => {
+  const page = await open(env, '/books.html');
+  const labels = await page.$$eval('.filter-button', (els) => els.map((el) => el.textContent.trim()));
+  assert(labels.includes('All'), 'All filter present');
+  assert(labels.length >= 5, `All plus at least 4 genres, got ${labels.length}`);
+  assertEqual(await page.locator('#result-count').getAttribute('aria-live'), 'polite', 'count is a live region');
+  assertEqual(await countText(page), 'Showing 12 of 12 books', 'initial count');
+  assertEqual(await pressed(page, 'All'), 'true', 'All pressed initially');
+  await page.getByRole('button', { name: 'Science Fiction', exact: true }).click();
+  assertEqual(await countText(page), 'Showing 2 of 12 books', 'filtered count');
+  assertEqual(await pressed(page, 'Science Fiction'), 'true', 'selected genre pressed');
+  assertEqual(await pressed(page, 'All'), 'false', 'All unpressed');
+  assertEqual(await page.locator('[data-genre]:not([hidden])').count(), 2, 'visible books');
+  await page.getByRole('button', { name: 'All', exact: true }).click();
+  assertEqual(await countText(page), 'Showing 12 of 12 books', 'count after All');
+});
+
+test('books', 'filter state lives in the URL and survives direct load, back and forward', async (env) => {
+  const page = await open(env, '/books.html');
+  await page.getByRole('button', { name: 'Fiction', exact: true }).click();
+  await page.getByRole('button', { name: 'Poetry', exact: true }).click();
+  assertEqual(genreParam(page), 'Poetry', 'URL after Poetry');
+  await page.goBack();
+  assertEqual(genreParam(page), 'Fiction', 'URL after back');
+  assertEqual(await countText(page), 'Showing 2 of 12 books', 'count after back');
+  assertEqual(await pressed(page, 'Fiction'), 'true', 'Fiction pressed after back');
+  await page.goBack();
+  assertEqual(genreParam(page), null, 'URL after second back');
+  assertEqual(await countText(page), 'Showing 12 of 12 books', 'count after second back');
+  await page.goForward();
+  assertEqual(genreParam(page), 'Fiction', 'URL after forward');
+  const bookmarked = await open(env, '/books.html?genre=Poetry');
+  assertEqual(await countText(bookmarked), 'Showing 2 of 12 books', 'bookmarked URL shows filtered list');
+  assertEqual(await pressed(bookmarked, 'Poetry'), 'true', 'bookmarked genre pressed');
+});
+
