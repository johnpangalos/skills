+test('site', 'core colour pairs meet WCAG AA 4.5:1 contrast', async (env) => {
+  const page = await open(env, '/books.html');
+  const v = await page.evaluate(() => {
+    const style = getComputedStyle(document.documentElement);
+    const names = ['--ink', '--paper', '--card', '--tag', '--muted', '--teal', '--rust', '--header', '--on-header', '--focus-on-header'];
+    return Object.fromEntries(names.map((name) => [name, style.getPropertyValue(name).trim()]));
+  });
+  const white = '#ffffff';
+  const pairs = [
+    [v['--ink'], v['--paper']],
+    [v['--muted'], v['--paper']],
+    [v['--muted'], v['--card']],
+    [v['--muted'], v['--tag']],
+    [v['--teal'], v['--paper']],
+    [v['--teal'], v['--card']],
+    [white, v['--teal']],
+    [v['--rust'], v['--paper']],
+    [v['--rust'], v['--card']],
+    [v['--on-header'], v['--header']],
+    [v['--focus-on-header'], v['--header']]
+  ];
+  for (const [a, b] of pairs) {
+    const ratio = contrast(a, b);
+    assert(ratio >= 4.5, `${a} on ${b} is ${ratio.toFixed(2)}:1`);
+  }
+});
