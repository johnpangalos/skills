+/* Marginalia Books: warm paper palette, system fonts only */
+
+:root {
+  --paper: #fbf6ec;
+  --card: #fffdf7;
+  --header: #f0e2c8;
+  --ink: #2b2118;
+  --muted: #5a4636;
+  --accent: #7a2e12;
+  --focus: #1f4e6b;
+  --rule: #d8c4a0;
+  --tag-bg: #e9d5b0;
+  --tag-ink: #4a2a14;
+  --error: #8b1a1a;
+  --serif: Georgia, "Iowan Old Style", "Palatino Linotype", Palatino, "Times New Roman", serif;
+  --sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
+}
+
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+
+[hidden] {
+  display: none !important;
+}
+
+body {
+  margin: 0;
+  font-family: var(--sans);
+  font-size: 1rem;
+  line-height: 1.6;
+  color: var(--ink);
+  background: var(--paper);
+  overflow-wrap: anywhere;
+}
+
+a {
+  color: var(--accent);
+}
+
+:focus-visible {
+  outline: 3px solid var(--focus);
+  outline-offset: 3px;
+}
+
+.skip-link {
+  position: absolute;
+  left: -9999px;
+  top: 0;
+  background: var(--card);
+  color: var(--ink);
+  padding: 8px 12px;
+  z-index: 10;
+}
+
+.skip-link:focus {
+  left: 8px;
+  top: 8px;
+}
+
+.site-header {
+  background: var(--header);
+  border-bottom: 1px solid var(--rule);
+  padding: 16px;
+}
+
+.header-inner {
+  max-width: 1080px;
+  margin: 0 auto;
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px 24px;
+}
+
+.brand {
+  margin: 0;
+  font-family: var(--serif);
+  font-size: 1.4rem;
+  font-weight: bold;
+}
+
+.brand a {
+  color: var(--ink);
+  text-decoration: none;
+}
+
+.site-nav ul {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: flex;
+  flex-wrap: wrap;
+  gap: 4px 18px;
+}
+
+.site-nav a {
+  display: inline-block;
+  padding: 6px 2px;
+  transition: color 0.2s;
+}
+
+.site-nav a[aria-current="page"] {
+  color: var(--ink);
+  font-weight: bold;
+  text-decoration: underline;
+  text-underline-offset: 6px;
+  text-decoration-thickness: 2px;
+}
+
+main {
+  max-width: 1080px;
+  margin: 0 auto;
+  padding: 24px 16px 48px;
+}
+
+h1 {
+  font-family: var(--serif);
+  font-size: clamp(2rem, 7vw, 2.8rem);
+  line-height: 1.15;
+  margin: 0 0 16px;
+}
+
+h2 {
+  font-family: var(--serif);
+  font-size: 1.35rem;
+  line-height: 1.25;
+  margin: 0 0 8px;
+}
+
+.lede {
+  font-size: 1.15rem;
+  max-width: 40em;
+}
+
+.hero {
+  border-left: 4px solid var(--accent);
+  padding-left: 16px;
+  margin-bottom: 32px;
+}
+
+.cards {
+  display: grid;
+  gap: 16px;
+  grid-template-columns: minmax(0, 1fr);
+  padding: 0;
+  margin: 24px 0 0;
+  list-style: none;
+}
+
+@media (min-width: 640px) {
+  .cards {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+  }
+}
+
+.card {
+  background: var(--card);
+  border: 1px solid var(--rule);
+  border-radius: 8px;
+  padding: 16px;
+}
+
+.card p {
+  margin: 0;
+}
+
+.filter {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 8px 12px;
+  margin: 24px 0 8px;
+}
+
+select,
+input,
+textarea {
+  font: inherit;
+  color: var(--ink);
+  background: var(--card);
+  border: 1px solid #8c7656;
+  border-radius: 6px;
+  padding: 8px 10px;
+  max-width: 100%;
+}
+
+select {
+  min-width: 12rem;
+}
+
+.result-count {
+  margin: 8px 0 16px;
+  font-weight: 600;
+  color: var(--muted);
+}
+
+.books {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: grid;
+  gap: 16px;
+  grid-template-columns: minmax(0, 1fr);
+}
+
+@media (min-width: 640px) {
+  .books {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+}
+
+@media (min-width: 960px) {
+  .books {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+  }
+}
+
+.book {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  margin: 0;
+  background: var(--card);
+  border: 1px solid var(--rule);
+  border-radius: 8px;
+  padding: 16px;
+}
+
+.book h2 {
+  margin: 0;
+}
+
+.book p {
+  margin: 0;
+}
+
+.author {
+  font-style: italic;
+  color: var(--muted);
+}
+
+.tag {
+  align-self: flex-start;
+  background: var(--tag-bg);
+  color: var(--tag-ink);
+  font-size: 0.85rem;
+  padding: 2px 10px;
+  border-radius: 999px;
+}
+
+.price {
+  font-weight: bold;
+  margin-top: 4px !important;
+}
+
+.event-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: grid;
+  gap: 16px;
+}
+
+.event {
+  background: var(--card);
+  border: 1px solid var(--rule);
+  border-left: 4px solid var(--accent);
+  border-radius: 8px;
+  padding: 16px;
+}
+
+.event p {
+  margin: 0 0 6px;
+}
+
+.event-date {
+  font-weight: 600;
+  color: var(--accent);
+}
+
+.hours {
+  width: 100%;
+  max-width: 480px;
+  border-collapse: collapse;
+  margin-bottom: 32px;
+}
+
+.hours th,
+.hours td {
+  text-align: left;
+  padding: 8px 4px;
+  border-bottom: 1px solid var(--rule);
+  vertical-align: top;
+}
+
+.hours th {
+  font-weight: 600;
+  padding-right: 16px;
+}
+
+address {
+  font-style: normal;
+  margin-bottom: 32px;
+}
+
+.contact-form {
+  max-width: 480px;
+}
+
+.field {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  margin-bottom: 16px;
+}
+
+.field input,
+.field textarea {
+  width: 100%;
+}
+
+.field label {
+  font-weight: 600;
+}
+
+[aria-invalid="true"] {
+  border: 2px solid var(--error);
+}
+
+.field-error {
+  margin: 0;
+  color: var(--error);
+  font-weight: 600;
+}
+
+button {
+  font: inherit;
+  font-weight: 600;
+  color: #fff;
+  background: var(--accent);
+  border: 0;
+  border-radius: 6px;
+  padding: 10px 22px;
+  cursor: pointer;
+}
+
+.form-status {
+  max-width: 480px;
+  margin: 16px 0 0;
+}
+
+.form-status:not(:empty) {
+  padding: 12px 16px;
+  background: var(--header);
+  border-left: 4px solid var(--accent);
+}
+
+.site-footer {
+  background: var(--header);
+  border-top: 1px solid var(--rule);
+  padding: 16px;
+  text-align: center;
+  font-size: 0.9rem;
+}
+
+.site-footer p {
+  margin: 0;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    transition: none !important;
+    animation: none !important;
+    scroll-behavior: auto !important;
+  }
+}
