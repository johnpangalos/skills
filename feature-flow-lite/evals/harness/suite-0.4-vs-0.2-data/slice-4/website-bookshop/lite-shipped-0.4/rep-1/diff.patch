+  const [first, second] = genres;
+  const ampersand = genres.find((g) => g.includes('&'));
+  const search = (pairs) => `?${new URLSearchParams(pairs).toString()}`;
+
+  await check('books: at least 8 titles, each with title, author, genre, blurb and price', async () => {
+    const page = await open();
+    const books = await page.$$eval('.book', (els) => els.map((el) => ({
+      title: el.querySelector('h2')?.textContent.trim() || '',
+      author: el.querySelector('.author')?.textContent.trim() || '',
