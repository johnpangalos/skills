+    expectEqual(new URL(page.url()).searchParams.get('genre'), ampersand, 'decoded genre');
+  });
+
+  await check('books: genre changes add history entries and back/forward restore filter and control', async () => {
+    const page = await open();
+    const before = await page.evaluate(() => history.length);
+    await page.selectOption('#genre', first);
+    expectEqual(await page.evaluate(() => history.length) - before, 1, 'history entries added');
+    await page.selectOption('#genre', second);
