+    await page.goBack();
+    expectEqual(await page.$eval('#genre', (s) => s.value), first, 'control after back');
+    expectEqual(await page.$$eval('.book:not([hidden])', (els) => els.length), counts[first], 'visible after back');
+    expectEqual(new URL(page.url()).searchParams.get('genre'), first, 'genre in url after back');
+
+    await page.goBack();
+    expectEqual(await page.$eval('#genre', (s) => s.value), 'All', 'control after second back');
+    expectEqual(await page.$$eval('.book:not([hidden])', (els) => els.length), total, 'visible after second back');
+    expectEqual(new URL(page.url()).search, '', 'url after second back');
