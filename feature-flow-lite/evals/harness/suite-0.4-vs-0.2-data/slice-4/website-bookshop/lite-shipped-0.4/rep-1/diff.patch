+}
+
+const NATIVE_CONTROLS = ['a', 'button', 'input', 'select', 'textarea', 'summary', 'label', 'form'];
+
+// Tags of non-control elements under body that have click or keydown listeners (read via CDP).
+async function listenerOffenders(page) {
+  const cdp = await page.context().newCDPSession(page);
+  await cdp.send('DOM.enable');
+  const { root } = await cdp.send('DOM.getDocument', { depth: -1 });
+  const { nodeIds } = await cdp.send('DOM.querySelectorAll', { nodeId: root.nodeId, selector: 'body *' });
+  const offenders = [];
+  for (const nodeId of nodeIds) {
+    const { node } = await cdp.send('DOM.describeNode', { nodeId });
+    const tag = node.nodeName.toLowerCase();
+    if (NATIVE_CONTROLS.includes(tag)) {
+      continue;
+    }
+    const { object } = await cdp.send('DOM.resolveNode', { nodeId });
+    const { listeners } = await cdp.send('DOMDebugger.getEventListeners', { objectId: object.objectId });
+    if (listeners.some((l) => l.type === 'click' || l.type === 'keydown')) {
+      offenders.push(tag);
+    }
+  }
+  await cdp.detach();
+  return offenders;
+}
+
+// Presses Tab until focus leaves the page; returns the stops with no visible outline or box-shadow.
+async function unoutlinedFocusStops(page) {
+  const offenders = [];
+  let presses = 0;
+  for (; presses < 100; presses += 1) {
+    await page.keyboard.press('Tab');
+    const stop = await page.evaluate(() => {
+      const el = document.activeElement;
+      if (el === document.body) {
+        return null;
+      }
+      const style = getComputedStyle(el);
+      const outlined = (style.outlineStyle !== 'none' && parseFloat(style.outlineWidth) > 0) || style.boxShadow !== 'none';
+      return { label: `${el.tagName.toLowerCase()} "${el.textContent.trim().slice(0, 30)}"`, outlined };
+    });
+    if (!stop) {
+      break;
+    }
+    if (!stop.outlined) {
+      offenders.push(stop.label);
+    }
+  }
+  expect(presses < 100, 'Tab did not leave the page within 100 stops');
+  return offenders;
+}
+
+async function runPage(browser, base, key, titles) {
+  const file = PAGES[key];
+  const origin = new URL(base).origin;
+  const requests = [];
+  const consoleErrors = [];
+  const context = await browser.newContext({ viewport: { width: 1280, height: 800 } });
+  context.on('request', (req) => requests.push({ url: req.url(), method: req.method() }));
+
+  const open = async (query = '') => {
+    const page = await context.newPage();
+    page.on('pageerror', (err) => consoleErrors.push(err.message));
+    page.on('console', (msg) => {
+      if (msg.type() === 'error') {
+        consoleErrors.push(msg.text());
+      }
+    });
+    await page.goto(base + file + query, { waitUntil: 'load' });
+    return page;
+  };
+
+  const externalRequests = () => requests.filter((r) => {
+    const u = new URL(r.url);
+    return u.origin !== origin && !['data:', 'blob:', 'about:'].includes(u.protocol);
+  });
+
+  await check(`${key}: nav links all four pages and each resolves`, async () => {
+    const page = await open();
+    const hrefs = await page.$$eval('.site-nav a', (links) => links.map((a) => a.getAttribute('href')));
+    expectEqual(hrefs, Object.values(PAGES), 'nav hrefs');
+    for (const href of hrefs) {
+      const response = await page.request.get(new URL(href, base).href);
+      expectEqual(response.status(), 200, `status for ${href}`);
+    }
+  });
+
+  await check(`${key}: only the current page is marked aria-current in nav`, async () => {
+    const page = await open();
+    const current = await page.$$eval('.site-nav a[aria-current="page"]', (links) => links.map((a) => a.getAttribute('href')));
+    expectEqual(current, [file], 'aria-current links');
+  });
+
+  await check(`${key}: lang attribute and non-empty title`, async () => {
+    const page = await open();
+    expectEqual(await page.getAttribute('html', 'lang'), 'en', 'html lang');
+    const title = (await page.title()).trim();
+    expect(title.length > 0, 'title is empty');
+    titles[key] = title;
+  });
+
+  await check(`${key}: header, nav, main and footer landmarks`, async () => {
+    const page = await open();
+    const counts = await page.evaluate(() => ({
+      header: document.querySelectorAll('header').length,
+      nav: document.querySelectorAll('nav').length,
+      main: document.querySelectorAll('main').length,
+      footer: document.querySelectorAll('footer').length,
+    }));
+    expectEqual(counts, { header: 1, nav: 1, main: 1, footer: 1 }, 'landmark counts');
+  });
+
+  await check(`${key}: one h1 and no skipped heading levels`, async () => {
+    const page = await open();
+    const levels = await page.$$eval('h1, h2, h3, h4, h5, h6', (hs) => hs.map((h) => Number(h.tagName.slice(1))));
+    expectEqual(levels.filter((l) => l === 1).length, 1, 'h1 count');
+    expectEqual(levels[0], 1, 'first heading level');
+    for (let i = 1; i < levels.length; i += 1) {
+      expect(levels[i] <= levels[i - 1] + 1, `heading jumps from h${levels[i - 1]} to h${levels[i]}`);
+    }
+  });
+
+  await check(`${key}: skip link is the first stop and moves focus to main`, async () => {
+    const page = await open();
+    await page.keyboard.press('Tab');
+    const first = await page.evaluate(() => ({
+      href: document.activeElement.getAttribute('href'),
+      outline: getComputedStyle(document.activeElement).outlineStyle,
+    }));
+    expectEqual(first.href, '#main', 'first tab stop');
+    expect(first.outline !== 'none', 'skip link has no visible focus outline');
+    await page.keyboard.press('Enter');
+    expectEqual(await page.evaluate(() => document.activeElement.id), 'main', 'focus after skip link');
+  });
+
+  await check(`${key}: no horizontal scrolling at 1280px or 360px`, async () => {
+    const page = await open();
+    for (const width of [1280, 360]) {
+      await page.setViewportSize({ width, height: 800 });
+      const overflow = await page.evaluate(() => document.documentElement.scrollWidth - document.documentElement.clientWidth);
+      expectEqual(overflow, 0, `horizontal overflow in px at ${width}px wide`);
+    }
+  });
+
+  await check(`${key}: nav links stay inside a 360px viewport`, async () => {
+    const page = await open();
+    await page.setViewportSize({ width: 360, height: 800 });
+    const outside = await page.$$eval('.site-nav a', (links) => links.filter((a) => a.getBoundingClientRect().right > window.innerWidth).length);
+    expectEqual(outside, 0, 'nav links past the right edge');
+  });
+
+  await check(`${key}: no pointer cursor on non-interactive elements`, async () => {
+    const page = await open();
+    const offenders = await page.evaluate(() => Array.from(document.querySelectorAll('body *'))
+      .filter((el) => getComputedStyle(el).cursor === 'pointer'
+        && !el.matches('a[href], button, select, input, textarea, label, summary'))
+      .map((el) => el.tagName.toLowerCase()));
+    expectEqual(offenders, [], 'elements with pointer cursor');
+  });
+
+  await check(`${key}: every Tab stop shows a visible focus outline or box-shadow`, async () => {
+    const page = await open();
+    expectEqual(await unoutlinedFocusStops(page), [], 'tab stops without a visible focus style');
+  });
+
+  await check(`${key}: no click or keydown handlers on non-interactive elements`, async () => {
+    const page = await open();
+    expectEqual(await listenerOffenders(page), [], 'non-interactive elements with handlers');
+  });
+
+  await check(`${key}: links, scripts, images and sources are same-origin, relative or data:`, async () => {
+    const page = await open();
+    const remote = await page.evaluate(() => Array.from(document.querySelectorAll('link[href], script[src], img[src], source[src]'))
+      .filter((el) => {
+        const url = new URL(el.getAttribute('href') ?? el.getAttribute('src'), location.href);
+        return url.origin !== location.origin && url.protocol !== 'data:';
+      })
+      .map((el) => el.outerHTML));
+    expectEqual(remote, [], 'remote assets');
+  });
+
+  await check(`${key}: no div or span acting as a button`, async () => {
+    const page = await open();
+    const count = await page.$$eval('div[onclick], span[onclick], div[role="button"], span[role="button"]', (els) => els.length);
+    expectEqual(count, 0, 'div/span buttons');
+  });
+
+  await check(`${key}: no placeholder lorem ipsum text`, async () => {
+    const page = await open();
+    const text = await page.evaluate(() => document.body.innerText);
+    expect(!/lorem ipsum/i.test(text), 'found lorem ipsum');
+  });
+
+  if (key === 'books') {
+    await booksChecks({ check, open });
+  }
+  if (key === 'events') {
+    await eventsChecks({ check, open });
+  }
+  if (key === 'visit') {
+    await visitChecks({ check, open, requests });
+  }
+
+  await check(`${key}: no console errors`, async () => {
+    expectEqual(consoleErrors, [], 'console errors');
+  });
+
+  await check(`${key}: no requests outside ${origin}`, async () => {
+    expectEqual(externalRequests().map((r) => r.url), [], 'external requests');
+  });
+
+  await context.close();
+}
+
+async function main() {
+  const arg = process.argv[2];
+  if (arg && !PAGES[arg]) {
+    console.error(`Unknown page "${arg}". Choose one of: ${Object.keys(PAGES).join(', ')}`);
+    process.exitCode = 2;
+    return;
+  }
+  const keys = arg ? [arg] : Object.keys(PAGES);
+  const chromium = await loadChromium();
+  const server = await startServer();
+  const base = `http://127.0.0.1:${server.address().port}/`;
+  const launchOptions = fs.existsSync(chromium.executablePath()) ? {} : { executablePath: SYSTEM_CHROME };
+  const browser = await chromium.launch({ headless: true, ...launchOptions });
+  const titles = {};
+  try {
+    for (const key of keys) {
+      await runPage(browser, base, key, titles);
+    }
+    if (keys.length === Object.keys(PAGES).length) {
+      await check('all four pages have distinct titles', async () => {
+        expectEqual(new Set(Object.values(titles)).size, keys.length, 'distinct titles');
+      });
+    }
+  } finally {
+    await browser.close();
+    server.close();
+  }
+  console.log(results.join('\n'));
+  console.log(failed === 0 ? '\nAll checks passed.' : `\n${failed} check(s) failed.`);
+  process.exitCode = failed === 0 ? 0 : 1;
+}
+
+main().catch((err) => {
+  console.error(err);
+  process.exitCode = 1;
+});
