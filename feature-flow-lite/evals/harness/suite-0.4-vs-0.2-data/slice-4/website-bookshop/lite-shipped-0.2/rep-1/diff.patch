+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Visit | Marginalia Books</title>
+  <link rel="icon" href="favicon.svg" type="image/svg+xml">
+  <link rel="stylesheet" href="css/styles.css">
+</head>
+<body>
+  <a class="skip-link" href="#main">Skip to main content</a>
+  <header class="site-header">
+    <p class="brand"><a href="index.html">Marginalia Books</a></p>
+    <nav aria-label="Main">
+      <ul class="nav-list">
+        <li><a href="index.html">Home</a></li>
+        <li><a href="books.html">Books</a></li>
+        <li><a href="events.html">Events</a></li>
+        <li><a href="visit.html" aria-current="page">Visit</a></li>
+      </ul>
+    </nav>
+  </header>
+
+  <main id="main" tabindex="-1">
+    <h1>Visit Marginalia Books</h1>
+
+    <section class="section" aria-labelledby="hours-heading">
+      <h2 id="hours-heading">Opening hours</h2>
+      <table class="hours-table">
+        <thead>
+          <tr><th scope="col">Day</th><th scope="col">Hours</th></tr>
+        </thead>
+        <tbody>
+          <tr><th scope="row">Monday</th><td>9:30am to 6:00pm</td></tr>
+          <tr><th scope="row">Tuesday</th><td>9:30am to 6:00pm</td></tr>
+          <tr><th scope="row">Wednesday</th><td>9:30am to 6:00pm</td></tr>
+          <tr><th scope="row">Thursday</th><td>9:30am to 7:00pm (late opening)</td></tr>
+          <tr><th scope="row">Friday</th><td>9:30am to 6:00pm</td></tr>
+          <tr><th scope="row">Saturday</th><td>9:30am to 5:00pm</td></tr>
+          <tr><th scope="row">Sunday</th><td>11:00am to 4:00pm</td></tr>
+        </tbody>
+      </table>
+    </section>
+
+    <section class="section" aria-labelledby="find-heading">
+      <h2 id="find-heading">Find us</h2>
+      <address>
+        Marginalia Books<br>
+        14 Lantern Row<br>
+        Oakfield<br>
+        OF4 7LR
+      </address>
+      <p>The nearest bus stop is Halsey Market, about two minutes on foot. The entrance is step-free and there is a bike rack outside the shop window.</p>
+    </section>
+
+    <section class="section" aria-labelledby="contact-heading">
+      <h2 id="contact-heading">Contact us</h2>
+      <p class="demo-note"><strong>This contact form is a demo.</strong> Nothing you type here is sent yet. For a real enquiry, email hello@marginalia.example.</p>
+
+      <form id="contact-form" novalidate>
+        <div class="field">
+          <label for="name">Your name</label>
+          <input id="name" name="name" type="text" autocomplete="name" required aria-describedby="name-error">
+          <p class="field-error" id="name-error"></p>
+        </div>
+        <div class="field">
+          <label for="email">Email address</label>
+          <input id="email" name="email" type="email" autocomplete="email" required aria-describedby="email-error">
+          <p class="field-error" id="email-error"></p>
+        </div>
+        <div class="field">
+          <label for="message">Message</label>
+          <textarea id="message" name="message" rows="6" required aria-describedby="message-error"></textarea>
+          <p class="field-error" id="message-error"></p>
+        </div>
+        <button type="submit">Send (demo)</button>
+      </form>
+      <p class="form-status" id="form-status" role="status"></p>
+    </section>
+  </main>
+
+  <footer class="site-footer">
+    <p>Marginalia Books, 14 Lantern Row, Oakfield. Independent since 1987.</p>
+    <p>&copy; 2026 Marginalia Books</p>
+  </footer>
+
+  <script src="js/visit.js"></script>
+</body>
+</html>
