+/* Marginalia Books: shared styles. System fonts only, no external resources. */
+
+:root {
+  --paper: #fbf8f3;
+  --ink: #1f1b16;
+  --muted: #57514b;
+  --rule: #d9d2c7;
+  --link: #1d4f7c;
+  --accent: #7a3e12;
+  --error: #9b1c1c;
+  --focus: #a4470b;
+  --font: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
+  --serif: Georgia, "Iowan Old Style", "Palatino Linotype", Palatino, "Times New Roman", serif;
+}
+
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+
+html {
+  scroll-behavior: smooth;
+}
+
+body {
+  margin: 0;
+  font-family: var(--font);
+  font-size: 1rem;
+  line-height: 1.6;
+  color: var(--ink);
+  background: var(--paper);
+}
+
+main,
+.site-footer {
+  overflow-wrap: anywhere;
+}
+
+h1,
+h2,
+h3 {
+  font-family: var(--serif);
+  line-height: 1.25;
+  color: var(--ink);
+  margin: 0 0 0.6rem;
+}
+
+h1 {
+  font-size: 2rem;
+}
+
+h2 {
+  font-size: 1.5rem;
+}
+
+h3 {
+  font-size: 1.2rem;
+}
+
+p {
+  margin: 0 0 1rem;
+}
+
+a {
+  color: var(--link);
+  text-underline-offset: 0.2em;
+}
+
+:focus-visible {
+  outline: 3px solid var(--focus);
+  outline-offset: 3px;
+}
+
+/* Skip link: hidden until it receives keyboard focus. */
+.skip-link {
+  position: absolute;
+  left: 0.5rem;
+  top: -3rem;
+  z-index: 10;
+  padding: 0.5rem 0.9rem;
+  background: var(--ink);
+  color: var(--paper);
+  border-radius: 4px;
+}
+
+.skip-link:focus {
+  top: 0.5rem;
+}
+
+.site-header {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0.5rem 1.5rem;
+  padding: 1rem clamp(1rem, 4vw, 2.5rem);
+  border-bottom: 1px solid var(--rule);
+}
+
+.brand {
+  margin: 0;
+  font-family: var(--serif);
+  font-size: 1.35rem;
+}
+
+.brand a {
+  color: var(--ink);
+  text-decoration: none;
+}
+
+.nav-list {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.25rem 1.25rem;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.nav-list a {
+  display: inline-block;
+  min-height: 44px;
+  line-height: 44px;
+  color: var(--ink);
+  text-decoration: none;
+  border-bottom: 2px solid transparent;
+}
+
+.nav-list a:hover {
+  border-bottom-color: var(--link);
+}
+
+.nav-list a[aria-current="page"] {
+  font-weight: 700;
+  border-bottom-color: var(--accent);
+}
+
+main {
+  max-width: 58rem;
+  margin: 0 auto;
+  padding: 2rem clamp(1rem, 4vw, 2.5rem) 3rem;
+}
+
+.hero {
+  padding-bottom: 1rem;
+  border-bottom: 1px solid var(--rule);
+  margin-bottom: 2rem;
+}
+
+.lede {
+  font-size: 1.15rem;
+  max-width: 40rem;
+}
+
+.section {
+  margin-bottom: 2.5rem;
+}
+
+.actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.75rem;
+}
+
+.button,
+button {
+  display: inline-block;
+  min-height: 44px;
+  padding: 0.6rem 1.2rem;
+  font: inherit;
+  font-weight: 600;
+  line-height: 1.3;
+  color: #ffffff;
+  background: var(--link);
+  border: 2px solid var(--link);
+  border-radius: 4px;
+  text-decoration: none;
+  cursor: pointer;
+  transition: background-color 0.15s ease;
+}
+
+.button:hover,
+button:hover {
+  background: #163d61;
+  border-color: #163d61;
+}
+
+.button-quiet {
+  color: var(--link);
+  background: transparent;
+}
+
+.button-quiet:hover {
+  color: #ffffff;
+  background: var(--link);
+}
+
+.card-list {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
+  gap: 1rem;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.card,
+.book {
+  padding: 1.1rem 1.2rem;
+  background: #ffffff;
+  border: 1px solid var(--rule);
+  border-radius: 6px;
+}
+
+.card p:last-child,
+.book p:last-child {
+  margin-bottom: 0;
+}
+
+.filter {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 0.5rem 0.75rem;
+  margin: 1.5rem 0 1rem;
+}
+
+.filter label {
+  font-weight: 600;
+}
+
+select,
+input,
+textarea {
+  font: inherit;
+  color: var(--ink);
+  background: #ffffff;
+  border: 1px solid #8a8278;
+  border-radius: 4px;
+  min-height: 44px;
+  padding: 0.4rem 0.6rem;
+}
+
+select {
+  max-width: 100%;
+}
+
+.result-count {
+  font-weight: 600;
+}
+
+.empty-message {
+  padding: 1rem;
+  border: 1px dashed var(--muted);
+  border-radius: 6px;
+}
+
+.book-list {
+  display: grid;
+  gap: 1rem;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.book h2 {
+  font-size: 1.25rem;
+}
+
+.book-author {
+  font-style: italic;
+  color: var(--muted);
+}
+
+.book-meta {
+  font-size: 0.95rem;
+  color: var(--muted);
+}
+
+.event-when {
+  font-weight: 600;
+  color: var(--accent);
+}
+
+.hours-table {
+  width: 100%;
+  max-width: 40rem;
+  border-collapse: collapse;
+  margin-bottom: 1rem;
+}
+
+.hours-table th,
+.hours-table td {
+  padding: 0.55rem 0.75rem;
+  text-align: left;
+  border-bottom: 1px solid var(--rule);
+  vertical-align: top;
+}
+
+address {
+  font-style: normal;
+  margin-bottom: 1rem;
+}
+
+.demo-note {
+  max-width: 40rem;
+  padding: 0.8rem 1rem;
+  border-left: 4px solid var(--accent);
+  background: #f4ece2;
+}
+
+.form-status {
+  max-width: 40rem;
+  font-weight: 600;
+}
+
+.field {
+  display: flex;
+  flex-direction: column;
+  gap: 0.3rem;
+  max-width: 40rem;
+  margin-bottom: 1.1rem;
+}
+
+.field label {
+  font-weight: 600;
+}
+
+.field input,
+.field textarea {
+  width: 100%;
+}
+
+.field textarea {
+  resize: vertical;
+}
+
+.field-error {
+  margin: 0;
+  color: var(--error);
+  font-weight: 600;
+}
+
+[aria-invalid="true"] {
+  border: 2px solid var(--error);
+}
+
+.site-footer {
+  padding: 1.5rem clamp(1rem, 4vw, 2.5rem);
+  border-top: 1px solid var(--rule);
+  color: var(--muted);
+  font-size: 0.95rem;
+}
+
+.site-footer p {
+  margin: 0 0 0.4rem;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  html {
+    scroll-behavior: auto;
+  }
+
+  *,
+  *::before,
+  *::after {
+    transition: none !important;
+    animation: none !important;
+  }
+}
