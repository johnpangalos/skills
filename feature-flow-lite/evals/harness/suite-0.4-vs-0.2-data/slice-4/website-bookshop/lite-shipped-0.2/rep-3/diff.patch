+
+describe('shared navigation', () => {
+  let server;
+  let browser;
+
+  before(async () => {
+    server = await startServer(ROOT);
+    browser = await launchBrowser();
+  });
+
+  after(async () => {
+    await browser.close();
+    await server.close();
+  });
+
+  for (const name of PAGES) {
+    it(`${name} lists the four pages in order and marks only its own link as current`, async () => {
+      const { page, close } = await openPage(browser, `${server.url}/${name}`);
+      try {
+        const links = await page.$$eval('.site-nav a', (anchors) =>
+          anchors.map((a) => [
+            a.textContent.trim(),
+            a.getAttribute('href'),
+            a.getAttribute('aria-current'),
+          ]),
+        );
+        const expected = LINKS.map(([text, href]) => [text, href, href === name ? 'page' : null]);
