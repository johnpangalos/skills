+/* Marginalia Books: shared styles. Mobile first; the desktop layout starts at 48em (768px). */
+
+:root {
+  /* Palette. Text pairs are at least 4.5:1: body text on --color-bg is about 15:1,
+     --color-muted is 7.24:1 on --color-bg and 6.58:1 on --color-surface, and white on --color-accent is about 7.7:1. */
+  --color-bg: #fbf8f3;
+  --color-surface: #f3ede2;
+  --color-notice: #fff4d6;
+  --color-text: #1f1b16;
+  --color-muted: #5a5249;
+  --color-accent: #8a3b12;
+  --color-accent-text: #ffffff;
+  --color-link: #8a3b12;
+  --color-focus: #0b5cad;
+  --color-border: #d8cdbd;
+  --color-error: #9b1c1c;
+
+  --font-body: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
+  --font-heading: Georgia, 'Iowan Old Style', 'Times New Roman', serif;
+
+  --radius: 6px;
+  --max-width: 60rem;
+  --touch-target: 2.75rem;
+}
+
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+
+html {
+  -webkit-text-size-adjust: 100%;
+  scroll-behavior: smooth;
+}
+
+body {
+  margin: 0;
+  background: var(--color-bg);
+  color: var(--color-text);
+  font-family: var(--font-body);
+  font-size: 1rem;
+  line-height: 1.6;
+  overflow-wrap: anywhere;
+}
+
+svg {
+  max-width: 100%;
+  height: auto;
+}
+
+h1,
+h2,
+h3 {
+  font-family: var(--font-heading);
+  line-height: 1.25;
+  color: var(--color-text);
+}
+
+h1 {
+  font-size: 1.9rem;
+  margin: 0.5rem 0 1rem;
+}
+
+h2 {
+  font-size: 1.45rem;
+  margin: 2rem 0 0.75rem;
+}
+
+h3 {
+  font-size: 1.15rem;
+  margin: 0 0 0.5rem;
+}
+
+p {
+  margin: 0 0 1rem;
+}
+
+a {
+  color: var(--color-link);
+  text-underline-offset: 0.2em;
+}
+
+:focus-visible {
+  outline: 3px solid var(--color-focus);
+  outline-offset: 2px;
+}
+
+/* Skip link: hidden until it receives keyboard focus. */
+.skip-link {
+  position: absolute;
+  top: 0.5rem;
+  left: 0.5rem;
+  z-index: 10;
+  padding: 0.75rem 1rem;
+  background: var(--color-text);
+  color: var(--color-bg);
+  border-radius: var(--radius);
+  transform: translateY(-200%);
+}
+
+.skip-link:focus {
+  transform: translateY(0);
+}
+
+.container {
+  width: 100%;
+  max-width: var(--max-width);
+  margin: 0 auto;
+  padding: 0 1rem;
+}
+
+main {
+  display: block;
+  padding: 0 0 2rem;
+}
+
+/* Header and navigation */
+
+.site-header {
+  background: var(--color-surface);
+  border-bottom: 1px solid var(--color-border);
+}
+
+.header-inner {
+  display: grid;
+  grid-template-columns: 1fr auto;
+  align-items: center;
+  gap: 0.5rem 1rem;
+  max-width: var(--max-width);
+  margin: 0 auto;
+  padding: 0.5rem 1rem;
+}
+
+.brand {
+  display: inline-flex;
+  align-items: center;
+  min-height: var(--touch-target);
+  font-family: var(--font-heading);
+  font-size: 1.25rem;
+  font-weight: bold;
+  color: var(--color-text);
+  text-decoration: none;
+}
+
+.nav-toggle {
+  display: none;
+  min-height: var(--touch-target);
+  min-width: var(--touch-target);
+  padding: 0.5rem 1rem;
+  font: inherit;
+  font-weight: bold;
+  color: var(--color-accent-text);
+  background: var(--color-accent);
+  border: 0;
+  border-radius: var(--radius);
+  cursor: pointer;
+}
+
+.js .nav-toggle {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+}
+
+.header-inner nav {
+  grid-column: 1 / -1;
+}
+
+.site-nav {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+/* Narrow screens: the list sits behind the menu button when JavaScript is running. */
+.js .site-nav {
+  display: none;
+}
+
+.js .site-nav.is-open {
+  display: flex;
+  flex-direction: column;
+  gap: 0.25rem;
+  padding-top: 0.25rem;
+}
+
+.site-nav a {
+  display: flex;
+  align-items: center;
+  min-height: var(--touch-target);
+  padding: 0.5rem 0.75rem;
+  color: var(--color-text);
+  text-decoration: none;
+  border-radius: var(--radius);
+  transition: background-color 0.2s ease;
+}
+
+.site-nav a:hover {
+  background: var(--color-border);
+}
+
+.site-nav a[aria-current='page'] {
+  font-weight: bold;
+  text-decoration: underline;
+  text-underline-offset: 0.25em;
+}
+
+/* Footer */
+
+.site-footer {
+  background: var(--color-surface);
+  border-top: 1px solid var(--color-border);
+  color: var(--color-muted);
+  font-size: 0.95rem;
+}
+
+.footer-inner {
+  max-width: var(--max-width);
+  margin: 0 auto;
+  padding: 1.5rem 1rem;
+}
+
+.footer-inner p:last-child {
+  margin-bottom: 0;
+}
+
+/* Shared content blocks */
+
+.lead {
+  font-size: 1.15rem;
+  color: var(--color-muted);
+}
+
+.button {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-height: var(--touch-target);
+  padding: 0.5rem 1.25rem;
+  margin: 0.25rem 0.5rem 0.25rem 0;
+  font: inherit;
+  font-weight: bold;
+  color: var(--color-accent-text);
+  background: var(--color-accent);
+  border: 2px solid var(--color-accent);
+  border-radius: var(--radius);
+  text-decoration: none;
+  cursor: pointer;
+}
+
+.button-secondary {
+  color: var(--color-accent);
+  background: transparent;
+}
+
+.card-grid {
+  display: grid;
+  gap: 1rem;
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.card {
+  padding: 1.25rem;
+  background: var(--color-surface);
+  border: 1px solid var(--color-border);
+  border-radius: var(--radius);
+}
+
+.card p:last-child {
+  margin-bottom: 0;
+}
+
+.byline {
+  font-size: 0.95rem;
+  color: var(--color-muted);
+}
+
+.section {
+  margin-top: 0.5rem;
+}
+
+.feature-list {
+  padding-left: 1.25rem;
+}
+
+.feature-list li {
+  margin-bottom: 0.75rem;
+}
+
+.notice {
+  padding: 1rem 1.25rem;
+  margin: 1rem 0;
+  background: var(--color-notice);
+  border: 1px solid #d9b55a;
+  border-radius: var(--radius);
+}
+
+.notice p:last-child {
+  margin-bottom: 0;
+}
+
+/* Home page hero */
+
+.hero {
+  display: grid;
+  gap: 1.5rem;
+  align-items: center;
+  max-width: var(--max-width);
+  margin: 0 auto;
+  padding: 1.5rem 1rem 0;
+}
+
+.hero-art {
+  width: 100%;
+  max-width: 20rem;
+  justify-self: center;
+}
+
+/* Books page */
+
+.filter-bar {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 0.5rem 1rem;
+  margin: 1.5rem 0 0.5rem;
+}
+
+.filter-bar label {
+  font-weight: bold;
+}
+
+select,
+input,
+textarea {
+  font: inherit;
+  color: var(--color-text);
+  background: #ffffff;
+  border: 1px solid #8c8175;
+  border-radius: var(--radius);
+}
+
+select {
+  min-height: var(--touch-target);
+  min-width: 14rem;
+  padding: 0.4rem 0.6rem;
+}
+
+.result-count {
+  font-weight: bold;
+  color: var(--color-muted);
+}
+
+.book-grid {
+  display: grid;
+  gap: 1rem;
+  list-style: none;
+  margin: 1rem 0 0;
+  padding: 0;
+}
+
+.book-card {
+  display: flex;
+  flex-direction: column;
+  padding: 1.25rem;
+  background: var(--color-surface);
+  border: 1px solid var(--color-border);
+  border-radius: var(--radius);
+}
+
+.book-card h2 {
+  font-size: 1.2rem;
+  margin: 0 0 0.25rem;
+}
+
+.book-meta {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.25rem 0.75rem;
+  margin: 0 0 0.75rem;
+  font-size: 0.95rem;
+  color: var(--color-muted);
+}
+
+.book-genre {
+  font-weight: bold;
+  color: var(--color-text);
+}
+
+.book-card p:last-child {
+  margin-bottom: 0;
+}
+
+/* Events page */
+
+.event-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.event-item {
+  padding: 1.25rem 0;
+  border-bottom: 1px solid var(--color-border);
+}
+
+.event-item h2 {
+  font-size: 1.25rem;
+  margin: 0 0 0.25rem;
+}
+
+.event-when {
+  margin: 0 0 0.5rem;
+  font-weight: bold;
+  color: var(--color-muted);
+}
+
+.event-booking {
+  font-size: 0.95rem;
+  margin: 0.5rem 0 0;
+}
+
+.past-events {
+  margin-top: 2.5rem;
+  padding-top: 0.5rem;
+  border-top: 2px solid var(--color-border);
+}
+
+.past-events .event-item {
+  opacity: 0.85;
+}
+
+/* Visit page */
+
+.hours-table {
+  width: 100%;
+  max-width: 28rem;
+  border-collapse: collapse;
+  margin: 0 0 1rem;
+}
+
+.hours-table caption {
+  text-align: left;
+  font-weight: bold;
+  padding-bottom: 0.5rem;
+}
+
+.hours-table th,
+.hours-table td {
+  padding: 0.5rem 0.75rem;
+  text-align: left;
+  border-bottom: 1px solid var(--color-border);
+}
+
+.visit-columns {
+  display: grid;
+  gap: 1.5rem;
+}
+
+address {
+  font-style: normal;
+  margin-bottom: 1rem;
+}
+
+.contact-form {
+  max-width: 36rem;
+}
+
+.field {
+  margin-bottom: 1.25rem;
+}
+
+.field label {
+  display: block;
+  font-weight: bold;
+  margin-bottom: 0.25rem;
+}
+
+.field input,
+.field select,
+.field textarea {
+  display: block;
+  width: 100%;
+  padding: 0.5rem 0.6rem;
+}
+
+.field input,
+.field select {
+  min-height: var(--touch-target);
+}
+
+.field textarea {
+  min-height: 9rem;
+  resize: vertical;
+}
+
+.field-hint {
+  margin: 0.25rem 0 0;
+  font-size: 0.9rem;
+  color: var(--color-muted);
+}
+
+.field-error {
+  margin: 0.25rem 0 0;
+  font-weight: bold;
+  color: var(--color-error);
+}
+
+.field-error:empty {
+  display: none;
+}
+
+[aria-invalid='true'] {
+  border: 2px solid var(--color-error);
+}
+
+.form-status {
+  min-height: 1.6em;
+  font-weight: bold;
+}
+
+/* Wide screens: 768px and up */
+
+@media (min-width: 48em) {
+  h1 {
+    font-size: 2.4rem;
+  }
+
+  .header-inner {
+    display: flex;
+    justify-content: space-between;
+  }
+
+  .nav-toggle,
+  .js .nav-toggle {
+    display: none;
+  }
+
+  .site-nav,
+  .js .site-nav {
+    display: flex;
+    flex-direction: row;
+    gap: 0.25rem;
+  }
+
+  .hero {
+    grid-template-columns: 1.4fr 1fr;
+    padding-top: 2.5rem;
+  }
+
+  .card-grid {
+    grid-template-columns: repeat(3, 1fr);
+  }
+
+  .book-grid {
+    grid-template-columns: repeat(2, 1fr);
+  }
+
+  .visit-columns {
+    grid-template-columns: 1fr 1fr;
+  }
+}
+
+/* Large screens: 1080px and up */
+
+@media (min-width: 67.5em) {
+  .book-grid {
+    grid-template-columns: repeat(3, 1fr);
+  }
+}
+
+/* Users who ask for less motion get no transitions and no smooth scrolling. */
+@media (prefers-reduced-motion: reduce) {
+  html {
+    scroll-behavior: auto;
+  }
+
+  *,
+  *::before,
+  *::after {
+    transition: none !important;
+    animation: none !important;
+  }
+}
