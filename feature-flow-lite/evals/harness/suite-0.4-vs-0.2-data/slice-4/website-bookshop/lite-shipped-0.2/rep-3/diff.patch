+
+const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '..');
+const LINKS = [
+  ['Home', 'index.html'],
+  ['Books', 'books.html'],
+  ['Events', 'events.html'],
+  ['Visit', 'visit.html'],
