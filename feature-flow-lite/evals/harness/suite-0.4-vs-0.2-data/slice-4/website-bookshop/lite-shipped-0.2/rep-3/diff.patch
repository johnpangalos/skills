diff --git a/tests/books.test.mjs b/tests/books.test.mjs
new file mode 100644
index 0000000..162fb8a
--- /dev/null
+++ b/tests/books.test.mjs
@@ -0,0 +1,208 @@
+import { describe, it, before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { dirname, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { startServer } from './helpers/server.mjs';
+import { launchBrowser } from './helpers/browser.mjs';
+import { openPage } from './helpers/session.mjs';
+
+const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '..');
+const TOTAL = 14;
+
+describe('books catalogue and genre filter', () => {
+  let server;
+  let browser;
+
+  before(async () => {
+    server = await startServer(ROOT);
+    browser = await launchBrowser();
+  });
+
+  after(async () => {
+    await browser.close();
+    await server.close();
+  });
+
+  // Reads the select, the live result count, the card titles and the page URL in one call.
+  async function state(page) {
+    return page.evaluate(() => ({
+      value: document.getElementById('genre-select').value,
+      selectedText: document.getElementById('genre-select').selectedOptions[0].textContent,
+      count: document.getElementById('result-count').textContent,
+      titles: Array.from(document.querySelectorAll('#book-list h2')).map((h) => h.textContent),
+      query: location.search,
+    }));
+  }
+
+  it('renders 14 fictional books with title, author, genre, price and description', async () => {
+    const { page, problems, close } = await openPage(browser, `${server.url}/books.html`);
+    try {
+      const cards = await page.$$eval('#book-list > li', (items) =>
+        items.map((item) => ({
+          title: item.querySelector('h2')?.textContent ?? '',
+          author: item.querySelector('.byline')?.textContent ?? '',
+          genre: item.querySelector('.book-genre')?.textContent ?? '',
+          price: item.querySelector('.book-meta')?.textContent ?? '',
+          description: item.querySelector(':scope > p:last-child')?.textContent ?? '',
+        })),
+      );
+      assert.equal(cards.length, TOTAL);
+      for (const card of cards) {
+        assert.ok(
+          card.title && card.author.startsWith('by '),
+          `missing title or author: ${card.title}`,
+        );
+        assert.ok(card.genre, `missing genre: ${card.title}`);
+        assert.match(card.price, /£\d+\.\d{2}/);
+        assert.ok(card.description.length > 40, `description too short: ${card.title}`);
+      }
+      assert.deepEqual(problems, []);
+    } finally {
+      await close();
+    }
+  });
+
+  it('offers All genres plus every genre, each with at least two books', async () => {
+    const { page, close } = await openPage(browser, `${server.url}/books.html`);
+    try {
+      const options = await page.$$eval('#genre-select option', (items) =>
+        items.map((item) => ({ value: item.value, text: item.textContent })),
+      );
+      assert.deepEqual(
+        options.map((option) => option.value),
+        ['all', 'crime', 'essays', 'fiction', 'history', 'nature-writing', 'poetry'],
+      );
+      assert.equal(options[0].text, 'All genres');
+
+      for (const option of options.slice(1)) {
+        await page.selectOption('#genre-select', option.value);
+        const shown = await page.locator('#book-list > li').count();
+        assert.ok(shown >= 2, `${option.text} has only ${shown} book(s)`);
+      }
+      await page.selectOption('#genre-select', 'all');
+      assert.equal(await page.locator('#book-list > li').count(), TOTAL);
+    } finally {
+      await close();
+    }
+  });
+
+  it('shows the genre from ?genre=poetry and the control reflects it', async () => {
+    const { page, problems, close } = await openPage(
+      browser,
+      `${server.url}/books.html?genre=poetry`,
+    );
+    try {
+      const result = await state(page);
+      assert.equal(result.value, 'poetry');
+      assert.equal(result.selectedText, 'Poetry');
+      assert.equal(result.count, 'Showing 2 of 14 books');
+      assert.equal(result.titles.length, 2);
+      assert.deepEqual(problems, []);
+    } finally {
+      await close();
+    }
+  });
+
+  const caseVariants = [
+    ['a mixed-case genre', 'POETRY'],
+    ['a padded, mixed-case genre', '%20Poetry%20'],
+  ];
+
+  for (const [label, genre] of caseVariants) {
+    it(`matches ${label} in ?genre= to poetry, shows only poetry and canonicalises the URL`, async () => {
+      const { page, problems, close } = await openPage(
+        browser,
+        `${server.url}/books.html?genre=${genre}`,
+      );
+      try {
+        const result = await state(page);
+        assert.equal(result.value, 'poetry');
+        assert.equal(result.selectedText, 'Poetry');
+        assert.equal(result.count, 'Showing 2 of 14 books');
+        assert.equal(result.query, '?genre=poetry');
+        const shownGenres = await page.$$eval('#book-list .book-genre', (items) =>
+          items.map((item) => item.textContent),
+        );
+        assert.deepEqual(shownGenres, ['Poetry', 'Poetry']);
+        assert.deepEqual(problems, []);
+      } finally {
+        await close();
+      }
+    });
+  }
+
+  const unknownGenres = [
+    ['an unknown genre', 'unknown-thing'],
+    ['an empty value', ''],
+    ['a script tag', '<script>alert(1)</script>'],
+  ];
+
+  for (const [label, genre] of unknownGenres) {
+    it(`falls back to All genres for ${label}, with no console error or injected markup`, async () => {
+      const url = `${server.url}/books.html?genre=${encodeURIComponent(genre)}`;
+      const { page, problems, close } = await openPage(browser, url);
+      try {
+        const result = await state(page);
+        assert.equal(result.value, 'all');
+        assert.equal(result.selectedText, 'All genres');
+        assert.equal(result.count, `Showing ${TOTAL} of ${TOTAL} books`);
+        assert.equal(result.titles.length, TOTAL);
+        assert.equal(result.query, '', 'unknown genre should be removed from the URL');
+        assert.equal(
+          await page.evaluate(() => document.body.textContent.includes('alert(1)')),
+          false,
+        );
+        assert.equal(
+          await page.evaluate(() => document.querySelectorAll('script:not([src])').length),
+          0,
+        );
+        assert.deepEqual(problems, []);
+      } finally {
+        await close();
+      }
+    });
+  }
+
+  it('changing the filter updates the URL and the result count', async () => {
+    const { page, problems, close } = await openPage(browser, `${server.url}/books.html`);
+    try {
+      await page.selectOption('#genre-select', 'crime');
+      const result = await state(page);
+      assert.equal(result.query, '?genre=crime');
+      assert.equal(result.count, 'Showing 3 of 14 books');
+
+      await page.selectOption('#genre-select', 'all');
+      assert.equal((await state(page)).query, '');
+      assert.equal((await state(page)).count, `Showing ${TOTAL} of ${TOTAL} books`);
+      assert.deepEqual(problems, []);
+    } finally {
+      await close();
+    }
+  });
+
+  it('Back and Forward restore the filter and the control', async () => {
+    const { page, problems, close } = await openPage(browser, `${server.url}/books.html`);
+    try {
+      await page.selectOption('#genre-select', 'crime');
+      await page.selectOption('#genre-select', 'poetry');
+
+      await page.goBack();
+      let result = await state(page);
+      assert.equal(result.value, 'crime');
+      assert.equal(result.count, 'Showing 3 of 14 books');
+
+      await page.goBack();
+      result = await state(page);
+      assert.equal(result.value, 'all');
+      assert.equal(result.count, `Showing ${TOTAL} of ${TOTAL} books`);
+
+      await page.goForward();
+      result = await state(page);
+      assert.equal(result.value, 'crime');
+      assert.equal(result.query, '?genre=crime');
+      assert.deepEqual(problems, []);
+    } finally {
+      await close();
+    }
+  });
+});
diff --git a/tests/contact.test.mjs b/tests/contact.test.mjs
new file mode 100644
index 0000000..9e8235e
--- /dev/null
+++ b/tests/contact.test.mjs
@@ -0,0 +1,267 @@
+import { describe, it, before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { dirname, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { startServer } from './helpers/server.mjs';
+import { launchBrowser } from './helpers/browser.mjs';
+import { openPage } from './helpers/session.mjs';
+
+const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '..');
+const NAME_ERROR = 'Please enter your name.';
+const EMAIL_EMPTY = 'Please enter your email address.';
+const EMAIL_MALFORMED = 'Please enter an email address that looks right, such as name@example.com.';
+const SUBJECT_ERROR = 'Please enter a subject.';
+const MESSAGE_ERROR = 'Please enter a message.';
+const TOO_LONG = 'Your message is over 2000 characters. Please shorten it.';
+const DEMO_STATUS =
+  'Demo only: nothing was sent. This form has no backend, so your message has not reached ' +
+  'the shop. Please email hello@marginalia-books.example or phone 01632 960 412 instead.';
+
+describe('contact form', () => {
+  let server;
+  let browser;
+
+  before(async () => {
+    server = await startServer(ROOT);
+    browser = await launchBrowser();
+  });
+
+  after(async () => {
+    await browser.close();
+    await server.close();
+  });
+
+  async function openForm() {
+    const opened = await openPage(browser, `${server.url}/visit.html`);
+    // A marker on the window shows whether a submit reloaded the page.
+    await opened.page.evaluate(() => {
+      window.__loadMarker = 'original';
+    });
+    return opened;
+  }
+
+  async function fillValid(page) {
+    await page.fill('#name', 'Ada Morrow');
+    await page.fill('#email', 'ada@example.com');
+    await page.fill('#subject', 'Booking a table for the Crime Club');
+    await page.fill('#message', 'Could you hold two seats for the 13 February evening?');
+  }
+
+  async function errorTexts(page) {
+    return page.evaluate(() => ({
+      name: document.getElementById('name-error').textContent,
+      email: document.getElementById('email-error').textContent,
+      subject: document.getElementById('subject-error').textContent,
+      message: document.getElementById('message-error').textContent,
+    }));
+  }
+
+  it('states that the form is a demo before anyone submits it', async () => {
+    const { page, close } = await openForm();
+    try {
+      const notice = page.locator('.notice');
+      assert.equal(await notice.isVisible(), true);
+      assert.match(await notice.textContent(), /This contact form is a demo/);
+      for (const id of ['name', 'email', 'subject', 'message']) {
+        const labelText = await page.locator(`label[for="${id}"]`).textContent();
+        assert.match(labelText, /\(required\)/, `${id} label does not say required in text`);
+      }
+    } finally {
+      await close();
+    }
+  });
+
+  it('rejects empty required fields, marks them invalid and focuses the first one', async () => {
+    const { page, problems, close } = await openForm();
+    try {
+      await page.click('button[type="submit"]');
+
+      assert.deepEqual(await errorTexts(page), {
+        name: NAME_ERROR,
+        email: EMAIL_EMPTY,
+        subject: SUBJECT_ERROR,
+        message: MESSAGE_ERROR,
+      });
+      for (const id of ['name', 'email', 'subject', 'message']) {
+        assert.equal(await page.getAttribute(`#${id}`, 'aria-invalid'), 'true');
+        const describedBy = await page.getAttribute(`#${id}`, 'aria-describedby');
+        assert.ok(describedBy.split(' ').includes(`${id}-error`), `${id} not linked to its error`);
+      }
+      assert.equal(await page.evaluate(() => document.activeElement.id), 'name');
+      assert.equal(
+        await page.locator('#form-status').textContent(),
+        'Please fix the 4 fields with errors.',
+      );
+      assert.equal(await page.evaluate(() => window.__loadMarker), 'original');
+      assert.deepEqual(problems, []);
+    } finally {
+      await close();
+    }
+  });
+
+  it('rejects a whitespace-only name and message', async () => {
+    const { page, close } = await openForm();
+    try {
+      await page.fill('#name', '   ');
+      await page.fill('#email', 'ada@example.com');
+      await page.fill('#subject', 'Opening hours');
+      await page.fill('#message', '\t  \n ');
+      await page.click('button[type="submit"]');
+
+      const errors = await errorTexts(page);
+      assert.equal(errors.name, NAME_ERROR);
+      assert.equal(errors.message, MESSAGE_ERROR);
+      assert.equal(errors.email, '');
+      assert.equal(errors.subject, '');
+      assert.equal(
+        await page.locator('#form-status').textContent(),
+        'Please fix the 2 fields with errors.',
+      );
+    } finally {
+      await close();
+    }
+  });
+
+  const malformedEmails = [
+    ['a@', EMAIL_MALFORMED],
+    ['@b.com', EMAIL_MALFORMED],
+    ['a b@c.com', EMAIL_MALFORMED],
+    ['a@b..com', EMAIL_MALFORMED],
+    ['a@.b.com', EMAIL_MALFORMED],
+    ['a@b.com.', EMAIL_MALFORMED],
+    ['.a@b.com', EMAIL_MALFORMED],
+    ['   ', EMAIL_EMPTY],
+  ];
+
+  for (const [email, expected] of malformedEmails) {
+    it(`rejects the email ${JSON.stringify(email)} with a specific message`, async () => {
+      const { page, close } = await openForm();
+      try {
+        await fillValid(page);
+        await page.fill('#email', email);
+        await page.click('button[type="submit"]');
+
+        assert.equal((await errorTexts(page)).email, expected);
+        assert.equal(await page.getAttribute('#email', 'aria-invalid'), 'true');
+        assert.equal(await page.evaluate(() => document.activeElement.id), 'email');
+        assert.equal(
+          await page.locator('#form-status').textContent(),
+          'Please fix the 1 field with an error.',
+        );
+      } finally {
+        await close();
+      }
+    });
+  }
+
+  const validEmails = [
+    'name@example.com',
+    'first.last@sub.example.co.uk',
+    "o'neil+books@example.org",
+  ];
+
+  for (const email of validEmails) {
+    it(`accepts the email ${JSON.stringify(email)}`, async () => {
+      const { page, problems, close } = await openForm();
+      try {
+        await fillValid(page);
+        await page.fill('#email', email);
+        await page.click('button[type="submit"]');
+
+        assert.equal((await errorTexts(page)).email, '');
+        assert.equal(await page.getAttribute('#email', 'aria-invalid'), null);
+        assert.equal(await page.locator('#form-status').textContent(), DEMO_STATUS);
+        assert.deepEqual(problems, []);
+      } finally {
+        await close();
+      }
+    });
+  }
+
+  it('clears an error as soon as the field is corrected', async () => {
+    const { page, close } = await openForm();
+    try {
+      await page.click('button[type="submit"]');
+      await page.fill('#name', 'Ada Morrow');
+
+      assert.equal((await errorTexts(page)).name, '');
+      assert.equal(await page.getAttribute('#name', 'aria-invalid'), null);
+      assert.equal(await page.getAttribute('#name', 'aria-describedby'), null);
+    } finally {
+      await close();
+    }
+  });
+
+  it('shows a demo status on a valid submit, without claiming the message was sent', async () => {
+    const { page, problems, close } = await openForm();
+    try {
+      await fillValid(page);
+      await page.click('button[type="submit"]');
+
+      const status = await page.locator('#form-status').textContent();
+      assert.equal(status, DEMO_STATUS);
+      assert.doesNotMatch(status, /(message|form|enquiry) (has been |was )?sent|thank you/i);
+      assert.equal(await page.evaluate(() => window.__loadMarker), 'original');
+      assert.equal(await page.locator('#form-status').getAttribute('role'), 'status');
+      assert.deepEqual(problems, []);
+    } finally {
+      await close();
+    }
+  });
+
+  it('does not duplicate the status or navigate when the submit is pressed twice', async () => {
+    const { page, problems, close } = await openForm();
+    try {
+      await fillValid(page);
+      const url = page.url();
+      await page.locator('button[type="submit"]').dblclick();
+
+      assert.equal(await page.locator('#form-status').textContent(), DEMO_STATUS);
+      assert.equal(page.url(), url);
+      assert.equal(await page.evaluate(() => window.__loadMarker), 'original');
+      assert.deepEqual(problems, []);
+    } finally {
+      await close();
+    }
+  });
+
+  it('keeps a pasted 10,000 character message to the 2000 limit with a visible counter', async () => {
+    const { page, problems, close } = await openForm();
+    try {
+      await fillValid(page);
+      await page.fill('#message', '');
+      await page.click('#message');
+      await page.keyboard.insertText('x'.repeat(10000));
+
+      const length = await page.evaluate(() => document.getElementById('message').value.length);
+      assert.equal(length, 2000);
+      assert.equal(
+        await page.locator('#message-count').textContent(),
