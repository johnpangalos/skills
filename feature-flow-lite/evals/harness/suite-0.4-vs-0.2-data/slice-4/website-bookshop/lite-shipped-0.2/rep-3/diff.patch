+      );
+      assert.equal(await page.getByRole('heading', { name: 'Past events' }).isVisible(), true);
+      assert.equal(await page.locator('#no-upcoming').isVisible(), false);
+      assert.equal(await page.locator('#upcoming-events').isVisible(), true);
