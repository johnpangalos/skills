+    const { page, problems, close } = await openPage(browser, `${server.url}/events.html`, {
+      clock: lateOnStorytimeDay,
+    });
+    try {
+      const upcoming = await listEvents(page, 'upcoming-events');
+      const past = await listEvents(page, 'past-event-list');
+      assert.equal(upcoming[0].title, 'Saturday Storytime for under-sixes');
+      assert.equal(upcoming[0].date, '2027-03-06T11:00');
+      assert.deepEqual(
