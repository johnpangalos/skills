@@ -0,0 +1,568 @@
+/* Marginalia Books: shared styles for every page. */
+
+:root {
+  --paper: #fbf7ef;
+  --ink: #1f1b16;
+  --muted: #5b5247;
+  --forest: #22372b;
+  --burgundy: #7a1f2b;
+  --burgundy-dark: #5c1620;
+  --line: #d9cfbf;
+  --field-border: #6b6257;
+  --error: #9b1c1c;
+  --focus: #1f4e8c;
+  --focus-on-dark: #fde68a;
+  --serif:
+    Georgia, "Iowan Old Style", "Palatino Linotype", "Times New Roman", serif;
+  --sans:
+    system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial,
+    sans-serif;
+}
+
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+
+[hidden] {
+  display: none !important;
+}
+
+body {
+  margin: 0;
+  background: var(--paper);
+  color: var(--ink);
+  font-family: var(--sans);
+  font-size: 1.0625rem;
+  line-height: 1.6;
+  overflow-wrap: break-word;
+}
+
+h1,
+h2,
+h3 {
+  font-family: var(--serif);
+  line-height: 1.2;
+  color: var(--ink);
+}
+
+h1 {
+  font-size: clamp(1.9rem, 5vw, 2.7rem);
+  margin: 0 0 1rem;
+}
+
+h2 {
+  font-size: 1.6rem;
+  margin: 0 0 0.75rem;
+}
+
+h3 {
+  font-size: 1.2rem;
+  margin: 0 0 0.35rem;
+}
+
+p {
+  margin: 0 0 1rem;
+}
+
+a {
+  color: var(--burgundy);
+  text-underline-offset: 0.2em;
+}
+
+:focus-visible {
+  outline: 3px solid var(--focus);
+  outline-offset: 2px;
+}
+
+.skip-link {
+  position: absolute;
+  top: -4rem;
+  left: 0.5rem;
+  z-index: 10;
+  padding: 0.75rem 1rem;
+  background: var(--ink);
+  color: var(--paper);
+  font-weight: 700;
+  text-decoration: none;
+}
+
+.skip-link:focus {
+  top: 0.5rem;
+}
+
+/* Header and navigation */
+
+.site-header {
+  background: var(--forest);
+  color: var(--paper);
+}
+
+.site-header__inner {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0.5rem 1rem;
+  max-width: 72rem;
+  margin: 0 auto;
+  padding: 0.5rem 1rem;
+}
+
+.brand {
+  display: inline-flex;
+  align-items: center;
+  min-height: 44px;
+  color: var(--paper);
+  font-family: var(--serif);
+  font-size: 1.35rem;
+  font-weight: 700;
+  text-decoration: none;
+}
+
+.nav-toggle {
+  min-width: 44px;
+  min-height: 44px;
+  padding: 0.4rem 1rem;
+  border: 2px solid var(--paper);
+  border-radius: 4px;
+  background: transparent;
+  color: var(--paper);
+  font: inherit;
+  font-weight: 600;
+  cursor: pointer;
+}
+
+.site-nav {
+  display: none;
+  flex-basis: 100%;
+}
+
+.site-nav.is-open {
+  display: block;
+}
+
+.site-nav ul {
+  display: flex;
+  flex-direction: column;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.site-nav a {
+  display: flex;
+  align-items: center;
+  min-height: 44px;
+  padding: 0.5rem 0.25rem;
+  color: var(--paper);
+  font-weight: 600;
+  text-decoration: none;
+}
+
+.site-nav a:hover {
+  text-decoration: underline;
+}
+
+.site-nav a[aria-current="page"] {
+  text-decoration: underline;
+  text-decoration-thickness: 2px;
+  text-underline-offset: 0.3em;
+}
+
+.site-header :focus-visible,
+.site-footer :focus-visible {
+  outline-color: var(--focus-on-dark);
+}
+
+@media (min-width: 48rem) {
+  .nav-toggle {
+    display: none;
+  }
+
+  .site-nav {
+    display: block;
+    flex-basis: auto;
+  }
+
+  .site-nav ul {
+    flex-direction: row;
+    gap: 0.25rem;
+  }
+
+  .site-nav a {
+    padding: 0.5rem 0.75rem;
+  }
+}
+
+/* Layout and shared components */
+
+main {
+  max-width: 72rem;
+  margin: 0 auto;
+  padding: 1.5rem 1rem 3rem;
+}
+
+main > section {
+  margin-bottom: 2.5rem;
+}
+
+.lead {
+  max-width: 42rem;
+  font-size: 1.2rem;
+}
+
+.hero {
+  padding: 2rem 1.25rem;
+  border-left: 6px solid var(--burgundy);
+  border-radius: 6px;
+  background: #efe4cf;
+}
+
+.hero__actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.75rem;
+  margin: 0;
+}
+
+.button {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-height: 44px;
+  padding: 0.5rem 1.25rem;
+  border: 2px solid var(--burgundy);
+  border-radius: 4px;
+  background: var(--burgundy);
+  color: var(--paper);
+  font: inherit;
+  font-weight: 700;
+  text-decoration: none;
+  cursor: pointer;
+}
+
+.button:hover {
+  border-color: var(--burgundy-dark);
+  background: var(--burgundy-dark);
+}
+
+.button--secondary {
+  border-color: var(--ink);
+  background: transparent;
+  color: var(--ink);
+}
+
+.button--secondary:hover {
+  background: var(--ink);
+  color: var(--paper);
+}
+
+.table-wrap {
+  overflow-x: auto;
+}
+
+/* Books */
+
+.genre-filter {
+  min-width: 0;
+  margin: 0 0 1.25rem;
+  padding: 0;
+  border: 0;
+}
+
+.genre-filter legend {
+  margin-bottom: 0.5rem;
+  padding: 0;
+  font-weight: 700;
+}
+
+.genre-options {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.5rem;
+}
+
+.genre-option {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.5rem;
+  min-height: 44px;
+  padding: 0.35rem 0.9rem;
+  border: 2px solid var(--field-border);
+  border-radius: 999px;
+  background: #fff;
+  cursor: pointer;
+}
+
+.genre-option input {
+  width: 1.1rem;
+  height: 1.1rem;
+  margin: 0;
+  accent-color: var(--burgundy);
+}
+
+.genre-option:has(input:checked) {
+  border-color: var(--ink);
+  background: var(--ink);
+  color: var(--paper);
+}
+
+.filter-status {
+  margin: 0 0 1.25rem;
+  font-weight: 600;
+}
+
+.book-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(min(16rem, 100%), 1fr));
+  gap: 1.5rem;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.book-card {
+  display: flex;
+  flex-direction: column;
+  gap: 1rem;
+  padding: 1rem;
+  border: 1px solid var(--line);
+  border-radius: 6px;
+  background: #fff;
+}
+
+.cover {
+  display: flex;
+  flex-direction: column;
+  justify-content: space-between;
+  width: min(100%, 11rem);
+  aspect-ratio: 2 / 3;
+  margin: 0 auto;
+  padding: 1rem;
+  border-radius: 3px;
+  background: linear-gradient(160deg, var(--cover-start), var(--cover-end));
+  color: var(--paper);
+  box-shadow: 0 4px 10px rgba(31, 27, 22, 0.25);
+}
+
+.cover__title {
+  font-family: var(--serif);
+  font-size: 1.15rem;
+  font-weight: 700;
+  line-height: 1.2;
+}
+
+.cover__author {
+  font-family: var(--serif);
+  font-size: 0.9rem;
+  font-style: italic;
+}
+
+.book-card__body p {
+  margin: 0 0 0.4rem;
+}
+
+.genre-tag {
+  color: var(--burgundy);
+  font-size: 0.85rem;
+  font-weight: 700;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+}
+
+.book-card__author,
+.book-card__blurb {
+  color: var(--muted);
+}
+
+.book-card__blurb {
+  font-size: 0.97rem;
+}
+
+.book-card__price {
+  font-weight: 700;
+}
+
+/* Events */
+
+.event-list {
+  display: grid;
+  gap: 1rem;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.event-card {
+  padding: 1rem 1.25rem;
+  border: 1px solid var(--line);
+  border-left: 6px solid var(--burgundy);
+  border-radius: 6px;
+  background: #fff;
+}
+
+.event-card p {
+  margin: 0.25rem 0;
+}
+
+.event-card__when {
+  color: var(--burgundy);
+  font-weight: 700;
+}
+
+.event-card__admission {
+  color: var(--muted);
+  font-size: 0.95rem;
+}
+
+.empty-state {
+  padding: 1rem;
+  border: 1px dashed var(--field-border);
+  border-radius: 6px;
+}
+
+/* Visit */
+
+.hours-table {
+  width: 100%;
+  border-collapse: collapse;
+  background: #fff;
+}
+
+.hours-table caption {
+  padding: 0.5rem 0;
+  color: var(--muted);
+  font-size: 0.95rem;
+  text-align: left;
+}
+
+.hours-table th,
+.hours-table td {
+  padding: 0.6rem 0.75rem;
+  border-bottom: 1px solid var(--line);
+  text-align: left;
+}
+
+.hours-table thead th {
+  font-family: var(--serif);
+}
+
+address {
+  margin-bottom: 1rem;
+  font-style: normal;
+}
+
+.contact-form {
+  max-width: 36rem;
+}
+
+.field {
+  margin-bottom: 1.25rem;
+}
+
+.field label {
+  display: block;
+  margin-bottom: 0.3rem;
+  font-weight: 700;
+}
+
+.required {
+  color: var(--muted);
+  font-weight: 400;
+}
+
+.field input,
+.field select,
+.field textarea {
+  display: block;
+  width: 100%;
+  min-height: 44px;
+  padding: 0.55rem 0.7rem;
+  border: 2px solid var(--field-border);
+  border-radius: 4px;
+  background: #fff;
+  color: var(--ink);
+  font: inherit;
+}
+
+.field textarea {
+  min-height: 9rem;
+  resize: vertical;
+}
+
+.field [aria-invalid="true"] {
+  border-color: var(--error);
+  box-shadow: inset 0 0 0 1px var(--error);
+}
+
+.field-error {
+  margin: 0.3rem 0 0;
+  color: var(--error);
+  font-weight: 700;
+}
+
+.hint {
+  margin: 0.3rem 0 0;
+  color: var(--muted);
+  font-size: 0.9rem;
+}
+
+.form-summary {
+  margin-bottom: 1.25rem;
+  padding: 0.75rem 1rem;
+  border-left: 6px solid var(--error);
+  background: #fbe9e9;
+  font-weight: 700;
+}
+
+.form-status:not(:empty) {
+  padding: 1rem 1.25rem;
+  border-left: 6px solid var(--forest);
+  border-radius: 4px;
+  background: #e7f0e7;
+}
+
+.form-status p:last-child {
+  margin-bottom: 0;
+}
+
+/* Footer */
+
+.site-footer {
+  background: var(--ink);
+  color: var(--paper);
+}
+
+.site-footer__inner {
+  max-width: 72rem;
+  margin: 0 auto;
+  padding: 2rem 1rem;
+}
+
+.site-footer p {
+  margin: 0 0 0.5rem;
+}
+
+.site-footer a {
+  color: var(--paper);
+}
+
+/* Motion: respect the reader's settings */
+
+@media (prefers-reduced-motion: no-preference) {
+  html {
+    scroll-behavior: smooth;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    scroll-behavior: auto !important;
+    transition-duration: 0.01ms !important;
+    animation-duration: 0.01ms !important;
+  }
+}
