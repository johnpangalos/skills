+      assert.ok(count >= 5, `only ${count} upcoming events`);
+    }));
+});
+
+describe("visit page contact form", () => {
+  it("uses native types and autocomplete, and marks required fields in text", () =>
+    withPage("/visit.html", 1280, async (page) => {
+      assert.equal(await page.getAttribute("#email", "type"), "email");
+      assert.equal(await page.getAttribute("#name", "autocomplete"), "name");
+      assert.equal(await page.getAttribute("#email", "autocomplete"), "email");
+      assert.notEqual(
+        await page.getAttribute("#contact-form", "novalidate"),
+        null,
+      );
+      assert.match(
+        await page.locator('label[for="name"]').textContent(),
+        /\(required\)/,
+      );
+      assert.equal(await page.getAttribute("#message", "maxlength"), "2000");
+    }));
+
+  it("shows an error per empty field, sets aria-invalid, and focuses the first invalid field", () =>
+    withPage("/visit.html", 1280, async (page) => {
+      await submitButton(page).click();
+      const fields = await page.evaluate(() =>
+        ["name", "email", "message"].map((id) => {
+          const field = document.getElementById(id);
+          const described = field
+            .getAttribute("aria-describedby")
+            .split(/\s+/)
+            .map((ref) => document.getElementById(ref).textContent)
+            .join(" ");
+          return { id, invalid: field.getAttribute("aria-invalid"), described };
+        }),
+      );
+      for (const field of fields) {
+        assert.equal(field.invalid, "true", `${field.id} is not aria-invalid`);
+        assert.match(
+          field.described,
+          /Please (enter|fill)|Please enter/,
+          `${field.id} message not described`,
+        );
+      }
+      assert.equal(
+        await page.textContent("#name-error"),
+        "Please enter your name.",
+      );
+      assert.equal(
+        await page.evaluate(() => document.activeElement.id),
+        "name",
+      );
+      assert.match(
+        await page.textContent("#form-summary"),
+        /Please fix 3 problems/,
+      );
+    }));
+
+  it("rejects a whitespace-only name and message as empty", () =>
+    withPage("/visit.html", 1280, async (page) => {
+      await fillForm(page, {
+        name: "   ",
+        email: "ada@example.com",
+        message: "   ",
+      });
+      await submitButton(page).click();
+      assert.equal(
+        await page.textContent("#name-error"),
+        "Please enter your name.",
+      );
+      assert.equal(
+        await page.textContent("#message-error"),
+        "Please enter a message.",
+      );
+      assert.equal(await page.getAttribute("#name", "aria-invalid"), "true");
+      assert.equal(await page.getAttribute("#email", "aria-invalid"), null);
+      assert.equal(
+        await page.evaluate(() => document.activeElement.id),
+        "name",
+      );
+      assert.equal(await page.locator("#form-status").textContent(), "");
+    }));
+
+  for (const email of ["a@", "foo"]) {
+    it(`rejects the email "${email}" with a message tied to the field`, () =>
+      withPage("/visit.html", 1280, async (page) => {
+        await fillForm(page, { name: "Ada", email, message: "Hello" });
+        await submitButton(page).click();
+        assert.equal(await page.getAttribute("#email", "aria-invalid"), "true");
+        assert.match(
+          await page.textContent("#email-error"),
+          /name@example\.com/,
+        );
+        assert.equal(
+          await page.evaluate(() => document.activeElement.id),
+          "email",
+        );
+        assert.equal(await page.locator("#form-status").textContent(), "");
+      }));
+  }
+
+  it("rejects a message over 2000 characters", () =>
+    withPage("/visit.html", 1280, async (page) => {
+      await fillForm(page, {
+        name: "Ada",
+        email: "ada@example.com",
+        message: "Hello",
+      });
+      await page.evaluate(() => {
+        const message = document.getElementById("message");
+        message.value = "x".repeat(2001);
+        message.dispatchEvent(new Event("input", { bubbles: true }));
+      });
+      await submitButton(page).click();
+      assert.equal(await page.getAttribute("#message", "aria-invalid"), "true");
+      assert.match(
+        await page.textContent("#message-error"),
+        /over 2000 characters/,
+      );
+      assert.equal(
+        await page.evaluate(() => document.activeElement.id),
+        "message",
+      );
+    }));
+
+  it("clears a field error once the field is corrected", () =>
+    withPage("/visit.html", 1280, async (page) => {
+      await submitButton(page).click();
+      await page.fill("#name", "Ada");
+      assert.equal(await page.getAttribute("#name", "aria-invalid"), null);
+      assert.equal(await page.locator("#name-error").isHidden(), true);
+      assert.match(
+        await page.textContent("#form-summary"),
+        /Please fix 2 problems/,
+      );
+    }));
+
+  it("says plainly that a valid message was not sent, and offers a mailto link", () =>
+    withPage("/visit.html", 1280, async (page) => {
+      await fillForm(page, {
+        name: "Ada",
+        email: "ada@example.com",
+        message: "Do you stock poetry?",
+      });
+      await submitButton(page).click();
+      const status = await page.locator("#form-status").innerText();
+      assert.match(status, /Thanks, Ada/);
+      assert.ok(status.includes(DEMO_SENTENCE), status);
+      assert.match(status, /wasn't sent/);
+      assert.doesNotMatch(
+        status,
+        /(has|have) been sent|we('ve| have) received|message sent/i,
+      );
+      assert.equal(
+        await page
+          .locator(
+            '#form-status a[href^="mailto:hello@marginaliabooks.example"]',
+          )
+          .count(),
+        1,
+      );
+    }));
+
+  it("does not duplicate the demo message when submitted twice", () =>
+    withPage("/visit.html", 1280, async (page) => {
+      await fillForm(page, {
+        name: "Ada",
+        email: "ada@example.com",
+        message: "Hello",
+      });
+      await submitButton(page).click();
+      await submitButton(page).click();
+      const status = await page.locator("#form-status").textContent();
+      assert.equal(status.split(DEMO_SENTENCE).length - 1, 1);
+    }));
+});
