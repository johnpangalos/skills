+
+  var catalog = window.MarginaliaCatalog;
+  var schedule = window.MarginaliaEvents;
+  var now = new Date();
+
+  catalog.books
+    .filter(function (book) {
+      return book.featured;
+    })
+    .forEach(function (book) {
+      picks.appendChild(catalog.makeCard(book));
+    });
+
+  schedule.renderEvents(
+    nextEvents,
+    schedule.upcomingEvents(schedule.events, now).slice(0, 3),
+    now,
+  );
+})();
diff --git a/js/main.js b/js/main.js
new file mode 100644
index 0000000..d3a3eed
--- /dev/null
+++ b/js/main.js
@@ -0,0 +1,30 @@
+// Shared behaviour for every page: the mobile navigation toggle.
+(function () {
+  "use strict";
+
+  var toggle = document.querySelector(".nav-toggle");
+  var nav = document.getElementById("site-nav");
+  if (!toggle || !nav) {
+    return;
+  }
+
+  function isOpen() {
+    return toggle.getAttribute("aria-expanded") === "true";
+  }
+
+  function setOpen(open) {
+    toggle.setAttribute("aria-expanded", open ? "true" : "false");
+    nav.classList.toggle("is-open", open);
+  }
+
+  toggle.addEventListener("click", function () {
+    setOpen(!isOpen());
+  });
+
+  document.addEventListener("keydown", function (event) {
+    if (event.key === "Escape" && isOpen()) {
+      setOpen(false);
+      toggle.focus();
+    }
+  });
+})();
