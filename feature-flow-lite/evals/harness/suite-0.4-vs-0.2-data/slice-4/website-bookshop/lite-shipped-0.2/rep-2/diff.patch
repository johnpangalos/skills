+const http = require("node:http");
+const path = require("node:path");
+const { chromium } = require("playwright");
+
+const ROOT = path.resolve(__dirname, "..");
+const CONTENT_TYPES = {
+  ".html": "text/html; charset=utf-8",
+  ".css": "text/css; charset=utf-8",
+  ".js": "text/javascript; charset=utf-8",
+  ".svg": "image/svg+xml",
+};
+const NAV = [
+  ["Home", "index.html"],
+  ["Books", "books.html"],
+  ["Events", "events.html"],
+  ["Visit", "visit.html"],
+];
+const PAGES = [
+  { route: "/", file: "index.html", current: "Home" },
+  { route: "/books.html", file: "books.html", current: "Books" },
+  { route: "/events.html", file: "events.html", current: "Events" },
+  { route: "/visit.html", file: "visit.html", current: "Visit" },
+];
+const DEMO_SENTENCE = "this is a demo site";
+
+let server;
+let origin;
+let browser;
+
+// Serves the repository root. Paths are resolved inside ROOT only.
+function createServer() {
+  return http.createServer((request, response) => {
+    const requested = decodeURIComponent(
+      new URL(request.url, "http://localhost").pathname,
+    );
+    const file = path.join(ROOT, requested === "/" ? "index.html" : requested);
+    if (!file.startsWith(ROOT + path.sep)) {
+      response.writeHead(403).end();
+      return;
+    }
+    fs.readFile(file, (error, data) => {
+      if (error) {
+        response
+          .writeHead(404, { "Content-Type": "text/plain" })
+          .end("Not found");
+        return;
+      }
+      response.writeHead(200, {
+        "Content-Type":
+          CONTENT_TYPES[path.extname(file)] || "application/octet-stream",
+      });
+      response.end(data);
+    });
+  });
+}
+
+before(async () => {
+  server = createServer();
+  await new Promise((resolve) => server.listen(0, "127.0.0.1", resolve));
+  origin = `http://127.0.0.1:${server.address().port}`;
+  browser = await chromium.launch({ executablePath: "/usr/bin/google-chrome" });
+});
+
+after(async () => {
+  await browser.close();
+  server.closeAllConnections();
+  await new Promise((resolve) => server.close(resolve));
+});
+
+// Opens a page and records console errors, uncaught exceptions and off-origin requests.
+async function openPage(route, width = 1280) {
+  const page = await browser.newPage({ viewport: { width, height: 900 } });
+  const seen = { errors: [], external: [] };
+  page.on("console", (message) => {
+    if (message.type() === "error") {
+      seen.errors.push(message.text());
+    }
+  });
+  page.on("pageerror", (error) => seen.errors.push(error.message));
+  page.on("request", (request) => {
+    if (new URL(request.url()).origin !== origin) {
+      seen.external.push(request.url());
+    }
+  });
+  await page.goto(origin + route);
+  await page.waitForLoadState("networkidle");
+  return { page, seen };
+}
+
+async function withPage(route, width, run) {
+  const { page, seen } = await openPage(route, width);
+  try {
+    await run(page, seen);
+  } finally {
+    await page.close();
+  }
+}
+
+function visibleBookCount(page) {
+  return page.$$eval(
+    "#book-grid li",
+    (items) => items.filter((item) => !item.hidden).length,
+  );
+}
+
+async function fillForm(page, { name = "", email = "", message = "" }) {
+  await page.fill("#name", name);
+  await page.fill("#email", email);
+  await page.fill("#message", message);
+}
+
+function submitButton(page) {
