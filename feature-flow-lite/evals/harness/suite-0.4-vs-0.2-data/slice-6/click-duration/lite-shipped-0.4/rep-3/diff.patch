+class DurationInfoDict(ParamTypeInfoDict):
+    min: timedelta | None
+    max: timedelta | None
+
+
+class Duration(ParamType[timedelta]):
+    """Convert a duration string to a :class:`datetime.timedelta`.
+
+    A duration is one or more ``<integer><unit>`` parts, using the units
+    ``d``, ``h``, ``m``, ``s`` and ``ms``, largest unit first and each unit at
+    most once, such as ``90s``, ``5m``, ``1h30m`` or ``1m500ms``. A bare integer
+    is a number of seconds. Negative durations are not accepted.
+
+    If ``min`` or ``max`` are passed, the value must be within that range,
+    inclusive. A :class:`datetime.timedelta` value is checked against the range
+    and returned unchanged.
+
+    :param min: The smallest accepted duration.
+    :param max: The largest accepted duration.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "duration"
+
+    # Only ASCII digits are allowed, so the grammar cannot match Unicode digits.
+    _pattern = re.compile(
+        r"(?P<bare>[0-9]+)"
+        r"|(?=[0-9])"
+        r"(?:(?P<days>[0-9]+)d)?"
+        r"(?:(?P<hours>[0-9]+)h)?"
+        r"(?:(?P<minutes>[0-9]+)m)?"
+        r"(?:(?P<seconds>[0-9]+)s)?"
+        r"(?:(?P<milliseconds>[0-9]+)ms)?"
+    )
+
+    def __init__(
+        self, min: timedelta | None = None, max: timedelta | None = None
+    ) -> None:
+        self.min = min
+        self.max = max
+
+    def to_info_dict(self) -> DurationInfoDict:
+        return {"min": self.min, "max": self.max, **super().to_info_dict()}
+
+    def _parse(self, value: str) -> timedelta | None:
+        match = self._pattern.fullmatch(value)
+
+        if match is None:
+            return None
+
+        try:
+            parts = {
+                name: int(amount)
+                for name, amount in match.groupdict().items()
+                if amount is not None
+            }
+
+            if "bare" in parts:
+                parts = {"seconds": parts["bare"]}
+
+            return timedelta(**parts)
+        except (OverflowError, ValueError):
+            return None
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        rv: timedelta | None
+
+        if isinstance(value, timedelta):
+            rv = value
+        else:
+            rv = self._parse(str(value))
+
+        if rv is None or rv < timedelta(0):
+            self.fail(
+                _("{value!r} is not a valid duration.").format(value=value),
+                param,
+                ctx,
+            )
+
+        if (self.min is not None and rv < self.min) or (
+            self.max is not None and rv > self.max
+        ):
+            self.fail(
+                _("{value} is not in the range {range}.").format(
+                    value=rv, range=self._describe_range()
+                ),
+                param,
+                ctx,
+            )
+
+        return rv
+
+    def _describe_range(self) -> str:
+        """Describe the range for use in help text."""
+        if self.min is None and self.max is None:
+            return ""
+
+        if self.min is None:
+            return f"x<={self.max}"
+
+        if self.max is None:
+            return f"x>={self.min}"
+
+        return f"{self.min}<=x<={self.max}"
+
+    def __repr__(self) -> str:
+        range_str = self._describe_range()
+        return f"<Duration {range_str}>" if range_str else "Duration"
+
+
