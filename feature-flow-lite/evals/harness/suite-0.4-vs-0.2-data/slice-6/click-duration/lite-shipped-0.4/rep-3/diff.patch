diff --git a/tests/test_types/test_Duration.py b/tests/test_types/test_Duration.py
new file mode 100644
index 0000000..1158a74
--- /dev/null
+++ b/tests/test_types/test_Duration.py
@@ -0,0 +1,196 @@
+from datetime import timedelta
+
+import pytest
+
+import click
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        ("90s", timedelta(seconds=90)),
+        ("5m", timedelta(minutes=5)),
+        ("1h30m", timedelta(hours=1, minutes=30)),
+        ("2d4h", timedelta(days=2, hours=4)),
+        ("1m500ms", timedelta(seconds=60.5)),
+        (
+            "1d2h3m4s5ms",
+            timedelta(days=1, hours=2, minutes=3, seconds=4, milliseconds=5),
+        ),
+        ("0", timedelta(0)),
+        ("45", timedelta(seconds=45)),
+    ],
+)
+def test_convert(value, expect):
+    assert click.Duration().convert(value, None, None) == expect
+
+
+def test_name():
+    assert click.Duration().name == "duration"
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "",
+        "s",
+        "1h1h",
+        "30m1h",
+        "1.5h",
+        "1H",
+        "1 h",
+        "1x",
+        "ms",
+        "1h30",
+        "1ms1s",
+        " 5s",
+        "5s\n",
+        "١s",
+        "-5s",
+        "-1",
+        "-0",
+        "999999999999d",
+        "1" + "0" * 30,
+    ],
+)
+def test_convert_invalid(value):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert exc_info.value.message == f"{value!r} is not a valid duration."
+
+
+@pytest.mark.parametrize(
+    ("type", "value", "expect"),
+    [
+        (click.Duration(min=timedelta(seconds=5)), "5s", timedelta(seconds=5)),
+        (click.Duration(max=timedelta(minutes=1)), "60", timedelta(minutes=1)),
+        (
+            click.Duration(timedelta(seconds=5), timedelta(minutes=1)),
+            "1m",
+            timedelta(minutes=1),
+        ),
+        (
+            click.Duration(timedelta(seconds=5), timedelta(minutes=1)),
+            "30s",
+            timedelta(seconds=30),
+        ),
+    ],
+)
+def test_range(type, value, expect):
+    assert type.convert(value, None, None) == expect
+
+
+@pytest.mark.parametrize(
+    ("type", "value", "expect"),
+    [
+        (
+            click.Duration(min=timedelta(seconds=5)),
+            "4s",
+            "0:00:04 is not in the range x>=0:00:05.",
+        ),
+        (
+            click.Duration(max=timedelta(minutes=1)),
+            "61s",
+            "0:01:01 is not in the range x<=0:01:00.",
+        ),
+        (
+            click.Duration(timedelta(seconds=5), timedelta(minutes=1)),
+            "2m",
+            "0:02:00 is not in the range 0:00:05<=x<=0:01:00.",
+        ),
+        (
+            click.Duration(timedelta(seconds=5), timedelta(minutes=1)),
+            "4s",
+            "0:00:04 is not in the range 0:00:05<=x<=0:01:00.",
+        ),
+    ],
+)
+def test_range_fail(type, value, expect):
+    with pytest.raises(click.BadParameter) as exc_info:
+        type.convert(value, None, None)
+
+    assert exc_info.value.message == expect
+
+
+def test_timedelta_passthrough():
+    value = timedelta(seconds=5)
+    assert click.Duration().convert(value, None, None) is value
+
+
+def test_timedelta_passthrough_checks_range():
+    type = click.Duration(max=timedelta(seconds=10))
+
+    with pytest.raises(click.BadParameter) as exc_info:
+        type.convert(timedelta(seconds=11), None, None)
+
+    assert exc_info.value.message == "0:00:11 is not in the range x<=0:00:10."
+
+
+def test_negative_timedelta_fails():
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(timedelta(seconds=-5), None, None)
+
+    assert exc_info.value.message == (
+        "datetime.timedelta(days=-1, seconds=86395) is not a valid duration."
+    )
+
+
+def test_repr():
+    assert repr(click.Duration()) == "Duration"
+    assert repr(click.Duration(min=timedelta(seconds=5))) == "<Duration x>=0:00:05>"
+    assert (
+        repr(click.Duration(timedelta(seconds=5), timedelta(minutes=1)))
+        == "<Duration 0:00:05<=x<=0:01:00>"
+    )
+
+
+@click.command()
+@click.option(
+    "--wait",
+    type=click.Duration(timedelta(seconds=5), timedelta(minutes=1)),
+)
+def wait_cmd(wait):
+    click.echo(str(wait.total_seconds()))
+
+
+def test_cli_valid(runner):
+    result = runner.invoke(wait_cmd, ["--wait", "1m"])
+    assert result.exit_code == 0
+    assert result.output == "60.0\n"
+
+
+@pytest.mark.parametrize(
+    ("value", "message"),
+    [
+        ("2m", "Invalid value for '--wait': 0:02:00 is not in the range"),
+        ("-5s", "Invalid value for '--wait': '-5s' is not a valid duration."),
+        (
+            "999999999999d",
+            "Invalid value for '--wait': '999999999999d' is not a valid duration.",
+        ),
+        ("1h30", "Invalid value for '--wait': '1h30' is not a valid duration."),
+    ],
+)
+def test_cli_invalid(runner, value, message):
+    result = runner.invoke(wait_cmd, [f"--wait={value}"])
+    assert result.exit_code == 2
+    assert message in result.output
+
+
+def test_help_shows_range(runner):
+    result = runner.invoke(wait_cmd, ["--help"])
+    assert result.exit_code == 0
+    assert "0:00:05<=x<=0:01:00" in result.output
+
+
+def test_help_without_range(runner):
+    @click.command()
+    @click.option("--wait", type=click.Duration())
+    def cmd(wait):
+        pass
+
+    result = runner.invoke(cmd, ["--help"])
+    assert result.exit_code == 0
+    assert "x<=" not in result.output
+    assert "x>=" not in result.output
