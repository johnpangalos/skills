+def _format_duration(value: timedelta) -> str:
+    """Format a timedelta in the input syntax, largest unit first."""
+    if value < timedelta(0):
+        return f"-{_format_duration(-value)}"
+
+    total_us = value // timedelta(microseconds=1)
+
+    if total_us % 1000:
+        seconds, microseconds = divmod(total_us, 1_000_000)
+        return f"{seconds}.{microseconds:06d}".rstrip("0") + "s"
+
+    units = (
+        ("d", 86_400_000),
+        ("h", 3_600_000),
+        ("m", 60_000),
+        ("s", 1_000),
+        ("ms", 1),
+    )
+    parts = []
+    milliseconds = total_us // 1000
+
+    for suffix, size in units:
+        count, milliseconds = divmod(milliseconds, size)
+
+        if count:
+            parts.append(f"{count}{suffix}")
+
+    return "".join(parts) or "0s"
+
+
+class DurationInfoDict(ParamTypeInfoDict):
+    min: timedelta | None
+    max: timedelta | None
+
+
+class Duration(ParamType[timedelta]):
+    """Convert a duration string such as ``1h30m`` into a
+    :class:`datetime.timedelta`.
+
+    A value is one or more ``<integer><unit>`` parts, using the units ``d``,
+    ``h``, ``m``, ``s`` and ``ms``. The parts must be in that order and each
+    unit may be used at most once. A bare integer is a number of seconds. Only
+    ASCII digits are accepted, with no sign or whitespace.
+
+    If ``min`` or ``max`` are passed, the value must be between them,
+    inclusive.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "duration"
+
+    _units_re = re.compile(
+        r"(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m(?!s))?(?:([0-9]+)s)?(?:([0-9]+)ms)?"
+    )
+    _seconds_re = re.compile(r"[0-9]+")
+
+    def __init__(
+        self, min: timedelta | None = None, max: timedelta | None = None
+    ) -> None:
+        self.min = min
+        self.max = max
+
+    def to_info_dict(self) -> DurationInfoDict:
+        return {"min": self.min, "max": self.max, **super().to_info_dict()}
+
+    def _parse(self, value: str) -> timedelta | None:
+        """Parse the string form, or return ``None`` if it is malformed or
+        too large to represent.
+        """
+        try:
+            if self._seconds_re.fullmatch(value):
+                return timedelta(seconds=int(value))
+
+            match = self._units_re.fullmatch(value)
+
+            if match is None or not any(match.groups()):
+                return None
+
+            days, hours, minutes, seconds, milliseconds = (
+                int(group or 0) for group in match.groups()
+            )
+            return timedelta(
+                days=days,
+                hours=hours,
+                minutes=minutes,
+                seconds=seconds,
+                milliseconds=milliseconds,
+            )
+        except (OverflowError, ValueError):
+            return None
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        rv = value if isinstance(value, timedelta) else self._parse(str(value))
+
+        if rv is None or rv < timedelta(0):
+            shown = (
+                _format_duration(value) if isinstance(value, timedelta) else repr(value)
+            )
+            self.fail(
+                _("{value} is not a valid duration.").format(value=shown),
+                param,
+                ctx,
+            )
+
+        if (self.min is not None and rv < self.min) or (
+            self.max is not None and rv > self.max
+        ):
+            self.fail(
+                _("{value} is not in the range {range}.").format(
+                    value=_format_duration(rv), range=self._describe_range()
+                ),
+                param,
+                ctx,
+            )
+
+        return rv
+
+    def _describe_range(self) -> str:
+        """Describe the range for use in help text."""
+        if self.min is not None and self.max is not None:
+            return f"{_format_duration(self.min)}<=x<={_format_duration(self.max)}"
+
+        if self.min is not None:
+            return f"x>={_format_duration(self.min)}"
+
+        if self.max is not None:
+            return f"x<={_format_duration(self.max)}"
+
+        return ""
+
+    def __repr__(self) -> str:
+        if self.min is None and self.max is None:
+            return "DURATION"
+
+        return f"<Duration {self._describe_range()}>"
+
+
