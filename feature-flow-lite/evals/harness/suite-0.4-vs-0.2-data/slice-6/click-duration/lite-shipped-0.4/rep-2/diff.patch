@@ -0,0 +1,255 @@
+from datetime import timedelta
+
+import pytest
+
+import click
+import click.types
+from click.testing import CliRunner
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        ("90s", timedelta(seconds=90)),
+        ("5m", timedelta(minutes=5)),
+        ("1h30m", timedelta(hours=1, minutes=30)),
+        ("2d4h", timedelta(days=2, hours=4)),
+        ("1m500ms", timedelta(seconds=60.5)),
+        ("5ms", timedelta(milliseconds=5)),
+        ("5m5ms", timedelta(minutes=5, milliseconds=5)),
+        (
+            "1d2h3m4s5ms",
+            timedelta(days=1, hours=2, minutes=3, seconds=4, milliseconds=5),
+        ),
+        ("30", timedelta(seconds=30)),
+        ("05s", timedelta(seconds=5)),
+        ("0", timedelta(0)),
+        ("0s", timedelta(0)),
+        (timedelta(seconds=5), timedelta(seconds=5)),
+    ],
+)
+def test_convert(value, expect):
+    assert click.Duration().convert(value, None, None) == expect
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "1h1h",
+        "30m1h",
+        "5x",
+        "1.5h",
+        "",
+        " ",
+        "h",
+        "1h30",
+        "1h 30m",
+        "5 m",
+        "5S",
+        "5H",
+        "5ms5m",
+        "-5s",
+        "-5",
+        "-0s",
+        "-0",
+        "+5s",
+        "٥s",
+        "999999999999d",
+    ],
+)
+def test_convert_invalid(value):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert exc_info.value.message == f"{value!r} is not a valid duration."
+
+
+@pytest.mark.parametrize(
+    ("type", "value", "expect"),
+    [
+        (click.Duration(min=timedelta(seconds=1)), "1s", timedelta(seconds=1)),
+        (click.Duration(max=timedelta(hours=1)), "1h", timedelta(hours=1)),
+        (
+            click.Duration(min=timedelta(seconds=1), max=timedelta(hours=1)),
+            "1s",
+            timedelta(seconds=1),
+        ),
+        (
+            click.Duration(min=timedelta(seconds=1), max=timedelta(hours=1)),
+            "1h",
+            timedelta(hours=1),
+        ),
+    ],
+)
+def test_range_inclusive(type, value, expect):
+    assert type.convert(value, None, None) == expect
+
+
+@pytest.mark.parametrize(
+    ("type", "value", "expect"),
+    [
+        (
+            click.Duration(min=timedelta(seconds=1), max=timedelta(hours=1)),
+            "500ms",
+            "500ms is not in the range 1s<=x<=1h.",
+        ),
+        (
+            click.Duration(min=timedelta(seconds=1), max=timedelta(hours=1)),
+            "1h1ms",
+            "1h1ms is not in the range 1s<=x<=1h.",
+        ),
+        (
+            click.Duration(min=timedelta(minutes=1)),
+            "30s",
+            "30s is not in the range x>=1m.",
+        ),
+        (
+            click.Duration(max=timedelta(hours=1)),
+            "2h",
+            "2h is not in the range x<=1h.",
+        ),
+        (
+            click.Duration(min=timedelta(microseconds=1500)),
+            "0s",
+            "0s is not in the range x>=0.0015s.",
+        ),
+    ],
+)
+def test_range_fail(type, value, expect):
+    with pytest.raises(click.BadParameter) as exc_info:
+        type.convert(value, None, None)
+
+    assert exc_info.value.message == expect
+
+
+@pytest.mark.parametrize(
+    ("type", "expect"),
+    [
+        (click.Duration(), "DURATION"),
+        (
+            click.Duration(min=timedelta(seconds=1), max=timedelta(hours=1)),
+            "<Duration 1s<=x<=1h>",
+        ),
+        (click.Duration(min=timedelta(minutes=1)), "<Duration x>=1m>"),
+        (click.Duration(max=timedelta(hours=1)), "<Duration x<=1h>"),
+    ],
+)
+def test_repr(type, expect):
+    assert repr(type) == expect
+
+
+def test_name_and_export():
+    assert click.Duration is click.types.Duration
+    assert click.Duration().name == "duration"
+
+
+def test_help_range():
+    option = click.Option(
+        ["--timeout"],
+        type=click.Duration(min=timedelta(seconds=1), max=timedelta(hours=1)),
+    )
+    context = click.Context(click.Command("test"))
+    assert option.get_help_extra(context) == {"range": "1s<=x<=1h"}
+    assert "[1s<=x<=1h]" in option.get_help_record(context)[1]
+
+
+def test_cli_success():
+    @click.command()
+    @click.option("--timeout", type=click.Duration(max=timedelta(hours=2)))
+    def cli(timeout):
+        click.echo(timeout.total_seconds())
+
+    result = CliRunner().invoke(cli, ["--timeout", "1h30m"])
+    assert result.exit_code == 0
+    assert result.output == "5400.0\n"
+
+
+def test_cli_malformed_is_usage_error():
+    @click.command()
+    @click.option("--timeout", type=click.Duration())
+    def cli(timeout):
+        click.echo(timeout.total_seconds())
+
+    result = CliRunner().invoke(cli, ["--timeout", "-5s"])
+    assert result.exit_code == 2
+    assert "Invalid value for '--timeout': '-5s' is not a valid duration." in (
+        result.output
+    )
+    assert "Traceback" not in result.output
+
+
+def test_cli_out_of_range_is_usage_error():
+    @click.command()
+    @click.option("--timeout", type=click.Duration(max=timedelta(hours=1)))
+    def cli(timeout):
+        click.echo(timeout.total_seconds())
+
+    result = CliRunner().invoke(cli, ["--timeout", "2h"])
+    assert result.exit_code == 2
+    assert "Invalid value for '--timeout': 2h is not in the range x<=1h." in (
+        result.output
+    )
+
+
+def test_negative_timedelta_shows_display_form():
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(timedelta(seconds=-90), None, None)
+
+    assert exc_info.value.message == "-1m30s is not a valid duration."
+
+
+def test_range_shows_sub_millisecond_as_seconds():
+    option = click.Option(
+        ["--t"], type=click.Duration(max=timedelta(microseconds=1500))
+    )
+    context = click.Context(click.Command("test"))
+    assert option.get_help_extra(context) == {"range": "x<=0.0015s"}
+
+
+def test_help_default_uses_input_syntax():
+    @click.command()
+    @click.option(
+        "--t",
+        type=click.Duration(min=timedelta(seconds=1), max=timedelta(hours=1)),
+        default=timedelta(minutes=30),
+        show_default=True,
+    )
+    def cli(t):
+        pass
+
+    result = CliRunner().invoke(cli, ["--help"])
+    assert "[default: 30m; 1s<=x<=1h]" in result.output
+
+
+def test_help_multiple_default_uses_input_syntax():
+    @click.command()
+    @click.option(
+        "--t",
+        type=click.Duration(),
+        multiple=True,
+        default=[timedelta(minutes=5), "1h"],
+        show_default=True,
+    )
+    def cli(t):
+        pass
+
+    result = CliRunner().invoke(cli, ["--help"])
+    assert "[default: 5m, 1h]" in result.output
+
+
+def test_prompt_default_uses_input_syntax():
+    @click.command()
+    @click.option(
+        "--t",
+        type=click.Duration(),
+        default=timedelta(minutes=30),
+        prompt=True,
+        show_default=True,
+    )
+    def cli(t):
+        click.echo(t)
+
+    result = CliRunner().invoke(cli, [], input="\n")
+    assert result.exit_code == 0
+    assert result.output.startswith("T [30m]: ")
+    assert result.output.splitlines()[-1] == "0:30:00"
