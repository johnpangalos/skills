+_DURATION_RE = re.compile(
+    r"(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?(?:([0-9]+)ms)?"
+)
+
+
+def _parse_duration(value: str) -> timedelta | None:
+    """Parse a duration string, or return ``None`` if it is malformed."""
+    try:
+        if re.fullmatch(r"[0-9]+", value):
+            return timedelta(seconds=int(value))
+
+        match = _DURATION_RE.fullmatch(value)
+
+        if match is None or not any(match.groups()):
+            return None
+
+        days, hours, minutes, seconds, milliseconds = (
+            int(group or 0) for group in match.groups()
+        )
+        return timedelta(
+            days=days,
+            hours=hours,
+            minutes=minutes,
+            seconds=seconds,
+            milliseconds=milliseconds,
+        )
+    except (OverflowError, ValueError):
+        # Overflow for values too large for timedelta, ValueError for integers
+        # beyond Python's digit limit.
+        return None
+
+
+def _format_duration(value: timedelta) -> str:
+    """Format a timedelta in duration syntax, such as ``1h30m``."""
+    millis = value // timedelta(milliseconds=1)
+    days, millis = divmod(millis, 86_400_000)
+    hours, millis = divmod(millis, 3_600_000)
+    minutes, millis = divmod(millis, 60_000)
+    seconds, millis = divmod(millis, 1000)
+    units = (("d", days), ("h", hours), ("m", minutes), ("s", seconds), ("ms", millis))
+    return "".join(f"{amount}{unit}" for unit, amount in units if amount) or "0s"
+
+
+class DurationInfoDict(ParamTypeInfoDict):
+    min: timedelta | None
+    max: timedelta | None
+
+
+class Duration(ParamType[timedelta]):
+    """The Duration type converts a duration string into a
+    :class:`datetime.timedelta`.
+
+    A duration is one or more integer parts, each followed by a unit: ``d``,
+    ``h``, ``m``, ``s`` or ``ms``, such as ``90s``, ``1h30m`` or ``1m500ms``.
+    The units must appear from largest to smallest, and each at most once. A
+    bare integer is a number of seconds. Negative values are not accepted.
+
+    If ``min`` or ``max`` are passed, they are inclusive bounds on the value.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def __init__(
+        self, min: timedelta | None = None, max: timedelta | None = None
+    ) -> None:
+        self.min = min
+        self.max = max
+
+    def to_info_dict(self) -> DurationInfoDict:
+        return {"min": self.min, "max": self.max, **super().to_info_dict()}
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        rv: timedelta | None
+
+        if isinstance(value, timedelta):
+            rv = value
+        elif isinstance(value, str):
+            rv = _parse_duration(value)
+        elif isinstance(value, int) and not isinstance(value, bool) and value >= 0:
+            try:
+                rv = timedelta(seconds=value)
+            except OverflowError:
+                rv = None
+        else:
+            rv = None
+
+        if rv is None or rv < timedelta(0):
+            self.fail(
+                _("{value!r} is not a valid duration.").format(value=value),
+                param,
+                ctx,
+            )
+
+        if (self.min is not None and rv < self.min) or (
+            self.max is not None and rv > self.max
+        ):
+            self.fail(
+                _("{value} is not in the range {range}.").format(
+                    value=_format_duration(rv), range=self._describe_range()
+                ),
+                param,
+                ctx,
+            )
+
+        return rv
+
+    def _describe_range(self) -> str:
+        """Describe the range for use in help text."""
+        if self.min is not None and self.max is not None:
+            return f"{_format_duration(self.min)}<=x<={_format_duration(self.max)}"
+
+        if self.max is not None:
+            return f"x<={_format_duration(self.max)}"
+
+        if self.min is not None:
+            return f"x>={_format_duration(self.min)}"
+
+        return ""
+
+    def __repr__(self) -> str:
+        range_str = self._describe_range()
+        return f"<Duration {range_str}>" if range_str else "Duration"
+
+
