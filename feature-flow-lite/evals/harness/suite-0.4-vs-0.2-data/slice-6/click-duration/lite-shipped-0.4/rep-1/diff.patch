+from datetime import timedelta
+
+import pytest
+
+import click
+from click.testing import CliRunner
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        ("90s", timedelta(seconds=90)),
+        ("5m", timedelta(minutes=5)),
+        ("1h30m", timedelta(hours=1, minutes=30)),
+        ("2d4h", timedelta(days=2, hours=4)),
+        ("1m500ms", timedelta(minutes=1, milliseconds=500)),
+        ("500ms", timedelta(milliseconds=500)),
+        ("0", timedelta(0)),
+        ("0s", timedelta(0)),
+        ("5", timedelta(seconds=5)),
+        (
+            "1d2h3m4s5ms",
+            timedelta(days=1, hours=2, minutes=3, seconds=4, milliseconds=5),
+        ),
+    ],
+)
+def test_convert(value, expect):
+    assert click.Duration().convert(value, None, None) == expect
+
+
+def test_convert_timedelta_passthrough():
+    value = timedelta(seconds=5)
+    assert click.Duration().convert(value, None, None) is value
+
+
+def test_name():
+    assert click.Duration.name == "duration"
+    assert click.types.Duration is click.Duration
+
+
+@pytest.mark.parametrize(
+    ("type", "value", "expect"),
+    [
+        (
+            click.Duration(timedelta(seconds=5), timedelta(minutes=30)),
+            "5s",
+            timedelta(seconds=5),
+        ),
+        (
+            click.Duration(timedelta(seconds=5), timedelta(minutes=30)),
+            "30m",
+            timedelta(minutes=30),
+        ),
+        (click.Duration(timedelta(seconds=5)), "5s", timedelta(seconds=5)),
+        (click.Duration(max=timedelta(minutes=30)), "30m", timedelta(minutes=30)),
+    ],
+)
+def test_range_accepts_bounds(type, value, expect):
+    assert type.convert(value, None, None) == expect
+
+
+@pytest.mark.parametrize(
+    ("type", "value", "expect"),
+    [
+        (
+            click.Duration(timedelta(seconds=5), timedelta(minutes=30)),
+            "4s",
+            "4s is not in the range 5s<=x<=30m.",
+        ),
+        (
+            click.Duration(timedelta(seconds=5), timedelta(minutes=30)),
+            "1h",
+            "1h is not in the range 5s<=x<=30m.",
+        ),
+        (
+            click.Duration(timedelta(seconds=5)),
+            "4s",
+            "4s is not in the range x>=5s.",
+        ),
+        (
+            click.Duration(max=timedelta(minutes=30)),
+            "1h",
+            "1h is not in the range x<=30m.",
+        ),
+        (
+            click.Duration(timedelta(milliseconds=500), timedelta(seconds=1)),
+            "1001ms",
+            "1s1ms is not in the range 500ms<=x<=1s.",
+        ),
+    ],
+)
+def test_range_fail(type, value, expect):
+    with pytest.raises(click.BadParameter) as exc_info:
+        type.convert(value, None, None)
+
+    assert exc_info.value.message == expect
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "",
+        "m",
+        "5x",
+        "1h1h",
+        "30m1h",
+        "1ms1s",
+        "1.5h",
+        "-5s",
+        "-5",
+        "+5s",
+        "1 h",
+        "1h 30m",
+        " 5s",
+        "5s ",
+        "5S",
+        "1H",
+        "1h30",
+        "٥s",
+        "1mss",
+        "1s1",
+        "999999999999d",
+        "9" * 5000,
+    ],
+)
+def test_convert_malformed(value):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert exc_info.value.message == f"{value!r} is not a valid duration."
+
+
+def test_negative_timedelta_fails():
+    value = timedelta(seconds=-5)
+
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert exc_info.value.message == f"{value!r} is not a valid duration."
+
+
+@pytest.mark.parametrize(
+    ("type", "expect"),
+    [
+        (click.Duration(), "Duration"),
+        (
+            click.Duration(timedelta(seconds=5), timedelta(minutes=30)),
+            "<Duration 5s<=x<=30m>",
+        ),
+        (click.Duration(max=timedelta(hours=1, minutes=30)), "<Duration x<=1h30m>"),
+        (click.Duration(min=timedelta(milliseconds=500)), "<Duration x>=500ms>"),
+    ],
+)
+def test_repr(type, expect):
+    assert repr(type) == expect
+
+
+@pytest.mark.parametrize(
+    ("type", "expect"),
+    [
+        (click.Duration(timedelta(0), timedelta(days=2)), "0s<=x<=2d"),
+        (click.Duration(timedelta(seconds=90)), "x>=1m30s"),
+        (click.Duration(max=timedelta(hours=1)), "x<=1h"),
+        (click.Duration(), ""),
+    ],
+)
+def test_describe_range(type, expect):
+    assert type._describe_range() == expect
+
+
+def test_help_shows_range():
+    @click.command()
+    @click.option(
+        "--time",
+        type=click.Duration(timedelta(seconds=5), timedelta(minutes=30)),
+        help="How long to wait.",
+    )
+    def cli(time):
+        click.echo(time)
+
+    result = CliRunner().invoke(cli, ["--help"])
+    assert result.exit_code == 0
+    assert "[5s<=x<=30m]" in result.output
+
+
+@pytest.mark.parametrize(
+    ("args", "message"),
+    [
+        (["--time", "5x"], "Invalid value for '--time': '5x' is not a valid duration."),
+        (
+            ["--time", "999999999999d"],
+            "Invalid value for '--time': '999999999999d' is not a valid duration.",
+        ),
+        (
+            ["--time", "-5s"],
+            "Invalid value for '--time': '-5s' is not a valid duration.",
+        ),
+        (
+            ["--time", "1s"],
+            "Invalid value for '--time': 1s is not in the range 5s<=x<=30m.",
+        ),
+        (
+            ["--time", "1h"],
+            "Invalid value for '--time': 1h is not in the range 5s<=x<=30m.",
+        ),
+    ],
+)
+def test_cli_usage_error(args, message):
+    @click.command()
+    @click.option(
+        "--time",
+        type=click.Duration(timedelta(seconds=5), timedelta(minutes=30)),
+    )
+    def cli(time):
+        click.echo(time)
+
+    result = CliRunner().invoke(cli, args)
+    assert result.exit_code == 2
+    assert "Traceback" not in result.output
+    assert message in result.output
+    assert "Usage:" in result.output
+
+
+def test_cli_valid_value():
+    @click.command()
+    @click.option("--time", type=click.Duration())
+    def cli(time):
+        click.echo(repr(time))
+
+    result = CliRunner().invoke(cli, ["--time", "1h30m"])
+    assert result.exit_code == 0
+    assert result.output == "datetime.timedelta(seconds=5400)\n"
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        (5, timedelta(seconds=5)),
+        (0, timedelta(0)),
+        (30, timedelta(seconds=30)),
+    ],
+)
+def test_convert_int_is_seconds(value, expect):
+    assert click.Duration().convert(value, None, None) == expect
+
+
+def test_convert_int_out_of_range_fails():
+    type = click.Duration(timedelta(seconds=5), timedelta(minutes=30))
+
+    with pytest.raises(click.BadParameter) as exc_info:
+        type.convert(1, None, None)
+
+    assert exc_info.value.message == "1s is not in the range 5s<=x<=30m."
+
+
+@pytest.mark.parametrize(
+    "value",
+    [-5, -1, True, 5.0, b"5s", ["5s"], None, 10**20],
+)
+def test_convert_non_string_malformed(value):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert exc_info.value.message == f"{value!r} is not a valid duration."
+
+
+@pytest.mark.parametrize(
+    ("default", "expect"),
+    [
+        (5, "datetime.timedelta(seconds=5)"),
+        (30, "datetime.timedelta(seconds=30)"),
+    ],
+)
+def test_cli_int_default(default, expect):
+    @click.command()
+    @click.option("--time", type=click.Duration(), default=default)
+    def cli(time):
+        click.echo(repr(time))
+
+    result = CliRunner().invoke(cli, [])
+    assert result.exit_code == 0
+    assert result.output == f"{expect}\n"
+
+
+def test_cli_default_map_int():
+    @click.command()
+    @click.option("--time", type=click.Duration())
+    def cli(time):
+        click.echo(repr(time))
+
+    result = CliRunner().invoke(cli, [], default_map={"time": 30})
+    assert result.exit_code == 0
+    assert result.output == "datetime.timedelta(seconds=30)\n"
+
+
+@pytest.mark.parametrize("default", [-5, 5.0, b"5s", ["5s"], True])
+def test_cli_invalid_non_string_default(default):
+    @click.command()
+    @click.option("--time", type=click.Duration(), default=default)
+    def cli(time):
+        click.echo(repr(time))
+
+    result = CliRunner().invoke(cli, [])
+    assert result.exit_code == 2
+    assert "Traceback" not in result.output
+    assert f"{default!r} is not a valid duration." in result.output
+    assert "Usage:" in result.output
