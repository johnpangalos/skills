+from datetime import timedelta
+
+import pytest
+
+import click
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        ("90s", timedelta(seconds=90)),
+        ("5m", timedelta(minutes=5)),
+        ("1h30m", timedelta(hours=1, minutes=30)),
+        ("2d4h", timedelta(days=2, hours=4)),
+        ("1m500ms", timedelta(minutes=1, milliseconds=500)),
+        ("500ms", timedelta(milliseconds=500)),
+        (
+            "1d2h3m4s5ms",
+            timedelta(days=1, hours=2, minutes=3, seconds=4, milliseconds=5),
+        ),
+        ("90", timedelta(seconds=90)),
+        ("0", timedelta(0)),
+        ("0s", timedelta(0)),
+        ("5ms", timedelta(milliseconds=5)),
+        ("1m5ms", timedelta(minutes=1, milliseconds=5)),
+        ("10m0s", timedelta(minutes=10)),
+    ],
+)
+def test_convert(value, expect):
+    assert click.Duration().convert(value, None, None) == expect
+
+
+def test_convert_timedelta_passes_through():
+    value = timedelta(minutes=5)
+    assert click.Duration().convert(value, None, None) is value
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        (90, timedelta(seconds=90)),
+        (0, timedelta(0)),
+    ],
+)
+def test_convert_int_is_seconds(value, expect):
+    assert click.Duration().convert(value, None, None) == expect
+
+
+@pytest.mark.parametrize(
+    ("value", "shown"),
+    [
+        (1.5, "1.5"),
+        (b"5s", "b'5s'"),
+        (True, "True"),
+        (None, "None"),
+        (object, "<class 'object'>"),
+    ],
+)
+def test_convert_unsupported_type(value, shown):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert exc_info.value.message == f"{shown} is not a valid duration."
