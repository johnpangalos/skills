+# A duration is a bare integer of seconds, or parts with units in the order
+# d, h, m, s, ms. The lookahead rejects the empty string.
+_DURATION_RE = re.compile(
+    r"[0-9]+|(?=[0-9])(?:[0-9]+d)?(?:[0-9]+h)?(?:[0-9]+m)?(?:[0-9]+s)?(?:[0-9]+ms)?"
+)
+_DURATION_PART_RE = re.compile(r"([0-9]+)(ms|[dhms])?")
+_DURATION_UNITS = {
+    "": timedelta(seconds=1),
+    "d": timedelta(days=1),
+    "h": timedelta(hours=1),
+    "m": timedelta(minutes=1),
+    "s": timedelta(seconds=1),
+    "ms": timedelta(milliseconds=1),
+}
+
+
+class DurationInfoDict(ParamTypeInfoDict):
+    min: timedelta | None
+    max: timedelta | None
+
+
+def _format_duration(value: timedelta) -> str:
+    """Write a duration in the syntax :class:`Duration` accepts, largest unit
+    first and omitting zero units. A value with a part below a millisecond
+    cannot be written that way, so it is written as ``str(value)``.
+    """
+    if value < timedelta(0):
+        return f"-{_format_duration(-value)}"
+
+    if value % timedelta(milliseconds=1) != timedelta(0):
+        return str(value)
+
+    millis = value // timedelta(milliseconds=1)
+    parts = []
+
+    for unit, size in (
+        ("d", 86_400_000),
+        ("h", 3_600_000),
+        ("m", 60_000),
+        ("s", 1000),
+        ("ms", 1),
+    ):
+        count, millis = divmod(millis, size)
+
+        if count:
+            parts.append(f"{count}{unit}")
+
+    return "".join(parts) or "0s"
+
+
+class Duration(ParamType[timedelta]):
+    """Convert a duration string such as ``90s``, ``5m``, ``1h30m`` or ``2d4h``
+    to a :class:`datetime.timedelta`. A bare integer is a number of seconds.
+
+    The units are ``d``, ``h``, ``m``, ``s`` and ``ms``. Each unit may appear
+    at most once, largest first, with at least one digit before it. Negative
+    durations are rejected.
+
+    ``min`` and ``max`` are inclusive bounds given as :class:`datetime.timedelta`
+    values. Either may be omitted.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "duration"
+
+    min: timedelta | None
+    max: timedelta | None
+
+    def __init__(
+        self, min: timedelta | None = None, max: timedelta | None = None
+    ) -> None:
+        self.min = min
+        self.max = max
+
+    def to_info_dict(self) -> DurationInfoDict:
+        return {"min": self.min, "max": self.max, **super().to_info_dict()}
+
+    def _describe_range(self) -> str:
+        """Describe the range in duration syntax for use in help text and
+        errors. Returns an empty string when neither bound is set.
+        """
+        low = None if self.min is None else _format_duration(self.min)
+        high = None if self.max is None else _format_duration(self.max)
+
+        if low is None and high is None:
+            return ""
+
+        if low is None:
+            return f"x<={high}"
+
+        if high is None:
+            return f"x>={low}"
+
+        return f"{low}<=x<={high}"
+
+    def _parse(
+        self, value: str, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        negative = value.startswith("-")
+        body = value[1:] if negative else value
+
+        if _DURATION_RE.fullmatch(body) is None:
+            self.fail(
+                _("{value!r} is not a valid duration.").format(value=value),
+                param,
+                ctx,
+            )
+
+        if negative:
+            self.fail(
+                _(
+                    "{value!r} is not a valid duration. "
+                    "Negative durations are not allowed."
+                ).format(value=value),
+                param,
+                ctx,
+            )
+
+        try:
+            return sum(
+                (
+                    _DURATION_UNITS[unit] * int(number)
+                    for number, unit in _DURATION_PART_RE.findall(value)
+                ),
+                timedelta(),
+            )
+        except (OverflowError, ValueError):
+            self.fail(
+                _("{value!r} is too large for a duration.").format(value=value),
+                param,
+                ctx,
+            )
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, str):
+            rv = self._parse(value, param, ctx)
+        elif isinstance(value, int) and not isinstance(value, bool):
+            if value < 0:
+                self.fail(
+                    _(
+                        "{value!r} is not a valid duration. "
+                        "Negative durations are not allowed."
+                    ).format(value=f"-{-value}s"),
+                    param,
+                    ctx,
+                )
+
+            try:
+                rv = timedelta(seconds=value)
+            except OverflowError:
+                self.fail(
+                    _("{value!r} is too large for a duration.").format(value=value),
+                    param,
+                    ctx,
+                )
+        elif isinstance(value, timedelta):
+            rv = value
+        else:
+            self.fail(
+                _("{value!r} is not a valid duration.").format(value=value),
+                param,
+                ctx,
+            )
+
+        if rv < timedelta(0):
+            self.fail(
+                _(
+                    "{value!r} is not a valid duration. "
+                    "Negative durations are not allowed."
+                ).format(value=_format_duration(rv)),
+                param,
+                ctx,
+            )
+
+        if (self.min is not None and rv < self.min) or (
+            self.max is not None and rv > self.max
+        ):
+            self.fail(
+                _("{value} is not in the range {range}.").format(
+                    value=_format_duration(rv), range=self._describe_range()
+                ),
+                param,
+                ctx,
+            )
+
+        return rv
+
+    def __repr__(self) -> str:
+        range_str = self._describe_range()
+        return f"<Duration {range_str}>" if range_str else "Duration"
+
+
