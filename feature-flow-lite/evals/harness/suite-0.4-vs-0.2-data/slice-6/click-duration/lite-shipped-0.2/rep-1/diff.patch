+import datetime
+
+import pytest
+
+import click
+
+HOSTILE_VALUES = [
+    "",
+    "  ",
+    "1h1h",
+    "30m1h",
+    "500ms1s",
+    "1.5h",
+    "5 s",
+    " 5s",
+    "5s\n",
+    "1H",
+    "5x",
+    "ms",
+    "h",
+    "1h5",
+    "1_000s",
+    "١٢s",
+    "+5s",
+    "5sms",
+    "-5s",
+    "-1",
+    "1h-5m",
+    "999999999999d",
+    "99999999999999999999",
+    "9999999999999999999999999ms",
+    "9" * 5000,
+]
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        ("90s", datetime.timedelta(seconds=90)),
+        ("5m", datetime.timedelta(minutes=5)),
+        ("1h30m", datetime.timedelta(hours=1, minutes=30)),
+        ("2d4h", datetime.timedelta(days=2, hours=4)),
+        ("1m500ms", datetime.timedelta(minutes=1, milliseconds=500)),
+        ("500ms", datetime.timedelta(milliseconds=500)),
+        (
+            "1d2h3m4s5ms",
+            datetime.timedelta(days=1, hours=2, minutes=3, seconds=4, milliseconds=5),
+        ),
+        ("90", datetime.timedelta(seconds=90)),
+        ("0", datetime.timedelta(0)),
+        ("0s", datetime.timedelta(0)),
+        (90, datetime.timedelta(seconds=90)),
+        (datetime.timedelta(minutes=2), datetime.timedelta(minutes=2)),
+    ],
+)
+def test_convert(value, expect):
+    assert click.Duration().convert(value, None, None) == expect
+
+
+@pytest.mark.parametrize("value", HOSTILE_VALUES)
+def test_convert_fail(value):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert exc_info.value.message == f"{value!r} is not a valid duration."
+
+
+@pytest.mark.parametrize(
+    "value",
+    [True, False, None, 1.5, -1, 10**30],
+)
+def test_convert_fail_non_string(value):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert exc_info.value.message == f"{value!r} is not a valid duration."
+
+
+def test_convert_fail_negative_timedelta():
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(datetime.timedelta(seconds=-90), None, None)
+
+    assert exc_info.value.message == "'-1m30s' is not a valid duration."
+
+
+@pytest.mark.parametrize(
+    ("type", "value", "expect"),
+    [
+        (
+            click.Duration(datetime.timedelta(seconds=1), datetime.timedelta(hours=1)),
+            "1s",
+            datetime.timedelta(seconds=1),
+        ),
+        (
+            click.Duration(datetime.timedelta(seconds=1), datetime.timedelta(hours=1)),
+            "1h",
+            datetime.timedelta(hours=1),
+        ),
+        (
+            click.Duration(datetime.timedelta(seconds=1), datetime.timedelta(hours=1)),
+            datetime.timedelta(minutes=5),
+            datetime.timedelta(minutes=5),
+        ),
+        (
+            click.Duration(
+                datetime.timedelta(seconds=1), datetime.timedelta(seconds=1)
+            ),
+            "1s",
+            datetime.timedelta(seconds=1),
+        ),
+        (
+            click.Duration(min=datetime.timedelta(seconds=1)),
+            "1d",
+            datetime.timedelta(days=1),
+        ),
+        (
+            click.Duration(max=datetime.timedelta(hours=1)),
+            "0",
+            datetime.timedelta(0),
+        ),
+        (
+            click.Duration(max=datetime.timedelta(0)),
+            "0",
+            datetime.timedelta(0),
+        ),
+    ],
+)
+def test_range(type, value, expect):
+    assert type.convert(value, None, None) == expect
+
+
+@pytest.mark.parametrize(
+    ("type", "value", "expect"),
+    [
+        (
+            click.Duration(datetime.timedelta(seconds=1), datetime.timedelta(hours=1)),
+            "2h",
+            "2h is not in the range 1s<=x<=1h.",
+        ),
+        (
+            click.Duration(datetime.timedelta(seconds=1), datetime.timedelta(hours=1)),
+            "0",
+            "0s is not in the range 1s<=x<=1h.",
+        ),
+        (
+            click.Duration(datetime.timedelta(seconds=1), datetime.timedelta(hours=1)),
+            datetime.timedelta(hours=2),
+            "2h is not in the range 1s<=x<=1h.",
+        ),
+        (
+            click.Duration(min=datetime.timedelta(seconds=1)),
+            "1ms",
+            "1ms is not in the range x>=1s.",
+        ),
+        (
+            click.Duration(max=datetime.timedelta(hours=1)),
+            "90m",
+            "1h30m is not in the range x<=1h.",
+        ),
+        (
+            click.Duration(max=datetime.timedelta(0)),
+            "1s",
+            "1s is not in the range x<=0s.",
+        ),
+        (
+            click.Duration(
+                min=datetime.timedelta(seconds=10), max=datetime.timedelta(seconds=1)
+            ),
+            "5s",
+            "5s is not in the range 10s<=x<=1s.",
+        ),
+        (
+            click.Duration(min=datetime.timedelta(microseconds=1)),
+            "0",
+            "0s is not in the range x>=0s.",
+        ),
+    ],
+)
+def test_range_fail(type, value, expect):
+    with pytest.raises(click.BadParameter) as exc_info:
+        type.convert(value, None, None)
+
+    assert exc_info.value.message == expect
+
+
+def test_info_dict_range_is_timedelta():
+    type = click.Duration(min=datetime.timedelta(seconds=1))
+    assert type.to_info_dict()["min"] == datetime.timedelta(seconds=1)
+    assert type.to_info_dict()["max"] is None
+
+
+@pytest.mark.parametrize(
+    ("type", "expect"),
+    [
+        (click.Duration(), "DURATION"),
+        (
+            click.Duration(datetime.timedelta(seconds=1), datetime.timedelta(hours=1)),
+            "<Duration 1s<=x<=1h>",
+        ),
+        (click.Duration(min=datetime.timedelta(minutes=1)), "<Duration x>=1m>"),
+        (click.Duration(max=datetime.timedelta(hours=1)), "<Duration x<=1h>"),
+    ],
+)
+def test_repr(type, expect):
+    assert repr(type) == expect
+
+
+def test_cli_default_int(runner):
+    @click.command()
+    @click.option("--timeout", type=click.Duration(), default=90, show_default=True)
+    def cli(timeout):
+        click.echo(timeout.total_seconds())
+
+    result = runner.invoke(cli, [])
+    assert result.exit_code == 0
+    assert result.output == "90.0\n"
+
+
+@pytest.mark.parametrize("value", HOSTILE_VALUES)
+def test_cli_invalid_value(runner, value):
+    @click.command()
+    @click.option("--timeout", type=click.Duration(max=datetime.timedelta(hours=1)))
+    def cli(timeout):
+        pass
+
+    result = runner.invoke(cli, [f"--timeout={value}"])
+    assert result.exit_code == 2
+    assert "Usage:" in result.output
+    assert "Error: Invalid value for '--timeout'" in result.output
+    assert f"{value!r} is not a valid duration." in result.output
+
+
+def test_cli_out_of_range(runner):
+    @click.command()
+    @click.option("--timeout", type=click.Duration(max=datetime.timedelta(hours=1)))
+    def cli(timeout):
+        pass
+
+    result = runner.invoke(cli, ["--timeout=2h"])
+    assert result.exit_code == 2
+    assert "Error: Invalid value for '--timeout': 2h is not in the range x<=1h." in (
+        result.output
+    )
+
+
+def test_help_shows_bounded_range(runner):
+    @click.command()
+    @click.option(
+        "--timeout",
+        type=click.Duration(datetime.timedelta(seconds=1), datetime.timedelta(hours=1)),
+    )
+    def cli(timeout):
+        pass
+
+    result = runner.invoke(cli, ["--help"])
+    assert "[1s<=x<=1h]" in result.output
+
+
+def test_help_omits_unbounded_range(runner):
+    @click.command()
+    @click.option("--timeout", type=click.Duration())
+    def cli(timeout):
+        pass
+
+    result = runner.invoke(cli, ["--help"])
+    assert "x>=" not in result.output
+    assert "x<=" not in result.output
