+class DurationInfoDict(ParamTypeInfoDict):
+    min: timedelta | None
+    max: timedelta | None
+
+
+# A unit may appear at most once, largest first. ``m`` must not be followed by
+# ``s``, so that ``1ms`` is read as milliseconds and not as minutes.
+_DURATION_PATTERN = re.compile(
+    r"(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m(?!s))?(?:([0-9]+)s)?(?:([0-9]+)ms)?"
+)
+_DURATION_UNITS = (
+    ("d", 86_400_000),
+    ("h", 3_600_000),
+    ("m", 60_000),
+    ("s", 1_000),
+    ("ms", 1),
+)
+
+
+def _format_duration(value: timedelta) -> str:
+    """Render a timedelta in the syntax accepted by :class:`Duration`, such as
+    ``1h30m``. Microseconds below one millisecond are dropped, because the
+    syntax has no finer unit, so ``timedelta(microseconds=1)`` renders as ``0s``.
+    """
+    if value < timedelta(0):
+        return f"-{_format_duration(-value)}"
+
+    remaining = value // timedelta(milliseconds=1)
+    parts: list[str] = []
+
+    for suffix, size in _DURATION_UNITS:
+        count, remaining = divmod(remaining, size)
+
+        if count:
+            parts.append(f"{count}{suffix}")
+
+    return "".join(parts) or "0s"
+
+
+class Duration(ParamType[timedelta]):
+    """Convert a duration string into a :class:`datetime.timedelta`.
+
+    A duration is one or more parts, each an integer followed by a unit. The
+    units are ``d``, ``h``, ``m``, ``s``, and ``ms``. Each unit may appear at
+    most once, largest first, with no separators, so ``90s``, ``5m``, ``1h30m``,
+    ``2d4h``, and ``1m500ms`` are valid. A bare integer such as ``90`` is a
+    number of seconds. Only ASCII digits are accepted.
+
+    A ``timedelta`` or an ``int`` (as seconds) is also accepted, so a default
+    can be given either way. Negative durations are rejected.
+
+    The bounds are inclusive. If ``min`` is greater than ``max``, no value is
+    accepted.
+
+    :param min: The smallest accepted duration.
+    :param max: The largest accepted duration.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "duration"
+
+    min: timedelta | None
+    max: timedelta | None
+
+    def __init__(
+        self, min: timedelta | None = None, max: timedelta | None = None
+    ) -> None:
+        self.min = min
+        self.max = max
+
+    def to_info_dict(self) -> DurationInfoDict:
+        return {"min": self.min, "max": self.max, **super().to_info_dict()}
+
+    def _parse(self, value: t.Any) -> timedelta | None:
+        """Parse a string, or an int as seconds, into a timedelta. Return
+        ``None`` if the value is not a duration or is too large to represent.
+        """
+        if isinstance(value, bool) or not isinstance(value, (str, int)):
+            return None
+
+        text = str(value)
+
+        try:
+            if re.fullmatch(r"[0-9]+", text):
+                return timedelta(seconds=int(text))
+
+            match = _DURATION_PATTERN.fullmatch(text)
+
+            if match is None or not any(match.groups()):
+                return None
+
+            days, hours, minutes, seconds, milliseconds = (
+                int(g or 0) for g in match.groups()
+            )
+            return timedelta(
+                days=days,
+                hours=hours,
+                minutes=minutes,
+                seconds=seconds,
+                milliseconds=milliseconds,
+            )
+        except (OverflowError, ValueError):
+            # ValueError is raised by int() for a very long run of digits.
+            return None
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        rv = value if isinstance(value, timedelta) else self._parse(value)
+
+        if rv is None or rv < timedelta(0):
+            if isinstance(value, timedelta):
+                value = _format_duration(value)
+
+            self.fail(
+                _("{value!r} is not a valid duration.").format(value=value),
+                param,
+                ctx,
+            )
+
+        if (self.min is not None and rv < self.min) or (
+            self.max is not None and rv > self.max
+        ):
+            self.fail(
+                _("{value} is not in the range {range}.").format(
+                    value=_format_duration(rv), range=self._describe_range()
+                ),
+                param,
+                ctx,
+            )
+
+        return rv
+
+    def _describe_range(self) -> str:
+        """Describe the range for use in help text. Empty if unbounded."""
+        if self.min is None:
+            return "" if self.max is None else f"x<={_format_duration(self.max)}"
+
+        if self.max is None:
+            return f"x>={_format_duration(self.min)}"
+
+        return f"{_format_duration(self.min)}<=x<={_format_duration(self.max)}"
+
+    def __repr__(self) -> str:
+        if self.min is None and self.max is None:
+            return "DURATION"
+
+        return f"<Duration {self._describe_range()}>"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
