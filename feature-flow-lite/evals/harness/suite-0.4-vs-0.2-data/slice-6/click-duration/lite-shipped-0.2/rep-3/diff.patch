         return "DateTime"
 
 
+_SECONDS_ONLY_RE = re.compile(r"[0-9]+")
+_DURATION_RE = re.compile(
+    r"(?:(?P<days>[0-9]+)d)?"
+    r"(?:(?P<hours>[0-9]+)h)?"
+    r"(?:(?P<minutes>[0-9]+)m)?"
+    r"(?:(?P<seconds>[0-9]+)s)?"
+    r"(?:(?P<milliseconds>[0-9]+)ms)?"
+)
+
+
+def _format_duration(value: timedelta) -> str:
+    """Render a non-negative timedelta in the syntax accepted by
+    :class:`Duration`. Sub-millisecond precision is dropped.
+    """
+    total_ms = value // timedelta(milliseconds=1)
+    days, rest = divmod(total_ms, 86_400_000)
+    hours, rest = divmod(rest, 3_600_000)
+    minutes, rest = divmod(rest, 60_000)
+    seconds, milliseconds = divmod(rest, 1000)
+    parts = [
+        f"{amount}{unit}"
+        for amount, unit in (
+            (days, "d"),
+            (hours, "h"),
+            (minutes, "m"),
+            (seconds, "s"),
+            (milliseconds, "ms"),
+        )
+        if amount
+    ]
+    return "".join(parts) or "0s"
+
+
+class DurationInfoDict(ParamTypeInfoDict):
+    min: timedelta | None
+    max: timedelta | None
+
+
+class Duration(ParamType[timedelta]):
+    """Convert a duration string such as ``1h30m`` to a
+    :class:`datetime.timedelta`.
+
+    The string is one or more ``<digits><unit>`` parts, with units ``d``,
+    ``h``, ``m``, ``s``, and ``ms`` in that order, each used at most once, for
+    example ``90s``, ``5m``, ``1h30m``, or ``1m500ms``. A bare integer is a
+    number of seconds, so ``90`` is the same as ``90s``. Negative durations are
+    rejected.
+
+    :param min: The smallest accepted duration, inclusive. If ``None``, there
+                is no lower bound.
+    :param max: The largest accepted duration, inclusive. If ``None``, there
+                is no upper bound.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "duration"
+
+    min: timedelta | None
+    max: timedelta | None
+
+    def __init__(
+        self, min: timedelta | None = None, max: timedelta | None = None
+    ) -> None:
+        self.min = min
+        self.max = max
+
+    def to_info_dict(self) -> DurationInfoDict:
+        return {"min": self.min, "max": self.max, **super().to_info_dict()}
+
+    def _parse(self, value: str) -> timedelta | None:
+        """Parse a duration string. Return ``None`` if it is malformed or too
+        large to represent.
+        """
+        if _SECONDS_ONLY_RE.fullmatch(value):
+            parts: dict[str, t.Any] = {"seconds": value}
+        else:
+            match = _DURATION_RE.fullmatch(value)
+
+            if match is None or not match.group(0):
+                return None
+
+            parts = match.groupdict(default="0")
+
+        try:
+            return timedelta(**{key: int(amount) for key, amount in parts.items()})
+        except (OverflowError, ValueError):
+            return None
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        if isinstance(value, timedelta):
+            rv = value
+        else:
+            parsed = self._parse(str(value))
+
+            if parsed is None:
+                self.fail(
+                    _("{value!r} is not a valid duration.").format(value=value),
+                    param,
+                    ctx,
+                )
+
+            rv = parsed
+
+        if rv < timedelta(0):
+            self.fail(
+                _("{value} must not be negative.").format(
+                    value=f"-{_format_duration(-rv)}"
+                ),
+                param,
+                ctx,
+            )
+
+        if (self.min is not None and rv < self.min) or (
+            self.max is not None and rv > self.max
+        ):
+            self.fail(
+                _("{value} is not in the range {range}.").format(
+                    value=_format_duration(rv), range=self._describe_range()
+                ),
+                param,
+                ctx,
+            )
+
+        return rv
+
+    def _describe_range(self) -> str:
+        """Describe the range for use in help text. Empty if unbounded."""
+        if self.min is not None and self.max is not None:
+            return f"{_format_duration(self.min)}<=x<={_format_duration(self.max)}"
+
+        if self.min is not None:
+            return f"x>={_format_duration(self.min)}"
+
+        if self.max is not None:
+            return f"x<={_format_duration(self.max)}"
+
+        return ""
+
+    def __repr__(self) -> str:
+        description = self._describe_range()
+        return f"<Duration {description}>" if description else "Duration"
+
+
 class _NumberParamTypeBase(
     ParamType[_ValueT_co], t.Generic[_ValueT_contra, _ValueT_co]
 ):
