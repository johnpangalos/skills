diff --git a/tests/test_types/test_Duration.py b/tests/test_types/test_Duration.py
new file mode 100644
index 0000000..2f90784
--- /dev/null
+++ b/tests/test_types/test_Duration.py
@@ -0,0 +1,178 @@
+from datetime import timedelta
+
+import pytest
+
+import click
+from click.testing import CliRunner
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        ("90s", timedelta(seconds=90)),
+        ("5m", timedelta(minutes=5)),
+        ("1h30m", timedelta(hours=1, minutes=30)),
+        ("2d4h", timedelta(days=2, hours=4)),
+        ("1m500ms", timedelta(seconds=60.5)),
+        ("5ms", timedelta(milliseconds=5)),
+        ("90", timedelta(seconds=90)),
+        ("0", timedelta(0)),
+        ("0s", timedelta(0)),
+        (
+            "1d2h3m4s5ms",
+            timedelta(days=1, hours=2, minutes=3, seconds=4, milliseconds=5),
+        ),
+    ],
+)
+def test_duration_convert(value, expect):
+    assert click.Duration().convert(value, None, None) == expect
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "",
+        "s",
+        "5x",
+        "1h1h",
+        "30m1h",
+        "1ms5s",
+        "1.5h",
+        "1h 30m",
+        " 5s",
+        "5s\n",
+        "5S",
+        "5H",
+        "٥s",
+        "+5s",
+        "5sms",
+        "-5s",
+        "-90",
+        # Too large for timedelta.
+        "999999999999d",
+        "99999999999999999999",
+        "10000000000000000000000000ms",
+    ],
+)
+def test_duration_rejects_invalid(value):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert exc_info.value.message == f"{value!r} is not a valid duration."
+
+
+def test_duration_rejects_negative_timedelta():
+    value = timedelta(seconds=-5)
+
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration().convert(value, None, None)
+
+    assert exc_info.value.message == "-5s must not be negative."
+
+
+def test_duration_passes_timedelta_through():
+    value = timedelta(minutes=5)
+    assert click.Duration().convert(value, None, None) is value
+
+
+@pytest.mark.parametrize(
+    ("kwargs", "value"),
+    [
+        ({"min": timedelta(seconds=1), "max": timedelta(hours=1)}, "1s"),
+        ({"min": timedelta(seconds=1), "max": timedelta(hours=1)}, "1h"),
+        ({"min": timedelta(minutes=1)}, "1m"),
+        ({"max": timedelta(minutes=1)}, "60s"),
+        ({"min": timedelta(minutes=1), "max": timedelta(minutes=1)}, "60s"),
+        ({"min": timedelta(minutes=1, milliseconds=500)}, "1m500ms"),
+        ({"max": timedelta(0)}, "0"),
+        ({"max": timedelta(0)}, timedelta(0)),
+    ],
+)
+def test_duration_bounds_accept(kwargs, value):
+    click.Duration(**kwargs).convert(value, None, None)
+
+
+@pytest.mark.parametrize(
+    ("kwargs", "value", "message"),
+    [
+        (
+            {"min": timedelta(seconds=1), "max": timedelta(hours=1)},
+            "2h",
+            "2h is not in the range 1s<=x<=1h.",
+        ),
+        (
+            {"min": timedelta(seconds=1), "max": timedelta(hours=1)},
+            "500ms",
+            "500ms is not in the range 1s<=x<=1h.",
+        ),
+        (
+            {"min": timedelta(seconds=1), "max": timedelta(hours=1)},
+            "0",
+            "0s is not in the range 1s<=x<=1h.",
+        ),
+        ({"min": timedelta(minutes=1)}, "59s", "59s is not in the range x>=1m."),
+        ({"max": timedelta(hours=1)}, "2h", "2h is not in the range x<=1h."),
+        (
+            {"min": timedelta(minutes=1), "max": timedelta(minutes=1)},
+            "61s",
+            "1m1s is not in the range 1m<=x<=1m.",
+        ),
+        (
+            {"min": timedelta(minutes=1, milliseconds=500)},
+            "1m",
+            "1m is not in the range x>=1m500ms.",
+        ),
+    ],
+)
+def test_duration_bounds_reject(kwargs, value, message):
+    with pytest.raises(click.BadParameter) as exc_info:
+        click.Duration(**kwargs).convert(value, None, None)
+
+    assert exc_info.value.message == message
+
+
+@pytest.mark.parametrize(
+    ("kwargs", "expect"),
+    [
+        ({}, "Duration"),
+        (
+            {"min": timedelta(seconds=1), "max": timedelta(hours=1)},
+            "<Duration 1s<=x<=1h>",
+        ),
+        ({"min": timedelta(seconds=1)}, "<Duration x>=1s>"),
+        ({"max": timedelta(hours=1)}, "<Duration x<=1h>"),
+        ({"max": timedelta(0)}, "<Duration x<=0s>"),
+    ],
+)
+def test_duration_repr(kwargs, expect):
+    assert repr(click.Duration(**kwargs)) == expect
+
+
+def test_duration_is_exported():
+    assert click.Duration is click.types.Duration
+    assert click.Duration.name == "duration"
+
+
+@pytest.mark.parametrize("args", [["--wait=-5s"], ["--wait=-90"], ["--wait=1h1h"]])
+def test_duration_usage_error(args):
+    @click.command()
+    @click.option("--wait", type=click.Duration())
+    def cli(wait):
+        click.echo(wait)
+
+    result = CliRunner().invoke(cli, args)
+    assert result.exit_code == 2
+    assert isinstance(result.exception, SystemExit)
+    assert "is not a valid duration" in result.stderr
+
+
+def test_duration_negative_default_usage_error():
+    @click.command()
+    @click.option("--wait", type=click.Duration(), default=timedelta(seconds=-5))
+    def cli(wait):
+        click.echo(wait)
+
+    result = CliRunner().invoke(cli, [])
+    assert result.exit_code == 2
+    assert isinstance(result.exception, SystemExit)
+    assert "must not be negative" in result.stderr
