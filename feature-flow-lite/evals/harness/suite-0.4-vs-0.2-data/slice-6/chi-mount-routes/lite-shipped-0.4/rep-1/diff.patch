+func TestWalkRouteOnMountPattern(t *testing.T) {
+	handler := func(w http.ResponseWriter, r *http.Request) {}
+
+	r := NewRouter()
+	r.Route("/foo", func(r Router) {
+		r.Route("/bar", func(r Router) {
+			r.Get("/{id}", handler)
+		})
+		r.Get("/bar", handler)
+		r.Route("/baz", func(r Router) {
+			r.Get("/{id}", handler)
+		})
+	})
+
+	var got []string
+	err := Walk(r, func(method string, route string, handler http.Handler, middlewares ...func(http.Handler) http.Handler) error {
+		got = append(got, method+" "+route)
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	sort.Strings(got)
+
+	want := []string{"GET /foo/bar", "GET /foo/bar/{id}", "GET /foo/baz/{id}"}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %v, want %v", got, want)
+	}
+}
