+func TestWalkRouteOnMountPattern(t *testing.T) {
+	handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {})
+
+	r := NewRouter()
+	r.Route("/foo", func(r Router) {
+		r.Route("/bar", func(r Router) {
+			r.Get("/{id}", handler)
+		})
+		r.Get("/bar", handler)
+		r.Post("/bar/", handler)
+	})
+	r.Mount("/baz", NewRouter())
+
+	var got []string
+	if err := Walk(r, func(method string, route string, handler http.Handler, middlewares ...func(http.Handler) http.Handler) error {
+		got = append(got, method+" "+route)
+		return nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+	slices.Sort(got)
+
+	want := []string{"GET /foo/bar", "GET /foo/bar/{id}", "POST /foo/bar/"}
+	if !slices.Equal(got, want) {
+		t.Errorf("walk routes = %v, want %v", got, want)
+	}
+}
