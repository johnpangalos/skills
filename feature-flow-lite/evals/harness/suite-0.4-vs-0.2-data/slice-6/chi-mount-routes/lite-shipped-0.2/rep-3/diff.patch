+func TestRoutesStubCollisionHandlers(t *testing.T) {
+	handler := func(w http.ResponseWriter, r *http.Request) {}
+
+	r := NewMux()
+	r.Route("/foo", func(r Router) {
+		r.Route("/bar", func(r Router) {
+			r.Get("/{id}", handler)
+		})
+		r.Get("/bar", handler)
+	})
+
+	var subroutes Routes
+	for _, rt := range r.Routes() {
+		if rt.Pattern == "/foo/*" {
+			subroutes = rt.SubRoutes
+		}
+	}
+	if subroutes == nil {
+		t.Fatal("expected subroutes for /foo/*")
+	}
+
+	var found bool
+	for _, rt := range subroutes.Routes() {
+		if rt.Pattern != "/bar" {
+			continue
+		}
+		found = true
+		if rt.SubRoutes != nil || len(rt.Handlers) != 1 || rt.Handlers["GET"] == nil {
+			t.Fatalf("expected only a GET handler on /bar with no subroutes, got %d handlers, subroutes nil: %v", len(rt.Handlers), rt.SubRoutes == nil)
+		}
+	}
+	if !found {
+		t.Fatal("expected a Route with Pattern /bar")
+	}
+}
