+func TestWalkRouteStubCollision(t *testing.T) {
+	mw := func(next http.Handler) http.Handler { return next }
+	handler := func(w http.ResponseWriter, r *http.Request) {}
+	plain := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {})
+
+	// Handle and Mount report every registered method, which RegisterMethod can extend
+	var everyMethod, everyMethodMount []string
+	for m := range methodMap {
+		everyMethod = append(everyMethod, m+" /foo/bar 0")
+		everyMethodMount = append(everyMethodMount, m+" /foo/bar/* 0")
+	}
+
+	tests := []struct {
+		name     string
+		setup    func() Router
+		expected []string // "METHOD route middlewareCount"
+	}{
+		{
+			name: "Route then Get on the same pattern",
+			setup: func() Router {
+				r := NewMux()
+				r.Route("/foo", func(r Router) {
+					r.Route("/bar", func(r Router) {
+						r.Get("/{id}", handler)
+					})
+					r.Get("/bar", handler)
+				})
+				return r
+			},
+			expected: []string{"GET /foo/bar 0", "GET /foo/bar/{id} 0"},
+		},
+		{
+			name: "Get then Route on the same pattern keeps the mount's GET overwritten",
+			setup: func() Router {
+				r := NewMux()
+				r.Route("/foo", func(r Router) {
+					r.Get("/bar", handler)
+					r.Route("/bar", func(r Router) {
+						r.Get("/{id}", handler)
+					})
+				})
+				return r
+			},
+			expected: []string{"GET /foo/bar/{id} 0"},
+		},
+		{
+			name: "Get on trailing-slash stub",
+			setup: func() Router {
+				r := NewMux()
+				r.Route("/foo", func(r Router) {
+					r.Route("/bar", func(r Router) {
+						r.Get("/{id}", handler)
+					})
+					r.Get("/bar/", handler)
+				})
+				return r
+			},
+			expected: []string{"GET /foo/bar/ 0", "GET /foo/bar/{id} 0"},
+		},
+		{
+			name: "Post and Get on the same stub",
+			setup: func() Router {
+				r := NewMux()
+				r.Route("/foo", func(r Router) {
+					r.Route("/bar", func(r Router) {
+						r.Get("/{id}", handler)
+					})
+					r.Post("/bar", handler)
+					r.Get("/bar", handler)
+				})
+				return r
+			},
+			expected: []string{"GET /foo/bar 0", "GET /foo/bar/{id} 0", "POST /foo/bar 0"},
+		},
+		{
+			name: "Handle on the same stub reports every method",
+			setup: func() Router {
+				r := NewMux()
+				r.Route("/foo", func(r Router) {
+					r.Route("/bar", func(r Router) {
+						r.Get("/{id}", handler)
+					})
+					r.Handle("/bar", plain)
+				})
+				return r
+			},
+			expected: slices.Concat(everyMethod, []string{"GET /foo/bar/{id} 0"}),
+		},
+		{
+			name: "Plain Mount then Get on the same pattern",
+			setup: func() Router {
+				r := NewMux()
+				r.Route("/foo", func(r Router) {
+					r.Mount("/bar", plain)
+					r.Get("/bar", handler)
+				})
+				return r
+			},
+			expected: slices.Concat(everyMethodMount, []string{"GET /foo/bar 0"}),
+		},
+		{
+			name: "With middleware on the collided Get",
+			setup: func() Router {
+				r := NewMux()
+				r.Route("/foo", func(r Router) {
+					r.Route("/bar", func(r Router) {
+						r.Get("/{id}", handler)
+					})
+					r.With(mw).Get("/bar", handler)
+				})
+				return r
+			},
+			expected: []string{"GET /foo/bar 1", "GET /foo/bar/{id} 0"},
+		},
+		{
+			name: "Use on the subrouter with a collided Get",
+			setup: func() Router {
+				r := NewMux()
+				r.Route("/foo", func(r Router) {
+					r.Use(mw)
+					r.Route("/bar", func(r Router) {
+						r.Get("/{id}", handler)
+					})
+					r.Get("/bar", handler)
+				})
+				return r
+			},
+			expected: []string{"GET /foo/bar 1", "GET /foo/bar/{id} 1"},
+		},
+		{
+			name: "Param pattern Route then Get",
+			setup: func() Router {
+				r := NewMux()
+				r.Route("/{id}", func(r Router) {
+					r.Get("/x", handler)
+				})
+				r.Get("/{id}", handler)
+				return r
+			},
+			expected: []string{"GET /{id} 0", "GET /{id}/x 0"},
+		},
+		{
+			name: "Route on root with Get on root",
+			setup: func() Router {
+				r := NewMux()
+				r.Route("/", func(r Router) {
+					r.Get("/x", handler)
+				})
+				r.Get("/", handler)
+				return r
+			},
+			expected: []string{"GET / 0", "GET /x 0"},
+		},
+		{
+			name: "Route on root with Get inside only",
+			setup: func() Router {
+				r := NewMux()
+				r.Route("/", func(r Router) {
+					r.Get("/", handler)
+				})
+				return r
+			},
+			expected: []string{"GET / 0"},
+		},
+		{
+			name: "Mount on a trailing-slash pattern skips bare stubs",
+			setup: func() Router {
+				r := NewMux()
+				sub := NewRouter()
+				sub.Get("/x", handler)
+				r.Mount("/bar/", sub)
+				return r
+			},
+			expected: []string{"GET /bar/x 0"},
+		},
+		{
+			name: "Nested Route with Get on its root does not duplicate",
+			setup: func() Router {
+				r := NewMux()
+				r.Route("/foo", func(r Router) {
+					r.Route("/bar", func(r Router) {
+						r.Get("/", handler)
+					})
+				})
+				return r
+			},
+			expected: []string{"GET /foo/bar/ 0"},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			r := tt.setup()
+			var got []string
+			err := Walk(r, func(method, route string, _ http.Handler, middlewares ...func(http.Handler) http.Handler) error {
+				got = append(got, fmt.Sprintf("%s %s %d", method, route, len(middlewares)))
+				return nil
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			slices.Sort(got)
+			slices.Sort(tt.expected)
+			if !slices.Equal(got, tt.expected) {
+				t.Fatalf("expected %v, got %v", tt.expected, got)
+			}
+		})
+	}
+}
