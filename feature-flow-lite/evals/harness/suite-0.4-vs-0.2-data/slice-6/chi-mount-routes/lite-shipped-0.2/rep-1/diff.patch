+// allMethodRoutes returns the "METHOD route" strings for every registered method on route.
+func allMethodRoutes(route string) []string {
+	var out []string
+	for name := range methodMap {
+		out = append(out, name+" "+route)
+	}
+	return out
+}
+
+// collectWalkRoutes returns the sorted "METHOD route" strings reported by Walk.
+func collectWalkRoutes(t *testing.T, r Routes) []string {
+	t.Helper()
+	var got []string
+	err := Walk(r, func(method, route string, handler http.Handler, middlewares ...func(http.Handler) http.Handler) error {
+		got = append(got, method+" "+route)
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	slices.Sort(got)
+	return got
+}
+
+func TestWalkRouteStubCollisions(t *testing.T) {
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {})
+	RegisterMethod("CUSTOM")
+
+	tests := []struct {
+		name     string
+		setup    func() Router
+		expected []string
+	}{
+		{
+			name: "Get after Route on the same pattern",
+			setup: func() Router {
+				r := NewMux()
+				r.Route("/foo", func(r Router) {
+					r.Route("/bar", func(r Router) {
+						r.Get("/{id}", h)
+					})
+					r.Get("/bar", h)
+				})
+				return r
+			},
+			expected: []string{"GET /foo/bar", "GET /foo/bar/{id}"},
+		},
+		{
+			name: "Get before Route on the same pattern is replaced by the stub",
+			setup: func() Router {
+				r := NewMux()
+				r.Route("/foo", func(r Router) {
+					r.Get("/bar", h)
+					r.Route("/bar", func(r Router) {
+						r.Get("/{id}", h)
+					})
+				})
+				return r
+			},
+			expected: []string{"GET /foo/bar/{id}"},
+		},
+		{
+			name: "Get and trailing slash Post after Mount",
+			setup: func() Router {
+				sub := NewMux()
+				sub.Get("/{id}", h)
+				r := NewMux()
+				r.Mount("/bar", sub)
+				r.Get("/bar", h)
+				r.Post("/bar/", h)
+				return r
+			},
+			expected: []string{"GET /bar", "GET /bar/{id}", "POST /bar/"},
+		},
+		{
+			name: "Post on trailing slash stub of Route",
+			setup: func() Router {
+				r := NewMux()
+				r.Route("/foo", func(r Router) {
+					r.Route("/bar", func(r Router) {
+						r.Get("/{id}", h)
+					})
+					r.Post("/bar/", h)
+				})
+				return r
+			},
+			expected: []string{"GET /foo/bar/{id}", "POST /foo/bar/"},
+		},
+		{
+			name: "Handle after Route reports every method",
+			setup: func() Router {
+				r := NewMux()
+				r.Route("/foo", func(r Router) {
+					r.Route("/bar", func(r Router) {
+						r.Get("/{id}", h)
+					})
+					r.Handle("/bar", h)
+				})
+				return r
+			},
+			expected: append(allMethodRoutes("/foo/bar"), "GET /foo/bar/{id}"),
+		},
+		{
+			name: "Custom method after Route",
+			setup: func() Router {
+				r := NewMux()
+				r.Route("/foo", func(r Router) {
+					r.Route("/bar", func(r Router) {
+						r.Get("/{id}", h)
+					})
+					r.Method("CUSTOM", "/bar", h)
+				})
+				return r
+			},
+			expected: []string{"CUSTOM /foo/bar", "GET /foo/bar/{id}"},
+		},
+		{
+			name: "Get next to Mount of plain handler",
+			setup: func() Router {
+				r := NewMux()
+				r.Mount("/bar", h)
+				r.Get("/bar", h)
+				return r
+			},
+			expected: append(allMethodRoutes("/bar/*"), "GET /bar"),
+		},
+		{
+			name: "No collision keeps stubs hidden",
+			setup: func() Router {
+				r := NewMux()
+				r.Route("/foo", func(r Router) {
+					r.Route("/bar", func(r Router) {
+						r.Get("/{id}", h)
+					})
+					r.Get("/baz", h)
+				})
+				return r
+			},
+			expected: []string{"GET /foo/bar/{id}", "GET /foo/baz"},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			slices.Sort(tt.expected)
+			got := collectWalkRoutes(t, tt.setup())
+			if !slices.Equal(got, tt.expected) {
+				t.Fatalf("expected %v, got %v", tt.expected, got)
+			}
+		})
+	}
+}
+
+func TestWalkRouteStubMiddlewares(t *testing.T) {
+	mw := func(next http.Handler) http.Handler { return next }
+	h := func(w http.ResponseWriter, r *http.Request) {}
+
+	r := NewMux()
+	r.Route("/foo", func(r Router) {
+		r.Use(mw)
+		r.Route("/bar", func(r Router) {
+			r.Get("/{id}", h)
+		})
+		r.With(mw).Get("/bar", h)
+	})
+
+	got := make(map[string]int)
+	err := Walk(r, func(method, route string, handler http.Handler, middlewares ...func(http.Handler) http.Handler) error {
+		got[method+" "+route] = len(middlewares)
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	want := map[string]int{"GET /foo/bar": 2, "GET /foo/bar/{id}": 1}
+	if !maps.Equal(got, want) {
+		t.Fatalf("expected middleware counts %v, got %v", want, got)
+	}
+}
+
+func TestRouteStubCollisionServing(t *testing.T) {
+	r := NewMux()
+	r.Route("/foo", func(r Router) {
+		r.Route("/bar", func(r Router) {
+			r.Get("/{id}", func(w http.ResponseWriter, r *http.Request) {
+				w.Write([]byte("id"))
+			})
+		})
+		r.Get("/bar", func(w http.ResponseWriter, r *http.Request) {
+			w.Write([]byte("bar"))
+		})
+	})
+
+	tests := map[string]string{"/foo/bar": "bar", "/foo/bar/1": "id"}
+	for path, want := range tests {
+		rec := httptest.NewRecorder()
+		r.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, path, nil))
+		if got := rec.Body.String(); got != want {
+			t.Errorf("GET %s: expected body %q, got %q", path, want, got)
+		}
+	}
+}
