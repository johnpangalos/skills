+class SpoofedInputTest(unittest.TestCase):
+    def test_lying_str_key_cannot_refund_twice(self):
+        order = _order()
+        first = refund(order, Decimal("5"), _LyingKey("abc"))
+        again = refund(order, Decimal("5"), _LyingKey("abc"))
+        self.assertIs(again, first)
+        self.assertEqual(order.refunded(), Decimal("5.00"))
+        self.assertIs(type(first.key), str)
+        self.assertEqual(first.key, "abc")
+
+    def test_lying_str_key_with_other_amount_is_rejected(self):
+        order = _order()
+        refund(order, Decimal("5"), _LyingKey("abc"))
+        with self.assertRaises(RefundError) as cm:
+            refund(order, Decimal("6"), _LyingKey("abc"))
+        self.assertEqual(str(cm.exception), REUSED_KEY_MESSAGE)
+        self.assertEqual(order.refunded(), Decimal("5.00"))
+
+    def test_str_subclass_with_raising_bool_is_stored_as_exact_str(self):
