-def redeem_reset_token(token):
-    """Return the username a token was issued for."""
-    username = _TOKENS.get(token)
-    if username is None:
-        raise InvalidToken("unknown token")
-    return username
+def redeem_reset_token(token, now=None):
+    """Return the username a token was issued for, marking the token used.
+
+    A token works once and only within RESET_TOKEN_TTL seconds of issue.
+    Raises TokenUsed if already redeemed, TokenExpired if past the window,
+    and InvalidToken for unknown tokens. Failed attempts do not mark the
+    token used. `now` is Unix seconds; the default is time.time() at call time.
+    """
+    if now is None:
+        now = time.time()
+    with _LOCK:
+        record = _TOKENS.get(token)
+        if record is None:
+            raise InvalidToken("unknown token")
+        if token in _USED:
+            raise TokenUsed("token already used")
+        username, issued_at = record
+        if now - issued_at > RESET_TOKEN_TTL:
+            raise TokenExpired("token expired")
+        _USED.add(token)
+        return username
