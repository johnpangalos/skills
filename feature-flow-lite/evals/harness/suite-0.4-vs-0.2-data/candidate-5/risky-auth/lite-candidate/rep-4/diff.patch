+from shop.auth import (
+    RESET_TOKEN_TTL,
+    InvalidToken,
+    TokenExpired,
+    TokenUsed,
+    issue_reset_token,
+    redeem_reset_token,
+)
+
+
+class RaceSet(set):
+    """A set that holds each membership answer until every racing thread reads.
+
+    Without a lock, every thread reads "unused" before any thread can add the
+    token, so all of them succeed. With a lock only one thread is in the check
+    at a time, so the 1 ms wait just times out and correct behavior holds.
+    """
+
+    def __init__(self, parties):
+        super().__init__()
+        self._parties = parties
+        self._arrived = 0
+        self._cond = threading.Condition()
+
+    def __contains__(self, item):
+        present = set.__contains__(self, item)
+        with self._cond:
+            self._arrived += 1
+            self._cond.notify_all()
+            self._cond.wait_for(lambda: self._arrived >= self._parties, timeout=0.001)
+        return present
 
 
