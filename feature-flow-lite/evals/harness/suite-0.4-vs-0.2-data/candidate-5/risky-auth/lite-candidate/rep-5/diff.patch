+    `now` is Unix seconds (int or float); it defaults to the current time.
+    Raises TypeError if `now` is not a number and ValueError if it is NaN,
+    infinite, or too large for a float. Nothing is stored in either case.
+    """
+    if now is None:
+        now = time.time()
+    now = _check_now(now)
     token = secrets.token_urlsafe(16)
-    _TOKENS[token] = username
+    with _LOCK:
+        _TOKENS[token] = {"username": username, "issued_at": now, "used": False}
     return token
 
 
-def redeem_reset_token(token):
-    """Return the username a token was issued for."""
-    username = _TOKENS.get(token)
-    if username is None:
-        raise InvalidToken("unknown token")
-    return username
+def redeem_reset_token(token, now=None):
+    """Return the username a token was issued for.
+
+    Tokens are single-use and expire 30 minutes after issue. `now` is Unix
+    seconds (int or float); it defaults to the current time. Raises TypeError
+    if `now` is not a number and ValueError if it is NaN, infinite, or too
+    large for a float; the token is left unused in either case.
+    """
+    if now is None:
+        now = time.time()
+    now = _check_now(now)
+    with _LOCK:
+        entry = _TOKENS.get(token) if isinstance(token, str) else None
+        if entry is None:
+            raise InvalidToken("unknown token")
+        if entry["used"]:
+            raise TokenUsed("token already used")
+        if now - entry["issued_at"] > TOKEN_TTL_SECONDS:
+            raise TokenExpired("token expired")
+        entry["used"] = True
+        return entry["username"]
