     token = secrets.token_urlsafe(16)
-    _TOKENS[token] = username
+    with _LOCK:
+        _TOKENS[token] = {"username": username, "issued_at": now, "used": False}
     return token
 
 
-def redeem_reset_token(token):
-    """Return the username a token was issued for."""
-    username = _TOKENS.get(token)
-    if username is None:
-        raise InvalidToken("unknown token")
-    return username
+def redeem_reset_token(token, now=None):
+    """Return the username a token was issued for; the token is then spent."""
+    if now is None:
+        now = time.time()
+    with _LOCK:
+        record = _TOKENS.get(token)
+        if record is None:
+            raise InvalidToken("unknown token")
+        if record["used"]:
+            raise TokenUsed("reset token already used")
+        if not now - record["issued_at"] <= RESET_TOKEN_TTL:
+            raise TokenExpired("reset token expired")
+        record["used"] = True
+        return record["username"]
