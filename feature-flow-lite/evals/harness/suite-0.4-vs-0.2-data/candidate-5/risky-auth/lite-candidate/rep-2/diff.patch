+class ConcurrentRedeemTest(unittest.TestCase):
+    def test_eight_threads_one_winner_per_round(self):
+        thread_count = 8
+        for round_no in range(200):
+            token = issue_reset_token("ada", now=0)
+            barrier = threading.Barrier(thread_count)
+            results = [None] * thread_count
+
+            def worker(i):
+                barrier.wait()
+                try:
+                    results[i] = redeem_reset_token(token, now=0)
+                except InvalidToken as exc:
+                    results[i] = exc
+
+            threads = [
+                threading.Thread(target=worker, args=(i,))
+                for i in range(thread_count)
+            ]
+            for t in threads:
+                t.start()
+            for t in threads:
+                t.join()
+            winners = [r for r in results if r == "ada"]
+            losers = [r for r in results if type(r) is TokenUsed]
+            self.assertEqual(
+                len(winners), 1, f"round {round_no}: results={results!r}"
+            )
+            self.assertEqual(
+                len(losers), thread_count - 1, f"round {round_no}: results={results!r}"
+            )
+
+
+class PropertyTest(unittest.TestCase):
+    def test_redeem_window_and_single_use(self):
+        rng = random.Random(20261117)
+        edge_times = [0, 1, 1799.999, 1800, 1800.001, 1801, -1, 1e12, 1700000000.5]
+        failures = []
+        for _ in range(1200):
+            issued_at = rng.choice(edge_times + [rng.uniform(-1e9, 1e12)])
+            elapsed = rng.choice(edge_times + [rng.uniform(-100, 3600)])
+            redeem_at = issued_at + elapsed
+            observed = redeem_at - issued_at
+            expected = "ok" if observed <= RESET_TOKEN_TTL else "TokenExpired"
+            token = issue_reset_token("ada", now=issued_at)
+            first = _redeem_outcome(token, redeem_at)
+            second = _redeem_outcome(token, redeem_at) if first == "ok" else None
+            if first != expected or (first == "ok" and second != "TokenUsed"):
+                failures.append(
+                    (issued_at, elapsed, observed, first, second, expected)
+                )
+        if failures:
+            self.fail(
+                "first failing input (issued_at, elapsed, observed, first, second, "
+                f"expected): {failures[0]!r}; total failures: {len(failures)}"
+            )
+
+
+def _redeem_outcome(token, now):
+    try:
+        redeem_reset_token(token, now=now)
+        return "ok"
+    except InvalidToken as exc:
+        return type(exc).__name__
+
