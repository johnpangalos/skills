+    await user.keyboard("{ArrowDown}{ArrowUp}{Enter}");
+    expect(input()).not.toHaveAttribute("aria-activedescendant");
+    expect(onChange).not.toHaveBeenCalled();
+  });
+
+  it("calls a consumer onBlur along with its own blur handling", async () => {
+    const user = userEvent.setup();
+    const onBlur = vi.fn();
+    render(<Combobox label="Fruit" options={FRUITS} value={null} onChange={noop} onBlur={onBlur} />);
