+    ["an inert ancestor", <div inert><button type="button">Hidden</button></div>],
+    ["a display:none ancestor", <div style={{ display: "none" }}><button type="button">Hidden</button></div>],
+    ["a visibility:hidden ancestor", <div style={{ visibility: "hidden" }}><button type="button">Hidden</button></div>],
+    ["display:none on itself", <button type="button" style={{ display: "none" }}>Hidden</button>],
+    ["visibility:hidden on itself", <button type="button" style={{ visibility: "hidden" }}>Hidden</button>],
