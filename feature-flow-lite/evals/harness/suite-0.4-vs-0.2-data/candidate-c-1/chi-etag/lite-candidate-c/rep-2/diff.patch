+func TestETagIfNoneMatchMatchesNetHTTP(t *testing.T) {
+	// net/http's ServeContent runs the stdlib If-None-Match check against the same ETag.
+	// Generated values must get the same 304-or-200 decision. Only a single If-None-Match line
+	// is generated, because the stdlib reads only the first line.
+	tokens := []string{`"`, `"a"`, `"b"`, `"a,b"`, `W/"b"`, `w/`, `W/`, `W`, `/`, ` `, "\t", `,`, `a`, `b`, `""`, "\x01", "\x80", `"b`, `abc`}
+	etags := []string{`"a"`, `"b"`, `W/"b"`, `"a,b"`, `""`, `abc`, `"b`, `"abc"`}
+	rng := rand.New(rand.NewSource(1))
+	for i := 0; i < 2000; i++ {
+		var sb strings.Builder
+		for n := rng.Intn(10); n > 0; n-- {
+			sb.WriteString(tokens[rng.Intn(len(tokens))])
+		}
+		inm := sb.String()
+		etag := etags[rng.Intn(len(etags))]
+
+		got := etagRecord(ETag(etagSetETag(etag)), http.MethodGet, etagINM(inm)).Code
+		want := etagServeContentCode(etag, etagINM(inm))
+		if got != want {
+			t.Fatalf("If-None-Match %q against ETag %q: middleware got %d, net/http got %d", inm, etag, got, want)
+		}
+	}
+}
