+func TestETagCompressLeavesHandlerETagAlone(t *testing.T) {
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "text/plain")
+		w.Header().Set("ETag", `"own"`)
+		w.Write([]byte(strings.Repeat("hello ", 100)))
+	})
+	ts := etagServer(t, Compress(5)(ETag(h)))
+	resp, _ := etagFetch(t, ts, http.MethodGet, http.Header{"Accept-Encoding": {"gzip"}})
+	assertEqual(t, resp.Header.Get("Content-Encoding"), "gzip")
+	assertEqual(t, resp.Header.Get("ETag"), `"own"`)
+}
