+func TestETagContentLengthMatchesNetHTTP(t *testing.T) {
+	cases := []struct {
+		name   string
+		length string
+		writes []string
+	}{
+		{"one write past the declared length", "3", []string{"abcde"}},
+		{"writes past the declared length", "3", []string{"ab", "cd", "e"}},
+		{"writes that exactly fill the length", "5", []string{"ab", "cde"}},
+		{"body shorter than the length", "9", []string{"ab"}},
