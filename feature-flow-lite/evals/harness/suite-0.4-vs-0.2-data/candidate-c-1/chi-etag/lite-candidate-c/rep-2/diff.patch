+func TestETagDifferentialCallOrders(t *testing.T) {
+	type op struct {
+		name string
+		run  func(w http.ResponseWriter)
+	}
+	ops := []op{
+		{"WriteHeader(200)", func(w http.ResponseWriter) { w.WriteHeader(http.StatusOK) }},
+		{"WriteHeader(404)", func(w http.ResponseWriter) { w.WriteHeader(http.StatusNotFound) }},
+		{"WriteHeader(500)", func(w http.ResponseWriter) { w.WriteHeader(http.StatusInternalServerError) }},
+		{"Write", func(w http.ResponseWriter) { w.Write([]byte("ab")) }},
+		{"Flush", func(w http.ResponseWriter) { w.(http.Flusher).Flush() }},
+	}
+
+	// Every call order of up to three operations.
+	var scripts [][]op
+	var build func(prefix []op)
+	build = func(prefix []op) {
+		if len(prefix) > 0 {
+			scripts = append(scripts, prefix)
+		}
+		if len(prefix) == 3 {
+			return
+		}
+		for _, o := range ops {
+			build(append(append([]op{}, prefix...), o))
+		}
+	}
+	build(nil)
+
+	for _, s := range scripts {
+		names := make([]string, len(s))
+		for i, o := range s {
+			names[i] = o.name
+		}
+
+		h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("X-Custom", "1")
+			for _, o := range s {
+				o.run(w)
+			}
+		})
+		for _, m := range []string{http.MethodGet, http.MethodHead, http.MethodPost} {
+			name := m + " " + strings.Join(names, ", ")
+			want := etagRecord(h, m, nil)
+			got := etagRecord(ETag(h), m, nil)
+
+			// Approved: buffered 200 GET/HEAD responses may gain an ETag and never send an early flush.
+			buffered := m != http.MethodPost && want.Code == http.StatusOK
+			if buffered {
+				assertEqual(t, got.Flushed, false)
+			} else {
+				assertEqual(t, got.Flushed, want.Flushed)
+			}
+			assertEqual(t, got.Code, want.Code)
+			assertEqual(t, got.Body.String(), want.Body.String())
+
+			// Approved: a buffered 200 may gain a generated ETag. Its headers go out with the body, so
+			// Content-Type is sniffed from the body, and httptest sniffs at a different point than net/http.
+			gotHeader := got.Header().Clone()
+			wantHeader := want.Header().Clone()
+			gotHeader.Del("ETag")
+			wantHeader.Del("ETag")
+			if buffered {
+				gotHeader.Del("Content-Type")
+				wantHeader.Del("Content-Type")
+			}
+			if !reflect.DeepEqual(gotHeader, wantHeader) {
+				t.Fatalf("%s: headers got %v, want %v", name, gotHeader, wantHeader)
+			}
+		}
+	}
+}
