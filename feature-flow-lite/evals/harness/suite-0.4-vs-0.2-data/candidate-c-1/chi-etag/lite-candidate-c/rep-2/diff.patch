+func TestETagCompressBothOrdersGiveDistinctETags(t *testing.T) {
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "text/plain")
+		w.Write([]byte(strings.Repeat("hello ", 100)))
+	})
+	orders := map[string]http.Handler{
+		"ETag outside Compress": ETag(Compress(5)(h)),
+		"ETag inside Compress":  Compress(5)(ETag(h)),
+	}
+	for name, served := range orders {
+		t.Run(name, func(t *testing.T) {
+			ts := etagServer(t, served)
+			identity, _ := etagFetch(t, ts, http.MethodGet, http.Header{"Accept-Encoding": {"identity"}})
+			identityETag := identity.Header.Get("ETag")
+			assertEqual(t, identity.Header.Get("Content-Encoding"), "")
+
+			gz, _ := etagFetch(t, ts, http.MethodGet, http.Header{"Accept-Encoding": {"gzip"}})
+			gzETag := gz.Header.Get("ETag")
+			assertEqual(t, gz.Header.Get("Content-Encoding"), "gzip")
+			assertEqual(t, gzETag != identityETag, true)
+
+			// A gzip request carrying the identity validator gets the full gzip response.
+			resp, body := etagFetch(t, ts, http.MethodGet, http.Header{"Accept-Encoding": {"gzip"}, "If-None-Match": {identityETag}})
+			assertEqual(t, resp.StatusCode, http.StatusOK)
+			assertEqual(t, resp.Header.Get("Content-Encoding"), "gzip")
+			assertEqual(t, body != "", true)
+
+			// An identity request carrying the gzip validator gets the identity response.
+			resp, _ = etagFetch(t, ts, http.MethodGet, http.Header{"Accept-Encoding": {"identity"}, "If-None-Match": {gzETag}})
+			assertEqual(t, resp.StatusCode, http.StatusOK)
+			assertEqual(t, resp.Header.Get("Content-Encoding"), "")
+
+			// Same-encoding revalidation still gets 304.
+			resp, _ = etagFetch(t, ts, http.MethodGet, http.Header{"Accept-Encoding": {"gzip"}, "If-None-Match": {gzETag}})
+			assertEqual(t, resp.StatusCode, http.StatusNotModified)
+			resp, _ = etagFetch(t, ts, http.MethodGet, http.Header{"Accept-Encoding": {"identity"}, "If-None-Match": {identityETag}})
+			assertEqual(t, resp.StatusCode, http.StatusNotModified)
+		})
+	}
+}
