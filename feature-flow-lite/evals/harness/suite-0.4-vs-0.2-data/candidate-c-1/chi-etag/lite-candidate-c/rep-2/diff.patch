+func TestETagContentLengthChangedAfterWriteHeaderMatchesWire(t *testing.T) {
+	cases := []struct {
+		name   string
+		before string // Content-Length set before WriteHeader, "" for none
+		after  string // Content-Length set after WriteHeader, "" to delete it
+	}{
+		{"larger value after WriteHeader", "", "9"},
+		{"smaller value after WriteHeader", "", "3"},
+		{"deleted after WriteHeader", "5", ""},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			// run serves h over the wire and returns the raw response and the error the Write returned.
+			run := func(wrap bool) (string, string) {
+				var writeErr string
+				h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					w.Header().Set("ETag", `"fixed"`)
+					w.Header().Set("Content-Type", "text/plain")
+					if tc.before != "" {
+						w.Header().Set("Content-Length", tc.before)
+					}
+					w.WriteHeader(http.StatusOK)
+					if tc.after == "" {
+						w.Header().Del("Content-Length")
+					} else {
+						w.Header().Set("Content-Length", tc.after)
+					}
+					_, err := w.Write([]byte("abcde"))
+					writeErr = fmt.Sprint(err)
+				})
+				var served http.Handler = h
+				if wrap {
+					served = ETag(h)
+				}
+				return etagRawExchange(t, served), writeErr
+			}
+			wantWire, wantErr := run(false)
+			gotWire, gotErr := run(true)
+			assertEqual(t, gotWire, wantWire)
+			assertEqual(t, gotErr, wantErr)
+		})
+	}
+}
