diff --git a/middleware/etag.go b/middleware/etag.go
new file mode 100644
index 0000000..4cca1ab
--- /dev/null
+++ b/middleware/etag.go
@@ -0,0 +1,285 @@
+package middleware
+
+import (
+	"bufio"
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"net"
+	"net/http"
+	"net/textproto"
+	"strconv"
+	"strings"
+)
+
+// ETag adds a validator to GET and HEAD responses and answers 304 Not Modified
+// when the request's If-None-Match matches it.
+//
+// For GET and HEAD requests the whole response body is buffered in memory until
+// the handler returns, so ETag is not for streaming or server-sent event
+// endpoints. A 200 response is buffered; any other status is passed through as
+// soon as the handler sets it.
+//
+// If the handler sets no ETag on a 200 response, ETag adds a strong one: the
+// hex SHA-256 of the body in double quotes. A HEAD response with no body gets
+// no generated ETag.
+//
+// If an If-None-Match member weak-matches the response's ETag (RFC 9110 section
+// 8.8.3.2), or If-None-Match is "*", the response becomes 304 Not Modified with
+// an empty body. The 304 keeps the ETag and the other headers, and drops
+// Content-Type, Content-Length, Content-Encoding and, when an ETag is present,
+// Last-Modified.
+//
+// Other methods are passed through unchanged.
+//
+// ETag works with Compress in either order. When Compress wraps ETag, a generated
+// validator gets the coding as a suffix (for example "<hex>-gzip"), so the
+// identity and encoded responses never share a strong ETag.
+func ETag(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet && r.Method != http.MethodHead {
+			next.ServeHTTP(w, r)
+			return
+		}
+		ew := &etagResponseWriter{ResponseWriter: w}
+		next.ServeHTTP(ew, r)
+		ew.finish(r)
+	})
+}
+
+type etagResponseWriter struct {
+	http.ResponseWriter
+
+	status   int          // status the handler chose; 0 until it chooses one
+	passthru bool         // the response has been sent; writes go straight through
+	hijacked bool         // the connection was taken over; writes are dropped
+	body     bytes.Buffer // body of a 200 response, held until finish
+	length   int64        // Content-Length the handler declared with its status, or -1
+	declared []string     // Content-Length header as the handler had it with its status, or nil
+	written  int64        // bytes the handler has written, refused ones included
+}
+
+func (w *etagResponseWriter) WriteHeader(code int) {
+	if w.hijacked {
+		return
+	}
+	if code >= 100 && code <= 199 && code != http.StatusSwitchingProtocols {
+		// Informational responses go out now and do not fix the final status.
+		w.ResponseWriter.WriteHeader(code)
+		return
+	}
+	if w.status != 0 {
+		// The first status wins. A repeat reaches net/http once the response is passed through.
+		if w.passthru {
+			w.ResponseWriter.WriteHeader(code)
+		}
+		return
+	}
+	w.status = code
+	w.length = -1
+	w.declared = w.Header()["Content-Length"]
+	if n, err := strconv.ParseInt(w.Header().Get("Content-Length"), 10, 64); err == nil && n >= 0 {
+		w.length = n
+	}
+	if code != http.StatusOK {
+		w.commit()
+	}
+}
+
+func (w *etagResponseWriter) Write(p []byte) (int, error) {
+	if w.hijacked {
+		return 0, http.ErrHijacked
+	}
+	if w.status == 0 {
+		w.WriteHeader(http.StatusOK)
+	}
+	if w.passthru {
+		return w.ResponseWriter.Write(p)
+	}
+	if len(p) == 0 {
+		return 0, nil
+	}
+	// As in net/http, a write that goes past the declared Content-Length is refused, and later writes are too.
+	w.written += int64(len(p))
+	if w.length >= 0 && w.written > w.length {
+		return 0, http.ErrContentLength
+	}
+	return w.body.Write(p)
+}
+
+func (w *etagResponseWriter) Flush() {
+	if w.hijacked {
+		return
+	}
+	if w.status == 0 {
+		// As in net/http, a flush before any status means 200, so a later WriteHeader is superfluous.
+		w.WriteHeader(http.StatusOK)
+	}
+	// A buffered response sends nothing until the handler returns.
+	if !w.passthru {
+		return
+	}
+	if f, ok := w.ResponseWriter.(http.Flusher); ok {
+		f.Flush()
+	}
+}
+
+func (w *etagResponseWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	hj, ok := w.ResponseWriter.(http.Hijacker)
+	if !ok {
+		return nil, nil, errors.New("chi/middleware: http.Hijacker is unavailable on the writer")
+	}
+	if w.status == http.StatusOK && !w.passthru {
+		// What was written before the takeover is sent, as it would be without the middleware.
+		w.commit()
+	}
+	w.hijacked = true
+	return hj.Hijack()
+}
+
+func (w *etagResponseWriter) Push(target string, opts *http.PushOptions) error {
+	if ps, ok := w.ResponseWriter.(http.Pusher); ok {
+		return ps.Push(target, opts)
+	}
+	return errors.New("chi/middleware: http.Pusher is unavailable on the writer")
+}
+
+func (w *etagResponseWriter) Unwrap() http.ResponseWriter {
+	return w.ResponseWriter
+}
+
+// commit sends w.status and the buffered body, then passes later writes straight through.
+// A body is written without an explicit WriteHeader, so it implies 200 as it would unwrapped.
+// Only a 200 response has a body here.
+func (w *etagResponseWriter) commit() {
+	w.passthru = true
+	if w.status == http.StatusOK {
+		// net/http takes the headers at WriteHeader, so a Content-Length set after it must not be sent.
+		if w.declared == nil {
+			w.Header().Del("Content-Length")
+		} else {
+			w.Header()["Content-Length"] = w.declared
+		}
+	}
+	if w.body.Len() == 0 {
+		w.ResponseWriter.WriteHeader(w.status)
+		return
+	}
+	w.ResponseWriter.Write(w.body.Bytes())
+}
+
+// finish sends a buffered 200 response once the handler has returned normally.
+// A panic skips it, so the recovering middleware's response is the only one sent.
+func (w *etagResponseWriter) finish(r *http.Request) {
+	if w.hijacked || w.passthru {
+		return
+	}
+	if w.status == 0 {
+		w.WriteHeader(http.StatusOK)
+	}
+	h := w.Header()
+	if h.Get("ETag") == "" && (r.Method == http.MethodGet || w.body.Len() > 0) {
+		sum := sha256.Sum256(w.body.Bytes())
+		tag := hex.EncodeToString(sum[:])
+		if coding := pendingCoding(w.ResponseWriter); coding != "" {
+			// Compress encodes this body on the way out, so the identity and encoded variants need different validators.
+			tag += "-" + coding
+		}
+		h.Set("ETag", `"`+tag+`"`)
+	}
+	if !etagNoneMatch(r, h.Get("ETag")) {
+		w.commit()
+		return
+	}
+	h.Del("Content-Type")
+	h.Del("Content-Length")
+	h.Del("Content-Encoding")
+	if h.Get("ETag") != "" {
+		h.Del("Last-Modified")
+	}
+	w.body.Reset()
+	w.status = http.StatusNotModified
+	w.commit()
+}
+
+// pendingCoding returns the coding that a Compress middleware wrapping w will apply to the body,
+// or "" if it will not. It walks the Unwrap chain to find the Compress writer.
+func pendingCoding(w http.ResponseWriter) string {
+	for {
+		if cw, ok := w.(*compressResponseWriter); ok {
+			if cw.encoding == "" || !cw.isCompressible() || cw.Header().Get("Content-Encoding") != "" {
+				return ""
+			}
+			return cw.encoding
+		}
+		u, ok := w.(interface{ Unwrap() http.ResponseWriter })
+		if !ok {
+			return ""
+		}
+		w = u.Unwrap()
+	}
+}
+
+// etagNoneMatch reports whether any If-None-Match line matches etag. Each line is parsed on its own,
+// so a malformed member cannot join with the next line.
+func etagNoneMatch(r *http.Request, etag string) bool {
+	for _, line := range r.Header.Values("If-None-Match") {
+		if etagListMatch(line, etag) {
+			return true
+		}
+	}
+	return false
+}
+
+// etagListMatch reports whether an If-None-Match list matches etag. A list of just "*" matches any
+// response. Inside a list "*" is skipped, and a malformed member ends the list.
+func etagListMatch(list, etag string) bool {
+	if textproto.TrimString(list) == "*" {
+		return true
+	}
+	buf := list
+	for {
+		buf = textproto.TrimString(buf)
+		if buf == "" {
+			return false
+		}
+		if buf[0] == ',' || buf[0] == '*' {
+			buf = buf[1:]
+			continue
+		}
+		member, remain := scanETag(buf)
+		if member == "" {
+			return false
+		}
+		if strings.TrimPrefix(member, "W/") == strings.TrimPrefix(etag, "W/") {
+			return true
+		}
+		buf = remain
+	}
+}
+
+// scanETag returns the entity tag at the start of s and the text after it,
+// or "", "" if s does not start with a valid one. It follows net/http's scanETag.
+func scanETag(s string) (etag string, remain string) {
+	start := 0
+	if strings.HasPrefix(s, "W/") {
+		start = 2
+	}
+	if len(s[start:]) < 2 || s[start] != '"' {
+		return "", ""
+	}
+	// ETag is either W/"text" or "text".
+	for i := start + 1; i < len(s); i++ {
+		c := s[i]
+		switch {
+		// Character values allowed in ETags.
+		case c == 0x21 || c >= 0x23 && c <= 0x7E || c >= 0x80:
+		case c == '"':
+			return s[:i+1], s[i+1:]
+		default:
+			return "", ""
+		}
+	}
+	return "", ""
+}
diff --git a/middleware/etag_test.go b/middleware/etag_test.go
new file mode 100644
index 0000000..e0afd4d
--- /dev/null
+++ b/middleware/etag_test.go
@@ -0,0 +1,916 @@
+package middleware
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"io"
+	"log"
+	"math/rand"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/http/httptrace"
+	"net/textproto"
+	"os"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/go-chi/chi/v5"
+)
+
+// etagOf is the ETag ETag must generate for body.
+func etagOf(body []byte) string {
+	sum := sha256.Sum256(body)
+	return `"` + hex.EncodeToString(sum[:]) + `"`
+}
+
+// etagHandler writes the status (when non-zero) and then each part in its own Write call.
+func etagHandler(status int, parts ...string) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		if status != 0 {
+			w.WriteHeader(status)
+		}
+		for _, p := range parts {
+			w.Write([]byte(p))
+		}
+	}
+}
+
+// etagSetETag sets the ETag header to tag and writes a short body.
+func etagSetETag(tag string) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("ETag", tag)
+		w.Write([]byte("body"))
+	}
+}
+
+func etagINM(lines ...string) http.Header {
+	h := http.Header{}
+	for _, l := range lines {
+		h.Add("If-None-Match", l)
+	}
+	return h
+}
+
+func etagServer(t *testing.T, h http.Handler) *httptest.Server {
+	t.Helper()
+	ts := httptest.NewServer(ETag(h))
+	t.Cleanup(ts.Close)
+	return ts
+}
+
+func etagFetch(t *testing.T, ts *httptest.Server, method string, hdr http.Header) (*http.Response, string) {
+	t.Helper()
+	req, err := http.NewRequest(method, ts.URL+"/", nil)
+	assertNoError(t, err)
+	for k, v := range hdr {
+		req.Header[k] = v
+	}
+	resp, err := http.DefaultClient.Do(req)
+	assertNoError(t, err)
+	defer resp.Body.Close()
+	body, err := io.ReadAll(resp.Body)
+	assertNoError(t, err)
+	return resp, string(body)
+}
+
+// etagRecord runs h, which is not wrapped in ETag, against a recorder.
+func etagRecord(h http.Handler, method string, hdr http.Header) *httptest.ResponseRecorder {
+	req := httptest.NewRequest(method, "/", nil)
+	for k, v := range hdr {
+		req.Header[k] = v
+	}
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, req)
+	return rec
+}
+
+// etagServeContentCode is the net/http oracle: the status ServeContent gives for an ETag and If-None-Match.
+func etagServeContentCode(etag string, hdr http.Header) int {
+	req := httptest.NewRequest(http.MethodGet, "/", nil)
+	req.Header = hdr
+	rec := httptest.NewRecorder()
+	rec.Header().Set("ETag", etag)
+	http.ServeContent(rec, req, "", time.Time{}, bytes.NewReader([]byte("x")))
+	return rec.Code
+}
+
+// etagSame fails unless h wrapped in ETag answers exactly like h alone.
+func etagSame(t *testing.T, h http.Handler, method string, hdr http.Header) {
+	t.Helper()
+	want := etagRecord(h, method, hdr)
+	got := etagRecord(ETag(h), method, hdr)
+	assertEqual(t, got.Code, want.Code)
+	assertEqual(t, got.Body.String(), want.Body.String())
+	assertEqual(t, got.Header(), want.Header())
+	assertEqual(t, got.Flushed, want.Flushed)
+}
+
+func TestETagSignature(t *testing.T) {
+	var _ func(http.Handler) http.Handler = ETag
+}
+
+func TestETagGeneratesStrongETag(t *testing.T) {
+	big := strings.Repeat("x", 1<<20)
+	many := make([]string, 1000)
+	for i := range many {
+		many[i] = string(rune('a' + i%26))
+	}
+	cases := []struct {
+		name string
+		h    http.HandlerFunc
+		body string
+	}{
+		{"explicit 200", etagHandler(http.StatusOK, "hello"), "hello"},
+		{"implicit 200 via Write", etagHandler(0, "hello"), "hello"},
+		{"no write at all", etagHandler(0), ""},
+		{"empty body", etagHandler(http.StatusOK), ""},
+		{"many small chunks", etagHandler(0, many...), strings.Join(many, "")},
+		{"1 MiB body", etagHandler(0, big), big},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			ts := etagServer(t, tc.h)
+			resp, body := etagFetch(t, ts, http.MethodGet, nil)
+			assertEqual(t, resp.StatusCode, http.StatusOK)
+			assertEqual(t, body, tc.body)
+			assertEqual(t, resp.Header.Get("ETag"), etagOf([]byte(tc.body)))
+		})
+	}
+}
+
+func TestETagStableAndContentDerived(t *testing.T) {
+	once := etagServer(t, etagHandler(0, "abcdef"))
+	split := etagServer(t, etagHandler(0, "abc", "def"))
+	other := etagServer(t, etagHandler(0, "abcdeg"))
+
+	first, _ := etagFetch(t, once, http.MethodGet, nil)
+	again, _ := etagFetch(t, once, http.MethodGet, nil)
+	chunked, _ := etagFetch(t, split, http.MethodGet, nil)
+	different, _ := etagFetch(t, other, http.MethodGet, nil)
+
+	assertEqual(t, again.Header.Get("ETag"), first.Header.Get("ETag"))
+	assertEqual(t, chunked.Header.Get("ETag"), first.Header.Get("ETag"))
+	assertEqual(t, different.Header.Get("ETag") == first.Header.Get("ETag"), false)
+}
+
+func TestETagHandlerSetETag(t *testing.T) {
+	t.Run("weak ETag kept byte-for-byte", func(t *testing.T) {
+		ts := etagServer(t, etagSetETag(`W/"v1"`))
+		resp, _ := etagFetch(t, ts, http.MethodGet, nil)
+		assertEqual(t, resp.StatusCode, http.StatusOK)
+		assertEqual(t, resp.Header.Get("ETag"), `W/"v1"`)
+	})
+
+	t.Run("strong ETag never overwritten", func(t *testing.T) {
+		ts := etagServer(t, etagSetETag(`"v9"`))
+		resp, _ := etagFetch(t, ts, http.MethodGet, nil)
+		assertEqual(t, resp.Header.Get("ETag"), `"v9"`)
+	})
+
+	t.Run("weak ETag matches strong If-None-Match", func(t *testing.T) {
+		ts := etagServer(t, etagSetETag(`W/"v1"`))
+		resp, body := etagFetch(t, ts, http.MethodGet, etagINM(`"v1"`))
+		assertEqual(t, resp.StatusCode, http.StatusNotModified)
+		assertEqual(t, body, "")
+	})
+
+	t.Run("header set after WriteHeader is sent and matched", func(t *testing.T) {
+		ts := etagServer(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(http.StatusOK)
+			w.Header().Set("ETag", `"late"`)
+			w.Write([]byte("body"))
+		}))
+		resp, _ := etagFetch(t, ts, http.MethodGet, nil)
+		assertEqual(t, resp.Header.Get("ETag"), `"late"`)
+		resp, _ = etagFetch(t, ts, http.MethodGet, etagINM(`"late"`))
+		assertEqual(t, resp.StatusCode, http.StatusNotModified)
+	})
+}
+
+func TestETagNotModifiedHeaders(t *testing.T) {
+	ts := etagServer(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		h := w.Header()
+		h.Set("Cache-Control", "max-age=60")
+		h.Set("Vary", "Accept-Encoding")
+		h.Set("Expires", "Wed, 21 Oct 2037 07:28:00 GMT")
+		h.Set("Content-Location", "/other")
+		h.Set("Set-Cookie", "sid=1")
+		h.Set("X-Custom", "yes")
+		h.Set("Last-Modified", "Mon, 02 Jan 2006 15:04:05 GMT")
+		h.Set("Content-Type", "text/plain")
+		h.Set("Content-Length", "5")
+		h.Set("Content-Encoding", "gzip")
+		w.Write([]byte("hello"))
+	}))
+
+	resp, body := etagFetch(t, ts, http.MethodGet, etagINM(etagOf([]byte("hello"))))
+	assertEqual(t, resp.StatusCode, http.StatusNotModified)
+	assertEqual(t, body, "")
+	assertEqual(t, resp.Header.Get("ETag"), etagOf([]byte("hello")))
+	assertEqual(t, resp.Header.Get("Cache-Control"), "max-age=60")
+	assertEqual(t, resp.Header.Get("Vary"), "Accept-Encoding")
+	assertEqual(t, resp.Header.Get("Expires"), "Wed, 21 Oct 2037 07:28:00 GMT")
+	assertEqual(t, resp.Header.Get("Content-Location"), "/other")
+	assertEqual(t, resp.Header.Get("Set-Cookie"), "sid=1")
+	assertEqual(t, resp.Header.Get("X-Custom"), "yes")
+	assertEqual(t, resp.Header.Get("Date") != "", true)
+	assertEqual(t, resp.Header.Get("Content-Type"), "")
+	assertEqual(t, resp.Header.Get("Content-Length"), "")
+	assertEqual(t, resp.Header.Get("Content-Encoding"), "")
+	assertEqual(t, resp.Header.Get("Last-Modified"), "")
+}
+
+func TestETagNotModifiedHEAD(t *testing.T) {
+	ts := etagServer(t, etagHandler(0, "hello"))
+	resp, body := etagFetch(t, ts, http.MethodHead, etagINM(etagOf([]byte("hello"))))
+	assertEqual(t, resp.StatusCode, http.StatusNotModified)
+	assertEqual(t, body, "")
+}
+
+func TestETagNotModifiedKeepsLastModifiedWithoutETag(t *testing.T) {
+	ts := etagServer(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Last-Modified", "Mon, 02 Jan 2006 15:04:05 GMT")
+	}))
+	resp, _ := etagFetch(t, ts, http.MethodHead, etagINM("*"))
+	assertEqual(t, resp.StatusCode, http.StatusNotModified)
+	assertEqual(t, resp.Header.Get("Last-Modified"), "Mon, 02 Jan 2006 15:04:05 GMT")
+	assertEqual(t, resp.Header.Get("ETag"), "")
+}
+
+func TestETagIfNoneMatchRules(t *testing.T) {
+	cases := []struct {
+		name string
+		etag string
+		inm  []string
+		want int
+	}{
+		{"list with OWS and weak member", `"b"`, []string{`"a", W/"b" ,"c"`}, http.StatusNotModified},
+		{"comma inside tag matches itself", `"a,b"`, []string{`"a,b"`}, http.StatusNotModified},
+		{"comma inside tag is not split (first part)", `"a"`, []string{`"a,b"`}, http.StatusOK},
+		{"comma inside tag is not split (second part)", `"b"`, []string{`"a,b"`}, http.StatusOK},
+		{"unquoted tag never matches", `abc`, []string{`abc`}, http.StatusOK},
+		{"unquoted member never matches quoted tag", `"abc"`, []string{`abc`}, http.StatusOK},
+		{"lowercase w never matches", `"abc"`, []string{`w/"abc"`}, http.StatusOK},
+		{"empty header", `"x"`, []string{""}, http.StatusOK},
+		{"lone comma", `"x"`, []string{","}, http.StatusOK},
+		{"empty quoted matches empty quoted tag", `""`, []string{`""`}, http.StatusNotModified},
+		{"empty quoted does not match other tag", `"x"`, []string{`""`}, http.StatusOK},
+		{"malformed member never matches", `"abc"`, []string{`"abc`}, http.StatusOK},
+		{"malformed member stops the list", `"x"`, []string{`"abc, "x"`}, http.StatusOK},
+		{"star alone matches", `"x"`, []string{"*"}, http.StatusNotModified},
