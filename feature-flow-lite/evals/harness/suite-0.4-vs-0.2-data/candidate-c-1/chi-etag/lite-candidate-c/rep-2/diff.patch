+// etagRawExchange sends one HTTP/1.1 request on a raw connection and returns the bytes the server wrote, without Date.
+func etagRawExchange(t *testing.T, h http.Handler) string {
+	t.Helper()
+	ts := httptest.NewServer(h)
+	// Closing waits for the handler, so anything it recorded is safe to read after return.
+	defer ts.Close()
+	conn, err := net.Dial("tcp", ts.Listener.Addr().String())
+	assertNoError(t, err)
+	defer conn.Close()
+	_, err = io.WriteString(conn, "GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n")
+	assertNoError(t, err)
+	out, err := io.ReadAll(conn)
+	assertNoError(t, err)
+	var lines []string
+	for _, l := range strings.Split(string(out), "\r\n") {
+		if !strings.HasPrefix(l, "Date: ") {
+			lines = append(lines, l)
+		}
+	}
+	return strings.Join(lines, "\r\n")
+}
