+				h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					w.Header().Set("ETag", `"fixed"`)
+					w.Header().Set("Content-Length", tc.length)
+					for _, p := range tc.writes {
+						_, err := w.Write([]byte(p))
+						errs = append(errs, fmt.Sprint(err))
+					}
+				})
+				var served http.Handler = h
+				if wrap {
+					served = ETag(h)
+				}
+				return etagRawExchange(t, served), errs
+			}
+			wantWire, wantErrs := run(false)
+			gotWire, gotErrs := run(true)
+			assertEqual(t, gotWire, wantWire)
+			assertEqual(t, gotErrs, wantErrs)
+		})
+	}
+}
