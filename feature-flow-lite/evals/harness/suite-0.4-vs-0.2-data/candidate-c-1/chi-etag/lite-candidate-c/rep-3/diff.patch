diff --git a/middleware/etag.go b/middleware/etag.go
new file mode 100644
index 0000000..773f92f
--- /dev/null
+++ b/middleware/etag.go
@@ -0,0 +1,235 @@
+package middleware
+
+import (
+	"bufio"
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"maps"
+	"net"
+	"net/http"
+	"strings"
+)
+
+// ETag buffers the response to GET and HEAD requests. When the handler responds 200 without an
+// ETag header of its own, it sets a strong ETag made from a SHA-256 digest of the body. If the
+// request's If-None-Match matches the response's ETag, it answers 304 Not Modified with no body.
+//
+// Other methods, and responses with a final status other than 200, pass through unchanged. While
+// a 200 is buffered, Flush sends nothing, so ETag is not suited to streaming handlers. NoCache
+// strips If-None-Match from requests, so don't combine it with ETag on the same route. If the
+// handler hijacks the connection after writing, the buffered response is sent as-is, without an
+// ETag or a 304.
+func ETag(next http.Handler) http.Handler {
+	fn := func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet && r.Method != http.MethodHead {
+			next.ServeHTTP(w, r)
+			return
+		}
+		ew := &etagResponseWriter{
+			ResponseWriter: w,
+			head:           r.Method == http.MethodHead,
+			ifNoneMatch:    r.Header.Values("If-None-Match"),
+		}
+		next.ServeHTTP(ew, r)
+		ew.finish()
+	}
+	return http.HandlerFunc(fn)
+}
+
+type etagResponseWriter struct {
+	http.ResponseWriter
+
+	head        bool
+	ifNoneMatch []string
+
+	wroteHeader bool
+	// passthrough is set once a final status other than 200 has been sent, or once the response
+	// has been committed as-is for a hijack.
+	passthrough bool
+	// header is the snapshot of the headers taken when a 200 is committed.
+	header http.Header
+	body   bytes.Buffer
+}
+
+func (ew *etagResponseWriter) WriteHeader(code int) {
+	// Informational responses are sent at once and are not final. 101 is final in net/http.
+	if code >= 100 && code < 200 && code != http.StatusSwitchingProtocols {
+		ew.ResponseWriter.WriteHeader(code)
+		return
+	}
+	if ew.wroteHeader {
+		if ew.passthrough {
+			ew.ResponseWriter.WriteHeader(code) // net/http ignores the superfluous call.
+		}
+		return
+	}
+	ew.wroteHeader = true
+	if code != http.StatusOK {
+		ew.passthrough = true
+		ew.ResponseWriter.WriteHeader(code)
+		return
+	}
+	ew.header = ew.Header().Clone()
+}
+
+func (ew *etagResponseWriter) Write(p []byte) (int, error) {
+	if !ew.wroteHeader {
+		ew.WriteHeader(http.StatusOK)
+	}
+	if ew.passthrough {
+		return ew.ResponseWriter.Write(p)
+	}
+	return ew.body.Write(p)
+}
+
+func (ew *etagResponseWriter) Flush() {
+	if !ew.wroteHeader {
+		ew.WriteHeader(http.StatusOK)
+	}
+	if !ew.passthrough {
+		return
+	}
+	if f, ok := ew.ResponseWriter.(http.Flusher); ok {
+		f.Flush()
+	}
+}
+
+func (ew *etagResponseWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	hj, ok := ew.ResponseWriter.(http.Hijacker)
+	if !ok {
+		return nil, nil, errors.New("chi/middleware: http.Hijacker is unavailable on the writer")
+	}
+	if ew.wroteHeader && !ew.passthrough {
+		// The handler may write more raw bytes to the connection, so a hash of this body would be
+		// a validator for the wrong representation. The buffered 200 is therefore sent as-is,
+		// without an ETag or a 304.
+		h := ew.ResponseWriter.Header()
+		clear(h)
+		maps.Copy(h, ew.header)
+		ew.ResponseWriter.WriteHeader(http.StatusOK)
+		ew.ResponseWriter.Write(ew.body.Bytes())
+		// Hijack would drop the buffered body, so write and flush it here before handing over.
+		if f, ok := ew.ResponseWriter.(http.Flusher); ok {
+			f.Flush()
+		}
+		ew.passthrough = true
+	}
+	conn, rw, err := hj.Hijack()
+	if err == nil {
+		// The connection now belongs to the handler, so finish has nothing left to send.
+		ew.wroteHeader, ew.passthrough = true, true
+	}
+	return conn, rw, err
+}
+
+func (ew *etagResponseWriter) Push(target string, opts *http.PushOptions) error {
+	if ps, ok := ew.ResponseWriter.(http.Pusher); ok {
+		return ps.Push(target, opts)
+	}
+	return errors.New("chi/middleware: http.Pusher is unavailable on the writer")
+}
+
+func (ew *etagResponseWriter) Unwrap() http.ResponseWriter {
+	return ew.ResponseWriter
+}
+
+// finish sends the buffered 200 response, or a 304 when If-None-Match matches its ETag.
+func (ew *etagResponseWriter) finish() {
+	if !ew.wroteHeader {
+		ew.WriteHeader(http.StatusOK)
+	}
+	if ew.passthrough {
+		return
+	}
+
+	// Restore the headers as they were when the 200 was committed.
+	h := ew.ResponseWriter.Header()
+	clear(h)
+	maps.Copy(h, ew.header)
+
+	if h.Get("ETag") == "" && (!ew.head || ew.body.Len() > 0) {
+		h.Set("ETag", etagForBody(ew.body.Bytes()))
+	}
+	for _, line := range ew.ifNoneMatch {
+		if etagListMatches(line, h.Get("ETag")) {
+			writeNotModified(ew.ResponseWriter)
+			return
+		}
+	}
+
+	ew.ResponseWriter.WriteHeader(http.StatusOK)
+	ew.ResponseWriter.Write(ew.body.Bytes())
+}
+
+func etagForBody(body []byte) string {
+	sum := sha256.Sum256(body)
+	return `"` + hex.EncodeToString(sum[:]) + `"`
+}
+
+// writeNotModified mirrors net/http's writeNotModified.
+func writeNotModified(w http.ResponseWriter) {
+	h := w.Header()
+	h.Del("Content-Type")
+	h.Del("Content-Length")
+	h.Del("Content-Encoding")
+	if h.Get("ETag") != "" {
+		h.Del("Last-Modified")
+	}
+	w.WriteHeader(http.StatusNotModified)
+}
+
+// etagListMatches reports whether one If-None-Match line matches etag using the weak comparison
+// of RFC 9110 §13.1.2. Malformed members are skipped up to the next comma.
+func etagListMatches(list, etag string) bool {
+	want, tagRest, ok := cutEntityTag(etag)
+	ok = ok && tagRest == ""
+	for {
+		list = strings.TrimLeft(list, " \t,")
+		if list == "" {
+			return false
+		}
+		star := list[0] == '*'
+		tag, rest, valid := cutEntityTag(list)
+		if star {
+			rest, valid = list[1:], true
+		}
+		rest = strings.TrimLeft(rest, " \t")
+		if valid && (rest == "" || rest[0] == ',') {
+			if star || (ok && tag == want) {
+				return true
+			}
+			list = rest
+			continue
+		}
+		// A malformed member is skipped up to its comma. Junk after a valid tag starts at rest.
+		if valid {
+			list = rest
+		}
+		i := strings.IndexByte(list, ',')
+		if i < 0 {
+			return false
+		}
+		list = list[i:]
+	}
+}
+
+// cutEntityTag splits a weak or strong entity-tag off the front of s. The opaque tag may contain
+// commas, so it is read up to its closing quote rather than split on commas.
+func cutEntityTag(s string) (opaque, rest string, ok bool) {
+	s = strings.TrimPrefix(s, "W/")
+	if s == "" || s[0] != '"' {
+		return "", "", false
+	}
+	for i := 1; i < len(s); i++ {
+		switch c := s[i]; {
+		case c == '"':
+			return s[1:i], s[i+1:], true
+		case c <= ' ' || c == 0x7f:
+			// etagc is %x21 / %x23-7E / obs-text, so controls and space are not allowed.
+			return "", "", false
+		}
+	}
+	return "", "", false
+}
diff --git a/middleware/etag_test.go b/middleware/etag_test.go
new file mode 100644
index 0000000..e905e48
--- /dev/null
+++ b/middleware/etag_test.go
@@ -0,0 +1,807 @@
+package middleware
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"io"
+	"log"
+	"math/rand"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/http/httptrace"
+	"net/textproto"
+	"reflect"
+	"testing"
+	"time"
+
+	"github.com/go-chi/chi/v5"
+)
+
+// etagOf is the strong ETag the middleware must compute for body.
+func etagOf(body string) string {
+	sum := sha256.Sum256([]byte(body))
+	return `"` + hex.EncodeToString(sum[:]) + `"`
+}
+
+// etagRun serves one request into a recorder. Each If-None-Match value is sent as its own header line.
+func etagRun(h http.Handler, method string, inm ...string) *httptest.ResponseRecorder {
+	req := httptest.NewRequest(method, "/", nil)
+	for _, v := range inm {
+		req.Header.Add("If-None-Match", v)
+	}
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, req)
+	return rec
+}
+
+func etagHandler(body string) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte(body))
+	}
+}
+
+// etagHandlerWithETag writes body with a handler-set ETag.
+func etagHandlerWithETag(etag, body string) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("ETag", etag)
+		w.Write([]byte(body))
+	}
+}
+
+type etagHijacker struct {
+	*httptest.ResponseRecorder
+	hijacked bool
+}
+
+func (h *etagHijacker) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	h.hijacked = true
+	return nil, nil, nil
+}
+
+type etagPusher struct {
+	*httptest.ResponseRecorder
+	pushed string
+}
+
+func (p *etagPusher) Push(target string, opts *http.PushOptions) error {
+	p.pushed = target
+	return nil
+}
+
+func TestETagUsableAsRouterMiddleware(t *testing.T) {
+	var _ func(http.Handler) http.Handler = ETag
+
+	r := chi.NewRouter()
+	r.Use(ETag)
+	r.Get("/", etagHandler("hello"))
+	rec := etagRun(r, "GET")
+	assertEqual(t, etagOf("hello"), rec.Result().Header.Get("ETag"))
+	assertEqual(t, "hello", rec.Body.String())
+}
+
+func TestETagGetComputesStrongETag(t *testing.T) {
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("X-Test", "yes")
+		w.Header().Set("Content-Type", "text/plain")
+		w.Write([]byte("hello"))
+	}))
+	rec := etagRun(h, "GET")
+	res := rec.Result()
+	assertEqual(t, http.StatusOK, rec.Code)
+	assertEqual(t, etagOf("hello"), res.Header.Get("ETag"))
+	assertEqual(t, "yes", res.Header.Get("X-Test"))
+	assertEqual(t, "text/plain", res.Header.Get("Content-Type"))
+	assertEqual(t, "hello", rec.Body.String())
+}
+
+func TestETagChunkedWritesMatchSingleWrite(t *testing.T) {
+	chunked := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		for _, p := range []string{"he", "", "l", "lo"} {
+			w.Write([]byte(p))
+		}
+	}))
+	rec := etagRun(chunked, "GET")
+	assertEqual(t, etagOf("hello"), rec.Result().Header.Get("ETag"))
+	assertEqual(t, "hello", rec.Body.String())
+}
+
+func TestETagQuotesAndNonUTF8Body(t *testing.T) {
+	body := "a\"b\xff\xfe"
+	rec := etagRun(ETag(etagHandler(body)), "GET")
+	assertEqual(t, etagOf(body), rec.Result().Header.Get("ETag"))
+	assertEqual(t, body, rec.Body.String())
+}
+
+func TestETagEmptyGetBodyStillGetsETag(t *testing.T) {
+	rec := etagRun(ETag(etagHandler("")), "GET")
+	assertEqual(t, etagOf(""), rec.Result().Header.Get("ETag"))
+
+	explicit := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusOK)
+	}))
+	rec = etagRun(explicit, "GET")
+	assertEqual(t, etagOf(""), rec.Result().Header.Get("ETag"))
+	assertEqual(t, "", rec.Body.String())
+}
+
+func TestETagIdenticalBodiesSameDifferentBodiesDiffer(t *testing.T) {
+	a := etagRun(ETag(etagHandler("a")), "GET").Result().Header.Get("ETag")
+	again := etagRun(ETag(etagHandler("a")), "GET").Result().Header.Get("ETag")
+	b := etagRun(ETag(etagHandler("b")), "GET").Result().Header.Get("ETag")
+	assertEqual(t, a, again)
+	if a == b {
+		t.Fatalf("different bodies gave the same ETag %s", a)
+	}
+}
+
+func TestETagHeadServedByGetHandler(t *testing.T) {
+	r := chi.NewRouter()
+	r.Use(GetHead)
+	r.Use(ETag)
+	r.Get("/hi", etagHandler("hello"))
+	ts := httptest.NewServer(r)
+	defer ts.Close()
+
+	get, _ := etagHTTP(t, ts.URL+"/hi", "GET")
+	head, body := etagHTTP(t, ts.URL+"/hi", "HEAD")
+	assertEqual(t, "", body)
+	assertEqual(t, etagOf("hello"), get.Header.Get("ETag"))
+	assertEqual(t, etagOf("hello"), head.Header.Get("ETag"))
+}
+
+func TestETagHeadEmptyBodyGetsNoETag(t *testing.T) {
+	none := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}))
+	assertEqual(t, "", etagRun(none, "HEAD").Result().Header.Get("ETag"))
+
+	empty := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte{})
+	}))
+	assertEqual(t, "", etagRun(empty, "HEAD").Result().Header.Get("ETag"))
+}
+
+func TestETagHeadHandlerETagUsedForIfNoneMatch(t *testing.T) {
+	h := ETag(etagHandlerWithETag(`"v1"`, ""))
+	rec := etagRun(h, "HEAD", `"v1"`)
+	assertEqual(t, http.StatusNotModified, rec.Code)
+	assertEqual(t, `"v1"`, rec.Result().Header.Get("ETag"))
+
+	rec = etagRun(h, "HEAD", `"v2"`)
+	assertEqual(t, http.StatusOK, rec.Code)
+	assertEqual(t, `"v1"`, rec.Result().Header.Get("ETag"))
+}
+
+func TestETagHandlerETagIsNotReplaced(t *testing.T) {
+	for _, etag := range []string{`W/"abc"`, `"def"`} {
+		rec := etagRun(ETag(etagHandlerWithETag(etag, "hello")), "GET")
+		assertEqual(t, etag, rec.Result().Header.Get("ETag"))
+		assertEqual(t, "hello", rec.Body.String())
+	}
+
+	rec := etagRun(ETag(etagHandlerWithETag(`W/"abc"`, "hello")), "GET", `"abc"`)
+	assertEqual(t, http.StatusNotModified, rec.Code)
+	assertEqual(t, `W/"abc"`, rec.Result().Header.Get("ETag"))
+}
+
+func TestETagNotModifiedHeaders(t *testing.T) {
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Cache-Control", "max-age=60")
+		w.Header().Set("Vary", "Accept")
+		w.Header().Set("Expires", "Wed, 21 Oct 2037 07:28:00 GMT")
+		w.Header().Set("Content-Location", "/other")
+		w.Header().Set("Date", "Mon, 02 Jan 2006 15:04:05 GMT")
+		w.Header().Set("Content-Type", "text/plain")
+		w.Header().Set("Content-Encoding", "gzip")
+		w.Header().Set("Content-Length", "5")
+		w.Header().Set("Last-Modified", "Mon, 02 Jan 2006 15:04:05 GMT")
+		w.Write([]byte("hello"))
+	}))
+	rec := etagRun(h, "GET", etagOf("hello"))
+	res := rec.Result()
+	assertEqual(t, http.StatusNotModified, rec.Code)
+	assertEqual(t, "", rec.Body.String())
+	assertEqual(t, etagOf("hello"), res.Header.Get("ETag"))
+	assertEqual(t, "max-age=60", res.Header.Get("Cache-Control"))
+	assertEqual(t, "Accept", res.Header.Get("Vary"))
+	assertEqual(t, "Wed, 21 Oct 2037 07:28:00 GMT", res.Header.Get("Expires"))
+	assertEqual(t, "/other", res.Header.Get("Content-Location"))
+	assertEqual(t, "Mon, 02 Jan 2006 15:04:05 GMT", res.Header.Get("Date"))
+	for _, k := range []string{"Content-Type", "Content-Length", "Content-Encoding", "Last-Modified"} {
+		if v, ok := res.Header[k]; ok {
+			t.Fatalf("304 kept %s: %v", k, v)
+		}
+	}
+}
+
+func TestETagNotModifiedKeepsLastModifiedWithoutETag(t *testing.T) {
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Last-Modified", "Mon, 02 Jan 2006 15:04:05 GMT")
+	}))
+	rec := etagRun(h, "HEAD", "*")
+	assertEqual(t, http.StatusNotModified, rec.Code)
+	assertEqual(t, "", rec.Result().Header.Get("ETag"))
+	assertEqual(t, "Mon, 02 Jan 2006 15:04:05 GMT", rec.Result().Header.Get("Last-Modified"))
+}
+
+func TestETagNoMatchSendsFullResponse(t *testing.T) {
+	rec := etagRun(ETag(etagHandler("hello")), "GET", `"other"`)
+	assertEqual(t, http.StatusOK, rec.Code)
+	assertEqual(t, etagOf("hello"), rec.Result().Header.Get("ETag"))
+	assertEqual(t, "hello", rec.Body.String())
+}
+
+func TestETagIfNoneMatchWeakComparison(t *testing.T) {
+	strong := ETag(etagHandlerWithETag(`"x"`, "body"))
+	assertEqual(t, http.StatusNotModified, etagRun(strong, "GET", `W/"x"`).Code)
+
+	weak := ETag(etagHandlerWithETag(`W/"x"`, "body"))
+	assertEqual(t, http.StatusNotModified, etagRun(weak, "GET", `"x"`).Code)
+	assertEqual(t, http.StatusNotModified, etagRun(weak, "GET", `W/"x"`).Code)
+}
+
+func TestETagIfNoneMatchListWithWhitespace(t *testing.T) {
+	h := ETag(etagHandlerWithETag(`"x"`, "body"))
+	assertEqual(t, http.StatusNotModified, etagRun(h, "GET", ` "a" ,  W/"b"	,	"x"  `).Code)
+	assertEqual(t, http.StatusNotModified, etagRun(h, "GET", `"a"`, `"x"`).Code)
+}
+
+func TestETagIfNoneMatchStar(t *testing.T) {
+	h := ETag(etagHandler("body"))
+	assertEqual(t, http.StatusNotModified, etagRun(h, "GET", "*").Code)
+
+	empty := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}))
+	assertEqual(t, http.StatusNotModified, etagRun(empty, "HEAD", "*").Code)
+}
+
+func TestETagIfNoneMatchOpaqueTagWithComma(t *testing.T) {
+	h := ETag(etagHandlerWithETag(`"a,b"`, "body"))
+	assertEqual(t, http.StatusNotModified, etagRun(h, "GET", `"a,b"`).Code)
+	assertEqual(t, http.StatusOK, etagRun(h, "GET", `"a"`).Code)
+	assertEqual(t, http.StatusOK, etagRun(h, "GET", `"b"`).Code)
+	assertEqual(t, http.StatusOK, etagRun(h, "GET", `"a", "b"`).Code)
+}
+
+func TestETagIfNoneMatchMalformedMembers(t *testing.T) {
+	h := ETag(etagHandlerWithETag(`"x"`, "body"))
+	cases := []struct {
+		inm  string
+		code int
+	}{
+		{`abc`, http.StatusOK},
+		{`"`, http.StatusOK},
+		{`"x`, http.StatusOK},
+		{`W/abc`, http.StatusOK},
+		{`,,`, http.StatusOK},
+		{`w/"x"`, http.StatusOK},
+		{`" , "x"`, http.StatusNotModified},
+		{`abc, "x"`, http.StatusNotModified},
+		{`"x" junk, "x"`, http.StatusNotModified},
+	}
+	for _, c := range cases {
+		rec := etagRun(h, "GET", c.inm)
+		if rec.Code != c.code {
+			t.Fatalf("If-None-Match %q: got %d want %d", c.inm, rec.Code, c.code)
+		}
+	}
+}
+
+func TestETagMalformedHandlerETagNeverMatches(t *testing.T) {
+	for _, etag := range []string{"x", `"x`} {
+		h := ETag(etagHandlerWithETag(etag, "body"))
+		assertEqual(t, http.StatusOK, etagRun(h, "GET", `"x"`).Code)
+		assertEqual(t, http.StatusOK, etagRun(h, "GET", "x").Code)
+	}
+}
+
+func TestETagIfNoneMatchEmptyHeaderNoMatch(t *testing.T) {
+	rec := etagRun(ETag(etagHandler("body")), "GET", "")
+	assertEqual(t, http.StatusOK, rec.Code)
+	assertEqual(t, "body", rec.Body.String())
+}
+
+func TestETagIfNoneMatchIsCaseSensitive(t *testing.T) {
+	h := ETag(etagHandlerWithETag(`"X"`, "body"))
+	assertEqual(t, http.StatusOK, etagRun(h, "GET", `"x"`).Code)
+}
+
+func TestETagOtherMethodsPassThrough(t *testing.T) {
+	for _, method := range []string{"POST", "PUT", "DELETE", "PATCH", "OPTIONS"} {
+		var got http.ResponseWriter
+		h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			got = w
