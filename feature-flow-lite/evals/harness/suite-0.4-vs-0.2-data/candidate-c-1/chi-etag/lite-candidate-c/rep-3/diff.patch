+// etagHTTP sends one request to a real server and returns the response with its body read.
+func etagHTTP(t *testing.T, url, method string) (*http.Response, string) {
+	req, err := http.NewRequest(method, url, nil)
+	assertNoError(t, err)
+	resp, err := http.DefaultClient.Do(req)
+	assertNoError(t, err)
+	defer resp.Body.Close()
+	body, err := io.ReadAll(resp.Body)
+	assertNoError(t, err)
+	return resp, string(body)
+}
