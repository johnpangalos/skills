+func TestETagInformationalResponseIsForwardedEarly(t *testing.T) {
+	forwarded := make(chan struct{})
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Link", "</style.css>; rel=preload; as=style")
+		w.WriteHeader(http.StatusEarlyHints)
+		select {
+		case <-forwarded:
+		case <-time.After(5 * time.Second):
+			t.Error("103 was not forwarded before the handler went on")
+		}
+		w.WriteHeader(http.StatusOK)
+		w.Write([]byte("hello"))
+	}))
+	ts := httptest.NewServer(h)
+	defer ts.Close()
+
+	var infoCode int
+	var infoLink string
+	trace := &httptrace.ClientTrace{
+		Got1xxResponse: func(code int, header textproto.MIMEHeader) error {
+			infoCode, infoLink = code, header.Get("Link")
+			close(forwarded)
+			return nil
+		},
+	}
+	req, err := http.NewRequestWithContext(httptrace.WithClientTrace(context.Background(), trace), "GET", ts.URL, nil)
+	assertNoError(t, err)
+	resp, err := http.DefaultClient.Do(req)
+	assertNoError(t, err)
+	defer resp.Body.Close()
+
+	assertEqual(t, http.StatusEarlyHints, infoCode)
+	assertEqual(t, "</style.css>; rel=preload; as=style", infoLink)
+	assertEqual(t, http.StatusOK, resp.StatusCode)
+	assertEqual(t, etagOf("hello"), resp.Header.Get("ETag"))
+}
