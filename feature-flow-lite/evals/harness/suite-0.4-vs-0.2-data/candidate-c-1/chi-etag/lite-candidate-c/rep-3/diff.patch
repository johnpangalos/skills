+// Triggered: invariant. A quoted tag matches itself, weakly or strongly, and never a different tag.
+func TestETagPropertyIfNoneMatch(t *testing.T) {
+	rng := rand.New(rand.NewSource(2))
+	tagAlphabet := []byte("ab,!#*W/w")
+	randomTag := func() string {
+		tag := make([]byte, 1+rng.Intn(6))
+		for j := range tag {
+			tag[j] = tagAlphabet[rng.Intn(len(tagAlphabet))]
+		}
+		return string(tag)
+	}
+	for i := 0; i < 1000; i++ {
+		tag := randomTag()
+		other := randomTag() + "x"
+		h := ETag(etagHandlerWithETag(`"`+tag+`"`, "body"))
+		cases := []struct {
+			inm  string
+			code int
+		}{
+			{`"` + tag + `"`, http.StatusNotModified},
+			{`W/"` + tag + `"`, http.StatusNotModified},
+			{`"` + other + `"`, http.StatusOK},
+			{`"` + other + `", "` + tag + `"`, http.StatusNotModified},
+		}
+		for _, c := range cases {
+			if got := etagRun(h, "GET", c.inm).Code; got != c.code {
+				t.Fatalf("first failing input: tag %q If-None-Match %q: got %d want %d", tag, c.inm, got, c.code)
+			}
+		}
+	}
+}
