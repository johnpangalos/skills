+func TestETagHijackBeforeWriteLogsNothing(t *testing.T) {
+	var logs bytes.Buffer
+	done := make(chan struct{})
+	raw := "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nhi"
+	inner := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		conn, buf, err := w.(http.Hijacker).Hijack()
+		if err != nil {
+			t.Error(err)
+			return
+		}
+		buf.WriteString(raw)
+		buf.Flush()
+		conn.Close()
+	})
+	h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		ETag(inner).ServeHTTP(w, r)
+		close(done) // Wait until ETag has finished before reading the log.
+	})
+	srv := httptest.NewUnstartedServer(h)
+	srv.Config.ErrorLog = log.New(&logs, "", 0)
+	srv.Start()
+	defer srv.Close()
+
+	got := etagRawExchange(t, srv)
+	<-done
+	if logs.Len() > 0 {
+		t.Errorf("server logged %q", logs.String())
+	}
+	if string(got) != raw {
+		t.Errorf("raw response mismatch\nwant: %q\n got: %q", raw, got)
+	}
+}
