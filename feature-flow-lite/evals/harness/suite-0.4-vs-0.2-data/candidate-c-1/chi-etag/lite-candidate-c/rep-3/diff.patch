+func TestETagHijackAfterWriteSendsBufferedResponse(t *testing.T) {
+	hijackAfterWrite := func(w http.ResponseWriter, r *http.Request) {
+		w.Header()["Date"] = nil // Suppress the Date header so the raw bytes can be compared.
+		w.Write([]byte("hello"))
+		// Without this Flush, net/http drops a small write on hijack, so the unwrapped handler
+		// needs it to show its body.
+		w.(http.Flusher).Flush()
+		conn, _, err := w.(http.Hijacker).Hijack()
+		if err != nil {
+			t.Error(err)
+			return
+		}
+		conn.Close()
+	}
+	plain := httptest.NewServer(http.HandlerFunc(hijackAfterWrite))
+	defer plain.Close()
+	want := etagRawExchange(t, plain)
+
+	srv := httptest.NewServer(ETag(http.HandlerFunc(hijackAfterWrite)))
+	defer srv.Close()
+	got := etagRawExchange(t, srv)
+
+	if !bytes.Contains(got, []byte("hello")) {
+		t.Fatalf("buffered body was dropped:\n%q", got)
+	}
+	if bytes.Contains(bytes.ToLower(got), []byte("\r\netag:")) {
+		t.Errorf("hijacked 200 carries an ETag header:\n%q", got)
+	}
+	if !bytes.Equal(got, want) {
+		t.Errorf("raw response differs from the unwrapped handler\nwant: %q\n got: %q", want, got)
+	}
+}
