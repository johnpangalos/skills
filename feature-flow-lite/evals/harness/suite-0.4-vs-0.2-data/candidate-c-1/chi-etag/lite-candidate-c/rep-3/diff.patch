+// Triggered: differential. Wrapped and unwrapped handlers run the same random scripts, and every
+// difference must be one of the approved ones: an added ETag on a 200, and nothing else.
+type etagOp struct {
+	kind byte // 'h' header, 'e' handler ETag, 'w' write, 'c' WriteHeader, 'f' flush
+	code int
+	data string
+}
+
+func etagScriptHandler(ops []etagOp, rec *httptest.ResponseRecorder, early *bool) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "text/plain")
+		committed, passthrough := false, false
+		for _, op := range ops {
+			switch op.kind {
+			case 'h':
+				w.Header().Set("X-Op", op.data)
+			case 'e':
+				w.Header().Set("ETag", op.data)
+			case 'w':
+				committed = true
+				w.Write([]byte(op.data))
+			case 'c':
+				if !committed {
+					committed = true
+					passthrough = op.code != http.StatusOK
+				}
+				w.WriteHeader(op.code)
+			case 'f':
+				if !committed {
+					committed = true
+				}
+				http.NewResponseController(w).Flush()
+				if !passthrough && (rec.Flushed || rec.Body.Len() > 0) {
+					*early = true
+				}
+			}
+		}
+	}
+}
+
+func TestETagDifferentialAgainstUnwrapped(t *testing.T) {
+	rng := rand.New(rand.NewSource(4))
+	kinds := []byte("hewcfc")
+	codes := []int{200, 200, 201, 204, 304, 404, 500}
+	etags := []string{`"e1"`, `W/"e1"`, `e2`}
+	methods := []string{"GET", "HEAD", "POST"}
+	for i := 0; i < 1500; i++ {
+		var ops []etagOp
+		for n := rng.Intn(5); n > 0; n-- {
+			op := etagOp{kind: kinds[rng.Intn(len(kinds))], code: codes[rng.Intn(len(codes))]}
+			switch op.kind {
+			case 'h':
+				op.data = fmt.Sprint("v", rng.Intn(3))
+			case 'e':
+				op.data = etags[rng.Intn(len(etags))]
+			case 'w':
+				op.data = []string{"", "a", "bc"}[rng.Intn(3)]
+			}
+			ops = append(ops, op)
+		}
+		method := methods[rng.Intn(len(methods))]
+
+		plain := httptest.NewRecorder()
+		etagScriptHandler(ops, plain, new(bool)).ServeHTTP(plain, httptest.NewRequest(method, "/", nil))
+
+		wrapped := httptest.NewRecorder()
+		var early bool
+		ETag(etagScriptHandler(ops, wrapped, &early)).ServeHTTP(wrapped, httptest.NewRequest(method, "/", nil))
+
+		want, got := plain.Result(), wrapped.Result()
+		body := plain.Body.String()
+		if early && method != "POST" {
+			t.Fatalf("first failing input: %v %s: Flush sent bytes while buffering", ops, method)
+		}
+		if want.StatusCode != got.StatusCode || body != wrapped.Body.String() {
+			t.Fatalf("first failing input: %v %s: status %d vs %d, body %q vs %q",
+				ops, method, want.StatusCode, got.StatusCode, body, wrapped.Body.String())
+		}
+		gotHeader := got.Header.Clone()
+		if want.Header.Get("ETag") == "" {
+			added := method != "POST" && got.StatusCode == http.StatusOK && (method == "GET" || body != "")
+			if added && gotHeader.Get("ETag") != etagOf(body) {
+				t.Fatalf("first failing input: %v %s: ETag %q, want %s", ops, method, gotHeader.Get("ETag"), etagOf(body))
+			}
+			if !added && gotHeader.Get("ETag") != "" {
+				t.Fatalf("first failing input: %v %s: unexpected ETag %q", ops, method, gotHeader.Get("ETag"))
+			}
+			gotHeader.Del("ETag")
+		}
+		if !reflect.DeepEqual(want.Header, gotHeader) {
+			t.Fatalf("first failing input: %v %s: headers %v vs %v", ops, method, want.Header, gotHeader)
+		}
+	}
+}
