+// Triggered: invariant. For any body split into any chunks, the ETag and body are those of the whole body.
+func TestETagPropertyChunksMatchWholeBody(t *testing.T) {
+	rng := rand.New(rand.NewSource(1))
+	alphabet := []byte("ab\"\xff\x00 ,")
+	for i := 0; i < 1000; i++ {
+		body := make([]byte, rng.Intn(40))
+		for j := range body {
+			body[j] = alphabet[rng.Intn(len(alphabet))]
+		}
+		var chunks [][]byte
+		for rest := body; len(rest) > 0; {
+			n := 1 + rng.Intn(len(rest))
+			chunks = append(chunks, rest[:n])
+			rest = rest[n:]
+		}
+		h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			for _, c := range chunks {
+				w.Write(c)
+			}
+		}))
+		rec := etagRun(h, "GET")
+		got := rec.Result().Header.Get("ETag")
+		if got != etagOf(string(body)) || rec.Body.String() != string(body) {
+			t.Fatalf("first failing input: body %q chunks %q: ETag %s, body %q", body, chunks, got, rec.Body.String())
+		}
+	}
+}
