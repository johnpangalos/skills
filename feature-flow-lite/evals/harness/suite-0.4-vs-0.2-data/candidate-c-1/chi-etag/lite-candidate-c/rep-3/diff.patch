+// etagRawExchange sends one GET over a plain TCP connection and returns every byte the server
+// wrote before it closed the connection.
+func etagRawExchange(t *testing.T, srv *httptest.Server) []byte {
+	t.Helper()
+	conn, err := net.Dial("tcp", srv.Listener.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	assertNoError(t, conn.SetDeadline(time.Now().Add(5*time.Second)))
+	fmt.Fprint(conn, "GET / HTTP/1.1\r\nHost: example.com\r\n\r\n")
+	raw, err := io.ReadAll(conn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return raw
+}
