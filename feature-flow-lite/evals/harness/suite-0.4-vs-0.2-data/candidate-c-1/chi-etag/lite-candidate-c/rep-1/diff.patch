+func TestETagInformationalStatusForwarded(t *testing.T) {
+	hinted := make(chan struct{})
+	r := chi.NewRouter()
+	r.Use(ETag)
+	var forwarded bool
+	r.Get("/", func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Link", "</style.css>; rel=preload")
+		w.WriteHeader(http.StatusEarlyHints)
+		select {
+		case <-hinted:
+			forwarded = true
+		case <-time.After(5 * time.Second):
+		}
+		w.Write([]byte("body"))
+	})
+	ts := httptest.NewServer(r)
+	defer ts.Close()
+
+	trace := &httptrace.ClientTrace{
+		Got1xxResponse: func(code int, header textproto.MIMEHeader) error {
+			if code == http.StatusEarlyHints {
+				close(hinted)
+			}
+			return nil
+		},
+	}
+	req, err := http.NewRequest("GET", ts.URL+"/", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	req = req.WithContext(httptrace.WithClientTrace(req.Context(), trace))
+	resp, err := http.DefaultClient.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+	body, _ := io.ReadAll(resp.Body)
+	if !forwarded {
+		t.Fatal("103 was not forwarded before the handler continued")
+	}
+	if resp.StatusCode != 200 || string(body) != "body" || resp.Header.Get("ETag") != etagOf("body") {
+		t.Fatalf("final status %d body %q ETag %q", resp.StatusCode, body, resp.Header.Get("ETag"))
+	}
