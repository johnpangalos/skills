+// Trailers declared in the Trailer header, or written with http.TrailerPrefix,
+// reach the client as trailers, as they do without the middleware.
+// etagWire sends a raw HTTP/1.1 request to h and returns the response bytes
+// with the Date and ETag lines removed. The ETag line is an approved
+// difference, so the rest of the wire output is compared.
+func etagWire(t *testing.T, h http.Handler, method string) string {
+	t.Helper()
+	ts := httptest.NewServer(h)
+	defer ts.Close()
+	conn, err := net.Dial("tcp", ts.Listener.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	fmt.Fprintf(conn, "%s / HTTP/1.1\r\nHost: example\r\nConnection: close\r\n\r\n", method)
+	out, err := io.ReadAll(conn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var kept []string
+	for _, line := range strings.Split(string(out), "\r\n") {
+		if !strings.HasPrefix(line, "Date: ") && !strings.HasPrefix(strings.ToLower(line), "etag: ") {
+			kept = append(kept, line)
+		}
+	}
+	return strings.Join(kept, "\r\n")
+}
