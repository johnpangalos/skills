+// TestETagDifferential runs the same handlers with and without ETag and
+// diffs everything except the approved differences.
+func TestETagDifferential(t *testing.T) {
+	scripts := map[string]func(w http.ResponseWriter){
+		"write only":        func(w http.ResponseWriter) { w.Write([]byte("abc")) },
+		"header then write": func(w http.ResponseWriter) { w.Header().Set("X-A", "1"); w.WriteHeader(200); w.Write([]byte("abc")) },
+		"late header":       func(w http.ResponseWriter) { w.Write([]byte("abc")); w.Header().Set("X-Late", "1") },
+		"flush then write":  func(w http.ResponseWriter) { w.Write([]byte("a")); w.(http.Flusher).Flush(); w.Write([]byte("b")) },
+		"flush before write": func(w http.ResponseWriter) {
+			w.(http.Flusher).Flush()
+			w.Header().Set("X-Late", "1")
+			w.Write([]byte("abc"))
+		},
+		"double status":   func(w http.ResponseWriter) { w.WriteHeader(200); w.WriteHeader(500); w.Write([]byte("x")) },
+		"not found":       func(w http.ResponseWriter) { w.Header().Set("X-A", "1"); w.WriteHeader(404); w.Write([]byte("nf")) },
+		"created late":    func(w http.ResponseWriter) { w.WriteHeader(201); w.Write([]byte("c")); w.Header().Set("X-Late", "1") },
+		"no content":      func(w http.ResponseWriter) { w.WriteHeader(204) },
+		"error and flush": func(w http.ResponseWriter) { w.WriteHeader(500); w.Write([]byte("boom")); w.(http.Flusher).Flush() },
+		"empty":           func(w http.ResponseWriter) {},
+	}
+	for name, script := range scripts {
+		plain := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { script(w) }))
+		wrapped := httptest.NewServer(ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { script(w) })))
+		_, getBody := testRequest(t, plain, "GET", "/", nil)
+		for _, method := range []string{"GET", "HEAD", "POST"} {
+			pr, pb := testRequest(t, plain, method, "/", nil)
+			wr, wb := testRequest(t, wrapped, method, "/", nil)
+			label := method + " " + name
+			if pr.StatusCode != wr.StatusCode || pb != wb {
+				t.Errorf("%s: status %d/%d body %q/%q", label, pr.StatusCode, wr.StatusCode, pb, wb)
+			}
+
+			// Framing headers differ when a flushed response becomes chunked on
+			// the plain server; the ETag is checked separately below.
+			etag := wr.Header.Get("ETag")
+			ph, wh := pr.Header.Clone(), wr.Header.Clone()
+			for _, k := range []string{"Date", "Content-Length", "Transfer-Encoding", "Etag"} {
+				ph.Del(k)
+				wh.Del(k)
+			}
+			if name == "flush before write" {
+				// Approved hold: the plain server sends headers at Flush, before
+				// any body exists, so it sniffs no Content-Type. The held
+				// response sends its headers later and sniffs one from the body.
+				ph.Del("Content-Type")
+				wh.Del("Content-Type")
+			}
+			if !reflect.DeepEqual(ph, wh) {
+				t.Errorf("%s: headers %v vs %v", label, ph, wh)
+			}
+
+			// Approved: a computed ETag on GET 200, and on HEAD 200 with a body.
+			wantETag := ""
+			if wr.StatusCode == 200 && (method == "GET" || (method == "HEAD" && getBody != "")) {
+				wantETag = etagOf(getBody)
+			}
+			if etag != wantETag {
+				t.Errorf("%s: ETag %q, want %q", label, etag, wantETag)
+			}
+		}
+		plain.Close()
+		wrapped.Close()
+	}
+}
