+func TestETagNon200PassThrough(t *testing.T) {
+	statuses := []int{201, 204, 206, 301, 404, 500}
+	for _, status := range statuses {
+		for _, etag := range []string{"", `"x"`} {
+			h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("X-Test", "yes")
+				if etag != "" {
+					w.Header().Set("ETag", etag)
+				}
+				w.WriteHeader(status)
+				if status != 204 {
+					w.Write([]byte("body"))
+				}
+			}))
+			req := httptest.NewRequest("GET", "/", nil)
+			req.Header.Set("If-None-Match", "*")
+			rec := httptest.NewRecorder()
+			h.ServeHTTP(rec, req)
+			res := rec.Result()
+			if res.StatusCode != status || res.Header.Get("X-Test") != "yes" {
+				t.Errorf("status %d (etag %q): got %d header %q", status, etag, res.StatusCode, res.Header.Get("X-Test"))
+			}
+			if res.Header.Get("ETag") != etag {
+				t.Errorf("status %d: ETag %q, want %q", status, res.Header.Get("ETag"), etag)
+			}
+			if status != 204 && rec.Body.String() != "body" {
+				t.Errorf("status %d: body %q", status, rec.Body.String())
+			}
+		}
+	}
+
+	// A second WriteHeader does not change the first final status.
+	rec := httptest.NewRecorder()
+	ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(404)
+		w.WriteHeader(200)
+		w.Write([]byte("nf"))
+	})).ServeHTTP(rec, httptest.NewRequest("GET", "/", nil))
+	if rec.Code != 404 {
+		t.Fatalf("second WriteHeader changed status to %d", rec.Code)
+	}
+	rec = httptest.NewRecorder()
+	ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(200)
+		w.WriteHeader(500)
+		w.Write([]byte("ok"))
+	})).ServeHTTP(rec, httptest.NewRequest("GET", "/", nil))
+	if rec.Code != 200 || rec.Body.String() != "ok" {
+		t.Fatalf("buffered 200 then 500: status %d body %q", rec.Code, rec.Body.String())
+	}
+}
