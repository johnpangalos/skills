+// Hijack after a buffered 200 sends the status, headers and body first, as a
+// plain server does, so the raw bytes follow the same response.
+func TestETagHijackAfterBufferedWrite(t *testing.T) {
+	handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("X-Test", "yes")
+		w.Write([]byte("abc"))
+		conn, _, err := w.(http.Hijacker).Hijack()
+		if err != nil {
+			t.Error(err)
+			return
+		}
+		conn.Write([]byte("RAW"))
+		conn.Close()
+	})
+	raw := func(h http.Handler) string {
+		ts := httptest.NewServer(h)
+		defer ts.Close()
+		conn, err := net.Dial("tcp", ts.Listener.Addr().String())
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer conn.Close()
+		fmt.Fprint(conn, "GET / HTTP/1.1\r\nHost: example\r\n\r\n")
+		out, _ := io.ReadAll(conn)
+		// The Date header changes between requests.
+		var kept []string
+		for _, line := range strings.Split(string(out), "\r\n") {
+			if !strings.HasPrefix(line, "Date: ") {
+				kept = append(kept, line)
+			}
+		}
+		return strings.Join(kept, "\r\n")
+	}
+	plain := raw(handler)
+	wrapped := raw(ETag(handler))
+	if wrapped != plain {
+		t.Fatalf("raw response differs:\nplain:   %q\nwrapped: %q", plain, wrapped)
+	}
+}
+
+// Two If-None-Match lines are one list joined with ", ", so the split tag
+// `"a` and `b"` cannot form the tag "a,b".
+func TestETagSplitIfNoneMatchLines(t *testing.T) {
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("ETag", `"a,b"`)
+		w.Write([]byte("x"))
+	}))
+	req := httptest.NewRequest("GET", "/", nil)
+	req.Header.Add("If-None-Match", `"a`)
+	req.Header.Add("If-None-Match", `b"`)
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, req)
+	if rec.Code != 200 || rec.Body.String() != "x" {
+		t.Fatalf("split lines matched a malformed member: status %d body %q", rec.Code, rec.Body.String())
+	}
+}
