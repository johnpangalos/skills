+// TestETagProperties uses 2000 seeded random inputs.
+func TestETagProperties(t *testing.T) {
+	rng := rand.New(rand.NewSource(1))
+	for i := 0; i < 2000; i++ {
+		body := make([]byte, rng.Intn(300))
+		rng.Read(body)
+		method := []string{"GET", "HEAD"}[rng.Intn(2)]
+
+		var chunks [][]byte
+		for rest := body; len(rest) > 0; {
+			n := 1 + rng.Intn(len(rest))
+			chunks = append(chunks, rest[:n])
+			rest = rest[n:]
+		}
+		h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			for _, c := range chunks {
+				w.Write(c)
+			}
+		})
+
+		rec := httptest.NewRecorder()
+		ETag(h).ServeHTTP(rec, httptest.NewRequest(method, "/", nil))
+		want := ""
+		if method == "GET" || len(body) > 0 {
+			want = etagOf(string(body))
+		}
+		if got := rec.Result().Header.Get("ETag"); got != want {
+			t.Fatalf("input %d (%s, body %x): ETag %q, want %q", i, method, body, got, want)
+		}
+		if !bytes.Equal(rec.Body.Bytes(), body) {
+			t.Fatalf("input %d (%s, body %x): body %x", i, method, body, rec.Body.Bytes())
+		}
+
+		// Idempotent: wrapping twice gives the same response as once.
+		twice := httptest.NewRecorder()
+		ETag(ETag(h)).ServeHTTP(twice, httptest.NewRequest(method, "/", nil))
+		if got := twice.Result().Header.Get("ETag"); got != want || !bytes.Equal(twice.Body.Bytes(), body) {
+			t.Fatalf("input %d (%s, body %x): double wrap ETag %q, want %q", i, method, body, got, want)
+		}
+	}
+
+	// Round trip: random lists of valid tags with random separators and
+	// malformed tails match exactly when a valid tag weakly equals the ETag.
+	pool := []string{`"a"`, `"b"`, `"a,b"`, `"ABC"`, `"abc"`, `""`}
+	seps := []string{",", " ,", ", ", " , "}
+	tails := []string{"", ", foo", `, "unterminated`, ", W/", ",,,"}
+	etags := append([]string{`abc`, `W/abc`}, pool...)
+	for i := 0; i < 2000; i++ {
+		etag := etags[rng.Intn(len(etags))]
+		expected := false
+		var list strings.Builder
+		for n := rng.Intn(4); n > 0; n-- {
+			tok := pool[rng.Intn(len(pool))]
+			if rng.Intn(2) == 0 {
+				tok = "W/" + tok
+			}
+			if strings.TrimPrefix(tok, "W/") == strings.TrimPrefix(etag, "W/") {
+				expected = true
+			}
+			if list.Len() > 0 {
+				list.WriteString(seps[rng.Intn(len(seps))])
+			}
+			list.WriteString(tok)
+		}
+		if rng.Intn(4) == 0 {
+			if list.Len() > 0 {
+				list.WriteString(seps[0])
+			}
+			list.WriteString("*")
+			expected = true
+		}
+		list.WriteString(tails[rng.Intn(len(tails))])
+		if got := ifNoneMatchMatches(list.String(), etag); got != expected {
+			t.Fatalf("input %d: If-None-Match %q against %q = %v, want %v", i, list.String(), etag, got, expected)
+		}
+	}
+}
