+// Trailers and the header block must match a plain server on the wire, so a
+// declared trailer is not also sent as a header.
+func TestETagTrailersReachClient(t *testing.T) {
+	cases := map[string]struct {
+		method  string
+		handler http.HandlerFunc
+	}{
+		"declared trailer set after write": {"GET", func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Trailer", "X-Sum")
+			w.Write([]byte("v"))
+			w.Header().Set("X-Sum", "v")
+		}},
+		"trailer prefix key set after write": {"GET", func(w http.ResponseWriter, r *http.Request) {
+			w.Write([]byte("v"))
+			w.Header().Set(http.TrailerPrefix+"X-Foo", "bar")
+		}},
+		"HEAD with declared trailer": {"HEAD", func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Trailer", "X-Sum")
+			w.Write([]byte("v"))
+			w.Header().Set("X-Sum", "v")
+		}},
+	}
+	for name, tc := range cases {
+		plain := etagWire(t, tc.handler, tc.method)
+		wrapped := etagWire(t, ETag(tc.handler), tc.method)
+		if wrapped != plain {
+			t.Errorf("%s: wire output differs\nplain:   %q\nwrapped: %q", name, plain, wrapped)
+		}
+	}
+}
