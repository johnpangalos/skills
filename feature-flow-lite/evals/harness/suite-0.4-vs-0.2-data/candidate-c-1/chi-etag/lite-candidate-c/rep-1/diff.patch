diff --git a/middleware/etag.go b/middleware/etag.go
new file mode 100644
index 0000000..81caebf
--- /dev/null
+++ b/middleware/etag.go
@@ -0,0 +1,237 @@
+package middleware
+
+import (
+	"bufio"
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"maps"
+	"net"
+	"net/http"
+	"net/textproto"
+	"strings"
+)
+
+// ETag is a middleware that adds a strong ETag, computed from the full body,
+// to GET and HEAD responses with a 200 status that don't set their own ETag.
+// If the request's If-None-Match matches the response's ETag (computed or set
+// by the handler), the response is replaced with 304 Not Modified.
+//
+// GET and HEAD responses with a 200 status are buffered until the handler
+// returns, so the ETag covers the bytes actually sent. While buffering, Flush
+// is a no-op and sends nothing to the client. Once a non-200 status is written,
+// the response streams through unchanged and Flush is forwarded. Other methods
+// pass through untouched.
+//
+// Register ETag before (outside of) Compress so the ETag is computed over the
+// bytes actually sent, after compression.
+func ETag(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet && r.Method != http.MethodHead {
+			next.ServeHTTP(w, r)
+			return
+		}
+		ew := &etagResponseWriter{
+			ResponseWriter: w,
+			method:         r.Method,
+			ifNoneMatch:    strings.Join(r.Header.Values("If-None-Match"), ", "),
+		}
+		next.ServeHTTP(ew, r)
+		ew.finish()
+	})
+}
+
+type etagResponseWriter struct {
+	http.ResponseWriter
+
+	method      string
+	ifNoneMatch string
+	// header is the copy of the headers taken when the 200 status is
+	// committed. Headers set after that are dropped, as net/http drops them.
+	header      http.Header
+	buf         bytes.Buffer
+	wroteHeader bool
+	passthrough bool
+}
+
+func (ew *etagResponseWriter) WriteHeader(code int) {
+	// Informational responses go out now and are not the final status.
+	if code >= 100 && code <= 199 && code != http.StatusSwitchingProtocols {
+		ew.ResponseWriter.WriteHeader(code)
+		return
+	}
+	if ew.wroteHeader {
+		return
+	}
+	ew.wroteHeader = true
+	if code != http.StatusOK {
+		ew.passthrough = true
+		ew.ResponseWriter.WriteHeader(code)
+		return
+	}
+	ew.header = ew.Header().Clone()
+}
+
+func (ew *etagResponseWriter) Write(p []byte) (int, error) {
+	if !ew.wroteHeader {
+		ew.WriteHeader(http.StatusOK)
+	}
+	if ew.passthrough {
+		return ew.ResponseWriter.Write(p)
+	}
+	return ew.buf.Write(p)
+}
+
+func (ew *etagResponseWriter) Flush() {
+	if !ew.wroteHeader {
+		ew.WriteHeader(http.StatusOK)
+	}
+	if !ew.passthrough {
+		return
+	}
+	if f, ok := ew.ResponseWriter.(http.Flusher); ok {
+		f.Flush()
+	}
+}
+
+func (ew *etagResponseWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	hj, ok := ew.ResponseWriter.(http.Hijacker)
+	if !ok {
+		return nil, nil, errors.New("chi/middleware: http.Hijacker is unavailable on the writer")
+	}
+	// A buffered 200 goes to the underlying writer first, so the client gets
+	// the status and headers before the handler's raw bytes, as a plain server
+	// sends them.
+	if ew.wroteHeader && !ew.passthrough {
+		ew.restoreHeader()
+		ew.ResponseWriter.WriteHeader(http.StatusOK)
+		ew.ResponseWriter.Write(ew.buf.Bytes())
+	}
+	// The handler owns the connection now, so nothing may be buffered out.
+	ew.passthrough = true
+	return hj.Hijack()
+}
+
+func (ew *etagResponseWriter) Push(target string, opts *http.PushOptions) error {
+	if ps, ok := ew.ResponseWriter.(http.Pusher); ok {
+		return ps.Push(target, opts)
+	}
+	return errors.New("chi/middleware: http.Pusher is unavailable on the writer")
+}
+
+func (ew *etagResponseWriter) Unwrap() http.ResponseWriter {
+	return ew.ResponseWriter
+}
+
+// finish sends the buffered response. It is not deferred, so a panicking
+// handler writes nothing.
+func (ew *etagResponseWriter) finish() {
+	if ew.passthrough {
+		return
+	}
+	if !ew.wroteHeader {
+		ew.WriteHeader(http.StatusOK)
+	}
+
+	trailers := ew.trailerValues()
+	h := ew.restoreHeader()
+	body := ew.buf.Bytes()
+	if h.Get("ETag") == "" && (ew.method == http.MethodGet || len(body) > 0) {
+		sum := sha256.Sum256(body)
+		h.Set("ETag", `"`+hex.EncodeToString(sum[:])+`"`)
+	}
+
+	if ifNoneMatchMatches(ew.ifNoneMatch, h.Get("ETag")) {
+		h.Del("Content-Type")
+		h.Del("Content-Length")
+		h.Del("Content-Encoding")
+		ew.ResponseWriter.WriteHeader(http.StatusNotModified)
+		return
+	}
+	ew.ResponseWriter.WriteHeader(http.StatusOK)
+	ew.ResponseWriter.Write(body)
+	// net/http reads trailer values when the handler returns. Copying them in
+	// after the header block is committed keeps them out of the headers, as a
+	// plain handler does.
+	maps.Copy(ew.ResponseWriter.Header(), trailers)
+}
+
+// restoreHeader replaces the live headers with the copy taken when the 200
+// status was committed, so headers set later are dropped as net/http drops them.
+func (ew *etagResponseWriter) restoreHeader() http.Header {
+	h := ew.ResponseWriter.Header()
+	clear(h)
+	maps.Copy(h, ew.header)
+	return h
+}
+
+// trailerValues returns the live values of the trailers the handler declared in
+// the Trailer header, and of the keys written with http.TrailerPrefix.
+func (ew *etagResponseWriter) trailerValues() http.Header {
+	live := ew.ResponseWriter.Header()
+	trailers := make(http.Header)
+	for _, v := range ew.header.Values("Trailer") {
+		for _, k := range strings.Split(v, ",") {
+			k = textproto.CanonicalMIMEHeaderKey(strings.TrimSpace(k))
+			if vv, ok := live[k]; ok {
+				trailers[k] = vv
+			}
+		}
+	}
+	for k, vv := range live {
+		if strings.HasPrefix(k, http.TrailerPrefix) {
+			trailers[k] = vv
+		}
+	}
+	return trailers
+}
+
+// ifNoneMatchMatches reports whether the If-None-Match list matches etag under
+// weak comparison (RFC 9110 13.1.2). It follows the scan rules of net/http's
+// checkIfNoneMatch: a malformed member ends the scan with no match.
+func ifNoneMatchMatches(list, etag string) bool {
+	for {
+		list = strings.Trim(list, " \t")
+		switch {
+		case list == "":
+			return false
+		case list[0] == ',':
+			list = list[1:]
+		case list[0] == '*':
+			return true
+		default:
+			tag, rest := scanETag(list)
+			if tag == "" {
+				return false
+			}
+			if strings.TrimPrefix(tag, "W/") == strings.TrimPrefix(etag, "W/") {
+				return true
+			}
+			list = rest
+		}
+	}
+}
+
+// scanETag splits the entity-tag at the start of s from the text after it.
+// It returns an empty tag if s does not start with a valid one.
+func scanETag(s string) (tag, rest string) {
+	start := 0
+	if strings.HasPrefix(s, "W/") {
+		start = 2
+	}
+	if len(s) < start+2 || s[start] != '"' {
+		return "", ""
+	}
+	for i := start + 1; i < len(s); i++ {
+		c := s[i]
+		switch {
+		case c == 0x21 || c >= 0x23 && c <= 0x7E || c >= 0x80:
+		case c == '"':
+			return s[:i+1], s[i+1:]
+		default:
+			return "", ""
+		}
+	}
+	return "", ""
+}
diff --git a/middleware/etag_test.go b/middleware/etag_test.go
new file mode 100644
index 0000000..be39ca0
--- /dev/null
+++ b/middleware/etag_test.go
@@ -0,0 +1,869 @@
+package middleware
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"io"
+	"math/rand"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/http/httptrace"
+	"net/textproto"
+	"reflect"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/go-chi/chi/v5"
+)
+
+// etagOf is the independent expectation for a computed ETag.
+func etagOf(body string) string {
+	sum := sha256.Sum256([]byte(body))
+	return `"` + hex.EncodeToString(sum[:]) + `"`
+}
+
+// etagSpyWriter counts the calls that reach the underlying writer.
+type etagSpyWriter struct {
+	*httptest.ResponseRecorder
+	calls int
+}
+
+func (s *etagSpyWriter) WriteHeader(code int) {
+	s.calls++
+	s.ResponseRecorder.WriteHeader(code)
+}
+
+func (s *etagSpyWriter) Write(p []byte) (int, error) {
+	s.calls++
+	return s.ResponseRecorder.Write(p)
+}
+
+// etagProbeFlush writes "partial", calls Flush, then blocks until the test
+// releases the handler. It reports whether the client saw response headers
+// before the release.
+func etagProbeFlush(t *testing.T, status int) bool {
+	t.Helper()
+	flushed := make(chan struct{})
+	release := make(chan struct{})
+	releaseOnce := sync.OnceFunc(func() { close(release) })
+
+	r := chi.NewRouter()
+	r.Use(ETag)
+	r.Get("/", func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(status)
+		w.Write([]byte("partial"))
+		w.(http.Flusher).Flush()
+		close(flushed)
+		<-release
+		w.Write([]byte("rest"))
+	})
+	ts := httptest.NewServer(r)
+	defer ts.Close()
+	defer releaseOnce()
+
+	got := make(chan *http.Response, 1)
+	go func() {
+		resp, err := http.Get(ts.URL + "/")
+		if err != nil {
+			t.Error(err)
+			got <- nil
+			return
+		}
+		got <- resp
+	}()
+
+	<-flushed
+	var resp *http.Response
+	var early bool
+	select {
+	case resp = <-got:
+		early = true
+	case <-time.After(200 * time.Millisecond):
+	}
+	releaseOnce()
+	if resp == nil {
+		resp = <-got
+	}
+	if resp == nil {
+		t.Fatal("request failed")
+	}
+	body, err := io.ReadAll(resp.Body)
+	resp.Body.Close()
+	if err != nil || string(body) != "partialrest" {
+		t.Errorf("body = %q, err = %v; want %q", body, err, "partialrest")
+	}
+	return early
+}
+
+func TestETagComputesStrongETag(t *testing.T) {
+	const body = "hello world"
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("X-Test", "yes")
+		w.WriteHeader(http.StatusOK)
+		w.Write([]byte(body))
+	}))
+
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, httptest.NewRequest("GET", "/", nil))
+	res := rec.Result()
+	if got := res.Header.Get("ETag"); got != etagOf(body) {
+		t.Fatalf("ETag = %q, want %q", got, etagOf(body))
+	}
+	if rec.Body.String() != body || res.Header.Get("X-Test") != "yes" || res.StatusCode != 200 {
+		t.Fatalf("body %q header %q status %d", rec.Body.String(), res.Header.Get("X-Test"), res.StatusCode)
+	}
+
+	// Implicit 200 via Write, same body gives the same ETag.
+	implicit := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte(body))
+	}))
+	rec = httptest.NewRecorder()
+	implicit.ServeHTTP(rec, httptest.NewRequest("GET", "/", nil))
+	if got := rec.Result().Header.Get("ETag"); got != etagOf(body) {
+		t.Fatalf("implicit ETag = %q, want %q", got, etagOf(body))
+	}
+
+	// Different body, different ETag.
+	rec = httptest.NewRecorder()
+	ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("other"))
+	})).ServeHTTP(rec, httptest.NewRequest("GET", "/", nil))
+	if got := rec.Result().Header.Get("ETag"); got == etagOf(body) {
+		t.Fatalf("different bodies share ETag %q", got)
+	}
+}
+
+func TestETagChunkedWritesHashLikeOneWrite(t *testing.T) {
+	big := strings.Repeat("0123456789abcdef", 4096*64) // 4 MiB
+	chunk := 4096
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		for i := 0; i < len(big); i += chunk {
+			w.Write([]byte(big[i : i+chunk]))
+		}
+	}))
+
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, httptest.NewRequest("GET", "/", nil))
+	if got := rec.Result().Header.Get("ETag"); got != etagOf(big) {
+		t.Fatalf("ETag = %q, want %q", got, etagOf(big))
+	}
+	if rec.Body.String() != big {
+		t.Fatalf("body differs: got %d bytes, want %d", rec.Body.Len(), len(big))
+	}
+}
+
+func TestETagEmptyBody(t *testing.T) {
+	cases := map[string]http.HandlerFunc{
+		"explicit 200 no body": func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(http.StatusOK)
+		},
+		"nothing written": func(w http.ResponseWriter, r *http.Request) {},
+	}
+	for name, handler := range cases {
+		rec := httptest.NewRecorder()
+		ETag(handler).ServeHTTP(rec, httptest.NewRequest("GET", "/", nil))
+		res := rec.Result()
+		if res.StatusCode != 200 || res.Header.Get("ETag") != etagOf("") {
+			t.Fatalf("%s: status %d ETag %q, want 200 %q", name, res.StatusCode, res.Header.Get("ETag"), etagOf(""))
+		}
+	}
+}
+
+func TestETagKeepsHandlerETag(t *testing.T) {
+	for _, tag := range []string{`"strong"`, `W/"weak"`, `abc`} {
+		h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("ETag", tag)
+			w.Write([]byte("body"))
+		}))
+		rec := httptest.NewRecorder()
+		h.ServeHTTP(rec, httptest.NewRequest("GET", "/", nil))
+		if got := rec.Result().Header.Get("ETag"); got != tag {
+			t.Fatalf("ETag = %q, want handler value %q", got, tag)
+		}
+	}
+
+	// The malformed tag never matches a real entity-tag, only "*" does.
+	malformed := func(inm string) int {
+		h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("ETag", "abc")
+			w.Write([]byte("body"))
+		}))
+		req := httptest.NewRequest("GET", "/", nil)
+		req.Header.Set("If-None-Match", inm)
+		rec := httptest.NewRecorder()
+		h.ServeHTTP(rec, req)
+		return rec.Code
+	}
+	if code := malformed(`"abc"`); code != 200 {
+		t.Fatalf("quoted If-None-Match matched malformed ETag: %d", code)
+	}
+	if code := malformed(`abc`); code != 200 {
+		t.Fatalf("unquoted If-None-Match matched malformed ETag: %d", code)
+	}
+	if code := malformed(`*`); code != 304 {
+		t.Fatalf("* did not match malformed ETag: %d", code)
+	}
+}
+
+func TestETagHEAD(t *testing.T) {
+	r := chi.NewRouter()
+	r.Use(ETag)
+	r.Use(GetHead)
+	r.Get("/get", func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("bye"))
+	})
+	r.Get("/empty", func(w http.ResponseWriter, r *http.Request) {})
+	r.Head("/head", func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("bye"))
+	})
+	r.Head("/tagged", func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("ETag", `"mine"`)
+	})
+
+	ts := httptest.NewServer(r)
+	defer ts.Close()
+
+	// A GET handler reached through GetHead gets a computed ETag on HEAD.
+	if req, body := testRequest(t, ts, "HEAD", "/get", nil); body != "" || req.Header.Get("ETag") != etagOf("bye") {
+		t.Fatalf("HEAD via GetHead: body %q ETag %q", body, req.Header.Get("ETag"))
+	}
+	if req, _ := testRequest(t, ts, "HEAD", "/head", nil); req.Header.Get("ETag") != etagOf("bye") {
+		t.Fatalf("HEAD ETag = %q, want %q", req.Header.Get("ETag"), etagOf("bye"))
+	}
+	// Empty-body HEAD must not get a validator from the empty body.
+	if req, _ := testRequest(t, ts, "HEAD", "/empty", nil); req.StatusCode != 200 || req.Header.Get("ETag") != "" {
+		t.Fatalf("empty HEAD ETag = %q, want none", req.Header.Get("ETag"))
+	}
+	// Handler-set ETag on an empty HEAD is kept.
+	if req, _ := testRequest(t, ts, "HEAD", "/tagged", nil); req.Header.Get("ETag") != `"mine"` {
+		t.Fatalf("handler ETag on HEAD = %q", req.Header.Get("ETag"))
+	}
+
+	// Handler-set ETag on HEAD is used for matching.
+	rec := httptest.NewRecorder()
+	req := httptest.NewRequest("HEAD", "/tagged", nil)
+	req.Header.Set("If-None-Match", `"mine"`)
+	r.ServeHTTP(rec, req)
+	if rec.Code != 304 || rec.Result().Header.Get("ETag") != `"mine"` {
+		t.Fatalf("HEAD If-None-Match: status %d ETag %q, want 304", rec.Code, rec.Result().Header.Get("ETag"))
+	}
+
+	// "*" matches a HEAD 200 with no body and no ETag.
+	rec = httptest.NewRecorder()
+	req = httptest.NewRequest("HEAD", "/empty", nil)
+	req.Header.Set("If-None-Match", "*")
+	r.ServeHTTP(rec, req)
+	if rec.Code != 304 {
+		t.Fatalf("HEAD * status = %d, want 304", rec.Code)
+	}
+}
+
+func TestETagNotModified(t *testing.T) {
+	for _, method := range []string{"GET", "HEAD"} {
+		h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Cache-Control", "max-age=60")
+			w.Header().Set("Vary", "Accept")
+			w.Header().Set("Content-Type", "text/plain")
+			w.Header().Set("Content-Length", "4")
+			w.Header().Set("Content-Encoding", "identity")
+			w.Write([]byte("body"))
+		}))
+		req := httptest.NewRequest(method, "/", nil)
+		req.Header.Set("If-None-Match", etagOf("body"))
+		rec := httptest.NewRecorder()
+		h.ServeHTTP(rec, req)
+
+		res := rec.Result()
+		if res.StatusCode != 304 || rec.Body.Len() != 0 {
+			t.Fatalf("%s: status %d body %q, want 304 empty", method, res.StatusCode, rec.Body.String())
+		}
+		if res.Header.Get("ETag") != etagOf("body") || res.Header.Get("Cache-Control") != "max-age=60" || res.Header.Get("Vary") != "Accept" {
+			t.Fatalf("%s: validators or cache headers dropped: %v", method, res.Header)
+		}
+		for _, name := range []string{"Content-Type", "Content-Length", "Content-Encoding"} {
+			if _, ok := res.Header[name]; ok {
+				t.Fatalf("%s: %s kept on 304", method, name)
+			}
+		}
+	}
+}
+
+func TestETagIfNoneMatch(t *testing.T) {
+	cases := []struct {
+		name string
+		inm  []string
+		etag string // handler-set ETag, empty means computed
+		want int
+	}{
+		{"absent", nil, "", 200},
+		{"weak request vs strong response", []string{`W/"x"`}, `"x"`, 304},
+		{"strong request vs weak response", []string{`"x"`}, `W/"x"`, 304},
+		{"list with whitespace", []string{`"a", "b" ,W/"c"`}, `"c"`, 304},
+		{"list without match", []string{`"a", "b"`}, `"c"`, 200},
+		{"multiple header lines", []string{`"a"`, `"b"`}, `"b"`, 304},
+		{"star matches computed ETag", []string{`*`}, "", 304},
+		{"star matches malformed ETag", []string{`*`}, `abc`, 304},
+		{"comma inside tag matches", []string{`"a,b"`}, `"a,b"`, 304},
+		{"comma tag is not two tags", []string{`"a", "b"`}, `"a,b"`, 200},
+		{"comma tag is not a separator", []string{`"a,b"`}, `"a"`, 200},
+		{"malformed foo", []string{`foo`}, `"x"`, 200},
+		{"malformed unterminated", []string{`"unterminated`}, `"x"`, 200},
+		{"malformed W/", []string{`W/`}, `"x"`, 200},
+		{"empty value", []string{``}, `"x"`, 200},
+		{"commas only", []string{`,,,`}, `"x"`, 200},
+		{"scan stops at malformed", []string{`foo, "x"`}, `"x"`, 200},
+		{"match before malformed", []string{`"x", foo`}, `"x"`, 304},
+		{"case sensitive", []string{`"ABC"`}, `"abc"`, 200},
+		{"lowercase w/ is not weak", []string{`w/"x"`}, `"x"`, 200},
+		{"malformed request tag", []string{`abc`}, `"x"`, 200},
+	}
+	for _, tc := range cases {
+		h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			if tc.etag != "" {
+				w.Header().Set("ETag", tc.etag)
+			}
+			w.Write([]byte("x"))
+		}))
+		req := httptest.NewRequest("GET", "/", nil)
+		for _, v := range tc.inm {
+			req.Header.Add("If-None-Match", v)
+		}
+		rec := httptest.NewRecorder()
+		h.ServeHTTP(rec, req)
+		if rec.Code != tc.want {
+			t.Errorf("%s: status %d, want %d", tc.name, rec.Code, tc.want)
+		}
+		if tc.want == 200 && (rec.Body.String() != "x" || rec.Result().Header.Get("ETag") == "") {
+			t.Errorf("%s: 200 without body or ETag: %q %q", tc.name, rec.Body.String(), rec.Result().Header.Get("ETag"))
+		}
+	}
+}
