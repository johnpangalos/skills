+	row1 := strings.Index(readme, "\n| [CleanPath]")
+	row2 := strings.Index(readme, "\n| [ETag]")
+	row3 := strings.Index(readme, "\n| [GetHead]")
+	if !(0 <= row1 && row1 < row2 && row2 < row3) {
+		t.Fatalf("[ETag] row should sit between [CleanPath] and [GetHead] in the table")
+	}
+
+	link1 := strings.Index(readme, "\n[CleanPath]: ")
+	link2 := strings.Index(readme, "\n[ETag]: https://pkg.go.dev/github.com/go-chi/chi/v5/middleware#ETag\n")
+	link3 := strings.Index(readme, "\n[GetHead]: ")
+	if !(0 <= link1 && link1 < link2 && link2 < link3) {
+		t.Fatalf("[ETag] link should sit between [CleanPath] and [GetHead] links")
+	}
+}
+
+// Property test: seeded random inputs, first failing input is reported.
+func TestETagPropertyRandomized(t *testing.T) {
+	rnd := rand.New(rand.NewSource(1))
+	opaqueChars := []string{"a", "b", ",", "A", "0"}
+	malformed := []string{"abc", `"unterminated`, `w/"a"`, `W/ "a"`, `"a b"`, `"a"x`}
+	randomOpaque := func() string {
+		var s string
+		for n := rnd.Intn(4); n > 0; n-- {
+			s += opaqueChars[rnd.Intn(len(opaqueChars))]
+		}
+		return s
+	}
+	seen := map[string]string{}
+
+	for i := 0; i < 2000; i++ {
+		// Chunked writes of a random body give the same tag as one write.
+		body := make([]byte, rnd.Intn(300))
+		for j := range body {
+			body[j] = byte(rnd.Intn(256))
+		}
+		chunked := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			for rest := body; len(rest) > 0; {
+				n := 1 + rnd.Intn(len(rest))
+				w.Write(rest[:n])
+				rest = rest[n:]
+			}
+		}))
+		got := etagRecord(chunked, "GET", nil).Header().Get("ETag")
+		if want := etagFor(string(body)); got != want {
+			t.Fatalf("iteration %d: body %q chunked ETag %q, want %q", i, body, got, want)
+		}
+		if prev, ok := seen[got]; ok && prev != string(body) {
+			t.Fatalf("iteration %d: bodies %q and %q share tag %q", i, prev, body, got)
+		}
+		seen[got] = string(body)
+
+		// A random If-None-Match list matches iff some valid member weak-equals the tag.
+		tag := randomOpaque()
+		want := false
+		var members []string
+		for k := 1 + rnd.Intn(4); k > 0; k-- {
+			if rnd.Intn(3) == 0 {
+				members = append(members, malformed[rnd.Intn(len(malformed))])
+				continue
+			}
+			opaque := randomOpaque()
+			member := `"` + opaque + `"`
+			if rnd.Intn(2) == 0 {
+				member = "W/" + member
+			}
+			members = append(members, member)
+			if opaque == tag {
+				want = true
+			}
+		}
+		var lines []string
+		var line string
+		for _, m := range members {
+			if line != "" && rnd.Intn(3) == 0 {
+				lines = append(lines, line)
+				line = ""
+			}
+			if line != "" {
+				line += []string{",", " ,", ", ", " ,\t "}[rnd.Intn(4)]
+			}
+			line += m
+		}
+		lines = append(lines, line)
+
+		etagHeader := `"` + tag + `"`
+		if rnd.Intn(2) == 0 {
+			etagHeader = "W/" + etagHeader
+		}
+		handler := etagStatus(http.StatusOK, "x", etagHeader)
+		rec := etagRecord(ETag(handler), "GET", inm(lines...))
+		wantCode := http.StatusOK
+		if want {
+			wantCode = http.StatusNotModified
+		}
+		if rec.Code != wantCode {
+			t.Fatalf("iteration %d: If-None-Match %q against ETag %q: got %d, want %d", i, lines, etagHeader, rec.Code, wantCode)
+		}
+	}
+}
+
+// etagDiffEvent is one call that reached the raw ResponseWriter.
+type etagDiffEvent struct {
+	phase int    // handler ops completed when the call happened
+	call  string // "info 103", "code 200", "write:abc", "flush", "hijack", "push /p", "superfluous"
+}
+
+// etagDiffSpy is a recorder that logs every raw call, with net/http's rules for
+// superfluous and informational status codes.
+type etagDiffSpy struct {
+	*httptest.ResponseRecorder
+	phase    *int
+	events   []etagDiffEvent
+	wrote    bool
+	hijacked bool
+}
+
+func (s *etagDiffSpy) log(call string) {
+	s.events = append(s.events, etagDiffEvent{*s.phase, call})
+}
+
+func (s *etagDiffSpy) WriteHeader(code int) {
+	if s.wrote || s.hijacked {
+		s.log("superfluous")
+		return
+	}
+	if code >= 100 && code <= 199 && code != http.StatusSwitchingProtocols {
+		s.log(fmt.Sprintf("info %d", code))
+		return
+	}
+	s.wrote = true
+	s.log(fmt.Sprintf("code %d", code))
+	s.ResponseRecorder.WriteHeader(code)
+}
+
+func (s *etagDiffSpy) Write(p []byte) (int, error) {
+	if s.hijacked {
+		return 0, http.ErrHijacked
+	}
+	if !s.wrote {
+		s.WriteHeader(http.StatusOK)
+	}
+	s.log("write:" + string(p))
+	return s.ResponseRecorder.Write(p)
+}
+
+func (s *etagDiffSpy) Flush() {
+	if !s.wrote {
+		s.WriteHeader(http.StatusOK)
+	}
+	s.log("flush")
+	s.ResponseRecorder.Flush()
+}
+
+func (s *etagDiffSpy) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	s.log("hijack")
+	if s.hijacked {
+		return nil, nil, errors.New("already hijacked")
+	}
+	s.hijacked = true
+	c, _ := net.Pipe()
+	return c, nil, nil
+}
+
+func (s *etagDiffSpy) Push(target string, _ *http.PushOptions) error {
+	s.log("push " + target)
+	return nil
+}
+
+// etagDiffOp runs one scripted handler step and returns what it observed.
+func etagDiffOp(w http.ResponseWriter, i int, op string) string {
+	switch op {
+	case "103", "200", "404":
+		code, _ := strconv.Atoi(op)
+		w.WriteHeader(code)
+		return "code " + op
+	case "write":
+		n, err := w.Write([]byte("w" + strconv.Itoa(i)))
+		return fmt.Sprintf("write %d %v", n, err)
+	case "flush":
+		w.(http.Flusher).Flush()
+		return "flush"
+	case "hijack":
+		_, _, err := w.(http.Hijacker).Hijack()
+		return fmt.Sprintf("hijack %v", err)
+	case "push":
+		return fmt.Sprintf("push %v", w.(http.Pusher).Push("/p", nil))
+	case "late":
+		w.Header().Set("X-Late", "1")
+		return "late"
+	case "etag":
+		w.Header().Set("ETag", `"h"`)
+		return "etag"
+	}
+	panic("unknown op " + op)
+}
+
+// etagDiffRun runs a scripted handler directly (wrap=false) or behind ETag.
+func etagDiffRun(wrap bool, method string, ops []string) (log []string, spy *etagDiffSpy) {
+	phase := 0
+	spy = &etagDiffSpy{ResponseRecorder: httptest.NewRecorder(), phase: &phase}
+	var h http.Handler = http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		for i, op := range ops {
+			log = append(log, etagDiffOp(w, i, op))
+			phase = i + 1
+		}
+	})
+	if wrap {
+		h = ETag(h)
+	}
+	h.ServeHTTP(spy, httptest.NewRequest(method, "/", nil))
+	if !spy.wrote && !spy.hijacked {
+		// net/http sends an implicit 200 when the handler returns without a status.
+		spy.WriteHeader(http.StatusOK)
+	}
+	return log, spy
+}
+
+// etagDiffCalls normalizes raw calls: flushes, superfluous calls and empty writes
+// are dropped and adjacent writes merged. With skipPush, pushes are left out.
+func etagDiffCalls(events []etagDiffEvent, skipPush bool) []string {
+	var calls []string
+	for _, e := range events {
+		switch {
+		case e.call == "flush" || e.call == "superfluous" || e.call == "write:":
+		case skipPush && strings.HasPrefix(e.call, "push "):
+		case strings.HasPrefix(e.call, "write:") && len(calls) > 0 && strings.HasPrefix(calls[len(calls)-1], "write:"):
+			calls[len(calls)-1] += e.call[len("write:"):]
+		default:
+			calls = append(calls, e.call)
+		}
+	}
+	return calls
+}
+
+func etagDiffPushes(events []etagDiffEvent) []string {
+	var pushes []string
+	for _, e := range events {
+		if strings.HasPrefix(e.call, "push ") {
+			pushes = append(pushes, e.call)
+		}
+	}
+	return pushes
+}
+
+// etagDiffBuffered reports whether the native run ends with a 200 that ETag holds back.
+func etagDiffBuffered(events []etagDiffEvent) bool {
+	for _, e := range events {
+		if strings.HasPrefix(e.call, "code ") {
+			return e.call == "code 200"
+		}
+	}
+	return true
+}
+
+func TestETagDifferential(t *testing.T) {
+	alphabet := []string{"103", "200", "404", "write", "flush", "hijack", "push", "late", "etag"}
+	var scenarios [][]string
+	var build func(prefix []string)
+	build = func(prefix []string) {
+		if len(prefix) == 3 {
+			return
+		}
+		for _, op := range alphabet {
+			next := append(slices.Clone(prefix), op)
+			scenarios = append(scenarios, next)
+			build(next)
+		}
+	}
+	build(nil)
+
+	for _, method := range []string{"GET", "HEAD", "POST"} {
+		for _, ops := range scenarios {
+			t.Run(method+" "+strings.Join(ops, ","), func(t *testing.T) {
+				nativeLog, native := etagDiffRun(false, method, ops)
+				wrapLog, wrapped := etagDiffRun(true, method, ops)
+				if !slices.Equal(nativeLog, wrapLog) {
+					t.Fatalf("handler results differ\nnative  %q\nwrapped %q", nativeLog, wrapLog)
+				}
+
+				hasHijack := slices.Contains(ops, "hijack")
+				if hasHijack {
+					// Hijack releases the held response, so compare only the raw calls.
+					want := etagDiffCalls(native.events, true)
+					got := etagDiffCalls(wrapped.events, true)
+					if !slices.Equal(got, want) {
+						t.Fatalf("raw calls differ\nnative  %q\nwrapped %q", want, got)
+					}
+					return
+				}
+
+				if method == "POST" || !etagDiffBuffered(native.events) {
+					// Pass-through: output must be identical to the handler without ETag.
+					want := etagDiffCalls(native.events, false)
+					got := etagDiffCalls(wrapped.events, false)
+					if !slices.Equal(got, want) {
+						t.Fatalf("raw calls differ\nnative  %q\nwrapped %q", want, got)
+					}
+					if wrapped.Code != native.Code || wrapped.Flushed != native.Flushed || wrapped.Body.String() != native.Body.String() {
+						t.Fatalf("response differs: native %d flushed=%v %q, wrapped %d flushed=%v %q",
+							native.Code, native.Flushed, native.Body, wrapped.Code, wrapped.Flushed, wrapped.Body)
+					}
+					if !reflect.DeepEqual(wrapped.Result().Header, native.Result().Header) {
+						t.Fatalf("headers differ\nnative  %v\nwrapped %v", native.Result().Header, wrapped.Result().Header)
+					}
+					return
+				}
+
+				// Buffered 200: the approved differences apply, nothing else may.
+				if !slices.Equal(etagDiffCalls(native.events, true), etagDiffCalls(wrapped.events, true)) {
+					t.Fatalf("raw calls differ\nnative  %q\nwrapped %q",
+						etagDiffCalls(native.events, true), etagDiffCalls(wrapped.events, true))
+				}
+				if !slices.Equal(etagDiffPushes(native.events), etagDiffPushes(wrapped.events)) {
+					t.Fatalf("pushes differ\nnative  %q\nwrapped %q", etagDiffPushes(native.events), etagDiffPushes(wrapped.events))
+				}
+				for _, e := range wrapped.events {
+					if e.phase < len(ops) && !strings.HasPrefix(e.call, "info ") && !strings.HasPrefix(e.call, "push ") {
+						t.Fatalf("approved difference broken: %q reached the client during handler step %d", e.call, e.phase)
+					}
+				}
+				if wrapped.Flushed {
+					t.Fatal("Flush must not reach the client while the 200 is held")
+				}
+				if wrapped.Code != native.Code {
+					t.Fatalf("status differs: native %d, wrapped %d", native.Code, wrapped.Code)
+				}
+				if wrapped.Body.String() != native.Body.String() {
+					t.Fatalf("body differs: native %q, wrapped %q", native.Body, wrapped.Body)
+				}
+
+				body := wrapped.Body.String()
+				wantTag := ""
+				switch {
+				case slices.Contains(ops, "etag"):
+					wantTag = `"h"`
+				case method == "GET" || body != "":
+					wantTag = etagFor(body)
+				}
+				gotTags := wrapped.HeaderMap.Values("ETag")
+				if wantTag == "" && len(gotTags) != 0 || wantTag != "" && !slices.Equal(gotTags, []string{wantTag}) {
+					t.Fatalf("ETag = %q, want %q", gotTags, wantTag)
+				}
+				if late := wrapped.HeaderMap.Get("X-Late") != ""; late != slices.Contains(ops, "late") {
+					t.Fatalf("late header reaches client = %v, want %v", late, slices.Contains(ops, "late"))
+				}
+
+				nativeHdr := native.HeaderMap.Clone()
+				wrappedHdr := wrapped.HeaderMap.Clone()
+				for _, h := range []http.Header{nativeHdr, wrappedHdr} {
+					h.Del("ETag")
+					h.Del("X-Late")
+				}
+				if !reflect.DeepEqual(nativeHdr, wrappedHdr) {
+					t.Fatalf("headers differ\nnative  %v\nwrapped %v", nativeHdr, wrappedHdr)
+				}
+			})
+		}
+	}
+}
