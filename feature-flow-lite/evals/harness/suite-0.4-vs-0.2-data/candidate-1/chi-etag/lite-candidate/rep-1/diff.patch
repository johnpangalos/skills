+func TestETagFlushIsNoOpWhileBuffering(t *testing.T) {
+	flushers := map[string]func(http.ResponseWriter) error{
+		"ResponseController": func(w http.ResponseWriter) error { return http.NewResponseController(w).Flush() },
+		"Flusher":            func(w http.ResponseWriter) error { w.(http.Flusher).Flush(); return nil },
+	}
+	for name, flush := range flushers {
+		t.Run(name, func(t *testing.T) {
+			flushed := make(chan struct{})
+			release := make(chan struct{})
+			ts := etagServer(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				io.WriteString(w, "part1")
+				if err := flush(w); err != nil {
+					t.Error(err)
+				}
+				close(flushed)
+				<-release
+			}))
+			t.Cleanup(func() { close(release) })
+
+			type result struct {
+				resp *http.Response
+				err  error
+			}
+			got := make(chan result, 1)
+			go func() {
+				resp, err := etagNoRedirect.Get(ts.URL)
+				got <- result{resp, err}
+			}()
+
+			select {
+			case <-flushed:
+			case <-time.After(5 * time.Second):
+				t.Fatal("handler did not reach Flush")
+			}
+			select {
+			case <-got:
+				t.Fatal("response reached the client before the handler returned")
+			case <-time.After(50 * time.Millisecond):
+			}
+
+			release <- struct{}{}
+			var r result
+			select {
+			case r = <-got:
+			case <-time.After(5 * time.Second):
+				t.Fatal("response never completed")
+			}
+			if r.err != nil {
+				t.Fatal(r.err)
+			}
+			defer r.resp.Body.Close()
+			body, err := io.ReadAll(r.resp.Body)
+			if err != nil {
+				t.Fatal(err)
+			}
+			assertEqual(t, string(body), "part1")
+			assertEqual(t, r.resp.Header.Get("ETag"), etagFor("part1"))
+		})
+	}
+}
