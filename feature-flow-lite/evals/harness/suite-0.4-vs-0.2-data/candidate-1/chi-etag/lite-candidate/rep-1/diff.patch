+// etagLateFetch returns the response, the body and the body read error text,
+// without failing the test on a read error.
+func etagLateFetch(t *testing.T, ts *httptest.Server, method string) (*http.Response, string, string) {
+	t.Helper()
+	req, err := http.NewRequest(method, ts.URL+"/", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp, err := etagNoRedirect.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(resp.Body)
+	readErr := ""
+	if err != nil {
+		readErr = err.Error()
+	}
+	return resp, string(body), readErr
+}
