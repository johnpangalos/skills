+// TestETagDeclaredTrailerSetBeforeWriteSurvivesNotModified checks that a 304 keeps a declared
+// header that was set before the write.
+func TestETagDeclaredTrailerSetBeforeWriteSurvivesNotModified(t *testing.T) {
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Trailer", "X-A")
+		w.Header().Set("X-A", "v")
+		io.WriteString(w, "body")
+	}))
+	rec := etagRecord(h, http.MethodGet, etagOf("body"))
+	if rec.Code != 304 || rec.Header().Get("X-A") != "v" {
+		t.Errorf("code %d X-A %q, want 304 with X-A v", rec.Code, rec.Header().Get("X-A"))
+	}
+}
