+// TestETagDeclaredETagTrailerStillMatches checks that declaring ETag as a trailer does not hide
+// the ETag from If-None-Match, whether the handler set it or ETag computed it.
+func TestETagDeclaredETagTrailerStillMatches(t *testing.T) {
+	computed := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Trailer", "ETag")
+		io.WriteString(w, "body")
+	}))
+	if rec := etagRecord(computed, http.MethodGet, etagOf("body")); rec.Code != 304 {
+		t.Errorf("computed ETag declared as trailer: code %d, want 304", rec.Code)
+	}
+	handler := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Trailer", "ETag")
+		io.WriteString(w, "body")
+		w.Header().Set("ETag", `"v1"`)
+	}))
+	if rec := etagRecord(handler, http.MethodGet, `"v1"`); rec.Code != 304 {
+		t.Errorf("handler ETag declared as trailer: code %d, want 304", rec.Code)
+	}
+}
