+		if _, err := io.Copy(w, strings.NewReader("copied")); err != nil {
+			t.Errorf("io.Copy: %v", err)
+		}
+		if rec.Body.Len() != 0 {
+			t.Error("io.Copy reached the client without buffering")
+		}
+	}))
+	h.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/", nil))
+	if rec.Body.String() != "copied" || rec.Header().Get("ETag") != etagOf("copied") {
+		t.Errorf("body %q ETag %q", rec.Body.String(), rec.Header().Get("ETag"))
