+func TestETagApprovedDifferences(t *testing.T) {
+	// Each order flushes, directly or via ResponseController, before or between writes.
+	orders := []struct {
+		name string
+		do   func(w http.ResponseWriter)
+	}{
+		{"flush first", func(w http.ResponseWriter) {
+			w.(http.Flusher).Flush()
+			w.Header().Set("X-Late", "1")
+			io.WriteString(w, "body")
+		}},
+		{"write then flush", func(w http.ResponseWriter) {
+			io.WriteString(w, "bo")
+			w.(http.Flusher).Flush()
+			w.Header().Set("X-Late", "1")
+			io.WriteString(w, "dy")
+		}},
+		{"status then flush", func(w http.ResponseWriter) {
+			w.WriteHeader(200)
+			w.(http.Flusher).Flush()
+			w.Header().Set("X-Late", "1")
+			io.WriteString(w, "body")
+		}},
+		{"response controller", func(w http.ResponseWriter) {
+			if err := http.NewResponseController(w).Flush(); err != nil {
+				t.Errorf("ResponseController.Flush: %v", err)
+			}
+			w.Header().Set("X-Late", "1")
+			io.WriteString(w, "body")
+		}},
+	}
+	for _, o := range orders {
+		t.Run(o.name, func(t *testing.T) {
+			h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { o.do(w) }))
+			// Flushed and Body are checked after the handler returns, so any byte or flush that
+			// reached the client while the 200 was buffered is still caught.
+			rec := etagRecord(h, http.MethodGet)
+			if rec.Flushed || rec.Code != 200 || rec.Body.String() != "body" {
+				t.Errorf("flushed %v code %d body %q", rec.Flushed, rec.Code, rec.Body.String())
+			}
+			if rec.Header().Get("ETag") != etagOf("body") || rec.Header().Get("X-Late") != "1" {
+				t.Errorf("ETag %q X-Late %q", rec.Header().Get("ETag"), rec.Header().Get("X-Late"))
+			}
+			if cond := etagRecord(h, http.MethodGet, etagOf("body")); cond.Code != 304 || cond.Body.Len() != 0 || cond.Flushed {
+				t.Errorf("conditional code %d body %q flushed %v", cond.Code, cond.Body.String(), cond.Flushed)
+			}
+		})
+	}
+}
