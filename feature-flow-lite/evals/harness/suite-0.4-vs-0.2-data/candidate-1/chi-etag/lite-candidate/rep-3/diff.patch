+func TestETagWriterInterfaces(t *testing.T) {
+	rec := httptest.NewRecorder()
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if _, ok := w.(io.ReaderFrom); ok {
+			t.Error("wrapper implements io.ReaderFrom")
+		}
+		if hj, ok := w.(http.Hijacker); !ok {
+			t.Error("wrapper does not implement http.Hijacker")
+		} else if _, _, err := hj.Hijack(); err == nil || err.Error() != "chi/middleware: http.Hijacker is unavailable on the writer" {
+			t.Errorf("Hijack error %v", err)
+		}
+		if ps, ok := w.(http.Pusher); !ok {
+			t.Error("wrapper does not implement http.Pusher")
+		} else if err := ps.Push("/x", nil); err == nil || err.Error() != "chi/middleware: http.Pusher is unavailable on the writer" {
+			t.Errorf("Push error %v", err)
+		}
+		if uw, ok := w.(interface{ Unwrap() http.ResponseWriter }); !ok || uw.Unwrap() != http.ResponseWriter(rec) {
+			t.Error("Unwrap does not return the original writer")
