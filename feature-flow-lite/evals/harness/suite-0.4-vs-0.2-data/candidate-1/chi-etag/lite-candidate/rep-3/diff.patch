+// TestETagDeclaredTrailerHoldIsExact checks the hold with messy Trailer declarations: a key set
+// before the write stays in the header block, and a declared key set after it is a trailer only.
+func TestETagDeclaredTrailerHoldIsExact(t *testing.T) {
+	for _, decl := range []string{"X-A, ,x-b,,", " x-b ,, X-A", "X-A,X-A,x-b"} {
+		decl := decl
+		ts := httptest.NewServer(ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Trailer", decl)
+			w.Header().Set("X-A", "a")
+			io.WriteString(w, "body")
+			w.Header().Set("X-B", "b")
+		})))
+		wire := etagParse(t, http.MethodGet, etagRaw(t, ts, http.MethodGet))
+		ts.Close()
+		if wire.err != "" || wire.body != "body" {
+			t.Fatalf("Trailer %q: body %q err %q", decl, wire.body, wire.err)
+		}
+		if got := wire.final().Header.Get("X-A"); got != "a" {
+			t.Errorf("Trailer %q: header block X-A %q, want a", decl, got)
+		}
+		if _, ok := wire.final().Header["X-B"]; ok {
+			t.Errorf("Trailer %q: X-B sent in the header block", decl)
+		}
+		if got := wire.final().Trailer.Get("X-B"); got != "b" {
+			t.Errorf("Trailer %q: X-B trailer %q, want b", decl, got)
+		}
+	}
+}
