+func TestETagOtherMethodsPassThrough(t *testing.T) {
+	for _, method := range []string{http.MethodPost, http.MethodPut, http.MethodDelete, http.MethodOptions, http.MethodPatch, "get"} {
+		rec := httptest.NewRecorder()
+		var seen http.ResponseWriter
+		h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			seen = w
+			w.Header().Set("ETag", `"b"`)
+			io.WriteString(w, "body")
+		}))
+		req := httptest.NewRequest(method, "/", nil)
+		req.Header.Set("If-None-Match", `"b"`)
+		h.ServeHTTP(rec, req)
+		if seen != http.ResponseWriter(rec) {
+			t.Errorf("%s: handler received a wrapped writer", method)
+		}
+		if rec.Code != 200 || rec.Body.String() != "body" {
+			t.Errorf("%s: If-None-Match not ignored: code %d body %q", method, rec.Code, rec.Body.String())
+		}
+		if bare := etagRecord(ETag(etagHandler("body")), method); bare.Header().Get("ETag") != "" {
+			t.Errorf("%s: ETag added %q", method, bare.Header().Get("ETag"))
+		}
+	}
