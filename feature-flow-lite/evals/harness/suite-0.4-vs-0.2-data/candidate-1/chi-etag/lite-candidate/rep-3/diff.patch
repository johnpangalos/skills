+// etagScenario is one handler script, run raw and wrapped by TestETagDifferential.
+type etagScenario struct {
+	name   string
+	body   string   // bytes written on a 200 response
+	skip   []string // final headers allowed to differ, beyond the framing headers
+	hijack bool
+	do     func(w http.ResponseWriter)
+}
+
+// etagReply writes text as a close-delimited 200 on a hijacked connection and closes it.
+func etagReply(conn net.Conn, rw *bufio.ReadWriter, text string) {
+	rw.WriteString("HTTP/1.1 200 OK\r\nConnection: close\r\n\r\n" + text)
+	rw.Flush()
+	conn.Close()
+}
+
+var etagScenarios = []etagScenario{
+	{name: "implicit 200", body: "hello", do: func(w http.ResponseWriter) { io.WriteString(w, "hello") }},
+	{name: "nothing written", do: func(w http.ResponseWriter) {}},
+	{name: "flush before write", body: "a", skip: []string{"Content-Type"}, do: func(w http.ResponseWriter) {
+		w.(http.Flusher).Flush()
+		io.WriteString(w, "a")
+	}},
+	{name: "header after first write", body: "ab", skip: []string{"X-Late"}, do: func(w http.ResponseWriter) {
+		io.WriteString(w, "a")
+		w.Header().Set("X-Late", "1")
+		io.WriteString(w, "b")
+	}},
+	{name: "no content", do: func(w http.ResponseWriter) { w.WriteHeader(204) }},
+	{name: "not found", do: func(w http.ResponseWriter) { w.WriteHeader(404); io.WriteString(w, "nope") }},
+	{name: "error then ok", do: func(w http.ResponseWriter) { w.WriteHeader(500); w.WriteHeader(200); io.WriteString(w, "late") }},
+	{name: "ok then error", body: "okmore", do: func(w http.ResponseWriter) {
+		w.WriteHeader(200)
+		io.WriteString(w, "ok")
+		w.WriteHeader(500)
+		io.WriteString(w, "more")
+	}},
+	{name: "early hints", body: "hi", do: func(w http.ResponseWriter) {
+		w.Header().Set("Link", "</s.css>; rel=preload")
+		w.WriteHeader(103)
+		w.WriteHeader(200)
+		io.WriteString(w, "hi")
+	}},
+	{name: "handler not modified", do: func(w http.ResponseWriter) { w.Header().Set("ETag", `"v1"`); w.WriteHeader(304) }},
+	{name: "push", body: "push failed", do: func(w http.ResponseWriter) {
+		// net/http's HTTP/1.1 writer has no Push method but the wrapper always does (AC10),
+		// so both sides are checked with comma-ok and report the same outcome.
+		if pusher, ok := w.(http.Pusher); !ok || pusher.Push("/x", nil) != nil {
+			io.WriteString(w, "push failed")
+			return
+		}
+		io.WriteString(w, "pushed")
+	}},
+	{name: "hijack reply", hijack: true, do: func(w http.ResponseWriter) {
+		conn, rw, _ := w.(http.Hijacker).Hijack()
+		etagReply(conn, rw, "hi")
+	}},
+	{name: "write after hijack", hijack: true, do: func(w http.ResponseWriter) {
+		conn, rw, _ := w.(http.Hijacker).Hijack()
+		_, err := w.Write([]byte("x"))
+		etagReply(conn, rw, err.Error())
+	}},
+	{name: "write then hijack", hijack: true, do: func(w http.ResponseWriter) {
+		io.WriteString(w, "x")
+		conn, _, _ := w.(http.Hijacker).Hijack()
+		conn.Close()
+	}},
+}
+
+// TestETagDifferential compares the wire bytes of each scenario with and without ETag, over
+// real connections. Only the approved differences may appear: the ETag added to GET and HEAD
+// 200s, the framing headers that follow from deferred writes, and the scenario's skip list.
+func TestETagDifferential(t *testing.T) {
+	for _, sc := range etagScenarios {
+		h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { sc.do(w) })
+		raw := httptest.NewServer(h)
+		defer raw.Close()
+		wrapped := httptest.NewServer(ETag(h))
+		defer wrapped.Close()
+		for _, method := range []string{http.MethodGet, http.MethodHead, http.MethodPost, "get"} {
+			t.Run(sc.name+" "+method, func(t *testing.T) {
+				want := etagParse(t, method, etagRaw(t, raw, method))
+				got := etagParse(t, method, etagRaw(t, wrapped, method))
+
+				skip := append([]string{"Date", "Content-Length", "Transfer-Encoding", "Etag"}, sc.skip...)
+				if d1, d2 := want.describe(skip...), got.describe(skip...); d1 != d2 {
+					t.Errorf("wire differs\nraw:     %s\nwrapped: %s", d1, d2)
+				}
+				if cl := got.final().Header.Get("Content-Length"); method == http.MethodGet && cl != "" && cl != fmt.Sprint(len(got.body)) {
+					t.Errorf("Content-Length %s does not match body length %d", cl, len(got.body))
+				}
+
+				wantTag := want.final().Header.Get("ETag")
+				gotTag := got.final().Header.Get("ETag")
+				wantAdded := !sc.hijack && wantTag == "" && want.final().StatusCode == 200 &&
+					(method == http.MethodGet || (method == http.MethodHead && sc.body != ""))
+				if wantAdded && gotTag != etagOf(sc.body) {
+					t.Errorf("ETag %q, want %q", gotTag, etagOf(sc.body))
+				}
+				if !wantAdded && gotTag != wantTag {
+					t.Errorf("ETag %q, want %q: none may be added here", gotTag, wantTag)
+				}
+			})
+		}
+	}
+}
