diff --git a/middleware/etag.go b/middleware/etag.go
new file mode 100644
index 0000000..5c9456d
--- /dev/null
+++ b/middleware/etag.go
@@ -0,0 +1,235 @@
+package middleware
+
+import (
+	"bufio"
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"net"
+	"net/http"
+	"strings"
+)
+
+// ETag buffers the whole response of each GET and HEAD request in memory, so it is
+// meant for small responses, not large or streamed ones. When the handler returns 200
+// without setting an ETag header, ETag sets a strong one hashed from the body. When the
+// request's If-None-Match matches the response's ETag, ETag answers 304 Not Modified
+// with an empty body. Other methods and non-200 statuses pass through unchanged.
+//
+// Register ETag before Compress (r.Use(ETag) ahead of r.Use(Compress(...))) so the tag
+// covers the encoded bytes and differs for each content encoding.
+func ETag(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet && r.Method != http.MethodHead {
+			next.ServeHTTP(w, r)
+			return
+		}
+		// Copied before next runs, so an inner middleware that deletes the header cannot hide it.
+		inm := append([]string(nil), r.Header.Values("If-None-Match")...)
+		ew := &etagResponseWriter{ResponseWriter: w, method: r.Method}
+		next.ServeHTTP(ew, r)
+		ew.finish(inm)
+	})
+}
+
+// etagResponseWriter holds a 200 response until the handler returns. Any other final
+// status, and any hijacked connection, is written straight through to the underlying writer.
+type etagResponseWriter struct {
+	http.ResponseWriter
+	method      string
+	buf         bytes.Buffer
+	wroteHeader bool            // a final status has been recorded
+	passthrough bool            // writes and flushes go straight to the underlying writer
+	held        map[string]bool // declared trailers absent when the final status was recorded
+}
+
+func (w *etagResponseWriter) WriteHeader(code int) {
+	if w.passthrough {
+		w.ResponseWriter.WriteHeader(code)
+		return
+	}
+	if w.wroteHeader {
+		return
+	}
+	if code >= 100 && code <= 199 && code != http.StatusSwitchingProtocols {
+		w.ResponseWriter.WriteHeader(code)
+		return
+	}
+	w.wroteHeader = true
+	if code != http.StatusOK {
+		w.passthrough = true
+		w.ResponseWriter.WriteHeader(code)
+		return
+	}
+	w.snapshotTrailers()
+}
+
+func (w *etagResponseWriter) Write(p []byte) (int, error) {
+	if !w.wroteHeader {
+		w.WriteHeader(http.StatusOK)
+	}
+	if w.passthrough {
+		return w.ResponseWriter.Write(p)
+	}
+	return w.buf.Write(p)
+}
+
+func (w *etagResponseWriter) Flush() {
+	if w.passthrough {
+		if f, ok := w.ResponseWriter.(http.Flusher); ok {
+			f.Flush()
+		}
+		return
+	}
+	if !w.wroteHeader {
+		w.WriteHeader(http.StatusOK)
+	}
+}
+
+func (w *etagResponseWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	hj, ok := w.ResponseWriter.(http.Hijacker)
+	if !ok {
+		return nil, nil, errors.New("chi/middleware: http.Hijacker is unavailable on the writer")
+	}
+	// A buffered 200 goes out unchanged, without an ETag or 304, before the connection is taken.
+	if !w.passthrough && w.wroteHeader {
+		w.ResponseWriter.WriteHeader(http.StatusOK)
+		w.ResponseWriter.Write(w.buf.Bytes())
+	}
+	w.passthrough = true
+	return hj.Hijack()
+}
+
+func (w *etagResponseWriter) Push(target string, opts *http.PushOptions) error {
+	if ps, ok := w.ResponseWriter.(http.Pusher); ok {
+		return ps.Push(target, opts)
+	}
+	return errors.New("chi/middleware: http.Pusher is unavailable on the writer")
+}
+
+func (w *etagResponseWriter) Unwrap() http.ResponseWriter {
+	return w.ResponseWriter
+}
+
+// finish runs after the handler returns and answers the buffered 200, if there is one.
+func (w *etagResponseWriter) finish(inm []string) {
+	if w.passthrough {
+		return
+	}
+	if !w.wroteHeader {
+		w.snapshotTrailers()
+	}
+	w.wroteHeader = true
+	h := w.Header()
+	if len(h.Values("ETag")) == 0 && (w.method == http.MethodGet || w.buf.Len() > 0) {
+		sum := sha256.Sum256(w.buf.Bytes())
+		h.Set("ETag", `"`+hex.EncodeToString(sum[:])+`"`)
+	}
+	if etagAnyLineMatches(inm, h.Get("ETag")) {
+		for k := range w.held {
+			h.Del(k)
+		}
+		h.Del("Content-Type")
+		h.Del("Content-Length")
+		h.Del("Content-Encoding")
+		h.Del("Last-Modified")
+		w.ResponseWriter.WriteHeader(http.StatusNotModified)
+		return
+	}
+	trailers := etagHoldTrailers(h, w.held)
+	w.ResponseWriter.WriteHeader(http.StatusOK)
+	w.ResponseWriter.Write(w.buf.Bytes())
+	// Put the held trailers back after the body so net/http sends them as trailers.
+	for k, v := range trailers {
+		h[k] = v
+	}
+}
+
+// snapshotTrailers records each trailer declared in the Trailer header that is not yet set. Raw
+// net/http sends a declared key set before the final status in the header block, and a later one
+// only as a trailer. The ETag key is never held, so it always stays in the header block.
+func (w *etagResponseWriter) snapshotTrailers() {
+	h := w.Header()
+	w.held = map[string]bool{}
+	for _, decl := range h.Values("Trailer") {
+		for _, k := range strings.Split(decl, ",") {
+			k = http.CanonicalHeaderKey(strings.TrimSpace(k))
+			if _, ok := h[k]; !ok && k != "" && k != http.CanonicalHeaderKey("ETag") {
+				w.held[k] = true
+			}
+		}
+	}
+}
+
+// etagHoldTrailers removes the values of the held keys from h and returns them, so WriteHeader
+// does not send them in the header block.
+func etagHoldTrailers(h http.Header, held map[string]bool) http.Header {
+	out := http.Header{}
+	for k := range held {
+		if v, ok := h[k]; ok {
+			out[k] = v
+			delete(h, k)
+		}
+	}
+	return out
+}
+
+// etagAnyLineMatches reports whether any If-None-Match field line matches etag. Each line is a
+// list of its own, so lines are not joined before matching.
+func etagAnyLineMatches(lines []string, etag string) bool {
+	for _, line := range lines {
+		if etagNoneMatch(line, etag) {
+			return true
+		}
+	}
+	return false
+}
+
+// etagNoneMatch reports whether an If-None-Match value matches etag under weak comparison.
+// A "*" matches any response that has an ETag. The scan stops at the first malformed member.
+func etagNoneMatch(inm, etag string) bool {
+	for {
+		inm = strings.Trim(inm, " \t")
+		switch {
+		case inm == "":
+			return false
+		case inm[0] == ',':
+			inm = inm[1:]
+		case inm[0] == '*':
+			return etag != ""
+		default:
+			tag, rest := scanETag(inm)
+			if tag == "" {
+				return false
+			}
+			if strings.TrimPrefix(tag, "W/") == strings.TrimPrefix(etag, "W/") {
+				return true
+			}
+			inm = rest
+		}
+	}
+}
+
+// scanETag returns the entity-tag at the start of s, with its optional W/ prefix, and the
+// text after it. It returns "", "" when s does not start with a valid entity-tag (RFC 9110 8.8.3).
+func scanETag(s string) (tag, rest string) {
+	start := 0
+	if strings.HasPrefix(s, "W/") {
+		start = 2
+	}
+	if len(s[start:]) < 2 || s[start] != '"' {
+		return "", ""
+	}
+	for i := start + 1; i < len(s); i++ {
+		c := s[i]
+		switch {
+		case c == 0x21 || c >= 0x23 && c <= 0x7E || c >= 0x80:
+		case c == '"':
+			return s[:i+1], s[i+1:]
+		default:
+			return "", ""
+		}
+	}
+	return "", ""
+}
diff --git a/middleware/etag_test.go b/middleware/etag_test.go
new file mode 100644
index 0000000..13396a3
--- /dev/null
+++ b/middleware/etag_test.go
@@ -0,0 +1,906 @@
+package middleware
+
+import (
+	"bufio"
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"io"
+	"math/rand"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"reflect"
+	"regexp"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/go-chi/chi/v5"
+)
+
+var etagFormat = regexp.MustCompile(`^"[0-9a-f]{64}"$`)
+
+// etagOf is an independent oracle for the ETag computed for body.
+func etagOf(body string) string {
+	sum := sha256.Sum256([]byte(body))
+	return `"` + hex.EncodeToString(sum[:]) + `"`
+}
+
+// etagRecord runs h against a recorder with the given method and If-None-Match lines.
+func etagRecord(h http.Handler, method string, inm ...string) *httptest.ResponseRecorder {
+	req := httptest.NewRequest(method, "/", nil)
+	for _, v := range inm {
+		req.Header.Add("If-None-Match", v)
+	}
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, req)
+	return rec
+}
+
+func etagHandler(body string) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) { io.WriteString(w, body) }
+}
+
+// etagRaw sends a hand-written HTTP/1.1 request to ts and returns every byte the server wrote.
+func etagRaw(t *testing.T, ts *httptest.Server, method string) []byte {
+	t.Helper()
+	conn, err := net.Dial("tcp", ts.Listener.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	conn.SetDeadline(time.Now().Add(5 * time.Second))
+	fmt.Fprintf(conn, "%s / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n", method)
+	raw, err := io.ReadAll(conn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return raw
+}
+
+// etagWire is a parsed raw exchange: informational responses first, the final one last.
+type etagWire struct {
+	responses []*http.Response
+	body, err string
+}
+
+func (w etagWire) final() *http.Response { return w.responses[len(w.responses)-1] }
+
+func etagParse(t *testing.T, method string, raw []byte) etagWire {
+	t.Helper()
+	br := bufio.NewReader(bytes.NewReader(raw))
+	req, _ := http.NewRequest(method, "/", nil)
+	var w etagWire
+	for {
+		resp, err := http.ReadResponse(br, req)
+		if err != nil {
+			t.Fatalf("parsing %q: %v", raw, err)
+		}
+		w.responses = append(w.responses, resp)
+		if resp.StatusCode < 100 || resp.StatusCode > 199 || resp.StatusCode == http.StatusSwitchingProtocols {
+			break
+		}
+	}
+	body, err := io.ReadAll(w.final().Body)
+	w.body = string(body)
+	if err != nil {
+		w.err = err.Error()
+	}
+	return w
+}
+
+// describe renders the exchange for comparison, leaving out the named final headers.
+func (w etagWire) describe(skip ...string) string {
+	h := w.final().Header.Clone()
+	for _, k := range skip {
+		h.Del(k)
+	}
+	var codes []int
+	for _, r := range w.responses {
+		codes = append(codes, r.StatusCode)
+	}
+	return fmt.Sprintf("codes %v headers %v body %q err %q", codes, h, w.body, w.err)
+}
+
+// TestETagUsableAsMiddlewareAndHandler covers both registrations: r.Use(ETag) and ETag(h).
+func TestETagUsableAsMiddlewareAndHandler(t *testing.T) {
+	r := chi.NewRouter()
+	r.Use(ETag)
+	r.Get("/", etagHandler("hi"))
+	for name, h := range map[string]http.Handler{"r.Use": r, "direct": ETag(etagHandler("hi"))} {
+		rec := etagRecord(h, http.MethodGet)
+		if rec.Code != 200 || rec.Body.String() != "hi" || rec.Header().Get("ETag") != etagOf("hi") {
+			t.Errorf("%s: code %d body %q ETag %q", name, rec.Code, rec.Body.String(), rec.Header().Get("ETag"))
+		}
+	}
+}
+
+func TestETagComputedOnGET(t *testing.T) {
+	cases := []struct {
+		name    string
+		handler http.HandlerFunc
+		body    string
+	}{
+		{"explicit 200", func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(200); io.WriteString(w, "hello") }, "hello"},
+		{"implicit 200", etagHandler("hello"), "hello"},
+		{"nothing written", func(w http.ResponseWriter, r *http.Request) {}, ""},
+		{"one byte writes", func(w http.ResponseWriter, r *http.Request) {
+			for _, b := range []byte("chunked") {
+				w.Write([]byte{b})
+			}
+		}, "chunked"},
+		{"many writes", func(w http.ResponseWriter, r *http.Request) {
+			io.WriteString(w, "ab")
+			io.WriteString(w, "cd")
+		}, "abcd"},
+		{"binary with quote and NUL", etagHandler("a\"b\x00c\xff"), "a\"b\x00c\xff"},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("X-Keep", "yes")
+				c.handler(w, r)
+			}))
+			rec := etagRecord(h, http.MethodGet)
+			got := rec.Header().Get("ETag")
+			if rec.Code != 200 || rec.Body.String() != c.body || got != etagOf(c.body) || !etagFormat.MatchString(got) {
+				t.Errorf("code %d body %q ETag %q; want 200 %q %q", rec.Code, rec.Body.String(), got, c.body, etagOf(c.body))
+			}
+			if rec.Header().Get("X-Keep") != "yes" {
+				t.Error("handler header lost")
+			}
+		})
+	}
+}
+
+func TestETagHandlerSetETagIsKept(t *testing.T) {
+	for _, tag := range []string{`W/"v1"`, `"v1"`} {
+		h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("ETag", tag)
+			io.WriteString(w, "body")
+		}))
+		if got := etagRecord(h, http.MethodGet).Header().Get("ETag"); got != tag {
+			t.Errorf("handler ETag %q was replaced by %q", tag, got)
+		}
+		if rec := etagRecord(h, http.MethodGet, `"v1"`); rec.Code != 304 {
+			t.Errorf("If-None-Match \"v1\" against handler ETag %q: code %d, want 304", tag, rec.Code)
+		}
+	}
+}
+
+func TestETagHEAD(t *testing.T) {
+	r := chi.NewRouter()
+	r.Use(ETag)
+	r.Use(GetHead)
+	r.Get("/", etagHandler("hello"))
+	ts := httptest.NewServer(r)
+	defer ts.Close()
+
+	get := etagParse(t, http.MethodGet, etagRaw(t, ts, http.MethodGet))
+	if get.final().Header.Get("ETag") != etagOf("hello") {
+		t.Fatalf("GET ETag %q, want %q", get.final().Header.Get("ETag"), etagOf("hello"))
+	}
+	head := etagParse(t, http.MethodHead, etagRaw(t, ts, http.MethodHead))
+	if head.final().Header.Get("ETag") != etagOf("hello") || head.body != "" {
+		t.Errorf("HEAD ETag %q body %q, want GET's ETag and no body", head.final().Header.Get("ETag"), head.body)
+	}
+
+	empty := httptest.NewServer(ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {})))
+	defer empty.Close()
+	if h := etagParse(t, http.MethodHead, etagRaw(t, empty, http.MethodHead)); h.final().Header.Get("ETag") != "" {
+		t.Errorf("HEAD with no body carried ETag %q", h.final().Header.Get("ETag"))
+	}
+
+	handlerTag := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("ETag", `"v1"`)
+	}))
+	if rec := etagRecord(handlerTag, http.MethodHead, `"v1"`); rec.Code != 304 {
+		t.Errorf("HEAD with handler ETag and matching If-None-Match: code %d, want 304", rec.Code)
+	}
+}
+
+func TestETagNotModifiedKeepsValidatorsAndDropsRepresentationHeaders(t *testing.T) {
+	kept := map[string]string{
+		"Cache-Control":    "max-age=60",
+		"Vary":             "Accept-Encoding",
+		"Expires":          "Wed, 21 Oct 2037 07:28:00 GMT",
+		"Content-Location": "/other",
+		"Set-Cookie":       "session=1",
+	}
+	dropped := []string{"Content-Type", "Content-Length", "Content-Encoding", "Last-Modified"}
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		for k, v := range kept {
+			w.Header().Set(k, v)
+		}
+		w.Header().Set("Content-Type", "text/plain; charset=utf-8")
+		w.Header().Set("Content-Length", "5")
+		w.Header().Set("Content-Encoding", "identity")
+		w.Header().Set("Last-Modified", "Mon, 02 Jan 2006 15:04:05 GMT")
+		io.WriteString(w, "hello")
+	}))
+	first := etagRecord(h, http.MethodGet)
+	tag := first.Header().Get("ETag")
+	if first.Code != 200 || tag == "" {
+		t.Fatalf("first code %d ETag %q, want 200 with an ETag", first.Code, tag)
+	}
+	rec := etagRecord(h, http.MethodGet, tag)
+	if rec.Code != 304 || rec.Body.Len() != 0 || rec.Header().Get("ETag") != tag {
+		t.Fatalf("code %d body %q ETag %q, want 304 empty with ETag %q", rec.Code, rec.Body.String(), rec.Header().Get("ETag"), tag)
+	}
+	for k := range kept {
+		if rec.Header().Get(k) != kept[k] {
+			t.Errorf("304 lost %s: %q", k, rec.Header().Get(k))
+		}
+	}
+	for _, k := range dropped {
+		if _, ok := rec.Header()[k]; ok {
+			t.Errorf("304 kept %s", k)
+		}
+	}
+}
+
+func TestETagIfNoneMatch(t *testing.T) {
+	long := strings.Repeat(`"a", `, 13000) + `"b"`
+	cases := []struct {
+		name  string
+		etag  string
+		lines []string
+		want  int
+	}{
+		{"exact", `"b"`, []string{`"b"`}, 304},
+		{"list", `"b"`, []string{`"a", "b"`}, 304},
+		{"padded", `"b"`, []string{` "b" `}, 304},
+		{"weak in list vs strong", `"b"`, []string{`W/"b"`}, 304},
+		{"weak both", `W/"b"`, []string{`W/"b"`}, 304},
+		{"weak handler vs strong list", `W/"b"`, []string{`"b"`}, 304},
+		{"case sensitive", `"b"`, []string{`"B"`}, 200},
+		{"unquoted", `"b"`, []string{`b`}, 200},
+		{"lowercase weak prefix", `"b"`, []string{`w/"b"`}, 200},
+		{"empty value", `"b"`, []string{``}, 200},
+		{"empty members", `"b"`, []string{`"a",,"b"`}, 304},
+		{"trailing comma", `"b"`, []string{`"a",`}, 200},
+		{"unterminated", `"b"`, []string{`"b`}, 200},
+		{"unterminated after valid", `"b"`, []string{`"a", "b`}, 200},
+		{"64 KiB list", `"b"`, []string{long}, 304},
+		{"64 KiB garbage", `"b"`, []string{strings.Repeat("x", 64<<10)}, 200},
+		{"star", `"b"`, []string{`*`}, 304},
+		{"multiple header lines", `"b"`, []string{`"a"`, `"b"`}, 304},
+		{"no match", `"b"`, []string{`"a"`}, 200},
+		{"lines are not joined", `"x,b"`, []string{`"x`, `b"`}, 200},
+		{"comma inside one tag", `"x,b"`, []string{`"x,b"`}, 304},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("ETag", c.etag)
+				io.WriteString(w, "body")
+			}))
+			if rec := etagRecord(h, http.MethodGet, c.lines...); rec.Code != c.want {
+				t.Fatalf("If-None-Match %q: code %d, want %d", c.lines, rec.Code, c.want)
+			}
+		})
+	}
+}
+
+func TestETagStarNeedsAnETagAndA200(t *testing.T) {
+	notFound := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("ETag", `"b"`)
+		w.WriteHeader(404)
+		io.WriteString(w, "nope")
+	}))
+	if rec := etagRecord(notFound, http.MethodGet, "*"); rec.Code != 404 || rec.Body.String() != "nope" {
+		t.Errorf("404 with * : code %d body %q, want 404 nope", rec.Code, rec.Body.String())
+	}
+	noBody := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}))
+	if rec := etagRecord(noBody, http.MethodHead, "*"); rec.Code != 200 {
+		t.Errorf("HEAD without body and * : code %d, want 200", rec.Code)
+	}
