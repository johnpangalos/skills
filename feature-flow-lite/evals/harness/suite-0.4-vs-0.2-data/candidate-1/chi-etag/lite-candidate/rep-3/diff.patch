+// TestETagDeclaredTrailersStayTrailers checks that a trailer declared in the Trailer header is
+// sent after the body and not in the header block, as raw net/http does.
+func TestETagDeclaredTrailersStayTrailers(t *testing.T) {
+	for _, decl := range []string{"X-Sum", "x-sum , X-Other"} {
+		ts := httptest.NewServer(ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Trailer", decl)
+			io.WriteString(w, "body")
+			w.Header().Set("X-Sum", "abc")
+		})))
+		resp, err := http.Get(ts.URL)
+		if err != nil {
+			t.Fatal(err)
+		}
+		body, err := io.ReadAll(resp.Body)
+		resp.Body.Close()
+		ts.Close()
+		if err != nil || string(body) != "body" {
+			t.Fatalf("Trailer %q: body %q err %v", decl, body, err)
+		}
+		if _, ok := resp.Header["X-Sum"]; ok {
+			t.Errorf("Trailer %q: X-Sum sent in the header block: %v", decl, resp.Header)
+		}
+		if got := resp.Trailer.Get("X-Sum"); got != "abc" {
+			t.Errorf("Trailer %q: X-Sum trailer %q, want abc", decl, got)
+		}
+	}
+}
