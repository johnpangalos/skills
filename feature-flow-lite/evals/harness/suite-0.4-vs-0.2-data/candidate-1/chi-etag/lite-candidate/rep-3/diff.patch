+// TestETagPropertyIfNoneMatchOracle builds random If-None-Match lines and checks the match
+// against a model: the first decisive member wins, and a malformed member stops the scan.
+func TestETagPropertyIfNoneMatchOracle(t *testing.T) {
+	valid := []string{`"a"`, `W/"a"`, `"b"`, `W/"b"`, `"B"`, `*`}
+	garbage := []string{`b`, `w/"b"`, `"b`, `W/`, `"b c"`, `x`}
+	seps := []string{",", ", ", " , ", ",\t"}
+	pads := []string{"", " ", "\t"}
+
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("ETag", `"b"`)
+		io.WriteString(w, "body")
+	}))
+	rnd := rand.New(rand.NewSource(2))
+	for i := 0; i < 2000; i++ {
+		var b strings.Builder
+		want, decided := false, false
+		for j, n := 0, rnd.Intn(5); j < n; j++ {
+			garb := rnd.Intn(4) == 0
+			var m string
+			if garb {
+				m = garbage[rnd.Intn(len(garbage))]
+			} else {
+				m = valid[rnd.Intn(len(valid))]
+			}
+			if j > 0 {
+				b.WriteString(seps[rnd.Intn(len(seps))])
+			}
+			b.WriteString(pads[rnd.Intn(len(pads))] + m + pads[rnd.Intn(len(pads))])
+			if !decided {
+				switch {
+				case garb:
+					decided = true
+				case m == "*" || m == `"b"` || m == `W/"b"`:
+					decided, want = true, true
+				}
+			}
+		}
+		if rec := etagRecord(h, http.MethodGet, b.String()); (rec.Code == 304) != want {
+			t.Fatalf("If-None-Match %q: code %d, want match=%v", b.String(), rec.Code, want)
+		}
+	}
+}
