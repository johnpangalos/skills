+func TestETagPropertyBodyChunksHashLikeOneWrite(t *testing.T) {
+	rnd := rand.New(rand.NewSource(1))
+	for i := 0; i < 1000; i++ {
+		body := make([]byte, rnd.Intn(300))
+		rnd.Read(body)
+		var chunks []string
+		for rest := string(body); len(rest) > 0; {
+			n := 1 + rnd.Intn(len(rest))
+			chunks = append(chunks, rest[:n])
+			rest = rest[n:]
+		}
+		h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			for _, c := range chunks {
+				io.WriteString(w, c)
+			}
+		}))
+		rec := etagRecord(h, http.MethodGet)
+		if got := rec.Header().Get("ETag"); got != etagOf(string(body)) || rec.Body.String() != string(body) {
+			t.Fatalf("body %q written in chunks %q: ETag %q, want %q", body, chunks, got, etagOf(string(body)))
+		}
+	}
+}
