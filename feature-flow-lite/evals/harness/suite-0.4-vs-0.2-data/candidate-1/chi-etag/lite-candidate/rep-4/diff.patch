+func TestETagPropertyIfNoneMatchFindsWellFormedMember(t *testing.T) {
+	rng := rand.New(rand.NewSource(3))
+	const opaqueChars = `abcXYZ019 ,*/W-_.~!`
+	const junkChars = `abcW/w ,`
+	randomString := func(chars string, max int) string {
+		b := make([]byte, rng.Intn(max))
+		for i := range b {
+			b[i] = chars[rng.Intn(len(chars))]
+		}
+		return string(b)
+	}
+	for i := 0; i < 1500; i++ {
+		opaque := randomString(opaqueChars, 12)
+		member := `"` + opaque + `"`
+		if rng.Intn(2) == 0 {
+			member = "W/" + member
+		}
+		members := make([]string, rng.Intn(4))
+		for j := range members {
+			members[j] = randomString(junkChars, 8)
+		}
+		at := rng.Intn(len(members) + 1)
+		members = slices.Insert(members, at, member)
+		if !ifNoneMatch([]string{strings.Join(members, ",")}, `"`+opaque+`"`) {
+			t.Fatalf("iteration %d: list %q did not match tag %q", i, members, opaque)
+		}
+	}
+}
