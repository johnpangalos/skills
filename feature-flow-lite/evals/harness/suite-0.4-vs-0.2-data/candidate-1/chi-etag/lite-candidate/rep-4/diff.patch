+func TestETagFlushHoldsBufferedBody(t *testing.T) {
+	flushed := make(chan struct{})
+	release := make(chan struct{})
+	var releaseOnce sync.Once
+	releaseHandler := func() { releaseOnce.Do(func() { close(release) }) }
+
+	ts := httptest.NewServer(ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("early"))
+		http.NewResponseController(w).Flush()
+		close(flushed)
+		<-release
+	})))
+	defer ts.Close()
+	defer releaseHandler()
+
+	responses := make(chan *http.Response, 1)
+	go func() {
+		resp, err := http.Get(ts.URL)
+		if err != nil {
+			t.Error(err)
+			return
+		}
+		responses <- resp
+	}()
+	select {
+	case <-flushed:
+	case <-time.After(5 * time.Second):
+		t.Fatal("handler did not reach Flush")
+	}
+	select {
+	case <-responses:
+		t.Fatal("client received a response before the handler returned")
+	case <-time.After(200 * time.Millisecond):
+	}
+	releaseHandler()
+	var resp *http.Response
+	select {
+	case resp = <-responses:
+	case <-time.After(5 * time.Second):
+		t.Fatal("no response after the handler returned")
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(resp.Body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(body) != "early" {
+		t.Fatalf("body = %q, want %q", body, "early")
+	}
