+func TestETagIfNoneMatch(t *testing.T) {
+	cases := []struct {
+		name string
+		etag string   // handler-set ETag; empty lets ETag generate one
+		inm  []string // If-None-Match header lines
+		want int
+		tag  string // ETag the response must carry
+	}{
+		{"generated tag matches", "", []string{wantETag("body")}, 304, wantETag("body")},
+		{"weak inm matches strong tag", `"a"`, []string{`W/"a"`}, 304, `"a"`},
+		{"strong inm matches weak tag", `W/"a"`, []string{`"a"`}, 304, `W/"a"`},
+		{"weak inm matches weak tag", `W/"a"`, []string{`W/"a"`}, 304, `W/"a"`},
+		{"different opaque tags", `"a"`, []string{`W/"b"`}, 200, `"a"`},
+		{"member after another", `"a"`, []string{`"x", W/"a"`}, 304, `"a"`},
+		{"OWS and empty members", `"a"`, []string{` "x" ,, W/"a" ,`}, 304, `"a"`},
+		{"only empty members", `"a"`, []string{`,,`}, 200, `"a"`},
+		{"no matching member", `"a"`, []string{`"x"`}, 200, `"a"`},
+		{"same tag with comma", `"a,b"`, []string{`"a,b"`}, 304, `"a,b"`},
+		{"shorter tag does not match", `"a,b"`, []string{`"a"`}, 200, `"a,b"`},
+		{"tag with comma is not split", `"a"`, []string{`"a,b"`}, 200, `"a"`},
+		{"comma tag found after another", `"a,b"`, []string{`"a", "a,b"`}, 304, `"a,b"`},
+		{"match in second header line", `"tag"`, []string{`"x"`, `"tag"`}, 304, `"tag"`},
+		{"bare token", `"tag"`, []string{`abc`}, 200, `"tag"`},
+		{"unterminated quote", `"tag"`, []string{`"unterminated`}, 200, `"tag"`},
+		{"weak prefix only", `"tag"`, []string{`W/`}, 200, `"tag"`},
+		{"lowercase weak prefix", `"tag"`, []string{`w/"tag"`}, 200, `"tag"`},
+		{"malformed then matching member", `"tag"`, []string{`abc, W/, w/"tag", "tag"`}, 304, `"tag"`},
+		// An opening quote without a closing one before a comma is read as an
+		// entity-tag that runs to the next quote, so "tag" after it is not a member.
+		{"quote runs to next quote", `"tag"`, []string{`"unterminated, "tag"`}, 200, `"tag"`},
+		{"empty value matches nothing", `""`, []string{""}, 200, `""`},
+		{"empty value matches nothing, generated", "", []string{""}, 200, wantETag("body")},
+		{"empty opaque tag matches", `""`, []string{`""`}, 304, `""`},
+		{"empty opaque tag, generated", "", []string{`""`}, 200, wantETag("body")},
+		{"case differs in inm", `"abc"`, []string{`"ABC"`}, 200, `"abc"`},
+		{"case differs in ETag", `"ABC"`, []string{`"abc"`}, 200, `"ABC"`},
+		{"same case matches", `"abc"`, []string{`"abc"`}, 304, `"abc"`},
+		{"unquoted ETag not matched by token", `abc`, []string{`abc`}, 200, `abc`},
+		{"unquoted ETag not matched by quoted", `abc`, []string{`"abc"`}, 200, `abc`},
+		{"unquoted ETag not matched by weak", `abc`, []string{`W/"abc"`}, 200, `abc`},
+		{"star matches unquoted ETag", `abc`, []string{"*"}, 304, `abc`},
+		{"star matches generated tag", "", []string{"*"}, 304, wantETag("body")},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			resp, body := etagGet(t, etagFixed(c.etag, "body"), http.MethodGet, etagINM(c.inm...))
+			if resp.StatusCode != c.want {
+				t.Fatalf("status = %d, want %d", resp.StatusCode, c.want)
+			}
+			wantBody := "body"
+			if c.want == http.StatusNotModified {
+				wantBody = ""
+			}
+			if body != wantBody {
+				t.Fatalf("body = %q, want %q", body, wantBody)
+			}
+			if got := resp.Header.Get("ETag"); got != c.tag {
+				t.Fatalf("ETag = %q, want %q", got, c.tag)
+			}
+		})
+	}
+}
