+func TestETagProbesOverWire(t *testing.T) {
+	cases := []struct {
+		name    string
+		method  string
+		header  http.Header
+		handler http.HandlerFunc
+		status  int
+		body    string
+		etag    string // empty means the response must carry no ETag
+	}{
+		{
+			name:   "HEAD with no body",
+			method: http.MethodHead,
+			handler: func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Content-Length", "5")
+			},
+			status: 200,
+		},
+		{
+			name:    "conditional GET",
+			method:  http.MethodGet,
+			header:  etagINM(wantETag("probe")),
+			handler: etagFixed("", "probe"),
+			status:  304,
+			etag:    wantETag("probe"),
+		},
+		{
+			name:    "empty body",
+			method:  http.MethodGet,
+			handler: func(w http.ResponseWriter, r *http.Request) {},
+			status:  200,
+			etag:    wantETag(""),
+		},
+		{
+			name:   "streamed across writes",
+			method: http.MethodGet,
+			handler: func(w http.ResponseWriter, r *http.Request) {
+				w.Write([]byte("a"))
+				w.Write([]byte("b"))
+				w.Write([]byte("c"))
+			},
+			status: 200,
+			body:   "abc",
+			etag:   wantETag("abc"),
+		},
+		{
+			name:   "header set after first write",
+			method: http.MethodGet,
+			handler: func(w http.ResponseWriter, r *http.Request) {
+				w.Write([]byte("body"))
+				w.Header().Set("ETag", `"late"`)
+			},
+			status: 200,
+			body:   "body",
+			etag:   wantETag("body"),
+		},
+		{
+			name:   "error status",
+			method: http.MethodGet,
+			handler: func(w http.ResponseWriter, r *http.Request) {
+				w.WriteHeader(http.StatusInternalServerError)
+				w.Write([]byte("oops"))
+			},
+			status: 500,
+			body:   "oops",
+		},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			resp, body := etagGet(t, c.handler, c.method, c.header)
+			if resp.StatusCode != c.status {
+				t.Fatalf("status = %d, want %d", resp.StatusCode, c.status)
+			}
+			if body != c.body {
+				t.Fatalf("body = %q, want %q", body, c.body)
+			}
+			if got := resp.Header.Get("ETag"); got != c.etag {
+				t.Fatalf("ETag = %q, want %q", got, c.etag)
+			}
+		})
+	}
+}
