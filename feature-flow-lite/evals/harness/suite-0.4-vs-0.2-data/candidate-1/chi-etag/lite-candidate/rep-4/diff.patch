+		},
+		{
+			name: "declared on 404",
+			handler: func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Trailer", "X-T")
+				w.WriteHeader(http.StatusNotFound)
+				w.Write([]byte("body"))
+				w.Header().Set("X-T", "v")
+			},
+			status:  404,
+			trailer: "X-T",
+			value:   "v",
+		},
+		{
+			name: "prefixed on 200",
+			handler: func(w http.ResponseWriter, r *http.Request) {
+				w.Write([]byte("body"))
+				w.Header().Set(http.TrailerPrefix+"X-T", "v")
+			},
+			status:  200,
+			trailer: "X-T",
+			value:   "v",
+		},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			// A buffered 200 gains an ETag, so only the trailer block is compared exactly.
+			block := fmt.Sprintf("0\r\n%s: %s\r\n\r\n", c.trailer, c.value)
+			if raw := etagRaw(t, ETag(c.handler)); !strings.HasSuffix(raw, block) {
+				t.Fatalf("wrapped connection bytes %q, want them to end with the trailer block %q", raw, block)
+			}
+			resp, body := etagGet(t, c.handler, http.MethodGet, nil)
+			if resp.StatusCode != c.status || body != "body" {
+				t.Fatalf("status %d body %q, want %d body", resp.StatusCode, body, c.status)
+			}
+			if got := resp.Trailer.Get(c.trailer); got != c.value {
+				t.Fatalf("trailer %s = %q, want %q", c.trailer, got, c.value)
+			}
+		})
+	}
+}
