+func TestETagTrailerNotSentOn304(t *testing.T) {
+	resp, body := etagGet(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("ETag", `"v1"`)
+		w.Header().Set("Trailer", "X-T")
+		w.Write([]byte("body"))
+		w.Header().Set("X-T", "v")
+	}), http.MethodGet, etagINM(`"v1"`))
+	etagExpect(t, resp, body, http.StatusNotModified)
+	if len(resp.Trailer) != 0 || resp.Header.Get("X-T") != "" {
+		t.Fatalf("304 trailer %v header X-T %q, want none", resp.Trailer, resp.Header.Get("X-T"))
+	}
+}
