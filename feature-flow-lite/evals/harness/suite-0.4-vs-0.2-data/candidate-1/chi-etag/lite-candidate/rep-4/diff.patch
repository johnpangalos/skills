+// etagStep is one call a handler makes, replayed by the differential test.
+type etagStep struct {
+	name string
+	run  func(w http.ResponseWriter) string
+}
+
+// etagReplay runs steps in a handler behind wrap and returns the recorder and
+// what each step returned.
+func etagReplay(wrap func(http.Handler) http.Handler, method string, steps []etagStep) (*httptest.ResponseRecorder, []string) {
+	var results []string
+	h := wrap(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		for _, s := range steps {
+			results = append(results, s.run(w))
+		}
+	}))
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, httptest.NewRequest(method, "/", nil))
+	return rec, results
+}
+
+func etagIdentity(next http.Handler) http.Handler { return next }
+
+func TestETagDifferentialAgainstUnwrapped(t *testing.T) {
+	steps := []etagStep{
+		{"etag", func(w http.ResponseWriter) string { w.Header().Set("ETag", `W/"v1"`); return "" }},
+		{"header", func(w http.ResponseWriter) string { w.Header().Set("X-A", "1"); return "" }},
+		{"200", func(w http.ResponseWriter) string { w.WriteHeader(200); return "" }},
+		{"201", func(w http.ResponseWriter) string { w.WriteHeader(201); return "" }},
+		{"404", func(w http.ResponseWriter) string { w.WriteHeader(404); return "" }},
+		{"write", func(w http.ResponseWriter) string { n, err := w.Write([]byte("ab")); return fmt.Sprint(n, err) }},
+		{"flush", func(w http.ResponseWriter) string { w.(http.Flusher).Flush(); return "" }},
+	}
+	// Every call sequence of up to three steps.
+	var seqs [][]etagStep
+	var gen func(prefix []etagStep)
+	gen = func(prefix []etagStep) {
+		seqs = append(seqs, prefix)
+		if len(prefix) == 3 {
+			return
+		}
+		for _, s := range steps {
+			gen(append(slices.Clip(prefix), s))
+		}
+	}
+	gen(nil)
+
+	methods := []string{http.MethodGet, http.MethodHead, http.MethodPost, http.MethodPut, http.MethodDelete, http.MethodOptions, http.MethodPatch}
+	for _, method := range methods {
+		for _, seq := range seqs {
+			names := make([]string, len(seq))
+			for i, s := range seq {
+				names[i] = s.name
+			}
+			name := method + " [" + strings.Join(names, " ") + "]"
+
+			want, wantLog := etagReplay(etagIdentity, method, seq)
+			got, gotLog := etagReplay(ETag, method, seq)
+			if !reflect.DeepEqual(gotLog, wantLog) {
+				t.Errorf("%s: step results %q, want %q", name, gotLog, wantLog)
+			}
+			if got.Code != want.Code {
+				t.Errorf("%s: status %d, want %d", name, got.Code, want.Code)
+			}
+			if got.Body.String() != want.Body.String() {
+				t.Errorf("%s: body %q, want %q", name, got.Body.String(), want.Body.String())
+			}
+
+			wantHeader := want.Result().Header
+			wantFlushed := want.Flushed
+			if (method == http.MethodGet || method == http.MethodHead) && want.Code == 200 {
+				// Approved: a buffered 200 is not flushed early and gains an ETag.
+				wantFlushed = false
+				wantHeader = wantHeader.Clone()
+				if len(wantHeader.Values("ETag")) == 0 && (method == http.MethodGet || want.Body.Len() > 0) {
+					wantHeader.Set("ETag", wantETag(want.Body.String()))
+				}
+			}
+			if !reflect.DeepEqual(got.Result().Header, wantHeader) {
+				t.Errorf("%s: headers %v, want %v", name, got.Result().Header, wantHeader)
+			}
+			if got.Flushed != wantFlushed {
+				t.Errorf("%s: flushed %t, want %t", name, got.Flushed, wantFlushed)
+			}
+		}
+	}
+}
