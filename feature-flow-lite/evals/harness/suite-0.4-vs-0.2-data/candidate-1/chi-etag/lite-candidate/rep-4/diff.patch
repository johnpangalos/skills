+func TestETagPropertyPriorTagGets304(t *testing.T) {
+	rng := rand.New(rand.NewSource(2))
+	for i := 0; i < 1500; i++ {
+		body := make([]byte, rng.Intn(256))
+		rng.Read(body)
+		h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Write(body)
+		})
+		tag := etagRecord(ETag(h), http.MethodGet, nil).Header().Get("ETag")
+		rec := etagRecord(ETag(h), http.MethodGet, etagINM(tag))
+		if rec.Code != http.StatusNotModified || rec.Body.Len() != 0 || rec.Header().Get("ETag") != tag {
+			t.Fatalf("iteration %d: status %d body %d bytes ETag %q, want 304 with no body and tag %q",
+				i, rec.Code, rec.Body.Len(), rec.Header().Get("ETag"), tag)
+		}
+	}
+}
