+func TestETagPropertyTagIgnoresWriteSplits(t *testing.T) {
+	rng := rand.New(rand.NewSource(1))
+	for i := 0; i < 1500; i++ {
+		body := make([]byte, rng.Intn(512))
+		rng.Read(body)
+		var pieces [][]byte
+		for off := 0; off < len(body); {
+			n := 1 + rng.Intn(len(body)-off)
+			pieces = append(pieces, body[off:off+n])
+			off += n
+		}
+		h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			for _, p := range pieces {
+				if rng.Intn(4) == 0 {
+					w.Write(nil)
+				}
+				w.Write(p)
+				if rng.Intn(4) == 0 {
+					w.(http.Flusher).Flush()
+				}
+			}
+		})
+		rec := etagRecord(ETag(h), http.MethodGet, nil)
+		if got := rec.Header().Get("ETag"); got != wantETag(string(body)) {
+			t.Fatalf("iteration %d: ETag = %q, want %q", i, got, wantETag(string(body)))
+		}
+		if !bytes.Equal(rec.Body.Bytes(), body) {
+			t.Fatalf("iteration %d: body differs from the written bytes", i)
+		}
+	}
+}
