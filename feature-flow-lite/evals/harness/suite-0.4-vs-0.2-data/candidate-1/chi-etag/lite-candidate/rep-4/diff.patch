+func TestETagPanicWritesNothing(t *testing.T) {
+	sentinel := errors.New("boom")
+	rec := httptest.NewRecorder()
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("X-A", "1")
+		w.Write([]byte("buffered"))
+		panic(sentinel)
+	}))
+	func() {
+		defer func() {
+			if v := recover(); v != sentinel {
+				t.Fatalf("recovered %v, want the handler's panic", v)
+			}
+		}()
+		h.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/", nil))
+	}()
+	if rec.Body.Len() != 0 || rec.Flushed || len(rec.Header()) != 0 {
+		t.Fatalf("after panic: body %q flushed %t headers %v, want nothing written", rec.Body.String(), rec.Flushed, rec.Header())
+	}
+}
