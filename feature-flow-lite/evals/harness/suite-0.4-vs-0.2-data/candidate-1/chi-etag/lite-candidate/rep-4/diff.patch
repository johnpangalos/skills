+						t.Fatalf("status %d body %q, want %d body", got.Code, got.Body.String(), code)
+					}
+					if !withETag && got.Header().Get("ETag") != "" {
+						t.Fatalf("ETag %q added to a %d response", got.Header().Get("ETag"), code)
