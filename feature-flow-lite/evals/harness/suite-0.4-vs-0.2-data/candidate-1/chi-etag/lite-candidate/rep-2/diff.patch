+// etagWriteAfterHijack hijacks with no earlier write, then returns the error of a Write.
+func etagWriteAfterHijack(t *testing.T, wrap func(http.Handler) http.Handler) error {
+	t.Helper()
+	errs := make(chan error, 1)
+	ts := httptest.NewServer(wrap(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		conn, _, err := http.NewResponseController(w).Hijack()
+		if err != nil {
+			errs <- err
+			return
+		}
+		_, werr := w.Write([]byte("x"))
+		errs <- werr
+		conn.Close()
+	})))
+	defer ts.Close()
+	conn, err := net.Dial("tcp", ts.Listener.Addr().String())
+	assertNoError(t, err)
+	defer conn.Close()
+	assertNoError(t, conn.SetDeadline(time.Now().Add(5*time.Second)))
+	_, err = io.WriteString(conn, "GET / HTTP/1.1\r\nHost: test\r\n\r\n")
+	assertNoError(t, err)
+	_, err = io.ReadAll(conn)
+	assertNoError(t, err)
+	return <-errs
+}
+
+func TestETagWriteAfterHijackReturnsUnwrappedError(t *testing.T) {
+	plain := etagWriteAfterHijack(t, func(h http.Handler) http.Handler { return h })
+	if !errors.Is(plain, http.ErrHijacked) {
+		t.Fatalf("expecting the unwrapped writer to return '%v' but got: '%v'", http.ErrHijacked, plain)
+	}
+	wrapped := etagWriteAfterHijack(t, ETag)
+	if !errors.Is(wrapped, http.ErrHijacked) {
+		t.Fatalf("expecting '%v' but got: '%v'", http.ErrHijacked, wrapped)
+	}
+	assertEqual(t, wrapped, plain)
+}
