+// etagRawResponse sends a GET over a raw connection and returns the bytes the server wrote, minus the Date header.
+func etagRawResponse(t *testing.T, method string, h http.Handler) string {
+	t.Helper()
+	ts := httptest.NewServer(h)
+	defer ts.Close()
+	conn, err := net.Dial("tcp", ts.Listener.Addr().String())
+	assertNoError(t, err)
+	defer conn.Close()
+	assertNoError(t, conn.SetDeadline(time.Now().Add(5*time.Second)))
+	_, err = io.WriteString(conn, method+" / HTTP/1.1\r\nHost: test\r\nConnection: close\r\n\r\n")
+	assertNoError(t, err)
+	out, err := io.ReadAll(conn)
+	assertNoError(t, err)
+	var kept []string
+	for _, line := range strings.SplitAfter(string(out), "\r\n") {
+		if !strings.HasPrefix(line, "Date: ") {
+			kept = append(kept, line)
+		}
+	}
+	return strings.Join(kept, "")
+}
