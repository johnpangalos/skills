+func TestETagHEAD(t *testing.T) {
+	const lastModified = "Mon, 02 Jan 2006 15:04:05 GMT"
+	cases := []struct {
+		name    string
+		handler func(w http.ResponseWriter)
+		inm     string
+		code    int
+		etag    string // expected ETag header, "" for none
+	}{
+		{
+			name: "body bytes give an ETag",
+			handler: func(w http.ResponseWriter) {
+				w.Write([]byte("hello"))
+			},
+			code: 200,
+			etag: etagTestDigest("hello"),
+		},
+		{
+			name:    "empty body gives no ETag",
+			handler: func(w http.ResponseWriter) {},
+			code:    200,
+			etag:    "",
+		},
+		{
+			name: "handler ETag drives 304",
+			handler: func(w http.ResponseWriter) {
+				w.Header().Set("ETag", `"v"`)
+				w.Write([]byte("hello"))
+			},
+			inm:  `"v"`,
+			code: 304,
+			etag: `"v"`,
+		},
+		{
+			name:    "star on empty body gives 304 without ETag",
+			handler: func(w http.ResponseWriter) {},
+			inm:     "*",
+			code:    304,
+			etag:    "",
+		},
+		{
+			name: "star on body gives 304",
+			handler: func(w http.ResponseWriter) {
+				w.Write([]byte("hello"))
+			},
+			inm:  "*",
+			code: 304,
+			etag: etagTestDigest("hello"),
+		},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			rec := httptest.NewRecorder()
+			req := httptest.NewRequest(http.MethodHead, "/", nil)
+			if tc.inm != "" {
+				req.Header.Set("If-None-Match", tc.inm)
+			}
+			ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Last-Modified", lastModified)
+				tc.handler(w)
+			})).ServeHTTP(rec, req)
+
+			res := rec.Result()
+			assertEqual(t, rec.Code, tc.code)
+			assertEqual(t, res.Header.Get("ETag"), tc.etag)
+			if tc.code == 304 && tc.etag == "" {
+				// RFC 9110 section 15.4.5: Last-Modified stays when there is no ETag.
+				assertEqual(t, res.Header.Get("Last-Modified"), lastModified)
+			}
+		})
+	}
+}
