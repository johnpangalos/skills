+func TestETagTrailers(t *testing.T) {
+	cases := []struct {
+		name    string
+		handler func(w http.ResponseWriter)
+		want    map[string]string // trailers the unwrapped handler gets on the client
+	}{
+		{
+			name: "declared trailer set after write",
+			handler: func(w http.ResponseWriter) {
+				w.Header().Set("Trailer", "X-T")
+				w.Write([]byte("body"))
+				w.Header().Set("X-T", "v")
+			},
+			want: map[string]string{"X-T": "v"},
+		},
+		{
+			name: "declared trailer list set after write",
+			handler: func(w http.ResponseWriter) {
+				w.Header().Set("Trailer", "X-A, x-b")
+				w.Write([]byte("body"))
+				w.Header().Set("X-A", "1")
+				w.Header().Set("X-B", "2")
+			},
+			want: map[string]string{"X-A": "1", "X-B": "2"},
+		},
+		{
+			name: "TrailerPrefix key set before write",
+			handler: func(w http.ResponseWriter) {
+				w.Header().Set(http.TrailerPrefix+"Foo", "v")
+				w.Write([]byte("body"))
+			},
+			want: map[string]string{"Foo": "v"},
+		},
+		{
+			// net/http does not send this trailer either, so the wrapper must match that.
+			name: "TrailerPrefix key set after write",
+			handler: func(w http.ResponseWriter) {
+				w.Write([]byte("body"))
+				w.Header().Set(http.TrailerPrefix+"Foo", "v")
+			},
+		},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			plainTS := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				tc.handler(w)
+			}))
+			defer plainTS.Close()
+			wrappedTS := httptest.NewServer(ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				tc.handler(w)
+			})))
+			defer wrappedTS.Close()
+
+			plain, _ := etagServerRequest(t, plainTS, http.MethodGet, "/", "")
+			wrapped, body := etagServerRequest(t, wrappedTS, http.MethodGet, "/", "")
+			assertEqual(t, body, "body")
+			for key, value := range tc.want {
+				assertEqual(t, plain.Trailer.Get(key), value)
+			}
+			assertEqual(t, wrapped.Trailer, plain.Trailer)
+		})
+	}
+}
