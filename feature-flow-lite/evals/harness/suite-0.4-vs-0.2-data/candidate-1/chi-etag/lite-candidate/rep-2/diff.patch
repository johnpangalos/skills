+func TestETagHTTPProbes(t *testing.T) {
+	const lastModified = "Mon, 02 Jan 2006 15:04:05 GMT"
+	r := chi.NewRouter()
+	r.Use(ETag)
+	r.HandleFunc("/body", func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("hello"))
+	})
+	r.HandleFunc("/empty", func(w http.ResponseWriter, r *http.Request) {})
+	r.HandleFunc("/stream", func(w http.ResponseWriter, r *http.Request) {
+		for _, chunk := range []string{"one", "two", "three"} {
+			w.Write([]byte(chunk))
+			w.(http.Flusher).Flush()
+		}
+	})
+	r.HandleFunc("/cond", func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("ETag", `"v1"`)
+		w.Header().Set("Content-Type", "text/plain")
+		w.Header().Set("Last-Modified", lastModified)
+		w.Write([]byte("hello"))
+	})
+	r.HandleFunc("/late", func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("a"))
+		w.Header().Set("X-Late", "1")
+	})
+	r.HandleFunc("/error", func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusInternalServerError)
+		w.Write([]byte("boom"))
+	})
+	ts := httptest.NewServer(r)
+	defer ts.Close()
+
+	t.Run("GET body", func(t *testing.T) {
+		resp, body := etagServerRequest(t, ts, http.MethodGet, "/body", "")
+		assertEqual(t, resp.StatusCode, http.StatusOK)
+		assertEqual(t, body, "hello")
+		assertEqual(t, resp.Header.Get("ETag"), etagTestDigest("hello"))
+	})
+
+	t.Run("HEAD body has ETag and no body", func(t *testing.T) {
+		resp, body := etagServerRequest(t, ts, http.MethodHead, "/body", "")
+		assertEqual(t, resp.StatusCode, http.StatusOK)
+		assertEqual(t, body, "")
+		assertEqual(t, resp.Header.Get("ETag"), etagTestDigest("hello"))
+	})
+
+	t.Run("GET empty body", func(t *testing.T) {
+		resp, body := etagServerRequest(t, ts, http.MethodGet, "/empty", "")
+		assertEqual(t, resp.StatusCode, http.StatusOK)
+		assertEqual(t, body, "")
+		assertEqual(t, resp.Header.Get("ETag"), etagTestDigest(""))
+	})
+
+	t.Run("HEAD empty body never gets a validator", func(t *testing.T) {
+		resp, _ := etagServerRequest(t, ts, http.MethodHead, "/empty", "")
+		assertEqual(t, resp.StatusCode, http.StatusOK)
+		assertEqual(t, resp.Header.Get("ETag"), "")
+	})
+
+	t.Run("streamed writes", func(t *testing.T) {
+		resp, body := etagServerRequest(t, ts, http.MethodGet, "/stream", "")
+		assertEqual(t, resp.StatusCode, http.StatusOK)
+		assertEqual(t, body, "onetwothree")
+		assertEqual(t, resp.Header.Get("ETag"), etagTestDigest("onetwothree"))
+	})
+
+	t.Run("conditional GET gives 304", func(t *testing.T) {
+		resp, body := etagServerRequest(t, ts, http.MethodGet, "/cond", `"v1"`)
+		assertEqual(t, resp.StatusCode, http.StatusNotModified)
+		assertEqual(t, body, "")
+		assertEqual(t, resp.Header.Get("ETag"), `"v1"`)
+		assertEqual(t, resp.Header.Get("Content-Type"), "")
+		assertEqual(t, resp.Header.Get("Last-Modified"), "")
+	})
+
+	t.Run("conditional HEAD gives 304", func(t *testing.T) {
+		resp, body := etagServerRequest(t, ts, http.MethodHead, "/cond", `"v1"`)
+		assertEqual(t, resp.StatusCode, http.StatusNotModified)
+		assertEqual(t, body, "")
+		assertEqual(t, resp.Header.Get("ETag"), `"v1"`)
+	})
+
+	t.Run("header set after first write is not sent", func(t *testing.T) {
+		resp, body := etagServerRequest(t, ts, http.MethodGet, "/late", "")
+		assertEqual(t, resp.StatusCode, http.StatusOK)
+		assertEqual(t, body, "a")
+		assertEqual(t, resp.Header.Get("X-Late"), "")
+		assertEqual(t, resp.Header.Get("ETag"), etagTestDigest("a"))
+	})
+
+	t.Run("error status has no ETag", func(t *testing.T) {
+		resp, body := etagServerRequest(t, ts, http.MethodGet, "/error", "")
+		assertEqual(t, resp.StatusCode, http.StatusInternalServerError)
+		assertEqual(t, body, "boom")
+		assertEqual(t, resp.Header.Get("ETag"), "")
+	})
+}
