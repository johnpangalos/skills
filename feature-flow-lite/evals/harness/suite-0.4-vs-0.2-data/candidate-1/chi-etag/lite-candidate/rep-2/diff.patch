+func TestETagDifferentialAgainstUnwrapped(t *testing.T) {
+	for _, s := range etagScripts {
+		for _, method := range []string{http.MethodGet, http.MethodHead} {
+			t.Run(s.name+" "+method, func(t *testing.T) {
+				req := httptest.NewRequest(method, "/", nil)
+
+				var plainLog []string
+				plain := httptest.NewRecorder()
+				http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					s.run(w, &plainLog)
+				}).ServeHTTP(plain, req)
+
+				var wrappedLog []string
+				wrapped := httptest.NewRecorder()
+				ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					s.run(w, &wrappedLog)
+				})).ServeHTTP(wrapped, req)
+
+				assertEqual(t, wrappedLog, plainLog)
+				assertEqual(t, wrapped.Code, plain.Code)
+				assertEqual(t, wrapped.Body.String(), plain.Body.String())
+
+				// The approved difference: GET 200, and HEAD 200 with body bytes, gain an ETag.
+				got := wrapped.Result().Header
+				wantETag := s.code == http.StatusOK && (method == http.MethodGet || s.body != "")
+				if wantETag {
+					assertEqual(t, got.Get("ETag"), etagTestDigest(s.body))
+					got.Del("ETag")
+				} else {
+					assertEqual(t, got.Get("ETag"), "")
+				}
+				assertEqual(t, got, plain.Result().Header)
+
+				// The approved difference: Flush does nothing to a buffered 200.
+				if s.code == http.StatusOK {
+					assertEqual(t, wrapped.Flushed, false)
+				} else {
+					assertEqual(t, wrapped.Flushed, plain.Flushed)
+				}
+			})
+		}
+	}
+}
+
+func TestETagApprovedDifferencesInEveryCallOrder(t *testing.T) {
+	for _, s := range etagScripts {
+		for _, method := range []string{http.MethodGet, http.MethodHead} {
+			t.Run(s.name+" "+method, func(t *testing.T) {
+				wantETag := s.code == http.StatusOK && (method == http.MethodGet || s.body != "")
+				inm := "*"
+				if wantETag {
+					inm = etagTestDigest(s.body)
+				}
+				if s.code != http.StatusOK {
+					inm = "*" // a non-200 response must never become 304
+				}
+
+				req := httptest.NewRequest(method, "/", nil)
+				req.Header.Set("If-None-Match", inm)
+				var log []string
+				rec := httptest.NewRecorder()
+				ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					s.run(w, &log)
+				})).ServeHTTP(rec, req)
+
+				res := rec.Result()
+				if s.code != http.StatusOK {
+					assertEqual(t, rec.Code, s.code)
+					assertEqual(t, rec.Body.String(), s.body)
+					assertEqual(t, res.Header.Get("ETag"), "")
+					return
+				}
+
+				// A 200 whose ETag (or `*`) matches becomes 304 with no body and no representation headers.
+				assertEqual(t, rec.Code, http.StatusNotModified)
+				assertEqual(t, rec.Body.Len(), 0)
+				assertEqual(t, rec.Flushed, false)
+				assertEqual(t, res.Header.Get("Content-Type"), "")
+				assertEqual(t, res.Header.Get("Content-Length"), "")
+				assertEqual(t, res.Header.Get("Content-Encoding"), "")
+				wantTag := ""
+				if wantETag {
+					wantTag = etagTestDigest(s.body)
+				}
+				assertEqual(t, res.Header.Get("ETag"), wantTag)
+			})
+		}
+	}
+}
