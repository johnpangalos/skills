+// etagScript is a handler body run both with and without the middleware.
+type etagScript struct {
+	name string
+	run  func(w http.ResponseWriter, log *[]string)
+	code int    // expected final status
+	body string // expected body
+}
+
+func etagWriteLogged(w http.ResponseWriter, log *[]string, s string) {
+	n, err := w.Write([]byte(s))
+	*log = append(*log, fmt.Sprint(n, err))
+}
+
+func etagFlush(w http.ResponseWriter) {
+	w.(http.Flusher).Flush()
+}
+
+var etagScripts = []etagScript{
+	{"write only", func(w http.ResponseWriter, log *[]string) { etagWriteLogged(w, log, "hello") }, 200, "hello"},
+	{"explicit 200", func(w http.ResponseWriter, log *[]string) {
+		w.WriteHeader(200)
+		etagWriteLogged(w, log, "hello")
+	}, 200, "hello"},
+	{"header then write", func(w http.ResponseWriter, log *[]string) {
+		w.Header().Set("Content-Type", "text/plain")
+		etagWriteLogged(w, log, "hello")
+	}, 200, "hello"},
+	{"flush then write", func(w http.ResponseWriter, log *[]string) {
+		etagFlush(w)
+		etagWriteLogged(w, log, "hello")
+	}, 200, "hello"},
+	{"write flush write", func(w http.ResponseWriter, log *[]string) {
+		etagWriteLogged(w, log, "he")
+		etagFlush(w)
+		etagWriteLogged(w, log, "llo")
+	}, 200, "hello"},
+	{"flush then 404", func(w http.ResponseWriter, log *[]string) {
+		etagFlush(w)
+		w.WriteHeader(404)
+		etagWriteLogged(w, log, "x")
+	}, 200, "x"},
+	{"double WriteHeader", func(w http.ResponseWriter, log *[]string) {
+		w.WriteHeader(200)
+		w.WriteHeader(500)
+		etagWriteLogged(w, log, "ok")
+	}, 200, "ok"},
+	{"header after write", func(w http.ResponseWriter, log *[]string) {
+		etagWriteLogged(w, log, "a")
+		w.Header().Set("X-Late", "1")
+		etagWriteLogged(w, log, "b")
+	}, 200, "ab"},
+	{"empty", func(w http.ResponseWriter, log *[]string) {}, 200, ""},
+	{"zero byte write", func(w http.ResponseWriter, log *[]string) {
+		etagWriteLogged(w, log, "")
+		etagWriteLogged(w, log, "x")
+	}, 200, "x"},
+	{"explicit 404", func(w http.ResponseWriter, log *[]string) {
+		w.WriteHeader(404)
+		etagWriteLogged(w, log, "nope")
+	}, 404, "nope"},
+	{"404 then 200", func(w http.ResponseWriter, log *[]string) {
+		w.WriteHeader(404)
+		w.WriteHeader(200)
+		etagWriteLogged(w, log, "nope")
+	}, 404, "nope"},
+	{"204 no body", func(w http.ResponseWriter, log *[]string) {
+		w.WriteHeader(204)
+	}, 204, ""},
+	{"flush after 404", func(w http.ResponseWriter, log *[]string) {
+		w.WriteHeader(404)
+		etagWriteLogged(w, log, "a")
+		etagFlush(w)
+		etagWriteLogged(w, log, "b")
+	}, 404, "ab"},
+	{"500 with type", func(w http.ResponseWriter, log *[]string) {
+		w.Header().Set("Content-Type", "text/plain")
+		w.WriteHeader(500)
+		etagWriteLogged(w, log, "boom")
+	}, 500, "boom"},
+}
