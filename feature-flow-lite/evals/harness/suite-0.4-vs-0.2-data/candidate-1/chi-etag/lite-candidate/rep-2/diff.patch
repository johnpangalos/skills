+func TestETagHijackAfterBufferedWritesStatusLine(t *testing.T) {
+	cases := []struct {
+		name    string
+		handler func(w http.ResponseWriter)
+	}{
+		{"explicit WriteHeader", func(w http.ResponseWriter) {
+			w.WriteHeader(http.StatusOK)
+		}},
+		{"write", func(w http.ResponseWriter) {
+			w.Write([]byte("hello"))
+		}},
+		{"explicit WriteHeader then write", func(w http.ResponseWriter) {
+			w.WriteHeader(http.StatusOK)
+			w.Write([]byte("hello"))
+		}},
+		{"write nil", func(w http.ResponseWriter) {
+			w.Write(nil)
+		}},
+		{"write empty", func(w http.ResponseWriter) {
+			w.Write([]byte{})
+		}},
+	}
+	for _, method := range []string{http.MethodGet, http.MethodHead} {
+		for _, tc := range cases {
+			t.Run(tc.name+" "+method, func(t *testing.T) {
+				hijack := func(w http.ResponseWriter, r *http.Request) {
+					tc.handler(w)
+					conn, _, err := http.NewResponseController(w).Hijack()
+					if err != nil {
+						t.Errorf("expecting no error but got: '%v'", err)
+						return
+					}
+					conn.Write([]byte("RAW"))
+					conn.Close()
+				}
+				plain := etagRawResponse(t, method, http.HandlerFunc(hijack))
+				wrapped := etagRawResponse(t, method, ETag(http.HandlerFunc(hijack)))
+				assertEqual(t, wrapped, plain)
+				if !strings.HasPrefix(wrapped, "HTTP/1.1 200 OK\r\n") {
+					t.Fatalf("expecting a status line but got: '%q'", wrapped)
+				}
+				if strings.Contains(wrapped, "ETag") {
+					t.Fatalf("expecting no ETag on a hijacked response but got: '%q'", wrapped)
+				}
+			})
+		}
+	}
+}
