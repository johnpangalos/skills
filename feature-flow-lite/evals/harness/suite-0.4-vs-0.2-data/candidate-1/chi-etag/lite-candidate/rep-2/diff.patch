+func TestETagNonCanonicalHandlerETag(t *testing.T) {
+	handler := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header()["ETag"] = []string{`"mine"`}
+		w.Write([]byte("body"))
+	}))
+
+	t.Run("wire has one ETag header", func(t *testing.T) {
+		wire := etagRawResponse(t, http.MethodGet, handler)
+		assertEqual(t, strings.Count(strings.ToLower(wire), "\r\netag:"), 1)
+		if !strings.Contains(wire, "\r\nETag: \"mine\"\r\n") {
+			t.Fatalf("expecting ETag \"mine\" on the wire but got: '%q'", wire)
+		}
+	})
+
+	t.Run("If-None-Match matches it", func(t *testing.T) {
+		ts := httptest.NewServer(handler)
+		defer ts.Close()
+		resp, body := etagServerRequest(t, ts, http.MethodGet, "/", `"mine"`)
+		assertEqual(t, resp.StatusCode, http.StatusNotModified)
+		assertEqual(t, body, "")
+		assertEqual(t, resp.Header.Get("ETag"), `"mine"`)
+	})
+}
