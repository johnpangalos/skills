+func TestETagHijackSendsBufferedResponse(t *testing.T) {
+	cases := []struct {
+		name    string
+		prepare func(w http.ResponseWriter)
+		started bool // the status line is on the wire before the hijack
+	}{
+		{"explicit 200 then write", func(w http.ResponseWriter) {
+			w.Header().Set("X-A", "1")
+			w.WriteHeader(http.StatusOK)
+			w.Write([]byte("pre"))
+		}, true},
+		{"write starts the response", func(w http.ResponseWriter) {
+			w.Header().Set("X-A", "1")
+			w.Write([]byte("pre"))
+		}, true},
+		{"flush starts the response", func(w http.ResponseWriter) {
+			w.Header().Set("X-A", "1")
+			w.(http.Flusher).Flush()
+		}, true},
+		{"nothing started", func(w http.ResponseWriter) {}, false},
+		{"write then flush", func(w http.ResponseWriter) {
+			w.Header().Set("X-A", "1")
+			w.Write([]byte("hello"))
+			w.(http.Flusher).Flush()
+		}, true},
+		{"write flush write", func(w http.ResponseWriter) {
+			w.Header().Set("X-A", "1")
+			w.Write([]byte("hello"))
+			w.(http.Flusher).Flush()
+			w.Write([]byte("late"))
+		}, true},
+		{"explicit 200 write flush", func(w http.ResponseWriter) {
+			w.Header().Set("X-A", "1")
+			w.WriteHeader(http.StatusOK)
+			w.Write([]byte("hello"))
+			w.(http.Flusher).Flush()
+		}, true},
+		{"flush write", func(w http.ResponseWriter) {
+			w.Header().Set("X-A", "1")
+			w.(http.Flusher).Flush()
+			w.Write([]byte("hello"))
+		}, true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				tc.prepare(w)
+				conn, rw, err := w.(http.Hijacker).Hijack()
+				if err != nil {
+					t.Error(err)
+					return
+				}
+				rw.WriteString("RAW")
+				rw.Flush()
+				conn.Close()
+			})
+			want := etagRawWire(t, handler)
+			got := etagRawWire(t, ETag(handler))
+			if g, w := etagWithoutDate(got), etagWithoutDate(want); g != w {
+				t.Errorf("wire = %q, unwrapped = %q", g, w)
+			}
+			if tc.started && !(strings.HasPrefix(got, "HTTP/1.1 200 OK\r\n") && strings.Contains(got, "\r\nX-A: 1\r\n")) {
+				t.Errorf("status line or X-A header missing from %q", got)
+			}
+			if !strings.HasSuffix(got, "RAW") {
+				t.Errorf("wire = %q, want it to end with RAW", got)
+			}
+		})
+	}
+}
