+func TestETagWrapperInterfaces(t *testing.T) {
+	rec := httptest.NewRecorder()
+	var pushErr, hijackErr error
+	var unwrapOK bool
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		u, ok := w.(interface{ Unwrap() http.ResponseWriter })
+		unwrapOK = ok && u.Unwrap() == http.ResponseWriter(rec)
+		hj, ok := w.(http.Hijacker)
+		if !ok {
+			t.Error("wrapped writer does not implement http.Hijacker")
+			return
+		}
+		_, _, hijackErr = hj.Hijack()
+		ps, ok := w.(http.Pusher)
+		if !ok {
+			t.Error("wrapped writer does not implement http.Pusher")
+			return
+		}
+		pushErr = ps.Push("/x", nil)
+	}))
+	h.ServeHTTP(rec, httptest.NewRequest("GET", "/", nil))
+
+	if !unwrapOK {
+		t.Error("Unwrap did not return the underlying writer")
+	}
+	if hijackErr == nil || hijackErr.Error() != "chi/middleware: http.Hijacker is unavailable on the writer" {
+		t.Errorf("Hijack error = %v", hijackErr)
+	}
+	if pushErr == nil || pushErr.Error() != "chi/middleware: http.Pusher is unavailable on the writer" {
+		t.Errorf("Push error = %v", pushErr)
+	}
