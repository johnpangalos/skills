+func TestETagForwardsInformationalStatusImmediately(t *testing.T) {
+	early := make(chan struct{})
+	ts := httptest.NewServer(ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("ETag", `"v1"`)
+		w.Header().Set("Link", "</style.css>; rel=preload")
+		w.WriteHeader(http.StatusEarlyHints)
+		select {
+		case <-early:
+		case <-time.After(5 * time.Second):
+			t.Error("103 was not forwarded before the handler returned")
+		}
+		w.Write([]byte("body"))
+	})))
+	defer ts.Close()
+
+	trace := &httptrace.ClientTrace{
+		Got1xxResponse: func(code int, header textproto.MIMEHeader) error {
+			if code == http.StatusEarlyHints {
+				close(early)
+			}
+			return nil
+		},
+	}
+	req, err := http.NewRequest("GET", ts.URL, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	req.Header.Set("If-None-Match", `"v1"`)
+	req = req.WithContext(httptrace.WithClientTrace(req.Context(), trace))
+	resp, err := http.DefaultClient.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+
+	// The 103 must not count as the final status, so the later match gives 304.
+	if resp.StatusCode != http.StatusNotModified {
+		t.Errorf("status = %d, want 304 (1xx must not be the final status)", resp.StatusCode)
+	}
+}
