+func TestETagOverHTTP(t *testing.T) {
+	r := chi.NewRouter()
+	r.Use(ETag)
+	r.Use(GetHead)
+	r.Get("/doc", func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("hello "))
+		w.Write([]byte("world"))
+	})
+	r.Get("/empty", func(w http.ResponseWriter, r *http.Request) {})
+	r.Get("/gone", func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusNotFound)
+		w.Write([]byte("nope"))
+	})
+	ts := httptest.NewServer(r)
+	defer ts.Close()
+
+	tag := etagTagOf("hello world")
+	cases := []struct {
+		name     string
+		method   string
+		path     string
+		inm      []string
+		wantCode int
+		wantBody string
+		wantETag string
+	}{
+		{"GET streamed body", "GET", "/doc", nil, 200, "hello world", tag},
+		{"HEAD has no body", "HEAD", "/doc", nil, 200, "", tag},
+		{"GET conditional", "GET", "/doc", []string{tag}, 304, "", tag},
+		{"HEAD conditional", "HEAD", "/doc", []string{tag}, 304, "", tag},
+		{"GET empty body", "GET", "/empty", nil, 200, "", etagTagOf("")},
+		{"HEAD empty body", "HEAD", "/empty", nil, 200, "", ""},
+		{"error status", "GET", "/gone", []string{"*"}, 404, "nope", ""},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			resp, body := etagDo(t, ts, tc.method, tc.path, tc.inm...)
+			if resp.StatusCode != tc.wantCode || body != tc.wantBody {
+				t.Errorf("got %d %q, want %d %q", resp.StatusCode, body, tc.wantCode, tc.wantBody)
+			}
+			if got := resp.Header.Get("ETag"); got != tc.wantETag {
+				t.Errorf("ETag = %q, want %q", got, tc.wantETag)
+			}
+		})
+	}
+}
