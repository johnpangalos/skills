diff --git a/middleware/etag.go b/middleware/etag.go
new file mode 100644
index 0000000..d8c010c
--- /dev/null
+++ b/middleware/etag.go
@@ -0,0 +1,251 @@
+package middleware
+
+import (
+	"bufio"
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"net"
+	"net/http"
+	"strings"
+)
+
+// ETag buffers the whole body of 200 responses to GET and HEAD requests in
+// memory, sets a strong ETag computed from that body when the handler set
+// none, and answers 304 Not Modified when If-None-Match matches (RFC 9110
+// section 13.1.2). Nothing is sent until the handler returns. Other methods
+// and other statuses pass through unchanged. Place ETag before (outside)
+// Compress so the ETag matches the bytes sent.
+func ETag(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet && r.Method != http.MethodHead {
+			next.ServeHTTP(w, r)
+			return
+		}
+		ew := &etagResponseWriter{
+			ResponseWriter: w,
+			head:           r.Method == http.MethodHead,
+			ifNoneMatch:    r.Header.Values("If-None-Match"),
+		}
+		next.ServeHTTP(ew, r)
+		ew.finish()
+	})
+}
+
+type etagResponseWriter struct {
+	http.ResponseWriter
+	head        bool
+	ifNoneMatch []string
+	body        bytes.Buffer
+	wrote       bool // the handler called Write, so finish must call Write too
+	// implicitHeader: the first call was Write, so the 200 is implicit and the body
+	// is written without a WriteHeader first, letting the writer sniff Content-Type.
+	implicitHeader bool
+	status         int  // final status; 0 until WriteHeader, Write or Flush
+	sent           bool // the buffered 200 went to the underlying writer (by Hijack)
+	hijacked       bool
+	flushed        bool // the handler called Flush while the 200 was buffered
+	flushedLen     int  // body bytes written before the last such Flush
+}
+
+// passthrough reports whether writes go straight to the underlying writer: a
+// final status other than 200 was set, or the buffered 200 was already sent.
+func (w *etagResponseWriter) passthrough() bool {
+	return w.sent || w.status != 0 && w.status != http.StatusOK
+}
+
+func (w *etagResponseWriter) WriteHeader(code int) {
+	if w.hijacked {
+		return
+	}
+	if code >= 100 && code <= 199 && code != http.StatusSwitchingProtocols {
+		w.ResponseWriter.WriteHeader(code) // informational: forwarded, not final
+		return
+	}
+	if w.status != 0 {
+		return // only the first final status counts
+	}
+	w.status = code
+	if code != http.StatusOK {
+		w.ResponseWriter.WriteHeader(code)
+	}
+}
+
+func (w *etagResponseWriter) Write(p []byte) (int, error) {
+	if w.hijacked {
+		return 0, http.ErrHijacked
+	}
+	if w.status == 0 {
+		w.status = http.StatusOK
+		w.implicitHeader = true
+	}
+	if w.passthrough() {
+		return w.ResponseWriter.Write(p)
+	}
+	w.wrote = true
+	return w.body.Write(p)
+}
+
+func (w *etagResponseWriter) Flush() {
+	if w.hijacked {
+		return
+	}
+	if w.status == 0 {
+		w.status = http.StatusOK // as in net/http, Flush implies WriteHeader(200)
+	}
+	if !w.passthrough() {
+		// A buffered 200 is held back until the handler returns. Record how much
+		// body this Flush covers, for Hijack.
+		w.flushed = true
+		w.flushedLen = w.body.Len()
+		return
+	}
+	if f, ok := w.ResponseWriter.(http.Flusher); ok {
+		f.Flush()
+	}
+}
+
+// Hijack first sends a buffered 200 as net/http would have kept it, so the
+// client sees what the unwrapped handler's Hijack would show. It computes no ETag.
+func (w *etagResponseWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	hj, ok := w.ResponseWriter.(http.Hijacker)
+	if !ok {
+		return nil, nil, errors.New("chi/middleware: http.Hijacker is unavailable on the writer")
+	}
+	if w.status == http.StatusOK && !w.sent {
+		w.sendForHijack()
+	}
+	conn, rw, err := hj.Hijack()
+	if err == nil {
+		w.hijacked = true
+	}
+	return conn, rw, err
+}
+
+// sendForHijack writes the buffered 200 as it stands at Hijack. The body up to
+// the last Flush is written and flushed. The rest is written unflushed, so the
+// underlying Hijack discards it, as it does for an unflushed net/http response.
+func (w *etagResponseWriter) sendForHijack() {
+	w.sent = true
+	if !w.implicitHeader {
+		w.ResponseWriter.WriteHeader(http.StatusOK)
+	}
+	w.ResponseWriter.Write(w.body.Bytes()[:w.flushedLen])
+	if f, ok := w.ResponseWriter.(http.Flusher); ok && w.flushed {
+		f.Flush()
+	}
+	w.ResponseWriter.Write(w.body.Bytes()[w.flushedLen:])
+}
+
+func (w *etagResponseWriter) Push(target string, opts *http.PushOptions) error {
+	if ps, ok := w.ResponseWriter.(http.Pusher); ok {
+		return ps.Push(target, opts)
+	}
+	return errors.New("chi/middleware: http.Pusher is unavailable on the writer")
+}
+
+func (w *etagResponseWriter) Unwrap() http.ResponseWriter {
+	return w.ResponseWriter
+}
+
+// finish sends the buffered 200 response, or a 304 when If-None-Match matches.
+// It is not deferred, so a panicking handler leaves nothing written.
+func (w *etagResponseWriter) finish() {
+	if w.passthrough() || w.hijacked {
+		return
+	}
+	// A HEAD response with no body bytes gets no computed ETag, so no
+	// validator comes from an empty body.
+	if len(w.Header().Values("ETag")) == 0 && (!w.head || w.body.Len() > 0) {
+		w.Header().Set("ETag", etagStrong(w.body.Bytes()))
+	}
+	if matchesIfNoneMatch(w.ifNoneMatch, w.Header().Get("ETag")) {
+		writeNotModified(w.ResponseWriter)
+		return
+	}
+	w.sendBuffered()
+}
+
+// sendBuffered writes the buffered 200 to the underlying writer as it stands:
+// the status line unless the 200 was implicit, then the body if the handler wrote one.
+func (w *etagResponseWriter) sendBuffered() {
+	w.sent = true
+	if !w.implicitHeader {
+		w.ResponseWriter.WriteHeader(http.StatusOK)
+	}
+	if w.wrote {
+		w.ResponseWriter.Write(w.body.Bytes())
+	}
+}
+
+// etagStrong returns the strong entity-tag for body: its SHA-256 in quotes.
+func etagStrong(body []byte) string {
+	sum := sha256.Sum256(body)
+	return `"` + hex.EncodeToString(sum[:]) + `"`
+}
+
+// writeNotModified sends a 304 with the same header clean-up as net/http's ServeContent.
+func writeNotModified(w http.ResponseWriter) {
+	h := w.Header()
+	h.Del("Content-Type")
+	h.Del("Content-Length")
+	h.Del("Content-Encoding")
+	if h.Get("ETag") != "" {
+		h.Del("Last-Modified")
+	}
+	w.WriteHeader(http.StatusNotModified)
+}
+
+// matchesIfNoneMatch reports whether the If-None-Match header lines match etag
+// ("" when the response has none), using weak comparison. The lines are joined
+// with commas. As in net/http's checkIfNoneMatch, the scan stops at the first
+// malformed member.
+func matchesIfNoneMatch(lines []string, etag string) bool {
+	list := strings.Join(lines, ",")
+	for {
+		list = strings.Trim(list, " \t")
+		if list == "" {
+			return false
+		}
+		if list[0] == ',' {
+			list = list[1:]
+			continue
+		}
+		if list[0] == '*' {
+			return true
+		}
+		tag, rest := scanETag(list)
+		if tag == "" {
+			return false
+		}
+		if strings.TrimPrefix(tag, "W/") == strings.TrimPrefix(etag, "W/") {
+			return true
+		}
+		list = rest
+	}
+}
+
+// scanETag reads one entity-tag (W/"x" or "x") at the start of s. It returns
+// the tag and the text after it, or "", "" when s does not start with a valid
+// entity-tag.
+func scanETag(s string) (tag, rest string) {
+	start := 0
+	if strings.HasPrefix(s, "W/") {
+		start = 2
+	}
+	if start+1 >= len(s) || s[start] != '"' {
+		return "", ""
+	}
+	for i := start + 1; i < len(s); i++ {
+		c := s[i]
+		switch {
+		case c == 0x21 || c >= 0x23 && c <= 0x7E || c >= 0x80: // etagc
+		case c == '"':
+			return s[:i+1], s[i+1:]
+		default:
+			return "", ""
+		}
+	}
+	return "", ""
+}
diff --git a/middleware/etag_test.go b/middleware/etag_test.go
new file mode 100644
index 0000000..88d4eed
--- /dev/null
+++ b/middleware/etag_test.go
@@ -0,0 +1,852 @@
+package middleware
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/http/httptrace"
+	"net/textproto"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/go-chi/chi/v5"
+)
+
+// etagTagOf is the strong ETag the middleware must compute for body.
+func etagTagOf(body string) string {
+	sum := sha256.Sum256([]byte(body))
+	return `"` + hex.EncodeToString(sum[:]) + `"`
+}
+
+// etagSpyWriter counts the calls that reach the underlying writer.
+type etagSpyWriter struct {
+	*httptest.ResponseRecorder
+	headerCalls int
+	writeCalls  int
+}
+
+func (s *etagSpyWriter) WriteHeader(code int) {
+	s.headerCalls++
+	s.ResponseRecorder.WriteHeader(code)
+}
+
+func (s *etagSpyWriter) Write(p []byte) (int, error) {
+	s.writeCalls++
+	return s.ResponseRecorder.Write(p)
+}
+
+// etagRecord serves method / with the given If-None-Match header lines through h.
+func etagRecord(h http.Handler, method string, inm ...string) *httptest.ResponseRecorder {
+	req := httptest.NewRequest(method, "/", nil)
+	for _, v := range inm {
+		req.Header.Add("If-None-Match", v)
+	}
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, req)
+	return rec
+}
+
+// etagDo sends a real request to ts with the given If-None-Match header lines.
+func etagDo(t *testing.T, ts *httptest.Server, method, path string, inm ...string) (*http.Response, string) {
+	t.Helper()
+	req, err := http.NewRequest(method, ts.URL+path, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, v := range inm {
+		req.Header.Add("If-None-Match", v)
+	}
+	resp, err := http.DefaultClient.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(resp.Body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return resp, string(body)
+}
+
+func TestETagPassesThroughOtherMethods(t *testing.T) {
+	for _, method := range []string{"POST", "PUT", "DELETE", "get"} {
+		t.Run(method, func(t *testing.T) {
+			rec := httptest.NewRecorder()
+			h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if got, ok := w.(*httptest.ResponseRecorder); !ok || got != rec {
+					t.Error("next did not receive the original ResponseWriter")
+				}
+				w.Write([]byte("part"))
+				w.(http.Flusher).Flush()
+				if !rec.Flushed || rec.Body.String() != "part" {
+					t.Errorf("flush was held back: flushed=%v body=%q", rec.Flushed, rec.Body.String())
+				}
+				w.Write([]byte("ed"))
+			}))
+
+			req := httptest.NewRequest(method, "/", nil)
+			req.Header.Set("If-None-Match", "*")
+			h.ServeHTTP(rec, req)
+
+			if rec.Code != http.StatusOK || rec.Body.String() != "parted" {
+				t.Errorf("got %d %q, want 200 %q", rec.Code, rec.Body.String(), "parted")
+			}
+			if got := rec.Header().Get("ETag"); got != "" {
+				t.Errorf("ETag = %q, want none", got)
+			}
+		})
+	}
+}
+
+func TestETagComputesStrongTagFromBody(t *testing.T) {
+	cases := []struct {
+		name     string
+		body     string
+		chunk    int  // bytes per Write; 0 means one Write
+		explicit bool // call WriteHeader(200) before writing
+	}{
+		{"implicit single write", "hello world", 0, false},
+		{"explicit status", "hello world", 0, true},
+		{"one byte writes", "hello world", 1, true},
+		{"quote and invalid utf-8", "say \"hi\"\xff\xfe", 1, false},
+		{"10 MiB body", strings.Repeat("0123456789", 1<<20), 1 << 16, true},
+		{"empty body", "", 0, true},
+		{"no writes at all", "", -1, false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			rec := httptest.NewRecorder()
+			h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if tc.explicit {
+					w.WriteHeader(http.StatusOK)
+				}
+				if tc.chunk < 0 {
+					return
+				}
+				chunk := tc.chunk
+				if chunk == 0 {
+					chunk = len(tc.body)
+				}
+				for i := 0; i < len(tc.body); i += chunk {
+					w.Write([]byte(tc.body[i:min(i+chunk, len(tc.body))]))
+				}
+			}))
+			h.ServeHTTP(rec, httptest.NewRequest("GET", "/", nil))
+
+			if rec.Code != http.StatusOK {
+				t.Errorf("status = %d, want 200", rec.Code)
+			}
+			if got, want := rec.Header().Get("ETag"), etagTagOf(tc.body); got != want {
+				t.Errorf("ETag = %q, want %q", got, want)
+			}
+			if !bytes.Equal(rec.Body.Bytes(), []byte(tc.body)) {
+				t.Errorf("body mismatch: got %d bytes, want %d", rec.Body.Len(), len(tc.body))
+			}
+		})
+	}
+}
+
+func TestETagTagsDifferByBody(t *testing.T) {
+	tags := map[string]string{}
+	for _, body := range []string{"a", "b", ""} {
+		h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Write([]byte(body))
+		}))
+		tag := etagRecord(h, "GET").Header().Get("ETag")
+		if prev, ok := tags[tag]; ok {
+			t.Fatalf("bodies %q and %q share ETag %q", prev, body, tag)
+		}
+		tags[tag] = body
+	}
+}
+
+func TestETagKeepsHandlerETag(t *testing.T) {
+	for _, etag := range []string{`"v1"`, `W/"v1"`} {
+		t.Run(etag, func(t *testing.T) {
+			h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("ETag", etag)
+				w.Write([]byte("body"))
+			}))
+			rec := etagRecord(h, "GET")
+			if got := rec.Header().Values("ETag"); !slices.Equal(got, []string{etag}) {
+				t.Errorf("ETag values = %q, want [%q]", got, etag)
+			}
+		})
+	}
+}
+
+func TestETagHEAD(t *testing.T) {
+	t.Run("no body means no ETag", func(t *testing.T) {
+		h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}))
+		rec := etagRecord(h, "HEAD")
+		if _, ok := rec.Result().Header["Etag"]; ok {
+			t.Errorf("HEAD with empty body got ETag %q", rec.Header().Get("ETag"))
+		}
+	})
+
+	t.Run("body bytes give the GET tag", func(t *testing.T) {
+		h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Write([]byte("hello world"))
+		}))
+		head := etagRecord(h, "HEAD").Header().Get("ETag")
+		get := etagRecord(h, "GET").Header().Get("ETag")
+		if head != etagTagOf("hello world") || head != get {
+			t.Errorf("HEAD ETag = %q, GET ETag = %q, want %q", head, get, etagTagOf("hello world"))
+		}
+	})
+
+	t.Run("handler ETag kept and used", func(t *testing.T) {
+		h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("ETag", `"v1"`)
+		}))
+		rec := etagRecord(h, "HEAD", `"v1"`)
+		if rec.Code != http.StatusNotModified || rec.Header().Get("ETag") != `"v1"` {
+			t.Errorf("got %d ETag %q, want 304 with ETag \"v1\"", rec.Code, rec.Header().Get("ETag"))
+		}
+	})
+
+	t.Run("star matches empty HEAD", func(t *testing.T) {
+		h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}))
+		if rec := etagRecord(h, "HEAD", "*"); rec.Code != http.StatusNotModified {
+			t.Errorf("status = %d, want 304", rec.Code)
+		}
+	})
+
+	t.Run("no validator to match", func(t *testing.T) {
+		h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}))
+		if rec := etagRecord(h, "HEAD", `"x"`); rec.Code != http.StatusOK {
+			t.Errorf("status = %d, want 200", rec.Code)
+		}
+	})
+}
+
+func TestETagIfNoneMatch(t *testing.T) {
+	cases := []struct {
+		name    string
+		etag    string   // handler-set ETag; empty means the handler sets none
+		inm     []string // If-None-Match header lines
+		want304 bool
+	}{
+		{"strong exact", `"abc"`, []string{`"abc"`}, true},
+		{"weak request matches strong", `"abc"`, []string{`W/"abc"`}, true},
+		{"strong request matches weak", `W/"abc"`, []string{`"abc"`}, true},
+		{"weak both sides", `W/"abc"`, []string{`W/"abc"`}, true},
+		{"empty list members", `"abc"`, []string{`"a",,"abc"`}, true},
+		{"leading comma", `"abc"`, []string{`, "abc"`}, true},
+		{"OWS around members", `"abc"`, []string{` "x" , "abc" `}, true},
+		{"combined header lines", `"abc"`, []string{`"x"`, `"abc"`}, true},
+		{"comma inside quotes is one tag", `"a,b"`, []string{`"a,b"`}, true},
+		{"comma inside quotes does not split", `"a"`, []string{`"a,b"`}, false},
+		{"unquoted never matches", `"abc"`, []string{`abc`}, false},
+		{"unterminated tag", `"abc"`, []string{`"abc`}, false},
+		{"W/ alone", `"abc"`, []string{`W/`}, false},
+		{"opaque tag is case sensitive", `"a"`, []string{`"A"`}, false},
+		{"empty value", `"abc"`, []string{``}, false},
+		{"malformed member stops the scan", `"abc"`, []string{`abc, "abc"`}, false},
+		{"star", `"abc"`, []string{`*`}, true},
+		{"star with other tags", `"abc"`, []string{`"x", *`}, true},
+		{"star with computed ETag", ``, []string{`*`}, true},
+		{"no match", `"abc"`, []string{`"x"`}, false},
+		{"unquoted handler ETag", `abc`, []string{`"abc"`}, false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if tc.etag != "" {
+					w.Header().Set("ETag", tc.etag)
+				}
+				w.Write([]byte("hello"))
+			}))
+			rec := etagRecord(h, "GET", tc.inm...)
+			if tc.want304 {
+				if rec.Code != http.StatusNotModified || rec.Body.Len() != 0 {
+					t.Errorf("got %d %q, want 304 with no body", rec.Code, rec.Body.String())
+				}
+				return
+			}
+			if rec.Code != http.StatusOK || rec.Body.String() != "hello" {
+				t.Errorf("got %d %q, want 200 hello", rec.Code, rec.Body.String())
+			}
+		})
+	}
+}
+
+func TestETagNotModifiedHeaders(t *testing.T) {
+	h := ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		hdr := w.Header()
+		hdr.Set("ETag", `"v1"`)
+		hdr.Set("Content-Type", "text/plain")
+		hdr.Set("Content-Length", "5")
+		hdr.Set("Content-Encoding", "gzip")
+		hdr.Set("Last-Modified", "Mon, 02 Jan 2006 15:04:05 GMT")
+		hdr.Set("Cache-Control", "max-age=60")
+		hdr.Set("Content-Location", "/other")
+		hdr.Set("Expires", "Thu, 01 Jan 2099 00:00:00 GMT")
+		hdr.Set("Vary", "Accept")
+		hdr.Set("Date", "Mon, 02 Jan 2006 15:04:05 GMT")
+		w.Write([]byte("hello"))
+	}))
+	rec := etagRecord(h, "GET", `"v1"`)
+	res := rec.Result()
+
+	if res.StatusCode != http.StatusNotModified || rec.Body.Len() != 0 {
+		t.Fatalf("got %d %q, want 304 with no body", res.StatusCode, rec.Body.String())
+	}
+	for _, k := range []string{"Content-Type", "Content-Length", "Content-Encoding", "Last-Modified"} {
+		if v, ok := res.Header[textproto.CanonicalMIMEHeaderKey(k)]; ok {
+			t.Errorf("%s = %q, want removed", k, v)
+		}
+	}
+	want := map[string]string{
+		"ETag":             `"v1"`,
+		"Cache-Control":    "max-age=60",
+		"Content-Location": "/other",
+		"Expires":          "Thu, 01 Jan 2099 00:00:00 GMT",
+		"Vary":             "Accept",
+		"Date":             "Mon, 02 Jan 2006 15:04:05 GMT",
+	}
+	for k, v := range want {
+		if got := res.Header.Get(k); got != v {
+			t.Errorf("%s = %q, want %q", k, got, v)
+		}
+	}
+}
