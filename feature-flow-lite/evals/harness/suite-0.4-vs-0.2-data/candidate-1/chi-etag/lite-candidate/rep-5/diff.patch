+func TestETagDifferentialAgainstUnwrapped(t *testing.T) {
+	writeHello := func(w http.ResponseWriter, r *http.Request) { w.Write([]byte("hello")) }
+	scenarios := []struct {
+		name      string
+		h         http.HandlerFunc
+		diff      []string // headers the middleware may add or change on GET and HEAD
+		flushDiff bool     // Flush is withheld while the 200 is buffered
+	}{
+		{"implicit write", writeHello, []string{"Etag"}, false},
+		{"explicit 200", func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(200)
+			w.Write([]byte("hello"))
+		}, []string{"Etag"}, false},
+		{"no writes", func(w http.ResponseWriter, r *http.Request) {}, []string{"Etag"}, false},
+		{"empty write", func(w http.ResponseWriter, r *http.Request) { w.Write(nil) }, []string{"Etag"}, false},
+		{"200 then 500", func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(200)
+			w.WriteHeader(500)
+			w.Write([]byte("hello"))
+		}, []string{"Etag"}, false},
+		{"500 then 200", func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(500)
+			w.WriteHeader(200)
+			w.Write([]byte("hello"))
+		}, nil, false},
+		{"flush before write", func(w http.ResponseWriter, r *http.Request) {
+			w.(http.Flusher).Flush()
+			w.Write([]byte("hello"))
+		}, []string{"Etag"}, true},
+		{"flush after write", func(w http.ResponseWriter, r *http.Request) {
+			w.Write([]byte("he"))
+			w.(http.Flusher).Flush()
+			w.Write([]byte("llo"))
+		}, []string{"Etag"}, true},
+		{"header set after write", func(w http.ResponseWriter, r *http.Request) {
+			w.Write([]byte("he"))
+			w.Header().Set("X-Late", "1")
+			w.Write([]byte("llo"))
+		}, []string{"Etag", "X-Late"}, false},
+		{"handler ETag", func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("ETag", `W/"v1"`)
+			w.Write([]byte("hello"))
+		}, nil, false},
+		{"status 201", func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(201)
+			w.Write([]byte("hello"))
+		}, nil, false},
+		{"status 404 with flush", func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(404)
+			w.Write([]byte("he"))
+			w.(http.Flusher).Flush()
+		}, nil, false},
+	}
+	for _, sc := range scenarios {
+		for _, method := range []string{"GET", "HEAD", "POST"} {
+			t.Run(sc.name+" "+method, func(t *testing.T) {
+				plainRec := etagRecord(sc.h, method, `"nope"`)
+				ourRec := etagRecord(ETag(sc.h), method, `"nope"`)
+				plain, ours := plainRec.Result(), ourRec.Result()
+
+				if plain.StatusCode != ours.StatusCode {
+					t.Errorf("status %d, unwrapped %d", ours.StatusCode, plain.StatusCode)
+				}
+				if !bytes.Equal(ourRec.Body.Bytes(), plainRec.Body.Bytes()) {
+					t.Errorf("body %q, unwrapped %q", ourRec.Body.String(), plainRec.Body.String())
+				}
+
+				wantDiff := slices.Clone(sc.diff)
+				if method == "POST" {
+					wantDiff = nil
+				}
+				if method == "HEAD" && plainRec.Body.Len() == 0 {
+					wantDiff = slices.DeleteFunc(wantDiff, func(k string) bool { return k == "Etag" })
+				}
+				slices.Sort(wantDiff)
+				if gotDiff := etagHeaderDiff(plain.Header, ours.Header); !slices.Equal(gotDiff, wantDiff) {
+					t.Errorf("header differences %q, want %q", gotDiff, wantDiff)
+				}
+
+				if method != "POST" && sc.flushDiff {
+					if ourRec.Flushed || !plainRec.Flushed {
+						t.Errorf("approved flush withholding did not happen: ours=%v unwrapped=%v", ourRec.Flushed, plainRec.Flushed)
+					}
+				} else if ourRec.Flushed != plainRec.Flushed {
+					t.Errorf("flushed %v, unwrapped %v", ourRec.Flushed, plainRec.Flushed)
+				}
+			})
+		}
+	}
+}
+
+// etagHeaderDiff returns the sorted canonical keys whose values differ between a and b.
+func etagHeaderDiff(a, b http.Header) []string {
+	var diff []string
+	for k := range a {
+		if !slices.Equal(a.Values(k), b.Values(k)) {
+			diff = append(diff, k)
+		}
+	}
+	for k := range b {
+		if _, ok := a[k]; !ok {
+			diff = append(diff, k)
+		}
+	}
+	slices.Sort(diff)
+	return diff
+}
