+func TestETagHijackWritesNothingFurther(t *testing.T) {
+	writeErr := make(chan error, 1)
+	ts := httptest.NewServer(ETag(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("buffered"))
+		conn, rw, err := w.(http.Hijacker).Hijack()
+		if err != nil {
+			t.Error(err)
+			writeErr <- err
+			return
+		}
+		_, err = w.Write([]byte("late"))
+		writeErr <- err
+		rw.WriteString("RAW")
+		rw.Flush()
+		conn.Close()
+	})))
+	defer ts.Close()
+
+	conn, err := net.Dial("tcp", strings.TrimPrefix(ts.URL, "http://"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	conn.SetDeadline(time.Now().Add(5 * time.Second))
+	fmt.Fprintf(conn, "GET / HTTP/1.1\r\nHost: test\r\nConnection: close\r\n\r\n")
+	raw, err := io.ReadAll(conn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// The 200 head goes out, the buffered body is dropped as net/http does on an
+	// unflushed Hijack, and the late write never reaches the wire.
+	if !strings.HasPrefix(string(raw), "HTTP/1.1 200 OK\r\n") || !strings.HasSuffix(string(raw), "\r\n\r\nRAW") {
+		t.Errorf("raw bytes on the connection = %q, want a 200 head then %q", raw, "RAW")
+	}
+	if err := <-writeErr; !errors.Is(err, http.ErrHijacked) {
+		t.Errorf("Write after Hijack error = %v, want %v", err, http.ErrHijacked)
+	}
+}
