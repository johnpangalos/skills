+    let {shadowRoot} = createHost(container);
+    let input = createElement(shadowRoot, 'input');
+    let {shadowRoot: siblingRoot} = createHost(shadowRoot);
+    let announcer = createElement(siblingRoot, 'div', {'data-live-announcer': 'true'});
+
+    let revert = ariaHideOutside([input]);
+    let added = createElement(siblingRoot, 'button');
+    await Promise.resolve();
+
+    expect(announcer).not.toHaveAttribute('aria-hidden');
+    expect(added).toHaveAttribute('aria-hidden', 'true');
+
+    revert();
+  });
+
+  it('should only walk the light DOM when shadow DOM is disabled', function () {
+    shadowDOM.mockReturnValue(false);
+    let {shadowRoot} = createHost(container);
+    let input = createElement(shadowRoot, 'input');
+    let shadowSibling = createElement(shadowRoot, 'button');
+
+    let revert = ariaHideOutside([input]);
+
+    expect(document.body).toHaveAttribute('aria-hidden', 'true');
+    expect(shadowSibling).not.toHaveAttribute('aria-hidden');
+
+    revert();
+
+    expect(document.body).not.toHaveAttribute('aria-hidden');
+  });
+});
