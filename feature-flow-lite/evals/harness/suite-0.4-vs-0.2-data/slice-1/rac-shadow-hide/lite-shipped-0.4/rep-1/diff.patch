diff --git a/packages/@react-aria/overlays/test/ariaHideOutsideShadowDOM.test.js b/packages/@react-aria/overlays/test/ariaHideOutsideShadowDOM.test.js
new file mode 100644
index 0000000..7549f86
--- /dev/null
+++ b/packages/@react-aria/overlays/test/ariaHideOutsideShadowDOM.test.js
@@ -0,0 +1,338 @@
+/*
