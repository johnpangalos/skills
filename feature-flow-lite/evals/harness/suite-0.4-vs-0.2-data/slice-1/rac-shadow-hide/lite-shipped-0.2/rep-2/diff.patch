+    expect(outerRoot.host).not.toHaveAttribute('aria-hidden');
+    expect(outerRoot.querySelector('#inner-host')).not.toHaveAttribute('aria-hidden');
+    expect(button).not.toHaveAttribute('aria-hidden');
+
+    revert();
+
+    expect(outerCheckbox).not.toHaveAttribute('aria-hidden');
+    expect(innerRadio).not.toHaveAttribute('aria-hidden');
+    expect(lightCheckbox).not.toHaveAttribute('aria-hidden');
+  });
+
+  it('should hide siblings when the target is a direct child of the shadow root', function () {
