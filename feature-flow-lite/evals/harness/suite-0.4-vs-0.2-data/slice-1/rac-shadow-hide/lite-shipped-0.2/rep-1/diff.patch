+    shadowRoot.innerHTML = '<input type="checkbox" id="before"><button>Target</button><input type="checkbox" id="after">';
+    let button = shadowRoot.querySelector('button');
+
+    let revert = ariaHideOutside([button]);
+
+    expect(lightCheckbox).toHaveAttribute('aria-hidden', 'true');
+    expect(shadowHost).not.toHaveAttribute('aria-hidden');
+    expect(shadowRoot.querySelector('#before')).toHaveAttribute('aria-hidden', 'true');
+    expect(shadowRoot.querySelector('#after')).toHaveAttribute('aria-hidden', 'true');
+    expect(button).not.toHaveAttribute('aria-hidden');
+
+    revert();
+
+    expect(lightCheckbox).not.toHaveAttribute('aria-hidden');
