+        now = time.time()
     token = secrets.token_urlsafe(16)
-    _TOKENS[token] = username
+    _TOKENS[token] = (username, now)
     return token
 
 
-def redeem_reset_token(token):
-    """Return the username a token was issued for."""
-    username = _TOKENS.get(token)
-    if username is None:
-        raise InvalidToken("unknown token")
-    return username
+def redeem_reset_token(token, now=None):
+    """Return the username a token was issued for, checked at now.
+
+    now is Unix seconds (default time.time()). Raises TokenUsed if the token
+    was already redeemed, TokenExpired more than 30 minutes after issue, and
+    InvalidToken if it was never issued. Tokens are single-use.
+    """
+    if now is None:
+        now = time.time()
+    with _LOCK:
+        if token in _USED:
+            raise TokenUsed("token already used")
+        entry = _TOKENS.get(token)
+        if entry is None:
+            raise InvalidToken("unknown token")
+        username, issued_at = entry
+        if now - issued_at > TOKEN_TTL:
+            raise TokenExpired("token expired")
+        _USED.add(token)
+        return username
