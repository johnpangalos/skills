+        valid = issue_reset_token("ada", now=0)
+        self.assertEqual(redeem_reset_token(valid, now=0), "ada")
+
+    def test_concurrent_redemption_succeeds_once(self):
+        token = issue_reset_token("ada", now=1000)
+        threads = 8
+        barrier = threading.Barrier(threads)
+        outcomes = []
+
+        def attempt():
+            barrier.wait()
+            try:
+                outcomes.append(redeem_reset_token(token, now=1000))
+            except TokenUsed:
