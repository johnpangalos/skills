+
+    def test_ttl_is_1800_seconds(self):
+        self.assertEqual(RESET_TTL_SECONDS, 1800)
+
+    def test_now_zero_is_a_real_timestamp(self):
+        token = issue_reset_token("ada", now=0)
+        self.assertEqual(redeem_reset_token(token, now=1800), "ada")
+
+    def test_now_zero_expires_after_ttl(self):
+        token = issue_reset_token("ada", now=0)
+        with self.assertRaises(TokenExpired):
+            redeem_reset_token(token, now=1801)
+
+    def test_redeem_exactly_at_ttl_succeeds(self):
+        token = issue_reset_token("ada", now=1000)
+        self.assertEqual(redeem_reset_token(token, now=2800), "ada")
+
+    def test_redeem_just_past_ttl_expires(self):
+        token = issue_reset_token("ada", now=1000)
+        with self.assertRaises(TokenExpired) as cm:
+            redeem_reset_token(token, now=2800.001)
+        self.assertEqual(str(cm.exception), "token expired")
+
+    def test_float_timestamps(self):
+        token = issue_reset_token("ada", now=1000.5)
+        self.assertEqual(redeem_reset_token(token, now=2800.5), "ada")
+
+    def test_float_boundary_has_no_rounding_error(self):
+        # (issued + 1800) - issued == 1800.0000002384186 for this value.
+        issued = 2147483647.26
+        token = issue_reset_token("ada", now=issued)
+        self.assertEqual(redeem_reset_token(token, now=issued + 1800), "ada")
+
+    def test_default_now_uses_time_time_at_call_time(self):
+        with mock.patch("shop.auth.time.time", return_value=5000.0):
+            token = issue_reset_token("ada")
+        with mock.patch("shop.auth.time.time", return_value=5000.0 + 1801):
+            with self.assertRaises(TokenExpired):
+                redeem_reset_token(token)
+
+    def test_default_now_within_ttl_succeeds(self):
+        with mock.patch("shop.auth.time.time", return_value=5000.0):
+            token = issue_reset_token("ada")
+        with mock.patch("shop.auth.time.time", return_value=5000.0 + 60):
+            self.assertEqual(redeem_reset_token(token), "ada")
+
+    def test_redeem_returns_username_then_token_is_used(self):
+        token = issue_reset_token("ada", now=0)
