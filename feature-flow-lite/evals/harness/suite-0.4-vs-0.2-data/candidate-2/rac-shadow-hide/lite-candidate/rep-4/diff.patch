+    let innerSibling = outerDialog.shadowRoot.appendChild(create('span'));
+
+    let revert1 = hideOutside([outerDialog.shadowHost]);
+
+    expect(lightSibling).toHaveAttribute('aria-hidden', 'true');
+    expect(innerDialog).not.toHaveAttribute('aria-hidden');
+    expect(innerSibling).not.toHaveAttribute('aria-hidden');
+
+    let revert2 = hideOutside([innerDialog]);
+
+    expect(lightSibling).toHaveAttribute('aria-hidden', 'true');
+    expect(outerDialog.shadowHost).not.toHaveAttribute('aria-hidden');
+    expect(innerDialog).not.toHaveAttribute('aria-hidden');
+    expect(innerSibling).toHaveAttribute('aria-hidden', 'true');
+
+    revert2();
+
+    expect(innerSibling).not.toHaveAttribute('aria-hidden');
+    expect(lightSibling).toHaveAttribute('aria-hidden', 'true');
+
+    revert1();
+
+    expect(lightSibling).not.toHaveAttribute('aria-hidden');
+  });
+
+  // Fills a light DOM element or shadow root with random divs, some of them hosts and some announcers.
+  let populate = (parent, random, depth, elements) => {
+    let count = 1 + Math.floor(random() * 3);
+    for (let i = 0; i < count; i++) {
+      let element = create('div');
+      if (random() < 0.2) {
+        element.setAttribute('aria-hidden', 'true');
+      }
+      if (random() < 0.1) {
+        element.setAttribute('data-live-announcer', 'true');
+      }
+      parent.appendChild(element);
+      elements.push(element);
+      if (depth < 3 && random() < 0.4) {
+        element.attachShadow({mode: 'open'});
+        populate(element.shadowRoot, random, depth + 1, elements);
+      }
+      if (depth < 3 && random() < 0.3) {
+        populate(element, random, depth + 1, elements);
+      }
+    }
+  };
+
+  // Light DOM and shadow DOM ancestors of an element, nearest first.
+  let ancestorsOf = (element) => {
+    let result = [];
+    let node = element.parentNode;
+    while (node) {
+      if (node instanceof Element) {
+        result.push(node);
+      }
+      node = node instanceof ShadowRoot ? node.host : node.parentNode;
+    }
+    return result;
+  };
+
+  // Targets and their ancestors that were visible before the call must still be visible during it.
+  let expectVisibleAround = (targets, elements, before) => {
+    for (let target of targets) {
+      for (let element of [target, ...ancestorsOf(target)]) {
+        let index = elements.indexOf(element);
+        if (index >= 0 && before[index] === null) {
+          expect(element).not.toHaveAttribute('aria-hidden');
+        }
+      }
+    }
+  };
+
+  it('restores every aria-hidden exactly after hiding, for random shadow trees and target choices', function () {
+    fc.assert(fc.property(fc.integer(), seed => {
+      let random = mulberry32(seed);
+      try {
+        let elements = [];
+        populate(container, random, 0, elements);
+        let targets = elements.filter(() => random() < 0.15);
+        if (!targets.length) {
+          targets.push(elements[Math.floor(random() * elements.length)]);
+        }
+        let before = elements.map(element => element.getAttribute('aria-hidden'));
+
+        let revert = hideOutside(targets);
+
+        expectVisibleAround(targets, elements, before);
+
+        revert();
+
+        expect(elements.map(element => element.getAttribute('aria-hidden'))).toEqual(before);
+      } finally {
+        container.replaceChildren();
+      }
+    }), {numRuns: 1000, seed: 42});
+  });
 });
