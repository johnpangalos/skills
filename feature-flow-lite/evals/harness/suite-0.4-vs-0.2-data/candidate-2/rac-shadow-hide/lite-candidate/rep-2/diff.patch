+ */
+
+import {ariaHideOutside} from '../src';
+import {enableShadowDOM} from '@react-stately/flags';
+import {keepVisible} from '../src/ariaHideOutside';
+
+// Flags are module-global, so this file keeps Shadow DOM on for every test in it.
+// The flag-off behavior is covered by ariaHideOutside.noShadowDOM.test.js.
+
+// Creates an element with an id and appends it to parent.
+function make(parent, id, tag = 'div') {
+  let el = document.createElement(tag);
+  el.id = id;
+  parent.appendChild(el);
+  return el;
+}
+
+// Creates a shadow host with an open shadow root and appends it to parent.
+function makeHost(parent, id) {
+  let host = make(parent, id);
+  return {host, shadow: host.attachShadow({mode: 'open'})};
+}
+
+// Returns every element in the document, including elements inside open shadow roots.
+function allElements(node, result = []) {
+  for (let el of node.querySelectorAll('*')) {
+    result.push(el);
+    if (el.shadowRoot) {
+      allElements(el.shadowRoot, result);
+    }
+  }
+  return result;
+}
+
+// Returns every element in the document, including inside open shadow roots, that has aria-hidden.
+function hiddenElements() {
+  return allElements(document.body).filter(el => el.hasAttribute('aria-hidden'));
+}
+
+describe('ariaHideOutside with Shadow DOM', function () {
+  beforeAll(() => {
+    enableShadowDOM();
+  });
+
+  afterEach(() => {
+    document.body.innerHTML = '';
+  });
+
+  describe('initial walk', function () {
+    it('hides siblings of a target inside its shadow root', function () {
+      let outside = make(document.body, 'outside', 'button');
+      let {host, shadow} = makeHost(document.body, 'host');
+      let before = make(shadow, 'before', 'input');
+      let target = make(shadow, 'target', 'button');
+      let after = make(shadow, 'after', 'input');
+
+      let revert = ariaHideOutside([target]);
+
+      expect(outside).toHaveAttribute('aria-hidden', 'true');
+      expect(before).toHaveAttribute('aria-hidden', 'true');
+      expect(after).toHaveAttribute('aria-hidden', 'true');
+      expect(host).not.toHaveAttribute('aria-hidden');
+      expect(target).not.toHaveAttribute('aria-hidden');
+
+      revert();
+
+      expect(outside).not.toHaveAttribute('aria-hidden');
+      expect(before).not.toHaveAttribute('aria-hidden');
+      expect(after).not.toHaveAttribute('aria-hidden');
+    });
+
+    it('hides siblings of shadow hosts on the path in every nested shadow root', function () {
+      let wrapper = make(document.body, 'wrapper');
+      let {host: outerHost, shadow: outerShadow} = makeHost(wrapper, 'outer-host');
+      let outerBefore = make(outerShadow, 'outer-before', 'input');
+      let {host: innerHost, shadow: innerShadow} = makeHost(outerShadow, 'inner-host');
+      let innerSibling = make(innerShadow, 'inner-sibling', 'input');
+      let target = make(innerShadow, 'target', 'button');
+      let outerAfter = make(outerShadow, 'outer-after', 'input');
+      let lightSibling = make(wrapper, 'light-sibling', 'input');
+
+      let revert = ariaHideOutside([target]);
+
+      expect(outerBefore).toHaveAttribute('aria-hidden', 'true');
+      expect(outerAfter).toHaveAttribute('aria-hidden', 'true');
+      expect(innerSibling).toHaveAttribute('aria-hidden', 'true');
+      expect(lightSibling).toHaveAttribute('aria-hidden', 'true');
+      expect(wrapper).not.toHaveAttribute('aria-hidden');
+      expect(outerHost).not.toHaveAttribute('aria-hidden');
+      expect(innerHost).not.toHaveAttribute('aria-hidden');
+      expect(target).not.toHaveAttribute('aria-hidden');
+
+      revert();
+
+      expect(hiddenElements()).toEqual([]);
+    });
+
+    it('hides a sibling host without walking into its own shadow root', function () {
+      let {shadow} = makeHost(document.body, 'host');
+      let {host: siblingHost, shadow: siblingShadow} = makeHost(shadow, 'sibling-host');
+      let deep = make(siblingShadow, 'deep', 'button');
+      let target = make(shadow, 'target', 'button');
+
+      let revert = ariaHideOutside([target]);
+
+      expect(siblingHost).toHaveAttribute('aria-hidden', 'true');
+      expect(deep).not.toHaveAttribute('aria-hidden');
+      expect(target).not.toHaveAttribute('aria-hidden');
+
+      revert();
