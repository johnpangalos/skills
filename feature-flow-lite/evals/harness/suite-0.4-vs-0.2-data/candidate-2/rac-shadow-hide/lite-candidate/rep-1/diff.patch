+
+    revert();
+  });
+
+  it('does not hide outside the root option when the root is inside a shadow root', async function () {
+    let outside = addToBody(createElement('button', {}, 'Outside'));
+    let {host, shadowRoot} = createHost();
+    let siblingOutsideRoot = createElement('input', {type: 'checkbox'});
+    let root = createElement('div');
+    let target = createElement('button', {}, 'Target');
+    let siblingInsideRoot = createElement('input', {type: 'radio'});
+    root.append(target, siblingInsideRoot);
+    shadowRoot.append(siblingOutsideRoot, root);
+
+    let revert = ariaHideOutside([target], {root});
+
+    expect(siblingInsideRoot).toHaveAttribute('aria-hidden', 'true');
+    expect(siblingOutsideRoot).not.toHaveAttribute('aria-hidden');
+    expect(outside).not.toHaveAttribute('aria-hidden');
+    expect(host).not.toHaveAttribute('aria-hidden');
+    expect(root).not.toHaveAttribute('aria-hidden');
+
+    let addedOutsideRoot = createElement('button', {}, 'Added outside root');
+    shadowRoot.append(addedOutsideRoot);
+    await Promise.resolve();
+    expect(addedOutsideRoot).not.toHaveAttribute('aria-hidden');
+
+    revert();
+  });
+
+  it('does not hide a shadow root child that is added and then moved into a target', async function () {
+    let {shadowRoot} = createHost();
+    let target = createElement('div', {}, 'Target');
+    shadowRoot.append(target);
+
+    let revert = ariaHideOutside([target]);
+
+    let child = createElement('span', {}, 'Moved');
+    shadowRoot.append(child);
+    target.appendChild(child);
+    await Promise.resolve();
+
+    expect(child).not.toHaveAttribute('aria-hidden');
+    expect(target).not.toHaveAttribute('aria-hidden');
+
+    revert();
+  });
+
+  it('hides light DOM children of a host on the path to a target', function () {
+    let {host, shadowRoot} = createHost();
+    let slotted = createElement('button', {}, 'Slotted');
+    host.appendChild(slotted);
+    let slot = createElement('slot');
+    let target = createElement('button', {}, 'Target');
+    shadowRoot.append(slot, target);
+
+    let revert = ariaHideOutside([target]);
+
+    expect(slotted).toHaveAttribute('aria-hidden', 'true');
+    expect(slot).toHaveAttribute('aria-hidden', 'true');
+    expect(host).not.toHaveAttribute('aria-hidden');
+    expect(target).not.toHaveAttribute('aria-hidden');
+
+    revert();
+  });
+
+  it('hides outside content when the target is the only child of a shadow root', function () {
+    let outside = addToBody(createElement('button', {}, 'Outside'));
+    let {host, shadowRoot} = createHost();
+    let target = createElement('button', {}, 'Target');
+    shadowRoot.append(target);
+
+    let revert = ariaHideOutside([target]);
+
+    expect(outside).toHaveAttribute('aria-hidden', 'true');
+    expect(host).not.toHaveAttribute('aria-hidden');
+    expect(target).not.toHaveAttribute('aria-hidden');
+
+    revert();
+
+    expect(outside).not.toHaveAttribute('aria-hidden');
+  });
 });
