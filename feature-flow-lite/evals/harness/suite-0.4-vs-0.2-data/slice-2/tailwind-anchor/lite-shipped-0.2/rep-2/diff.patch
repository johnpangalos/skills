+test('anchor', async () => {
+  expect(
+    await run([
+      'anchor-tooltip',
+      'anchor-my-anchor',
+      'anchor-1',
+      'anchor-none',
+      'anchor-[--a,--b]',
+      'anchor-(--x)',
+      'hover:anchor-tooltip',
+      'anchor-tooltip!',
+    ]),
+  ).toMatchInlineSnapshot(`
+    "
+    .anchor-\\(--x\\) {
+      anchor-name: var(--x);
+    }
+
+    .anchor-1 {
+      anchor-name: --1;
+    }
+
+    .anchor-\\[--a\\,--b\\] {
+      anchor-name: --a,--b;
+    }
+
+    .anchor-my-anchor {
+      anchor-name: --my-anchor;
+    }
+
+    .anchor-none {
+      anchor-name: none;
+    }
+
+    .anchor-tooltip {
+      anchor-name: --tooltip;
+    }
+
+    .anchor-tooltip\\! {
+      anchor-name: --tooltip !important;
+    }
+
+    @media (hover: hover) {
+      .hover\\:anchor-tooltip:hover {
+        anchor-name: --tooltip;
+      }
+    }
+    "
+  `)
+  expect(
+    await run([
+      'anchor',
+      '-anchor-foo',
+      '-anchor-none',
+      'anchor-foo/bar',
+      'anchor-none/foo',
+      'anchor-[--a]/foo',
+      'anchor-1/2',
+      'anchor-foo.bar',
+      'anchor-50%',
+    ]),
+  ).toEqual('')
+})
+
+test('anchored', async () => {
+  expect(await run(['anchored-menu', 'anchored-auto', 'anchored-[--menu]', 'hover:anchored-menu']))
+    .toMatchInlineSnapshot(`
+    "
+    .anchored-\\[--menu\\] {
+      position-anchor: --menu;
+    }
+
+    .anchored-auto {
+      position-anchor: auto;
+    }
+
+    .anchored-menu {
+      position-anchor: --menu;
+    }
+
+    @media (hover: hover) {
+      .hover\\:anchored-menu:hover {
+        position-anchor: --menu;
+      }
+    }
+    "
+  `)
+  expect(
+    await run([
+      'anchored',
+      '-anchored-foo',
+      '-anchored-auto',
+      'anchored-auto/foo',
+      'anchored-[--a]/foo',
+      'anchored-1/2',
+      'anchored-foo.bar',
+      'anchored-50%',
+    ]),
+  ).toEqual('')
+})
