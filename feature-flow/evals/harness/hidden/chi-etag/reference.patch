index 0000000..8939f64
--- /dev/null
+++ b/middleware/etag.go
@@ -0,0 +1,98 @@
+package middleware
+
+import (
+	"bufio"
+	"bytes"
+	"crypto/sha256"
+	"encoding/base64"
+	"net"
+	"net/http"
+	"strings"
+)
+
+// ETag buffers the response to GET and HEAD requests and, for a 200 response,
+// sets a strong ETag computed from the body unless the handler set one itself.
+// When the request's If-None-Match matches the ETag (weak comparison, RFC 9110
+// section 13.1.2), it responds 304 Not Modified with no body.
+func ETag(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet && r.Method != http.MethodHead {
+			next.ServeHTTP(w, r)
+			return
+		}
+		bw := &etagWriter{ResponseWriter: w, status: http.StatusOK}
+		next.ServeHTTP(bw, r)
+		if bw.hijacked {
+			return
+		}
+
+		if bw.status != http.StatusOK {
+			w.WriteHeader(bw.status)
+			w.Write(bw.buf.Bytes())
+			return
+		}
+		tag := w.Header().Get("ETag")
+		if tag == "" {
+			sum := sha256.Sum256(bw.buf.Bytes())
+			tag = `"` + base64.RawURLEncoding.EncodeToString(sum[:16]) + `"`
+			w.Header().Set("ETag", tag)
+		}
+		if etagMatch(r.Header.Values("If-None-Match"), tag) {
+			h := w.Header()
+			for _, k := range []string{"Content-Type", "Content-Length", "Content-Encoding"} {
+				h.Del(k)
+			}
+			w.WriteHeader(http.StatusNotModified)
+			return
+		}
+		w.WriteHeader(http.StatusOK)
+		w.Write(bw.buf.Bytes())
+	})
+}
+
+type etagWriter struct {
+	http.ResponseWriter
+	buf         bytes.Buffer
+	status      int
+	wroteHeader bool
+	hijacked    bool
+}
+
+// Flush is a no-op: nothing reaches the client until the handler returns and
+// the ETag is known.
+func (w *etagWriter) Flush() {}
+
+// Hijack hands the connection to the handler (for example for a WebSocket
+// upgrade); the middleware then stays out of the way.
+func (w *etagWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	conn, buf, err := http.NewResponseController(w.ResponseWriter).Hijack()
+	if err == nil {
+		w.hijacked = true
+	}
+	return conn, buf, err
+}
+
+func (w *etagWriter) WriteHeader(code int) {
+	if !w.wroteHeader {
+		w.status = code
+		w.wroteHeader = true
+	}
+}
+
+func (w *etagWriter) Write(b []byte) (int, error) {
+	w.wroteHeader = true
+	return w.buf.Write(b)
+}
+
+func etagMatch(headers []string, tag string) bool {
+	opaque := strings.TrimPrefix(tag, "W/")
+	for _, header := range headers {
+		for _, candidate := range strings.Split(header, ",") {
+			candidate = strings.TrimSpace(candidate)
+			if candidate == "*" || strings.TrimPrefix(candidate, "W/") == opaque {
+				return true
+			}
+		}
+	}
+	return false
+}
